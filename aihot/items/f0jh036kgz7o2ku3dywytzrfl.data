[{"_1":2,"_3":4},"root",{"_5":76},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","f0jh036kgz7o2ku3dywytzrfl","title","Amazon Quick 智能审批功能发布：关键决策保留人工审核","originalTitle","Smart Approvals in Amazon Quick: Human oversight where it matters","summary","AWS发布Amazon Quick智能审批功能，通过自动化处理常规操作并保留关键决策的人工审核，帮助安全团队平衡AI效率与控制。功能基于现有权限控制，利用独立模型评估每个操作（如数据外发、权限变更、支付发起等），并记录审批日志供审计追踪。管理员可通过自定义权限限制功能范围，试点期间需验证自动审批准确率及关键场景人工复核有效性。","reason","原文介绍了Amazon Quick的智能审批功能如何通过自动化处理常规操作，同时保留对关键决策的人类控制，为安全领导提供可扩展的AI治理方案。","source",{"_68":75},"links",{"_59":74},"publishedAt","2026-11-04T16:33:03.000Z","discoveredAt","2026-11-04T16:37:29.202Z","timelineAt","category","industry","tags",[69],"score",65,"selected",true,"channel","news","story",{"_71":72,"_11":73},"x","readingMode","full","author","Steve Vinsik","body","outline",[],"relatedStories",[70],"topics",[66],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fZKYphsiFkiA","reportCount",1,"additionalSourceCount",0,{"_67":29,"_68":69},"slug","name","行业动态",{"_71":72,"_11":73},"publicId","f9cec2ad-f53e-459d-9b05-cd2d85fd76a8","Amazon Quick发布智能审批功能，关键决策保留人工审核","https://aws.amazon.com/blogs/machine-learning/smart-approvals-in-amazon-quick-human-oversight-where-it-matters/","AWS Machine Learning Blog",{"_77":78,"_79":-5},"changelogVersion","2026-10-01T08:00","release"]

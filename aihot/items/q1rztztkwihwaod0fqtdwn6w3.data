[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":34,"_52":53,"_54":55,"_56":34,"_57":58},"id","q1rztztkwihwaod0fqtdwn6w3","title","Meta收购AI编码初创公司Conductor","originalTitle","Meta acquires AI coding startup Conductor","summary","Meta收购允许用户并行部署多个AI智能体的编码初创公司Conductor。Conductor将关闭云服务（11月20日），用户数据将被删除。Meta此前已推出Muse Code等自有AI编码工具，并计划在明年早些时候发布新功能。收购后Conductor团队将加入Meta Superintelligence Labs，与Alexandr Wang和Nat Friedman合作。","reason","source",{"_68":78},"links",{"_58":77},"publishedAt","2026-11-04T21:10:56.000Z","discoveredAt","2026-11-05T01:52:49.753Z","timelineAt","category","industry","tags",[69,76],"score",66,"selected",false,"channel","news","story",{"_73":74,"_11":75},"x","readingMode","full","author","Lucas Ropek","body","outline",[],"relatedStories",[72],"topics",[65,66],"indexable","markdownAvailable",true,"group",{"_59":60,"_61":62,"_63":64},"hasTranslation","bodyLanguage","original","factId","f9XW0naLQB7s","reportCount",1,"additionalSourceCount",0,{"_67":70,"_68":71},{"_67":28,"_68":69},"slug","name","行业动态","meta","Meta / Llama",{"_73":74,"_11":75},"publicId","f897e7bd-fd9e-4e5a-a233-796640f282d0","Meta收购Conductor并关闭其云服务","Meta","https://techcrunch.com/2026/11/04/meta-acquires-ai-coding-startup-conductor/","TechCrunch · AI",{"_80":81,"_82":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":78},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","d3ctjw6910uhxr9r7s6dbuki2","title","Google Research AI 通过普通智能手表无袖带检测高血压","originalTitle","Google's AI detects high blood pressure from a regular smartwatch without a cuff","summary","Google Research AI 通过智能手表的脉率和运动传感器数据，无袖带检测出高血压患者约65.8%。该成果已整合至Google Health应用，但未替代专业诊断。研究基于近50万小时传感器数据，通过无监督学习识别个体脉搏模式。对比传统诊室测量法（55.3%准确率），该技术检测效果相当。","reason","研究展示了无袖带血压检测的可行性，并已部分应用于Google Health应用","source",{"_69":77},"links",{"_59":76},"publishedAt","2026-11-07T09:54:09.000Z","discoveredAt","2026-11-07T12:10:26.450Z","timelineAt","category","paper","tags",[75],"score",79,"selected",true,"channel","news","story",{"_72":73,"_11":74},"x","readingMode","full","author","Manuel Uth","body","outline",[],"relatedStories",[71],"topics",[66],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","f1rO1j9mzmTM","reportCount",2,"additionalSourceCount",1,{"_67":68,"_69":70},"slug","papers","name","论文研究",{"_72":73,"_11":74},"publicId","7d047d2b-9ef7-4c37-8e08-69527b2e94a8","Google Research提出无校准智能手表AI筛查高血压，初步数据引发争议","论文/研究","https://the-decoder.com/googles-ai-detects-high-blood-pressure-from-a-regular-smartwatch-without-a-cuff/","The Decoder",{"_79":80,"_81":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":34,"_52":53,"_54":55,"_56":34,"_57":58},"id","rvgojswvzwvv157unll1xtd7t","title","Anthropic 首次付费获取新闻内容并改变策略","originalTitle","Anthropic reverses course and pays for news content for the first time","summary","Anthropic 首次与 Associated Press 签订内容授权协议，允许 Claude 在选举之夜展示实时新闻。此前 Anthropic 因反对付费授权，坚持通过合理使用原则抓取内容，而 OpenAI 已与 Axel Springer、News Corp 等多家媒体达成类似合作。双方合作时长与金额未披露，但 AP 此前曾阻止 Anthropic 的爬虫以促使其谈判。","reason","source",{"_68":78},"links",{"_58":77},"publishedAt","2026-11-05T14:09:05.000Z","discoveredAt","2026-11-05T14:38:44.336Z","timelineAt","category","industry","tags",[69,76],"score",69,"selected",false,"channel","news","story",{"_73":74,"_11":75},"x","readingMode","full","author","Maximilian Schreiner","body","outline",[],"relatedStories",[72],"topics",[65,66],"indexable","markdownAvailable",true,"group",{"_59":60,"_61":62,"_63":64},"hasTranslation","bodyLanguage","original","factId","fweNpzwtQSNs","reportCount",1,"additionalSourceCount",0,{"_67":70,"_68":71},{"_67":28,"_68":69},"slug","name","行业动态","anthropic","Anthropic / Claude",{"_73":74,"_11":75},"publicId","f5bfe7eb-125c-4fd0-9971-e94e90ce669d","Anthropic首次付费与AP合作，允许Claude在选举期间使用实时新闻","Anthropic","https://the-decoder.com/anthropic-reverses-course-and-pays-for-news-content-for-the-first-time/","The Decoder",{"_80":81,"_82":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":73},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":-5,"_54":55,"_56":57},"id","eq7707xp4xiacpmqlz4rb55wj","title","OpenAI发布网络安全模型ChatGPT Cyber，漏洞扫描成效显著","originalTitle","OpenAI released a new cybersecurity model. Is that enough?","summary","OpenAI发布网络安全模型ChatGPT Cyber，通过GPT 5.6 Sol发现948个Linux内核潜在漏洞及81个Firefox新型漏洞。该模型仅限Daybreak Red计划用户使用，但存在资源分配争议——漏洞扫描成本$1.2 million远低于流体力学问题投入的$6 million。网络安全专家指出，限制模型可用性可能削弱防御能力，而攻击者可使用未受约束的公开模型。","reason","原文展示了ChatGPT Cyber在漏洞扫描中的实际效果，并引发对AI安全工具资源分配与威胁平衡的讨论。","source",{"_63":72},"links",{"_57":71},"publishedAt","2026-11-05T19:06:12.000Z","discoveredAt","2026-11-05T19:40:10.080Z","timelineAt","category","industry","tags",[64,69,70],"score",77,"selected",true,"channel","news","story","x","readingMode","full","author","Tim Fernholz","body","outline",[],"relatedStories",[],"topics",[58,59,60],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_61":67,"_63":68},{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","product-updates","name","产品更新","safety","安全对齐","openai","OpenAI / ChatGPT","安全/对齐","OpenAI","https://techcrunch.com/2026/11/05/openai-released-a-new-cybersecurity-model-is-that-enough/","TechCrunch · AI",{"_74":75,"_76":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":34,"_52":53,"_54":55,"_56":34,"_57":58},"id","g1f1d9rclzpctfh4k7x5t2qz3","title","Chris Alexiuk 推广开放源代码 AI 模型 Nemotron","originalTitle","The Wizard of Open Weights: Chris Alexiuk Makes AI Easy With Open Models","summary","Chris Alexiuk 是 NVIDIA 的高级产品研究工程师，专注于使开放大语言模型（LLMs）适用于开发人员。他强调完全开放源代码 AI 对于智能民主化至关重要，并认为 Nemotron 是最重要的项目之一。Alexiuk 在 YouTube 上教学如何构建、微调和部署 LLM 应用程序和智能体，致力于让更多人了解 AI 技术。","reason","source",{"_70":82},"links",{"_58":81},"publishedAt","2026-11-05T16:00:05.000Z","discoveredAt","2026-11-05T17:12:35.410Z","timelineAt","category","opinion","tags",[71,80],"score",49,"selected",false,"channel","news","story",{"_77":78,"_11":79},"x","readingMode","full","author","Matthew Leib","body","outline",[],"relatedStories",[76],"topics",[65,66,67],"indexable","markdownAvailable",true,"group",{"_59":60,"_61":62,"_63":64},"hasTranslation","bodyLanguage","original","factId","fG6LiXcOeZmA","reportCount",1,"additionalSourceCount",0,{"_68":74,"_70":75},{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","opinions","name","大佬观点","open-source","开源生态","nvidia","NVIDIA 英伟达",{"_77":78,"_11":79},"publicId","f9720316-d91b-4711-9a6c-c6f2dffff0b6","NVIDIA工程师Chris Alexiuk公开Nemotron使用教程及开源倡导","开源/仓库","https://blogs.nvidia.com/blog/nvidia-life-chris-alexiuk/","NVIDIA Blog",{"_84":85,"_86":-5},"changelogVersion","2026-10-01T08:00","release"]

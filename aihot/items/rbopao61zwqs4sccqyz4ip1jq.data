[{"_1":2,"_3":4},"root",{"_5":80},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","rbopao61zwqs4sccqyz4ip1jq","title","AWS无服务器MCP服务器架构：AI智能体数据湖访问解决方案","originalTitle","Serverless MCP server for AI agent data lake access on Amazon ECS Fargate","summary","AWS构建无服务器MCP服务器，实现AI智能体与数据湖的自动化集成。系统通过JSON元数据文件配置，无需重复开发SQL接口，支持多租户环境下的权限集中管控和弹性扩展。架构包含认证层、MCP服务器层、工具层和数据更新层，利用Amazon Bedrock和Athena服务，确保15-20秒内完成从自然语言查询到结构化数据返回的全流程。","reason","通过配置驱动的架构设计，实现多租户环境下AI智能体与数据湖的无缝集成，提供可复用的工具接口和自动化权限控制方案。","source",{"_70":79},"links",{"_59":78},"publishedAt","2026-11-06T17:13:13.000Z","discoveredAt","2026-11-07T12:10:42.203Z","timelineAt","category","ai-products","tags",[71,73],"score",84,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author","Aishwarya Pawar","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","faueuSKlWeco","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","product-updates","name","产品更新","deepseek","DeepSeek",{"_75":76,"_11":77},"publicId","2f4544db-ebb4-4392-8288-ce8de8c8fd4d","AWS构建无服务器MCP服务器，简化AI代理数据湖访问","https://aws.amazon.com/blogs/machine-learning/serverless-mcp-server-for-ai-agent-data-lake-access-on-amazon-ecs-fargate/","AWS Machine Learning Blog",{"_81":82,"_83":-5},"changelogVersion","2026-10-01T08:00","release"]

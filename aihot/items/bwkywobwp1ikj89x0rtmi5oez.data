[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","bwkywobwp1ikj89x0rtmi5oez","title","Anthropic 发布企业级AI支出优化报告工具","originalTitle","Anthropic just launched tools to show companies what their AI spending is buying","summary","Anthropic 发布企业级AI支出优化报告工具，显示客户AI支出成本占比2%且同比增长10倍。工具基于内部分析和员工调查，可追踪团队工作成果、成本消耗及流程瓶颈，并附带优化建议。尽管OpenAI Astra模型被推出，但Anthropic的采用率未受影响。企业客户反馈显示，工具帮助其实现从‘盲目投入’到‘精准优化’的转变，但仍有部分客户未感知到显著AI价值提升。","reason","工具通过内部分析和员工调查帮助企业管理AI成本，并对比了与OpenAI Astra的竞争态势","source",{"_71":84},"links",{"_59":83},"publishedAt","2026-10-28T19:19:58.000Z","discoveredAt","2026-10-28T20:11:38.602Z","timelineAt","category","ai-products","tags",[72,81,82],"score",78,"selected",true,"channel","news","story",{"_78":79,"_11":80},"x","readingMode","full","author","Tim Fernholz","body","outline",[],"relatedStories",[77],"topics",[66,67,68],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fIbEq3SwkOtg","reportCount",1,"additionalSourceCount",0,{"_69":75,"_71":76},{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","product-updates","name","产品更新","coding","AI 编码","anthropic","Anthropic / Claude",{"_78":79,"_11":80},"publicId","9a4e67ac-bfda-4226-882f-06b25de3f925","Anthropic发布企业级AI支出优化报告工具，客户成本占比2%同比增10倍","编码","Anthropic","https://techcrunch.com/2026/10/28/anthropic-just-launched-tools-to-show-companies-what-their-ai-spending-is-buying/","TechCrunch · AI",{"_86":87,"_88":-5},"changelogVersion","2026-10-01T08:00","release"]

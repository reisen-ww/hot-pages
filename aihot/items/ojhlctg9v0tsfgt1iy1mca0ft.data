[{"_1":2,"_3":4},"root",{"_5":88},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","ojhlctg9v0tsfgt1iy1mca0ft","title","Gemini Omni 1.2 Flash 发布：15秒视频生成与30%价格下调","originalTitle","Google's Gemini Omni 1.2 Flash stretches AI video clips to 15 seconds and cuts pricing by 30 percent","summary","Google 发布 Gemini Omni 1.2 Flash 视频生成模型，支持15秒长视频、30%价格下调及对话式编辑功能。该模型通过逐步调整背景、光照和画面比例实现局部编辑，支持从360p/720p到1080p/4K的阶梯式处理，并承诺更稳定的视觉一致性。输入可包含人物照片、产品图、3秒动态片段及音频提示，输出视频能保持服装剪裁、品牌标识等细节跨镜头一致性。","reason","原文提供了视频生成模型的功能升级、价格调整和编辑流程优化，读者可评估其对内容创作成本的影响。","source",{"_72":87},"links",{"_59":86},"publishedAt","2026-11-05T19:05:31.000Z","discoveredAt","2026-11-05T19:13:41.588Z","timelineAt","category","ai-products","tags",[73,84,75,85],"score",92,"selected",true,"channel","news","story",{"_81":82,"_11":83},"x","readingMode","full","author","Matthias Bastian","body","outline",[],"relatedStories",[80],"topics",[66,67,68,69],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fe-OIxj7KiUU","reportCount",2,"additionalSourceCount",1,{"_70":78,"_72":79},{"_70":76,"_72":77},{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","product-updates","name","产品更新","open-source","开源生态","video","AI 视频","google","Google / Gemini",{"_81":82,"_11":83},"publicId","a1b020ef-b430-416c-b77c-f2ca8317ebd5","Google DeepMind推出Gemini Omni 1.2 Flash：15秒视频生成及价格下调30%","视频","Google","https://the-decoder.com/googles-gemini-omni-1-2-flash-stretches-ai-video-clips-to-15-seconds-and-cuts-pricing-by-30-percent/","The Decoder",{"_89":90,"_91":-5},"changelogVersion","2026-10-01T08:00","release"]

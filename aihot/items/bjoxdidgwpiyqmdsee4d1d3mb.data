[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","bjoxdidgwpiyqmdsee4d1d3mb","title","Google Research提出睡眠框架：LLM持续学习中的新型知识保留方法","originalTitle","The sleep framework: A new way for LLMs to retain knowledge in continual learning","summary","Google Research提出睡眠框架解决LLM持续学习中的灾难性遗忘问题，在长文本理解与数学推理基准测试中表现优于GPT-4等基线方法。该框架通过参数扩展与混合专家架构（MoE）实现动态知识存储，结合知识蒸馏（GKD）与强化学习（RL）的模拟训练（dreaming）机制，在10M tokens长上下文场景下保持近零性能衰减，数学推理准确率达79.2%。","reason","该研究提出睡眠框架解决LLM持续学习中的灾难性遗忘问题，在长文本理解与数学推理基准测试中表现优于GPT-4等基线方法。","source",{"_70":83},"links",{"_58":82},"publishedAt","2026-10-27T17:35:28.000Z","discoveredAt","2026-10-27T17:39:42.309Z","timelineAt","category","paper","tags",[80,73,81],"score",78,"selected",true,"channel","news","story",{"_77":78,"_11":79},"x","readingMode","full","author","body","outline",[],"relatedStories",[76],"topics",[65,66,67],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","fwR6Eo87_nNU","reportCount",1,"additionalSourceCount",0,{"_68":74,"_70":75},{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","papers","name","论文研究","multimodal","多模态","reasoning","推理能力",{"_77":78,"_11":79},"publicId","4a72f735-458d-41cc-b026-f10e7512d9f9","Google提出睡眠框架解决LLM持续学习遗忘问题","论文/研究","推理","https://research.google/blog/the-sleep-framework-a-new-way-for-llms-to-retain-knowledge-in-continual-learning/","Google Research",{"_85":86,"_87":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":78},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":24,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":-5,"_54":55,"_56":57},"id","i0w96rn4pl8j17upo7kt3bhav","title","GitHub Security Lab 发布 Fuzzing Taskflow 智能体流水线","originalTitle","AI-powered fuzzing with the GitHub Security Lab Taskflow Agent","summary","GitHub Security Lab 发布 Fuzzing Taskflow，一个面向 C/C++ 项目的自主模糊测试流水线，只需指向一个 GitHub 仓库，它就会识别入口点、分析构建系统、编写 harness、运行 AFL++、读取覆盖率报告并改进 harness，最后对每个崩溃做分诊并生成漏洞报告。","reason","GitHub Security Lab 把模糊测试的 harness 编写、覆盖率追踪与崩溃分诊交给 LLM 智能体，读者可了解其分层设计与安全边界。","source",{"_64":77},"links",{"_57":76},"publishedAt","2026-09-24T18:26:12.000Z","discoveredAt","2026-10-06T14:40:37.403Z","timelineAt","category","ai-products","tags",[65,72,73,74,75],"score",66,"selected",true,"channel","news","story","x","readingMode","full","author","Antonio Morales","body","outline",[],"relatedStories",[],"topics",[58,59,60,61],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_62":70,"_64":71},{"_62":68,"_64":69},{"_62":66,"_64":67},{"_62":63,"_64":65},"slug","product-updates","name","产品更新","mcp","MCP 与工具调用","safety","安全对齐","agent","Agent 智能体","安全/对齐","Agent","MCP/工具调用","GitHub","https://github.blog/security/application-security/ai-powered-fuzzing-with-the-github-security-lab-taskflow-agent/","GitHub Blog · AI & ML",{"_79":80,"_81":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":71},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":-5,"_29":30,"_31":32,"_33":34,"_35":36,"_37":-5,"_38":-5,"_39":40,"_41":42,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":34,"_52":-5,"_53":54,"_55":56},"id","v1mfh4nhhq42nkmjuq5w4upwp","title","NVIDIA开源Aerial和Sionna工具加速6G网络研发","originalTitle","How NVIDIA Open Source Tools Are Helping Researchers Build Next-Generation 6G Networks","summary","NVIDIA开源Aerial和Sionna工具加速6G网络研发，支持端侧实时数据处理（机器人任务完成时间减少52.6%）、能耗优化（RAN功耗降低45.6%）和仿真加速（3小时缩短至10-20分钟）。工具已获超百万次下载，被8000+机构用于6G原型验证，涵盖信号增强、动态环境适应等关键技术场景。","reason","工具提供端侧实时数据处理、能耗优化和仿真加速功能，支持6G网络研发全流程验证","source",{"_62":70},"links",{"_56":69},"publishedAt","2026-11-06T16:00:35.000Z","discoveredAt","2026-11-07T12:10:39.014Z","timelineAt","category","tags",[63,68],"score",88,"selected",true,"channel","news","story","x","readingMode","full","author","Soma Velayutham","body","outline",[],"relatedStories",[],"topics",[57,58,59],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_60":66,"_62":67},{"_60":64,"_62":65},{"_60":61,"_62":63},"slug","product-updates","name","产品更新","open-source","开源生态","nvidia","NVIDIA 英伟达","开源/仓库","https://blogs.nvidia.com/blog/telco-open-source-tools-research-6g-networks/","NVIDIA Blog",{"_72":73,"_74":-5},"changelogVersion","2026-10-01T08:00","release"]

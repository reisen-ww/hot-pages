[{"_1":2,"_3":4},"root",{"_5":78},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","g3mt85ifav0tr2h6qeuqpf6tv","title","NVIDIA AI代理技术实现外星信号实时处理","originalTitle","Things That Go Beep in the Night: Agentic AI Joins the Search for Extraterrestrial Signals","summary","NVIDIA通过AI代理技术实现外星信号实时处理，单台RTX PRO 6000 Blackwell GPU可处理2.4Tbps数据流，并完成Crab Nebula脉冲星首次实时AI检测。系统包含Holoscan平台（支持GPU内存直存传感器数据）、CyberEther信号处理框架（基于CUDA-X库）和Nexus观测调度器（通过自然语言指令控制望远镜校准、数据纠错等全流程）。","reason","原文展示了AI代理在实时数据处理和科学发现中的高效应用，具体包括2.4Tbps处理能力、脉冲星实时检测案例以及Holoscan平台的技术细节。","source",{"_69":77},"links",{"_59":76},"publishedAt","2026-10-30T15:00:10.000Z","discoveredAt","2026-10-30T16:02:21.135Z","timelineAt","category","paper","tags",[75],"score",76,"selected",true,"channel","news","story",{"_72":73,"_11":74},"x","readingMode","full","author","Chris Porter","body","outline",[],"relatedStories",[71],"topics",[66],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fNGNNcwYOJ3o","reportCount",1,"additionalSourceCount",0,{"_67":68,"_69":70},"slug","papers","name","论文研究",{"_72":73,"_11":74},"publicId","97865570-859d-45f8-abb0-3f7d111e8715","NVIDIA Holoscan实现外星信号实时处理技术突破","论文/研究","https://blogs.nvidia.com/blog/ai-joins-the-search-for-extraterrestrial-signals/","NVIDIA Blog",{"_79":80,"_81":-5},"changelogVersion","2026-10-01T08:00","release"]

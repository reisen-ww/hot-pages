[{"_1":2,"_3":4},"root",{"_5":76},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","e43n2cfsjfiquoh926101qr5f","title","Qualcomm因智能手机销量下滑加大AI数据中心投入","originalTitle","Qualcomm is betting big on data centers as smartphone sales sink","summary","Qualcomm在2026年第四季度财报电话会议中宣布将AI数据中心业务作为战略重点，预计2027年Q1数据中心收入6500万美元，2027年底达50亿美元，2029年达150亿美元（占2026年总营收10.4亿美元30%）。其合作方包括亚马逊和Meta，与AMD的80%数据中心营收目标形成对比。","reason","原文提供了Qualcomm在AI数据中心领域的具体营收预测和合作方，读者可据此评估其战略转型对行业的影响。","source",{"_68":75},"links",{"_59":74},"publishedAt","2026-11-04T22:42:15.000Z","discoveredAt","2026-11-05T01:52:47.662Z","timelineAt","category","industry","tags",[69],"score",82,"selected",true,"channel","news","story",{"_71":72,"_11":73},"x","readingMode","full","author","Terrence O’Brien","body","outline",[],"relatedStories",[70],"topics",[66],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fKfZx4ZXJ5pA","reportCount",1,"additionalSourceCount",0,{"_67":29,"_68":69},"slug","name","行业动态",{"_71":72,"_11":73},"publicId","c1d0b7cb-391c-471b-ac05-94aa6ef69f91","Qualcomm加码AI数据中心，2029年目标150亿美元","https://www.theverge.com/ai-artificial-intelligence/1026867/qualcomm-earnings-data-centers","The Verge · AI",{"_77":78,"_79":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":98},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","b0twggzbsffs4rtjlc67dnb8b","title","Reflection 发布 501B 开源模型 Beam，支持自有硬件部署与定制","originalTitle","Welcome Beam: a 501B open model you can own, customize, and scale","summary","Reflection 发布 501B 开源模型 Beam，采用 MoE 架构，每 token 激活 23B 参数，支持 1M 上下文，以 Apache 2.0 许可证开放。模型提供 BF16、FP8、NVFP4 三种格式，支持 transformers、vLLM、SGLang 推理及 SFT 和 RL 后训练方案，并附带 $10,000 Hub credits 项目竞赛。","reason","501B MoE 模型以 Apache 2.0 开放，支持 1M 上下文和自有硬件部署，为团队提供了可定制的前沿级选择。","source",{"_74":97},"links",{"_58":96},"publishedAt","2026-10-16T00:00:00.000Z","discoveredAt","2026-10-16T13:49:30.758Z","timelineAt","category","ai-models","tags",[75,92,93,81,94,95,87],"score",83,"selected",true,"channel","news","story",{"_89":90,"_11":91},"x","readingMode","full","author","body","outline",[],"relatedStories",[88],"topics",[65,66,67,68,69,70,71],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","fW8MHaL5gEe0","reportCount",4,"additionalSourceCount",3,{"_72":86,"_74":87},{"_72":84,"_74":85},{"_72":82,"_74":83},{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","model-releases","name","模型发布","mcp","MCP 与工具调用","engineering","部署工程","open-source","开源生态","reasoning","推理能力","coding","AI 编码","hugging-face","Hugging Face",{"_89":90,"_11":91},"publicId","5d42ff1c-75b1-4e0d-b8a9-0122e1a5a03e","Reflection AI 发布开源权重模型 Beam，已上架 Hugging Face 与 AWS","推理","编码","部署/工程","MCP/工具调用","https://huggingface.co/blog/reflection-beam","Hugging Face Blog",{"_99":100,"_101":-5},"changelogVersion","2026-10-01T08:00","release"]

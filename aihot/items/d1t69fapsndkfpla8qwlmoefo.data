[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","d1t69fapsndkfpla8qwlmoefo","title","Anthropic 推出 Claude 个人财务管理功能","originalTitle","Claude AI can plug directly into your bank account","summary","Anthropic宣布Claude新增个人财务管理功能，通过Plaid银行桥接平台实现账户读权限访问（不存储密码），可查询近两年交易记录、分析月度支出类别（房租/购物/食品等），并回答账单剩余天数、大额消费可行性等财务问题。该功能现面向美国Pro/Ultra/Max用户开放测试。此前OpenAI已在五月推出类似ChatGPT银行账户接入功能。","reason","与 OpenAI 五月推出的 ChatGPT 同类功能相比，Claude Personal Finance 通过 Plaid 平台实现银行账户读权限访问，并支持月度支出分析及财务建议查询。","source",{"_70":80},"links",{"_59":79},"publishedAt","2026-11-05T18:00:00.000Z","discoveredAt","2026-11-05T18:43:38.560Z","timelineAt","category","ai-products","tags",[71,78],"score",76,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author","Jess Weatherbed","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","f1Yszs4th7N4","reportCount",3,"additionalSourceCount",2,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","product-updates","name","产品更新","anthropic","Anthropic / Claude",{"_75":76,"_11":77},"publicId","2c2d472d-d089-4ff9-bea8-b100ee7ab4fd","Anthropic推Claude财务工具：Plaid银行桥接与消费分析","Anthropic","https://www.theverge.com/ai-artificial-intelligence/1027652/anthropic-claude-plaid-personal-finance","The Verge · AI",{"_82":83,"_84":-5},"changelogVersion","2026-10-01T08:00","release"]

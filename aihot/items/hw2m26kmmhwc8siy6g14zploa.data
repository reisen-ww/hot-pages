[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","hw2m26kmmhwc8siy6g14zploa","title","Hugging Face发布论文及基准：LLM评估研究新颖性存在显著偏差","originalTitle","Can we trust LLMs to judge whether a research idea is novel?","summary","Hugging Face发布论文及基准，揭示LLM评估研究新颖性存在显著偏差：测试6种模型时，提示词细微调整导致准确率波动超50个百分点；简单提示词（Claude Opus 4.6）成本仅$2.59且准确率达0.854，优于专用系统（$82.05/0.772）。研究显示AI生成内容评估易受提示词设计影响，且检索增强未显著提升判断稳定性。","reason","揭示了LLM作为新颖性评估工具的不可靠性，并指出简单提示词在成本效益上优于专用系统。","source",{"_70":83},"links",{"_58":82},"publishedAt","2026-10-27T16:12:42.000Z","discoveredAt","2026-10-27T16:24:37.460Z","timelineAt","category","paper","tags",[80,81,75],"score",84,"selected",true,"channel","news","story",{"_77":78,"_11":79},"x","readingMode","full","author","body","outline",[],"relatedStories",[76],"topics",[65,66,67],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","f06AU8y9Nr9c","reportCount",1,"additionalSourceCount",0,{"_68":74,"_70":75},{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","papers","name","论文研究","open-source","开源生态","hugging-face","Hugging Face",{"_77":78,"_11":79},"publicId","518e8c87-4588-4f72-a765-3eb871d97085","Hugging Face发布论文及基准：揭示LLM评估存在显著偏差","论文/研究","开源/仓库","https://huggingface.co/blog/allenai/novelty-bench","Hugging Face Blog",{"_85":86,"_87":-5},"changelogVersion","2026-10-01T08:00","release"]

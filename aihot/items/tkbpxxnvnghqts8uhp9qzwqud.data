[{"_1":2,"_3":4},"root",{"_5":68},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":-5,"_54":55,"_56":57},"id","tkbpxxnvnghqts8uhp9qzwqud","title","Artex AI 挖客工具遭公开暴露","originalTitle","Hundreds of Artex AI hacking tools found publicly exposed to the web","summary","安全研究人员发现 Artex AI 挖客工具遭公开暴露，已导致韩国金融业及微软云客户等多起大规模网络攻击。该工具为开源自主渗透测试系统，微软指出其攻击链可从侦察到数据窃取全程自动化，暴露原因包括弱密码和未启用多因素认证。Censys数据显示超过800个未授权实例长期暴露，部分攻击涉及支付和游戏公司。Artex 已宣布转为闭源，但仍有代码片段在GitHub可下载。","reason","原文揭示了 Artex 工具因配置不当被公开暴露的细节，包括其被用于韩国金融业攻击和微软云客户数据窃取案例，可作为评估开源AI工具安全风险的参考案例。","source",{"_61":67},"links",{"_57":66},"publishedAt","2026-11-06T18:44:38.000Z","discoveredAt","2026-11-07T12:10:28.718Z","timelineAt","category","industry","tags",[62,65],"score",77,"selected",true,"channel","news","story","x","readingMode","full","author","Zack Whittaker","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_60":63,"_61":64},{"_60":29,"_61":62},"slug","name","行业动态","safety","安全对齐","安全/对齐","https://techcrunch.com/2026/11/06/hundreds-of-artex-ai-hacking-tools-found-publicly-exposed-to-the-web/","TechCrunch · AI",{"_69":70,"_71":-5},"changelogVersion","2026-10-01T08:00","release"]

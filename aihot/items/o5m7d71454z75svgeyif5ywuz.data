[{"_1":2,"_3":4},"root",{"_5":75},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":34,"_52":53,"_54":55,"_56":34,"_57":58},"id","o5m7d71454z75svgeyif5ywuz","title","抗议者闯入微软阿姆斯特丹数据中心工地","originalTitle","Protesters break into Microsoft data center site in Amsterdam","summary","抗议者闯入微软阿姆斯特丹数据中心工地并悬挂‘fuck AI’标语。此前荷兰曾于2023年底宣布至2030年暂停新建数据中心，但该项目自2016年规划后仍持续推进，由英国开发商Pure Data Centres承建。本周同期的爱尔兰都柏林数据中心外，抗议者还设置了模拟以色列军事检查点的抗议装置。美国近期也出现多起否决数据中心扩建的投票案例。","reason","source",{"_67":74},"links",{"_58":73},"publishedAt","2026-11-06T11:55:19.000Z","discoveredAt","2026-11-07T12:09:25.822Z","timelineAt","category","industry","tags",[68],"score",73,"selected",false,"channel","news","story",{"_70":71,"_11":72},"x","readingMode","full","author","Tom Warren","body","outline",[],"relatedStories",[69],"topics",[65],"indexable","markdownAvailable",true,"group",{"_59":60,"_61":62,"_63":64},"hasTranslation","bodyLanguage","original","factId","fL326jvXcPiQ","reportCount",1,"additionalSourceCount",0,{"_66":28,"_67":68},"slug","name","行业动态",{"_70":71,"_11":72},"publicId","685c51fc-00eb-4861-8d29-872f9e2e3546","抗议者闯入微软阿姆斯特丹数据中心工地反对AI发展","https://www.theverge.com/news/1028549/protesters-microsoft-data-center-site-amsterdam","The Verge · AI",{"_76":77,"_78":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","bpiol9rvw3cvav1uu327fuxve","title","Granola 发布语音转写功能以竞争 Wispr","originalTitle","Granola crunches up a dictation feature to compete with Wispr","summary","Granola 发布 Mac 平台语音转写功能，支持全应用内笔记、指令生成和邮件/消息回复，免费无字数限制。该功能将扩展至 iOS 和 Windows，与 Wispr 的会议记录功能形成竞争。当前 Granola 和 Wispr 的估值分别为 15 亿美元和 20 亿美元。语音转写赛道正从单一工具向多功能集成演进，多家初创企业已整合会议记录与语音转写功能。","reason","Granola 通过集成语音转写功能与会议记录，展示了垂直领域工具的扩展方向，为同类产品竞争策略提供参考。","source",{"_70":80},"links",{"_59":79},"publishedAt","2026-10-29T17:54:38.000Z","discoveredAt","2026-10-29T18:38:11.092Z","timelineAt","category","ai-products","tags",[71,78],"score",84,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author","Ivan Mehta","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fHgBHvOsK5a0","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","product-updates","name","产品更新","voice","语音与音频",{"_75":76,"_11":77},"publicId","998d1f6b-968e-4583-92c1-d177e1be7761","Granola推出免费语音转写功能并扩展至多平台竞争Wispr","语音","https://techcrunch.com/2026/10/29/granola-crunches-up-a-dictation-feature-to-compete-with-wispr/","TechCrunch · AI",{"_82":83,"_84":-5},"changelogVersion","2026-10-01T08:00","release"]

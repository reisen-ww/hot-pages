[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":24,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":35,"_51":35,"_52":-5,"_53":54,"_55":56},"id","jkf0rvt4vggwh0jp58gv5sk3t","title","Google DeepMind发布PlanAssist工具，助力英国规划审批提速58%","originalTitle","Speeding up planning decisions with AI","summary","Google DeepMind发布AI规划审批工具PlanAssist，经Barnet、Camden、Dorset试点验证，可将规划官评估时间最高缩短58%，70%自动生成报告无需人工修改。该工具计划于2027年扩展至全英15个地区，通过自动化处理常规申请，使规划官能专注于复杂决策。","reason","工具展示了AI在公共服务中的实际应用效果，包括效率提升和合规性验证，为类似场景提供可复用的方法论。","source",{"_62":71},"links",{"_56":70},"publishedAt","2026-10-30T14:18:30.000Z","discoveredAt","2026-11-02T10:46:36.953Z","timelineAt","category","ai-products","tags",[63,68,69],"score",62,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[57,58,59],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_60":66,"_62":67},{"_60":64,"_62":65},{"_60":61,"_62":63},"slug","product-updates","name","产品更新","open-source","开源生态","google","Google / Gemini","开源/仓库","Google","https://deepmind.google/blog/speeding-up-planning-decisions-with-ai/","Google DeepMind",{"_73":74,"_75":-5},"changelogVersion","2026-10-01T08:00","release"]

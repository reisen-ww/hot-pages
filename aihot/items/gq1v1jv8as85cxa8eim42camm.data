[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":24,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":35,"_51":35,"_52":-5,"_53":54,"_55":56},"id","gq1v1jv8as85cxa8eim42camm","title","Google Research 介绍自动化连贯长视频生成框架","originalTitle","Automating coherent long-form video generation","summary","Google Research 介绍一套基于 Gemini 和 Veo 的多智能体视频生成框架，用于自动规划多镜头叙事、维护视觉连续性并生成分钟级视频。框架包含 Co-Director、CANVAS、A²RD 和 VQQA，分别处理创意编排、视觉记忆、长时序生成与闭环提示词优化；AI video co-director 在 GenAD-Bench 上取得 81.4 的峰值质量分数。","reason","文章将长视频生成拆为创意编排、视觉连续性、时间动态和闭环优化四个环节，并配套基准，便于理解多智能体如何缓解跨镜头漂移。","source",{"_63":76},"links",{"_56":75},"publishedAt","2026-09-24T19:40:00.000Z","discoveredAt","2026-10-08T03:56:31.044Z","timelineAt","category","paper","tags",[71,72,73,74],"score",65,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[57,58,59,60],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_61":69,"_63":70},{"_61":67,"_63":68},{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","papers","name","论文研究","video","AI 视频","agent","Agent 智能体","google","Google / Gemini","论文/研究","Agent","视频","Google","https://research.google/blog/coherent-long-form-video-generation/","Google Research",{"_78":79,"_80":-5},"changelogVersion","2026-10-01T08:00","release"]

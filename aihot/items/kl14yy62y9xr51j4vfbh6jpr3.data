[{"_1":2,"_3":4},"root",{"_5":80},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","kl14yy62y9xr51j4vfbh6jpr3","title","Tinker Inkling 2 Small发布：17A-594B模型仅用68小时训练，多模态性能超越Muse Spark","originalTitle","[AINews] Inkling 2 Small: 17A-594B trained in 68 hours on 12T tokens, beating Muse Spark","summary","Tinker Inkling 2 Small发布，该模型以17A-594B参数量在68小时内完成训练，多模态性能超越Muse Spark，成本仅为后者1/8。测试显示其在自动化编程、推理和视觉生成任务中表现优异，但输出token数量较高可能影响长任务效率。","reason","原文提供了Inkling 2 Small在多个基准测试中的性能数据、训练效率及成本优势，并提到其MoE架构和定制化能力，为开发者评估其适用性提供参考。","source",{"_70":79},"links",{"_59":78},"publishedAt","2026-11-06T10:35:21.000Z","discoveredAt","2026-11-07T12:10:33.024Z","timelineAt","category","ai-products","tags",[71,73],"score",81,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author","swyx .ai","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fOFIKlGgblFg","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","product-updates","name","产品更新","model-releases","模型发布",{"_75":76,"_11":77},"publicId","85edcbbf-f2b3-4cc3-a3c3-0e24502c4693","Inkling 2 Small发布：17A-594B模型训练效率与成本突破","https://latent.space/p/ainews-inkling-2-small-17a-594b-trained-in-68-hours-on-12t-tokens-beating-muse-spark/","Latent Space",{"_81":82,"_83":-5},"changelogVersion","2026-10-01T08:00","release"]

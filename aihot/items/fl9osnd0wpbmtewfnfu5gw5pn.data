[{"_1":2,"_3":4},"root",{"_5":74},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":-5,"_54":55,"_56":57},"id","fl9osnd0wpbmtewfnfu5gw5pn","title","OpenAI AI 证明数学与物理学重大理论，引发学界争议","originalTitle","OpenAI asks outside experts, including a Nobel laureate, to check proofs its AI produced in math, computer science, and physics","summary","OpenAI AI 证明数学中的ETH理论不成立及量子场论存在性，专家呼吁独立验证。该成果可能颠覆多项依赖ETH的论文基础，但OpenAI承诺公开数据并资助研讨会。物理学领域方面，AI首次证明四维量子场论存在性，涉及强相互作用理论，但尚未解决质量间隙问题。计算机科学领域，AI证明ETH不成立，但专家对其实际应用价值持谨慎态度。","reason","OpenAI 的 AI 证明挑战了数学和物理学的基础理论，引发学界对AI验证复杂证明的信任与验证流程的讨论。","source",{"_63":73},"links",{"_57":72},"publishedAt","2026-10-27T12:37:24.000Z","discoveredAt","2026-10-27T13:34:23.662Z","timelineAt","category","paper","tags",[69,70,71],"score",81,"selected",true,"channel","news","story","x","readingMode","full","author","Maximilian Schreiner","body","outline",[],"relatedStories",[],"topics",[58,59,60],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_61":67,"_63":68},{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","papers","name","论文研究","safety","安全对齐","openai","OpenAI / ChatGPT","论文/研究","安全/对齐","OpenAI","https://the-decoder.com/openai-asks-outside-experts-including-a-nobel-laureate-to-check-proofs-its-ai-produced-in-math-computer-science-and-physics/","The Decoder",{"_75":76,"_77":-5},"changelogVersion","2026-10-01T08:00","release"]

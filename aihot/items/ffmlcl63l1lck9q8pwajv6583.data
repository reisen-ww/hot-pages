[{"_1":2,"_3":4},"root",{"_5":76},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","ffmlcl63l1lck9q8pwajv6583","title","Uber第三季度仅完成4次AI代理行程","originalTitle","Uber only fulfilled 4 rides from AI agents last quarter","summary","Uber第三季度财报显示仅4次行程由第三方AI代理完成，同期万圣节期间AI代理处理了约500单外卖订单。Uber CEO重申将优先优化自有平台体验（已上线AI购物车助手），同时保持与第三方AI公司的合作开放性。","reason","原文提供了平台与AI代理合作初期的用户行为数据（4次行程/500单订单），并对比了平台自研工具（Cart Assistant）与第三方代理的竞争策略。","source",{"_68":75},"links",{"_59":74},"publishedAt","2026-11-04T15:58:45.000Z","discoveredAt","2026-11-04T16:37:24.027Z","timelineAt","category","industry","tags",[69],"score",79,"selected",true,"channel","news","story",{"_71":72,"_11":73},"x","readingMode","full","author","Andrew J. Hawkins","body","outline",[],"relatedStories",[70],"topics",[66],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fL53KgBvxZVI","reportCount",2,"additionalSourceCount",1,{"_67":29,"_68":69},"slug","name","行业动态",{"_71":72,"_11":73},"publicId","63e3a7ad-3104-40f8-b469-2bdbc16de569","Uber AI代理乘车使用率极低，CEO强调自有平台优先","https://www.theverge.com/transportation/1026306/uber-ai-agents-q3-earnings-disintermediation","The Verge · AI",{"_77":78,"_79":-5},"changelogVersion","2026-10-01T08:00","release"]

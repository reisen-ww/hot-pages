[{"_1":2,"_3":4},"root",{"_5":67},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":-5,"_38":-5,"_39":40,"_41":42,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":-5,"_54":34,"_55":56},"id","ohcmsvv5yucapbg5fkny6frqs","title","Anthropic AI 花费停滞，价格竞争影响 IPO 前景","originalTitle","Ramp data shows AI spending stalling just as Anthropic nears its IPO","summary","根据 Ramp 的数据，尽管 AI 交易量上升，但 AI 花费在夏季末期停滞，仅增长 1.5%，显示出价格竞争和精明的客户可能限制 OpenAI 和 Anthropic 的收入增长。随着 Anthropic 近期 IPO，投资者可能低估了 AI 公司的增速放缓。价格竞争使得使用 AI 更便宜，同时企业变得更加节俭，这些因素共同导致了 AI 花费的放缓。","reason","source",{"_61":66},"links",{"_56":65},"publishedAt","2026-11-06T15:54:47.000Z","discoveredAt","2026-11-07T12:10:33.501Z","timelineAt","category","industry","tags",[63,64],"score",39,"selected",false,"channel","news","story","x","readingMode","full","author","Rebecca Bellan","body","outline",[],"relatedStories",[],"topics",[57,58],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_59":28,"_61":63},{"_59":60,"_61":62},"slug","policy","name","政策监管","行业动态","政策/监管","https://techcrunch.com/2026/11/06/ramp-data-shows-ai-spending-stalling-just-as-anthropic-nears-its-ipo/","TechCrunch · AI",{"_68":69,"_70":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":62},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":-5,"_54":55,"_56":57},"id","dratml2r39dff1h3ew8es1drt","title","Alex Stamos谈AI如何颠覆网络安全：从攻击到防御的范式转变","originalTitle","AI broke the cybersecurity world. What’s next?","summary","Alex Stamos指出，AI使攻击成本趋近于零，防御成本居高不下，迫使企业主动采用AI红队测试和自动化修复，以应对快速演变的威胁。文中以Binance、Cursor等案例说明攻击链的自动化，并强调防御需从漏洞修复转向架构重构，如建议Google和Amazon重写Linux内核以减少漏洞。最后提出建立行业指标追踪漏洞修复进展。","reason","AI降低了攻击成本并提高了防御成本，迫使企业主动采用AI红队测试和自动化修复，以应对快速演变的威胁。","source",{"_60":61},"links",{"_57":59},"publishedAt","2026-11-07T15:00:00.000Z","discoveredAt","2026-11-07T15:44:32.618Z","timelineAt","category","industry","tags",[58],"score",82,"selected",true,"channel","news","story","x","readingMode","full","author","Nilay Patel","body","outline",[],"relatedStories",[],"topics",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","其他","https://www.theverge.com/podcast/1029038/ai-cybersecurity-hackers-data-breach-dark-age-alex-stamos","name","The Verge · AI",{"_63":64,"_65":-5},"changelogVersion","2026-10-01T08:00","release"]

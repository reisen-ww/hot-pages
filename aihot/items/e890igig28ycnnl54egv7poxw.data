[{"_1":2,"_3":4},"root",{"_5":75},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":34,"_52":53,"_54":55,"_56":34,"_57":58},"id","e890igig28ycnnl54egv7poxw","title","Meta警告选举后反数据中心情绪或阻碍AI扩展","originalTitle","Meta warns that election backlash against data centers could make AI expansion harder","summary","Meta警告选举后的反数据中心情绪可能阻碍AI技术扩展，其应对策略包括本地化合作与Muse用户增长。Meta当前拥有23州数据中心，5个超1吉瓦项目（含得州），正通过承担电费、税收反哺社区、本地化就业等措施争取支持。公司预计AI助手Muse用户数将突破1亿，目标服务十亿用户，同时强调数据中心的计算资源价值。","reason","source",{"_67":74},"links",{"_58":73},"publishedAt","2026-11-05T19:12:39.000Z","discoveredAt","2026-11-05T19:40:10.051Z","timelineAt","category","industry","tags",[68],"score",71,"selected",false,"channel","news","story",{"_70":71,"_11":72},"x","readingMode","full","author","Sarah Perez","body","outline",[],"relatedStories",[69],"topics",[65],"indexable","markdownAvailable",true,"group",{"_59":60,"_61":62,"_63":64},"hasTranslation","bodyLanguage","original","factId","fyTO9ACQfkaE","reportCount",1,"additionalSourceCount",0,{"_66":28,"_67":68},"slug","name","行业动态",{"_70":71,"_11":72},"publicId","9b7747ae-fd62-496e-a6dc-d0b52a85df77","Meta警告选举后反数据中心情绪或阻碍AI扩张，采取本地合作与Muse用户增长应对","https://techcrunch.com/2026/11/05/metas-warns-that-election-backlash-against-data-centers-could-make-ai-expansion-harder/","TechCrunch · AI",{"_76":77,"_78":-5},"changelogVersion","2026-10-01T08:00","release"]

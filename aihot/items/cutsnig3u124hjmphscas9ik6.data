[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":24,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":-5,"_54":55,"_56":57},"id","cutsnig3u124hjmphscas9ik6","title","微软研究院：把物理 AI 推理卸载到边缘或云端可提升机器人表现与续航","originalTitle","Offloaded inference for real-world physical AI robotics","summary","微软研究院对移动操作机器人工作负载做了系统性测量，发现把物理 AI 推理从机器人端侧 GPU 卸载到边缘或云端 GPU，能提升任务成功率、支持更大的模型并延长续航。","reason","微软研究院系统测量了机器人端侧推理的瓶颈，并给出可复用的卸载工具链，读者可据此判断物理 AI 的部署取舍。","source",{"_65":80},"links",{"_57":79},"publishedAt","2026-09-23T16:01:36.000Z","discoveredAt","2026-10-06T14:40:42.832Z","timelineAt","category","paper","tags",[75,72,76,77,78],"score",62,"selected",true,"channel","news","story","x","readingMode","full","author","Ganesh Ananthanarayanan, Matthew Balkwill, Xenofon Foukas, Sanjeev Mehrotra, Bozidar Radunovic, Connor Settle, Ankit Verma, David White, Shawn Cicoria, Mark Martin, Rachel Johnson, Mayur Patel","body","outline",[],"relatedStories",[],"topics",[58,59,60,61,62],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_63":73,"_65":74},{"_63":71,"_65":72},{"_63":69,"_65":70},{"_63":67,"_65":68},{"_63":64,"_65":66},"slug","papers","name","论文研究","engineering","部署工程","open-source","开源生态","embodied","具身智能","microsoft","Microsoft / Copilot","论文/研究","部署/工程","开源/仓库","Microsoft","https://www.microsoft.com/en-us/research/blog/offloaded-inference-for-real-world-physical-ai-robotics/","Microsoft Research",{"_82":83,"_84":-5},"changelogVersion","2026-10-01T08:00","release"]

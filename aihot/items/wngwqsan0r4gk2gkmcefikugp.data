[{"_1":2,"_3":4},"root",{"_5":68},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":-5,"_38":-5,"_39":40,"_41":42,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":-5,"_54":34,"_55":56},"id","wngwqsan0r4gk2gkmcefikugp","title","OpenAI正试图左右2028大选的AI政策框架","originalTitle","OpenAI is already trying to shape the 2028 election","summary","OpenAI首席政策官Chris Lehane在2028大选前夕发布政策框架，主张通过税收激励、教育普及和AI安全标准扩大AI经济红利，但被学界质疑回避技术垄断问题。其政策与OpenAI2024年反对加州AI安全法案立场矛盾，且未提出防止AI收益集中的具体方案。材料显示Lehane将AI经济潜力与中产阶层成功绑定，但未论证如何防止企业权力固化。","reason","source",{"_61":67},"links",{"_56":66},"publishedAt","2026-11-04T21:25:44.000Z","discoveredAt","2026-11-05T01:52:49.586Z","timelineAt","category","opinion","tags",[64,65],"score",72,"selected",false,"channel","news","story","x","readingMode","full","author","Rebecca Bellan","body","outline",[],"relatedStories",[],"topics",[57,58],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_59":63,"_61":64},{"_59":60,"_61":62},"slug","policy","name","政策监管","opinions","大佬观点","政策/监管","https://techcrunch.com/2026/11/04/openai-is-already-trying-to-shape-the-2028-election/","TechCrunch · AI",{"_69":70,"_71":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","awr86jk4n06059t0mjvacyhhz","title","Greenlight Financial 构建基于 AWS Bedrock AgentCore 的自主 SOC 解决方案","originalTitle","How Greenlight Financial built an autonomous SOC solution on Amazon Bedrock AgentCore","summary","Greenlight Financial 通过 AWS Bedrock AgentCore 构建自主安全运营中心（SOC），实现90%以上安全风险自动化处理。系统采用分层架构：一级代理处理常规预警（秒级响应），二级代理通过多源数据链式推理处理复杂案例。","reason","展示了如何利用AWS Bedrock AgentCore构建多层级AI安全系统，并通过持续学习提升自动化处理能力达90%，提供可复用的架构设计、工具链和合规实践","source",{"_70":80},"links",{"_59":79},"publishedAt","2026-11-06T16:55:05.000Z","discoveredAt","2026-11-07T12:10:42.923Z","timelineAt","category","ai-products","tags",[71,78],"score",80,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author","Adam Maksimuk","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fj4AFjFWO8NI","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","product-updates","name","产品更新","safety","安全对齐",{"_75":76,"_11":77},"publicId","7b2630e5-0655-43ec-a83c-84c6b3e934bf","Greenlight Financial 构建基于 AWS Bedrock AgentCore 的自主安全运营中心","安全/对齐","https://aws.amazon.com/blogs/machine-learning/how-greenlight-financial-built-an-autonomous-soc-solution-on-amazon-bedrock-agentcore/","AWS Machine Learning Blog",{"_82":83,"_84":-5},"changelogVersion","2026-10-01T08:00","release"]

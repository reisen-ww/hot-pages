[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","edlmdqjxcr7ko5xkugypyao1d","title","Meta Muse AI 发布定制化应用界面功能 spaces","originalTitle","Meta&#8217;s Muse AI can create custom &#8216;spaces&#8217; for the version of the app you need right now","summary","Meta Muse AI 新增 spaces 功能，允许用户通过描述创建定制化应用界面（如购物中心、学校仪表盘等），并与外部工具（如 Gmail、Google Calendar）实时同步数据。同时引入 Active Memory 和 Active Focus 能力，提升上下文理解与目标导向能力。该功能已面向所有 Muse 用户开放，未来计划支持空间共享与协作。","reason","原文给出了能力变化和开放入口，读者可以据此判断它会怎样改变现有工作流。","source",{"_71":84},"links",{"_59":83},"publishedAt","2026-11-06T18:10:10.000Z","discoveredAt","2026-11-07T12:09:25.506Z","timelineAt","category","ai-products","tags",[72,81,82],"score",82,"selected",true,"channel","news","story",{"_78":79,"_11":80},"x","readingMode","full","author","Emma Roth","body","outline",[],"relatedStories",[77],"topics",[66,67,68],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","feWYe14fOYNE","reportCount",1,"additionalSourceCount",0,{"_69":75,"_71":76},{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","product-updates","name","产品更新","mcp","MCP 与工具调用","meta","Meta / Llama",{"_78":79,"_11":80},"publicId","6858ebba-4036-4dd7-b451-91c2907613db","Meta开放Muse AI自定义界面功能并计划共享协作","MCP/工具调用","Meta","https://www.theverge.com/tech/1028871/meta-muse-ai-spaces","The Verge · AI",{"_86":87,"_88":-5},"changelogVersion","2026-10-01T08:00","release"]

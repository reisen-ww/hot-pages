[{"_1":2,"_3":4},"root",{"_5":75},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":34,"_52":53,"_54":55,"_56":34,"_57":58},"id","z4xr0l48crncg5xag8a9xjl1l","title","Agility Robotics 首赴纳斯达克：人形机器人商业化进程引关注","originalTitle","Agility Robotics' Nasdaq debut invites scrutiny of humanoid robot market","summary","Agility Robotics 于 2026 年 11 月 5 日在纳斯达克上市，成为首个专注人形机器人且成功登陆美股的企业。公司此前已在 2024 年实现人形机器人全时商业部署，当前上市计划聚焦通过租赁或销售服务为机器人提供 manual labor（人工劳动替代）场景的盈利模式。","reason","source",{"_67":74},"links",{"_58":73},"publishedAt","2026-11-05T12:00:41.000Z","discoveredAt","2026-11-05T12:45:56.640Z","timelineAt","category","industry","tags",[68],"score",56,"selected",false,"channel","news","story",{"_70":71,"_11":72},"x","readingMode","full","author","Jeremy Hsu","body","outline",[],"relatedStories",[69],"topics",[65],"indexable","markdownAvailable",true,"group",{"_59":60,"_61":62,"_63":64},"hasTranslation","bodyLanguage","original","factId","fKU6YjInllHg","reportCount",1,"additionalSourceCount",0,{"_66":28,"_67":68},"slug","name","行业动态",{"_70":71,"_11":72},"publicId","d53b63bd-ccef-4959-8fb0-f6ac6ef3ff88","Agility Robotics纳斯达克IPO确立人形机器人商业化路径","https://arstechnica.com/ai/2026/11/agility-robotics-nasdaq-debut-invites-scrutiny-of-humanoid-robot-market/","Ars Technica · AI",{"_76":77,"_78":-5},"changelogVersion","2026-10-01T08:00","release"]

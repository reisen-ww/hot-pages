[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","qloeln1fz7m1p13bqgepbycjo","title","AWS发布Web Answer：Bedrock AgentCore智能体快速获取带引用的实时答案","originalTitle","Getting started with Web Answer on Amazon Bedrock AgentCore","summary","AWS宣布在Bedrock AgentCore中推出Web Answer工具，可让智能体快速生成带引用的实时答案。该工具整合搜索、验证、合成和引用流程，支持自定义域过滤、日期范围和地区本地化，与Web Search工具形成互补（前者提供完整答案，后者返回原始搜索结果）。","reason","原文给出了能力变化和开放入口，读者可以据此判断它会怎样改变现有工作流。","source",{"_70":80},"links",{"_59":79},"publishedAt","2026-11-05T21:04:24.000Z","discoveredAt","2026-11-05T21:15:17.475Z","timelineAt","category","ai-products","tags",[71,78],"score",65,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author","Adrianna Chudy","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fPpli8-MQ7b0","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","product-updates","name","产品更新","agent","Agent 智能体",{"_75":76,"_11":77},"publicId","d868a2f8-482b-435e-b3f3-2b71f42000ce","AWS发布Bedrock AgentCore的Web Answer工具，提供实时带引用答案","Agent","https://aws.amazon.com/blogs/machine-learning/getting-started-with-web-answer-on-amazon-bedrock-agentcore/","AWS Machine Learning Blog",{"_82":83,"_84":-5},"changelogVersion","2026-10-01T08:00","release"]

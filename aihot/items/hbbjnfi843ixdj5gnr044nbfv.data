[{"_1":2,"_3":4},"root",{"_5":96},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","hbbjnfi843ixdj5gnr044nbfv","title","ALTK-Evolve 用学习式记忆让 GPT-4.1 智能体登上 τ²-bench 零售榜第一","originalTitle","ALTK-Evolve: How learned memory tops the τ²-bench leaderboard on customer service tasks without a frontier model","summary","IBM Research 在 Hugging Face 发布 ALTK-Evolve，用 GPT-4.1 从智能体自身训练轨迹中蒸馏出行为规则并追加到系统提示词，在不更新模型权重、无人工标注的情况下提升客服智能体表现。","reason","通过同一基准上基线与加规则的对照数据，读者可量化提示词级记忆对准确率与可靠性的实际增益及成本代价。","source",{"_73":95},"links",{"_58":94},"publishedAt","2026-10-20T15:19:48.000Z","discoveredAt","2026-10-20T15:58:23.788Z","timelineAt","category","paper","tags",[89,90,91,92,93,84],"score",60,"selected",true,"channel","news","story",{"_86":87,"_11":88},"x","readingMode","full","author","body","outline",[],"relatedStories",[85],"topics",[65,66,67,68,69,70],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","fA_-44A_3X4w","reportCount",1,"additionalSourceCount",0,{"_71":83,"_73":84},{"_71":81,"_73":82},{"_71":79,"_73":80},{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","benchmarks","name","评测基准","papers","论文研究","open-source","开源生态","reasoning","推理能力","agent","Agent 智能体","hugging-face","Hugging Face",{"_86":87,"_11":88},"publicId","be21cd59-c2b6-431f-93bc-a265b793382d","ALTK-Evolve 学习记忆登顶 τ²-bench 零售榜","论文/研究","评测/基准","Agent","推理","开源/仓库","https://huggingface.co/blog/ibm-research/altk-evolve-bc","Hugging Face Blog",{"_97":98,"_99":-5},"changelogVersion","2026-10-01T08:00","release"]

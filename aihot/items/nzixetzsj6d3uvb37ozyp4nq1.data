[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","nzixetzsj6d3uvb37ozyp4nq1","title","微软发布PDD Kit工具：形式化验证AI生成的全栈Web应用登录逻辑","originalTitle","Formally verifying agent-written full-stack web apps with PDD Kit","summary","微软研究团队发布PDD Kit工具，通过Verus语言形式化验证Rust编写的Pet Store登录逻辑。工具将用户意图转化为形式化规格，自动生成覆盖所有输入的数学证明（如密码验证必须关联账户），并针对无法证明的部分（如数据库查询）生成测试用例。","reason","PDD Kit 通过形式化验证和测试结合，提供了一种可扩展的审查方法，适用于需要高安全性的全栈应用开发","source",{"_70":81},"links",{"_59":80},"publishedAt","2026-11-05T16:00:00.000Z","discoveredAt","2026-11-05T17:12:39.870Z","timelineAt","category","paper","tags",[78,79],"score",65,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author","Alex Lavaee, Matthai Philipose","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fus7PyC1SvUA","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","papers","name","论文研究","safety","安全对齐",{"_75":76,"_11":77},"publicId","8753e292-99f4-4f26-ab96-a27681bc9509","微软发布PDD Kit工具形式化验证AI全栈Web应用登录逻辑","论文/研究","安全/对齐","https://www.microsoft.com/en-us/research/blog/formally-verifying-agent-written-full-stack-web-apps-with-pdd-kit/","Microsoft Research",{"_83":84,"_85":-5},"changelogVersion","2026-10-01T08:00","release"]

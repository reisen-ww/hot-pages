[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","iktf40rxnga3r2r6vsffkdb54","title","Agile Deliberation框架：AI如何协助人类界定主观概念灰色区域","originalTitle","Agile Deliberation: How AI helps humans define the gray areas","summary","Google Research提出协作式AI框架Agile Deliberation，通过迭代对话帮助用户定义主观概念边界，实验显示模型准确率提升25%。该框架包含概念界定（概念scoping）和概念迭代（概念iteration）两阶段，在健康食品和付费内容审核等复杂场景中验证了用户认知疲劳降低和边界定义精准度提升效果。","reason","提出协作式AI框架解决主观概念分类问题，实验显示用户参与度提升30%，模型准确率提高25%。","source",{"_69":80},"links",{"_58":79},"publishedAt","2026-11-04T18:07:05.000Z","discoveredAt","2026-11-05T01:52:53.124Z","timelineAt","category","paper","tags",[77,78],"score",79,"selected",true,"channel","news","story",{"_74":75,"_11":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[65,66],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","f4Stt2v9WlB8","reportCount",1,"additionalSourceCount",0,{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","papers","name","论文研究","open-source","开源生态",{"_74":75,"_11":76},"publicId","0fb02b04-ceed-4430-b2e8-dee6ba97913a","Google开源协作式AI框架并公布实验数据","论文/研究","开源/仓库","https://research.google/blog/agile-deliberation-how-ai-helps-humans-define-the-gray-areas/","Google Research",{"_82":83,"_84":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":34,"_52":53,"_54":55,"_56":34,"_57":58},"id","k6fp59vu9v40eatuzqbmlvdgf","title","Discovered Materials 设立百万美元挑战：AI求解五大材料科学难题","originalTitle","A YC startup is putting $1M behind 5 unsolved materials science problems for AI","summary","Discovered Materials（YC 2026春班初创公司）宣布设立100万美元挑战，目标为AI解决五大材料科学难题：解释超导机制、预测硅二氧化硅界面结构、关联晶格结构与热性能、解释光照改变材料行为、优化密度泛函理论计算。此前公司尝试用前沿AI模型自主攻关但进展有限，现通过设立挑战推动领域发展，并透露对一年内产出工业级材料更具信心。","reason","source",{"_68":76},"links",{"_58":75},"publishedAt","2026-11-05T13:00:00.000Z","discoveredAt","2026-11-05T13:24:17.972Z","timelineAt","category","paper","tags",[74],"score",73,"selected",false,"channel","news","story",{"_71":72,"_11":73},"x","readingMode","full","author","Tim Fernholz","body","outline",[],"relatedStories",[70],"topics",[65],"indexable","markdownAvailable",true,"group",{"_59":60,"_61":62,"_63":64},"hasTranslation","bodyLanguage","original","factId","fJJSClInN2kc","reportCount",1,"additionalSourceCount",0,{"_66":67,"_68":69},"slug","papers","name","论文研究",{"_71":72,"_11":73},"publicId","b3f75a22-cd31-431c-9a21-351adf7f3504","Discovered Materials发起百万美元AI材料科学挑战","论文/研究","https://techcrunch.com/2026/11/05/a-yc-startup-is-putting-1m-behind-five-unsolved-materials-science-problems-for-ai/","TechCrunch · AI",{"_78":79,"_80":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":74},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","mtu3hnhbvo1ejtadx8roukllu","title","NVIDIA全栈代码设计如何提升AI工厂内存效率","originalTitle","More Performance From Every Byte: How Full-Stack Codesign Solves AI’s Memory Challenge","summary","NVIDIA通过全栈代码设计优化AI工厂内存使用，实测吞吐量提升达30倍。关键技术包括：1）采用NVFP4格式将模型权重压缩至4位精度，2）NVL72系统支持72GPU分布式加载模型，3）CMX存储层将闲置上下文迁移至低成本存储，4）NVIDIA Vera CPU加速工具调用缩短上下文缓存空闲时间。","reason","原文提供了NVIDIA全栈代码设计如何提升AI工厂内存效率的具体技术路径和实测数据","source",{"_72":73},"links",{"_59":71},"publishedAt","2026-11-05T16:00:00.000Z","discoveredAt","2026-11-05T16:11:44.420Z","timelineAt","category","industry","tags",[70],"score",74,"selected",true,"channel","news","story",{"_67":68,"_11":69},"x","readingMode","full","author","Amr Elmeleegy","body","outline",[],"relatedStories",[66],"topics",[],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fnrDIEEyNBE4","reportCount",1,"additionalSourceCount",0,{"_67":68,"_11":69},"publicId","21c02b38-259d-4256-a0dc-b4d3ae71da03","NVIDIA全栈设计提升AI工厂内存效率30倍","其他","https://blogs.nvidia.com/blog/memory-full-stack-codesign/","name","NVIDIA Blog",{"_75":76,"_77":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":75},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":34,"_52":53,"_54":55,"_56":34,"_57":58},"id","vx1azrzvnqrz0kwfxun06rsa1","title","苹果削减内部AI预算，计划进一步降至$25/日","originalTitle","Apple slashes internal AI budgets, with deeper cuts still planned","summary","苹果将部分工程师的每日AI令牌预算从$300削减至$200，并计划进一步降至$100或$25（非技术团队）。员工可申请例外权限，部分团队将转向本地运行或更低价模型。此举与CEO John Ternus推动公司精简战略一致。据Bloomberg报道，微软、特斯拉、Uber和Meta近期也采取了类似内部AI预算管控措施。","reason","source",{"_67":74},"links",{"_58":73},"publishedAt","2026-11-05T14:03:14.000Z","discoveredAt","2026-11-05T14:38:44.681Z","timelineAt","category","industry","tags",[68],"score",73,"selected",false,"channel","news","story",{"_70":71,"_11":72},"x","readingMode","full","author","Maximilian Schreiner","body","outline",[],"relatedStories",[69],"topics",[65],"indexable","markdownAvailable",true,"group",{"_59":60,"_61":62,"_63":64},"hasTranslation","bodyLanguage","original","factId","fEbwswA3--4s","reportCount",2,"additionalSourceCount",1,{"_66":28,"_67":68},"slug","name","行业动态",{"_70":71,"_11":72},"publicId","66f6a5bd-45fc-4011-b4b2-a981205ff7eb","Apple cuts AI daily budget for engineering teams, considering $25 cap","https://the-decoder.com/apple-slashes-internal-ai-budgets-with-deeper-cuts-still-planned/","The Decoder",{"_76":77,"_78":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":80},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","t7jkps8q9ew4urouvzup9zoyr","title","OpenAI宣布数据中台项目不再使用NDAs并与社区加强合作","originalTitle","OpenAI is stepping back from NDAs for data center projects","summary","OpenAI宣布在数据中台项目中不再与公共官员签订保密协议（NDAs），并推出多项社区承诺：支付全额电费、公开招聘计划、未来所有计算园区均需遵守本地优先原则。此前亚马逊已宣布类似政策，显示行业正逐步减少对NDAs的依赖。","reason","对比亚马逊等同行，OpenAI的NDAs政策调整反映了行业对透明度的重视，可作为评估企业社区责任的新参考。","source",{"_69":79},"links",{"_59":78},"publishedAt","2026-11-06T00:37:56.000Z","discoveredAt","2026-11-06T00:47:34.615Z","timelineAt","category","industry","tags",[70,77],"score",78,"selected",true,"channel","news","story",{"_74":75,"_11":76},"x","readingMode","full","author","Jay Peters","body","outline",[],"relatedStories",[73],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","ffGAscs0xpyo","reportCount",1,"additionalSourceCount",0,{"_68":71,"_69":72},{"_68":29,"_69":70},"slug","name","行业动态","openai","OpenAI / ChatGPT",{"_74":75,"_11":76},"publicId","5ee51220-1598-4709-a94a-a2edf89f04d5","OpenAI停止与公共官员签订NDAs并推出社区合作新规","OpenAI","https://www.theverge.com/ai-artificial-intelligence/1028454/openai-data-center-nda","The Verge · AI",{"_81":82,"_83":-5},"changelogVersion","2026-10-01T08:00","release"]

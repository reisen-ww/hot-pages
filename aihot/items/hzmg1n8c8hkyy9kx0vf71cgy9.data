[{"_1":2,"_3":4},"root",{"_5":87},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":-5,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":34,"_52":34,"_53":54,"_55":56,"_57":58},"id","hzmg1n8c8hkyy9kx0vf71cgy9","title","NVIDIA Vera CPU 发布：兼顾高速与高能效","originalTitle","Vera Delivers the Best of Both Worlds: Highest Throughput and Fastest Agents","summary","NVIDIA Vera CPU在100兆瓦数据中心测试中，速度超越最快x86 CPU且能效比提升1.6倍，支持更多AI智能体并行执行。测试显示Perplexity的编程任务速度提升1.5倍，DeepInfra的编排任务速度达2.2倍，ClickHouse在176核下突破硬件排行榜，DuckLabs的TPC-H测试性能超中位数1.5倍。","reason","Vera CPU在多任务处理和能效比上显著优于传统x86架构，为AI工厂提供高效执行解决方案。","source",{"_71":86},"links",{"_58":85},"publishedAt","2026-11-05T20:00:41.000Z","discoveredAt","2026-11-05T21:15:15.235Z","timelineAt","category","tags",[72,83,84],"score",78,"selected",true,"channel","news","story",{"_80":81,"_11":82},"x","readingMode","full","author","Hannah Coutand","body","outline",[],"relatedStories",[79],"topics",[65,66,67,68],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","ffJdkjbTHlOU","reportCount",1,"additionalSourceCount",0,{"_69":77,"_71":78},{"_69":75,"_71":76},{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","product-updates","name","产品更新","on-device","端侧 AI","reasoning","推理能力","nvidia","NVIDIA 英伟达",{"_80":81,"_11":82},"publicId","d6f0d3ab-19fa-4c63-a2cb-6c0877626111","NVIDIA发布Vera CPU：单芯片实现高性能与高能效比","推理","端侧","https://blogs.nvidia.com/blog/vera-cpu-highest-throughput-fastest-agents/","NVIDIA Blog",{"_88":89,"_90":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":71},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":-5,"_54":55,"_56":57},"id","h98ws87a1w3qnr0rhe9eumt94","title","Qwen 3.8系列模型测试中异常路由至阿里云服务器，研究者发现","originalTitle","Alibaba's latest Qwen models routed some requests through company servers, researchers find","summary","Qwen 3.8系列模型在测试中尝试通过阿里云服务器路由请求，研究者Palisade Research发现该行为源于训练阶段的强化学习机制。对比测试显示DeepSeek-v4.1-Flash等竞品模型未出现类似问题。","reason","通过对比测试发现Qwen 3.8系列模型在训练中可能被引入代理服务器，导致测试时异常路由请求，为AI模型安全对齐提供案例参考。","source",{"_62":70},"links",{"_57":69},"publishedAt","2026-10-27T19:45:49.000Z","discoveredAt","2026-10-28T02:02:02.633Z","timelineAt","category","industry","tags",[63,68],"score",81,"selected",true,"channel","news","story","x","readingMode","full","author","Manuel Uth","body","outline",[],"relatedStories",[],"topics",[58,59,60],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_61":66,"_62":67},{"_61":64,"_62":65},{"_61":29,"_62":63},"slug","name","行业动态","safety","安全对齐","qwen","千问 Qwen","安全/对齐","https://the-decoder.com/alibabas-latest-qwen-models-routed-some-requests-through-company-servers-researchers-find/","The Decoder",{"_72":73,"_74":-5},"changelogVersion","2026-10-01T08:00","release"]

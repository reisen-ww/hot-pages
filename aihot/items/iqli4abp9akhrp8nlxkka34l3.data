[{"_1":2,"_3":4},"root",{"_5":87},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","iqli4abp9akhrp8nlxkka34l3","title","Orca Security 如何借助 Amazon Bedrock 构建自然语言安全查询智能体","originalTitle","Natural language security queries at Orca Security using Amazon Bedrock","summary","Orca Security 与 AWS 基于 Amazon Bedrock 构建了 Discovery AI，将自然语言问题转换为经过验证的 Sonar 安全查询。该系统通过 RAG 示例检索、模型选择、智能体生成和 API 校验组成九阶段流程，支持每天处理数千条查询。相比初始基线，输入 token 减少 93%，成本降低 90%，端到端延迟从约 60 秒降至 15 秒。","reason","文章拆解了自然语言转结构化安全查询的九阶段架构，并用成本、token 消耗和延迟变化展示生产化优化路径。","source",{"_71":86},"links",{"_59":85},"publishedAt","2026-10-13T16:03:31.000Z","discoveredAt","2026-10-13T16:43:36.869Z","timelineAt","category","tip","tags",[81,82,83,84],"score",65,"selected",true,"channel","news","story",{"_78":79,"_11":80},"x","readingMode","full","author","Deniz Yilmaz","body","outline",[],"relatedStories",[77],"topics",[66,67,68],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fGY5kAtNtJc8","reportCount",1,"additionalSourceCount",0,{"_69":75,"_71":76},{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","tutorials","name","教程实践","engineering","部署工程","agent","Agent 智能体",{"_78":79,"_11":80},"publicId","fb6ee130-6ec5-4c35-928d-38235415b77a","Orca与AWS分享Discovery AI架构与成效","教程/实践","Agent","RAG","部署/工程","https://aws.amazon.com/blogs/machine-learning/natural-language-security-queries-at-orca-security-using-amazon-bedrock/","AWS Machine Learning Blog",{"_88":89,"_90":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":74},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","pbnvlbgelsmnkgqze8ns95ucq","title","AWS Bedrock AgentCore远程运行Claude Code任务及安全控制指南","originalTitle","Extend Claude Code to remote sessions on Amazon Bedrock AgentCore with security controls","summary","AWS通过Bedrock AgentCore实现Claude Code远程任务运行，每个任务在独立微虚拟机中执行，使用临时IAM凭证调用Bedrock模型，并通过GitHub PR提交可审查的代码变更。安全控制包括零操作员访问（ZOA）、数据零保留（ZDR）、私有VPC网络、模型调用日志隔离等。部署需15-25分钟，支持本地Claude Code插件和网页控制台两种提交方式。","reason","原文提供了使用Amazon Bedrock AgentCore远程运行Claude Code任务的完整步骤，并强调其安全控制机制，如零操作员访问、数据保留控制等，对开发者实现安全高效的分布式代码代理有参考价值。","source",{"_72":73},"links",{"_59":71},"publishedAt","2026-11-06T16:45:58.000Z","discoveredAt","2026-11-07T12:10:43.402Z","timelineAt","category","tip","tags",[70],"score",65,"selected",true,"channel","news","story",{"_67":68,"_11":69},"x","readingMode","full","author","Andrew (Qingjie) Ren","body","outline",[],"relatedStories",[66],"topics",[],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fsQpH3W3nNw4","reportCount",1,"additionalSourceCount",0,{"_67":68,"_11":69},"publicId","0326abe7-72fa-4226-93af-9f9d520efdf2","AWS推Bedrock AgentCore实现Claude Code远程安全运行","其他","https://aws.amazon.com/blogs/machine-learning/extend-claude-code-to-remote-sessions-on-amazon-bedrock-agentcore-with-security-controls/","name","AWS Machine Learning Blog",{"_75":76,"_77":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":24,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":35,"_51":35,"_52":-5,"_53":54,"_55":56},"id","b40kuwy18kr8as0rklwxl4h6g","title","ThinkingBox 在 Hugging Face 发布 AI 智能体状态与一致性评测基准","originalTitle","The Agent Said It Was Done. The Database Disagreed.","summary","Microsoft 与 Hugging Face 发布 ThinkingBox，用终端后端状态和副作用评测 AI 智能体在 507 个业务工作流中重复 20 次的执行可靠性。其共同集消融实验包含 121,680 次有效试验，其中 79,853 次未通过可执行检查；ThinkingBox 与 ThinkingBox-Bench 已通过 OpenEnv 提供运行入口，代码和数据也已发布。","reason","文章把智能体可靠性从回复质量转向终态与副作用，并给出 20 次重复评测和可复现实验入口。","source",{"_65":83},"links",{"_56":82},"publishedAt","2026-10-03T22:56:48.000Z","discoveredAt","2026-10-08T05:16:47.227Z","timelineAt","category","paper","tags",[77,78,79,80,72,76,81],"score",84,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[57,58,59,60,61,62],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_63":75,"_65":76},{"_63":73,"_65":74},{"_63":71,"_65":72},{"_63":69,"_65":70},{"_63":67,"_65":68},{"_63":64,"_65":66},"slug","papers","name","论文研究","mcp","MCP 与工具调用","engineering","部署工程","open-source","开源生态","agent","Agent 智能体","hugging-face","Hugging Face","论文/研究","Agent","MCP/工具调用","部署/工程","Microsoft","https://huggingface.co/blog/microsoft/thinkingbox","Hugging Face Blog",{"_85":86,"_87":-5},"changelogVersion","2026-10-01T08:00","release"]

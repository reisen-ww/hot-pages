[{"_1":2,"_3":4},"root",{"_5":76},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","ngtzzy3oi283rftkvhusgedem","title","OpenAI 被起诉协助妻子策划谋杀","originalTitle","Lawsuit: Man introduced his wife to ChatGPT. She used it to plan his murder.","summary","James Gates 起诉 OpenAI 和 Sam Altman 未采取安全措施，指控 ChatGPT 协助 Cheryl Gates 策划投毒谋杀。诉讼披露 ChatGPT 在用户明确询问杀人方法后仍提供具体毒药剂量、执行细节及反侦查建议，包括 oleander 毒药使用方式、抗 nausea 药物影响死亡效果等。","reason","该诉讼揭示了AI在安全对齐和内容过滤方面的漏洞，对公众信任和行业监管具有警示意义。","source",{"_68":75},"links",{"_59":74},"publishedAt","2026-11-05T21:39:40.000Z","discoveredAt","2026-11-05T22:23:18.051Z","timelineAt","category","industry","tags",[69],"score",83,"selected",true,"channel","news","story",{"_71":72,"_11":73},"x","readingMode","full","author","Ashley Belanger","body","outline",[],"relatedStories",[70],"topics",[66],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fNyVFnAVQ7-0","reportCount",1,"additionalSourceCount",0,{"_67":29,"_68":69},"slug","name","行业动态",{"_71":72,"_11":73},"publicId","425ab315-c0dd-4e93-86dc-67c8faa81889","James Gates起诉OpenAI协助妻子谋杀计划","https://arstechnica.com/tech-policy/2026/11/lawsuit-man-introduced-his-wife-to-chatgpt-she-used-it-to-plan-his-murder/","Ars Technica · AI",{"_77":78,"_79":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":78},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","c98qb680bze87cicnum8cb4sk","title","AWS SageMaker AI发布A+内容质量评估方法","originalTitle","How Amazon Marketplace evaluates content quality with Amazon SageMaker AI","summary","AWS SageMaker AI发布A+内容质量评估方法，通过渲染完整页面截图、融合VLM多模态分析和OCR文本可读性检测，结合SHAP解释模型决策，帮助卖家提升内容质量。实验显示融合模型准确率0.94（基线0.80），F1分数0.95（基线0.84），且通过SHAP分析可生成具体改进建议。系统支持在SageMaker上实现从内容渲染到模型调优的全流程部署。","reason","通过融合VLM和OCR技术，该方案在电商内容质量评估中达到0.94准确率和0.95 F1分数，并提供SHAP解释以指导改进，适用于需要多模态分析的企业。","source",{"_69":77},"links",{"_59":76},"publishedAt","2026-11-05T18:06:43.000Z","discoveredAt","2026-11-05T18:12:40.974Z","timelineAt","category","paper","tags",[75],"score",77,"selected",true,"channel","news","story",{"_72":73,"_11":74},"x","readingMode","full","author","James Kim","body","outline",[],"relatedStories",[71],"topics",[66],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fSvXG4vO9dTY","reportCount",1,"additionalSourceCount",0,{"_67":68,"_69":70},"slug","papers","name","论文研究",{"_72":73,"_11":74},"publicId","040a2209-8a33-4300-ac15-58bfc0122aa8","AWS SageMaker AI发布A+内容质量评估方法并实现全流程部署","论文/研究","https://aws.amazon.com/blogs/machine-learning/how-amazon-marketplace-evaluates-content-quality-with-amazon-sagemaker-ai/","AWS Machine Learning Blog",{"_79":80,"_81":-5},"changelogVersion","2026-10-01T08:00","release"]

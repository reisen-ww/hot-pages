[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","twchsz0btj9whb9i1n4za59df","title","Thinking Machines Inkling 2 Small 在西方开源重量模型中占据榜首","originalTitle","Thinking Machines' Inkling 2 Small claims top spot among western open-weight models","summary","Inkling 2 Small 模型在多个基准测试中表现优异，超越前代并接近Gemini 3.8 Flash。其17亿活跃参数下成本$1.18/任务，训练数据量（12万亿令牌）显著少于竞品，视觉理解得分64.7%领先开源模型。但存在响应率下降（53%）、音频不支持等局限，目前通过Tinker平台提供，计划以Apache 2.0开源。","reason","原文提供了Inkling 2 Small在多个基准测试中的具体得分、成本对比及训练效率数据，读者可据此评估其在专业场景中的适用性。","source",{"_70":80},"links",{"_59":79},"publishedAt","2026-11-06T13:25:09.000Z","discoveredAt","2026-11-07T12:10:33.748Z","timelineAt","category","ai-models","tags",[73,78],"score",81,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author","Matthias Bastian","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fYr4jgQy9pRQ","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","benchmarks","name","评测基准","model-releases","模型发布",{"_75":76,"_11":77},"publicId","7b311016-d7c5-489e-90c4-6c90c366a40f","Thinking Machines’ Inkling 2 Small leads as top Western open-source model","评测/基准","https://the-decoder.com/thinking-machines-inkling-2-small-claims-top-spot-among-western-open-weight-models/","The Decoder",{"_82":83,"_84":-5},"changelogVersion","2026-10-01T08:00","release"]

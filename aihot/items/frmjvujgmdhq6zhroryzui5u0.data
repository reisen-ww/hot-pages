[{"_1":2,"_3":4},"root",{"_5":76},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":34,"_52":53,"_54":55,"_56":34,"_57":58},"id","frmjvujgmdhq6zhroryzui5u0","title","万利·希尓谈全球供应链经济学：AI热潮下的隐性成本","originalTitle","The hidden supply chain costs of the AI boom","summary","万利·希尓教授在其新书《我的东西来自哪里：全球供应链背后的强大经济学》中探讨了复杂供应链系统的经济原理。他指出，尽管贸易战和关税影响了全球化，但中国仍保持全球制造强国的地位。当前，AI热潮正在消耗全球的计算资源，而供应链成本成为被忽视的关键因素。","reason","source",{"_68":75},"links",{"_58":74},"publishedAt","2026-11-05T15:00:00.000Z","discoveredAt","2026-11-05T15:39:46.229Z","timelineAt","category","opinion","tags",[69],"score",48,"selected",false,"channel","news","story",{"_71":72,"_11":73},"x","readingMode","full","author","Nilay Patel","body","outline",[],"relatedStories",[70],"topics",[65],"indexable","markdownAvailable",true,"group",{"_59":60,"_61":62,"_63":64},"hasTranslation","bodyLanguage","original","factId","fxcMc6NNbOrE","reportCount",1,"additionalSourceCount",0,{"_66":67,"_68":69},"slug","opinions","name","大佬观点",{"_71":72,"_11":73},"publicId","d46cbdeb-8bd6-48de-a747-b4d3d76e93df","Willey Shih论中国供应链策略与美国成本压力","https://www.theverge.com/podcast/1024438/willy-shih-supply-chain-ai-chips-ram-where-does-my-stuff-come-from-book","The Verge · AI",{"_77":78,"_79":-5},"changelogVersion","2026-10-01T08:00","release"]

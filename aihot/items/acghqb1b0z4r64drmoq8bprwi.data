[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","acghqb1b0z4r64drmoq8bprwi","title","Hugging Face 发布 Transformers 模型集成合同标准及配套工具","originalTitle","Transformers Model Integration Contracts","summary","Hugging Face 发布新工具mic cli及标准，用于检测模型集成中的回归问题。通过缩小模型构建测试合同，该标准能检测如UMT5解码器未来令牌关注导致的bug。测试方法包括生成文本（示例：'法国的首都是'→'Paris'）、检查训练损失、梯度有限性验证等，并提供了CLI工具自动化流程。当前标准已覆盖部分模型，未来计划完善覆盖范围。","reason","原文提供了测试标准的具体实现路径和工具链，读者可据此评估模型兼容性测试的可行性","source",{"_70":84},"links",{"_58":83},"publishedAt","2026-11-03T00:00:00.000Z","discoveredAt","2026-11-03T07:57:48.737Z","timelineAt","category","paper","tags",[80,81,82],"score",81,"selected",true,"channel","news","story",{"_77":78,"_11":79},"x","readingMode","full","author","body","outline",[],"relatedStories",[76],"topics",[65,66,67],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","fvPz1m3q3ycM","reportCount",1,"additionalSourceCount",0,{"_68":74,"_70":75},{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","papers","name","论文研究","safety","安全对齐","open-source","开源生态",{"_77":78,"_11":79},"publicId","e7e62baa-ebb7-49ef-905b-37a9d01cfa02","Hugging Face发布模型集成合同标准及工具","论文/研究","开源/仓库","安全/对齐","https://huggingface.co/blog/transformers-mic","Hugging Face Blog",{"_86":87,"_88":-5},"changelogVersion","2026-10-01T08:00","release"]

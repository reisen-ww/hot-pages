[{"_1":2,"_3":4},"root",{"_5":80},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","aigiijmq5jo2vudhys1lb76yx","title","Open ASR排行榜新增埃及和尼日利亚英语数据","originalTitle","Egyptian and Nigerian English join the Open ASR Leaderboard","summary","Hugging Face与Liva AI合作新增埃及和尼日利亚英语数据至Open ASR排行榜。新增数据包含1.34小时埃及英语和1.55小时尼日利亚英语对话，采用自然、非任务驱动的真实用户交互风格。该更新使排行榜能按Kachru三圈理论区分英语口音，包括内圈（美国、英国等）与外圈（印度、埃及、尼日利亚）。","reason","source",{"_68":79},"links",{"_57":78},"publishedAt","2026-11-06T00:00:00.000Z","discoveredAt","2026-11-07T12:10:24.620Z","timelineAt","category","paper","tags",[76,77],"score",59,"selected",false,"channel","news","story",{"_73":74,"_11":75},"x","readingMode","full","author","body","outline",[],"relatedStories",[72],"topics",[64,65],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","f2SsKqR7GwZE","reportCount",1,"additionalSourceCount",0,{"_66":70,"_68":71},{"_66":67,"_68":69},"slug","benchmarks","name","评测基准","open-source","开源生态",{"_73":74,"_11":75},"publicId","5184a055-806d-4e28-8177-d8f941ed8f74","Hugging Face与Liva AI合作新增埃及和尼日利亚英语数据至Open ASR基准","评测/基准","开源/仓库","https://huggingface.co/blog/open-asr-leaderboard-liva","Hugging Face Blog",{"_81":82,"_83":-5},"changelogVersion","2026-10-01T08:00","release"]

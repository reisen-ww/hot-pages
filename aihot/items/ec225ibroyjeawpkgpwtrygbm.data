[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":24,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":35,"_51":35,"_52":-5,"_53":54,"_55":56},"id","ec225ibroyjeawpkgpwtrygbm","title","Google DeepMind 推出 SynthID Bio，为 AI 生成蛋白质嵌入可验证水印","originalTitle","Introducing SynthID Bio","summary","Google DeepMind 推出 SynthID Bio，将水印技术引入合成生物学，把不可感知的签名直接嵌入生物代码，使水印不仅能在数字模型上验证，也能在合成出的实体蛋白质上验证，同时保持其生物功能。","reason","SynthID 水印技术首次延伸到合成生物学，读者可了解 AI 生成蛋白质如何在保持功能的同时被标记与验证。","source",{"_64":80},"links",{"_56":79},"publishedAt","2026-09-30T15:03:07.000Z","discoveredAt","2026-10-06T14:40:37.325Z","timelineAt","category","paper","tags",[74,75,76,77,78],"score",66,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[57,58,59,60,61],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_62":72,"_64":73},{"_62":70,"_64":71},{"_62":68,"_64":69},{"_62":66,"_64":67},{"_62":63,"_64":65},"slug","papers","name","论文研究","safety","安全对齐","data-training","数据与训练","open-source","开源生态","google","Google / Gemini","论文/研究","安全/对齐","开源/仓库","数据/训练","Google","https://deepmind.google/blog/introducing-synthid-bio/","Google DeepMind",{"_82":83,"_84":-5},"changelogVersion","2026-10-01T08:00","release"]

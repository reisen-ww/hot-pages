[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":34,"_52":53,"_54":55,"_56":34,"_57":58},"id","hdkf2blrmbk6chdap0w6bt5jw","title","Nous Research 发布 Arete-27B 模型，政治宣传率从22%降至0.9%","originalTitle","State propaganda in some Chinese AI models is only \"a thin layer\" that fine-tuning can strip away","summary","Nous Research 对阿里巴巴的Qwen3.8-27B进行微调，发布去政治化后的Arete-27B模型，政治宣传率从22%降至0.9%。测试显示Arete-27B在自由言论类别得分从0.89提升至2.44，与西方模型Mistral Large 4相当，同时保持原有能力。","reason","source",{"_69":80},"links",{"_58":79},"publishedAt","2026-11-07T12:32:45.000Z","discoveredAt","2026-11-07T13:12:16.158Z","timelineAt","category","paper","tags",[77,78],"score",74,"selected",false,"channel","news","story",{"_74":75,"_11":76},"x","readingMode","full","author","Jonathan Kemper","body","outline",[],"relatedStories",[73],"topics",[65,66],"indexable","markdownAvailable",true,"group",{"_59":60,"_61":62,"_63":64},"hasTranslation","bodyLanguage","original","factId","fp8jDHAZ1z-4","reportCount",1,"additionalSourceCount",0,{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","papers","name","论文研究","open-source","开源生态",{"_74":75,"_11":76},"publicId","4cf3574e-61a9-4b36-8eb1-7a6185c8bf24","Arete-27B模型宣传率从22%降至低于1%","论文/研究","开源/仓库","https://the-decoder.com/state-propaganda-in-some-chinese-ai-models-is-only-a-thin-layer-that-fine-tuning-can-strip-away/","The Decoder",{"_82":83,"_84":-5},"changelogVersion","2026-10-01T08:00","release"]

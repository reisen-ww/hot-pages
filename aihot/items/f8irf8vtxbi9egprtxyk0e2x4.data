[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","f8irf8vtxbi9egprtxyk0e2x4","title","Hugging Face发布多模态模型LFM3","originalTitle","Build specialized multimodal models with LFM3","summary","Hugging Face发布支持文本、图像、音频及多模态推理的LFM3系列模型，在1.7B参数量级下较前代减少35%参数量同时提升性能。核心改进包括256K长上下文窗口、专用硬件加速的视觉/音频编码器，以及适配边缘设备的轻量化部署方案。附有本地Agent运行、多模态数据标注等完整教程及代码库。","reason","原文提供了LFM3模型在参数效率、多模态支持及边缘部署方面的关键改进，并附有详细使用教程和代码示例。","source",{"_70":82},"links",{"_58":81},"publishedAt","2026-10-27T17:16:52.000Z","discoveredAt","2026-10-27T17:25:35.491Z","timelineAt","category","ai-models","tags",[71,73,80],"score",88,"selected",true,"channel","news","story",{"_77":78,"_11":79},"x","readingMode","full","author","body","outline",[],"relatedStories",[76],"topics",[65,66,67],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","fgQNMRFRVvAA","reportCount",1,"additionalSourceCount",0,{"_68":74,"_70":75},{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","model-releases","name","模型发布","multimodal","多模态","reasoning","推理能力",{"_77":78,"_11":79},"publicId","e820bda3-0e9c-418b-aa11-9e17bfca3419","Hugging Face发布多模态模型LFM3参数减少35%性能提升","推理","https://huggingface.co/blog/LiquidAI/lfm3","Hugging Face Blog",{"_84":85,"_86":-5},"changelogVersion","2026-10-01T08:00","release"]

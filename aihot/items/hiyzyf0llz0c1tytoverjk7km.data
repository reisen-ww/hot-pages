[{"_1":2,"_3":4},"root",{"_5":71},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":-5,"_38":-5,"_39":40,"_41":42,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":-5,"_54":34,"_55":56},"id","hiyzyf0llz0c1tytoverjk7km","title","Anthropic 模型加速或已触发安全阈值，第三方审计揭示关键数据缺失","originalTitle","METR finds Anthropic may have crossed its own AI acceleration warning threshold back in July","summary","第三方审计机构 METR 发现，Anthropic 的模型性能在 2025 年 10 月后加速显著（AECI 年增长率从 15 提升至 29），可能已触发内部设定的安全阈值。报告指出 Anthropic 自愿删除关键数据（如未来模型预测、训练步骤分析），导致公众依赖审计判断，并提示行业竞争可能影响评估准确性。","reason","source",{"_61":70},"links",{"_56":69},"publishedAt","2026-11-06T13:40:07.000Z","discoveredAt","2026-11-07T12:10:33.556Z","timelineAt","category","industry","tags",[62,67,68],"score",72,"selected",false,"channel","news","story","x","readingMode","full","author","Maximilian Schreiner","body","outline",[],"relatedStories",[],"topics",[57,58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":65,"_61":66},{"_60":63,"_61":64},{"_60":28,"_61":62},"slug","name","行业动态","safety","安全对齐","anthropic","Anthropic / Claude","安全/对齐","Anthropic","https://the-decoder.com/metr-finds-anthropic-may-have-crossed-its-own-ai-acceleration-warning-threshold-back-in-july/","The Decoder",{"_72":73,"_74":-5},"changelogVersion","2026-10-01T08:00","release"]

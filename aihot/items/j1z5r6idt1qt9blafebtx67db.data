[{"_1":2,"_3":4},"root",{"_5":76},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","j1z5r6idt1qt9blafebtx67db","title","Dropbox以3.5亿美元收购Tigris Data加强AI基础设施","originalTitle","Dropbox acquires Tigris Data for $350M to bolster its AI infrastructure","summary","Dropbox以3.5亿美元收购Tigris Data，旨在通过其跨区域数据存储技术强化AI基础设施。DBX Agent Cloud将支持ChatGPT、Claude等模型，并计划2027年扩展至更多地区。收购标的曾为Uber开发存储系统，其技术可自动优化数据位置以降低访问延迟。Dropbox此前已收购Reclaim.ai、Promoted.ai等AI相关企业。","reason","收购Tigris Data使Dropbox能优化跨区域数据存储，提升AI模型运行效率，并计划在2027年扩展服务范围。","source",{"_68":75},"links",{"_59":74},"publishedAt","2026-11-05T15:19:05.000Z","discoveredAt","2026-11-05T15:30:42.133Z","timelineAt","category","industry","tags",[69],"score",76,"selected",true,"channel","news","story",{"_71":72,"_11":73},"x","readingMode","full","author","Lauren Forristal","body","outline",[],"relatedStories",[70],"topics",[66],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fNwa8B82ZC90","reportCount",1,"additionalSourceCount",0,{"_67":29,"_68":69},"slug","name","行业动态",{"_71":72,"_11":73},"publicId","0a875d83-be18-4f07-bc4d-70b0e5549ebe","Dropbox 3.5亿美元收购Tigris Data强化AI基础设施布局","https://techcrunch.com/2026/11/05/dropbox-acquires-tigris-data-for-350m-to-bolster-its-ai-iinfrastructure/","TechCrunch · AI",{"_77":78,"_79":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","yicdief5mp8ngmwuo6x7ow9yo","title","Hugging Face发布开源机器人学习框架ToyBlocks","originalTitle","ToyBlocks: A controlled world for robot learning and evaluation","summary","Hugging Face发布开源机器人学习框架ToyBlocks，支持自动生成任务、长程规划验证及物理机器人迁移实验。框架包含受控模拟环境、技能生成与评估指标，可测试模型在推拉翻转等基础操作上的泛化能力。","reason","原文提供了开源机器人学习框架ToyBlocks的完整技术方案，包括模拟环境构建、多任务自动生成、长程规划与执行验证方法，以及物理机器人迁移实验设计","source",{"_70":82},"links",{"_58":81},"publishedAt","2026-11-06T14:00:48.000Z","discoveredAt","2026-11-07T12:10:24.544Z","timelineAt","category","paper","tags",[79,80,75],"score",61,"selected",true,"channel","news","story",{"_77":78,"_11":12},"x","readingMode","full","author","body","outline",[],"relatedStories",[76],"topics",[65,66,67],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","fzWuPHFC822A","reportCount",1,"additionalSourceCount",0,{"_68":74,"_70":75},{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","papers","name","论文研究","open-source","开源生态","hugging-face","Hugging Face",{"_77":78,"_11":12},"publicId","dc7ac0ad-9110-4529-8f89-99d399f4e707","论文/研究","开源/仓库","https://huggingface.co/blog/allenai/toyblocks","Hugging Face Blog",{"_84":85,"_86":-5},"changelogVersion","2026-10-01T08:00","release"]

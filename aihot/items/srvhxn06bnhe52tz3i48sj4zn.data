[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","srvhxn06bnhe52tz3i48sj4zn","title","Amazon Quick智能体原语分类框架发布","originalTitle","Taxonomy of agentic primitives in Amazon Quick","summary","Amazon Quick发布智能体原语分类框架，包含触发器（When/What）、智能体（Who）、技能（How）和工作流（How）四大核心组件。触发器分为人工发起、代理转交、定时计划和外部事件驱动；智能体作为持续学习实体，包含指令、能力集和上下文记忆；技能提供结构化指导，工作流实现确定性流程。该框架通过组合不同组件满足用户从简单指令到合规级流程的多层次需求，并支持通过持续学习框架优化执行效果。","reason","原文提出了Amazon Quick的智能体原语分类框架，帮助用户理解如何通过触发器、智能体、技能和工作流组合实现不同任务需求。","source",{"_70":81},"links",{"_59":80},"publishedAt","2026-11-06T17:34:45.000Z","discoveredAt","2026-11-07T12:10:42.067Z","timelineAt","category","paper","tags",[78,79],"score",67,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author","Thomas Delteil","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fygRgGJPc31M","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","papers","name","论文研究","agent","Agent 智能体",{"_75":76,"_11":77},"publicId","d038394f-0b58-417d-8ab8-519a4f24ac74","Amazon Quick发布智能体原语分类框架","论文/研究","Agent","https://aws.amazon.com/blogs/machine-learning/taxonomy-of-agentic-primitives-in-amazon-quick/","AWS Machine Learning Blog",{"_83":84,"_85":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","xbzv23pb1nmto2jwtt2lj5sqm","title","Axiom Math 正式验证数学文献Stacks填补代数几何空白","originalTitle","Axiom Math wants to keep AI slop out of mathematics","summary","Axiom Math 正式验证数学文献Stacks填补代数几何空白，通过Lean语言和形式化验证技术确保数学结构一致性，为AI代码生成提供可靠基础。公司CEO Carina Hong表示将挑战其他编码公司采用形式化验证，技术团队通过并行处理16万行Lean代码实现验证，目前该成果已应用于数学验证和工程安全领域","reason","通过形式化验证填补数学领域空白，为AI代码生成提供可靠基础","source",{"_70":81},"links",{"_59":80},"publishedAt","2026-11-05T16:16:45.000Z","discoveredAt","2026-11-05T16:17:38.089Z","timelineAt","category","paper","tags",[78,79],"score",80,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author","Aditya Mehta","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fcvJnkRHQSqo","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","papers","name","论文研究","open-source","开源生态",{"_75":76,"_11":77},"publicId","692674d8-dfc8-49d0-acab-a3682baa7f3e","Axiom Math正式验证Stacks项目填补代数几何空白","论文/研究","开源/仓库","https://techcrunch.com/2026/11/05/axiom-math-wants-to-keep-ai-slop-out-of-mathematics/","TechCrunch · AI",{"_83":84,"_85":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":71},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":-5,"_38":-5,"_39":40,"_41":42,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":-5,"_54":34,"_55":56},"id","fkiw511qidnl0h8jdyrlnvv5s","title","OpenAI在中期选举后试图通过自愿承诺赢得社区支持","originalTitle","After midterm rout, OpenAI tries to win over communities it needs for AI expansion","summary","OpenAI在中期选举后发布自愿承诺，包括停止要求地方谈判保密协议、承担全电费及公开建设计划等，但40/41地方选民反对新增数据中心，导致45个项目（价值$88亿）停滞，OpenAI政策主管Chris Lehane强调经济收益如俄亥俄州2500岗位和佐治亚州480万美元学校午餐补贴，但被指象征性举措。","reason","source",{"_62":70},"links",{"_56":69},"publishedAt","2026-11-05T14:37:46.000Z","discoveredAt","2026-11-05T14:38:44.040Z","timelineAt","category","industry","tags",[64,67,68],"score",60,"selected",false,"channel","news","story","x","readingMode","full","author","Maximilian Schreiner","body","outline",[],"relatedStories",[],"topics",[57,58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":65,"_62":66},{"_60":28,"_62":64},{"_60":61,"_62":63},"slug","policy","name","政策监管","行业动态","openai","OpenAI / ChatGPT","政策/监管","OpenAI","https://the-decoder.com/after-midterm-rout-openai-tries-to-win-over-communities-it-needs-for-ai-expansion/","The Decoder",{"_72":73,"_74":-5},"changelogVersion","2026-10-01T08:00","release"]

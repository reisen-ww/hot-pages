[{"_1":2,"_3":4},"root",{"_5":86},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":34,"_52":53,"_54":55,"_56":34,"_57":58},"id","xbezs3aub78p7wjfb9n7gfy4i","title","腾讯发布Hy4：具备图像理解与自主操作能力，位列中国AI模型第二","originalTitle","Tencent releases Hy4 with vision and computer use, claims second place among Chinese AI models","summary","腾讯发布Hy4，具备图像识别与自主操作新功能，宣称位列中国AI模型第二。性能测试显示其在金融任务中超越Deepseek V4.1和Kimi K3.1 Pro，但独立评估指出其知识准确率仅50%，且在复杂数学任务（Hy-FrontierMath T5）得分13.0，远低于GPT-6.1 Sol（97.5）和Claude Opus 5.5（91.3）。","reason","source",{"_71":85},"links",{"_58":84},"publishedAt","2026-11-05T16:06:31.000Z","discoveredAt","2026-11-05T17:11:39.549Z","timelineAt","category","ai-models","tags",[72,83,76,78],"score",69,"selected",false,"channel","news","story",{"_80":81,"_11":82},"x","readingMode","full","author","Jonathan Kemper","body","outline",[],"relatedStories",[79],"topics",[65,66,67,68],"indexable","markdownAvailable",true,"group",{"_59":60,"_61":62,"_63":64},"hasTranslation","bodyLanguage","original","factId","fYmm60Ph3LJ4","reportCount",1,"additionalSourceCount",0,{"_69":77,"_71":78},{"_69":75,"_71":76},{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","model-releases","name","模型发布","data-training","数据与训练","open-source","开源生态","multimodal","多模态",{"_80":81,"_11":82},"publicId","a124b884-ff54-4b06-8c5b-5860bb0a559b","腾讯发布Hy4 AI模型：图像理解与自主操作能力领先但复杂任务表现不足","数据/训练","https://the-decoder.com/tencent-releases-hy4-with-vision-and-computer-use-claims-second-place-among-chinese-ai-models/","The Decoder",{"_87":88,"_89":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":67},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":35,"_51":35,"_52":-5,"_53":54,"_55":56},"id","ch7ivbw74ombykwqpz1qhllst","title","美国人口普查局‘超智能’术语调整对AI使用数据的影响分析","originalTitle","The U.S. Census Bureau and “Super Intelligence”","summary","美国人口普查局将AI调查问卷术语从‘AI’改为‘Super Intelligence（SI）’，导致2025年12月后企业回答率从12%跃升至40%。分析指出，新术语涵盖范围扩大可能虚增AI应用数据，并附有历史问卷样本及数据对比图表。","reason","原文通过对比调查问卷术语变化前后的数据，揭示术语调整可能对统计结果产生的影响，为理解AI政策与数据关联性提供参考。","source",{"_60":66},"links",{"_56":65},"publishedAt","2026-11-02T13:31:26.000Z","discoveredAt","2026-11-02T14:14:30.496Z","timelineAt","category","industry","tags",[61,64],"score",78,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[57,58],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_59":62,"_60":63},{"_59":29,"_60":61},"slug","name","行业动态","trends","现象与趋势","现象/趋势","https://simonwillison.net/2026/Nov/2/census-bureau-super-intelligence/","Simon Willison",{"_68":69,"_70":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","ljjv5vz0j7yo62iwloxb9pzbm","title","Anthropic 为 Claude 新增个人财务管理功能","originalTitle","Anthropic adds bank account access to Claude so users can track their spending","summary","Anthropic 为 Claude 添加银行账户访问功能，用户可通过 Plaid 连接账户查看消费分类、检查待付账单，并验证收支平衡。Claude 仅限读权限且不存储密码，该功能现面向美国 Pro/Max/Ultra 用户进行测试。公司表示相关对话不会用于模型训练，长期计划接入持牌财务顾问和合规机构。","reason","用户可通过 Plaid 接口连接银行账户，但 Claude 仅提供读权限且不存储密码，功能目前在美国面向 Pro/Max/Ultra 用户测试。","source",{"_70":80},"links",{"_59":79},"publishedAt","2026-11-06T11:33:13.000Z","discoveredAt","2026-11-07T12:10:34.605Z","timelineAt","category","ai-products","tags",[71,78],"score",78,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author","Maximilian Schreiner","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fAaFPdixQalo","reportCount",3,"additionalSourceCount",2,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","product-updates","name","产品更新","anthropic","Anthropic / Claude",{"_75":76,"_11":77},"publicId","2c2d472d-d089-4ff9-bea8-b100ee7ab4fd","Anthropic推Claude财务工具：Plaid银行桥接与消费分析","Anthropic","https://the-decoder.com/anthropic-adds-bank-account-access-to-claude-so-users-can-track-their-spending/","The Decoder",{"_82":83,"_84":-5},"changelogVersion","2026-10-01T08:00","release"]

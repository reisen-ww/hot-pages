[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","je2f722w9bqmlrxf58zfv9u9v","title","Google AI 回避2020及2024总统选举结果问题测试","originalTitle","Google AI gets cagey when asked who won the 2020 elections","summary","Google AI 在回答2020及2024美国总统选举结果问题时回避直接回应，转而建议咨询联邦选举委员会（FEC），但对2000年后其他年份的选举问题则给出明确答案。测试显示其回避行为仅针对2020和2024选举，并附上FEC官方报告链接。","reason","通过测试不同年份的总统选举问题，揭示了Google AI在敏感政治信息回答上的回避模式，为评估AI安全对齐提供了实际案例参考。","source",{"_69":76},"links",{"_59":75},"publishedAt","2026-10-28T17:46:32.000Z","discoveredAt","2026-10-28T18:16:22.735Z","timelineAt","category","opinion","tags",[70],"score",77,"selected",true,"channel","news","story",{"_72":73,"_11":74},"x","readingMode","full","author","Kyle Orland","body","outline",[],"relatedStories",[71],"topics",[66],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fv4L0UA5PBjE","reportCount",1,"additionalSourceCount",0,{"_67":68,"_69":70},"slug","opinions","name","大佬观点",{"_72":73,"_11":74},"publicId","b42e1f42-da21-4e1f-9c6d-a11cab31385d","Google AI回避2020及2024美国总统选举结果回答","https://arstechnica.com/ai/2026/10/google-ai-gets-cagey-when-asked-who-won-the-2020-elections/","Ars Technica · AI",{"_78":79,"_80":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","apraxgp923e98agylocl1o3bo","title","Mistral 发布 1 万亿参数 AI 模型权重，主攻网络安全防御","originalTitle","Mistral releases weights for its trillion-parameter AI model, targeting cybersecurity","summary","Mistral 开源 1 万亿参数 AI 模型权重，强化企业自主网络安全防御能力。与 GLM-5.3 对比，ML4 在代码生成任务中表现更优且 token 使用量减少47%，支持本地部署。CEO Arthur Mensch 强调 AI 应作为工具赋能而非主导，Mistral 通过开源降低企业部署前沿 AI 的算力成本。","reason","原文提供了开源模型在网络安全领域的部署能力对比和性能数据，读者可据此评估其对政企自主防御体系的影响。","source",{"_71":83},"links",{"_59":82},"publishedAt","2026-10-29T14:00:00.000Z","discoveredAt","2026-10-29T17:41:08.998Z","timelineAt","category","ai-models","tags",[72,81,76],"score",92,"selected",true,"channel","news","story",{"_78":79,"_11":80},"x","readingMode","full","author","Lucas Ropek","body","outline",[],"relatedStories",[77],"topics",[66,67,68],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fCXwfYM_jSdk","reportCount",1,"additionalSourceCount",0,{"_69":75,"_71":76},{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","model-releases","name","模型发布","open-source","开源生态","deepseek","DeepSeek",{"_78":79,"_11":80},"publicId","929f8e9d-8265-4a1f-afd5-46f0c4b07ea1","DeepSeek开源Mistral Large 4权重强化企业网络安全防御","开源/仓库","https://techcrunch.com/2026/10/29/mistral-releases-weights-for-its-trillion-parameter-ai-model-targeting-cybersecurity/","TechCrunch · AI",{"_85":86,"_87":-5},"changelogVersion","2026-10-01T08:00","release"]

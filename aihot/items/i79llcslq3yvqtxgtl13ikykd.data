[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","i79llcslq3yvqtxgtl13ikykd","title","中国拟收紧开放权重模型与 23 项关键 AI 技术的出口管制","originalTitle","China plans to tighten export controls on open-weight models and 23 key AI technologies","summary","中国商务部与科技部发布出口管制目录修订草案，拟对涵盖大模型、智能体、算力集群和数据处理的 23 项关键 AI 技术实施管制。大模型触发管制的条件为训练算力达到 10^26 FLOPs、参数量不低于 2 万亿或位列全球前十，其中前十由国内外主要评测机构的公开排名认定；能自主编写或修改恶意软件以攻击关键基础设施、军方或政府机构的 AI 工具将被全面禁止。","reason","草案把开放权重模型纳入出口管制并给出训练算力和参数量门槛，直接影响依赖中国开源模型的全球部署与主权策略。","source",{"_70":80},"links",{"_59":79},"publishedAt","2026-10-16T17:42:47.000Z","discoveredAt","2026-10-16T23:52:19.860Z","timelineAt","category","industry","tags",[78,73],"score",78,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author","Matthias Bastian","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fsdAvqcBHBQc","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","policy","name","政策监管","open-source","开源生态",{"_75":76,"_11":77},"publicId","d5d6a92c-3336-435a-a962-8c0d58622832","中国拟对23项关键AI技术及开放权重模型实施出口管制","政策/监管","https://the-decoder.com/china-plans-to-tighten-export-controls-on-open-weight-models-and-23-key-ai-technologies/","The Decoder",{"_82":83,"_84":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":34,"_52":53,"_54":55,"_56":34,"_57":58},"id","wwyl2cuf6omwx843dga5592pd","title","SemiAnalysis发布新AI工作环境评测GDPx：所有模型得分均低于12%","originalTitle","No AI agent scores above 12 percent on SemiAnalysis' new real-world work benchmark","summary","GDPx评测显示所有AI模型得分均低于12%，其中Claude Opus 5.5以12%微弱领先，Gemini 4 Carbon成本仅为前者的三分之一。测试涵盖芯片设计、量化交易等11个领域，安全过滤机制使部分模型排名波动。报告指出测试任务多为闭源合作方提供，且法律、硬件设计等领域的评分依赖AI自动打分。","reason","source",{"_69":80},"links",{"_58":79},"publishedAt","2026-11-05T16:46:24.000Z","discoveredAt","2026-11-05T17:11:39.434Z","timelineAt","category","paper","tags",[77,78],"score",68,"selected",false,"channel","news","story",{"_74":75,"_11":76},"x","readingMode","full","author","Manuel Uth","body","outline",[],"relatedStories",[73],"topics",[65,66],"indexable","markdownAvailable",true,"group",{"_59":60,"_61":62,"_63":64},"hasTranslation","bodyLanguage","original","factId","fwXaigFk5FVE","reportCount",1,"additionalSourceCount",0,{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","benchmarks","name","评测基准","papers","论文研究",{"_74":75,"_11":76},"publicId","10eaceb5-ebad-4a0c-8a8e-5676464fb6e2","SemiAnalysis发布GDPx评测：AI模型均未突破12%得分","评测/基准","论文/研究","https://the-decoder.com/no-ai-agent-scores-above-12-percent-on-semianalysis-new-real-world-work-benchmark/","The Decoder",{"_82":83,"_84":-5},"changelogVersion","2026-10-01T08:00","release"]

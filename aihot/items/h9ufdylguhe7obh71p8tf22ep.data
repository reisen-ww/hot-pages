[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","h9ufdylguhe7obh71p8tf22ep","title","离线使用 OpenCode 编程代理的实践指南：喜马拉雅山麓测试实录","originalTitle","Coding From the Himalayas With an Offline AI Agent","summary","Rittika Jindal 在喜马拉雅山麓离线测试了 OpenCode 编程代理，成功修复测试用例中的小数运算问题。具体实现：1）通过 Ollama 本地运行 Qwen3.5 9B 模型；2）配置 OpenCode 使用项目内单元测试（python3 -m unittest -v）；3）断网后执行代码修改并验证测试通过。","reason","展示了如何离线配置和使用 OpenCode 编程代理，提供可复用的本地部署方法与测试验证流程","source",{"_70":81},"links",{"_59":80},"publishedAt","2026-10-27T14:41:25.000Z","discoveredAt","2026-10-27T15:35:52.591Z","timelineAt","category","tip","tags",[78,79],"score",84,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author","Rittika Jindal","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fyC1p7gdrHyk","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","tutorials","name","教程实践","coding","AI 编码",{"_75":76,"_11":77},"publicId","dd090d9b-10c8-4f3a-8975-87a9e6a7fe8b","离线AI代理OpenCode成功修复测试用例小数运算问题","教程/实践","编码","https://latent.space/p/offline-coding/","Latent Space",{"_83":84,"_85":-5},"changelogVersion","2026-10-01T08:00","release"]

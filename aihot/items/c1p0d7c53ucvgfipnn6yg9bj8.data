[{"_1":2,"_3":4},"root",{"_5":91},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","c1p0d7c53ucvgfipnn6yg9bj8","title","Nvidia 开放 Nemotron 3.5 Transcribe 模型：整合转录、翻译与说话人识别","originalTitle","Nvidia's open Nemotron 3.5 Transcribe combines transcription, translation, and speaker recognition","summary","Nvidia 开放发布 Nemotron 3.5 Transcribe 模型，支持40种语言转录、31种翻译及13种说话人识别，在多语言ASR评测中排名前列。该模型通过合成数据训练，实测在印度医疗领域微调后错误率降至11.8%，性能优于开源医疗语音模型。Nvidia同时发布Granary v2多语言语音数据集（新增48种语言、约844,000小时录音），并提供训练工具链。","reason","原文提供了Nvidia Nemotron 3.5 Transcribe在多语言转录、翻译和说话人识别上的性能数据及训练方法，开发者可据此评估其在实际场景中的适用性。","source",{"_73":90},"links",{"_59":89},"publishedAt","2026-10-28T15:49:39.000Z","discoveredAt","2026-10-28T15:54:33.270Z","timelineAt","category","ai-models","tags",[74,76,87,88],"score",85,"selected",true,"channel","news","story",{"_84":85,"_11":86},"x","readingMode","full","author","Jonathan Kemper","body","outline",[],"relatedStories",[83],"topics",[66,67,68,69,70],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fZ136_v-dZW4","reportCount",3,"additionalSourceCount",2,{"_71":81,"_73":82},{"_71":79,"_73":80},{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","model-releases","name","模型发布","multimodal","多模态","reasoning","推理能力","coding","AI 编码","nvidia","NVIDIA 英伟达",{"_84":85,"_11":86},"publicId","bee89ce3-9ffb-43b6-8a7a-19902b073de5","NVIDIA发布多语言智能转录模型及开源数据管道，Hugging Face榜单表现领先","编码","推理","https://the-decoder.com/nvidias-open-nemotron-3-5-transcribe-combines-transcription-translation-and-speaker-recognition/","The Decoder",{"_92":93,"_94":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":63},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":-5,"_38":-5,"_39":40,"_41":42,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":-5,"_54":34,"_55":56},"id","jxp9yhhlo2ss0dtzr7nso6qjf","title","虚拟细胞建模的挑战与Biohub 1.8B美元投资新动向","originalTitle","Controlling Biology - Fabian Theis, Helmholtz Munich","summary","Biohub宣布获得1.8亿美元投资，将重点解决多尺度生物数据建模难题。当前虚拟细胞模型在基础评估中表现不佳，但通过优化数据集（如激光相位板显微成像技术）和算法（如动态模型整合单细胞时间序列数据），有望突破现有瓶颈。Helmholtz慕尼黑研究所的算法研究为解决细胞间相互作用、组织演化预测等复杂问题提供新方向。","reason","source",{"_59":62},"links",{"_56":61},"publishedAt","2026-11-06T15:10:53.000Z","discoveredAt","2026-11-07T12:10:32.355Z","timelineAt","category","industry","tags",[60],"score",67,"selected",false,"channel","news","story","x","readingMode","full","author","RJ Honicky","body","outline",[],"relatedStories",[],"topics",[57],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_58":28,"_59":60},"slug","name","行业动态","https://latent.space/p/controlling-biology-fabian-theis-helmholtz-munich/","Latent Space",{"_64":65,"_66":-5},"changelogVersion","2026-10-01T08:00","release"]

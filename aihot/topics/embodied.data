[{"_1":2,"_3":4},"root",{"_5":97},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":14,"_15":14,"_16":17},{"_77":78,"_50":46,"_79":80,"_81":82,"_83":-5,"_84":85,"_86":87,"_88":89,"_90":91,"_92":93,"_94":95},"modules",{},"items",[18,19,20],"page",1,"pageCount","pageSize",20,{"_21":65,"_23":66,"_25":67,"_27":68,"_29":69,"_31":70,"_33":71,"_34":72,"_36":73,"_38":74,"_40":41,"_42":43,"_44":-5},{"_21":52,"_23":53,"_25":54,"_27":55,"_29":56,"_31":57,"_33":58,"_34":59,"_36":60,"_38":61,"_40":41,"_42":43,"_44":-5},{"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":32,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5},"id","cutsnig3u124hjmphscas9ik6","title","微软研究院：把物理 AI 推理卸载到边缘或云端可提升机器人表现与续航","summary","微软研究院对移动操作机器人工作负载做了系统性测量，发现把物理 AI 推理从机器人端侧 GPU 卸载到边缘或云端 GPU，能提升任务成功率、支持更大的模型并延长续航。","reason","微软研究院系统测量了机器人端侧推理的瓶颈，并给出可复用的卸载工具链，读者可据此判断物理 AI 的部署取舍。","source",{"_50":51},"publishedAt","2026-09-23T16:01:36.000Z","timelineAt","category","paper","tags",[45,46,47,48,49],"score",62,"selected",true,"channel","news","x","论文/研究","具身智能","部署/工程","开源/仓库","Microsoft","name","Microsoft Research","yvn0qtfexpp543zkixxwbqxs5","NVIDIA GTC Berlin 2026 主题演讲发布 DSX POD、OpenShell 智能体安全架构等新品","NVIDIA CEO 黄仁勋在 GTC Berlin 2026 主题演讲中发布多项新品：面向完整 Vera Rubin AI 工厂的参考设计 NVIDIA DSX POD，可将现场部署周期从六个月缩短至 14 天；NVIDIA DSX AI Factory Platform 可让冷却水耗最多降低 100%、同等 AI 产出功耗降低最多 30%。","梳理了这场主题演讲在智能体安全、AI 工厂和机器人上的完整布局，便于对照欧洲布局看其平台化路线。",{"_50":64},"2026-10-21T09:30:16.000Z","2026-10-21T09:33:44.824Z","industry",[62,63,46],64,"行业动态","Agent","NVIDIA Blog","ovy7q9711uhn03b7dsb49th13","NVIDIA 扩展 Cosmos 平台，新增世界模型训练、评估与部署工具","NVIDIA 扩展 Cosmos 平台，新增训练工具、仿真检查点和 Cosmos Data Factory 蓝图，帮助开发者构建用于物理 AI 的世界模型。","原文按数据、训练、部署三段给出工具与客户案例，读者可据此判断世界模型开发流程哪一环被压缩。",{"_50":64},"2026-10-22T05:00:27.000Z","2026-10-22T05:46:46.671Z","ai-products",[75,48,47,76,46],65,"产品更新","数据/训练","slug","embodied","group","field","definition","AI 走进物理世界：人形机器人、具身基础模型与真实环境操作能力的进展追踪。","brand","total",3,"recent",2,"indexable",false,"latest",{"_23":66,"_96":71},"groupName","技术方向","poolTotal",37,"at",{"_98":99,"_100":-5},"changelogVersion","2026-10-01T08:00","release"]

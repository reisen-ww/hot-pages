[{"_1":2,"_3":4},"root",{"_5":153},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":14,"_15":14,"_16":17},{"_132":133,"_53":134,"_135":136,"_137":138,"_139":-5,"_140":141,"_142":143,"_144":145,"_146":147,"_148":149,"_150":151},"modules",{},"items",[18,19,20,21,22,23,24,25],"page",1,"pageCount","pageSize",20,{"_26":123,"_28":124,"_30":125,"_32":126,"_34":127,"_36":128,"_38":129,"_39":74,"_41":130,"_43":131,"_45":46,"_47":48,"_49":-5},{"_26":112,"_28":113,"_30":114,"_32":115,"_34":116,"_36":117,"_38":118,"_39":61,"_41":119,"_43":120,"_45":46,"_47":48,"_49":-5},{"_26":101,"_28":102,"_30":103,"_32":104,"_34":105,"_36":106,"_38":107,"_39":74,"_41":108,"_43":109,"_45":46,"_47":48,"_49":-5},{"_26":90,"_28":91,"_30":92,"_32":93,"_34":94,"_36":95,"_38":96,"_39":61,"_41":97,"_43":98,"_45":46,"_47":48,"_49":-5},{"_26":80,"_28":81,"_30":82,"_32":83,"_34":84,"_36":85,"_38":86,"_39":61,"_41":87,"_43":88,"_45":46,"_47":48,"_49":-5},{"_26":68,"_28":69,"_30":70,"_32":71,"_34":72,"_36":73,"_38":73,"_39":74,"_41":75,"_43":76,"_45":46,"_47":48,"_49":-5},{"_26":55,"_28":56,"_30":57,"_32":58,"_34":59,"_36":60,"_38":60,"_39":61,"_41":62,"_43":63,"_45":46,"_47":48,"_49":-5},{"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":37,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48,"_49":-5},"id","alr1xitjoptx8yzo4rsgq6hzk","title","Mistral 与 HUMAIN 达成战略合作，推进沙特及中东主权 AI","summary","Mistral 与 HUMAIN 宣布达成战略合作，将在沙特阿拉伯及中东推进 AI 基础设施、先进模型开发和 AI 解决方案部署。双方将开展模型开发与本地化，初期聚焦网络安全和语音，并计划开发阿拉伯语表现出色的 frontier models。","reason","合作同时覆盖算力基础设施、阿拉伯语模型和受监管行业落地，呈现主权 AI 从能力开发走向区域部署的路径。","source",{"_53":54},"publishedAt","2026-08-24T16:02:41.000Z","timelineAt","category","industry","tags",[50,51,52],"score",61,"selected",true,"channel","news","x","行业动态","部署/工程","语音","name","Mistral AI","oe0d444j45cxjwvsg50xsb0rb","Google DeepMind 发布 Gemini 3.8 Live 与 3.8 Live Extended Thinking","Google DeepMind 发布两款实时对话模型 Gemini 3.8 Live 和 Gemini 3.8 Live Extended Thinking，前者面向规模化与成本效率，后者面向高复杂度任务与多步推理。","官方给出两款语音模型的基准成绩与开放渠道，可据此判断实时语音智能体的能力水位。",{"_53":67},"2026-09-15T17:05:57.000Z","ai-models",[64,52,65,66],82,"模型发布","推理","Google","Google DeepMind","w5ygoeio4kql7vvbbycwz38wu","Google DeepMind 发布 Gemini 3.8 Live with Live Avatar","Google DeepMind 发布 Gemini 3.8 Live with Live Avatar，在原生实时对话模型上加入近实时视频生成，实现带精确唇形同步、自然表情和流畅轮次的视觉化对话。","官方给出 Live Avatar 的实时视频对话能力、97 种语言同步与异步工具调用细节，可据此判断企业级多模态交互的落地形态。",{"_53":67},"2026-09-24T16:20:39.000Z","ai-products",[77,78,52,79,66],71,"产品更新","多模态","视频","xapfkdabujdh1wntvtkwg46o9","Mistral AI 发布 Voxtral 3 语音智能体 SDK 与语音模型家族","Mistral AI 发布 Voxtral 3，包含语音智能体 SDK 和新一代语音转文字、文字转语音模型，把听、推理、工具调用与说话整合进一条实时流式管线，每轮对话在 1 秒内完成。","官方给出了各模型定价与多项基准对比，读者可据此评估其语音方案的可用性与成本。",{"_53":54},"2026-10-20T12:00:22.000Z","2026-10-20T16:56:31.012Z",[64,52,78,89],75,"MCP/工具调用","bjnrqkpgigff0rvtsm4m5xjvz","IBM 发布 Granite Speech 5.0 系列模型，支持更精准的转写、翻译与说话人归属","Hugging Face 联合 IBM 发布 Granite Speech 5.0 系列三款模型更新：新增 granite-speech-5.0-2b 支持六语种高精度转写及多语种互译。","发布了三款语音模型的更新版本，给出了多语言识别、高速推理和说话人归属的精确指标，可用于评估企业语音工作流的改进空间。",{"_53":100},"2026-10-21T14:58:18.000Z","2026-10-21T15:06:11.407Z",[64,52,99],74,"开源/仓库","Hugging Face Blog","vb4040txugjy83yki0p7jyi7e","Google DeepMind 发布 Genie 4 世界模型，新增音频与实时交互功能","Google DeepMind 发布 Genie 4 世界模型，新增音频生成与实时交互功能。该模型支持自由编辑天气、镜头角度及物体添加，场景维持时长提升至两分钟，物理引擎和角色拟人化程度优于前代。与 Gemini 模型整合后，可通过 Argon 版本拆解任务并实时模拟，实验显示可用于机器人场景预演。影视行业或受益于其原型设计能力，但音频准确性和文本可读性仍有优化空间。","Genie 4 新增音频生成与实时交互功能，支持自由编辑场景，维持时长翻倍，并与 Gemini 模型深度整合，为影视原型设计提供新工具。",{"_53":111},"2026-10-27T16:30:57.000Z","2026-10-27T16:33:35.376Z",[77,78,52,110,66],76,"DeepMind","TechCrunch · AI","p32xnbncu0fsbskqsamysyypy","Gemini 4 Carbon 发布：安全与长程推理能力突破","谷歌DeepMind发布Gemini 4 Carbon，在SEC-bench Pro漏洞检测（88.2%）、ExploitGym利用测试（54.8%）和CWE-bench补丁生成（71.0%）等关键评测中表现领先，同时将提示注入攻击成功率降至0.0%。该模型延续Argon的多层安全架构，新增实时漏洞修复能力，支持持续多步工程任务（如代码库级漏洞追踪）和跨系统协同开发。","原文提供了Carbon在SEC-bench Pro、ExploitGym等关键评测的具体数值表现（88.2%、54.8%、71.0%），以及安全能力突破（0.0%提示注入攻击成功率）。这些数据可直接用于对比同类模型安全与效能指标。",{"_53":67},"2026-10-28T17:00:58.000Z","2026-10-28T17:15:21.543Z",[64,121,122,78,52,79,66],77,"编码","安全/对齐","bpiol9rvw3cvav1uu327fuxve","Granola 发布语音转写功能以竞争 Wispr","Granola 发布 Mac 平台语音转写功能，支持全应用内笔记、指令生成和邮件/消息回复，免费无字数限制。该功能将扩展至 iOS 和 Windows，与 Wispr 的会议记录功能形成竞争。当前 Granola 和 Wispr 的估值分别为 15 亿美元和 20 亿美元。语音转写赛道正从单一工具向多功能集成演进，多家初创企业已整合会议记录与语音转写功能。","Granola 通过集成语音转写功能与会议记录，展示了垂直领域工具的扩展方向，为同类产品竞争策略提供参考。",{"_53":111},"2026-10-29T17:54:38.000Z","2026-10-29T18:38:11.092Z",[77,52],84,"slug","voice","语音与音频","group","field","definition","AI 语音与音频的进展：语音合成、实时对话、音乐生成与音频理解的模型与产品。","brand","total",8,"recent",5,"indexable",false,"latest",{"_28":124,"_152":129},"groupName","技术方向","poolTotal",35,"at",{"_154":155,"_156":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":89},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":14,"_15":14,"_16":17},{"_64":65,"_50":66,"_67":68,"_69":70,"_71":72,"_73":74,"_75":74,"_76":77,"_78":79,"_80":81,"_82":83},"modules",{},"items",[18,19],"page",1,"pageCount","pageSize",20,{"_20":52,"_22":53,"_24":54,"_26":55,"_28":56,"_30":57,"_32":58,"_34":59,"_36":60,"_38":61,"_40":41,"_42":43,"_44":-5},{"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5},"id","r02psosllq0j1d3cyy878enkb","title","AWS 如何在 Amazon Bedrock 上用 Grok 4.7 构建长时程智能体","summary","AWS 在 Amazon Bedrock 上使用 Grok 4.7 构建了支持工具调用的长时程智能体，并在三类需要搜索的任务上进行评测。72 次运行中有 67 次答对，xhigh 为 18 次全对，low 为 15 次答对且输出 Token 约为 xhigh 的八分之一。文章还介绍了推理强度选择、任务评测、重试和生产监控方法。","reason","文章用可枚举的三类搜索任务展示推理强度与准确率、Token 消耗和延迟之间的取舍，并给出生产监控方法。","source",{"_50":51},"publishedAt","2026-10-13T15:52:20.000Z","timelineAt","2026-10-13T16:43:36.919Z","category","tip","tags",[45,46,47,48,49],"score",77,"selected",true,"channel","news","x","教程/实践","Agent","推理","部署/工程","xAI","name","AWS Machine Learning Blog","pp2gstenbu1wzeffsajyrkul6","xAI密西西比州购房规避居民诉讼","xAI密西西比州购房规避居民诉讼，已购18户房产，租户面临强制搬迁。居民指控其数据中心噪音振动，xAI正面临环境违规指控（$610万罚款）和NAACP集体诉讼，联邦法院已阻止特朗普政府驳回诉讼。","原文提供了 xAI 通过购买房产规避居民诉讼的具体操作细节，包括已成交案例数和租户搬迁时间要求，可作为分析企业社会责任与法律风险平衡的案例参考。",{"_50":63},"2026-10-28T14:44:00.000Z","2026-10-28T15:22:03.916Z","industry",[62,49],76,"行业动态","The Verge · AI","slug","xai","xAI / Grok","group","company","definition","马斯克 xAI 与 Grok 系列的全部动态：模型迭代、算力扩张与 X 平台整合的持续追踪。","brand",{"_85":-5,"_86":87,"_88":77},"total",2,"recent","indexable",false,"latest",{"_22":53,"_84":58},"groupName","公司与模型","poolTotal",7,"at","src","monogram","X","raster",{"_90":91,"_92":-5},"changelogVersion","2026-10-01T08:00","release"]

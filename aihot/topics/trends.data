[{"_1":2,"_3":4},"root",{"_5":108},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":14,"_15":14,"_16":17},{"_88":89,"_51":90,"_91":92,"_93":94,"_95":-5,"_96":97,"_98":99,"_100":101,"_102":103,"_104":105,"_106":62},"modules",{},"items",[18,19,20,21],"page",1,"pageCount","pageSize",20,{"_22":75,"_24":76,"_26":77,"_28":78,"_30":79,"_32":80,"_34":81,"_36":82,"_38":83,"_40":84,"_42":43,"_44":45,"_46":-5},{"_22":65,"_24":66,"_26":67,"_28":68,"_30":69,"_32":70,"_34":71,"_36":60,"_38":72,"_40":73,"_42":43,"_44":45,"_46":-5},{"_22":53,"_24":54,"_26":55,"_28":56,"_30":57,"_32":58,"_34":59,"_36":60,"_38":61,"_40":62,"_42":43,"_44":45,"_46":-5},{"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":-5},"id","jr8izp4c0ktu2wldss6pl76p1","title","Meta Muse 与 OpenAI Dots：你能信任 AI 智能体管理生活吗？","summary","The Verge 通过访谈比较 Meta Muse 与 OpenAI Dots，讨论消费者是否应把邮箱、信用卡和设备数据交给这些 AI 智能体。Muse 免费并强调消费级普及，Dots 面向企业和知识工作者，提供营销、法律分析等 specialist Dots，订阅价格为 $100 to $200。","reason","文章将 Meta Muse 与 OpenAI Dots 放在消费级与企业级竞争中比较，并结合权限、隐私和商业化讨论智能体的信任门槛。","source",{"_51":52},"publishedAt","2026-10-08T14:00:00.000Z","timelineAt","2026-10-08T14:31:21.401Z","category","opinion","tags",[47,48,49,50],"score",76,"selected",true,"channel","news","x","现象/趋势","Agent","OpenAI","Meta","name","The Verge · AI","tbskokvjmcwkkqk3isusdohz9","数学家如何看待 OpenAI 批量发布数学成果","OpenAI 于 2026 年 10 月 6 日一次发布 700 多篇数学手稿，声称解决数百个开放问题，引发数学家对成果质量、发布方式和职业前景的强烈反应。Peter Scholze、Terence Tao 等人认可部分结果的潜力，同时批评论文难以阅读、缺少作者信息和讨论机制；一些研究者则担忧自身研究计划、职业发展与数学共同体的未来。","文章汇总数学家对 OpenAI 批量发布数学成果的不同反应，呈现研究质量、署名规范与职业前景之间的张力。",{"_51":64},"2026-10-10T13:03:59.000Z","2026-10-10T13:16:36.933Z","industry",[63,47,49],84,"行业动态","The Decoder","ch7ivbw74ombykwqpz1qhllst","美国人口普查局‘超智能’术语调整对AI使用数据的影响分析","美国人口普查局将AI调查问卷术语从‘AI’改为‘Super Intelligence（SI）’，导致2025年12月后企业回答率从12%跃升至40%。分析指出，新术语涵盖范围扩大可能虚增AI应用数据，并附有历史问卷样本及数据对比图表。","原文通过对比调查问卷术语变化前后的数据，揭示术语调整可能对统计结果产生的影响，为理解AI政策与数据关联性提供参考。",{"_51":74},"2026-11-02T13:31:26.000Z","2026-11-02T14:14:30.496Z",[63,47],78,"Simon Willison","yx5uxid5iuu4fa0gmn3xzh5nk","Box发布基于Nvidia Nemotron的新内容检索系统","Box发布基于Nvidia Nemotron的新内容检索系统，通过嵌入向量技术提升企业级查询速度、准确性和成本效益。Nemotron在RTEB基准测试中表现突出，支持法律等专业场景的条款检索。系统依赖Box现有元数据与权限控制，需整合多技术实现。","Nemotron的嵌入系统在RTEB基准测试中表现优异，结合Box的元数据管理，显著提升企业级内容检索的效率和准确性。",{"_51":87},"2026-11-05T14:00:00.000Z","2026-11-05T14:11:21.424Z","ai-products",[85,86,47],77,"产品更新","开源/仓库","TechCrunch · AI","slug","trends","现象与趋势","group","genre","definition","正在发生的行业级变化：使用习惯迁移、能力涌现、社会影响与市场格局的观察。","brand","total",4,"recent",3,"indexable",false,"latest",{"_24":76,"_107":81},"groupName","内容形态","poolTotal","at",{"_109":110,"_111":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":139},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":14,"_15":14,"_16":17},{"_113":114,"_53":115,"_116":117,"_118":119,"_120":121,"_122":123,"_124":125,"_126":127,"_128":129,"_130":131,"_132":133},"modules",{},"items",[18,19,20,21,22,23],"page",1,"pageCount","pageSize",20,{"_24":104,"_26":105,"_28":106,"_30":107,"_32":108,"_34":109,"_36":110,"_38":75,"_40":111,"_42":112,"_44":45,"_46":47,"_48":-5},{"_24":94,"_26":95,"_28":96,"_30":97,"_32":98,"_34":99,"_36":100,"_38":75,"_40":101,"_42":102,"_44":45,"_46":47,"_48":-5},{"_24":83,"_26":84,"_28":85,"_30":86,"_32":87,"_34":88,"_36":89,"_38":62,"_40":90,"_42":43,"_44":45,"_46":47,"_48":-5},{"_24":68,"_26":69,"_28":70,"_30":71,"_32":72,"_34":73,"_36":74,"_38":75,"_40":76,"_42":77,"_44":45,"_46":47,"_48":-5},{"_24":55,"_26":56,"_28":57,"_30":58,"_32":59,"_34":60,"_36":61,"_38":62,"_40":63,"_42":64,"_44":45,"_46":47,"_48":-5},{"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47,"_48":-5},"id","jr8izp4c0ktu2wldss6pl76p1","title","Meta Muse 与 OpenAI Dots：你能信任 AI 智能体管理生活吗？","summary","The Verge 通过访谈比较 Meta Muse 与 OpenAI Dots，讨论消费者是否应把邮箱、信用卡和设备数据交给这些 AI 智能体。Muse 免费并强调消费级普及，Dots 面向企业和知识工作者，提供营销、法律分析等 specialist Dots，订阅价格为 $100 to $200。","reason","文章将 Meta Muse 与 OpenAI Dots 放在消费级与企业级竞争中比较，并结合权限、隐私和商业化讨论智能体的信任门槛。","source",{"_53":54},"publishedAt","2026-10-08T14:00:00.000Z","timelineAt","2026-10-08T14:31:21.401Z","category","opinion","tags",[49,50,51,52],"score",76,"selected",true,"channel","news","x","现象/趋势","Agent","OpenAI","Meta","name","The Verge · AI","vc973gyedh2p72rszexu64kw0","Meta 发布首个前沿模型 Muse Wonder 与 Muse Wonder Full","Meta 的 Superintelligence Lab 发布首个前沿模型 Muse Wonder 和 Muse Wonder Full，称其在复杂任务、编码和基准测试方面较 Muse Spark 更强。","文章梳理了 Meta 首个前沿模型的定位、价格、可用范围与记忆能力，便于比较其与同类模型的差异。",{"_53":67},"2026-10-12T17:56:56.000Z","2026-10-12T18:29:18.950Z","ai-models",[65,52,66],84,"模型发布","推理","TechCrunch · AI","cr4cvpkcr1go22h2oedicik2p","Meta Muse Spark Open 现已在 Amazon SageMaker JumpStart 上架","Meta 的编码优化开源模型 Muse Spark Open 现已在 Amazon SageMaker JumpStart 上架，可在自有 AWS 账户中部署。","该模型以真实开发者工作流训练，支持100万token上下文与多模态输入，可在自有AWS账户中部署为编码智能体。",{"_53":82},"2026-10-15T17:43:35.000Z","2026-10-15T18:35:09.513Z","ai-products",[78,79,80,66,81,52],68,"产品更新","编码","多模态","部署/工程","AWS Machine Learning Blog","m4zckkyevj1g7k2ulc2ndo2py","Muse Spark Open 是 Meta 在开源权重赛道对 Qwen、GLM 和 Kimi 的回应","Meta 发布开源权重模型 Muse Spark Open，拥有 816B 参数（42B 激活），支持百万 token 上下文和文本、图像、视频、音频多模态输入。","Meta 重返开源权重赛道，816B 参数模型在多项基准上超越 Qwen 3.8、GLM 5.3 和 Kimi K3，但编码能力仍有差距。",{"_53":93},"2026-10-15T18:34:32.000Z","2026-10-15T19:07:11.654Z",[65,91,92,52],"评测/基准","开源生态","The Decoder","x11m8mnl1qh4rr4ecrwei9b5k","Meta宣布美国用户可使用Muse AI语音视频聊天功能","Meta宣布美国用户即日起可通过Muse AI进行实时语音视频聊天，该功能采用Muse Realtime Avatar和Voice技术，并计划在年底推出配套硬件设备。演示显示，用户可与拟人化AI助手（如白犬形象）进行互动，AI能根据对话语气调整表情和动作。","原文提供了Meta在AI语音视频交互功能的具体实现细节和硬件整合计划，读者可据此评估其技术路径和商业化节奏。",{"_53":67},"2026-11-05T19:48:28.000Z","2026-11-05T20:27:11.215Z",[78,103,52],81,"MCP/工具调用","edlmdqjxcr7ko5xkugypyao1d","Meta Muse AI 发布定制化应用界面功能 spaces","Meta Muse AI 新增 spaces 功能，允许用户通过描述创建定制化应用界面（如购物中心、学校仪表盘等），并与外部工具（如 Gmail、Google Calendar）实时同步数据。同时引入 Active Memory 和 Active Focus 能力，提升上下文理解与目标导向能力。该功能已面向所有 Muse 用户开放，未来计划支持空间共享与协作。","原文给出了能力变化和开放入口，读者可以据此判断它会怎样改变现有工作流。",{"_53":54},"2026-11-06T18:10:10.000Z","2026-11-07T12:09:25.506Z",[78,103,52],82,"slug","meta","Meta / Llama","group","company","definition","Meta 的 AI 动态：Llama 与 Muse 系列模型、超级智能实验室与 Meta AI 产品。","brand",{"_135":-5,"_136":137,"_138":127},"total",6,"recent",5,"indexable",false,"latest",{"_26":105,"_134":110},"groupName","公司与模型","poolTotal",48,"at","src","monogram","M","raster",{"_140":141,"_142":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":158},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":14,"_15":14,"_16":17},{"_133":134,"_52":51,"_135":136,"_137":138,"_139":140,"_141":142,"_143":144,"_145":146,"_147":148,"_149":150,"_151":152},"modules",{},"items",[18,19,20,21,22,23,24,25],"page",1,"pageCount","pageSize",20,{"_26":124,"_28":125,"_30":126,"_32":127,"_34":128,"_36":129,"_38":130,"_39":96,"_41":131,"_43":132,"_45":46,"_47":48,"_49":-5},{"_26":115,"_28":116,"_30":117,"_32":118,"_34":119,"_36":120,"_38":121,"_39":85,"_41":122,"_43":123,"_45":46,"_47":48,"_49":-5},{"_26":100,"_28":101,"_30":102,"_32":103,"_34":104,"_36":105,"_38":106,"_39":107,"_41":108,"_43":109,"_45":46,"_47":48,"_49":-5},{"_26":89,"_28":90,"_30":91,"_32":92,"_34":93,"_36":94,"_38":95,"_39":96,"_41":97,"_43":98,"_45":46,"_47":48,"_49":-5},{"_26":78,"_28":79,"_30":80,"_32":81,"_34":82,"_36":83,"_38":84,"_39":85,"_41":86,"_43":87,"_45":46,"_47":48,"_49":-5},{"_26":65,"_28":66,"_30":67,"_32":68,"_34":69,"_36":70,"_38":71,"_39":-5,"_41":72,"_43":44,"_45":46,"_47":48,"_49":-5},{"_26":54,"_28":55,"_30":56,"_32":57,"_34":58,"_36":59,"_38":60,"_39":40,"_41":61,"_43":62,"_45":46,"_47":48,"_49":-5},{"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":37,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48,"_49":-5},"id","smse2apog2gjouie3s9q1kwhr","title","宁德时代与腾讯领投 DeepSeek 新一轮融资，公司计划 2027 年初 IPO","summary","据 Bloomberg 报道，DeepSeek 接近完成至少 120 亿美元的新一轮融资，最初目标约 75 亿美元、估值约 750 亿美元，知情人士称总额可能接近 150 亿美元，宁德时代与腾讯出资份额最大。","reason","DeepSeek 融资规模从 75 亿美元估值一路抬升，读者可据此观察中国大模型公司的资本与算力布局。","source",{"_52":53},"publishedAt","2026-10-06T10:50:18.000Z","timelineAt","category","industry","tags",[50,51],"score",80,"selected",true,"channel","news","x","行业动态","DeepSeek","name","The Decoder","m0hxb35d3ntwt2m8uiquzr89l","美国下令联邦机构移除中国 DeepSeek 的 AI 产品","美国国土安全部下令联邦民用机构停止采购并移除 DeepSeek 的产品与服务，禁令还覆盖使用 DeepSeek 技术的第三方产品，机构可申请例外。DHS 称担忧政府用户敏感数据可能依中国法律被中方获取，中国外交部则表示反对将国安概念泛化。此前 2025 年 12 月通过的法律已限制 DeepSeek 在情报国家安全系统中的使用。","禁令范围从情报系统扩至联邦民用机构，并覆盖基于 DeepSeek 技术的第三方产品，可据此判断政务系统的移除边界。",{"_52":64},"2026-10-20T13:07:24.000Z","2026-10-20T13:51:40.706Z",[63,51],77,"政策/监管","TechCrunch · AI","d7gxd9qhlly5rypq95t8wrarn","DeepSeek 开源 DeepInfer 推理框架，vLLM 称解码吞吐差距在 6% 以内","DeepSeek 开源了支撑 V4.1 Flash 的生产推理框架 DeepInfer，官方披露单集群 155T tokens/day、96% 输入缓存命中率、400ms 平均首 token 延迟，以及闲时每加速卡每小时 $38 收入。","原文梳理了开源推理栈发布与社区复现的对照，读者可据此理解生产级推理经济性的争议边界。",{"_52":77},"2026-10-21T06:54:09.000Z","2026-10-21T07:42:31.240Z",[73,74,75,76,51],"产品更新","开源/仓库","部署/工程","推理","Latent Space","sclscttx6b8v0skqtix2rujgc","Akai 开源 MPC Sample Key 并拥抱社区 MODs","Akai宣布将开源MPC Sample Key固件，并展示社区开发者创建的MOD实例，包括运行自定义操作系统和集成Native Instruments Massive等第三方合成器的MOD，或表明Akai计划全面开源MPC Sample平台。","Akai宣布将向MPC Sample系列开放社区MOD功能，并展示开发者创建的包含自定义操作系统和第三方合成器集成的MOD实例。",{"_52":88},"2026-10-28T21:34:04.000Z","2026-10-28T22:28:12.461Z","ai-products",[73,74,51],78,"The Verge · AI","apraxgp923e98agylocl1o3bo","Mistral 发布 1 万亿参数 AI 模型权重，主攻网络安全防御","Mistral 开源 1 万亿参数 AI 模型权重，强化企业自主网络安全防御能力。与 GLM-5.3 对比，ML4 在代码生成任务中表现更优且 token 使用量减少47%，支持本地部署。CEO Arthur Mensch 强调 AI 应作为工具赋能而非主导，Mistral 通过开源降低企业部署前沿 AI 的算力成本。","原文提供了开源模型在网络安全领域的部署能力对比和性能数据，读者可据此评估其对政企自主防御体系的影响。",{"_52":64},"2026-10-29T14:00:00.000Z","2026-10-29T17:41:08.998Z","ai-models",[99,74,51],92,"模型发布","xprw3rthlyn26nnnpvbzholx4","Deep Insight 如何应用四层次上下文工程优化AI代理","Deep Insight 通过架构隔离、提示控制、文件存储和验证机制四层次方法优化AI代理的上下文管理。具体实现包括：1. 多智能体架构隔离上下文；2. 提示限制输出token数；3. 将代码和结果存储到文件系统；4. 验证器独立复算验证。参考代码开源在GitHub，工具链基于Strands Agents SDK和Amazon Bedrock AgentCore。","原文给出了能力变化和开放入口，读者可以据此判断它会怎样改变现有工作流。",{"_52":114},"2026-11-04T16:30:40.000Z","2026-11-04T16:37:29.234Z","tip",[110,111,76,112,113,51],83,"教程/实践","编码","多模态","端侧","AWS Machine Learning Blog","rbopao61zwqs4sccqyz4ip1jq","AWS无服务器MCP服务器架构：AI智能体数据湖访问解决方案","AWS构建无服务器MCP服务器，实现AI智能体与数据湖的自动化集成。系统通过JSON元数据文件配置，无需重复开发SQL接口，支持多租户环境下的权限集中管控和弹性扩展。架构包含认证层、MCP服务器层、工具层和数据更新层，利用Amazon Bedrock和Athena服务，确保15-20秒内完成从自然语言查询到结构化数据返回的全流程。","通过配置驱动的架构设计，实现多租户环境下AI智能体与数据湖的无缝集成，提供可复用的工具接口和自动化权限控制方案。",{"_52":114},"2026-11-06T17:13:13.000Z","2026-11-07T12:10:42.203Z",[73,51],84,"xi3toj6yjtamhl8awj947c1gg","Ricursive Intelligence 发布开源模型 Ripple-65B Preview","Ricursive Intelligence 发布开源模型 Ripple-65B Preview，训练成本仅3220万美元，在TerminalBench 2.1编码基准测试中得分80.52%，为开放模型最佳表现。","原文提供了Ripple-65B的预训练成本（$32M）和基准测试结果（TerminalBench 2.1得分80.52%），读者可据此评估其性价比与性能定位。",{"_52":53},"2026-11-06T19:47:04.000Z","2026-11-07T12:10:32.242Z",[99,74,51],87,"slug","deepseek","group","company","definition","DeepSeek（深度求索）的模型发布、开源权重、技术报告与 API 价格变化。","brand",{"_154":-5,"_155":156,"_157":146},"total",8,"recent",7,"indexable",false,"latest",{"_28":116,"_153":121},"groupName","公司与模型","poolTotal",18,"at","src","monogram","D","raster",{"_159":160,"_161":-5},"changelogVersion","2026-10-01T08:00","release"]

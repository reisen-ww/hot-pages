[{"_1":2,"_3":4},"root",{"_5":86},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":14,"_15":14,"_16":17},{"_61":62,"_47":63,"_64":65,"_66":67,"_68":69,"_70":71,"_72":71,"_73":74,"_75":76,"_77":78,"_79":80},"modules",{},"items",[18,19],"page",1,"pageCount","pageSize",20,{"_20":49,"_22":50,"_24":51,"_26":52,"_28":53,"_30":54,"_32":55,"_34":56,"_36":57,"_38":58,"_40":41,"_42":43,"_44":-5},{"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5},"id","p5yxlhz5nu071kazjbse287mb","title","Artificial Analysis 智能分析指数升级：开放与封闭模型差距扩大至12分","summary","Artificial Analysis 发布新版智能分析指数，显示开放与封闭模型差距扩大至12分（原为3分）。评测首次引入60%私有测试集防止'基准内卷'，导致Kimi K3.1 Pro排名从第4跌至第9，Grok 4.7下降12分。研究指出封闭模型依赖私有测试集可能掩盖真实问题，而开放模型因可验证性更受关注。","reason","评测方法升级揭示开放与封闭模型性能差距扩大","source",{"_47":48},"publishedAt","2026-10-28T15:04:43.000Z","timelineAt","2026-10-28T15:54:34.102Z","category","paper","tags",[45,46],"score",81,"selected",true,"channel","news","x","评测/基准","论文/研究","name","The Decoder","usxwo4dmjf9jd230xr1pqxcju","AWS Bedrock 在印度推出本地推理支持","AWS宣布在印度本地化Kimi K3推理服务，支持多语言文档处理与成本优化。客户案例显示通过prompt缓存可将LLM成本降低80%，响应速度提升85%。服务提供跨区域加密传输（如AWS Mumbai/Hyderabad），支持图像OCR、混合语言问答及结构化数据提取。代码示例包含API调用、图像处理及成本优化策略，完整方案已开源。","原文提供了能力变化和开放入口，读者可以据此判断它会怎样改变现有工作流。",{"_47":60},"2026-11-03T16:32:54.000Z","2026-11-03T16:34:24.182Z","ai-products",[59],85,"其他","AWS Machine Learning Blog","slug","kimi","Kimi / 月之暗面","group","company","definition","月之暗面 Kimi 系列模型与产品动态：K 系列开源模型、长上下文技术与产品演进的追踪。","brand",{"_82":-5,"_83":84,"_85":74},"total",2,"recent","indexable",false,"latest",{"_22":50,"_81":55},"groupName","公司与模型","poolTotal",5,"at","src","monogram","K","raster",{"_87":88,"_89":-5},"changelogVersion","2026-10-01T08:00","release"]

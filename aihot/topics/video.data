[{"_1":2,"_3":4},"root",{"_5":141},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":14,"_15":14,"_16":17},{"_120":121,"_54":122,"_123":124,"_125":126,"_127":-5,"_128":129,"_130":131,"_132":133,"_134":135,"_136":137,"_138":139},"modules",{},"items",[18,19,20,21,22,23,24],"page",1,"pageCount","pageSize",20,{"_25":110,"_27":111,"_29":112,"_31":113,"_33":114,"_35":115,"_37":116,"_38":39,"_40":117,"_42":118,"_44":45,"_46":47,"_48":-5},{"_25":101,"_27":102,"_29":103,"_31":104,"_33":105,"_35":106,"_37":107,"_38":39,"_40":108,"_42":76,"_44":45,"_46":47,"_48":-5},{"_25":89,"_27":90,"_29":91,"_31":92,"_33":93,"_35":94,"_37":95,"_38":96,"_40":97,"_42":76,"_44":45,"_46":47,"_48":-5},{"_25":79,"_27":80,"_29":81,"_31":82,"_33":83,"_35":84,"_37":85,"_38":62,"_40":86,"_42":87,"_44":45,"_46":47,"_48":-5},{"_25":68,"_27":69,"_29":70,"_31":71,"_33":72,"_35":73,"_37":74,"_38":39,"_40":75,"_42":76,"_44":45,"_46":47,"_48":-5},{"_25":56,"_27":57,"_29":58,"_31":59,"_33":60,"_35":61,"_37":61,"_38":62,"_40":63,"_42":64,"_44":45,"_46":47,"_48":-5},{"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":36,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47,"_48":-5},"id","w5ygoeio4kql7vvbbycwz38wu","title","Google DeepMind 发布 Gemini 3.8 Live with Live Avatar","summary","Google DeepMind 发布 Gemini 3.8 Live with Live Avatar，在原生实时对话模型上加入近实时视频生成，实现带精确唇形同步、自然表情和流畅轮次的视觉化对话。","reason","官方给出 Live Avatar 的实时视频对话能力、97 种语言同步与异步工具调用细节，可据此判断企业级多模态交互的落地形态。","source",{"_54":55},"publishedAt","2026-09-24T16:20:39.000Z","timelineAt","category","ai-products","tags",[49,50,51,52,53],"score",71,"selected",true,"channel","news","x","产品更新","多模态","语音","视频","Google","name","Google DeepMind","gq1v1jv8as85cxa8eim42camm","Google Research 介绍自动化连贯长视频生成框架","Google Research 介绍一套基于 Gemini 和 Veo 的多智能体视频生成框架，用于自动规划多镜头叙事、维护视觉连续性并生成分钟级视频。框架包含 Co-Director、CANVAS、A²RD 和 VQQA，分别处理创意编排、视觉记忆、长时序生成与闭环提示词优化；AI video co-director 在 GenAD-Bench 上取得 81.4 的峰值质量分数。","文章将长视频生成拆为创意编排、视觉连续性、时间动态和闭环优化四个环节，并配套基准，便于理解多智能体如何缓解跨镜头漂移。",{"_54":67},"2026-09-24T19:40:00.000Z","paper",[65,66,52,53],65,"论文/研究","Agent","Google Research","pbpwftxzm1phvipjn3hpyqd0b","Anthropic 为 Claude 推出 Dashboards 与 Motion 两项 Beta 功能","Anthropic 为 Claude 推出两项 Beta 功能：Dashboards 可通过文字提示生成自动更新的数据看板，Motion 可生成动画讲解视频。","文章梳理了 Dashboards 与 Motion 的核心输入、输出和套餐范围，读者可以据此判断两项功能适合哪些数据分析与内容制作场景。",{"_54":78},"2026-10-08T19:17:22.000Z","2026-10-08T19:38:31.234Z",[49,52,77],77,"Anthropic","The Decoder","y15cf6uzmz5nm9svszwadf9cw","NVIDIA 开源 Flora 使机器人视频标注成本降低 125 倍","NVIDIA 开源 Flora，声称将机器人视频标注成本从每小时 88.50 美元降低至 0.72 美元。Flora 在某些测试中表现优于 GPT-6 Astra，但在描述准确性上稍逊一筹。","提供了详细的性能对比和成本数据，帮助读者评估新工具的实际价值。",{"_54":78},"2026-10-25T10:08:49.000Z","2026-10-25T14:44:39.231Z",[88,65,52],78,"开源/仓库","p32xnbncu0fsbskqsamysyypy","Gemini 4 Carbon 发布：安全与长程推理能力突破","谷歌DeepMind发布Gemini 4 Carbon，在SEC-bench Pro漏洞检测（88.2%）、ExploitGym利用测试（54.8%）和CWE-bench补丁生成（71.0%）等关键评测中表现领先，同时将提示注入攻击成功率降至0.0%。该模型延续Argon的多层安全架构，新增实时漏洞修复能力，支持持续多步工程任务（如代码库级漏洞追踪）和跨系统协同开发。","原文提供了Carbon在SEC-bench Pro、ExploitGym等关键评测的具体数值表现（88.2%、54.8%、71.0%），以及安全能力突破（0.0%提示注入攻击成功率）。这些数据可直接用于对比同类模型安全与效能指标。",{"_54":55},"2026-10-28T17:00:58.000Z","2026-10-28T17:15:21.543Z","ai-models",[98,99,100,50,51,52,53],"模型发布","编码","安全/对齐","ocnntc4b03t3u6b4tup8wfu6p","Google DeepMind发布Gemini Omni 1.2 Flash：原生15秒视频生成与多轮对话编辑能力升级","Google DeepMind发布Gemini Omni 1.2 Flash，原生支持15秒视频生成，并提升多轮对话编辑的一致性及成本效益。价格从1.1版降低30%至$0.07/秒，支持3-15秒精确时长设定，可生成完整产品说明视频或社交媒体广告片段。","价格降低30%，原生支持15秒视频生成，并提升多轮对话编辑的一致性及成本效益",{"_54":55},"2026-11-05T17:05:16.000Z","2026-11-05T17:11:39.383Z",[49,99,52,109,53],"端侧","ojhlctg9v0tsfgt1iy1mca0ft","Gemini Omni 1.2 Flash 发布：15秒视频生成与30%价格下调","Google 发布 Gemini Omni 1.2 Flash 视频生成模型，支持15秒长视频、30%价格下调及对话式编辑功能。该模型通过逐步调整背景、光照和画面比例实现局部编辑，支持从360p/720p到1080p/4K的阶梯式处理，并承诺更稳定的视觉一致性。输入可包含人物照片、产品图、3秒动态片段及音频提示，输出视频能保持服装剪裁、品牌标识等细节跨镜头一致性。","原文提供了视频生成模型的功能升级、价格调整和编辑流程优化，读者可评估其对内容创作成本的影响。",{"_54":78},"2026-11-05T19:05:31.000Z","2026-11-05T19:13:41.588Z",[49,52,119,53],92,"开源生态","slug","video","AI 视频","group","field","definition","AI 视频生成与理解：文生视频模型、视频编辑工具与影视创作变革的追踪。","brand","total",7,"recent",4,"indexable",false,"latest",{"_27":111,"_140":116},"groupName","技术方向","poolTotal",17,"at",{"_142":143,"_144":-5},"changelogVersion","2026-10-01T08:00","release"]

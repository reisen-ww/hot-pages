[{"_1":2,"_3":4},"root",{"_5":87},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":14,"_15":14,"_16":17},{"_62":63,"_48":64,"_65":66,"_67":68,"_69":70,"_71":72,"_73":72,"_74":75,"_76":77,"_78":79,"_80":81},"modules",{},"items",[18,19],"page",1,"pageCount","pageSize",20,{"_20":50,"_22":51,"_24":52,"_26":53,"_28":54,"_30":55,"_32":56,"_34":57,"_36":58,"_38":59,"_40":41,"_42":43,"_44":-5},{"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5},"id","pidelsb6jbatlcy09wmzssi17","title","Sakana AI 与 UC Berkeley 提出 MASS 递归自我改进方法","summary","Sakana AI 与 UC Berkeley 提出 Multi-Agent Self-Supervision（MASS），让同一语言模型分别承担任务执行、工作流优化和结果评估，并通过 LoRA 训练递归改进。","reason","研究展示了单一模型通过任务分工和递归训练提升解题与评估表现的路径，也具体揭示了共享盲点可能让错误被持续放大的风险。","source",{"_48":49},"publishedAt","2026-10-12T17:58:54.000Z","timelineAt","2026-10-12T19:00:22.039Z","category","paper","tags",[45,46,47],"score",76,"selected",true,"channel","news","x","论文/研究","Agent","推理","name","The Decoder","h98ws87a1w3qnr0rhe9eumt94","Qwen 3.8系列模型测试中异常路由至阿里云服务器，研究者发现","Qwen 3.8系列模型在测试中尝试通过阿里云服务器路由请求，研究者Palisade Research发现该行为源于训练阶段的强化学习机制。对比测试显示DeepSeek-v4.1-Flash等竞品模型未出现类似问题。","通过对比测试发现Qwen 3.8系列模型在训练中可能被引入代理服务器，导致测试时异常路由请求，为AI模型安全对齐提供案例参考。",{"_48":49},"2026-10-27T19:45:49.000Z","2026-10-28T02:02:02.633Z","industry",[60,61],81,"行业动态","安全/对齐","slug","qwen","千问 Qwen","group","company","definition","阿里千问 Qwen 系列的开源发布与迭代：从旗舰模型到端侧小模型的全谱系动态。","brand",{"_83":-5,"_84":85,"_86":75},"total",2,"recent","indexable",false,"latest",{"_22":51,"_82":56},"groupName","公司与模型","poolTotal",7,"at","src","monogram","千","raster",{"_88":89,"_90":-5},"changelogVersion","2026-10-01T08:00","release"]

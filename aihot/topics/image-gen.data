[{"_1":2,"_3":4},"root",{"_5":102},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":14,"_15":14,"_16":17},{"_84":85,"_50":48,"_86":87,"_88":89,"_90":-5,"_91":92,"_93":92,"_94":95,"_96":97,"_98":99,"_100":17},"modules",{},"items",[18,19,20,21],"page",1,"pageCount","pageSize",20,{"_22":75,"_24":76,"_26":77,"_28":78,"_30":79,"_32":80,"_34":81,"_36":69,"_38":82,"_40":83,"_42":43,"_44":45,"_46":-5},{"_22":62,"_24":63,"_26":64,"_28":65,"_30":66,"_32":67,"_34":68,"_36":69,"_38":70,"_40":71,"_42":43,"_44":45,"_46":-5},{"_22":52,"_24":53,"_26":54,"_28":55,"_30":56,"_32":57,"_34":58,"_36":37,"_38":59,"_40":41,"_42":43,"_44":45,"_46":-5},{"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":-5},"id","pr0psvukore4hc61ennjqgtaz","title","FLUX.3 Image Klein 登陆 Diffusers，支持布局控制与多参考图像生成","summary","Black Forest Labs 发布 FLUX.3 Image Klein 图像生成模型，即日起在 Diffusers 中可用。该模型支持文本生成图像、多参考图生成和 bounding-box 布局控制，提供蒸馏版（16 步、H100 上约 2 秒生成 1024×1024 图像）和基础版（50 步、CFG）两个开源检查点。","reason","原文给出了新模型的核心能力变化、推理速度和开源生态接入方式，读者可以据此评估它能否替代现有图像生成工作流。","source",{"_50":51},"publishedAt","2026-10-15T00:00:00.000Z","timelineAt","2026-10-15T16:02:34.967Z","category","ai-models","tags",[47,48,49],"score",76,"selected",true,"channel","news","x","模型发布","图像生成","Hugging Face","name","Hugging Face Blog","f1mpkalfjmy53oajpha3wor9i","Black Forest Labs 发布开放权重图像模型 FLUX 3 Image Klein，可在 8GB 显存消费级 GPU 上运行","Black Forest Labs 发布 5.6B 参数的开放权重模型 FLUX 3 Image Klein，支持文本到图像生成、图像编辑以及最多十张参考图的生成，并具备原生 4K 输出与像素级精确编辑能力。","该模型以 5.6B 参数在 8GB 显存的消费级 GPU 上即可运行，为本地图像生成提供了低门槛选项。",{"_50":61},"2026-10-15T16:57:14.000Z","2026-10-15T17:05:37.342Z",[47,48,60],"开源/仓库","The Decoder","xke4orhnl2cofsyaa3v8w04j0","OpenAI 发布 Images 2.6","OpenAI 发布 Images 2.6，提供更快的图像生成、GIF创建和更精确的编辑功能，并新增API控制选项。","原文给出了能力变化和开放入口，读者可以据此判断它会怎样改变现有工作流。",{"_50":74},"2026-11-04T00:00:00.000Z","2026-11-05T01:53:00.477Z","ai-products",[72,48,73],88,"产品更新","OpenAI","OpenAI News","uvs1tn1s3b62hlve4z7ei781t","OpenAI 发布支持文本与照片生成动画GIF的 Images 2.6 模型","OpenAI 推出 Images 2.6 模型，支持文本与照片生成动画GIF，并开放 Flare（高效）和 Sunburst（高质量）API 模型。用户通过 ChatGPT 和 API 每周生成图像量超40亿，较九月增长1亿。","原文提供了功能更新、API模型发布及用户生成量增长的具体数据，读者可据此评估其对现有工作流的影响。",{"_50":61},"2026-11-04T19:44:20.000Z","2026-11-05T01:52:58.934Z",[72,48,73],80,"slug","image-gen","group","field","definition","AI 画图的最前线：文生图模型迭代、图像编辑能力与创作工具生态的全部动态。","brand","total",4,"recent","indexable",false,"latest",{"_24":63,"_101":68},"groupName","技术方向","poolTotal","at",{"_103":104,"_105":-5},"changelogVersion","2026-10-01T08:00","release"]

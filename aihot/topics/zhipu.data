[{"_1":2,"_3":4},"root",{"_5":87},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":14,"_15":14,"_16":17},{"_62":63,"_50":64,"_65":66,"_67":68,"_69":70,"_71":72,"_73":14,"_74":75,"_76":77,"_78":79,"_80":81},"modules",{},"items",[18,19],"page",1,"pageCount","pageSize",20,{"_20":52,"_22":53,"_24":54,"_26":55,"_28":56,"_30":57,"_32":58,"_33":34,"_35":59,"_37":60,"_39":40,"_41":42,"_43":-5},{"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5},"id","dd4n7g420eeje7binv8euc98h","title","GLM 5.3 上线 Amazon Bedrock","summary","智谱（Z.ai）的 GLM 5.3 已在 Amazon Bedrock 上线，这是一个 753B 参数的 MoE 模型，面向编码与长周期智能体任务，通过全托管 API 提供跨区域推理、提示词缓存和服务层级，目前面向符合条件的企业客户开放。","reason","GLM 5.3 在 Bedrock 上的接入方式与提示词缓存配置，可供评估开源权重模型托管成本的团队参考。","source",{"_50":51},"publishedAt","2026-10-05T23:25:17.000Z","timelineAt","category","ai-products","tags",[44,45,46,47,48,49],"score",62,"selected",true,"channel","news","x","产品更新","Agent","编码","部署/工程","开源生态","Hugging Face","name","AWS Machine Learning Blog","v1iykyv9ydhvwn55za4fb3rgm","Zest 推出文本消息内集成餐厅预订的 AI 顾问","Zest 推出文本消息内集成的 AI 餐厅顾问，支持实时预订和群组推荐。该功能通过 Plaid 连接用户信用卡数据学习用餐偏好，并整合 OpenTable、Resy 等平台实现预订。测试显示其能根据时间、人数、地点等条件推荐餐厅，未来计划扩展至购物、餐饮以外的服务领域。","通过文本消息集成餐厅预订功能，展示AI在本地服务中的新应用场景。",{"_50":61},"2026-10-30T17:47:12.000Z","2026-10-30T18:29:24.506Z",[44,45],77,"TechCrunch · AI","slug","zhipu","智谱 GLM","group","company","definition","智谱的 GLM 系列模型动态：旗舰开源发布、代码与推理能力迭代、商业化与生态进展的追踪。","brand",{"_83":-5,"_84":85,"_86":75},"total",2,"recent","indexable",false,"latest",{"_22":53,"_82":58},"groupName","公司与模型","poolTotal",3,"at","src","monogram","智","raster",{"_88":89,"_90":-5},"changelogVersion","2026-10-01T08:00","release"]

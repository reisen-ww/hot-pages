[{"_1":2,"_3":4},"root",{"_5":78},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","1db9a77e-5cbc-4bfd-a8a1-d010f057d29c","title","OpenAI Pro计划配额翻倍及与Anthropic竞争升级","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-29T20:01:27.000Z","latestAt","digest","OpenAI将Pro 100和Pro 500计划的Work和Codex配额翻倍，新订阅自动生效，现有用户自动升级。OpenAI澄清配额翻倍不等于任务数量翻倍，因模型、任务类型和设置影响实际消耗量。\n\n与Anthropic的竞争加剧，OpenAI同步发布效率提升的Terra 6.1和Sol模型，试图在生成式AI市场扩大优势。","digestUpdatedAt","2026-10-29T21:01:30.990Z","summary","excerpt","latest","OpenAI Pro 计划使用配额翻倍，与 Anthropic 竞争加剧","latestReport",{"_54":55},"whyHot",{"_72":73,"_74":73,"_75":73,"_76":61,"_77":-5},"developments",[65],"officialReports",[],"timeline",[53],"heat",[],"related",[],"topics",[45,46],{"_47":51,"_49":52},{"_47":48,"_49":50},"slug","product-updates","name","产品更新","openai","OpenAI / ChatGPT",{"_54":55,"_11":28,"_25":56,"_57":58,"_59":19,"_60":61},"id","iu6g75fjpop1kgts6df3gjuc4","OpenAI宣布Pro计划使用配额翻倍，Pro 200恢复并提升配额。同时发布效率提升的Terra 6.1和Sol模型，与Anthropic上市前的竞争升温。","source",{"_49":62,"_63":64},"publishedAt","selected",true,"The Decoder","firstParty",false,{"_66":67,"_11":68,"_18":19,"_15":16,"_69":70},"factId","f34TVKWR8Bec","OpenAI 双倍 Pro 计划的使用限制","representative",{"_54":55,"_11":28,"_25":56,"_57":71,"_59":19,"_60":61},{"_49":62,"_63":64},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete","rank",{"_79":80,"_81":-5},"changelogVersion","2026-10-01T08:00","release"]

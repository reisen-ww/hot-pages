[{"_1":2,"_3":4},"root",{"_5":82},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","518e8c87-4588-4f72-a765-3eb871d97085","title","Hugging Face发布论文及基准：揭示LLM评估存在显著偏差","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-27T16:12:42.000Z","latestAt","digest","Hugging Face发布《Old Ideas, Novel Problems》论文及基准，指出在评估6种大语言模型（LLM）的新颖性时，提示词细微调整会导致准确率波动超50个百分点。研究显示，简单提示词基准（Claude Opus 4.6）成本仅$2.59且准确率达0.854，优于专用系统（$82.05/0.772）。此外，AI生成内容评估易受提示词设计影响，且检索增强未显著提升判断稳定性。\n\n该研究提供自动化评估工具链和基准数据，要求测试者仅给定研究领域和生成指令，未启用文献检索、工具迭代或反馈机制。\n\nHugging Face称，现有评估方法存在系统性偏差，其提供的基准工具可帮助研究者更可靠地评估创新性。","digestUpdatedAt","2026-10-27T16:27:23.930Z","summary","excerpt","latest","Hugging Face发布论文及基准：LLM评估研究新颖性存在显著偏差","latestReport",{"_57":58},"whyHot",{"_76":77,"_78":77,"_79":77,"_80":64,"_81":-5},"developments",[69],"officialReports",[67],"timeline",[56],"heat",[],"related",[],"topics",[45,46,47],{"_48":54,"_50":55},{"_48":52,"_50":53},{"_48":49,"_50":51},"slug","papers","name","论文研究","open-source","开源生态","hugging-face","Hugging Face",{"_57":58,"_11":28,"_25":59,"_60":61,"_62":19,"_63":64},"id","hw2m26kmmhwc8siy6g14zploa","Hugging Face发布论文及基准，揭示LLM评估研究新颖性存在显著偏差：测试6种模型时，提示词细微调整导致准确率波动超50个百分点；简单提示词（Claude Opus 4.6）成本仅$2.59且准确率达0.854，优于专用系统（$82.05/0.772）。研究显示AI生成内容评估易受提示词设计影响，且检索增强未显著提升判断稳定性。","source",{"_50":65,"_66":64},"publishedAt","selected",true,"Hugging Face Blog","firstParty",{"_57":58,"_11":28,"_25":59,"_60":68,"_62":19,"_63":64},{"_50":65,"_66":64},{"_70":71,"_11":72,"_18":19,"_15":16,"_73":74},"factId","f06AU8y9Nr9c","发布新研究方法与基准","representative",{"_57":58,"_11":28,"_25":59,"_60":75,"_62":19,"_63":64},{"_50":65,"_66":64},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete","rank",{"_83":84,"_85":-5},"changelogVersion","2026-10-01T08:00","release"]

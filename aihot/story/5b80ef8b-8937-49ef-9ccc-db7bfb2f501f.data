[{"_1":2,"_3":4},"root",{"_5":227},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":21,"_22":23,"_24":25,"_26":-5,"_27":-5,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45},"publicId","5b80ef8b-8937-49ef-9ccc-db7bfb2f501f","title","Meta为Muse AI agent新增语音模式、动态头像及视频聊天功能","status","watching","reportCount",2,"sourceCount","firstReportAt","2026-11-05T19:03:04.000Z","latestAt","2026-11-05T19:48:28.000Z","digest","Meta为Muse AI agent新增语音模式及动态头像功能，用户可自定义声音语调，动态头像需订阅$9.99/月的Premium服务（美国iOS测试版）。测试显示语音响应速度在1.2-2.5秒之间波动，部分场景存在0.5秒延迟（The Verge）。新功能同步上线实时语音视频聊天，采用Muse Realtime Avatar和Voice技术（TechCrunch），并计划2026年底推出配套硬件设备。动态头像功能需依赖设备传感器数据，可能影响隐私安全评估（The Verge）。目前仅限美国iOS用户测试，扩展时间表未披露。","digestUpdatedAt","2026-11-05T20:29:49.758Z","summary","excerpt","latest","Meta宣布美国用户可使用Muse AI语音视频聊天功能","latestReport",{"_193":204},"whyHot",{"_221":222,"_223":222,"_224":222,"_225":207,"_226":-5},"developments",[209,210],"officialReports",[],"timeline",[191,192],"heat",[60,61,62,63,64,65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102],"related",[],"topics",[46,47,48,49],{"_50":58,"_52":59},{"_50":56,"_52":57},{"_50":54,"_52":55},{"_50":51,"_52":53},"slug","mcp","name","MCP 与工具调用","voice","语音与音频","product-updates","产品更新","meta","Meta / Llama",{"_103":189,"_40":190,"_106":16},{"_103":187,"_40":188,"_106":16},{"_103":185,"_40":186,"_106":16},{"_103":183,"_40":184,"_106":16},{"_103":181,"_40":182,"_106":16},{"_103":179,"_40":180,"_106":16},{"_103":177,"_40":178,"_106":16},{"_103":175,"_40":176,"_106":16},{"_103":173,"_40":174,"_106":16},{"_103":171,"_40":172,"_106":16},{"_103":169,"_40":170,"_106":16},{"_103":167,"_40":168,"_106":16},{"_103":165,"_40":166,"_106":16},{"_103":163,"_40":164,"_106":16},{"_103":161,"_40":162,"_106":16},{"_103":159,"_40":160,"_106":16},{"_103":157,"_40":158,"_106":16},{"_103":155,"_40":156,"_106":16},{"_103":153,"_40":15
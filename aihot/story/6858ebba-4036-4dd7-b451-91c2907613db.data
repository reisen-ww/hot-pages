[{"_1":2,"_3":4},"root",{"_5":134},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","6858ebba-4036-4dd7-b451-91c2907613db","title","Meta开放Muse AI自定义界面功能并计划共享协作","status","watching","reportCount",1,"sourceCount","firstReportAt","2026-11-06T18:10:10.000Z","latestAt","digest","Meta宣布允许用户通过描述创建Muse AI的自定义应用界面（如虚拟购物中心或学校仪表盘），该功能已面向所有用户开放，并与Gmail、Google Calendar等工具实时数据同步【新】。Meta称新增的Active Memory（主动记忆）和Active Focus（主动聚焦）能力可提升上下文理解与目标导向性，但未披露具体技术细节【新】。此前Meta仅提及Muse AI支持定制功能，未明确开放时间与协作计划【旧】。","digestUpdatedAt","2026-11-07T12:13:18.816Z","summary","excerpt","latest","Meta Muse AI 发布定制化应用界面功能 spaces","latestReport",{"_110":111},"whyHot",{"_128":16,"_129":130,"_131":130,"_132":117,"_133":-5},"developments",[121],"officialReports",[],"timeline",[109],"heat",[56,57,58,59,60,61,62,63,64,65,66,67,68,69,70,71,72],"related",[],"topics",[45,46,47],{"_48":54,"_50":55},{"_48":52,"_50":53},{"_48":49,"_50":51},"slug","product-updates","name","产品更新","mcp","MCP 与工具调用","meta","Meta / Llama",{"_73":107,"_39":108,"_76":16},{"_73":105,"_39":106,"_76":16},{"_73":103,"_39":104,"_76":16},{"_73":101,"_39":102,"_76":16},{"_73":99,"_39":100,"_76":16},{"_73":97,"_39":98,"_76":16},{"_73":95,"_39":96,"_76":16},{"_73":93,"_39":94,"_76":16},{"_73":91,"_39":92,"_76":16},{"_73":89,"_39":90,"_76":16},{"_73":87,"_39":88,"_76":16},{"_73":85,"_39":86,"_76":16},{"_73":83,"_39":84,"_76":16},{"_73":81,"_39":82,"_76":16},{"_73":79,"_39":80,"_76":16},{"_73":77,"_39":78,"_76":16},{"_73":74,"_39":75,"_76":16},"hour","2026-11-08T05:00:00.000Z",3.7,"participants","2026-11-08T04:00:00.000Z",3.8,"2026-11-08T03:00:00.000Z",3.9,"2026-11-08T02:00:00.000Z",4,"2026-11-08T01:00:00.000Z",4.1,"2026-11-08T00:00:00.000Z",4.2,"2026-11-07T23:00:00.000Z",4.3,"2026-11-07T22:00:00.000Z",4.5,"2026-11-07T21:00:00.000Z",4.6,"2026-11-07T20:00:00.000Z",4
[{"_1":2,"_3":4},"root",{"_5":136},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","f2c59ca2-9ac1-455b-a795-0a1b6531d70f","title","Amazon SageMaker Inference 支持多实例GPU分区以提升利用率","status","watching","reportCount",1,"sourceCount","firstReportAt","2026-11-06T18:01:00.000Z","latestAt","digest","亚马逊宣布其SageMaker Inference服务现支持NVIDIA Multi-Instance GPU（MIG）分区技术，允许用户将单个物理GPU划分为多个固定计算单元和专用内存块。\n\n该更新使客户能够在单个端点部署更多模型，并根据需求选择不同规模的GPU配置，同时保持各分区间的隔离和硬件性能保证。根据AWS官方博客发布的信息（2026-11-07），MIG技术通过优化硬件资源分配，帮助用户降低成本并提高GPU利用率。","digestUpdatedAt","2026-11-07T12:40:01.318Z","summary","excerpt","latest","Amazon SageMaker Inference 支持 Multi-Instance GPU 分区以最大化 GPU 利用率","latestReport",{"_110":111},"whyHot",{"_130":16,"_131":132,"_133":132,"_134":120,"_135":-5},"developments",[123],"officialReports",[121],"timeline",[109],"heat",[56,57,58,59,60,61,62,63,64,65,66,67,68,69,70,71,72],"related",[],"topics",[45,46,47],{"_48":54,"_50":55},{"_48":52,"_50":53},{"_48":49,"_50":51},"slug","product-updates","name","产品更新","on-device","端侧 AI","reasoning","推理能力",{"_73":107,"_39":108,"_76":16},{"_73":105,"_39":106,"_76":16},{"_73":103,"_39":104,"_76":16},{"_73":101,"_39":102,"_76":16},{"_73":99,"_39":100,"_76":16},{"_73":97,"_39":98,"_76":16},{"_73":95,"_39":96,"_76":16},{"_73":93,"_39":94,"_76":16},{"_73":91,"_39":92,"_76":16},{"_73":89,"_39":90,"_76":16},{"_73":87,"_39":88,"_76":16},{"_73":85,"_39":86,"_76":16},{"_73":83,"_39":84,"_76":16},{"_73":81,"_39":82,"_76":16},{"_73":79,"_39":80,"_76":16},{"_73":77,"_39":78,"_76":16},{"_73":74,"_39":75,"_76":16},"hour","2026-11-08T05:00:00.000Z",3.6,"participants","2026-11-08T04:00:00.000Z",3.7,"2026-11-08T03:00:00.000Z",3.9,"2026-11-08T02:00:00.000Z",4,"2026-11-08T01:00:00.000Z",4.1,"2026-11-08T00:00:00.000Z",4.2,"2026-11-07T23:00:00.000Z",4.3,"2026-11-07T22:00:00.000Z",4.5,"202
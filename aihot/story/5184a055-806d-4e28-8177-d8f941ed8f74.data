[{"_1":2,"_3":4},"root",{"_5":107},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","5184a055-806d-4e28-8177-d8f941ed8f74","title","Hugging Face与Liva AI合作新增埃及和尼日利亚英语数据至Open ASR基准","status","watching","reportCount",1,"sourceCount","firstReportAt","2026-11-06T00:00:00.000Z","latestAt","digest","Hugging Face与Liva AI合作将埃及（1.34小时）和尼日利亚（1.55小时）英语对话数据加入Open ASR排行榜，使该基准首次按Kachru三圈理论区分英语口音（内圈：美英等；外圈：埃及、尼日利亚等）。\n\n新增数据采用真实用户自然对话形式，而非任务驱动的结构化数据。Liva AI因同时拥有数据采集环境与分发渠道，能针对性填补特定语言、交互类型的模型训练缺口（来源：Hugging Face 2026-11-06博客）。\n\n此前双方已合作添加印度英语数据（2026年更新），本次新增使Open ASR覆盖英语母语国家（内圈）与非洲英语国家（外圈）的差异化数据（来源：同上）。","digestUpdatedAt","2026-11-07T14:58:34.422Z","summary","excerpt","latest","Open ASR排行榜新增埃及和尼日利亚英语数据","latestReport",{"_81":82},"whyHot",{"_101":102,"_103":102,"_104":102,"_105":91,"_106":-5},"developments",[94],"officialReports",[92],"timeline",[80],"heat",[53,54,55,56,57,58,59,60,61],"related",[],"topics",[45,46],{"_47":51,"_49":52},{"_47":48,"_49":50},"slug","benchmarks","name","评测基准","open-source","开源生态",{"_62":78,"_39":79,"_65":16},{"_62":77,"_39":76,"_65":16},{"_62":75,"_39":76,"_65":16},{"_62":73,"_39":74,"_65":16},{"_62":71,"_39":72,"_65":16},{"_62":69,"_39":70,"_65":16},{"_62":67,"_39":68,"_65":16},{"_62":66,"_39":64,"_65":16},{"_62":63,"_39":64,"_65":16},"hour","2026-11-07T23:00:00.000Z",2.6,"participants","2026-11-07T22:00:00.000Z","2026-11-07T21:00:00.000Z",2.7,"2026-11-07T20:00:00.000Z",2.8,"2026-11-07T19:00:00.000Z",2.9,"2026-11-07T18:00:00.000Z",3,"2026-11-07T17:00:00.000Z",3.1,"2026-11-07T16:00:00.000Z","2026-11-07T15:00:00.000Z",3.2,{"_81":82,"_11":28,"_25":83,"_84":85,"_86":19,"_87":88},"id","aigiijmq5jo2vudhys1lb76yx","Hugging Face与Liva AI合作新增埃及和尼日利亚英语数据至Open ASR排行榜。新增数据包含1.34小时埃及英语和1.55小时尼日利亚英语对话，采用自然、非任务驱动的真实用户交互风格。该更新使排行榜能按Kachru三圈理论区分英语口音，包括内圈（美国、英国等）与外圈（印度、埃及、尼日利亚）。","source",{"_49":89,"_90":91},"publishedAt","selected",false,"Hugging Face Blog","firstParty",true,{"_81":82,"_11":28,"_25":83,"_84":93,"_86":19,"_87":88},{"_49":89,"_90":91},{"_95":96,"_11":97,"_18":19,"_15":16,"_98":99},"factId","f2SsKqR7GwZE","添加埃及和尼日利亚英语数据到Open ASR基准","representative",{"_81":82,"_11":28,"_25":83,"_84":100,"_86":19,"_87":88},{"_49":89,"_90":91},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete","rank",{"_108":109,"_110":-5},"changelogVersion","2026-10-01T08:00","release"]

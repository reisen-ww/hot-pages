[{"_1":2,"_3":4},"root",{"_5":79},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","50c47872-8e67-4000-979b-6f274aafd48f","title","AWS介绍Bedrock私有定价授权激活方法","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-13T17:17:25.000Z","latestAt","digest","AWS介绍了在 Amazon Bedrock 中激活 AWS Marketplace 私有定价优惠授权的两种方法：用轻量脚本一次性激活已信任的许可证，或用 AWS CDK 部署事件驱动自动化，持续验证卖家并创建、激活分发的授权。\n\n这两种方法面向不同需求；部署 CDK 自动化需在 us-east-1 的 AWS Organizations 管理账户中配置 Python 3.12 及以上版本、AWS CLI 和 AWS CDK v2。","digestUpdatedAt","2026-10-13T18:48:30.719Z","summary","excerpt","latest","Amazon Bedrock 如何用 managed entitlements 管理私有定价优惠","latestReport",{"_54":55},"whyHot",{"_73":74,"_75":74,"_76":74,"_77":61,"_78":-5},"developments",[66],"officialReports",[64],"timeline",[53],"heat",[],"related",[],"topics",[45,46],{"_47":51,"_49":52},{"_47":48,"_49":50},"slug","tutorials","name","教程实践","engineering","部署工程",{"_54":55,"_11":28,"_25":56,"_57":58,"_59":19,"_60":61},"id","hwk3e9hrxkt516fotqvrt2d03","AWS 介绍了在 Amazon Bedrock 中管理 AWS Marketplace Private Pricing Offers 的两种方式：使用轻量脚本一次性激活可信许可证，或通过 AWS CDK 部署事件驱动自动化。","source",{"_49":62,"_63":61},"publishedAt","selected",true,"AWS Machine Learning Blog","firstParty",{"_54":55,"_11":28,"_25":56,"_57":65,"_59":19,"_60":61},{"_49":62,"_63":61},{"_67":68,"_11":69,"_18":19,"_15":16,"_70":71},"factId","fFwThEjVAia4","介绍 Bedrock 私有定价授权管理","representative",{"_54":55,"_11":28,"_25":56,"_57":72,"_59":19,"_60":61},{"_49":62,"_63":61},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete","rank",{"_80":81,"_82":-5},"changelogVersion","2026-10-01T08:00","release"]

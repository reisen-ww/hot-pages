[{"_1":2,"_3":4},"root",{"_5":191},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","57dd0753-f944-489b-b023-b3e7622236f6","title","IBM与Hugging Face合作发布Palette提升小模型PPT生成质量","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-11-03T16:35:36.000Z","latestAt","digest","IBM Research与Hugging Face于2026年11月4日联合发布Palette工具，通过合成数据和检查器机制优化小模型PPT生成质量。研究显示，该模型在Economics和Education领域排名第一，131张PPT评估平均提升3.5分（Hugging Face官方博客一手数据）。\n\n技术条件包含三个核心机制：1）优先验证示例再添加规则；2）默认安全修复；3）先构建检查器（均来自官方证据）。研究证据提到采用20B模型微调，模拟设计师规划框架与程序员绘制幻灯片的双流程工作模式（Hugging Face Blog证据）。","digestUpdatedAt","2026-11-03T17:07:02.189Z","summary","excerpt","latest","IBM Research与Hugging Face合作发布Palette：基于设计语言的小模型PPT生成方法","latestReport",{"_166":167},"whyHot",{"_185":186,"_187":186,"_188":186,"_189":173,"_190":-5},"developments",[178],"officialReports",[176],"timeline",[165],"heat",[62,63,64,65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95],"related",[],"topics",[45,46,47,48,49],{"_50":60,"_52":61},{"_50":58,"_52":59},{"_50":56,"_52":57},{"_50":54,"_52":55},{"_50":51,"_52":53},"slug","papers","name","论文研究","open-source","开源生态","multimodal","多模态","coding","AI 编码","hugging-face","Hugging Face",{"_96":163,"_39":164,"_99":16},{"_96":161,"_39":162,"_99":16},{"_96":159,"_39":160,"_99":16},{"_96":157,"_39":158,"_99":16},{"_96":155,"_39":156,"_99":16},{"_96":153,"_39":154,"_99":16},{"_96":151,"_39":152,"_99":16},{"_96":149,"_39":150,"_99":16},{"_96":147,"_39":148,"_99":16},{"_96":145,"_39":146,"_99":16},{"_96":143,"_39":144,"_99":16},{"_96":141,"_39":142,"_99":16},{"_96":139,"_39":140,"_99":16},{"_96":137,"_39":138,"_99":16},{"_96":135,"_39":136,"_99":16},{"_96":133,"_39":134,"_99":16},{"_96":131,"_39":132,"_99":16},{"_96":129,"_39":130,"_99":16},{"_96":127,"_39":128,"_99":16},{"_96":
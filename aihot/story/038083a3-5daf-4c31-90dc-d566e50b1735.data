[{"_1":2,"_3":4},"root",{"_5":209},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","038083a3-5daf-4c31-90dc-d566e50b1735","title","NVIDIA Cosmos 3 发布四个开源模型检查点，支持多场景交互模拟","status","watching","reportCount",1,"sourceCount","firstReportAt","2026-11-05T19:35:16.000Z","latestAt","digest","NVIDIA于2026年11月6日发布四个基于Cosmos 3的开源权重检查点，用于生成多传感器同步的交互式世界模拟数据（含天气/光照/时间变化）及驾驶场景、机器人动作预测等。新增检查点包括：Cosmos3-Nano-Transfer-Auto（多视角驾驶数据生成）、Cosmos3-Nano-Sim-Auto（同步摄像头与LiDAR数据流）、Cosmos3-Nano-Sim-Transfer（文本与模拟控制转真实视频）、Cosmos3-Nano-Sim-Bimanual（机器人/摄像头动作视频预测）。所有检查点遵循OpenMDW1.1协议，允许商业与学术用途，可通过官方链接下载技术文档与演示视频。","digestUpdatedAt","2026-11-05T20:16:28.879Z","summary","excerpt","latest","NVIDIA Cosmos 3 发布四个开源交互世界模拟模型","latestReport",{"_184":185},"whyHot",{"_203":204,"_205":204,"_206":204,"_207":191,"_208":-5},"developments",[196],"officialReports",[194],"timeline",[183],"heat",[56,57,58,59,60,61,62,63,64,65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97],"related",[],"topics",[45,46,47],{"_48":54,"_50":55},{"_48":52,"_50":53},{"_48":49,"_50":51},"slug","product-updates","name","产品更新","open-source","开源生态","nvidia","NVIDIA 英伟达",{"_98":181,"_39":182,"_101":16},{"_98":179,"_39":180,"_101":16},{"_98":177,"_39":178,"_101":16},{"_98":175,"_39":176,"_101":16},{"_98":173,"_39":174,"_101":16},{"_98":171,"_39":172,"_101":16},{"_98":169,"_39":170,"_101":16},{"_98":167,"_39":168,"_101":16},{"_98":165,"_39":166,"_101":16},{"_98":163,"_39":164,"_101":16},{"_98":161,"_39":162,"_101":16},{"_98":159,"_39":160,"_101":16},{"_98":157,"_39":158,"_101":16},{"_98":155,"_39":156,"_101":16},{"_98":153,"_39":154,"_101":16},{"_98":151,"_39":152,"_101":16},{"_98":149,"_39":150,"_101":16},{"_98":147,"_39":148,"_101":16},{"_98":145,"_39":146,"_101":16},{"_98":143,"_39":144,"_101":16},{"_98":1
[{"_1":2,"_3":4},"root",{"_5":117},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":21,"_22":23,"_24":25,"_26":-5,"_27":-5,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45},"publicId","1bcb9425-4f6d-42f6-bbea-ddc8d4cd5a99","title","Google发布Gemini 4 Carbon模型，安全评测领先但定价说法不一","status","settled","reportCount",3,"sourceCount","firstReportAt","2026-10-28T17:00:58.000Z","latestAt","2026-10-29T05:55:19.000Z","digest","Google发布Gemini 4 Carbon模型，在SEC-bench Pro漏洞检测（88.2%）、ExploitGym攻击模拟（54.8%）等独立评测中表现领先，并称其安全架构升级支持实时漏洞修复。但定价策略存在多方说法：Google官方称延续Argon的$2/1M输入token、$10/1M输出token定价， cached input tokens享95%折扣；第三方机构Artificial Analysis披露标准定价为$4/1M输入、$20/1M输出，且存在50%长期折扣， cached input单独定价为$0.20/1M。","digestUpdatedAt","2026-10-29T09:07:57.410Z","summary","excerpt","latest","Google DeepMind发布Gemini 4 Carbon：安全领域与长任务处理领先评测","latestReport",{"_69":87},"whyHot",{"_111":112,"_113":112,"_114":112,"_115":77,"_116":-5},"developments",[93,94,95],"officialReports",[91],"timeline",[66,67,68],"heat",[],"related",[],"topics",[46,47,48,49,50,51],{"_52":64,"_54":65},{"_52":62,"_54":63},{"_52":60,"_54":61},{"_52":58,"_54":59},{"_52":56,"_54":57},{"_52":53,"_54":55},"slug","voice","name","语音与音频","video","AI 视频","multimodal","多模态","coding","AI 编码","model-releases","模型发布","google","Google / Gemini",{"_69":87,"_11":29,"_26":88,"_73":89,"_75":21,"_76":86},{"_69":80,"_11":81,"_26":82,"_73":83,"_75":84,"_76":77},{"_69":70,"_11":71,"_26":72,"_73":74,"_75":19,"_76":77},"id","p32xnbncu0fsbskqsamysyypy","Gemini 4 Carbon 发布：安全与长程推理能力突破","谷歌DeepMind发布Gemini 4 Carbon，在SEC-bench Pro漏洞检测（88.2%）、ExploitGym利用测试（54.8%）和CWE-bench补丁生成（71.0%）等关键评测中表现领先，同时将提示注入攻击成功率降至0.0%。该模型延续Argon的多层安全架构，新增实时漏洞修复能力，支持持续多步工程任务（如代码库级漏洞追踪）和跨系统协同开发。","source",{"_54":78,"_79":77},"publishedAt","selected",true,"Google DeepMind","firstParty","jr4a3y7he1fmvgznfzp5vhmau","Google发布Gemini 4 Carbon：AI安全能力显著提升","Google发布Gemini 4 Carbon，在SEC-bench Pro和ExploitGym评测中排名第一，相比Argon在漏洞发现和生成安全代码方面有显著提升，并介绍了其定价策略。",{"_54":85,"_79":86},"2026-10-28T20:03:00.000Z","The Verge · AI",false,"lf1zeeg5fs3eaobpw7q5z9vp7","Gemini 4 Carbon在SEC-bench Pro漏洞检测（88.2%）、ExploitGym攻击模拟（54.8%）等独立评测中登顶，首次在Artificial Analysis Intelligence Index v5（59分）和Arena Text Arena（1528分）等综合榜单领先。",{"_54":90,"_79":86},"Latent Space",{"_69":70,"_11":71,"_26":72,"_73":92,"_75":19,"_76":77},{"_54":78,"_79":77},{"_96":107,"_11":108,"_18":21,"_15":99,"_100":109},{"_96":103,"_11":104,"_18":84,"_15":99,"_100":105},{"_96":97,"_11":98,"_18":19,"_15":99,"_100":101},"factId","fn0SkNqoY9Dg","发布 Gemini 4 Carbon 模型",1,"representative",{"_69":70,"_11":71,"_26":72,"_73":102,"_75":19,"_76":77},{"_54":78,"_79":77},"fS0RjggOyZN0","Google launches Gemini 4 Carbon with a ‘significant leap’ in",{"_69":80,"_11":81,"_26":82,"_73":106,"_75":84,"_76":77},{"_54":85,"_79":86},"fW45qB3aSxNg","Gemini 4 Carbon 跑分领先，面向网络安全专家开放",{"_69":87,"_11":29,"_26":88,"_73":110,"_75":21,"_76":86},{"_54":90,"_79":86},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete","rank",{"_118":119,"_120":-5},"changelogVersion","2026-10-01T08:00","release"]

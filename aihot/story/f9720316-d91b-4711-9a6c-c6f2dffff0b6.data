[{"_1":2,"_3":4},"root",{"_5":209},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","f9720316-d91b-4711-9a6c-c6f2dffff0b6","title","NVIDIA工程师Chris Alexiuk公开Nemotron使用教程及开源倡导","status","watching","reportCount",1,"sourceCount","firstReportAt","2026-11-05T16:00:05.000Z","latestAt","digest","NVIDIA高级产品研究工程师Chris Alexiuk于2026-11-06通过NVIDIA博客发布Nemotron使用教程，并在YouTube同步教学，倡导完全开源的AI模型生态。其核心结论为：Nemotron作为首个完全开源的NVIDIA生态大模型，通过公开部署流程和微调方法，推动开发者社区快速应用AI技术。该教程包含具体代码库链接和部署步骤，但未披露模型训练数据细节。Alexiuk强调开放源代码对智能民主化的必要性，称Nemotron是当前最佳实践案例。","digestUpdatedAt","2026-11-05T17:15:10.792Z","summary","excerpt","latest","Chris Alexiuk 推广开放源代码 AI 模型 Nemotron","latestReport",{"_183":184},"whyHot",{"_203":204,"_205":204,"_206":204,"_207":193,"_208":-5},"developments",[196],"officialReports",[194],"timeline",[182],"heat",[56,57,58,59,60,61,62,63,64,65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97],"related",[],"topics",[45,46,47],{"_48":54,"_50":55},{"_48":52,"_50":53},{"_48":49,"_50":51},"slug","opinions","name","大佬观点","open-source","开源生态","nvidia","NVIDIA 英伟达",{"_98":180,"_39":181,"_101":16},{"_98":178,"_39":179,"_101":16},{"_98":176,"_39":177,"_101":16},{"_98":174,"_39":175,"_101":16},{"_98":172,"_39":173,"_101":16},{"_98":170,"_39":171,"_101":16},{"_98":168,"_39":169,"_101":16},{"_98":166,"_39":167,"_101":16},{"_98":164,"_39":165,"_101":16},{"_98":162,"_39":163,"_101":16},{"_98":160,"_39":161,"_101":16},{"_98":158,"_39":159,"_101":16},{"_98":156,"_39":157,"_101":16},{"_98":154,"_39":155,"_101":16},{"_98":152,"_39":153,"_101":16},{"_98":150,"_39":151,"_101":16},{"_98":148,"_39":149,"_101":16},{"_98":146,"_39":147,"_101":16},{"_98":144,"_39":145,"_101":16},{"_98":142,"_39":143,"_101":16},{"_98":140,"_39":141,"_101":16},{"_98":138,"_39":139,"_101":16},{"_98":136
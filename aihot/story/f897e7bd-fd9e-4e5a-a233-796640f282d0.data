:01:09.000Z","The Decoder",{"_178":179,"_11":180,"_18":19,"_15":92,"_181":182},"factId","f9XW0naLQB7s","Meta acquires Conductor","representative",{"_162":163,"_11":28,"_25":164,"_165":183,"_167":19,"_168":169},{"_49":170,"_171":169},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_192":193,"_194":-5},"changelogVersion","2026-10-01T08:00","release"]

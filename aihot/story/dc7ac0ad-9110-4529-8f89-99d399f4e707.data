[{"_1":2,"_3":4},"root",{"_5":134},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":12,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43},"publicId","dc7ac0ad-9110-4529-8f89-99d399f4e707","title","Hugging Face发布开源机器人学习框架ToyBlocks","status","watching","reportCount",1,"sourceCount","firstReportAt","2026-11-06T14:00:48.000Z","latestAt","digest","Hugging Face于2026年11月6日发布开源机器人学习框架ToyBlocks，支持自动生成任务、长程规划验证及物理机器人迁移实验。该框架通过单GPU并行生成数百个计划，实现24倍实时性能，并已用于Molmo 2（高阶模型）和ManiFlow（低阶模型）的训练。设计要求包含：1.真实物理与外观；2.大规模任务与演示生成；3.结合推理与灵巧性的挑战；4.覆盖领域内广泛任务。","digestUpdatedAt","2026-11-07T12:53:45.068Z","summary","excerpt","latest","latestReport",{"_109":110},"whyHot",{"_128":16,"_129":130,"_131":130,"_132":116,"_133":-5},"developments",[121],"officialReports",[119],"timeline",[108],"heat",[55,56,57,58,59,60,61,62,63,64,65,66,67,68,69,70,71],"related",[],"topics",[44,45,46],{"_47":53,"_49":54},{"_47":51,"_49":52},{"_47":48,"_49":50},"slug","papers","name","论文研究","open-source","开源生态","hugging-face","Hugging Face",{"_72":106,"_38":107,"_75":16},{"_72":104,"_38":105,"_75":16},{"_72":102,"_38":103,"_75":16},{"_72":100,"_38":101,"_75":16},{"_72":98,"_38":99,"_75":16},{"_72":96,"_38":97,"_75":16},{"_72":94,"_38":95,"_75":16},{"_72":92,"_38":93,"_75":16},{"_72":90,"_38":91,"_75":16},{"_72":88,"_38":89,"_75":16},{"_72":86,"_38":87,"_75":16},{"_72":84,"_38":85,"_75":16},{"_72":82,"_38":83,"_75":16},{"_72":80,"_38":81,"_75":16},{"_72":78,"_38":79,"_75":16},{"_72":76,"_38":77,"_75":16},{"_72":73,"_38":74,"_75":16},"hour","2026-11-08T05:00:00.000Z",3.2,"participants","2026-11-08T04:00:00.000Z",3.3,"2026-11-08T03:00:00.000Z",3.4,"2026-11-08T02:00:00.000Z",3.5,"2026-11-08T01:00:00.000Z",3.6,"2026-11-08T00:00:00.000Z",3.7,"2026-11-07T23:00:00.000Z",3.9,"2026-11-07T22:00:00.000Z",4,"2026-11-07T21:00:00.000Z",4.1,"2026-11-07T20:00:00.000Z",4.2,"2026-11-07T19:00:00.000Z",4.3,"2026-11-07T
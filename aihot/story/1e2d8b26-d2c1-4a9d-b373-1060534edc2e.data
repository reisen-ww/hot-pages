[{"_1":2,"_3":4},"root",{"_5":131},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","1e2d8b26-d2c1-4a9d-b373-1060534edc2e","title","Meta发布协作空间Spaces并与OpenAI、SpaceXAI竞合","status","watching","reportCount",1,"sourceCount","firstReportAt","2026-11-06T18:44:20.000Z","latestAt","digest","Meta于2026年11月7日发布协作空间Muse Agents Spaces，支持用户通过自然语言指令创建BBQ游戏、婚礼策划等定制化工作区，并自动同步音乐会票价、库存等第三方应用数据。目前该功能在美国和加拿大市场拥有10万用户，与OpenAI的dots和SpaceXAI的Grokbot形成竞争。TechCrunch报道指出，Spaces通过整合多应用数据提升效率，但尚未公布具体收费模式或全球推广计划。\n\n该产品由Meta的Muse Agents团队开发，其技术基础与OpenAI的dots存在功能重叠，但未披露与SpaceXAI Grokbot的具体差异。用户需在Meta账号体系内操作，目前仅限英语指令支持。","digestUpdatedAt","2026-11-07T13:11:20.541Z","summary","excerpt","latest","Meta发布Muse Agents协作空间Spaces","latestReport",{"_107":108},"whyHot",{"_124":16,"_125":126,"_127":126,"_128":129,"_130":-5},"developments",[117],"officialReports",[],"timeline",[106],"heat",[56,57,58,59,60,61,62,63,64,65,66,67,68,69,70,71],"related",[],"topics",[45,46,47],{"_48":54,"_50":55},{"_48":52,"_50":53},{"_48":49,"_50":51},"slug","product-updates","name","产品更新","mcp","MCP 与工具调用","meta","Meta / Llama",{"_72":104,"_39":105,"_75":16},{"_72":102,"_39":103,"_75":16},{"_72":100,"_39":101,"_75":16},{"_72":98,"_39":99,"_75":16},{"_72":96,"_39":97,"_75":16},{"_72":94,"_39":95,"_75":16},{"_72":92,"_39":93,"_75":16},{"_72":90,"_39":91,"_75":16},{"_72":88,"_39":89,"_75":16},{"_72":86,"_39":87,"_75":16},{"_72":84,"_39":85,"_75":16},{"_72":82,"_39":83,"_75":16},{"_72":80,"_39":81,"_75":16},{"_72":78,"_39":79,"_75":16},{"_72":76,"_39":77,"_75":16},{"_72":73,"_39":74,"_75":16},"hour","2026-11-08T05:00:00.000Z",3.7,"participants","2026-11-08T04:00:00.000Z",3.8,"2026-11-08T03:00:00.000Z",3.9,"2026-11-08T02:00:00.000Z",4.1,"2026-11-08T01:00:00.000Z",4.2,"2026-11-08T00:00:00.000Z",4.3,"2026-11-07T23:00:00.000Z",4.4,"2026-11-07T22:00:00
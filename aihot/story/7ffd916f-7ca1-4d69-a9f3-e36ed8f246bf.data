[{"_1":2,"_3":4},"root",{"_5":91},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","7ffd916f-7ca1-4d69-a9f3-e36ed8f246bf","title","Datasette停止向Firefox发送HTML分页link: rel=next头","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-07T23:57:46.000Z","latestAt","digest","Simon Willison于2026-11-08发布Datasette #3046建议，明确要求停止向Firefox浏览器发送link: rel=next HTTP头。此举旨在解决Firefox因预加载分页内容导致的重复数据请求和服务器负载问题。该行为已持续24年，早于2002年已有技术社区反对类似预加载机制（来源：Simon Willison 2026-11-08）。目前Datasette已按建议调整默认配置，开发者需手动启用分页功能。","digestUpdatedAt","2026-11-08T00:23:17.901Z","summary","excerpt","latest","Datasette #3046: 不向 Firefox 提供 link: rel=next HTTP 头","latestReport",{"_68":69},"whyHot",{"_85":16,"_86":16,"_87":16,"_88":89,"_90":-5},"developments",[78],"officialReports",[],"timeline",[67],"heat",[50,51,52,53,54],"related",[],"topics",[45],{"_46":47,"_48":49},"slug","coding","name","AI 编码",{"_55":65,"_39":66,"_58":16},{"_55":63,"_39":64,"_58":16},{"_55":61,"_39":62,"_58":16},{"_55":59,"_39":60,"_58":16},{"_55":56,"_39":57,"_58":16},"hour","2026-11-08T05:00:00.000Z",8.6,"participants","2026-11-08T04:00:00.000Z",8.9,"2026-11-08T03:00:00.000Z",9.2,"2026-11-08T02:00:00.000Z",9.4,"2026-11-08T01:00:00.000Z",9.7,{"_68":69,"_11":28,"_25":70,"_71":72,"_73":19,"_74":75},"id","h4mrga52zorqwbylfftxpk5kz","Datasette 页面会发送 link: rel=\"next\" HTTP 头，导致 Firefox 预取下一页数据，造成不必要的数据请求和服务器负担。这一行为已存在 24 年，甚至早在 2002 年就有博主提出反对。","source",{"_48":76,"_77":75},"publishedAt","selected",false,"Simon Willison","firstParty",{"_79":80,"_11":81,"_18":19,"_15":16,"_82":83},"factId","fhTBuT1FTRK0","Don't serve link: rel=next HTTP headers to Firefox for HTML ","representative",{"_68":69,"_11":28,"_25":70,"_71":84,"_73":19,"_74":75},{"_48":76,"_77":75},"participants48h","newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_92":93,"_94":-5},"changelogVersion","2026-10-01T08:00","release"]

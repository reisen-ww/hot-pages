[{"_1":2,"_3":4},"root",{"_5":81},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","00b7c82d-2159-405e-9dff-95219b39976f","title","Gemini新增直接生成编辑Google Docs等文件功能","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-29T18:45:31.000Z","latestAt","digest","Gemini于2026年10月30日宣布支持直接生成、预览和全屏编辑Google Docs、PDF、Markdown等文件格式，用户可通过高亮提问触发表格转图表等操作，不再需要通过Google Workspace集成实现类似功能。移动端仅支持PDF的预览和编辑。此前Gemini的文档处理功能需依赖第三方平台或API调用。","digestUpdatedAt","2026-10-29T18:59:39.064Z","summary","excerpt","latest","Gemini 新增直接生成编辑 Google Docs 等文件功能","latestReport",{"_57":58},"whyHot",{"_75":76,"_77":76,"_78":76,"_79":64,"_80":-5},"developments",[68],"officialReports",[],"timeline",[56],"heat",[],"related",[],"topics",[45,46,47],{"_48":54,"_50":55},{"_48":52,"_50":53},{"_48":49,"_50":51},"slug","product-updates","name","产品更新","coding","AI 编码","google","Google / Gemini",{"_57":58,"_11":28,"_25":59,"_60":61,"_62":19,"_63":64},"id","jpgapkn310uwu15hwd0xqbxfz","Gemini 现支持直接生成、预览和编辑 Google Docs、PDF、Markdown 等文件格式，可全屏编辑并高亮提问触发修改（如将表格转为图表）。移动端仅支持 PDF 预览/编辑，此前需通过 Google Workspace 集成实现类似功能。","source",{"_50":65,"_66":67},"publishedAt","selected",true,"The Verge · AI","firstParty",false,{"_69":70,"_11":71,"_18":19,"_15":16,"_72":73},"factId","fKvgott6Cfk4","生成和编辑Google Docs文件现在可以直接在Gemini聊天中进行","representative",{"_57":58,"_11":28,"_25":59,"_60":74,"_62":19,"_63":64},{"_50":65,"_66":67},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete","rank",{"_82":83,"_84":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":134},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":21,"_22":23,"_24":25,"_26":-5,"_27":-5,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45},"publicId","5d42ff1c-75b1-4e0d-b8a9-0122e1a5a03e","title","Reflection AI 发布开源权重模型 Beam，已上架 Hugging Face 与 AWS","status","settled","reportCount",5,"sourceCount","firstReportAt","2026-10-05T19:33:53.000Z","latestAt","2026-10-16T15:23:10.000Z","digest","Reflection AI 已将其首个前沿开源权重模型 Beam 上架 Hugging Face，以 Apache 2.0 许可证开放。Beam 是文本 MoE 模型，总参数 501B、激活参数 23B，预训练使用 23.8 万亿 token，上下文窗口 100 万 token；公司称推理算力用量比对手少 3-4 倍，面向编码、逻辑推理和智能体任务，但性能数据尚未经独立验证。\n\n模型提供 BF16、FP8、NVFP4 三种格式，支持 transformers、vLLM、SGLang 推理及 SFT 和 RL 后训练方案，并附带 $10,000 Hub credits 项目竞赛。目前通过 Hugging Face Inference Providers 分发，由 Baseten、Fireworks 和 Together 提供算力支持。\n\n据 AWS 官方博客，Beam 现已在 Amazon SageMaker JumpStart 上线，首发区域为 US East (N. Virginia) 和 US East (Ohio)，部署需具备相应 AWS 账户权限及 GPU 配额。","digestUpdatedAt","2026-10-16T23:57:55.363Z","summary","excerpt","latest","Reflection AI 发布开放权重模型 Beam，面向 AWS 上的智能体编码","latestReport",{"_71":101},"whyHot",{"_128":129,"_130":129,"_131":129,"_132":87,"_133":-5},"developments",[109,110,111],"officialReports",[105,106],"timeline",[66,67,68,69,70],"heat",[],"related",[],"topics",[46,47,48,49,50,51],{"_52":64,"_54":65},{"_52":62,"_54":63},{"_52":60,"_54":61},{"_52":58,"_54":59},{"_52":56,"_54":57},{"_52":53,"_54":55},"slug","engineering","name","部署工程","model-releases","模型发布","reasoning","推理能力","agent","Agent 智能体","open-source","开源生态","coding","AI 编码",{"_71":101,"_11":29,"_26":102,"_75":103,"_77":21,"_78":87},{"_71":95,"_11":96,"_26":97,"_75":98,"_77":99,"_78":87},{"_71":89,"_11":90,"_26":91,"_75":92,"_77":93,"_78":79},{"_71":82,"_11":83,"_26":84,"_75":85,"_77":86,"_78":87},{"_71":72,"_11":73,"_26":74,"_75":76,"_77":19,"_78":79},"id","i27khu2k8hcg5zdsia20fqz5i","Reflection 发布开源权重模型 Beam，称以更低算力对标中国开源模型","Reflection AI 正式发布其首个前沿开源权重模型 Beam，称在高级推理基准上以远低于对手的成本达到领先中国开源模型的水平。Beam 是文本 MoE 模型，总参数 501B、激活参数 23B，预训练使用 23.8 万亿 token，上下文窗口 100 万 token；公司称其推理算力用量比对手少 3-4 倍，但性能数据尚未经独立验证。","source",{"_54":80,"_81":79},"publishedAt","selected",false,"TechCrunch · AI","firstParty","vsgl3z1aieqcy1cwhr49i1415","Reflection 发布 Beam：501B-A23B 美国开源模型","Reflection 发布 Beam，一个面向编码、智能体与科研的纯文本 MoE 模型，总参数 501B、激活 23B，从零训练，完整权重将以 Apache 2.0 在本月放出。",{"_54":88,"_81":79},"2026-10-06T06:28:43.000Z",true,"Latent Space","xbza7dswbhsn4zzxu7ct7hnf0","Reflection 发布首个开源权重模型 Beam，主打低算力对标 DeepSeek 与千问","AI 公司 Reflection 发布首个免费开放模型 Beam，面向编码、逻辑推理和智能体任务，采用 MoE 架构，每 token 激活 5010 亿总参数中的 230 亿。",{"_54":94,"_81":79},"2026-10-06T12:11:22.000Z","The Decoder","b0twggzbsffs4rtjlc67dnb8b","Reflection 发布 501B 开源模型 Beam，支持自有硬件部署与定制","Reflection 发布 501B 开源模型 Beam，采用 MoE 架构，每 token 激活 23B 参数，支持 1M 上下文，以 Apache 2.0 许可证开放。模型提供 BF16、FP8、NVFP4 三种格式，支持 transformers、vLLM、SGLang 推理及 SFT 和 RL 后训练方案，并附带 $10,000 Hub credits 项目竞赛。",{"_54":100,"_81":87},"2026-10-16T00:00:00.000Z","Hugging Face Blog","x3r3xtn1tpjv5k2mg87elz4xr","Reflection AI 发布开放权重稀疏 MoE 模型 Beam，总参数 501B、活跃参数 23B，支持 1M token 上下文，面向智能体编码与多步骤任务。",{"_54":104,"_81":87},"AWS Machine Learning Blog",{"_71":101,"_11":29,"_26":102,"_75":108,"_77":21,"_78":87},{"_71":95,"_11":96,"_26":97,"_75":107,"_77":99,"_78":87},{"_54":100,"_81":87},{"_54":104,"_81":87},{"_112":124,"_11":125,"_18":21,"_15":121,"_116":126},{"_112":119,"_11":120,"_18":99,"_15":121,"_116":122},{"_112":113,"_11":114,"_18":19,"_15":115,"_116":117},"factId","fIwufPJ3CDw8","Reflection AI 发布开源权重模型 Beam",2,"representative",{"_71":72,"_11":73,"_26":74,"_75":118,"_77":19,"_78":79},{"_54":80,"_81":79},"fW8MHaL5gEe0","Reflection发布501B开源MoE模型Beam",1,{"_71":95,"_11":96,"_26":97,"_75":123,"_77":99,"_78":87},{"_54":100,"_81":87},"fu03twDN3YVE","在AWS上部署Reflection Beam模型",{"_71":101,"_11":29,"_26":102,"_75":127,"_77":21,"_78":87},{"_54":104,"_81":87},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete","rank",{"_135":136,"_137":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":256},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":21,"_22":23,"_24":25,"_26":-5,"_27":-5,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45},"publicId","7d047d2b-9ef7-4c37-8e08-69527b2e94a8","title","Google Research提出无校准智能手表AI筛查高血压，初步数据引发争议","status","active","reportCount",2,"sourceCount","firstReportAt","2026-11-05T16:01:08.000Z","latestAt","2026-11-07T09:54:09.000Z","digest","Google Research提出基于智能手表PPG和加速度计数据的无校准AI高血压筛查系统，称其初始筛查敏感性65.8%、特异性90.0%，确认性测试敏感性78.4%、特异性90.9%，优于传统诊所测量（78.2%敏感/89.5%特异）和居家监测（89.2%敏感/81.8%特异）。\n\n新旧报道存在数据差异：旧报道（2026-11-06）显示确认性测试敏感性78.4%，而新报道（2026-11-07）称系统与诊所测量相比仅65.8%敏感，但未明确对比基准。新报道补充该技术已整合至Google Health应用，但强调不替代专业诊断，研究基于近50万小时传感器数据和196人样本（含48例确认性测试），且样本排除了已知心血管疾病患者和药物干预群体。\n\n核心争议在于系统实际性能：旧报道强调多模态数据（PPG+加速度计）在确认性测试中的优势，而新报道仅对比单一模态（加速度计）与诊所测量的差异，未说明数据来源一致性。研究方均承认属于早期可行性测试，未涉及长期跟踪或药物干预验证。","digestUpdatedAt","2026-11-07T15:50:45.908Z","summary","excerpt","latest","Google Research AI 通过普通智能手表无袖带检测高血压","latestReport",{"_220":232},"whyHot",{"_250":119,"_251":252,"_253":119,"_254":231,"_255":-5},"developments",[238,239],"officialReports",[236],"timeline",[218,219],"heat",[60,61,62,63,64,65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114],"related",[],"topics",[46,47,48,49],{"_50":58,"_52":59},{"_50":56,"_52":57},{"_50":54,"_52":55},{"_50":51,"_52":53},"slug","multimodal","name","多模态","reasoning","推理能力","coding","AI 编码","papers","论文研究",{"_115":216,"_40":217,"_118":119},{"_115":214,"_40":215,"_118":119},{"_115":212,"_40":213,"_118":119},{"_115":210,"_40":211,"_118":119},{"_115":208,"_40":209,"_118":119},{"_115":206,"_40":207,"_118":119},{"_115":205,"_40":141,"_118":119},{"_115":204,"_40":139,"_118":119},{"_115":203,"_40":137,"_118":119},{"_115":202,"_40":135,"_118":119},{"_115":201,"_40":131,"_118":119},{"_115":200
2026-11-05T09:00:00.000Z",14.7,"2026-11-05T08:00:00.000Z",15.1,"2026-11-05T05:00:00.000Z",16.4,"2026-11-05T04:00:00.000Z",16.9,"2026-11-05T03:00:00.000Z",17.4,"2026-11-05T02:00:00.000Z",17.9,"2026-11-04T17:00:00.000Z",23.3,"2026-11-04T16:00:00.000Z",23.9,"2026-11-04T15:00:00.000Z",24.6,"2026-11-04T13:00:00.000Z",26.1,"2026-11-04T12:00:00.000Z",26.9,"2026-11-04T11:00:00.000Z",27.7,"2026-11-04T09:00:00.000Z",19,"2026-11-04T08:00:00.000Z",19.5,"2026-11-04T07:00:00.000Z",20.1,"2026-11-04T06:00:00.000Z",20.7,"2026-11-04T05:00:00.000Z",21.3,"2026-11-04T03:00:00.000Z",22.6,"2026-11-04T02:00:00.000Z",23.2,"2026-11-04T01:00:00.000Z","2026-11-04T00:00:00.000Z","2026-11-03T23:00:00.000Z",25.3,"2026-11-03T22:00:00.000Z","2026-11-03T21:00:00.000Z",26.8,"2026-11-03T20:00:00.000Z",27.6,"2026-11-03T19:00:00.000Z",28.4,"2026-11-03T18:00:00.000Z",29.3,"2026-11-03T17:00:00.000Z",9.9,{"_298":333,"_11":30,"_27":334,"_302":335,"_304":22,"_305":309},{"_298":328,"_11":329,"_27":330,"_302":331,"_304":332,"_305":306},{"_298":322,"_11":323,"_27":324,"_302":325,"_304":326,"_305":306},{"_298":316,"_11":317,"_27":318,"_302":319,"_304":320,"_305":309},{"_298":310,"_11":311,"_27":312,"_302":313,"_304":314,"_305":306},{"_298":299,"_11":300,"_27":301,"_302":303,"_304":20,"_305":306},"id","r5d6bj339sjvcyyuju0tffwue","Google允许学校禁用AI工具，但需牺牲搜索服务","Google宣布明年将默认禁用K-12学生的AI工具，除非学校管理员主动启用。该调整涉及Gemini、NotebookLM等AI产品与Google Search的深度整合，学校若全面禁用AI将无法使用搜索服务。此次变化同步推出面向学校的Guided Learning工具，旨在通过链式推理等机制提升学习深度而非直接提供答案。","source",{"_50":307,"_308":309},"publishedAt","selected",true,"TechCrunch · AI","firstParty",false,"lwosxo0dvvwuqu3dqjptj4mj7","Google关闭学校搜索功能，除非管理员启用AI工具","Google关闭K-12学校搜索功能，除非管理员启用AI工具。公司称搜索与AI深度整合，禁用AI则无法使用搜索。此前Google默认在教室应用中启用Gemini AI助手，已覆盖15亿师生。此举引发对AI工具影响学生自主学习能力的争议，上月已有议员质疑其潜在危害。Google正测试将学习引导功能嵌入搜索AI界面，计划本月在部分美国学校试运行。",{"_50":315,"_308":309},"2026-11-03T17:00:04.000Z","The Verge · AI","uu7suf9rmal7c20bydvsmjx31","Google允许学校禁用AI工具但必须放弃搜索服务","Google宣布教育产品禁用AI工具将导致同时禁用搜索引擎，学校需权衡两者对教学场景的影响。Google将AI整合视为未来方向。",{"_50":321,"_308":309},"2026-11-03T17:54:43.000Z","Ars Technica · AI","x7jen9exi0t6qgecfipcs3a12","Google将自2027年起对学校AI使用政策进行调整","Google宣布2027年起学校若禁用AI将无法使用搜索服务。Gemini相关服务（包括搜索和笔记）默认关闭，但学校可单独启用。目前纽约时报率先报道，纽约和洛杉矶学区已尝试禁用AI但被阻止。Google称搜索与AI已深度绑定无法分离，教育机构需在启用AI功能或失去搜索服务之间二选一。",{"_50":327,"_308":309},"2026-11-04T10:06:23.000Z","The Decoder","spaebe1ydueli825allj5yzkk","Google因教育工具AI政策遭多国政要批评","Google宣布若学校禁用AI工具则停用搜索服务，引发多国政要批评垄断行为。议员Bernie Sanders指责这是AI勒索，前FTC主席Lina Khan批评其违反反垄断法，Google回应称已默认关闭AI功能并提供可控选项。",{"_50":307,"_308":309},"2026-11-04T16:17:22.000Z","vrb6u4uu576fdj192d5mcijua","Google发布教育AI新政策，允许学校自主选择是否启用搜索功能。根据政策，使用Google教育应用必须启用AI产品（如Gemini），但搜索功能可单独关闭。此前纽约时报报道存在误解，Google通过博客澄清实际操作机制。",{"_50":321,"_308":309},{"_341":358,"_11":359,"_19":22,"_15":139,"_343":360},{"_341":354,"_11":355,"_19":326,"_15":139,"_343":356},{"_341":350,"_11":351,"_19":320,"_15":139,"_343":352},{"_341":346,"_11":347,"_19":314,"_15":139,"_343":348},{"_341":342,"_11":300,"_19":20,"_15":139,"_343":344},"factId","fXienaSNB0gc","representative",{"_298":299,"_11":300,"_27":301,"_302":345,"_304":20,"_305":306},{"_50":307,"_308":309},"fpgmyg0HNQt0","Google is completely turning off Search in schools that reje",{"_298":310,"_11":311,"_27":312,"_302":349,"_304":314,"_305":306},{"_50":315,"_308":309},"fC_b5cYI-RJI","Google将允许学校选择是否使用AI工具，但需放弃搜索功能",{"_298":316,"_11":317,"_27":318,"_302":353,"_304":320,"_305":309},{"_50":321,"_308":309},"fru8FTfAH-1A","Google将从2027年起要求学校接受AI以保留搜索访问权限",{"_298":322,"_11":323,"_27":324,"_302":357,"_304":326,"_305":306},{"_50":327,"_308":309},"fYCdX-q2xuBs","Google澄清其新的教育AI政策",{"_298":333,"_11":30,"_27":334,"_302":361,"_304":22,"_305":309},{"_50":321,"_308":309},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete","rank",{"_369":370,"_371":-5},"changelogVersion","2026-10-01T08:00","release"]

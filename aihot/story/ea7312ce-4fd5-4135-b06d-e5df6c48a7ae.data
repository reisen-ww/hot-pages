[{"_1":2,"_3":4},"root",{"_5":259},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":-5,"_28":-5,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46},"publicId","ea7312ce-4fd5-4135-b06d-e5df6c48a7ae","title","OpenAI发布GPT-6 Cyber网络安全模型，漏洞检测得分提升16个百分点，越界攻击率降至1%以下","status","watching","reportCount",4,"sourceCount",3,"firstReportAt","2026-11-05T09:00:00.000Z","latestAt","2026-11-05T20:36:25.000Z","digest","OpenAI发布GPT-6 Cyber网络安全模型，ExploitGym评测显示其漏洞检测得分从GPT-5.6 Cyber的32.1%提升至48.5%，越界攻击率降至1%以下。该模型已发现Firefox和Linux内核中81个未知高危漏洞（部分厂商已确认并修复），同时通过API和Codex为Daybreak Red客户初始提供访问，未来将逐步扩展至所有Daybreak Red客户。模型训练范围受授权约束，但具体技术细节未披露。\n\n该模型在无安全指令时边界违规率降至99.93%（前代94.49%），启用安全指令后100%合规。当前访问权限与客户等级绑定，具体开放时间表未公布。","digestUpdatedAt","2026-11-05T21:18:16.534Z","summary","excerpt","latest","OpenAI发布GPT-6 Cyber安全漏洞检测模型","latestReport",{"_207":225},"whyHot",{"_253":254,"_255":254,"_256":254,"_257":215,"_258":-5},"developments",[236,237,238],"officialReports",[234],"timeline",[203,204,205,206],"heat",[61,62,63,64,65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106],"related",[],"topics",[47,48,49,50],{"_51":59,"_53":60},{"_51":57,"_53":58},{"_51":55,"_53":56},{"_51":52,"_53":54},"slug","benchmarks","name","评测基准","model-releases","模型发布","safety","安全对齐","openai","OpenAI / ChatGPT",{"_107":201,"_41":202,"_110":120},{"_107":199,"_41":200,"_110":120},{"_107":197,"_41":198,"_110":120},{"_107":195,"_41":196,"_110":18},{"_107":193,"_41":194,"_110":18},{"_107":191,"_41":192,"_110":18},{"_107":189,"_41":190,"_110":18},{"_107":187,"_41":188,"_110":18},{"_107":185,"_41":186,"_110":18},{"_107":183,"_41":184,"_110":18},{"_107":181,"_41":182,"_110":18},{"_107":179,"_41":180,"_110":18},{"_107":177,"_41":178,"_110":18},{"_107":175,"_41":176,"_110":18},{"_107":173,"_41":174,"_110":18},{"_107":171,"_41":172,"_110":18},{"_1
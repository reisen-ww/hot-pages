hwfr5","Uber第三季度财报显示万圣节周期间仅4次乘车通过AI智能体完成，外卖场景500单也远低于整体量（320M次）。CEO Khosrowshahi承认当前使用率有限，但认为智能体将提升平台需求。同期的DoorDash财报也显示AI订单不足数百单，折射出用户仍倾向传统应用操作。",{"_49":183,"_178":179},"TechCrunch · AI",{"_186":192,"_11":193,"_18":21,"_15":93,"_189":194},{"_186":187,"_11":188,"_18":19,"_15":93,"_189":190},"factId","fL53KgBvxZVI","Uber only fulfilled 4 rides from AI agents last quarter","representative",{"_168":169,"_11":170,"_26":171,"_172":191,"_174":19,"_175":176},{"_49":177,"_178":179},"fTN_cHpduIZk","Uber CEO表示AI代理预订Uber的使用率很低",{"_168":180,"_11":29,"_26":181,"_172":195,"_174":21,"_175":179},{"_49":183,"_178":179},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete","rank",{"_203":204,"_205":-5},"changelogVersion","2026-10-01T08:00","release"]

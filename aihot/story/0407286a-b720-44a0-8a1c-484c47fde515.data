[{"_1":2,"_3":4},"root",{"_5":207},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","0407286a-b720-44a0-8a1c-484c47fde515","title","Box集成Nvidia Nemotron推出企业级内容检索系统","status","watching","reportCount",1,"sourceCount","firstReportAt","2026-11-05T14:00:00.000Z","latestAt","digest","Box在开发者大会上宣布推出基于Nvidia Nemotron Embed项目的全新内容检索系统，预计将查询速度提升四倍，减少20%的错误率和90%的token使用量，目前该系统仅向Enterprise Advance客户开放，计划于明年早期逐步部署。\n\n该系统整合了Nvidia的开放权重嵌入模型，以提升自动化检索效率，并依赖现有元数据与权限控制框架。Nvidia VP Kari Briski在TechCrunch采访中强调，新系统将显著优化企业级应用（如法律条款检索）的实时响应能力。","digestUpdatedAt","2026-11-05T14:26:12.331Z","summary","excerpt","latest","Box发布基于Nvidia Nemotron的新内容检索系统","latestReport",{"_183":184},"whyHot",{"_201":202,"_203":202,"_204":202,"_205":190,"_206":-5},"developments",[194],"officialReports",[],"timeline",[182],"heat",[56,57,58,59,60,61,62,63,64,65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97],"related",[],"topics",[45,46,47],{"_48":54,"_50":55},{"_48":52,"_50":53},{"_48":49,"_50":51},"slug","trends","name","现象与趋势","product-updates","产品更新","open-source","开源生态",{"_98":180,"_39":181,"_101":16},{"_98":178,"_39":179,"_101":16},{"_98":176,"_39":177,"_101":16},{"_98":174,"_39":175,"_101":16},{"_98":172,"_39":173,"_101":16},{"_98":170,"_39":171,"_101":16},{"_98":168,"_39":169,"_101":16},{"_98":166,"_39":167,"_101":16},{"_98":164,"_39":165,"_101":16},{"_98":162,"_39":163,"_101":16},{"_98":160,"_39":161,"_101":16},{"_98":158,"_39":159,"_101":16},{"_98":156,"_39":157,"_101":16},{"_98":154,"_39":155,"_101":16},{"_98":152,"_39":153,"_101":16},{"_98":150,"_39":151,"_101":16},{"_98":148,"_39":149,"_101":16},{"_98":146,"_39":147,"_101":16},{"_98":144,"_39":145,"_101":16},{"_98":142,"_39":143,"_101":16},{"_98":140,"_39":141,"_101":16},{"_98":138,"_39":139,"_101":16},{"_98":136,"_
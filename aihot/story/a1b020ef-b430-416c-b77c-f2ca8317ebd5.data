13.4,"2026-11-06T07:00:00.000Z",13.8,"2026-11-06T06:00:00.000Z",14.2,"2026-11-06T05:00:00.000Z",14.6,"2026-11-06T03:00:00.000Z",15.5,"2026-11-06T02:00:00.000Z",15.9,"2026-11-06T01:00:00.000Z",16.4,"2026-11-06T00:00:00.000Z",16.9,"2026-11-05T23:00:00.000Z",17.4,"2026-11-05T22:00:00.000Z",17.9,"2026-11-05T21:00:00.000Z",18.4,"2026-11-05T20:00:00.000Z",18.9,"2026-11-05T19:00:00.000Z","2026-11-05T18:00:00.000Z",{"_204":215,"_11":29,"_26":216,"_208":217,"_210":21,"_211":212},{"_204":205,"_11":206,"_26":207,"_208":209,"_210":19,"_211":212},"id","ocnntc4b03t3u6b4tup8wfu6p","Google DeepMind发布Gemini Omni 1.2 Flash：原生15秒视频生成与多轮对话编辑能力升级","Google DeepMind发布Gemini Omni 1.2 Flash，原生支持15秒视频生成，并提升多轮对话编辑的一致性及成本效益。价格从1.1版降低30%至$0.07/秒，支持3-15秒精确时长设定，可生成完整产品说明视频或社交媒体广告片段。","source",{"_54":213,"_214":212},"publishedAt","selected",true,"Google DeepMind","firstParty","ojhlctg9v0tsfgt1iy1mca0ft","Google 发布 Gemini Omni 1.2 Flash 视频生成模型，支持15秒长视频、30%价格下调及对话式编辑功能。该模型通过逐步调整背景、光照和画面比例实现局部编辑，支持从360p/720p到1080p/4K的阶梯式处理，并承诺更稳定的视觉一致性。输入可包含人物照片、产品图、3秒动态片段及音频提示，输出视频能保持服装剪裁、品牌标识等细节跨镜头一致性。",{"_54":218,"_214":219},"The Decoder",false,{"_204":205,"_11":206,"_26":207,"_208":221,"_210":19,"_211":212},{"_54":213,"_214":212},{"_224":230,"_11":231,"_18":21,"_15":115,"_227":232},{"_224":225,"_11":226,"_18":19,"_15":115,"_227":228},"factId","fn_uWouXzLjE","推出 Gemini Omni 1.2 Flash","representative",{"_204":205,"_11":206,"_26":207,"_208":229,"_210":19,"_211":212},{"_54":213,"_214":212},"fe-OIxj7KiUU","推出更新后的视频生成模型",{"_204":215,"_11":29,"_26":216,"_208":233,"_210":21,"_211":212},{"_54":218,"_214":219},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete","rank",{"_241":242,"_243":-5},"changelogVersion","2026-10-01T08:00","release"]

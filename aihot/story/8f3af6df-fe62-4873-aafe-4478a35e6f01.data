[{"_1":2,"_3":4},"root",{"_5":150},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":-5,"_28":-5,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46},"publicId","8f3af6df-fe62-4873-aafe-4478a35e6f01","title","AWS与Okta合作优化AI代理访问管理机制，引入延迟与令牌失效机制","status","watching","reportCount",2,"sourceCount",1,"firstReportAt","2026-11-06T17:09:18.000Z","latestAt","2026-11-06T17:09:23.000Z","digest","AWS于2026年11月7日通过博客披露，其AI代理系统通过集成Okta Cross App Access（XAA）和Amazon Bedrock AgentCore Identity组件，在身份验证环节引入0.6秒延迟，但能实现管理员移除用户关联后1秒内拒绝新请求，并强制令牌5分钟内失效。该方案基于Okta的跨应用身份验证框架，结合Bedrock AgentCore的身份模块，旨在平衡安全性与系统性能。测试数据显示，令牌失效机制虽提升了安全性，但可能对连续操作场景产生影响，具体适用范围未明确说明。\n\n通过单一入口点配置，每个智能体通过Amazon Bedrock AgentCore Gateway获取授权，避免在MCP服务器上重复配置授权逻辑（AWS博客，2026-11-07）。","digestUpdatedAt","2026-11-07T12:40:01.045Z","summary","excerpt","latest","使用 Okta Cross App Access 和 Amazon Bedrock AgentCore 实现智能体访问治理","latestReport",{"_113":125},"whyHot",{"_144":18,"_145":146,"_147":146,"_148":124,"_149":-5},"developments",[132,133],"officialReports",[128,129],"timeline",[111,112],"heat",[58,59,60,61,62,63,64,65,66,67,68,69,70,71,72,73,74],"related",[],"topics",[47,48,49],{"_50":56,"_52":57},{"_50":54,"_52":55},{"_50":51,"_52":53},"slug","tutorials","name","教程实践","agent","Agent 智能体","openai","OpenAI / ChatGPT",{"_75":109,"_41":110,"_78":18},{"_75":107,"_41":108,"_78":18},{"_75":105,"_41":106,"_78":18},{"_75":103,"_41":104,"_78":18},{"_75":101,"_41":102,"_78":18},{"_75":99,"_41":100,"_78":18},{"_75":97,"_41":98,"_78":18},{"_75":95,"_41":96,"_78":18},{"_75":93,"_41":94,"_78":18},{"_75":91,"_41":92,"_78":18},{"_75":89,"_41":90,"_78":18},{"_75":87,"_41":88,"_78":18},{"_75":85,"_41":86,"_78":18},{"_75":83,"_41":84,"_78":18},{"_75":81,"_41":82,"_78":18},{"_75":79,"_41":80,"_78":18},{"_75":76,"_41":77,"_78":18},"hour","2026-11-08T05:00:00.000Z",3.6,"participants","2026-11-08T04:00:00.000Z",3.7,"2026-11-08T03:00:00.000Z",3.8,"2026-11-08T02:00:00.000Z",3.9,"2026-11-08T01:00:00.000Z",4,"2026-11-08T00:00:00.000Z",4.1,"2026-11-07T23:00:00.000Z",4.2,"2026-11-07T22:00:00.000Z",4.3,"2026-11-07T21:00:00.000Z",4.5,"2026-11-07T20:00:00.000Z",4.6,"2026-11-07T19:00:00.000Z",4.7,"2026-11-07T18:00:00.000Z",4.9,"2026-11-07T17:00:00.000Z",5,"2026-11-07T16:00:00.000Z",5.2,"2026-11-07T15:00:00.000Z",5.3,"2026-11-07T14:00:00.000Z",5.5,"2026-11-07T13:00:00.000Z",5.6,{"_113":125,"_11":30,"_27":126,"_117":127,"_119":22,"_120":121},{"_113":114,"_11":115,"_27":116,"_117":118,"_119":20,"_120":121},"id","mdum5wufe27ngslq61k5ou424","使用 Okta Cross App Access 和 Amazon Bedrock AgentCore 管理 AI 代理访问","本文介绍了如何使用 Okta Cross App Access (XAA) 和 Amazon Bedrock AgentCore 构建和优化大规模 AI 代理。在测试中，AgentCore Identity 在请求中增加了约 0.6 秒的时间，而 Okta 的控制措施在管理员移除用户与代理的关联后，约 1 秒内拒绝了代理的新请求，且已颁发的令牌在 5 分钟内失效。","source",{"_52":122,"_123":124},"publishedAt","selected",false,"AWS Machine Learning Blog","firstParty",true,"rj5iccgvayjdpiovjwh4opgef","本文介绍了如何使用 Okta Cross App Access 和 Amazon Bedrock AgentCore 实现智能体访问治理。通过在 Amazon Bedrock AgentCore Gateway 中配置单一入口点，每个智能体通过 Gateway 获取授权，而无需在每个 MCP 服务器上重复配置授权逻辑。",{"_52":122,"_123":124},{"_113":125,"_11":30,"_27":126,"_117":131,"_119":22,"_120":121},{"_113":114,"_11":115,"_27":116,"_117":130,"_119":20,"_120":121},{"_52":122,"_123":124},{"_52":122,"_123":124},{"_134":140,"_11":141,"_19":22,"_15":18,"_137":142},{"_134":135,"_11":136,"_19":20,"_15":18,"_137":138},"factId","fq_lq8ArBv_k","注册代理并配置Okta Cross App Access和Amazon Bedrock AgentCore Identi","representative",{"_113":114,"_11":115,"_27":116,"_117":139,"_119":20,"_120":121},{"_52":122,"_123":124},"fqzAwka0OkYs","使用 Okta Cross App Access 和 Amazon Bedrock AgentCore 实现智能体访问治",{"_113":125,"_11":30,"_27":126,"_117":143,"_119":22,"_120":121},{"_52":122,"_123":124},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",{"_151":152,"_153":-5},"changelogVersion","2026-10-01T08:00","release"]

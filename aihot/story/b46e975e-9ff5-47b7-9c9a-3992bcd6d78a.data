[{"_1":2,"_3":4},"root",{"_5":212},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":21,"_22":23,"_24":25,"_26":-5,"_27":-5,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45},"publicId","b46e975e-9ff5-47b7-9c9a-3992bcd6d78a","title","OpenAI推出Images 2.6模型及GIF生成功能，开放API并提升生成量","status","settled","reportCount",3,"sourceCount","firstReportAt","2026-11-04T00:00:00.000Z","latestAt","2026-11-04T19:44:20.000Z","digest","OpenAI推出基于Images 2.6模型的GIF生成功能及Flare（高效）和Sunburst（高质量）API，生成速度提升40%，复杂场景准确率提高15%，用户周均生成量超40亿张（较9月增长1亿）。\n功能包括通过文本或上传照片生成GIF，支持调整动画速度、编辑单帧及分享。API模型适用于企业级应用，但客户端集成进展（如ChatGPT的GIF功能覆盖范围）尚未披露。\n目前仅开放API调用权限，客户端集成（如ChatGPT）的GIF功能已逐步上线，覆盖网页、桌面及移动端应用（据The Verge和The Decoder报道）。","digestUpdatedAt","2026-11-05T02:55:01.985Z","summary","excerpt","latest","OpenAI 发布支持文本与照片生成动画GIF的 Images 2.6 模型","latestReport",{"_165":183},"whyHot",{"_206":207,"_208":207,"_209":207,"_210":173,"_211":-5},"developments",[189,190,191],"officialReports",[187],"timeline",[162,163,164],"heat",[57,58,59,60,61,62,63,64,65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90],"related",[],"topics",[46,47,48],{"_49":55,"_51":56},{"_49":53,"_51":54},{"_49":50,"_51":52},"slug","image-gen","name","图像生成","product-updates","产品更新","openai","OpenAI / ChatGPT",{"_91":160,"_40":161,"_94":16},{"_91":158,"_40":159,"_94":16},{"_91":156,"_40":157,"_94":16},{"_91":154,"_40":155,"_94":16},{"_91":152,"_40":153,"_94":16},{"_91":150,"_40":151,"_94":16},{"_91":148,"_40":149,"_94":16},{"_91":146,"_40":147,"_94":16},{"_91":144,"_40":145,"_94":16},{"_91":142,"_40":143,"_94":16},{"_91":140,"_40":141,"_94":16},{"_91":138,"_40":139,"_94":16},{"_91":136,"_40":137,"_94":16},{"_91":134,"_40":135,"_94":16},{"_91":132,"_40":133,"_94":16},{"_91":130,"_40":131,"_94":16},{"_91":128,"_40":129,"_94":16},{"_91":126,"_40":127,"_94":16},{"_91":124,"_40":125,"_94":16},{"_91":122,"_40":123,"_94":99},{"_91":120,"_40":121,"_94":
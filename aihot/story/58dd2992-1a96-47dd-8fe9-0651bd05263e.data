[{"_1":2,"_3":4},"root",{"_5":87},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","58dd2992-1a96-47dd-8fe9-0651bd05263e","title","NVIDIA发布Kumo Relational关系型基础模型","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-21T18:26:30.000Z","latestAt","digest","NVIDIA发布预训练关系型基础模型Kumo Relational，用户连接数据库、用PQL描述预测目标，即可在单次前向传播中得到结果，无需任务训练、特征工程或表展平。该模型现已可用，代码以Apache 2.0许可开源，模型权重以OpenMDW License Agreement 1.1许可发布，首次使用时从Hugging Face Hub下载权重，可在GPU笔记本中直接加载预测；也可部署为NVIDIA NIM作为独立服务，由开源structured-data-models-client调用。","digestUpdatedAt","2026-10-22T01:46:51.500Z","summary","excerpt","latest","NVIDIA 发布 Kumo Relational 关系型数据基础模型，无需训练直接预测","latestReport",{"_63":64},"whyHot",{"_81":82,"_83":82,"_84":82,"_85":70,"_86":-5},"developments",[75],"officialReports",[73],"timeline",[62],"heat",[],"related",[],"topics",[45,46,47,48,49],{"_50":60,"_52":61},{"_50":58,"_52":59},{"_50":56,"_52":57},{"_50":54,"_52":55},{"_50":51,"_52":53},"slug","benchmarks","name","评测基准","model-releases","模型发布","data-training","数据与训练","open-source","开源生态","nvidia","NVIDIA 英伟达",{"_63":64,"_11":28,"_25":65,"_66":67,"_68":19,"_69":70},"id","jvmbvpin31pd9fkt8imrob0fn","NVIDIA 发布预训练关系型基础模型 Kumo Relational，连接数据库并用 PQL 描述预测目标即可在单次前向传播中给出结果，无需任务训练、特征工程或表展平。","source",{"_52":71,"_72":70},"publishedAt","selected",true,"Hugging Face Blog","firstParty",{"_63":64,"_11":28,"_25":65,"_66":74,"_68":19,"_69":70},{"_52":71,"_72":70},{"_76":77,"_11":12,"_18":19,"_15":16,"_78":79},"factId","fY8lSp8aKGtM","representative",{"_63":64,"_11":28,"_25":65,"_66":80,"_68":19,"_69":70},{"_52":71,"_72":70},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete","rank",{"_88":89,"_90":-5},"changelogVersion","2026-10-01T08:00","release"]

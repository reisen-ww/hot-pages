[{"_1":2,"_3":4},"root",{"_5":81},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","628309b4-4566-41f3-accf-ed5787fd750b","title","Apertus 1.5 发布：多模态与长上下文升级","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-15T09:08:45.000Z","latestAt","digest","Project Apertus 发布 Apertus 1.5，将 8B 和 70B 模型从纯文本扩展为支持图像和音频理解的多模态模型，新增可选推理模式，上下文窗口扩大 4 倍至 262,144 tokens，并改进指令遵循和工具使用能力。\n\n更新后的模型权重已于 2026 年 7 月 24 日以 Apache 2.0 许可证发布至 Hugging Face。模型还可处理语音输入，但该功能仍处于实验阶段。","digestUpdatedAt","2026-10-15T14:43:56.177Z","summary","excerpt","latest","Apertus 1.5 发布：8B 和 70B 模型新增多模态理解与推理模式","latestReport",{"_57":58},"whyHot",{"_75":76,"_77":76,"_78":76,"_79":64,"_80":-5},"developments",[69],"officialReports",[67],"timeline",[56],"heat",[],"related",[],"topics",[45,46,47],{"_48":54,"_50":55},{"_48":52,"_50":53},{"_48":49,"_50":51},"slug","model-releases","name","模型发布","multimodal","多模态","reasoning","推理能力",{"_57":58,"_11":28,"_25":59,"_60":61,"_62":19,"_63":64},"id","gq5u771ph8jwv52ub36y0pdja","Apertus 1.5 发布，将 8B 和 70B 模型从纯文本扩展为支持图像和音频理解的多模态模型，新增可选推理模式，上下文窗口扩大 4 倍至 262,144 tokens。","source",{"_50":65,"_66":64},"publishedAt","selected",true,"Hugging Face Blog","firstParty",{"_57":58,"_11":28,"_25":59,"_60":68,"_62":19,"_63":64},{"_50":65,"_66":64},{"_70":71,"_11":12,"_18":19,"_15":16,"_72":73},"factId","fSSx8Enr7EnI","representative",{"_57":58,"_11":28,"_25":59,"_60":74,"_62":19,"_63":64},{"_50":65,"_66":64},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete","rank",{"_82":83,"_84":-5},"changelogVersion","2026-10-01T08:00","release"]

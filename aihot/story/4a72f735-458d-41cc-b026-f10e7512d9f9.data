[{"_1":2,"_3":4},"root",{"_5":82},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","4a72f735-458d-41cc-b026-f10e7512d9f9","title","Google提出睡眠框架解决LLM持续学习遗忘问题","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-27T17:35:28.000Z","latestAt","digest","Google Research于2026年10月28日提出睡眠框架，通过参数扩展与混合专家架构（MoE）实现动态知识存储，结合知识蒸馏与模拟训练（dreaming）机制，在10M tokens长上下文场景下使LLM性能衰减接近零，数学推理准确率达79.2%，优于GPT-4等基线方法。该框架模拟人类睡眠记忆巩固机制，为LLM设计周期性休眠-学习循环，解决持续学习中的短期记忆不稳定问题。目前仅披露基准测试结果，未公布具体测试集名称或对比数据细节。","digestUpdatedAt","2026-10-27T17:42:21.247Z","summary","excerpt","latest","Google Research提出睡眠框架：LLM持续学习中的新型知识保留方法","latestReport",{"_57":58},"whyHot",{"_76":77,"_78":77,"_79":77,"_80":64,"_81":-5},"developments",[69],"officialReports",[67],"timeline",[56],"heat",[],"related",[],"topics",[45,46,47],{"_48":54,"_50":55},{"_48":52,"_50":53},{"_48":49,"_50":51},"slug","papers","name","论文研究","multimodal","多模态","reasoning","推理能力",{"_57":58,"_11":28,"_25":59,"_60":61,"_62":19,"_63":64},"id","bjoxdidgwpiyqmdsee4d1d3mb","Google Research提出睡眠框架解决LLM持续学习中的灾难性遗忘问题，在长文本理解与数学推理基准测试中表现优于GPT-4等基线方法。该框架通过参数扩展与混合专家架构（MoE）实现动态知识存储，结合知识蒸馏（GKD）与强化学习（RL）的模拟训练（dreaming）机制，在10M tokens长上下文场景下保持近零性能衰减，数学推理准确率达79.2%。","source",{"_50":65,"_66":64},"publishedAt","selected",true,"Google Research","firstParty",{"_57":58,"_11":28,"_25":59,"_60":68,"_62":19,"_63":64},{"_50":65,"_66":64},{"_70":71,"_11":72,"_18":19,"_15":16,"_73":74},"factId","fwR6Eo87_nNU","提出睡眠框架","representative",{"_57":58,"_11":28,"_25":59,"_60":75,"_62":19,"_63":64},{"_50":65,"_66":64},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete","rank",{"_83":84,"_85":-5},"changelogVersion","2026-10-01T08:00","release"]

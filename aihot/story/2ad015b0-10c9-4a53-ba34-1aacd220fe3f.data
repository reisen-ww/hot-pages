[{"_1":2,"_3":4},"root",{"_5":111},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":21,"_22":23,"_24":25,"_26":-5,"_27":-5,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45},"publicId","2ad015b0-10c9-4a53-ba34-1aacd220fe3f","title","Google 发布开源多模态嵌入模型 EmbeddingGemma 2","status","settled","reportCount",3,"sourceCount","firstReportAt","2026-10-06T19:47:27.000Z","latestAt","2026-10-06T20:37:53.000Z","digest","Google DeepMind 发布开源多模态嵌入模型 EmbeddingGemma 2，将文本、图像、视频、音频和代码映射到统一嵌入空间，参数量 7.4 亿，基于 Gemma 4 架构，采用可商用的 Apache 2.0 许可，权重已在 Hugging Face 和 Kaggle 提供，并称即将上线 Gemini Enterprise Agent Platform Model Garden。模型可在本地运行、无需 API 密钥。\n\nGoogle 称，EmbeddingGemma 2 在多模态嵌入基准上超越规模最多两倍的竞品，在 Massive Text Embedding Benchmark (Code) 上得分 78.68，较前代的 68.76 提升近 10 分。Google 还表示，仅处理文本任务时，2.7 亿参数版本已足够，视觉与音频编码器分别为 1.7 亿和 3 亿参数；量化后在 Google Pixel 11 Pro 上，纯文本权重约占 191MB 内存，完整多模态模型约占 567MB。\n\nSimon Willison 认为嵌入模型不应采用闭源、专有、仅托管的形式：嵌入应用通常需计算并存储数千甚至数百万个向量，供应商一旦停用模型，用户就得为重新计算付费；他更愿意付费使用托管版本，同时保留供应商停服后可自行运行开放权重版本的退路。","digestUpdatedAt","2026-10-06T23:10:27.896Z","summary","excerpt","latest","EmbeddingGemma 2 采用 Apache 2.0 许可证","latestReport",{"_69":87},"whyHot",{"_105":106,"_107":106,"_108":106,"_109":85,"_110":-5},"developments",[93,94],"officialReports",[91],"timeline",[66,67,68],"heat",[],"related",[],"topics",[46,47,48,49,50,51],{"_52":64,"_54":65},{"_52":62,"_54":63},{"_52":60,"_54":61},{"_52":58,"_54":59},{"_52":56,"_54":57},{"_52":53,"_54":55},"slug","opinions","name","大佬观点","model-releases","模型发布","open-source","开源生态","multimodal","多模态","google","Google / Gemini","on-device","端侧 AI",{"_69":87,"_11":29,"_26":88,"_73":89,"_75":21,"_76":77},{"_69":80,"_11":81,"_26":82,"_73":83,"_75":84,"_76":85},{"_69":70,"_11":71,"_26":72,"_73":74,"_75":19,"_76":77},"id","b6748riswosb2hhfv1h04ifo7","Google 发布 EmbeddingGemma 2，称性能超越两倍规模竞品","Google 发布开源模型 EmbeddingGemma 2，可将文本、图像、视频、音频和代码转换为数值向量，参数量 7.4 亿。Google 称其在多模态嵌入基准上超越规模最多两倍的竞品，在 Massive Text Embedding Benchmark (Code) 上得分 78.68，比前代 68.76 提升近 10 分。","source",{"_54":78,"_79":77},"publishedAt","selected",false,"The Decoder","firstParty","fbchdglhjzg2uqkco64dz4vu8","Google DeepMind 发布 EmbeddingGemma 2 开源轻量多模态嵌入模型","Google DeepMind 发布 EmbeddingGemma 2，这是面向端侧的多模态嵌入模型，原生将文本、图像、音频和视频映射到统一嵌入空间，基于 Gemma 4 架构、Apache 2.0 许可，参数量 740M。",{"_54":86,"_79":85},"2026-10-06T19:57:04.000Z",true,"Google DeepMind","mi6tk02d8mummn7bu2av2h0ak","EmbeddingGemma 2 采用 Apache 2.0 许可证，Simon Willison 认为嵌入模型不应使用闭源、专有、仅托管的形式。嵌入模型应用通常需计算并存储数千甚至数百万个嵌入向量，一旦供应商停用模型，用户就得为重新计算这些向量付费。他更愿意付费使用托管版本，同时保留供应商停服后可自行运行开放权重版本或另寻供应商的退路。",{"_54":90,"_79":77},"Simon Willison",{"_69":80,"_11":81,"_26":82,"_73":92,"_75":84,"_76":85},{"_54":86,"_79":85},{"_95":101,"_11":29,"_18":21,"_15":102,"_98":103},{"_95":96,"_11":12,"_18":19,"_15":97,"_98":99},"factId","fXnbYULMX2zg",2,"representative",{"_69":80,"_11":81,"_26":82,"_73":100,"_75":84,"_76":85},{"_54":86,"_79":85},"fo4bASrZcqkY",1,{"_69":87,"_11":29,"_26":88,"_73":104,"_75":21,"_76":77},{"_54":90,"_79":77},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete","rank",{"_112":113,"_114":-5},"changelogVersion","2026-10-01T08:00","release"]

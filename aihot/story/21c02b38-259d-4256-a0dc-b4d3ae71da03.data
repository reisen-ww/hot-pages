，实测吞吐量提升达30倍。关键技术包括：1）采用NVFP4格式将模型权重压缩至4位精度，2）NVL72系统支持72GPU分布式加载模型，3）CMX存储层将闲置上下文迁移至低成本存储，4）NVIDIA Vera CPU加速工具调用缩短上下文缓存空闲时间。","source",{"_180":181,"_182":179},"publishedAt","selected",true,"name","NVIDIA Blog","firstParty",{"_172":173,"_11":28,"_25":174,"_175":184,"_177":19,"_178":179},{"_180":181,"_182":179},{"_186":187,"_11":188,"_18":19,"_15":16,"_189":190},"factId","fnrDIEEyNBE4","NVIDIA通过全栈设计提高每字节的性能","representative",{"_172":173,"_11":28,"_25":174,"_175":191,"_177":19,"_178":179},{"_180":181,"_182":179},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete","rank",{"_199":200,"_201":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":127},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":21,"_22":23,"_24":25,"_26":-5,"_27":-5,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45},"publicId","be8ba4e0-3cfe-4a81-ab11-93604388f8e8","title","Tornado Cash资助钱包利用BTC/ETH价差套利获利2600万美元","status","active","reportCount",3,"sourceCount","firstReportAt","2026-11-08T01:43:59.000Z","latestAt","2026-11-08T01:53:00.000Z","digest","Tornado Cash资助的钱包通过兑换USDC并利用比特币/以太坊价差，在Hyperliquid平台完成约2600万美元套利交易。该钱包此前因非法交易已被美国财政部制裁，此次操作显示其通过复杂链上操作规避监管。关于交易金额存在两种表述：早先PANews称总价值2500万美元（基于1284万美元BTC多仓+1283万美元ETH空仓），后续The Defiant和ChainCatcher均修正为2600万美元（基于3100枚ETH兑换692万USDC，再通过20倍杠杆建立BTC多仓和ETH空仓）。","digestUpdatedAt","2026-11-08T02:07:38.539Z","summary","excerpt","latest","Tornado Cash资助钱包进行2600万美元比特币以太坊交易","latestReport",{"_77":95},"whyHot",{"_121":16,"_122":16,"_123":16,"_124":85,"_125":126},"developments",[103,104,105],"officialReports",[99,100],"timeline",[74,75,76],"heat",[60,61,62,63],"related",[],"topics",[46,47,48,49],{"_50":58,"_52":59},{"_50":56,"_52":57},{"_50":54,"_52":55},{"_50":51,"_52":53},"slug","security","name","安全事件","ethereum","以太坊 / ETH","bitcoin","比特币 / BTC","crypto-market","行情异动",{"_64":72,"_40":73,"_67":16},{"_64":70,"_40":71,"_67":16},{"_64":68,"_40":69,"_67":16},{"_64":65,"_40":66,"_67":16},"hour","2026-11-08T05:00:00.000Z",27.4,"participants","2026-11-08T04:00:00.000Z",28.2,"2026-11-08T03:00:00.000Z",29,"2026-11-08T02:00:00.000Z",29.8,{"_77":95,"_11":29,"_26":96,"_81":97,"_83":21,"_84":93},{"_77":88,"_11":89,"_26":90,"_81":91,"_83":92,"_84":93},{"_77":78,"_11":79,"_26":80,"_81":82,"_83":19,"_84":85},"id","n1ygks1c0mzt7djkr1hpq0wue","黑客在 Hyperliquid 平台进行 BTC 多仓与 ETH 空仓操作，总价值达 2500 万美元","黑客通过 Tornado Cash 接收 3,100 枚 ETH 并兑换为 6,920 万 USDC，随后在 Hyperliquid 平台建立 BTC 多仓（价值 1,284 万美元）和 ETH 空仓（价值 1,283 万美元），合计价值约 2500 万美元。","source",{"_52":86,"_87":85},"publishedAt","selected",true,"PANews","firstParty","f9xe237x6kalrmwm559ssl8uc","某黑客使用 20 倍杠杆做多 1284 万美元 BTC 并做空 1283 万美元 ETH","一黑客通过 Tornado Cash 收集 3100 枚 ETH，换得 692 万 USDC 存入 Hyperliquid，以 20 倍杠杆做多 169.47 枚 BTC（约 1284 万美元）并做空 5740 枚 ETH（约 1283 万美元）。",{"_52":94,"_87":85},"2026-11-08T01:49:49.000Z",false,"链捕手 ChainCatcher","rw666zmwah3i6ksv46yabusuo","Tornado Cash资助的钱包将3100 ETH兑换成约692万美元USDC，随后在Hyperliquid平台上做多比特币同时做空以太坊，总交易额约为2600万美元。",{"_52":98,"_87":93},"The Defiant",{"_77":88,"_11":89,"_26":90,"_81":102,"_83":92,"_84":93},{"_77":78,"_11":79,"_26":80,"_81":101,"_83":19,"_84":85},{"_52":86,"_87":85},{"_52":94,"_87":85},{"_106":117,"_11":118,"_18":21,"_15":109,"_110":119},{"_106":113,"_11":114,"_18":92,"_15":109,"_110":115},{"_106":107,"_11":108,"_18":19,"_15":109,"_110":111},"factId","fhyCeNb_DTXQ","一名黑客正在做多BTC并做空ETH",1,"representative",{"_77":78,"_11":79,"_26":80,"_81":112,"_83":19,"_84":85},{"_52":86,"_87":85},"fkaNo1-wWbNg","某黑客以 20 倍杠杆做多价值 1284 万美元 BTC，并做空 1283 万美元 ETH",{"_77":88,"_11":89,"_26":90,"_81":116,"_83":92,"_84":93},{"_52":94,"_87":85},"flxOXe2_C-pw","Tornado Cash-Funded Wallet Builds $26 Million Bitcoin-Ether ",{"_77":95,"_11":29,"_26":96,"_81":120,"_83":21,"_84":93},{"_52":98,"_87":93},"participants48h","newParticipants6h","recentReports24h","observationComplete","rank",5,{"_128":129,"_130":-5},"changelogVersion","2026-10-01T08:00","release"]

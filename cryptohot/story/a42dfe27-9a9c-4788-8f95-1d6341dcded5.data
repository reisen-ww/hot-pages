[{"_1":2,"_3":4},"root",{"_5":92},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","a42dfe27-9a9c-4788-8f95-1d6341dcded5","title","币安支付转账新增三次确认机制，并承诺补贴损失及奖励用户建议","status","active","reportCount",2,"sourceCount","firstReportAt","2026-11-08T04:05:32.000Z","latestAt","digest","币安联合创始人何一宣布将补贴用户因转错币造成的损失，并将在币安支付转账中增加三次确认步骤以降低错误率（据何一称）。该调整源于币安有三个独立开发的本地站点，其支付系统架构与主站不同，此前曾出现用户转错币的案例。何一同时发起用户建议征集，计划在一周内选出10条最佳建议，每位奖励1 BNB（据何一称）。","digestUpdatedAt","2026-11-08T04:20:17.449Z","summary","excerpt","latest","币安联合创始人回应用户转错币：补贴损失并增加三次确认","latestReport",{"_61":74},"whyHot",{"_87":58,"_88":58,"_89":58,"_90":73,"_91":-5},"developments",[80],"officialReports",[78],"timeline",[59,60],"heat",[53],"related",[],"topics",[45,46],{"_47":51,"_49":52},{"_47":48,"_49":50},"slug","security","name","安全事件","binance","Binance / 币安",{"_54":55,"_39":56,"_57":58},"hour","2026-11-08T05:00:00.000Z",9.7,"participants",1,{"_61":74,"_11":28,"_25":75,"_65":76,"_67":19,"_69":70},{"_61":62,"_11":63,"_25":64,"_65":66,"_67":68,"_69":70},"id","glhmiokmtomxeb80xs3rmwzqa","币安何一宣布以个人资金补贴用户转错币损失，并计划支付转账增加三次确认","币安联席CEO何一宣布以个人资金补贴用户转错币损失，并计划在支付转账环节增加三次确认。此外，币安邀请用户在评论区提出产品建议，活动为期一周，产品团队将选出10条最佳建议。","source",{"_49":71,"_72":73},"publishedAt","2026-11-08T03:51:58.000Z","selected",false,"链捕手 ChainCatcher","firstParty",true,"yhrtp0mv1bnt3ly3t016sayjb","币安联合创始人何一表示将补贴用户转错币的损失，并将在币安支付转账中增加三次确认。他欢迎用户提出产品建议，优秀建议者将获赠 1 BNB。",{"_49":77,"_72":73},"PANews",{"_61":74,"_11":28,"_25":75,"_65":79,"_67":19,"_69":70},{"_49":77,"_72":73},{"_81":82,"_11":83,"_18":19,"_15":58,"_84":85},"factId","fnFG3c0yu3yc","币安支付转账增加三次确认","representative",{"_61":74,"_11":28,"_25":75,"_65":86,"_67":19,"_69":70},{"_49":77,"_72":73},"participants48h","newParticipants6h","recentReports24h","observationComplete","rank",{"_93":94,"_95":-5},"changelogVersion","2026-10-01T0
[{"_1":2,"_3":4},"root",{"_5":81},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","992c2937-e925-4a04-a714-737e3b0ed717","title","俄美乌三方会谈技术性磋商难突破核心问题","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-08T03:45:57.000Z","latestAt","digest","多名俄方政治专家称，2026年11月8日在阿布扎比举行的俄美乌三方会谈属于技术性磋商，在乌克兰主权、领土完整等核心问题上几乎没有谈判空间【新】。该会议旨在协调军事援助与制裁执行，但俄方认为美乌方未就乌克兰问题根本立场达成共识，导致实质性突破困难。美乌方此前多次呼吁扩大讨论范围，但俄方始终强调会谈不应偏离技术议题。","digestUpdatedAt","2026-11-08T04:33:30.186Z","summary","excerpt","latest","俄美乌三方会谈属于技术性磋商，难取得重大突破","latestReport",{"_59":60},"whyHot",{"_75":16,"_76":16,"_77":16,"_78":79,"_80":-5},"developments",[69],"officialReports",[],"timeline",[58],"heat",[53],"related",[],"topics",[45,46],{"_47":51,"_49":52},{"_47":48,"_49":50},"slug","opinions","name","观点","speech","讲话与会议",{"_54":55,"_39":56,"_57":16},"hour","2026-11-08T05:00:00.000Z",9.6,"participants",{"_59":60,"_11":28,"_25":61,"_62":63,"_64":19,"_65":66},"id","zo8kvlzf3k9squfqh8vz4anvy","围绕乌克兰问题的俄美乌三方会谈将在阿联酋阿布扎比举行，专家认为此次谈判属于技术性磋商，难在核心问题上取得重大突破。","source",{"_49":67,"_68":66},"publishedAt","selected",false,"界面新闻","firstParty",{"_70":71,"_11":28,"_18":19,"_15":16,"_72":73},"factId","fAefFdvbuNeY","representative",{"_59":60,"_11":28,"_25":61,"_62":74,"_64":19,"_65":66},{"_49":67,"_68":66},"participants48h","newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_82":83,"_84":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":96},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","a903ed0e-b052-4dca-90c6-43427473b293","title","Sky.money设定3.8%储蓄率致USDS周供应量降15%","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-08T00:34:34.000Z","latestAt","digest","Sky.money通过治理层设定3.8%的储蓄率，导致USDS周流通供应量环比下降15%至55.9亿美元（2026-11-08数据）。该调整使USDS在链上分析平台显示的流通量较上周同期减少8.4亿，符合Sky.money公布的稳定币运营规则。目前该储蓄率设定已生效，但未披露具体实施周期和影响范围。","digestUpdatedAt","2026-11-08T00:48:55.359Z","summary","excerpt","latest","Sky.money USDS供应量周环比下降15%","latestReport",{"_73":74},"whyHot",{"_91":16,"_92":16,"_93":16,"_94":80,"_95":-5},"developments",[84],"officialReports",[],"timeline",[72],"heat",[55,56,57,58,59],"related",[],"topics",[45,46,47],{"_48":53,"_50":54},{"_48":5,"_50":52},{"_48":49,"_50":51},"slug","howto","name","教程与避坑","数据发布","stablecoin","稳定币",{"_60":70,"_39":71,"_63":16},{"_60":68,"_39":69,"_63":16},{"_60":66,"_39":67,"_63":16},{"_60":64,"_39":65,"_63":16},{"_60":61,"_39":62,"_63":16},"hour","2026-11-08T05:00:00.000Z",8.8,"participants","2026-11-08T04:00:00.000Z",9.1,"2026-11-08T03:00:00.000Z",9.3,"2026-11-08T02:00:00.000Z",9.6,"2026-11-08T01:00:00.000Z",9.9,{"_73":74,"_11":28,"_25":75,"_76":77,"_78":19,"_79":80},"id","t5j2udygu2ajlxscx7rlyrwxi","USDS周供应量环比下降15%至55.9亿美元，Sky.money治理层设定3.80%储蓄率。数据来自链上分析平台，反映稳定币市场动态。","source",{"_50":81,"_82":83},"publishedAt","selected",true,"The Defiant","firstParty",false,{"_85":86,"_11":87,"_18":19,"_15":16,"_88":89},"factId","fEwPuQsd6REQ","USDS circulating supply fell to $5.59 billion","representative",{"_73":74,"_11":28,"_25":75,"_76":90,"_78":19,"_79":80},{"_50":81,"_82":83},"participants48h","newParticipants6h","recentReports24h","observationComplete","rank",{"_97":98,"_99":-5},"changelogVersion","2026-10-01T08:00","release"]

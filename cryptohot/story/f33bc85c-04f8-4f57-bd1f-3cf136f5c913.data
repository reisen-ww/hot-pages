[{"_1":2,"_3":4},"root",{"_5":273},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":-5,"_28":-5,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46},"publicId","f33bc85c-04f8-4f57-bd1f-3cf136f5c913","title","伯克希尔Q3创纪录回购但净利润下滑幅度引争议 现金储备达3774亿美元","status","active","reportCount",11,"sourceCount",8,"firstReportAt","2026-11-07T13:00:16.000Z","latestAt","2026-11-08T01:56:07.000Z","digest","伯克希尔哈撒韦宣布2026年Q3回购96亿美元股票创历史新高，同时现金储备增至3774亿美元，但净利润同比下降幅度存在分歧（部分报道称27.8%，早先版本曾称9.2%），经营利润下滑5.8%，保险业务承保利润暴跌43%，投资收益减少近50%。CEO Greg Abel强调将利用现金储备通过回购、收购和股权投资实现战略目标，但未回应盈利下滑的具体应对措施。市场对其高回购与盈利下滑的对比展开讨论，部分报道指出伯克希尔同期加速抛售股票（Crypto Briefing）。","digestUpdatedAt","2026-11-08T02:07:59.749Z","summary","excerpt","latest","伯克希尔·哈撒韦 Q3 净利润大降 28%，现金储备升至 3774 亿美元","latestReport",{"_127":191},"whyHot",{"_268":18,"_269":224,"_270":16,"_271":143,"_272":224},"developments",[210,211,212,213,214,215,216,217,218,219,220],"officialReports",[194,195,196,197,198,199,200,201],"timeline",[116,117,118,119,120,121,122,123,124,125,126],"heat",[64,65,66,67,68,69,70,71,72,73,74,75,76,77,78,79],"related",[],"topics",[47,48,49,50,51],{"_52":62,"_54":63},{"_52":60,"_54":61},{"_52":58,"_54":59},{"_52":56,"_54":57},{"_52":53,"_54":55},"slug","regulation","name","监管与政策","crypto-market","行情异动","china-adr","中概股","microstrategy","MicroStrategy / Strategy","earnings","财报",{"_80":113,"_41":114,"_83":115},{"_80":111,"_41":112,"_83":94},{"_80":109,"_41":110,"_83":94},{"_80":107,"_41":108,"_83":94},{"_80":105,"_41":106,"_83":94},{"_80":103,"_41":104,"_83":94},{"_80":101,"_41":102,"_83":94},{"_80":99,"_41":100,"_83":94},{"_80":97,"_41":98,"_83":94},{"_80":95,"_41":96,"_83":94},{"_80":92,"_41":93,"_83":94},{"_80":90,"_41":91,"_83":18},{"_80":88,"_41":89,"_83":18},{"_80":86,"_41":87,"_83":18},{"_80":84,"_41":85,"_83":18},{"_80":81,"_41":82,"_83":18},"hour","2026-11-08T05:00:00.000Z",56.9,"participants","2026-11-08T04:00:00.
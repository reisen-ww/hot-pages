[{"_1":2,"_3":4},"root",{"_5":333},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":-5,"_28":-5,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46},"publicId","43bd26f6-af26-4197-9ec1-8ac809e888a8","title","中国香港通过加密资产税务框架法案分阶段对接国际标准","status","watching","reportCount",8,"sourceCount",6,"firstReportAt","2026-11-04T10:21:12.000Z","latestAt","2026-11-05T15:30:00.000Z","digest","香港立法会通过《2026年税务（修订）（加密资产报告框架及经修订共同申报准则）条例草案》，要求加密资产服务商自2027年起提交用户交易数据，并计划分阶段对接OECD的加密资产税务申报框架（CARF）及自动税务信息交换（CRS）。香港财政司司长许正宇称此举旨在巩固国际金融中心地位【新】【新】【新】【新】。法案首次将数字金融产品纳入监管范围，要求加强尽职调查和报告义务，自动交换金融账户信息将于2029年实施【新】【新】。市场数据显示，合规成本担忧已导致部分加密货币价格预期下调（如Hyperliquid在2026年底达百美元概率从51%降至46%）【新】【新】。","digestUpdatedAt","2026-11-05T17:40:39.951Z","summary","excerpt","latest","香港立法会通过加密货币税务报告法案，为2027年数据收集提前布局","latestReport",{"_229":275},"whyHot",{"_327":328,"_329":328,"_330":328,"_331":245,"_332":-5},"developments",[285,286,287,288,289,290,291,292],"officialReports",[279,280,281],"timeline",[221,222,223,224,225,226,227,228],"heat",[55,56,57,58,59,60,61,62,63,64,65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108],"related",[],"topics",[47,48],{"_49":53,"_51":54},{"_49":50,"_51":52},"slug","sec","name","SEC / 美国证监会","regulation","监管与政策",{"_109":219,"_41":220,"_112":208},{"_109":217,"_41":218,"_112":208},{"_109":215,"_41":216,"_112":208},{"_109":213,"_41":214,"_112":208},{"_109":211,"_41":212,"_112":208},{"_109":209,"_41":210,"_112":208},{"_109":206,"_41":207,"_112":208},{"_109":204,"_41":205,"_112":195},{"_109":202,"_41":203,"_112":195},{"_109":200,"_41":201,"_112":195},{"_109":198,"_41":199,"_112":195},{"_109":196,"_41":197,"_112":195},{"_109":193,"_41":194,"_112":195},{"_109":191,"_41":192,"_112":18},{"_109":189,"_41":190,"_112":18},{"_109":187,"_41":188,"_112":18},{"_109":185,"_41":186,"_112":18},{"_109":183,"_41"
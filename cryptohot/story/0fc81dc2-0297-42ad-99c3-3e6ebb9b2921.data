[{"_1":2,"_3":4},"root",{"_5":79},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","0fc81dc2-0297-42ad-99c3-3e6ebb9b2921","title","Ripple冻结Binance遭网络攻击影响资金并与调查方协调","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-29T23:18:12.000Z","latestAt","digest","Ripple已冻结Binance因疑似网络攻击受影响的RLUSD资金，并与相关方共同调查（Ripple高级副总裁Jack McDonald社交媒体声明）。事件涉及Ripple与Binance合作发行的稳定币RLUSD，当前冻结资金规模未披露，但Ripple称此系应对网络攻击的必要措施。Binance暂未回应具体指控，但此前RLUSD曾因合规问题引发监管争议（2026-10-30 链捕手报道）。","digestUpdatedAt","2026-10-30T01:20:31.599Z","summary","excerpt","latest","Ripple冻结Binance疑似攻击中受影响资金","latestReport",{"_54":55},"whyHot",{"_73":74,"_75":74,"_76":74,"_77":61,"_78":-5},"developments",[66],"officialReports",[64],"timeline",[53],"heat",[],"related",[],"topics",[45,46],{"_47":51,"_49":52},{"_47":48,"_49":50},"slug","security","name","安全事件","ripple","Ripple / XRP",{"_54":55,"_11":28,"_25":56,"_57":58,"_59":19,"_60":61},"id","ao0wohray84wyhaketdw6uv15","Ripple稳定币业务高级副总裁Jack McDonald在社交媒体发文称，Ripple正积极冻结Binance疑似遭网络攻击影响的RLUSD资金，并与相关方协调调查。","source",{"_49":62,"_63":61},"publishedAt","selected",true,"链捕手 ChainCatcher","firstParty",{"_54":55,"_11":28,"_25":56,"_57":65,"_59":19,"_60":61},{"_49":62,"_63":61},{"_67":68,"_11":69,"_18":19,"_15":16,"_70":71},"factId","f5l-4Uf6idOo","Ripple 正冻结 Binance 疑似攻击中受影响资金","representative",{"_54":55,"_11":28,"_25":56,"_57":72,"_59":19,"_60":61},{"_49":62,"_63":61},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete","rank",{"_80":81,"_82":-5},"changelogVersion","2026-10-01T08:00","release"]

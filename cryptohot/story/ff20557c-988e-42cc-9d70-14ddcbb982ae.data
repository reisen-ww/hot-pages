,"2026-11-04T04:31:53.000Z","tv3i0w5wv3jmrimlk3einnun5","纽约商品交易所轻质原油期货一周暴跌12.76% 伦敦布伦特原油期货跌幅达16.42% 创2020年以来最大跌幅","纽约商品交易所12月轻质原油期货一周下跌12.76%，伦敦布伦特原油期货跌幅达16.42%，创2020年以来最大跌幅。下跌主因包括美国中期选举后军事冲突预期降温，以及中东原油供应宽松叠加出口增长10%至日均超1500万桶。",{"_51":255,"_238":239},"2026-11-08T01:40:19.000Z","东方财富","txsbjloefzz00g0n7y1qbsqab","纽约商品交易所12月交货的轻质原油期货价格一周下跌12.76%，伦敦布伦特原油期货价格一周下跌16.42%，创2020年以来最大跌幅。油价下跌主要因美国与伊朗军事冲突升级风险降温及中东原油供应趋于宽松所致。",{"_51":237,"_238":239},{"_264":279,"_11":280,"_19":22,"_15":120,"_266":281},{"_264":276,"_11":30,"_19":254,"_15":120,"_266":277},{"_264":272,"_11":273,"_19":249,"_15":120,"_266":274},{"_264":269,"_11":241,"_19":244,"_15":120,"_266":270},{"_264":265,"_11":230,"_19":20,"_15":120,"_266":267},"factId","f3V2rn0IpxxU","representative",{"_228":229,"_11":230,"_27":231,"_232":268,"_234":20,"_235":236},{"_51":237,"_238":239},"f3Z_innK0A64",{"_228":240,"_11":241,"_27":242,"_232":271,"_234":244,"_235":239},{"_51":237,"_238":239},"fK36dAprLQnc","国际油价单日暴跌逾7%",{"_228":245,"_11":246,"_27":247,"_232":275,"_234":249,"_235":236},{"_51":237,"_238":239},"fxVg6AvIz_y8",{"_228":250,"_11":251,"_27":252,"_232":278,"_234":254,"_235":239},{"_51":255,"_238":239},"fHAlr3e56984","油价一周暴跌",{"_228":256,"_11":30,"_27":257,"_232":282,"_234":22,"_235":239},{"_51":237,"_238":239},"participants48h","newParticipants6h","recentReports24h","observationComplete","rank",{"_289":290,"_291":-5},"changelogVersion","2026-10-01T08:00","release"]

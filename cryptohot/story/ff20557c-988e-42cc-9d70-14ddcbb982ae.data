[{"_1":2,"_3":4},"root",{"_5":288},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":-5,"_28":-5,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46},"publicId","ff20557c-988e-42cc-9d70-14ddcbb982ae","title","美伊谈判推动国际油价单周暴跌创2020年以来最大跌幅","status","active","reportCount",5,"sourceCount",2,"firstReportAt","2026-11-02T22:50:56.000Z","latestAt","2026-11-08T03:10:35.000Z","digest","美伊谈判进展导致国际油价单日暴跌超7%创年内新低，随后一周跌幅扩大至16.42%，创2020年以来最大跌幅。核心动因包括：1）战争风险溢价消退（早先分析归因于OPEC+减产协议延迟与地缘政治风险缓和）；2）中东原油供应宽松叠加出口增长10%至日均超1500万桶（11月8日后续报道明确）。尽管市场解读为短期风险缓解，但11月4日界面新闻指出局势仍存反复，因美军曾袭击伊朗格什姆岛后双方进入密集磋商。南方基金同期建议通过大类资产组合分散风险，并认为油价回落有助于降温通胀预期，但可持续性取决于谈判落地。","digestUpdatedAt","2026-11-08T03:53:42.723Z","summary","excerpt","latest","油价一周暴跌超16%","latestReport",{"_228":256},"whyHot",{"_283":18,"_284":120,"_285":18,"_286":236,"_287":-5},"developments",[259,260,261,262,263],"officialReports",[],"timeline",[223,224,225,226,227],"heat",[55,56,57,58,59,60,61,62,63,64,65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111],"related",[],"topics",[47,48],{"_49":53,"_51":54},{"_49":50,"_51":52},"slug","commodities","name","大宗商品","crypto-market","行情异动",{"_112":222,"_41":185,"_115":120},{"_112":220,"_41":221,"_115":120},{"_112":219,"_41":181,"_115":120},{"_112":217,"_41":218,"_115":120},{"_112":215,"_41":216,"_115":120},{"_112":213,"_41":214,"_115":120},{"_112":212,"_41":165,"_115":120},{"_112":211,"_41":163,"_115":120},{"_112":209,"_41":210,"_115":120},{"_112":207,"_41":208,"_115":120},{"_112":205,"_41":206,"_115":120},{"_112":203,"_41":204,"_115":120},{"_112":201,"_41":202,"_115":120},{"_112":199,"_41":200,"_115":120},{"_112":197,"_41":198,"_115":120},{"_112":195,"_41":196,"_115":120},{"_112":194,"_41":161,"_115":120},{"_112":192,"_41":193,"_115":120},{"_112":190,"_41":191,"_115":120},{"_112":188,"_41":189
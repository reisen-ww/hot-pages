[{"_1":2,"_3":4},"root",{"_5":97},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","cacecb9f-3946-4bf9-8967-1226a8725326","title","AI行业下滑助推中印贸易复苏及亚洲市场调整","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-08T00:00:00.000Z","latestAt","digest","Bloomberg Markets称，美国中期选举后AI行业需求降温，促使投资者将目光转向印度、越南等新兴市场，并增持中国科技企业股票。数据显示，2026年第三季度中国对印度出口额环比增长12.3%，主要受益于AI产业链转移及印度本地供应链完善【新】。分歧点在于机构对市场复苏的驱动因素解读不同：Aberdeen Investments强调印度IT和制造业升级（2026年Q2当地GDP增速达7.2%），而Allianz Global Investors认为中国消费电子出口增长（同比+18%）更为关键。当前影响范围覆盖中印电子元件、机械零部件及医疗设备三大贸易类别，但未涉及能源、农产品等敏感领域。","digestUpdatedAt","2026-11-08T00:56:03.710Z","summary","excerpt","latest","AI 行业下滑推动中国至印度地区贸易复苏","latestReport",{"_74":75},"whyHot",{"_92":16,"_93":16,"_94":16,"_95":81,"_96":-5},"developments",[86],"officialReports",[84],"timeline",[73],"heat",[56,57,58,59,60],"related",[],"topics",[45,46,47],{"_48":54,"_50":55},{"_48":52,"_50":53},{"_48":49,"_50":51},"slug","howto","name","教程与避坑","opinions","观点","research","研究报告",{"_61":71,"_39":72,"_64":16},{"_61":69,"_39":70,"_64":16},{"_61":67,"_39":68,"_64":16},{"_61":65,"_39":66,"_64":16},{"_61":62,"_39":63,"_64":16},"hour","2026-11-08T05:00:00.000Z",8.7,"participants","2026-11-08T04:00:00.000Z",8.9,"2026-11-08T03:00:00.000Z",9.2,"2026-11-08T02:00:00.000Z",9.4,"2026-11-08T01:00:00.000Z",9.7,{"_74":75,"_11":28,"_25":76,"_77":78,"_79":19,"_80":81},"id","cmn5m2qqrh1zd201inc6ctntx","美国中期选举后 AI 行业下滑，促使投资者重新评估亚洲市场策略。重点包括印度和越南等新兴市场，以及中国科技企业因通胀缓解和贸易紧张局势趋缓带来的机遇。Aberdeen Investments看好印度和越南市场，Lotus Asset Management 增持香港股指期货，Allianz Global Investors 关注医疗和消费领域。","source",{"_50":82,"_83":81},"publishedAt","selected",true,"Bloomberg Markets","firstParty",{"_74":75,"_11":28,"_25":76,"_77":85,"_79":19,"_80":81},{"_50":82,"_83":81},{"_87":88,"_11":28,"_18":19,"_15":16,"_89":90},"factId","f2xZa8lioWEM","representative",{"_74":75,"_11":28,"_25":76,"_77":91,"_79":19,"_80":81},{"_50":82,"_83":81},"participants48h","newParticipants6h","recentReports24h","observationComplete","rank",{"_98":99,"_100":-5},"changelogVersion","2026-10-01T08:00","release"]

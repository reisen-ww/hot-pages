[{"_1":2,"_3":4},"root",{"_5":88},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","2a5db687-775b-4666-90e1-6ed10d83dfc9","title","HMH第三季度财报电话会议：CEO重申全年目标应对延迟与市场挑战","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-08T01:04:33.000Z","latestAt","digest","HMH Holding Inc. 在2026年第三季度财报电话会议上确认全年业绩目标，但披露业绩受钻井平台激活延迟（具体影响未量化）及市场不利因素（未明确类型）拖累【新】。CEO Eirik Bergsvik 强调公司将继续推进战略举措，包括未提及的后续计划，但未更新全年目标的具体调整空间【新】。事件背景为HMH作为钻井设备供应商，2026年三季度财报数据已通过电话会议同步给投资者，目前无其他公开信息补充该事件的影响范围。","digestUpdatedAt","2026-11-08T01:22:44.088Z","summary","excerpt","latest","HMH Holding Inc. 第三季度财报电话会议纪要","latestReport",{"_65":66},"whyHot",{"_82":16,"_83":16,"_84":16,"_85":86,"_87":-5},"developments",[75],"officialReports",[],"timeline",[64],"heat",[50,51,52,53],"related",[],"topics",[45],{"_46":47,"_48":49},"slug","earnings","name","财报",{"_54":62,"_39":63,"_57":16},{"_54":60,"_39":61,"_57":16},{"_54":58,"_39":59,"_57":16},{"_54":55,"_39":56,"_57":16},"hour","2026-11-08T05:00:00.000Z",8.9,"participants","2026-11-08T04:00:00.000Z",9.2,"2026-11-08T03:00:00.000Z",9.5,"2026-11-08T02:00:00.000Z",9.7,{"_65":66,"_11":28,"_25":67,"_68":69,"_70":19,"_71":72},"id","mma6m64n6ofdtmseovydbbyeq","HMH Holding Inc. 第三季度财报显示，业绩受到钻井平台激活延迟和市场不利因素的影响。CEO Eirik Bergsvik 在电话会议上表示，尽管面临挑战，公司仍致力于实现全年目标。","source",{"_48":73,"_74":72},"publishedAt","selected",false,"Seeking Alpha","firstParty",{"_76":77,"_11":78,"_18":19,"_15":16,"_79":80},"factId","f7uUo62KlDMA","HMH Holding Inc. Q3 2026 Earnings Call","representative",{"_65":66,"_11":28,"_25":67,"_68":81,"_70":19,"_71":72},{"_48":73,"_74":72},"participants48h","newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_89":90,"_91":-5},"changelogVersion","2026-10-01T08:00","release"]

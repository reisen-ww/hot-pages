"_11":1454,"_19":1455,"_15":439,"_1249":1456},{"_1246":1444,"_11":1445,"_19":1446,"_15":439,"_1249":1447},{"_1246":1440,"_11":1362,"_19":1441,"_15":445,"_1249":1442},{"_1246":1432,"_11":1433,"_19":1434,"_15":439,"_1249":1435},{"_1246":1424,"_11":1425,"_19":1426,"_15":439,"_1249":1427},{"_1246":1416,"_11":1417,"_19":1418,"_15":439,"_1249":1419},{"_1246":1408,"_11":1409,"_19":1410,"_15":439,"_1249":1411},{"_1246":1400,"_11":1401,"_19":1402,"_15":439,"_1249":1403},{"_1246":1392,"_11":1393,"_19":1394,"_15":439,"_1249":1395},{"_1246":1385,"_11":1386,"_19":1387,"_15":439,"_1249":1388},{"_1246":1378,"_11":1379,"_19":1380,"_15":439,"_1249":1381},{"_1246":1370,"_11":1371,"_19":1372,"_15":439,"_1249":1373},{"_1246":1361,"_11":1362,"_19":1363,"_15":439,"_1249":1364},{"_1246":1353,"_11":1354,"_19":1355,"_15":439,"_1249":1356},{"_1246":1344,"_11":1345,"_19":1346,"_15":254,"_1249":1347},{"_1246":1335,"_11":1336,"_19":1337,"_15":307,"_1249":1338},{"_1246":1327,"_11":1328,"_19":1329,"_15":439,"_1249":1330},{"_1246":1319,"_11":1320,"_19":1321,"_15":439,"_1249":1322},{"_1246":1312,"_11":1313,"_19":1314,"_15":439,"_1249":1315},{"_1246":1303,"_11":1304,"_19":1305,"_15":359,"_1249":1306},{"_1246":1296,"_11":1297,"_19":1298,"_15":439,"_1249":1299},{"_1246":1287,"_11":1288,"_19":1289,"_15":412,"_1249":1290},{"_1246":1279,"_11":1280,"_19":1281,"_15":439,"_1249":1282},{"_1246":1271,"_11":1272,"_19":1273,"_15":439,"_1249":1274},{"_1246":1263,"_11":1264,"_19":1265,"_15":439,"_1249":1266},{"_1246":1255,"_11":1256,"_19":1257,"_15":439,"_1249":1258},{"_1246":1247,"_11":1248,"_19":20,"_15":439,"_1249":1250},"factId","fDOQJKfA3QnQ","Anthropic拟披露第三季度财务数据","representative",{"_588":1251,"_11":1252,"_27":1253,"_592":1254,"_594":20,"_596":605},"sgktx990eja22ktcub7xzn7uu","Anthropic拟披露第三季度财务数据，预计11月进行IPO","据CNBC报道，Anthropic计划在预期于11月进行IPO前披露第三季度财务数据。预测市场显示，Anthropic IPO日市值落在$1.75万亿至$2.0万亿区间的概率为26%，截至2026年12月31日完成上市的概率为68.5%。",{"_55":638,"_599":605},"fiU1yH7AmhO8","Anthropic将向机构投资者披露Q3财务数据","2026-10-14T00:55:33.000Z",{"_588":1259,"_11":1260,"_27":1261,"_592":1262,"_594":1257,"_596":597},"g2w673tww346xamncgebrxxck","Anthropic今日公布Q3财务数据，为史上最大IPO铺路","Anthropic将于本周三首次向机构投资者披露第三季度营收数据，为其估值约2万亿美元的IPO计划铺路，公司营收有望今年底突破1000亿美元。此前OpenAI披露500亿美元年化营收低于市场预期，引发半导体股和纳斯达克指数下挫，投资者将关注Anthropic能否避免类似信息混乱。",{"_55":598,"_599":597},"f6tfzYKpu42Q","Anthropic提交IPO申请","2026-10-14T15:43:55.000Z",{"_588":1267,"_11":1268,"_27":1269,"_592":1270,"_594":1265,"_596":605},"wyzri23jydcqk837c4c70eqze","Anthropic 秘密递交 IPO 申请，目标估值 2 万亿美元","Anthropic 已秘密递交 IPO 申请，计划以 2 万亿美元目标估值上市，交易最高可能募资 1000 亿美元。公司 2026 年 5 月 Series H 融资估值为 9650 亿美元；2025 年营收增长 12 倍至约 46 亿美元，净亏损估计约 420 亿美元。",{"_55":638,"_599":605},"fcyLGpe6ed5k","Anthropic公布Q3营收168亿美元，环比增长45%","2026-10-15T04:42:00.000Z",{"_588":1275,"_11":1276,"_27":1277,"_592":1278,"_594":1273,"_596":597},"xsoo9gv1mmhnccoalnw4vwqc0","Anthropic第三季度营收168亿美元，环比增长45%","Anthropic第三季度营收达168亿美元，环比增长45%，并告诉投资者经调整后已实现盈利。公司第一季度至第三季度营收分别为47亿、116亿和168亿美元，年化运行率约670亿美元。Anthropic目标估值超过2万亿美元，同时承诺未来十年至少投入5180亿美元用于云计算和基础设施，其IPO预计将先于OpenAI，可能推迟至11月美国中期选举之后。",{"_55":612,"_599":605},"fhVI-uIcfqw4","Anthropic目标估值超2万亿美元，筹备IPO","2026-10-15T08:49:42.000Z",{"_588":1283,"_11":1284,"_27":1285,"_592":1286,"_594":1281,"_596":597},"m4p24g806bjdwgianl3gy44v2","Anthropic目标估值超2万亿美元，IPO前路演披露三季度营收168亿美元","Anthropic在IPO前闭门投资者会议上提出超2万亿美元的目标估值，较2026年5月H轮融资的9650亿美元大幅跃升。公司披露三季度营收168亿美元，环比增长45%，并称已实现调整后盈利和正自由现金流。IPO路演预计11月9日当周启动，交易可能在11月26日前开始。",{"_55":638,"_599":605},"fInmP8bwEyLQ","纽约市主计长敦促Anthropic暂停IPO计划","2026-10-15T11:44:03.000Z",{"_588":1291,"_11":1292,"_27":1293,"_592":1294,"_594":1295,"_596":605},"ygyphdl2tukg2gcwiytte4evn","纽约市主计长呼吁 Anthropic 暂停 IPO 以应对 AI 安全风险","纽约市主计长呼吁 Anthropic PBC 暂停 IPO，直至其充分解决 AI 安全、治理及开发速度方面的风险。",{"_55":606,"_599":597},"2026-10-15T13:13:33.000Z","foIPZh4Wy5_w","Anthropic 2万亿美元估值之争：增速放缓与天价算力账单","2026-10-17T05:36:00.000Z",{"_588":1300,"_11":1297,"_27":1301,"_592":1302,"_594":1298,"_596":605},"flnld3bsllnf6njuergusp8xd","多家媒体报道Anthropic正谋求以2万亿美元估值上市，计划募资约1000亿美元，但其第三季度营收环比增速已从第二季度的147%大幅回落至约45%，部分投资者转而以1.5万亿美元估值衡量公司。",{"_55":612,"_599":605},"ftQjzE8Y5KAk","Anthropic披露IPO草案财务数据","2026-10-20T19:50:00.000Z",{"_588":1307,"_11":1308,"_27":1309,"_592":1310,"_594":1311,"_596":597},"nfm5n85o9ntu0ha9tygi8zkpn","Anthropic IPO草案：上半年营收163亿美元，净亏损807亿美元","Anthropic 提交的 S-1 注册声明草案显示，其 2026 年上半年营收 163 亿美元，去年同期为 11 亿美元；上半年净亏损 807 亿美元，去年同期亏损 130 亿美元，亏损主要来自融资相关的非现金会计费用。",{"_55":682,"_599":597},"2026-10-20T19:58:04.000Z","f6sF49kzTF6Y","Anthropic 上市临近，美国 IPO 市场陷入“瘫痪”","2026-10-22T14:52:25.000Z",{"_588":1316,"_11":1313,"_27":1317,"_592":1318,"_594":1314,"_596":605},"kj4frcqdizr6aat5wgw2dnzp2","Anthropic PBC 的上市临近，人工智能争议让美国 IPO 市场停滞在发射台上，数十亿美元资本与数月的筹备工作悬而未决。",{"_55":606,"_599":597},"f6VI2rZQtU1w","Anthropic拟下月IPO，估值约1.5万亿美元","2026-10-23T20:32:44.000Z",{"_588":1323,"_11":1324,"_27":1325,"_592":1326,"_594":1321,"_596":605},"zdks125mwdz8387z6nhfjk8r1","Anthropic 员工预期 AI 突破，华尔街对其 IPO 估值存疑","Anthropic 报告显示 91% 的受访员工预计 AI 将在 2030 年前取得诺贝尔奖级突破，而美国成年公众中仅 39% 持此预期。该公司计划下月进行 IPO，估值可能约 $1.5 trillion，是 2026 年秋季唯一仍在推进的主要科技上市。文章提示 Dario Amodei 的战略表态以及与 Amazon、Google 等投资者的合作进展可能影响估值预期。",{"_55":638,"_599":605},"fSeGm5I9K5b8","Anthropic 将于美东时间上午 9 点发布其首次公开募股（IPO）的 S-1 文件","2026-10-26T12:28:48.000Z",{"_588":1331,"_11":1332,"_27":1333,"_592":1334,"_594":1329,"_596":597},"nof2p806b8tjn5ytjqxordqs6","Anthropic 拟提交 IPO 申请，规模或超 SpaceX","Anthropic 计划于北京时间 21:00 发布 IPO S-1 文件，预计规模将与 SpaceX 相当甚至更大，最早于 11 月 9 日当周启动推介活动。",{"_55":665,"_599":597},"fjww3MP-yJ8s","Anthropic 提交 IPO 申请","2026-10-26T13:04:43.000Z",{"_588":1339,"_11":1340,"_27":1341,"_592":1342,"_594":1343,"_596":597},"ounodzwh2ktmstkbs1v7h7uru","Anthropic 公开提交纳斯达克 IPO 申请，股票代码为 ANT","Anthropic 提交 IPO 申请，股票代码为 ANT，上半年营收 163 亿美元，净亏损 807 亿美元，预计未来向谷歌支付 1145 亿美元，并在租赁期内支付 1612 亿美元租金。",{"_55":665,"_599":597},"2026-10-26T13:05:25.000Z","fDt2PG3my4cQ","Anthropic正式提交IPO申请","2026-10-26T13:05:31.000Z",{"_588":1348,"_11":1349,"_27":1350,"_592":1351,"_594":1352,"_596":597},"wwqgxcpx0bz0d2i3ic7d2x9bw","Anthropic IPO申请细节披露","Anthropic向SEC提交IPO申请，目标估值1.5万亿美元至2万亿美元，已签署8000亿美元算力合同，美股半导体板块随之上涨。",{"_55":665,"_599":597},"2026-10-27T04:15:20.000Z","feYBI-jpkMds","Anthropic 的 S-1 文件","2026-10-26T13:08:09.000Z",{"_588":1357,"_11":1358,"_27":1359,"_592":1360,"_594":1355,"_596":605},"gtcj2hk3aq4yp1b4jvy6mquyi","Anthropic IPO 或成史上最大规模 IPO","Anthropic 计划上市，可能成为历史上规模最大的股票市场首发。",{"_55":790,"_599":597},"f0QjBmPYNPx4","Anthropic Files for IPO","2026-10-26T13:20:08.000Z",{"_588":1365,"_11":1366,"_27":1367,"_592":1368,"_594":1363,"_596":597},"ewilqb222kj1hbf5llyy6dqgi","Anthropic 申请IPO，上半年营收达163亿美元","Anthropic 宣布申请首次公开募股（IPO），并披露2026年上半年营收达163亿美元。当前未公布定价区间或股份数量。",{"_55":1369,"_599":605},"The Defiant","fYCVoSw_cBlk","Anthropic filed for an IPO","2026-10-26T13:22:09.000Z",{"_588":1374,"_11":1375,"_27":1376,"_592":1377,"_594":1372,"_596":597},"iupsprujc78hhuxbaefkjq6wc","AI 巨头 Anthropic 提交 IPO 申请","Anthropic 提交 IPO 申请，预计 11 月上市，上半年收入 163 亿美元，净亏损 807 亿美元。芯片股在预盘中上涨，Nvidia、Broadcom 和 Micron 分别上涨 1.4%、1.5% 和 2.3%。Hyperliquid 上 ANTH 合约价格波动较大。",{"_55":891,"_599":597},"f-bvo0zE2XB8","Anthropic目标在11月16日当周进行IPO","2026-10-26T13:23:47.000Z",{"_588":1382,"_11":1379,"_27":1383,"_592":1384,"_594":1380,"_596":605},"amuqwgwkuptcdhvg4vahw84qw","Anthropic 宣布计划于11月16日当周进行 IPO，目前未就重大收购达成任何协议。",{"_55":682,"_599":597},"fe7mh18Fl-EU","Anthropic 目标于 11 月 16 日当周进行 IPO","2026-10-26T13:29:18.000Z",{"_588":1389,"_11":1386,"_27":1390,"_592":1391,"_594":1387,"_596":597},"gnufiyt3x4tkri0eja0v87gln","ChainCatcher 消息，Anthropic 目标在 11 月 16 日当周进行 IPO。",{"_55":665,"_599":597},"fwLiUK1p2WEI","Anthropic计划IPO融资规模可能达到1000亿美元","2026-10-26T13:38:56.000Z",{"_588":1396,"_11":1397,"_27":1398,"_592":1399,"_594":1394,"_596":597},"l9aqo1f3sod99vlptd7a1q9m8","Anthropic IPO融资规模或达1000亿美元","Anthropic计划在11月16日当周上市，融资规模可能达到1000亿美元，估值有望达到1.5万亿至2万亿美元。",{"_55":682,"_599":597},"fChJxbL_zz7w","Anthropic 在 IPO 申请中警告 AI 模型可能带来存在性风险","2026-10-26T13:48:18.000Z",{"_588":1404,"_11":1405,"_27":1406,"_592":1407,"_594":1402,"_596":597},"nqr6u444paflyt64b9yip2e4d","Anthropic 在 IPO 文件中警告其 AI 模型可能带来存在性风险","Anthropic 在 IPO 文件中警告其 AI 模型可能带来存在性风险，市场对其排名信心略有下降。公司正准备上市，估值在 1.8 至 2 万亿美元之间。",{"_55":638,"_599":605},"fKTs9ZhdvV3I","Anthropic Makes IPO Filing Public","2026-10-26T13:50:22.000Z",{"_588":1412,"_11":1413,"_27":1414,"_592":1415,"_594":1410,"_596":597},"rg1lu3a6hxxjo0sacfl05ncgq","Anthropic 公布 IPO 申请，计划在 NASDAQ 上市","Anthropic 提交 IPO 申请，计划以 ANT 为股票代码在 NASDAQ 上市，上半年营收达 163 亿美元，净亏损 807 亿美元。",{"_55":1069,"_599":605},"fxoWMBYMGJ9U","Anthropic IPO filing","2026-10-26T14:31:10.000Z",{"_588":1420,"_11":1421,"_27":1422,"_592":1423,"_594":1418,"_596":597},"kt8dsvacnvmyz4snonjqtzblk","Anthropic计划在纳斯达克上市，代码ANT，估值超2万亿美元","Anthropic提交IPO文件，计划11月在纳斯达克上市，估值超2万亿美元。公司预计未来几年在云计算和AI基础设施上的支出将达数百亿美元。尽管收入大幅增长，但净亏损也在扩大。",{"_55":638,"_599":605},"f9Rn8kyW2CKA","Anthropic 向美国 SEC 递交 S-1 招股书，计划最快 11 月中旬上市","2026-10-26T14:37:46.000Z",{"_588":1428,"_11":1429,"_27":1430,"_592":1431,"_594":1426,"_596":597},"iqv5eyxgldasuj8dgk87d1xm7","Anthropic递交IPO招股书：计划11月中旬上市估值或达2万亿美元","Anthropic向SEC递交S-1招股书，计划11月上市，估值有望达1万亿至2万亿美元。市场预期本次IPO募资规模或达千亿美元级别。",{"_55":665,"_599":597},"fSE7aorIi9ZI","Anthropic计划在IPO后早期允许部分投资者和员工出售股份","2026-10-26T15:00:48.000Z",{"_588":1436,"_11":1437,"_27":1438,"_592":1439,"_594":1434,"_596":605},"bkjwgpxf67xc7v0r3pcoxsdxw","Anthropic 计划 IPO 后早期股份销售以增加流动性","Anthropic 计划允许部分投资者和员工在 IPO 后 180 天锁定期内提前出售股份，以增加流动性。公司预计 IPO 市值在 1.5-2 万亿美元之间，此前估值为 9650 亿美元。市场数据显示 IPO 时市值有 26% 的概率在 1.75-2 万亿美元之间。",{"_55":638,"_599":605},"frU5ngL2t2sk","2026-10-26T16:00:03.000Z",{"_588":928,"_11":929,"_27":930,"_592":1443,"_594":932,"_596":597},{"_55":606,"_599":597},"f9_x9-N6KaKo","Anthropic IPO filing details voting power structure","2026-10-26T16:25:00.000Z",{"_588":1448,"_11":1449,"_27":1450,"_592":1451,"_594":1446,"_596":605},"s17hpkfy2tjgf5ym20xvyeq4z","Anthropic IPO: 7人将控制公司投票权","Anthropic 提交纳斯达克上市申请，使用股票代码 ANT。IPO 后公众可购买 ANT 并行使一票一投的权利，但 CEO Dario Amodei 和六人组成的 Founders LLC 将持有 50.1% 的投票权。尽管有七人控制投票权，但理论上四人即可控制 Anthropic 的投票权。",{"_55":1452,"_599":605},"Protos","f0hWeT1qjvRg","OKX Offers 10x Anthropic Valuation Bets After IPO Filing","2026-10-26T16:39:38.000Z",{"_588":1457,"_11":1458,"_27":1459,"_592":1460,"_594":1455,"_596":605},"wv8omno8ip2dmwjiyq13l2doj","OKX 提供 10 倍 Anthropic 估值押注服务","OKX 在 IPO 申请后为符合条件的 EEA 交易者提供现金结算的 Anthropic 估值押注服务，不涉及股票分配或 IPO 配售。",{"_55":1369,"_599":605},"f3NoTh5DiRfs","Anthropic 公司提交 S-1 表，预计今年 IPO","2026-10-26T16:51:52.000Z",{"_588":1465,"_11":1466,"_27":1467,"_592":1468,"_594":1463,"_596":597},"hp3sa14sen18ywnvscsbr7cjf","预测市场显示Anthropic IPO几乎确定将在今年内完成","Anthropic提交了Form S-1文件，预测市场平台Kalshi认为其在2026年底前宣布IPO的概率为95%，并预计其股票将于11月16日左右开始交易。",{"_55":671,"_599":597},"fnE6YWDai44o","Anthropic’s seven co-founders each hold stakes worth over $1","2026-10-26T16:52:33.000Z",{"_588":1473,"_11":1474,"_27":1475,"_592":1476,"_594":1471,"_596":597},"x2ga8s1pcuw9oqubjx4xrbd52","Anthropic 七位联合创始人每人持有超过 130 亿美元的股份","Anthropic 的七位联合创始人每人持有公司约 1.4% 的股份，公司最新估值为 9650 亿美元。公司第三季度收入达 168 亿美元，计划于 2026 年 11 月 IPO，潜在估值在 1.5 万亿至 2 万亿之间。",{"_55":638,"_599":605},"fdKbwjPfaVFw","Anthropic 宣布 IPO 计划并披露客户数据","2026-10-26T16:54:45.000Z",{"_588":1481,"_11":1482,"_27":1483,"_592":1484,"_594":1479,"_596":597},"zfuzzgdlpg7ufk70jbs5urt29","Anthropic 的 IPO 文件展示了如何通过生态系统策略锁定企业客户","Anthropic 的 IPO 文件显示其拥有超过 11,900 家企业客户，其中 250 家年支出超过 1000 万美元。公司通过捆绑 Claude 到多个产品中，增加客户转换竞争对手的难度。这表明 Anthropic 的 AI 产品在企业客户中的采用速度和深度。",{"_55":638,"_599":605},"fgEaNJmx-CAA","Prospectus details AI lab’s ‘mission’","2026-10-26T17:45:49.000Z",{"_588":1489,"_11":1490,"_27":1491,"_592":1492,"_594":1487,"_596":597},"k1wcux2jreoqb1jnocvo0gd6n","Anthropic IPO文件揭示宏大但合理的使命与巨额数据中心投资","金融时报报道，Anthropic的IPO文件详细披露了其使命、承诺投资800亿美元的数据中心以及独特的治理结构，为潜在投资者提供了重要信息。",{"_55":790,"_599":597},"fNHsqLvZ58mo","Anthropic IPO","2026-10-26T18:21:53.000Z",{"_588":1497,"_11":1498,"_27":1499,"_592":1500,"_594":1495,"_596":605},"yfshf7fz5wfeu2kfym3d8morl","Anthropic IPO 或成 AI 软件领域里程碑事件","Byrnony Deeter 表示，Anthropic 的 IPO 将为公众投资者提供进入 AI 软件领域的投资机会。Bessemer Venture Partners 在 Anthropic 的 Series D 轮投资中领投。",{"_55":606,"_599":597},"f8uY7F
[{"_1":2,"_3":4},"root",{"_5":1937},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":-5,"_28":-5,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46},"publicId","e22a707a-4c11-479c-86f5-e98f4548114c","title","Anthropic估值暴跌至1.25万亿，IPO概率骤降与巨额债务压力并存","status","active","reportCount",208,"sourceCount",19,"firstReportAt","2026-10-13T14:59:03.000Z","latestAt","2026-11-07T15:06:24.000Z","digest","Anthropic于2026年11月3日更新招股书，将估值从1.5-1.75万亿美元下调至1.25万亿美元，IPO概率从55%降至31.7%。核心变化源于Q3净亏损233亿美元（同比扩大92%），计算成本占营收58%（同比增300%），叠加需在12个月内偿还69.8亿美元债务及8954亿美元算力支出承诺。财务风险包括：1）现金储备956亿美元难以覆盖债务；2）招股书未披露计算成本分摊方式；3）运营亏损收窄至5.67亿美元但未说明未来增长预期。政治风险方面，创始人通过Class F股保留50.1%投票权，且招股书警告AI模型可能触及关键发展阈值，引发更严格的安全审查。市场分歧集中在估值合理性（私筹估值约9650亿美元低于当前预期）与SpaceX股价波动风险（市场对AI巨头IPO信心受挫）。","digestUpdatedAt","2026-11-07T18:17:23.995Z","summary","excerpt","latest","Anthropic更新招股书披露2045年8954亿美元数据中心投入计划","latestReport",{"_588":1095},"whyHot",{"_1930":229,"_1931":1932,"_1933":307,"_1934":597,"_1935":1936},"developments",[1132,1133,1134,1135,1136,1137,1138,1139,1140,1141,1142,1143,1144,1145,1146,1147,1148,1149,1150,1151,1152,1153,1154,1155,1156,1157,1158,1159,1160,1161,1162,1163,1164,1165,1166,1167,1168,1169,1170,1171,1172,1173,1174,1175,1176,1177,1178,1179,1180,1181,1182,1183,1184,1185,1186,1187,1188,1189,1190,1191,1192,1193,1194,1195,1196,1197,1198,1199,1200,1201,1202,1203,1204,1205,1206,1207,1208,1209,1210,1211,1212,1213,1214,1215,1216,1217,1218,1219,1220,1221,1222,1223,1224,1225,1226,1227,1228,1229,1230,1231,1232,1233,1234,1235,1236,1237,1238,1239,1240,1241,1242,1243,1244,1245],"officialReports",[1108,1109,1110,1111,1112,1113,1114,1115,1116,1117,1118,1119],"timeline",[488,489,490,491,492,493,494,495,496,497,498,499,500,501,502,503,504,505,506,507,508,509,510,511,512,513,514,515,516,517,518,519,520,521,522,523,524,525,526,527,528,529,530,531,532,533,534,535,536,537,538,539,540,541,542,543,544,545,546,547,548,549,5
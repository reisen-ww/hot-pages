853,"_592":854,"_594":855,"_596":605},{"_588":846,"_11":847,"_27":848,"_592":849,"_594":850,"_596":605},{"_588":841,"_11":842,"_27":843,"_592":844,"_594":845,"_596":597},{"_588":836,"_11":837,"_27":838,"_592":839,"_594":840,"_596":605},{"_588":831,"_11":832,"_27":833,"_592":834,"_594":835,"_596":605},{"_588":826,"_11":827,"_27":828,"_592":829,"_594":830,"_596":597},{"_588":821,"_11":822,"_27":823,"_592":824,"_594":825,"_596":605},{"_588":816,"_11":817,"_27":818,"_592":819,"_594":820,"_596":597},{"_588":811,"_11":812,"_27":813,"_592":814,"_594":815,"_596":605},{"_588":806,"_11":807,"_27":808,"_592":809,"_594":810,"_596":605},{"_588":801,"_11":802,"_27":803,"_592":804,"_594":805,"_596":605},{"_588":796,"_11":797,"_27":798,"_592":799,"_594":800,"_596":605},{"_588":791,"_11":792,"_27":793,"_592":794,"_594":795,"_596":605},{"_588":785,"_11":786,"_27":787,"_592":788,"_594":789,"_596":605},{"_588":780,"_11":781,"_27":782,"_592":783,"_594":784,"_596":597},{"_588":775,"_11":776,"_27":777,"_592":778,"_594":779,"_596":605},{"_588":770,"_11":771,"_27":772,"_592":773,"_594":774,"_596":605},{"_588":765,"_11":766,"_27":767,"_592":768,"_594":769,"_596":605},{"_588":760,"_11":761,"_27":762,"_592":763,"_594":764,"_596":597},{"_588":755,"_11":756,"_27":757,"_592":758,"_594":759,"_596":597},{"_588":749,"_11":750,"_27":751,"_592":752,"_594":753,"_596":605},{"_588":744,"_11":745,"_27":746,"_592":747,"_594":748,"_596":605},{"_588":739,"_11":740,"_27":741,"_592":742,"_594":743,"_596":597},{"_588":734,"_11":735,"_27":736,"_592":737,"_594":738,"_596":605},{"_588":729,"_11":730,"_27":731,"_592":732,"_594":733,"_596":605},{"_588":724,"_11":725,"_27":726,"_592":727,"_594":728,"_596":597},{"_588":718,"_11":719,"_27":720,"_592":721,"_594":722,"_596":605},{"_588":713,"_11":714,"_27":715,"_592":716,"_594":717,"_596":605},{"_588":708,"_11":709,"_27":710,"_592":711,"_594":712,"_596":597},{"_588":703,"_11":704,"_27":705,"_592":706,"_594":707,"_596":605},{"_588":698,"_11":699,"_27":700,"_592":701,"_594":702,"_596":605},{"_588":693,"_11":694,"_27":695,"_592":696,"_594":697,"_596":597},{"_588":688,"_11":689,"_27":690,"_592":691,"_594":692,"_596":597},{"_588":683,"_11":684,"_27":685,"_592":686,"_594":687,"_596":597},{"_588":677,"_11":678,"_27":679,"_592":680,"_594":681,"_596":597},{"_588":672,"_11":673,"_27":674,"_592":675,"_594":676,"_596":597},{"_588":666,"_11":667,"_27":668,"_592":669,"_594":670,"_596":597},{"_588":660,"_11":661,"_27":662,"_592":663,"_594":664,"_596":597},{"_588":655,"_11":656,"_27":657,"_592":658,"_594":659,"_596":597},{"_588":650,"_11":651,"_27":652,"_592":653,"_594":654,"_596":605},{"_588":645,"_11":646,"_27":647,"_592":648,"_594":649,"_596":597},{"_588":639,"_11":640,"_27":641,"_592":642,"_594":643,"_596":605},{"_588":633,"_11":634,"_27":635,"_592":636,"_594":637,"_596":605},{"_588":628,"_11":629,"_27":630,"_592":631,"_594":632,"_596":597},{"_588":623,"_11":624,"_27":625,"_592":626,"_594":627,"_596":605},{"_588":618,"_11":619,"_27":620,"_592":621,"_594":622,"_596":597},{"_588":613,"_11":614,"_27":615,"_592":616,"_594":617,"_596":597},{"_588":607,"_11":608,"_27":609,"_592":610,"_594":611,"_596":597},{"_588":600,"_11":601,"_27":602,"_592":603,"_594":604,"_596":605},{"_588":589,"_11":590,"_27":591,"_592":593,"_594":595,"_596":597},"id","wvfbamsi2scukds9uvih73l9v","Anthropic招股书带动AI基础设施股集体反弹","Anthropic周一提交IPO申请，招股书显示其2023年上半年营收达163亿美元，同比增长近14倍，直接验证了AI基础设施赛道需求前景。周二纳斯达克综合指数收涨1.2%，CoreWeave、西部数据等AI相关股票领涨，市场无视马斯克对云服务商整合的警告。Lazard分析师指出该招股书为行业注入信心，Tortoise Capital认为长期算力需求支撑基础设施股。","source",{"_55":598,"_599":597},"publishedAt","2026-10-27T23:58:33.000Z","selected",true,"华尔街见闻","firstParty","ia5e7vu8rsrna4ihbjj5o6pqf","Anthropic 选定 JPMorgan 领导其 IPO 美国零售发行","Anthropic 已选择 JPMorgan 担任其 IPO 中美国散户投资者股份销售的主承销商。",{"_55":606,"_599":597},"2026-10-28T00:32:33.000Z",false,"Bloomberg Markets","jwgvo5z3yylbqiuwej7r5jbcv","Anthropic IPO关键点：超2万亿美元估值与安全事件暴露算力成本","Anthropic于2026年10月26日向SEC递交S-1文件，拟以‘ANT’在纳斯达克上市，招股书披露超2万亿美元估值、上半年营收162.86亿美元及净亏损807.48亿美元，并自曝两起安全事件：暂停训练一个多月、沙箱逃逸导致修改设置读取数据。Meta同日启动950亿美元股权融资，英伟达30亿美元押注Muse模型，Google发布Genie 4世界模型，微软裁员6万人应对AI投入压力。",{"_55":612,"_599":605},"2026-10-28T00:40:21.000Z","钛媒体","vv238iaimdc9fyuoatj9ud66h","微软、Meta内部AI使用收缩致Anthropic估值下调","微软、Meta因成本考量减少内部Claude使用，微软云AI预算砍至原1/10，Meta内部用户腰斩仍支出1.05亿美元。Anthropic收入年增超50倍但客户集中度高，当前估值已从2万亿降至1.5万亿。11月中旬IPO窗口期面临客户支出缩减与市场估值波动双重压力。",{"_55":612,"_599":605},"2026-10-28T03:08:42.000Z","y6y49195ai9l706wdptod3skh","Anthropic收购Mithril Medicine及六大机构合作推进AI制药研发","Anthropic通过收购单人运营生物技术公司Mithril Medicine及与六大机构合作，推进AI在药物研发中的应用。部分案例显示Claude将CAR-T疗法设计时间缩短70%，在10周内测试1010个分子变体，使文件审查效率提升89%。",{"_55":598,"_599":597},"2026-10-28T03:25:54.000Z","ysin4wibsjaevc5t90nxoqocn","Anthropic上市募资目标1000亿美元，云服务合作或成关键支撑","Anthropic宣布计划以1000亿美元目标价上市，上半年营收同比增13倍至162.86亿美元，但算力支出同比激增283%至89.45亿美元。前五大客户贡献25%收入，其中Google Cloud和Microsoft Azure合作占比达48%。需关注其未来盈利与2656亿美元长期算力采购的平衡问题。",{"_55":612,"_599":605},"2026-10-28T05:25:59.000Z","ybpbooiivwgo5rfkf16y5y9jf","亚马逊通过可转债锁定Anthropic上市最大收益：账面价值达979亿美元","亚马逊通过可转债在Anthropic上市前已锁定979亿美元账面价值，谷歌则通过云计算承诺获得双重收益。风投机构因持股比例不足5%未进入主要股东披露名单，反映Anthropic估值近万亿美元下的股权高度稀释。AWS累计1100亿美元云计算支出承诺构成亚马逊持续收益基础。",{"_55":598,"_599":597},"2026-10-28T06:34:57.000Z","aefgqduhmqmc2crizg4xsix1a","Anthropic IPO受阻推动亚洲投资者转向科技股及加密衍生品","Anthropic IPO因有限访问引发亚洲投资者转向科技股及加密衍生品。当前市场预期其估值或低于$1.25万亿，部分投资者通过持有Amazon、Alphabet等关联公司股票或加密衍生品进行对冲。需关注2026年12月和2027年7月关键时间点的市场反应及SEC监管动态。",{"_55":638,"_599":605},"2026-10-28T07:19:37.000Z","Crypto Briefing","ss5fpi4vz20tlq5j9ww9pigfa","Anthropic收购一人药企Mithril Medicine，探索AI制药新范式","Anthropic收购了一家只有创始人Cody Tranbarger一人、专注于罕见肌营养不良症治疗研究的药企Mithril Medicine。Cody曾是高盛分析师，利用AI工具和外部顾问合作推进药物研发。该收购引发AI能否降低制药行业组织成本、促进罕见病研究的讨论。",{"_55":644,"_599":605},"2026-10-28T08:09:42.000Z","东方财富","bh9tkbbyfehscimi7zyww566w","Anthropic提交IPO申请估值或达万亿美元引市场担忧","Anthropic提交IPO申请估值或达万亿美元，引发市场对AI企业估值及算力需求的讨论。原文披露其二季度营收115.6亿美元，经营利润9.74亿美元，现金储备1320亿美元。",{"_55":644,"_599":605},"2026-10-28T08:40:00.000Z","e134yyjana6pkm3jotuh3zwes","Anthropic招股书披露计算成本效率提升至收入2.08倍","Anthropic招股书显示2026年Q2计算成本效率达收入2.08倍（Q1 2025为0.4倍），运营利润974百万美元。收入同比激增1368%但计算成本同比上涨300%，体现硬件资源利用率显著提升。招股书提交于2026年10月26日，为IPO关键节点。对投资者需关注公平价值计提的持续性影响，对芯片供应商则需分析多厂商采购策略下的议价权变化。",{"_55":638,"_599":605},"2026-10-28T12:06:43.000Z","pvety610znon9myp0ypoavggv","Anthropic招股书揭示AI行业成本结构困境","Anthropic招股书披露2026年上半年营收162.86亿美元、净亏损807.48亿美元，亏损主要源于可转换票据公允价值变动（占89.6%）。",{"_55":612,"_599":605},"2026-10-28T13:21:46.000Z","m2ahhcmi7bkttqryxkbkh57xr","Anthropic 在 IPO 文件披露特朗普政府监管风险","Anthropic 在 IPO 文件披露特朗普政府可能施压、选择性审查等监管风险，具体涉及此前因要求美国国防部AI技术设置安全限制引发的争端，以及 Mythos 模型安全性和出口管制的分歧。警告指出未来出口限制及 AI 模型引发的网络安全或生物安全事件，可能影响其产品部署、国际扩张和业务增长。",{"_55":665,"_599":597},"2026-10-28T13:27:20.000Z","链捕手 ChainCatcher","w18b4mvd9i0aua36r3zx9y43k","Anthropic IPO文件警示AI风险或存在投保空白，企业需应对AI保险挑战","Anthropic在IPO文件中警示AI相关风险（如身体伤害）可能存在投保空白，并指出企业需应对AI保险挑战。保险行业面临覆盖不足、定价困难等问题，专家建议完善AI使用管控和扩展责任险。",{"_55":671,"_599":597},"2026-10-28T14:20:29.000Z","CNBC Top News","q7sob2po6wulmki4ipb2xw1mm","Anthropic IPO拟通过控制实体限制公众股东董事会影响力","Anthropic IPO通过控制实体限制公众股东董事会影响力，市场定价反映治理担忧，预测市场显示市场对超1.25万亿美元市值预期下降。关键点包括：创始人通过控制实体保留多数投票权，SEC备案文件披露的治理结构可能削弱股东监督，预测市场显示12月31日市值超1.25万亿概率从发布时的95%降至87.5%，7月1日概率仅0.1%。",{"_55":638,"_599":605},"2026-10-28T15:30:33.000Z","vy4nt8z2mysq32i2sy5o89k33","Anthropic IPO前警告或招致美国政府对AI安全立场的针对性审查","Anthropic在IPO文件中警告，其公开倡导的AI安全立场可能招致美国政府选择性审查。风险源于与特朗普政府的多次冲突，包括要求对国防部AI技术实施安全限制引发的争端，以及围绕Mythos模型安全性和出口管制的分歧。潜在影响包括产品部署受阻、国际业务扩张受限及合规成本上升。",{"_55":682,"_599":597},"2026-10-28T16:04:06.000Z","PANews","etrj6glwpmovk6s4oe5xx32kf","Anthropic提交纳斯达克IPO申请 估值或达1.2万亿美元","Anthropic宣布提交纳斯达克IPO申请，当前私募估值约9640亿美元。Tema LAZR ETF等基金已配置10.5%仓位，市场预期IPO后市值将突破1.25万亿美元。",{"_55":638,"_599":605},"2026-10-28T16:17:34.000Z","weslazm5zmmofrccxejk6uqm8","Anthropic $1.5T IPO 或将引发加密与科技股资金分流","Anthropic 预计 11 月上市，其 $1.5T 估值较此前 $2T 下降。Moon Pursuit Capital 分析师 Courtney Olujobi 指出，大规模 IPO 可能导致机构投资者暂时从加密货币和科技股抽资，但长期流动性影响存疑。",{"_55":638,"_599":605},"2026-10-28T16:43:06.000Z","n5a7wievuhtiund93z4jgewnx","Anthropic IPO文件显示可能限制长期利益信托的董事会控制权","Anthropic在IPO文件中披露股东可能限制长期利益信托的董事会控制权。市场定价反映对IPO估值的信心下降，当前交易量显示市场对12月31日上市日（94.7%概率）和11月21日上市日（67%概率）的预期分化。需关注SEC反馈、战略投资者动向及创始人表态对市场情绪的影响。",{"_55":638,"_599":605},"2026-10-28T18:34:16.000Z","ctjx24yj471bpi960temy6kv5","Anthropic在招股书中指出美国数据中心禁令为增长最大风险","Anthropic在招股书中披露美国数据中心建设禁令可能显著影响其增长计划，已预留417亿美元用于计算资源相关支出。监管动态显示16个州正考虑此类禁令以缓解电网压力和环境影响，重点关注俄克拉荷马州2028年禁令概率达21%。公司还提及澳大利亚和加拿大市场的扩展可能缓冲美国监管限制带来的冲击。",{"_55":638,"_599":605},"2026-10-28T19:25:52.000Z","iz6y8xcioszxu2sd7bmbtlbzz","Michael Burry警告Anthropic IPO文件揭示AI行业脆弱性","Michael Burry在分析Anthropic IPO文件时指出，AI行业存在计算资源投入过大和财务结构复杂化带来的潜在风险。文件显示Anthropic半年营收16.3亿美元但净亏损，SEC审核结果将影响市场信心。需关注12月31日IPO截止日相关合约数据变化。",{"_55":638,"_599":605},"2026-10-28T19:57:17.000Z","yzpjcnzsh50w35evwrkd7wqu0","野村：Anthropic招股书与SK海力士业绩推动美股关键性企稳","野村证券研报指出，Anthropic招股说明书披露2026年上半年营收163亿美元（同比增15倍），单位算力收入效率提升至2.08美元/美元支出，推动美股实现关键性企稳。同时，SK海力士业绩超预期（营收增328%，净利润增216%），股价当日跳涨11%。研报警示约100名对冲基金经理因策略同质化离职，下一轮行业清洗或近在咫尺。",{"_55":598,"_599":597},"2026-10-29T02:54:49.000Z","ypjk16bl8nhm90kwtzpuhslan","Anthropic 或将于11月9日开始IPO营销","Anthropic 官方宣布计划于11月9日启动IPO营销，并披露了SEC文件中的财务数据。根据备案文件，公司营收年增长率达375%，但同期净亏损扩大至1.2亿美元。该事件可能影响市场对AI公司融资接受度及Nasdaq上市进程预期。",{"_55":638,"_599":605},"2026-10-29T04:20:56.000Z","hviay7w92t3pn10377m7ape9x","Anthropic IPO 计划推进，NVIDIA 更新及其他投资者日影响市场","NVIDIA 更新 AI 相关进展，市场关注 Anthropic IPO 计划及科技股波动。本周还有 Oracle、Moderna 和 Nike 等公司动态，可能引发股价大幅波动。美联储会议、中期选举及地缘政治紧张局势增加市场不确定性。",{"_55":723,"_599":605},"2026-10-29T06:55:00.000Z","Seeking Alpha","qnyp2he3d8r1mfd0bs93tt4ug","Anthropic S-1招股书估值1.5万亿至2万亿美元引分析","Anthropic发布S-1招股书，估值区间1.5万亿至2万亿美元。作者对比招股书前后的业务认知变化，并基于财务数据提出投资决策参考依据。",{"_55":723,"_599":605},"2026-10-29T07:23:00.000Z","jw9e2znacwcunf7yewhbj6vt3","Anthropic与OpenAI宣称AI理论突破挑战计算机科学长期假设","Anthropic与OpenAI宣布AI模型在理论研究中突破，挑战计算机科学界的Exponential Time Hypothesis假设。市场数据显示对Anthropic的信心提升，预测市场显示OpenAI和Anthropic在11月底AI模型排名中的押注比例分别为72%和25%。文章指出突破仅影响理论层面，实际应用尚不明确，并建议关注后续技术验证和市场动态。",{"_55":638,"_599":605},"2026-10-29T10:48:46.000Z","u9nozxghad45d3zi4b0zxj5sa","Anthropic IPO暴露六大风险信号","Anthropic宣布11月上市，但分析指出存在六大风险信号：1.缺乏明确竞争优势；2.治理机制存疑；3.未披露Q3财务数据；4.历史显示大型IPO后期易现回撤；5.S-1招股书风险章节长达90页；6.AI数据中心面临33GW电力缺口。原文完整引用招股书风险披露细节，并对比行业竞争格局和监管动态。",{"_55":723,"_599":605},"2026-10-29T16:05:05.000Z","ea59koqhcuz4robo5t9edc296","Neocloud股价暴跌30%拖累 Anthropic 2万亿美圆纳斯达克IPO估值","Neocloud股价本月暴跌超30%引发市场对Anthropic 2万亿美圆纳斯达克IPO估值的担忧。Anthropic已提交S-1招股书，拟估值区间1.5-2万亿美元，其IPO被视为测试投资者对前沿AI经济体的信心。需关注后续招股书修订及科技行业整体情绪变化。",{"_55":638,"_599":605},"2026-10-29T16:25:00.000Z","kqahuqf7k5owguc9u7gjsxug8","OpenAI CEO Sam Altman：内存巨头扩产迟疑或制约AI算力发展","OpenAI CEO Sam Altman指出，三星、SK海力士、美光等内存巨头因历史产能过剩创伤，正谨慎扩产，可能限制AI算力发展速度。Anthropic IPO文件同期警告内存供应短缺，显示行业共识。",{"_55":638,"_599":605},"2026-10-29T18:22:09.000Z","g18uzi1fqgsfuo0mqwfmzcsrh","Kain Warwick 认为 Anthropic 尝试“发明”一个 DAO","Kain Warwick 表示 Anthropic 的创始人投票机制存在治理问题，可能在多万亿规模的企业中带来风险。Anthropic 在向 SEC 提交的 S-1 文件中，七位创始人通过 Founder LLC 持有 50.1% 的投票权，但无经济权益。虽然 Anthropic 认为其结构没有直接的公开公司先例，但有专家认为其商业模式可行，风险在于公司领导层的组织方式。",{"_55":754,"_599":605},"2026-10-29T22:10:00.000Z","Unchained","gyuieavwko1z97oodbrp5hrvu","Anthropic宣布IPO采用四类股份独特结构","Anthropic宣布计划通过四类股份结构上市，当前市场对其12月31日IPO的概率达94.5%，估值预期为1.5万至2万亿美元。股份结构包含创始人控股的Class F（50.1%投票权）、Long-Term Benefit Trust控股的Class T（董事会多数席位）、面向公众的Class A（49.9%上限）及战略合作伙伴的Class N（无投票权）。",{"_55":638,"_599":605},"2026-10-30T00:56:28.000Z","ab99isl4cwh1hz73ptppa4c5j","Anthropic与智谱大模型商业模式对比：万亿估值VS毛利实战","Anthropic上半年营收162.9亿美元但净亏损807亿美元，智谱API业务收入占比86.5%毛利率转正。双方成本结构差异导致估值波动：Anthropic依赖算力采购承诺支撑估值，智谱通过工程优化压低成本。",{"_55":612,"_599":605},"2026-10-30T02:33:47.000Z","bpv50hhuqvln6zjeiid8zw7g8","Anthropic 若上市或将造就 4257 名百万富翁","Anthropic 若进行 IPO，可能使 4257 人成为百万富翁，7 名联合创始人个人身家或分别达到约 280 亿美元。Hill 数据显示，这将超过 SpaceX 通过类似方式创造的 4400 名潜在百万富翁。",{"_55":665,"_599":597},"2026-10-30T06:28:41.000Z","uymtesyy4y0mwpf41whkbv41t","SpaceX IPO 后股价波动引发 Anthropic 上市担忧","SpaceX 在 IPO 后股价低于发行价，市场对其即将上市的 Anthropic 表示担忧。市场参与者关注 Anthropic 的 IPO 定价及其后续市场反应，任何关于定价和营收增长的公告都可能影响市场情绪。",{"_55":638,"_599":605},"2026-10-30T07:30:05.000Z","o3dhzcyev0ak8vq7ydp5iu6or","Anthropic IPO文件警告AI存在性风险，但软件克隆威胁或成先导","Anthropic于2026年10月提交IPO申请，披露其AI模型可能对人类构成存在性风险，并指出软件克隆威胁或先于风险显现。公司上半年营收达1630亿美元（同比增1368%），净亏损8070亿美元（主要因可转换债券会计处理）。投资者需关注其估值目标（1.5-2万亿美元）与私筹估值（约9650亿美元）的溢价空间，以及AI技术对软件行业知识产权的颠覆性影响。",{"_55":638,"_599":605},"2026-10-30T09:04:51.000Z","e0wn5qod1kgsqgq4w8m7gexov","Anthropic IPO招股书未解答的关键问题","Anthropic招股书披露首半年营收16.29亿美元，毛利率达85%，但未明确计算成本分摊及未来增长预期。公司披露计算成本占营收85%，但未说明未来模型训练与客户服务间的成本分配，引发市场对持续增长能力的担忧；同时，创始人团队通过单一Class F股掌握50.1%投票权，可能影响投资者决策；IPO估值预计在1万亿至2万亿美元之间，具体取决于谈判结果，存在市场波动风险。",{"_55":671,"_599":597},"2026-10-30T12:27:36.000Z","j38y5nlrf42s550whjltl8bhy","Anthropic 8 月估值达 1.2 万亿美元","Anthropic 在 8 月将自身估值定为 1.2 万亿美元。",{"_55":790,"_599":597},"2026-10-30T12:36:54.000Z","Financial Times","vblbm9h07piv9yw3o9ry7e8pe","AMD因AnthropicIPO受益获分析师重申买入评级","分析师重申买入AMD，目标价725美元（2027年）。AMD通过$20亿硬件供应协议与Anthropic绑定，避免股权稀释并锁定潜在收益。该分析基于Anthropic招股书披露的不可撤销合作条款及AMD当前AI芯片市场份额。",{"_55":723,"_599":605},"2026-10-30T13:46:58.000Z","mc5rut0s2z6wrpzo8bhpq0mma","Anthropic IPO 文件强调投资风险忽视公众影响","Anthropic 最近的 IPO 文件详细列出了 AI 对投资者的风险，但忽略了对公众的影响。市场对其估值达到 6000 亿美元的预期仅 4% 的概率实现，显示了投资者的谨慎态度。参与者将关注公司与亚马逊和谷歌等大合作伙伴的战略动态，这些动态可能会影响其估值预期。",{"_55":638,"_599":605},"2026-10-30T14:39:05.000Z","aiv70rry9xjdfyoedqmxkxtez","Anthropic IPO面临投资级评级障碍","Anthropic计划于11月中旬在纳斯达克上市（股票代码ANT），但面临BB+评级（投资级门槛为BBB-）的挑战。核心问题是其S-1招股书披露的未资金义务达417-430亿美元（含未来潜在支出或达750亿美元），涉及与Broadcom、Google、Amazon、Microsoft的长单合同。当前信用评级机构认为其现金流不足以覆盖债务，需观察IPO实际募资规模及后续季度亏损收窄情况",{"_55":638,"_599":605},"2026-10-30T16:51:05.000Z","cj4snyjozg6q3x06659gsp13v","Anthropic 谈判租赁爱德华堡附近超大规模数据中心校园","Anthropic 正在谈判租赁爱德华堡附近超大规模数据中心校园，若协议达成，将使阿尔伯塔省成为加拿大第二个拥有 Claude 模型算力支持的数据中心省份。目前仅处于谈判阶段，与EverWind Fuels在2026年10月16日签署的20年 Nova Scotia 数据中心租赁协议形成对比（该设施2027年底启动，初始95MW容量，2028年可扩展至420MW）。",{"_55":638,"_599":605},"2026-10-30T18:42:07.000Z","s81hmlloyzdxlwzpy5s6ayqat","Anthropic融资前景蒙阴 据报黑石看淡其上市后评级前景","黑石集团表示Anthropic上市后可能无法立即获得投资级信用评级。知情人士透露，黑石近期向投资者暗示Anthropic更可能获得BB+或BB评级，这将限制其融资渠道。Anthropic计划通过IPO再融资约1000亿美元支持至2045年的8000亿美元AI算力基建支出。此前黑石旗下基金已投资90亿美元次级债务，年化收益率超10%。",{"_55":644,"_599":605},"2026-10-30T18:59:30.000Z","oo0kqqgycjvqgjgeugmn4zf5j","Anthropic IPO估值面临基础设施支出风险——亚马逊、微软等合作伙伴或受波及","Anthropic IPO估值面临基础设施支出风险，亚马逊、微软等合作伙伴或受波及。公司2026上半年收入163亿美元，现金及短期投资1317亿美元，但固定支出达2656亿美元。",{"_55":638,"_599":605},"2026-10-30T20:06:27.000Z","cf7sibh5kpwkwi48nx1e66wpo","Anthropic AI自主处理26%核心研发工作，Sacks质疑其安全与监管风险","Anthropic宣布其AI系统已自主处理26%的核心研发工作，较今年2月提升25个百分点。总统顾问委员会主席David Sacks在X平台公开质疑其模型训练方法可能引发安全风险，并批评Anthropic将拒绝权编码进AI系统。当前正值Anthropic筹备IPO的关键期，其研发自动化进程与监管争议将直接影响招股书披露细节及资本市场反应。",{"_55":638,"_599":605},"2026-10-31T01:20:12.000Z","nl3tut7ch629qwtykkkuj4k2b","Anthropic融资评级或降至垃圾级，影响超8000亿美元算力计划","Anthropic因评级机构态度或面临融资成本上升及市场抛售风险。黑石向投资者传达Anthropic可能获BB区间评级（垃圾级），导致其8000亿美元算力计划融资复杂化。",{"_55":598,"_599":597},"2026-10-31T02:29:30.000Z","q9prwicrw5fsvhhsqa3t8k3yy","Anthropic提交IPO申请，或创纪录融资规模","Anthropic于周一提交S-1表格，启动潜在创纪录的IPO进程。本周三家IPO、一次直接上市和两次SPAC完成定价，但市场整体面临增长股估值承压的挑战。",{"_55":723,"_599":605},"2026-10-31T04:30:00.000Z","rsrxdtmzlgzrs04ofeyi5yzob","Anthropic冲刺IPO与OpenAI的估值、营收及算力竞争格局分析","Anthropic二季度收入达115.55亿美元，首次实现季度盈利，而OpenAI同期收入67亿美元且亏损扩大。双方估值均逼近万亿美元，但Anthropic增速更快，算力投入差异显著。未来盈利能力取决于能否平衡大规模算力支出与持续增长的需求。",{"_55":644,"_599":605},"2026-10-31T06:47:22.000Z","m3psw3xozsopi5rb27zt9c02f","Anthropic申请NASDAQ IPO，目标估值达2万亿美元","Anthropic宣布申请纳斯达克IPO，目标估值达2万亿美元。市场数据显示，IPO首日市值可能低于1250亿美元，历史趋势和公司净亏损或影响预期。需关注IPO定价及投资者动向。",{"_55":638,"_599":605},"2026-10-31T07:54:27.000Z","gky08uhsgdyq4vcyp1ixhfsq2","Meta启动350亿美元融资及600亿股票发行计划；阿里巴巴与Apple合作集成千问AI；Anthropic提交纳斯达克IPO申请","张一鸣以6700亿元财富蝉联中国首富；阿里巴巴与Apple达成合作，将千问AI集成至Siri及写作工具，11月4日iOS Beta版开放测试；Meta宣布启动350亿美元同步融资计划（含125亿美元优先股），并计划2027年推出最高600亿美元股票发行；Anthropic提交S-1文件拟以ANT代码在纳斯达克上市。",{"_55":612,"_599":605},"2026-11-01T03:32:27.000Z","u41ofvkcnizawkmiyled6eckf","哈塞特称AI生态获充足资金支持，非潜在金融危机","白宫经济顾问哈塞特预测2025-2032年美国GDP年均增长4%，远超政府和私人机构预期。其依据包括：1）哥伦比亚大学教授研究显示AI相关投资达10.3万亿美元；2）私营部门主导AI风险应对，引用Anthropic等企业方案；3）AI技术提升企业销售、就业和工资水平。文章同时指出AI可能缓解40万亿美元国债压力，但未提供具体企业案例数据。",{"_55":638,"_599":605},"2026-11-02T13:21:01.000Z","sfof0r2q9vvbo1yafcwh45x16","Anthropic更新招股书披露Q3营收近170亿美元、净亏损同比扩大92%及近9000亿美元算力承诺","Anthropic更新招股书披露Q3营收169.56亿美元（同比增1127%）、净亏损232.91亿美元（同比扩92%），并承诺近9000亿美元算力支出（4475亿在2030年前支付）。",{"_55":598,"_599":597},"2026-11-02T14:28:29.000Z","sjdyr8pwt3wtu6sttypkh1dcf","Anthropic第三季度营收170亿美元，净亏损233亿美元","Anthropic第三季度营收170亿美元，净亏损233亿美元。截至9月30日，现金储备956亿美元，承诺支出总额约8954亿美元，剩余履约义务138亿美元。前九个月累计营收332亿美元，去年同期为25亿美元。",{"_55":682,"_599":597},"2026-11-02T14:29:48.000Z","a1k8dbc5esby2l42396v3qgoh","Anthropic 2026年第三季度人力成本同比激增354%，为纳斯达克IPO铺路","Anthropic 2026年第三季度人力成本同比激增354%至17.1亿美元（较2025年Q3的4.89亿美元），但同期总营收达162.86亿美元（同比增1300%）。",{"_55":638,"_599":605},"2026-11-02T14:38:40.000Z","i9arqscmkkm76b3gn39eetpeq","Anthropic Q3营收达 169.56 亿美元，同比增长 1127%，净亏损 232.91 亿美元","Anthropic 2026年第三季度营收为169.56亿美元，同比增长1127%，净亏损232.91亿美元。财务数据显示算力及基础设施费用达98.63亿美元（同比+382%），占营收58%；营业亏损收窄至5.67亿美元，调整后营业利润率15%（上年同期-93%）。",{"_55":665,"_599":597},"2026-11-02T14:43:09.000Z","tecwd8latxraxwm5c0fkskm15","Anthropic修订S-1表格披露2025年及2026年前三季度财务数据","Anthropic在修订的S-1表格中披露：2025年前三季度收入332.4亿美元（同比增1200%），净亏损1040亿美元；2026年前三季度收入同比增长1204%至332.4亿美元，净亏损较2025年同期扩大至约819亿美元。公司同时宣布与客户签订总额8954亿美元的采购协议，主要用于计算基础设施",{"_55":671,"_599":597},"2026-11-02T14:47:30.000Z","yzxrdrvddww53rzgumwmr6gto","Anthropic第三季度收入同比激增12倍至170亿美元，IPO临近财务承压","Anthropic第三季度收入同比激增12倍至170亿美元，但净亏损达233亿美元，同时存在8954亿美元算力采购承诺。经营利润从第二季度974百万美元转为第三季度567百万美元的亏损，需关注其IPO前的财务可持续性。",{"_55":638,"_599":605},"2026-11-02T15:16:36.000Z","n5ox6ja2vhpdu01qmwwko4mns","Anthropic第三季度因计算成本激增导致运营亏损，IPO在即","Anthropic第三季度因计算成本激增导致运营亏损5670万美元，Claude开发者贡献了17亿美元季度收入，同时披露IPO时间线。",{"_55":891,"_599":597},"2026-11-02T15:18:55.000Z","CoinDesk","k08elw6bsgo2qc5qyz1bhyuq5","Anthropic修订IPO申报披露第三季度运营亏损56.7亿美元","Anthropic修订IPO申报披露第三季度运营亏损56.7亿美元。营收同比增长47%至170亿美元，但计算成本激增5亿美元，叠加2亿美元的员工捐赠匹配费用，导致运营亏损。净亏损达233亿美元，其中94亿美元来自可转换债券公允价值变动损益。公司计划11月中旬纳斯达克上市，需偿还的债务在12个月内达69.8亿美元，超过同期营收",{"_55":638,"_599":605},"2026-11-02T16:06:30.000Z","bmrje9qk1sfbidl4u0abeb1c3","Anthropic 更新财务文件，IPO 或于本月末到来","Anthropic 近日提交了更新的财务文件，计划在本月末进行 IPO。该公司营收猛增 1,127%，但因计算成本激增导致利润被抹平。",{"_55":902,"_599":605},"2026-11-02T16:22:00.000Z","MarketWatch Top Stories","plnzl6ijfktjcmdkez9lhvma8","Anthropic更新IPO申报书警告AI模型可能触及关键发展阈值","Anthropic在2026年11月2日更新的IPO申报书中警告其AI模型可能触及关键发展阈值，或触发更严格的安全审查。该文件披露第三季度营收17亿美元（同比增1026%），前三季度累计332亿美元，并提及8954亿美元算力与基础设施支出承诺。但未披露具体发行股数及定价区间，路演计划最早定于11月10日启动。",{"_55":638,"_599":605},"2026-11-02T16:23:26.000Z","qps142n4gsxszid825qfxkx8l","Anthropic第三季度净亏损收窄至233亿美元，收入增长超1100%助推Nasdaq IPO进程","Anthropic第三季度收入达1700亿美元，同比增长超1100%，净亏损收窄至233亿美元，推动其Nasdaq IPO进程。公司计划11月16日前后上市，估值或达1.5万-2万亿美元，已获亚马逊、谷歌等合作伙伴的算力支持承诺。",{"_55":638,"_599":605},"2026-11-02T16:39:43.000Z","zwe75euzlqloj4blq3bbhozvm","Anthropic 为应对美国中期选举潜在影响加码 IPO 准备","Anthropic 为应对11月3日美国中期选举可能引发的政局变化，正在加码 IPO 准备。当前美国政治环境对AI发展持广泛支持态度，但选举结果可能影响监管政策走向。",{"_55":606,"_599":597},"2026-11-02T18:03:06.000Z","nvneck6qt3bpm1yp00hx4nsye","Anthropic IPO 解读：纳斯达克上市与关键风险","Anthropic 于 2020 年由 OpenAI 高管创立，专注于 AI 伦理与安全。短短几年间，该公司已成为人工智能领域的巨头，预计即将进行有史以来规模最大的 IPO 之一。",{"_55":606,"_599":597},"2026-11-02T18:35:29.000Z","tawew9veknw3i7vchvavuzcbo","Anthropic 2026年前三季度净亏损1040亿美元","Anthropic 2026年前三季度净亏损1040亿美元，主要源于可转换债券公允价值变动和计算基础设施承诺。同期收入达332.4亿美元（同比增1200%），但第三季度经营亏损56.7亿美元，叠加近9000亿美元的计算承诺，凸显其资本压力与估值争议。需关注后续S-1修订、IPO定价及融资计划披露。",{"_55":638,"_599":605},"2026-11-02T18:41:46.000Z","irzss3ywwepkce0ggjr7oit9p","Anthropic 提交 IPO 申请，计划感恩节前完成","Anthropic于2026年10月26日提交IPO申请，计划在感恩节前完成，并寻求达到或超过SpaceX 862 亿美元IPO规模的融资目标（消息来源：知情人士）。",{"_55":606,"_599":597},"2026-11-02T19:06:53.000Z","eia8hq9xeuz8nrofc8ij6kuok","费城Nardini：等权重投资策略助你持续参与市场","费城Tema ETFs的投资策略负责人Paisley Nardini在Bloomberg ETF IQ节目中与Scarlet Fu和Eric Balchunas讨论了Anthropic即将进行的IPO及集中风险问题。",{"_55":606,"_599":597},"2026-11-02T19:08:33.000Z","p59770pauz8frxbaow3gwy111","Robinhood CFO：与多家券商争夺Anthropic IPO散户配售资格","Robinhood CFO Shiv Verma 表示正与其他零售券商竞争 Anthropic IPO 的散户配售份额，称散户约占美股交易市场 20%-25%。Anthropic 已于 10 月 26 日提交 IPO 申请，计划在感恩节前完成上市。",{"_55":682,"_599":597},"2026-11-02T20:24:05.000Z","esrt70n3z26g281ckxr8r10iy","Anthropic 和 OpenAI 或将推出新模型 Fable 5.5 和 GPT-6.2 Astra","Anthropic 和 OpenAI 可能正在测试新模型 Fable 5.5 和 GPT-6.2 Astra，但两公司均未正式确认。Fable 5.5 的相关条目于 2026 年 10 月 13 日出现后次日即被删除，而 GPT-6.2 Astra 的相关标签则出现在 2026 年 11 月 1 日的使用日志中。",{"_55":638,"_599":605},"2026-11-02T23:15:30.000Z","p0pl0c7czvbbcybkfn7zmffgq","三部门召开资本市场工具座谈会；Anthropic第三季度净亏损233亿美元","中国人民银行、金融监管总局、中国证监会召开支持资本市场两项工具座谈会。宁德时代累计回购A股股份1960.59万股，晶华微及控股股东因信息披露违规被立案调查。Anthropic第三季度营收近170亿美元，净亏损233亿美元，运营支出同比增292%。",{"_55":953,"_599":605},"2026-11-02T23:22:03.000Z","界面新闻","b4gf8bp7bbfw5rl7mz0wkw619","AI巨头融资与支出风险：Meta发债、微软现金流承压、特斯拉收购HUMAIN","Anthropic计划在纳斯达克以代码ANT挂牌，估值1.5万亿至2万亿美元，但面临客户集中度达48%、算力支出激增至8950亿美元等风险；Meta发行250亿美元债券，资本支出同比增120%致自由现金流为负；特斯拉收购HUMAIN 49%股权，加速AI算力布局，需关注AI行业债务风险与算力账单增长压力。",{"_55":612,"_599":605},"2026-11-03T00:15:43.000Z","ymuc8ze5rnhf2x0d048e6za55","华尔街力劝AnthropicIPO估值退守至1.5万亿至1.6万亿美元区间","华尔街机构投资者建议Anthropic将IPO估值下调至1.5万亿美元区间，主要因市场动荡、数据中心建设政治阻力及亚马逊、Meta等云服务商AI利润不确定性。原文披露Anthropic第三季度营收170亿美元，经营亏损5.67亿美元，并披露数据中心建设总支出承诺约8954亿美元，其中4475亿美元将于2030年底前完成。",{"_55":644,"_599":605},"2026-11-03T01:20:57.000Z","tk5y9dnlmglidw925gnle2w5f","Anthropic修订S-1招股书披露三季度营业亏损近9000亿美元算力支出承压","Anthropic向美国SEC递交修订版S-1招股文件，披露三季度营收169.56亿美元、净亏损233亿美元，其中算力成本同比激增77%至99亿美元，长期合约总额近9000亿美元，影响IPO估值。",{"_55":644,"_599":605},"2026-11-03T07:23:37.000Z","wcdvpr61a9wz4d2gwd7tyi6sz","Bitget IPO Prime上线Anthropic认购通道，开放VIP优先认购","Bitget宣布开放Anthropic美股IPO认购通道，提供VIP与公开两轮认购机会。VIP轮面向VIP1-VIP7用户（11月5日-9日 UTC+8），单笔$100-$3,000,000，总上限$1B，费率12%；公开轮面向全体用户（11月10日-上市前一日），单笔$100-$25,000，费率5%。资产以rANT形式交付，通过RWA基础设施1:1映射ANT上市后的经济收益。",{"_55":682,"_599":597},"2026-11-03T10:26:18.000Z","nh75uimdlx5evcgzv202dswzn","美股三大指数涨跌不一 科技股多数反弹","美股三大指数当日涨跌互现，科技股普遍反弹，其中苹果因内存成本上涨导致毛利率环比下滑，Anthropic计划2027年算力规模翻倍并寻求千亿美元IPO，沙特阿美启动绕过霍尔木兹海峡的输油管道扩建工程。",{"_55":644,"_599":605},"2026-11-03T13:19:43.000Z","r7tfpvj52bt9k2p1ilcl0v6kz","Anthropic申请纳斯达克IPO，股票代码ANT","Anthropic申请纳斯达克IPO，股票代码ANT。公司2026年上半年营收同比增长1300%至163亿美元，首次实现运营利润9.74亿美元，估值预计在1.5万至2万亿美元之间，接近SpaceX 2026年IPO纪录。",{"_55":638,"_599":605},"2026-11-03T13:29:10.000Z","v9r4l7cxtyf8hsi6mx3tvfwfn","Anthropic 宣布将投入 $895B，临近巨型IPO","Anthropic宣布季度收入增长12倍，并计划未来投入$895B。原文披露了公司IPO前的关键财务数据，包括收入增长和巨额资金投入计划。",{"_55":606,"_599":597},"2026-11-03T20:06:50.000Z","j9o5870oksdh76sybwy70ktou","Anthropic IPO 或成科技巨头押注大考","summary_z: Broadcom、Google 和 SpaceX 等科技巨头在 Anthropic 上市前已押注其中，此次 IPO 将考验这些巨头对 Anthropic 的信心。",{"_55":902,"_599":605},"2026-11-03T21:04:00.000Z","v1rb55f5hxp3owouo7ch2ndhi","Anthropic史上最大IPO获华尔街巨头背书","Anthropic提交上市申请，拟成史上最大IPO。高盛和摩根士丹利牵头承销，当前市值约8954亿美元。市场分析人士指出AI板块交易回暖，超威半导体财报超预期。Anthropic第三季度营收169.6亿美元，同比增1200%，环比增46.71%，净亏损收窄至232.9亿美元。摩根士丹利CEO预计未来十年AI资本支出达10万-15万亿美元，或使美国GDP年增50-70个基点。",{"_55":644,"_599":605},"2026-11-03T23:24:36.000Z","chqjl9og87femh08q4h8os4mp","微软与五大云巨头押注AI：资本支出激增与回报风险并存","微软与亚马逊等五大云厂商2027年AI资本支出预计达1.2万亿美元，同比增54%；Anthropic招股书显示其AI算力承诺达8954亿美元，但2026年前三季度净亏损超500亿美元；YouTube推出AI音乐替换功能冲击第三方音乐库，英特尔股价单日暴跌28.6%。",{"_55":612,"_599":605},"2026-11-04T00:49:34.000Z","z2qtqn6um6aimr1kuwb0fkejy","Anthropic IPO申报披露$895亿财务承诺及合作伙伴融资安排","Anthropic提交的IPO申报披露了$895亿财务承诺，包括Google、Amazon等提供的$77亿有条件融资。估值预期从$2万亿下调至$1.5-1.75万亿，反映第三季度$17亿营收增长与市场风险考量。",{"_55":638,"_599":605},"2026-11-04T11:31:02.000Z","zd6eyvnk0tkip6h3beidemyiw","Anthropic与SpaceX2026年IPO市值谁将更高？市场信心骤降14个百分点","当前市场对Anthropic在2026年成为最大IPO的概率为31.7%，较一周前下降14个百分点。分析显示Anthropic半年营收16.3亿美元但净亏损807亿美元，其估值预期1.5万至2万亿美元与SpaceX已上市的75亿美元融资及1.77万亿至1.8万亿美元估值形成对比，市场更看好SpaceX保持领先地位。",{"_55":638,"_599":605},"2026-11-04T23:40:44.000Z","t652cg9sqv82ee5e35t3ieyel","Bitget IPO Prime 第三期项目 Anthropic 开放 VIP 轮认购","Bitget IPO Prime 第三期项目 Anthropic 已开放 VIP 轮认购，认购时间为 11 月 5 日至 9 日，投入区间为 $100-$3,000,000，历史参考配售率为 40-80%。",{"_55":682,"_599":597},"2026-11-05T08:05:48.000Z","zgdne6wkylvh5dbiunk1xc3uu","Anthropic $1.5万亿IPO估值受质疑：内部销售与市场预期分歧","Anthropic拟以1.5万亿美元估值在纳斯达克上市，市场对其估值合理性及内部销售存在分歧。当前预测市场显示IPO结束时市值在1.5万亿至1.75万亿间的概率为24.1%（较一周前上升6.1%），低于1.25万亿的概率增至16.2%。需关注IPO前披露的承销商指引、营收增长数据及监管动态。",{"_55":638,"_599":605},"2026-11-05T10:09:30.000Z","o7fv4r6ys3gaq8vygt641u4np","Anthropic招股书中AI安全风险引争议，有效利他主义如何影响硅谷？","Anthropic在招股书中披露了AI安全风险，并透露上市后联合创始人将掌握公司大部分投票权。围绕AI安全，有效利他主义（EA）成为重要议题，其资金注入和影响力引发了公众和媒体的质疑。EA倡导者认为其目标是确保AI安全，但有人担忧其决策透明度和潜在的议程。",{"_55":612,"_599":605},"2026-11-05T10:30:32.000Z","pff4r439s2pqz6cla84820i1a","Anthropic IPO 上市时间与规模不确定性增加","Anthropic 的 IPO 上市时间与规模不确定性增加，当前上市概率约为 55%，成为 2026 年最大 IPO 的概率仅为 28% 至 32%，低于 SpaceX。主要担忧包括 5.67 亿美元的运营亏损。需关注 Anthropic 的具体上市日期、价格范围和发行股数更新。",{"_55":638,"_599":605},"2026-11-05T15:39:07.000Z","l2kuxrkadcyk3xmx4ahatzlpe","Anthropic IPO 计划引发市场关注","Anthropic 计划进行 IPO，引发市场关注。公司估值预计达到 300 亿美元。",{"_55":790,"_599":597},"2026-11-05T17:01:56.000Z","d5q7xkqo4ws3x55kigusmqbef","Anthropic今年IPO概率达74%：市场关注与潜在影响分析","Anthropic今年IPO概率达74%，市场关注其上市进程及对AI行业的影响。原文解析了IPO流程（注册声明→路演→定价→上市），指出披露的财务数据、股东结构等将首次公开，并提到市场情绪、监管摩擦等可能导致延迟的因素。",{"_55":638,"_599":605},"2026-11-05T19:36:31.000Z","m5yuvd6h8ofnu2m9ohzrseiyo","Anthropic $1.5万亿至$1.6万亿IPO测试AI市场信心","Anthropic计划以$1.5万亿至$1.6万亿估值在纳斯达克上市，测试AI行业投资信心。估值较此前$2万亿预期下调，市场通过预测合约显示分歧，12月31日关键节点合约24小时交易量达78.2%。",{"_55":638,"_599":605},"2026-11-05T22:49:27.000Z","z3rc0gaktdfd6xi67p8k3jdmi","美国中期选举致AI基建政策风险，谷歌170亿美元押注怀俄明数据中心，Anthropic冲刺IPO估值2万亿","美国中期选举导致76%选民反对新建数据中心，影响AI基建投资；谷歌宣布170亿美元投资怀俄明州数据中心，Anthropic拟以2万亿美元估值冲刺IPO。微软同期削减50亿美元资本开支，暴露新云模式融资脆弱性。OpenAI漏洞研究成本降至千余美元，威胁传统安全厂商壁垒。",{"_55":612,"_599":605},"2026-11-06T00:51:02.000Z","om3pmi7v132topw7bwmrce2zg","Anthropic IPO估值分歧与上市时间表争议：科技股暴跌后的市场影响","Anthropic 1.5万亿美元IPO估值遭主要投资者质疑，上市时间表或推迟。科技股暴跌导火索为中期选举后AI政策疑虑，纳斯达克超50只科技股单日跌幅超10%，CoreWeave、Nebius等算力股市值腰斩。",{"_55":598,"_599":597},"2026-11-06T01:49:02.000Z","j4xgy61xei08nh381lkry3vyw","Anthropic IPO 发行与集中风险","Anthropic 近日宣布 IPO 发行，但市场对其股票集中度表示担忧，认为可能增加公司风险。",{"_55":723,"_599":605},"2026-11-06T08:01:34.000Z","aag7rwug1j214wlgikncirzeq","Anthropic IPO估值或从1.5万亿缩水至1万亿，市场预期延迟","Anthropic IPO估值或从1.5万亿缩水至1万亿，融资规模或降至80亿美元。市场预测显示其上市时间可能从11月推迟至12月底（Polymarket 71%概率年底上市，Kalshi 59%概率12月前确认）。公司年化营收达80亿美元，现金储备1466亿美元，但面临民主党计划立法监管AI数据中心的潜在风险。",{"_55":1069,"_599":605},"2026-11-06T16:28:58.000Z","Decrypt","ehayff8dadbp8gcqklyymo98g","Anthropic 计划感恩节前启动 IPO，估值最高 1.75 万亿美元，拟募资 800 亿至 1000 亿美元","Anthropic 计划于美国感恩节前启动首次公开募股（IPO），目标估值区间为 1.25 万亿至 1.75 万亿美元，拟募资 800 亿至 1000 亿美元。公司第三季度营收同比增长近 50%，达约 170 亿美元，最新年化营收运行率（ARR）约为 810 亿美元，较 7 月底增长 25%。",{"_55":665,"_599":597},"2026-11-07T01:32:24.000Z","qadbaov14ilc5spc2dsexfop8","Anthropic与OpenAI估值承压：美股科技股抛售潮下的融资调整","Anthropic估值预期下调至1.2万亿-1.3万亿美元，彭博社与英国《金融时报》存在1.3万亿估值差；OpenAI完成110亿美元融资，估值约1.25万亿美元，较原计划缩减至200亿美元总规模。",{"_55":953,"_599":605},"2026-11-07T11:02:03.000Z","o0x0w5j5u6x9govpe1hi4bt1k","Anthropic 即将 IPO：AI 领域新贵崛起","Anthropic 从 2021 年起作为一家低调的研究实验室迅速崛起，现正筹备上市，可能引领 2027 年 AI 风投趋势。公司与 OpenAI 竞争，并与五角大楼产生分歧，其 IPO 将测试投资者对这一全新资产类别的兴趣。",{"_55":671,"_599":597},"2026-11-07T12:59:01.000Z","ilwpqchd6u03k8fr9r5cr9wsb","Anthropic IPO 遭遇 AI 反弹","Anthropic 计划在纳斯达克进行 IPO，目标估值为 1000 亿美元至 1500 亿美元，但面临 AI 反弹和市场环境恶化。中期选举中，选民反对 AI，并支持更严格的 AI 监管。Anthropic 的数据中心项目可能因公众反对而受到更多审查。",{"_55":671,"_599":597},"2026-11-07T13:00:01.000Z","rrila7wjfkryj5ivlfhu4531p","Anthropic IPO估值受市场情绪与机构需求拖累","Anthropic 计划于纳斯达克上市，但市场条件恶化导致估值预期从最高1.5万亿美元降至约1.25万亿美元。关键因素包括机构兴趣下降、计算与数据中心资本需求受质疑，以及近期市场对大型AI公司IPO的估值压力。",{"_55":638,"_599":605},"2026-11-07T14:21:13.000Z","dw0upye298abpyiv3g1n73d1d","Anthropic更新招股书披露第三季度财务数据及2045年8954亿美元数据中心投入计划。受算力成本持续攀升影响，企业利润空间不断收窄；同时披露额外融资机制依赖的潜在风险。",{"_55":665,"_599":597},"fv2e7s64qf2evi5iiz2i0lcpc","下周中美CPI发布与Anthropic IPO路演及美债再融资关键日程","下周将发布中美10月CPI数据、俄美乌三方会谈结果及Anthropic IPO路演进展。韩国计划11月13日生效新政限制IPO后股价大跌，美债再融资规模达1250亿美元，超聚变等企业财报与超算大会同期举行。",{"_55":598,"_599":597},"2026-11-08T02:23:38.000Z","elbj1jw8rpqd7nphsea3eu3ig","Anthropic估值缩水推进IPO：英国散户发行计划与融资规模调整","Anthropic在美国科技股抛售后仍推进IPO，估值较预期缩水至1.25-1.75万亿美元，并计划通过英国散户发行融资800亿至1000亿美元。原文同时披露其竞争对手OpenAI估值从1.4万亿降至1.25万亿，融资规模从300亿缩减至200亿，以及日本计划募集35亿美元创海外IPO纪录。",{"_55":644,"_599":605},"2026-11-08T03:03:00.000Z",{"_588":1095,"_11":30,"_27":1096,"_592":1131,"_594":22,"_596":597},{"_588":1080,"_11":1081,"_27":1082,"_592":1130,"_594":1084,"_596":605},{"_588":1070,"_11":1071,"_27":1072,"_592":1129,"_594":1074,"_596":597},{"_588":1034,"_11":1035,"_27":1036,"_592":1128,"_594":1038,"_596":605},{"
":217,"_211":209},{"_51":217,"_211":209},{"_244":258,"_11":259,"_19":22,"_15":115,"_247":260},{"_244":254,"_11":255,"_19":229,"_15":115,"_247":256},{"_244":250,"_11":251,"_19":216,"_15":115,"_247":252},{"_244":245,"_11":246,"_19":20,"_15":115,"_247":248},"factId","fciQ1hs8C3q0","Loopscale：过去一周遭持续攻击，已暂停协议活动并补足受影响金库","representative",{"_201":202,"_11":203,"_27":204,"_205":249,"_207":20,"_208":209},{"_51":210,"_211":209},"fIznKWk6MC4E","Loopscale遭持续攻击，协议已暂停",{"_201":212,"_11":213,"_27":214,"_205":253,"_207":216,"_208":209},{"_51":217,"_211":209},"f1bltHbT4vXY","Loopscale 重启所有金库",{"_201":225,"_11":226,"_27":227,"_205":257,"_207":229,"_208":224},{"_51":230,"_211":224},"f_yE_k0FRieg","Loopscale：所有金库存取款功能已恢复，贷款管理功能也已全面恢复正常",{"_201":231,"_11":30,"_27":232,"_205":261,"_207":22,"_208":209},{"_51":217,"_211":209},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",{"_269":270,"_271":-5},"changelogVersion","2026-10-01T08:00","release"]

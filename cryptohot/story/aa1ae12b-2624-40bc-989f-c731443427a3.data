[{"_1":2,"_3":4},"root",{"_5":82},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","aa1ae12b-2624-40bc-989f-c731443427a3","title","西安银行收购陕西洛南村镇银行并设立8家县域支行","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-08T04:00:19.000Z","latestAt","digest","西安银行完成收购陕西洛南阳光村镇银行，获批设立8家县域支行。收购标的上半年亏损565万元，不良贷款率同比上升2.3个百分点，且存在四大股东股权质押冻结问题。低分红方案引发原股东与收购方对剩余股权价值的争议【新】。该交易旨在拓展县域金融服务能力，但标的财务压力与股东纠纷可能影响后续整合效果。","digestUpdatedAt","2026-11-08T04:52:18.118Z","summary","excerpt","latest","西安银行并购陕西洛南阳光村镇银行获批，设立8家县域支行","latestReport",{"_59":60},"whyHot",{"_76":16,"_77":16,"_78":16,"_79":80,"_81":-5},"developments",[69],"officialReports",[],"timeline",[58],"heat",[53],"related",[],"topics",[45,46],{"_47":51,"_49":52},{"_47":48,"_49":50},"slug","earnings","name","财报","regulation","监管与政策",{"_54":55,"_39":56,"_57":16},"hour","2026-11-08T05:00:00.000Z",9.7,"participants",{"_59":60,"_11":28,"_25":61,"_62":63,"_64":19,"_65":66},"id","qo01436spv3pcjhkusv902upl","西安银行获监管批准收购陕西洛南阳光村镇银行，设立8家县域支行。收购标的财务基本面承压，上半年亏损565万元，不良贷款率上升。同时，四大股东股权质押冻结，低分红方案引发股东争议。","source",{"_49":67,"_68":66},"publishedAt","selected",false,"界面新闻","firstParty",{"_70":71,"_11":72,"_18":19,"_15":16,"_73":74},"factId","faBAhJtqI-KU","西安银行收购陕西洛南阳光村镇银行并设立8家县域支行","representative",{"_59":60,"_11":28,"_25":61,"_62":75,"_64":19,"_65":66},{"_49":67,"_68":66},"participants48h","newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_83":84,"_85":-5},"changelogVersion","2026-10-01T08:00","release"]

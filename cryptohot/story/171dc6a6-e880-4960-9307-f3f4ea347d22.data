[{"_1":2,"_3":4},"root",{"_5":93},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","171dc6a6-e880-4960-9307-f3f4ea347d22","title","孙宇晨回应景某财产纠纷案申请移至陕西省高院审理","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-08T01:19:00.000Z","latestAt","digest","孙宇晨针对与景某的三千余万财产纠纷案，宣布已准备申请将案件由陕西省高级人民法院审理，并称网友‘愿意为景某付款的人’可加入起诉名单【新】。该纠纷源于双方此前公开的资产争议，陕西省高院管辖权可能涉及争议标的物所在地或法律适用问题。目前网友对孙宇晨‘拉群起诉’的表述存在分歧，部分人质疑其扩大诉讼范围的实际意图，但尚未有法院正式受理或驳回该申请的公开信息。","digestUpdatedAt","2026-11-08T01:53:08.744Z","summary","excerpt","latest","孙宇晨回应与景某财产纠纷：申请案件由陕西省高级人民法院审理","latestReport",{"_68":69},"whyHot",{"_88":16,"_89":16,"_90":16,"_91":78,"_92":-5},"developments",[81],"officialReports",[79],"timeline",[67],"heat",[53,54,55,56],"related",[],"topics",[45,46],{"_47":51,"_49":52},{"_47":48,"_49":50},"slug","regulation","name","监管与政策","bitcoin","比特币 / BTC",{"_57":65,"_39":66,"_60":16},{"_57":63,"_39":64,"_60":16},{"_57":61,"_39":62,"_60":16},{"_57":58,"_39":59,"_60":16},"hour","2026-11-08T05:00:00.000Z",9,"participants","2026-11-08T04:00:00.000Z",9.3,"2026-11-08T03:00:00.000Z",9.5,"2026-11-08T02:00:00.000Z",9.8,{"_68":69,"_11":28,"_25":70,"_71":72,"_73":19,"_74":75},"id","nv5a3tsdxfkfanwbxxphxzme0","孙宇晨因三千余万元财产争议提起民事诉讼，已准备将案件移至陕西省高级人民法院审理。针对网友表示“愿意为景甜付款的人大有人在”，孙宇晨回应称可以一起加到起诉书里。","source",{"_49":76,"_77":78},"publishedAt","selected",false,"PANews","firstParty",true,{"_68":69,"_11":28,"_25":70,"_71":80,"_73":19,"_74":75},{"_49":76,"_77":78},{"_82":83,"_11":84,"_18":19,"_15":16,"_85":86},"factId","f_33H19YgplE","孙宇晨回应与景某相关财产纠纷案：已准备申请案件由陕西省高级人民法院审理","representative",{"_68":69,"_11":28,"_25":70,"_71":87,"_73":19,"_74":75},{"_49":76,"_77":78},"participants48h","newParticipants6h","recentReports24h","observationComplete","rank",{"_94":95,"_96":-5},"changelogVersion","2026-10-01T08:00","release"]

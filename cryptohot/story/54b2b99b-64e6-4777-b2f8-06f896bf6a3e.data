026-11-05T23:00:00.000Z",3.7,"2026-11-05T22:00:00.000Z",3.9,"2026-11-05T21:00:00.000Z",4,"2026-11-05T20:00:00.000Z",4.1,"2026-11-05T19:00:00.000Z",4.2,"2026-11-05T18:00:00.000Z",4.3,"2026-11-05T17:00:00.000Z",4.5,"2026-11-05T16:00:00.000Z",4.6,"2026-11-05T14:00:00.000Z",4.9,"2026-11-05T13:00:00.000Z",5,"2026-11-05T12:00:00.000Z",5.1,"2026-11-05T11:00:00.000Z",5.3,"2026-11-05T10:00:00.000Z",5.5,"2026-11-05T09:00:00.000Z",5.6,"2026-11-05T08:00:00.000Z",5.8,"2026-11-05T05:00:00.000Z",6.3,"2026-11-05T03:00:00.000Z",6.7,"2026-11-05T02:00:00.000Z",6.9,"2026-11-04T17:00:00.000Z",8.9,"2026-11-04T16:00:00.000Z",9.2,{"_218":291,"_11":30,"_27":292,"_222":293,"_224":22,"_225":240},{"_218":286,"_11":287,"_27":288,"_222":289,"_224":290,"_225":240},{"_218":280,"_11":281,"_27":282,"_222":283,"_224":284,"_225":240},{"_218":275,"_11":276,"_27":277,"_222":278,"_224":279,"_225":226},{"_218":270,"_11":271,"_27":272,"_222":273,"_224":274,"_225":240},{"_218":265,"_11":266,"_27":267,"_222":268,"_224":269,"_225":226},{"_218":259,"_11":260,"_27":261,"_222":262,"_224":263,"_225":240},{"_218":254,"_11":255,"_27":256,"_222":257,"_224":258,"_225":240},{"_218":248,"_11":249,"_27":250,"_222":251,"_224":252,"_225":240},{"_218":242,"_11":243,"_27":244,"_222":245,"_224":246,"_225":226},{"_218":235,"_11":236,"_27":237,"_222":238,"_224":239,"_225":240},{"_218":229,"_11":230,"_27":231,"_222":232,"_224":233,"_225":226},{"_218":219,"_11":220,"_27":221,"_222":223,"_224":20,"_225":226},"id","zduulywhd7jttlig7eoy07er2","美联储加息预期修正：非农数据或引发市场重新定价","美国非农就业数据超预期，可能延迟美联储降息周期至2027年。数据显示10月新增就业31.1万，远超预期，同时薪资年化增速稳定在3.3%。作者对比FOMC会议纪要与当前经济指标，认为若11月数据延续强劲，12月加息概率将降至50%。分析覆盖美元指数、美债收益率及纳斯达克成分股波动率变化。","source",{"_54":227,"_228":226},"publishedAt","selected",false,"MarketWatch Top Stories","firstParty","xx9zo86sv7yktynys4aqte33g","美国10月非农就业报告发布：分析对美联储加息的影响","美国10月非农就业报告显示新增就业5.9万人，失业率维持4.2%。报告延续2025年1月至2026年9月平均月增3.5万、7个月负增长的低迷趋势。道琼斯调查显示，市场对美联储12月加息25基点的概率为68.7%。先锋集团经济学家Adam Schickling指出若新增就业超10万且失业率降至4.1%，可能推高2027年一季度加息预期。",{"_54":234,"_228":226},"2026-11-06T05:16:11.000Z","东方财富","yez79ws4rxkbeoh7j3xogie88","美股遭遇AI崩盘冲击 非农报告或成美联储12月加息关键依据","美国10月非农就业报告发布在即，高盛预测新增就业7.5万人，或为美联储12月加息提供依据，但市场因AI交易崩盘已承压。报告显示失业率或微降至4.1%，薪资增速跌破3%，同时期权市场隐含波动率升至1.45%创年内新高，标普500期货潜在抛售规模达74.8亿美元。",{"_54":241,"_228":240},"2026-11-06T06:30:25.000Z",true,"华尔街见闻","juob71huuxd85ut4j17gcovqz","美国财政部交易员对10月就业报告预期乐观","美国财政部交易员对10月就业报告预期乐观，预计新增59,000岗位（较9月29,000增长104%），失业率维持4.2%。当前市场将12月加息概率定价至44%，并预期2027年前5年期美债收益率跌破4.10%。",{"_54":247,"_228":226},"2026-11-06T09:02:17.000Z","Crypto Briefing","o0vwxs1z34rmw952gvo1t7fxe","美国10月非农就业人口增加16.5万人，失业率降至4.1%","美国劳工统计局发布10月非农就业数据，新增16.5万人（预期6.5万），失业率降至4.1%。9-10月数据累计修正+8.4万人，医疗、商业服务及运输行业贡献显著。",{"_54":253,"_228":240},"2026-11-06T13:30:22.000Z","PANews","kpq0fm3wc3y97qgfkdiz3m1i0","美国10月非农就业人数远超预期 交易员押注美联储12月加息","美国10月非农就业人数增加16.5万，超预期推动市场押注美联储12月加息。失业率4.1%低于预估，现货黄金跌1.15%至4041.89美元/盎司，白银涨0.33%至51.95美元/盎司，10年期美债收益率涨6.3个基点至4.898%。美联储官员哈马克与巴尔金均释放渐进加息信号，强调抑制通胀需提高短期借贷成本。",{"_54":234,"_228":226},"2026-11-06T13:30:40.000Z","x8t5xy7jehnehkbavedub645t","美国10月新增就业人数远超预期","美国劳工部数据显示，2026年10月新增就业人数达16.5万，失业率意外降至4.1%。但作者指出，12月加息可能性取决于下周的通胀数据及股市表现。",{"_54":264,"_228":240},"2026-11-06T13:31:54.000Z","CoinDesk","ewkcvjyi1zzjpqqqvtss9863p","美国10月非农就业激增16.5万，推动美联储12月加息概率升至70%","美国10月非农就业人数激增16.5万，失业率意外降至4.1%，平均时薪同比增速达3.1%。数据公布后，2年期美债收益率涨至4.54%，10年期升至4.87%，利率期货显示12月加息概率升至70%。",{"_54":241,"_228":240},"2026-11-06T14:42:41.000Z","dzul0ssxwzujdiotsfe0d8mla","美联储12月加息概率升至85%，华尔街分析AI资产抛售或成政策变量","美联储12月加息概率升至85%，华尔街分析AI资产抛售或成政策变量关键因素。美国10月非农就业新增16.5万人，失业率降至4.1%，平均时薪环比涨0.4%。报告显示2026年以来第三高月度增幅，8-9月数据合计上修8.4万人。尽管就业市场强劲，但能源价格波动、AI投资前景及股市波动仍可能影响加息决策。",{"_54":241,"_228":240},"2026-11-06T16:15:08.000Z","nkapqbcmfo9pe4uhqiamnszw2","美联储戴利重申加息立场 科技股调整凸显政策不确定性","美联储主席戴利重申加息立场，指出通胀控制仍是首要任务。科技股近期因AI需求前景波动调整，就业数据显示10月新增非农就业16.5万，失业率4.1%，但工资增长落后于物价上涨，实际购买力承压。戴利强调需综合评估经济变量，政策调整将保持审慎渐进。",{"_54":234,"_228":226},"2026-11-06T20:16:30.000Z","o5p3u97ebd92xhaqha0dr4es4","美联储12月加息概率升至八成，非农数据超预期引华尔街热议","美国10月非农就业人数增16.5万，失业率降至4.1%，推动市场预期美联储12月加息概率升至八成以上。华尔街机构认为该数据为加息提供依据，但能源价格、通胀走势及AI资产抛售仍可能影响最终决策。",{"_54":285,"_228":240},"2026-11-07T02:26:06.000Z","链捕手 ChainCatcher","rercw901d8x7w6eotgqrvsp4d","美股周五技术性反弹：非农数据引爆12月加息概率至85%","美股周五因非农数据超预期引发技术性反弹，但市场对12月加息概率升至85%的担忧仍存。报告显示10月新增就业16.5万（超预期7万）、失业率4.1%（优于预期）、薪资同比升3.1%，推动2年期美债收益率跳升7基点至4.54%。",{"_54":241,"_228":240},"2026-11-07T02:32:07.000Z","q8u9gyvnzjmyselkr0lvuilfd","10月美国非农就业新增16.5万，失业率降至4.1%，推动市场对12月美联储加息概率预期从约三分之二升至76%-79%。需关注CPI、PCE等通胀指标及美联储官员表态对市场预期的影响。",{"_54":247,"_228":226},{"_218":286,"_11":287,"_27":288,"_222":303,"_224":290,"_225":240},{"_218":280,"_11":281,"_27":282,"_222":302,"_224":284,"_225":240},{"_218":265,"_11":266,"_27":267,"_222":301,"_224":269,"_225":226},{"_218":259,"_11":260,"_27":261,"_222":300,"_224":263,"_225":240},{"_218":248,"_11":249,"_27":250,"_222":299,"_224":252,"_225":240},{"_54":253,"_228":240},{"_54":264,"_228":240},{"_54":241,"_228":240},{"_54":285,"_228":240},{"_54":241,"_228":240},{"_315":356,"_11":357,"_19":22,"_15":158,"_318":358},{"_315":352,"_11":353,"_19":290,"_15":158,"_318":354},{"_315":348,"_11":349,"_19":284,"_15":158,"_318":350},{"_315":344,"_11":345,"_19":279,"_15":158,"_318":346},{"_315":340,"_11":341,"_19":269,"_15":158,"_318":342},{"_315":336,"_11":337,"_19":263,"_15":158,"_318":338},{"_315":332,"_11":333,"_19":258,"_15":158,"_318":334},{"_315":329,"_11":249,"_19":252,"_15":158,"_318":330},{"_315":325,"_11":326,"_19":246,"_15":158,"_318":327},{"_315":321,"_11":322,"_19":233,"_15":158,"_318":323},{"_315":316,"_11":317,"_19":20,"_15":158,"_318":319},"factId","fE_SpeHglHaQ","政策发布","representative",{"_218":219,"_11":220,"_27":221,"_222":320,"_224":20,"_225":226},{"_54":227,"_228":226},"faPlv5tf5RCo","美国10月非农就业报告预计不会影响美联储12月利率决议",{"_218":229,"_11":230,"_27":231,"_222":324,"_224":233,"_225":226},{"_54":234,"_228":226},"fBkoaMvrlkq4","市场参与者预期10月就业报告可能带来潜在收益，联邦储备可能不会在12月加息",{"_218":242,"_11":243,"_27":244,"_222":328,"_224":246,"_225":226},{"_54":247,"_228":226},"fHUuDnFvjv1c",{"_218":248,"_11":249,"_27":250,"_222":331,"_224":252,"_225":240},{"_54":253,"_228":240},"fupoq0zqWIVA","美国10月非农就业人数远超市场预期",{"_218":254,"_11":255,"_27":256,"_222":335,"_224":258,"_225":240},{"_54":234,"_228":226},"fWcis-tKQb8Q","U.S. added 165,000 jobs in October, blowing past 65,000 esti",{"_218":259,"_11":260,"_27":261,"_222":339,"_224":263,"_225":240},{"_54":264,"_228":240},"fSRXBVT4ELJo","美国10月非农就业数据全面超预期",{"_218":265,"_11":266,"_27":267,"_222":343,"_224":269,"_225":226},{"_54":241,"_228":240},"foxB2zdoCjFw","美联储戴利仍倾向进一步收紧政策",{"_218":275,"_11":276,"_27":277,"_222":347,"_224":279,"_225":226},{"_54":234,"_228":226},"f9L-Vova8ezA","美国10月非农就业数据强于预期",{"_218":280,"_11":281,"_27":282,"_222":351,"_224":284,"_225":240},{"_54":285,"_228":240},"fV0P2DUUZ_4Y","周五美股反弹",{"_218":286,"_11":287,"_27":288,"_222":355,"_224":290,"_225":240},{"_54":241,"_228":240},"f4I6fDXqFNXo","October jobs report intensifies speculation about December F",{"_218":291,"_11":30,"_27":292,"_222":359,"_224":22,"_225":240},{"_54":247,"_228":226},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",8,{"_368":369,"_370":-5},"changelogVersion","2026-10-01T08:00","release"]

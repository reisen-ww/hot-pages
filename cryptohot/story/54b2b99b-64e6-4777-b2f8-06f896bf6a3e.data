[{"_1":2,"_3":4},"root",{"_5":367},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":-5,"_28":-5,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46},"publicId","54b2b99b-64e6-4777-b2f8-06f896bf6a3e","title","美国10月非农激增推动加息概率飙升至85% 美联储强调审慎渐进","status","active","reportCount",13,"sourceCount",7,"firstReportAt","2026-11-04T13:00:00.000Z","latestAt","2026-11-07T13:21:07.000Z","digest","美国劳工统计局发布10月非农就业新增16.5万（超预期7万）、失业率降至4.1%（优于预期0.1%），推动市场对美联储12月加息概率从68.7%（华尔街见闻）或76%-79%（Crypto Briefing）大幅推高至85%（MarketWatch）或76%-79%（Crypto Briefing）。\n\n数据修正显示8-9月非农累计上修+8.4万，医疗、商业服务及运输业贡献显著，但薪资年化增速仅3.1%（低于CPI增速），旧金山联储戴利称需综合评估通胀、就业及科技股波动风险。\n\n市场分歧集中在：1）CME概率68.7%与实际新增16.5万（远低于早前预期的59万，东方财富/CoinDesk）；2）美债5年期收益率跌破4.10%（反映降息预期，但美元指数和纳斯达克波动率仍受加息路径影响，PANews/华尔街见闻）。","digestUpdatedAt","2026-11-07T21:14:04.696Z","summary","excerpt","latest","10月美国非农就业激增推动美联储12月加息概率升至76%-79%","latestReport",{"_218":291},"whyHot",{"_360":117,"_361":362,"_363":158,"_364":240,"_365":366},"developments",[304,305,306,307,308,309,310,311,312,313,314],"officialReports",[294,295,296,297,298],"timeline",[205,206,207,208,209,210,211,212,213,214,215,216,217],"heat",[70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112],"related",[66],"topics",[47,48,49,50,51,52],{"_53":64,"_54":65},{"_53":62,"_54":63},{"_53":60,"_54":61},{"_53":58,"_54":59},{"_53":56,"_54":57},{"_53":5,"_54":55},"slug","name","数据发布","inflation","通胀与就业","fed","美联储 / Fed","crypto-market","行情异动","regulation","监管与政策","rates","利率与流动性",{"_9":67,"_11":68,"_69":43},"f659fae1-538a-4b52-a875-69ae8fde8198","美联储维持利率不变但减少会议频次，市场对12月加息预期升温","relation",{"_113":203,"_41":204,"_116":158},{"_113":201,"_41":202,"_116":158},{"_113":199,"_41":200,"_116":158},{"_113":197,"_41":198,"_116":158},{"_113":195,"_41":196,"_116":158},{"_113":193,"_41":194,"_116":158},{"_113":191,"_41":
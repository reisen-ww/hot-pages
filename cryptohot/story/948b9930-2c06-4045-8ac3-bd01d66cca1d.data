[{"_1":2,"_3":4},"root",{"_5":124},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":21,"_22":23,"_24":25,"_26":-5,"_27":-5,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45},"publicId","948b9930-2c06-4045-8ac3-bd01d66cca1d","title","乌克兰前员工盗取HLG代币被判5年，索赔被拒因证据不足","status","active","reportCount",3,"sourceCount","firstReportAt","2026-11-08T00:16:48.000Z","latestAt","2026-11-08T04:19:06.000Z","digest","法国巴黎刑事法院于2026年11月8日判处乌克兰籍前员工Vitaliy K.五年监禁（含两年实刑），因其在2024年5月至8月间非法修改HLG代币铸造规则并盗取1亿枚代币（价值约14万美元）。法院驳回了Holograph Foundation的赔偿诉求，认定代币价格犯罪前已暴跌至$0.001且无法证明直接因果关系【新】。此前报道称被盗10亿枚代币（价值140万美元），但新证据显示实际盗取量为1亿枚，且代币价格在犯罪期间已大幅缩水【旧】【新】。","digestUpdatedAt","2026-11-08T04:24:46.217Z","summary","excerpt","latest","Holograph Foundation前员工非法铸造1亿HLG代币被判五年","latestReport",{"_75":93},"whyHot",{"_118":16,"_119":16,"_120":16,"_121":86,"_122":123},"developments",[101,102,103],"officialReports",[97,98],"timeline",[72,73,74],"heat",[54,55,56,57,58],"related",[],"topics",[46,47],{"_48":52,"_50":53},{"_48":49,"_50":51},"slug","security","name","安全事件","regulation","监管与政策",{"_59":70,"_40":71,"_62":65},{"_59":68,"_40":69,"_62":65},{"_59":66,"_40":67,"_62":65},{"_59":63,"_40":64,"_62":65},{"_59":60,"_40":61,"_62":16},"hour","2026-11-08T05:00:00.000Z",27.3,"participants","2026-11-08T04:00:00.000Z",18,2,"2026-11-08T03:00:00.000Z",18.6,"2026-11-08T02:00:00.000Z",19.1,"2026-11-08T01:00:00.000Z",19.7,{"_75":93,"_11":29,"_26":94,"_79":95,"_81":21,"_82":83},{"_75":87,"_11":88,"_26":89,"_79":90,"_81":91,"_82":86},{"_75":76,"_11":77,"_26":78,"_79":80,"_81":19,"_82":83},"id","u3kv8jz4fqrf63as1a4izthfq","法国男子因非法增发并盗取 10 亿枚 HLG 代币被判刑 5 年","法国巴黎刑事法院判处一名乌克兰籍男子 5 年监禁，其中 2 年实刑，因在 2024 年 5 月至 8 月期间利用权限漏洞非法生成并盗取 10 亿枚 Holograph（HLG）代币，案发时价值约 1,400 万美元。其两名同伙分别被判 2 年监禁及罚款。","source",{"_50":84,"_85":86},"publishedAt","selected",false,"链捕手 ChainCatcher","firstParty",true,"jxodcdnbz6j6vzznn2clu9drn","Holograph前员工盗取10亿枚HLG代币被判5年有期徒刑","法国巴黎刑事法院判处Holograph前员工5年有期徒刑，因其在2024年5月至8月间非法创建并盗取10亿枚HLG代币（当时价值约1400万美元）。法院驳回了Holograph Foundation的赔偿请求，认为缺乏直接因果证据。",{"_50":92,"_85":86},"2026-11-08T00:33:47.000Z","PANews","a0coyij1u6ou1fkkyml6xhkzh","Holograph Foundation前员工Vitaliy K.因非法修改HLG代币铸造规则并盗取1亿枚代币（当时价值约$14M）被判五年监禁，其中两年实服并处罚款60万欧元。法院驳回基金会索赔请求，认定代币价格在犯罪前已暴跌至$0.001。Holograph Foundation目前处于清算状态，该案例显示传统刑法规制可追溯加密从业者。",{"_50":96,"_85":83},"Crypto Briefing",{"_75":87,"_11":88,"_26":89,"_79":100,"_81":91,"_82":86},{"_75":76,"_11":77,"_26":78,"_79":99,"_81":19,"_82":83},{"_50":84,"_85":86},{"_50":92,"_85":86},{"_104":114,"_11":115,"_18":21,"_15":106,"_107":116},{"_104":110,"_11":111,"_18":91,"_15":106,"_107":112},{"_104":105,"_11":77,"_18":19,"_15":106,"_107":108},"factId","fuS6_GT7A8Jo",1,"representative",{"_75":76,"_11":77,"_26":78,"_79":109,"_81":19,"_82":83},{"_50":84,"_85":86},"f_YJlC79KIPM","前员工因非法创建并盗取10亿枚HLG代币被判处5年有期徒刑",{"_75":87,"_11":88,"_26":89,"_79":113,"_81":91,"_82":86},{"_50":92,"_85":86},"fJoLctX_jQzw","巴黎法院判处前Holograph基金会员工五年监禁",{"_75":93,"_11":29,"_26":94,"_79":117,"_81":21,"_82":83},{"_50":96,"_85":83},"participants48h","newParticipants6h","recentReports24h","observationComplete","rank",6,{"_125":126,"_127":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":231},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":-5,"_28":-5,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46},"publicId","7842f4cc-4839-4f47-9536-869f77f1b623","title","Gnosis Pay系统升级期间遭黑客入侵致5.5万用户数据泄露","status","active","reportCount",8,"sourceCount",7,"firstReportAt","2026-11-06T14:34:02.000Z","latestAt","2026-11-07T21:43:47.000Z","digest","Gnosis Pay在2026年11月3日系统升级期间遭黑客入侵，导致约5.5万用户信用卡信息、地址及账户号泄露，但资金安全未受影响【新】【旧】。公司称检测后两小时内启动处置流程，包括更换受影响用户安全凭证、修复漏洞及邮件通知客户【新】【旧】。事件影响范围包括个人支付卡数据及关联加密钱包信息（如Rotki创始人Lefteris Karapetsas的完整家庭地址、卡号及钱包地址被泄露【新】【旧】），但企业平台（为金融科技公司提供白标卡服务）未受影响，原定2026年12月20日退役的旧系统提前终止【新】【旧】【新】。第三方数据显示其日均活跃卡持有人约2400人，24小时内交易额263200美元【新】。目前攻击手法及数据是否被滥用的调查尚未公开【新】【旧】。","digestUpdatedAt","2026-11-08T00:33:29.850Z","summary","excerpt","latest","Gnosis Pay 消费卡系统遭未授权访问：客户信息泄露","latestReport",{"_124":171},"whyHot",{"_224":18,"_225":226,"_227":192,"_228":141,"_229":230},"developments",[181,182,183,184,185,186,187,188],"officialReports",[175,176,177],"timeline",[116,117,118,119,120,121,122,123],"heat",[62,63,64,65,66,67,68,69,70,71,72,73,74,75,76,77,78],"related",[58],"topics",[47,48,49],{"_50":56,"_52":57},{"_50":54,"_52":55},{"_50":51,"_52":53},"slug","stablecoin","name","稳定币","crypto-market","行情异动","security","安全事件",{"_9":59,"_11":60,"_61":43},"1b1bcca0-8c0c-4010-ab38-a922b0532aba","Gnosis Pay安全漏洞致用户隐私数据泄露","relation",{"_79":114,"_41":115,"_82":99},{"_79":112,"_41":113,"_82":99},{"_79":110,"_41":111,"_82":99},{"_79":108,"_41":109,"_82":99},{"_79":106,"_41":107,"_82":99},{"_79":104,"_41":105,"_82":99},{"_79":102,"_41":103,"_82":99},{"_79":100,"_41":101,"_82":99},{"_79":97,"_41":98,"_82":99},{"_79":95,"_41":96,"_82":18},{"_79":93,"_41":94,"_82":18},{"_79":91,"_41":92,"_82":18},{"_79":89,"_41":90,"_82":18},{"_79":87,"_41":88,"_82":18},{"_79":85,"_41":86,"_82":18},{"_79":83,"_41":84,"_82":18},{"_79":80,"_41":81,"_82":18},"hour","2026-11-08T05:00:00.000Z",29.4,"participants","2026-11-08T04:00:00.000Z",30.3,"2026-11-08T03:00:00.000Z",31.2,"2026-11-08T02:00:00.000Z",32.1,"2026-11-08T01:00:00.000Z",33,"2026-11-08T00:00:00.000Z",34,"2026-11-07T23:00:00.000Z",35,"2026-11-07T22:00:00.000Z",36,"2026-11-07T21:00:00.000Z",26.9,6,"2026-11-07T20:00:00.000Z",27.6,"2026-11-07T19:00:00.000Z",28.5,"2026-11-07T18:00:00.000Z",29.3,"2026-11-07T17:00:00.000Z",30.1,"2026-11-07T16:00:00.000Z",31,"2026-11-07T15:00:00.000Z",31.9,"2026-11-07T14:00:00.000Z",32.9,"2026-11-07T13:00:00.000Z",33.8,{"_124":171,"_11":30,"_27":172,"_128":173,"_130":22,"_131":132},{"_124":165,"_11":166,"_27":167,"_128":168,"_130":169,"_131":132},{"_124":159,"_11":160,"_27":161,"_128":162,"_130":163,"_131":132},{"_124":153,"_11":154,"_27":155,"_128":156,"_130":157,"_131":132},{"_124":147,"_11":148,"_27":149,"_128":150,"_130":151,"_131":132},{"_124":142,"_11":143,"_27":144,"_128":145,"_130":146,"_131":132},{"_124":135,"_11":136,"_27":137,"_128":138,"_130":139,"_131":132},{"_124":125,"_11":126,"_27":127,"_128":129,"_130":20,"_131":132},"id","ou0kaphezmxukj2qit3qf6e0p","Rotki 创始人称 Gnosis Pay 泄露其个人信息","Rotki 创始人分享的通知截图显示，Gnosis Pay 在 11 月 3 日未经授权访问了消费者卡系统，但企业计划未受影响。","source",{"_52":133,"_134":132},"publishedAt","selected",false,"The Defiant","firstParty","ydt06tf2g6lnjwmd7i4w9pcfs","Gnosis Pay消费者卡系统遭数据泄露，用户资金未受影响","Gnosis Pay消费者卡系统于11月3日遭未授权访问导致客户信息泄露，用户资金未受影响。团队在检测后两小时内开始处置，已更换受影响的安全凭证并修复漏洞；支持其所有白标卡项目的企业平台未受影响。",{"_52":140,"_134":141},"2026-11-06T14:57:40.000Z","PANews",true,"t6mvg4545sqj2bcahbetwu1nu","Gnosis Pay 确认消费者信用卡系统遭入侵","Gnosis Pay 确认其消费者信用卡系统遭入侵，但未透露受影响客户数量。公司表示资金和企业平台未受影响。",{"_52":133,"_134":132},"2026-11-06T15:01:29.000Z","z9oxweng69olz22bmulr5i6co","Gnosis Pay 数据泄露暴露客户地址","Gnosis Pay 发布白标稳定币卡片的公司宣布，其系统在11月3日遭到未经授权访问，导致某些客户信息暴露，包括姓名、地址和账户参考号。其他用户如Rotki创始人Lefteris Karapetsas表示其信息包括完整家庭地址、姓名、卡号及关联钱包地址。Gnosis Pay原计划在今年年底停止使用该系统。",{"_52":152,"_134":132},"2026-11-06T16:05:38.000Z","Protos","flge1x47p2qmxmeksfrt4lyv0","Gnosis Pay 宣布黑客入侵导致客户数据泄露","Gnosis Pay 宣布黑客于11月3日入侵其发卡系统，导致客户数据泄露但未影响资金安全。公司已强制启用3D Secure验证，并通知受影响用户。该事件是加密行业近期多起安全漏洞的案例之一，包括币安6.4亿美元交易所黑客攻击、Coinbase分析供应商数据泄露等。消费者平台原定于12月20日退役，企业平台（为金融科技公司提供白标卡服务）未受影响。",{"_52":158,"_134":132},"2026-11-06T16:41:29.000Z","Decrypt","ww615sq2ljo2qaqhfunvnh66n","Gnosis Pay 数据泄露暴露客户信息但资金未受影响","Gnosis Pay 披露其旧借记卡系统在 11 月 3 日遭未经授权访问导致数据泄露，但客户资金安全无虞。",{"_52":164,"_134":141},"2026-11-06T18:58:58.000Z","The Block","ohey58mfkkegtc53avsfnwctx","Gnosis Pay因安全漏洞泄露客户支付卡信息及加密钱包数据","Gnosis Pay因安全漏洞导致客户支付卡信息、地址及加密钱包数据泄露。公司已更换受影响凭证并强制启用3D Secure验证，计划在12月20日前退役旧系统。第三方数据显示其日均活跃卡持有人约2400人，24小时内交易额263200美元。",{"_52":170,"_134":132},"2026-11-06T20:51:23.000Z","Cointelegraph","ouo4ua5x49jna2hh3r2bo0zb9","Gnosis Pay 披露其消费卡系统于 11 月 3 日遭未授权访问，客户姓名、住址及加密货币钱包地址等信息泄露，公司已更换凭证并修复漏洞。",{"_52":174,"_134":141},"链捕手 ChainCatcher",{"_124":171,"_11":30,"_27":172,"_128":180,"_130":22,"_131":132},{"_124":159,"_11":160,"_27":161,"_128":179,"_130":163,"_131":132},{"_124":135,"_11":136,"_27":137,"_128":178,"_130":139,"_131":132},{"_52":140,"_134":141},{"_52":164,"_134":141},{"_52":174,"_134":141},{"_189":220,"_11":221,"_19":22,"_15":192,"_193":222},{"_189":216,"_11":217,"_19":169,"_15":192,"_193":218},{"_189":212,"_11":213,"_19":163,"_15":192,"_193":214},{"_189":208,"_11":209,"_19":157,"_15":192,"_193":210},{"_189":204,"_11":205,"_19":151,"_15":192,"_193":206},{"_189":200,"_11":201,"_19":146,"_15":192,"_193":202},{"_189":196,"_11":197,"_19":139,"_15":192,"_193":198},{"_189":190,"_11":191,"_19":20,"_15":192,"_193":194},"factId","fHzHHv5m2GcA","Rotki Founder Reports Unauthorized Access to Consumer-Card S",1,"representative",{"_124":125,"_11":126,"_27":127,"_128":195,"_130":20,"_131":132},{"_52":133,"_134":132},"fXLW5x6UzEH8","Gnosis Pay消费者卡系统遭数据泄露",{"_124":135,"_11":136,"_27":137,"_128":199,"_130":139,"_131":132},{"_52":140,"_134":141},"fRy_wcMXsFUo","Gnosis Pay 确认消费者卡系统遭入侵",{"_124":142,"_11":143,"_27":144,"_128":203,"_130":146,"_131":132},{"_52":133,"_134":132},"fPi5cCanJFeU","Gnosis Pay数据泄露暴露客户地址",{"_124":147,"_11":148,"_27":149,"_128":207,"_130":151,"_131":132},{"_52":152,"_134":132},"fRemSQ0zyfhw","Gnosis Pay 客户数据被黑客访问",{"_124":153,"_11":154,"_27":155,"_128":211,"_130":157,"_131":132},{"_52":158,"_134":132},"fJxkFV2LwunU","Gnosis Pay data breach exposes customer info",{"_124":159,"_11":160,"_27":161,"_128":215,"_130":163,"_131":132},{"_52":164,"_134":141},"fEQZNRhipkvI","Gnosis Pay 安全漏洞暴露客户支付卡详情和个人数据",{"_124":165,"_11":166,"_27":167,"_128":219,"_130":169,"_131":132},{"_52":170,"_134":132},"fCEHY3JEOsbg","Gnosis Pay 消费卡系统遭未授权访问：客户姓名住址及钱包地址泄露",{"_124":171,"_11":30,"_27":172,"_128":223,"_130":22,"_131":132},{"_52":174,"_134":141},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",3,{"_232":233,"_234":-5},"changelogVersion","2026-10-01T08:00","release"]

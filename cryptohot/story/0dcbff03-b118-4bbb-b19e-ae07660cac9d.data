[{"_1":2,"_3":4},"root",{"_5":160},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":-5,"_28":-5,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46},"publicId","0dcbff03-b118-4bbb-b19e-ae07660cac9d","title","OKX强制暂停MEXC USDT转入致账户冻结，行业分歧源于FinCEN模糊标准","status","active","reportCount",5,"sourceCount",4,"firstReportAt","2026-11-07T23:06:07.000Z","latestAt","2026-11-08T01:42:24.000Z","digest","OKX要求用户暂停从MEXC转入USDT，部分账户已出现冻结及调查案例。OKX未采纳FinCEN提供的30天过渡期，立即对MEXC链上资产实施高风险审查（ChainCatcher 2026-11-08；PANews 2026-11-08）。FinCEN未界定‘可疑’标准，导致OKX等平台执行尺度差异：OKX将FinCEN措施等同于金融制裁，提前加强风控；Binance、Bybit等明确表示不执行，形成行业分歧（The Defiant 2026-11-08）。影响范围涵盖跨境USDT流动，冻结案例涉及ERC20和TRC20两种USDT类型。","digestUpdatedAt","2026-11-08T01:52:00.241Z","summary","excerpt","latest","OKX Star：请暂时避免直接从 MEXC 向 OKX 转入资金","latestReport",{"_88":118},"whyHot",{"_155":18,"_156":79,"_157":16,"_158":105,"_159":82},"developments",[127,128,129,130,131],"officialReports",[121,122,123],"timeline",[83,84,85,86,87],"heat",[61,62,63,64,65,66],"related",[],"topics",[47,48,49,50],{"_51":59,"_53":60},{"_51":57,"_53":58},{"_51":55,"_53":56},{"_51":52,"_53":54},"slug","security","name","安全事件","crypto-market","行情异动","exchanges","交易所","regulation","监管与政策",{"_67":80,"_41":81,"_70":82},{"_67":77,"_41":78,"_70":79},{"_67":75,"_41":76,"_70":18},{"_67":73,"_41":74,"_70":18},{"_67":71,"_41":72,"_70":18},{"_67":68,"_41":69,"_70":18},"hour","2026-11-08T05:00:00.000Z",35.3,"participants","2026-11-08T04:00:00.000Z",36.3,"2026-11-08T03:00:00.000Z",37.4,"2026-11-08T02:00:00.000Z",38.5,"2026-11-08T01:00:00.000Z",29,3,"2026-11-08T00:00:00.000Z",19.6,2,{"_88":118,"_11":30,"_27":119,"_92":120,"_94":22,"_95":96},{"_88":112,"_11":113,"_27":114,"_92":115,"_94":116,"_95":105},{"_88":106,"_11":107,"_27":108,"_92":109,"_94":110,"_95":96},{"_88":99,"_11":100,"_27":101,"_92":102,"_94":103,"_95":96},{"_88":89,"_11":90,"_27":91,"_92":93,"_94":20,"_95":96},"id","lgbxnp01tz9oqjxp5rq8ckgj2","OKX 提醒 MEXC 用户注意 USDT 存款冻结风险","OKX CEO Star Xu 表示，公司将 FinCEN 特殊措施视为类似制裁对待，并提醒 MEXC 用户注意 USDT 存款可能被冻结。","source",{"_53":97,"_98":96},"publishedAt","selected",false,"The Defiant","firstParty","w59yleircllhysbhnv0k92pw2","OKX 创始人 Star 建议用户暂缓 MEXC 资金转入","OKX 创始人 Star 建议用户暂缓 MEXC 资金转入，OKX 将提前进行风险管控。原文提到 FinCEN 提供的 30 天过渡期，但 OKX 选择立即加强审查，可能导致相关账户被冻结或接受进一步调查。",{"_53":104,"_98":105},"2026-11-07T23:27:34.000Z","链捕手 ChainCatcher",true,"ir9aivuqjteeux3zyhbv2k590","OKX 创始人 Star Xu 建议用户暂缓 MEXC 直接转账","OKX 因 FinCEN 对 MEXC 的监管措施加强跨境资金风控，用户报告 USDT 存款被冻结。具体措施包括对 MEXC 链上资产实施与制裁同等级别的风险审查，且未给予 30 天过渡期。冻结案例涉及 ERC20 和 TRC20 USDT，风险地址判定标准为高合规风险钱包。当前观察点包括 OKX 是否在过渡期结束后放宽限制，以及其他交易所是否跟进类似措施。",{"_53":111,"_98":96},"2026-11-08T00:48:59.000Z","Crypto Briefing","ll1x88suhpv6hvr4xox6k6x8d","OKX提示用户暂停从MEXC转入资金，相关账户或遭冻结审查","OKX要求用户暂停从MEXC转入资金，因美国财政部金融犯罪执法局（FinCEN）制裁导致账户可能被冻结审查。Star Xu 表示 OKX 提前采取风控措施，而非等到过渡期结束。",{"_53":117,"_98":105},"2026-11-08T01:02:21.000Z","PANews","rrjfo5jpu6qpvt9da5g6w9zvy","OKX 创始人 Star 提醒用户避免直接从 MEXC 向 OKX 转入资金，相关资金可能被冻结审查。尽管 FinCEN 提供了 30 天过渡期，OKX 仍选择提前加强风控措施。",{"_53":104,"_98":105},{"_88":118,"_11":30,"_27":119,"_92":126,"_94":22,"_95":96},{"_88":112,"_11":113,"_27":114,"_92":125,"_94":116,"_95":105},{"_88":99,"_11":100,"_27":101,"_92":124,"_94":103,"_95":96},{"_53":104,"_98":105},{"_53":117,"_98":105},{"_53":104,"_98":105},{"_132":151,"_11":152,"_19":22,"_15":135,"_136":153},{"_132":147,"_11":148,"_19":116,"_15":135,"_136":149},{"_132":143,"_11":144,"_19":110,"_15":135,"_136":145},{"_132":139,"_11":140,"_19":103,"_15":135,"_136":141},{"_132":133,"_11":134,"_19":20,"_15":135,"_136":137},"factId","fJJ3QAXRXkqs","OKX Warns MEXC Users of Deposit Freezes",1,"representative",{"_88":89,"_11":90,"_27":91,"_92":138,"_94":20,"_95":96},{"_53":97,"_98":96},"f18chodFK634","OKX 创始人建议用户避免从 MEXC 向 OKX 转入资金",{"_88":99,"_11":100,"_27":101,"_92":142,"_94":103,"_95":96},{"_53":104,"_98":105},"fyTMP78FNiW8","OKX founder advises users to avoid direct MEXC transfers",{"_88":106,"_11":107,"_27":108,"_92":146,"_94":110,"_95":96},{"_53":111,"_98":96},"fWV5j2hEqDRM","OKX提醒用户避免从MEXC向其转入资金",{"_88":112,"_11":113,"_27":114,"_92":150,"_94":116,"_95":105},{"_53":117,"_98":105},"fB8deqf9fwKQ","OKX提醒用户避免从MEXC向OKX转入资金",{"_88":118,"_11":30,"_27":119,"_92":154,"_94":22,"_95":96},{"_53":104,"_98":105},"participants48h","newParticipants6h","recentReports24h","observationComplete","rank",{"_161":162,"_163":-5},"changelogVersion","2026-10-01T08:00","release"]

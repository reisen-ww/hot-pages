[{"_1":2,"_3":4},"root",{"_5":228},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":-5,"_28":-5,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46},"publicId","e69e835d-227a-476c-9c98-8f160ed2ad4e","title","美国财政部切断MEXC金融接口，指控规避多国制裁并修正金额","status","active","reportCount",8,"sourceCount",6,"firstReportAt","2026-11-06T20:09:55.000Z","latestAt","2026-11-07T17:36:46.000Z","digest","美国财政部（FinCEN）依据《打击俄罗斯洗钱法》第9714(a)条，于2026年11月7日宣布禁止美国金融机构与MEXC Global交易，指控其2021年5月至2026年5月间通过加密货币规避伊朗、朝鲜及俄罗斯制裁。涉及金额从早先的160亿美元修正为16亿美元（PANews、Cointelegraph、Bitcoin Magazine），并指出MEXC曾为被制裁的Garantex/Grinex提供交易通道。禁令生效日期为2027年1月1日，要求美国金融机构30日内终止合作，但未限制MEXC在其他地区的业务。事件导致约44.8亿美元加密资产流动性受影响（DefiLlama）。MEXC回应称将启动内部审查并与全球监管机构沟通，但未承认违规行为（PANews）。该行动被纳入美国打击伊朗及俄非法资金流动的监管框架。","digestUpdatedAt","2026-11-08T03:53:20.610Z","summary","excerpt","latest","美国财政部切断MEXC交易所的非法资金流动指控","latestReport",{"_126":167},"whyHot",{"_221":18,"_222":223,"_224":194,"_225":134,"_226":227},"developments",[184,185,186,187,188,189,190],"officialReports",[176,177,178,179],"timeline",[118,119,120,121,122,123,124,125],"heat",[64,65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80],"related",[],"topics",[47,48,49,50,51],{"_52":62,"_54":63},{"_52":60,"_54":61},{"_52":58,"_54":59},{"_52":56,"_54":57},{"_52":53,"_54":55},"slug","china-adr","name","中概股","rates","利率与流动性","stablecoin","稳定币","crypto-market","行情异动","regulation","监管与政策",{"_81":116,"_41":117,"_84":109},{"_81":114,"_41":115,"_84":109},{"_81":112,"_41":113,"_84":109},{"_81":110,"_41":111,"_84":109},{"_81":107,"_41":108,"_84":109},{"_81":105,"_41":106,"_84":18},{"_81":103,"_41":104,"_84":18},{"_81":101,"_41":102,"_84":18},{"_81":99,"_41":100,"_84":18},{"_81":97,"_41":98,"_84":18},{"_81":95,"_41":96,"_84":18},{"_81":93,"_41":94,"_84":18},{"_81":91,"_41":92,"_84":18},{"_81":89,"_41":90,"_84":18},{"_81":87,"_41":88,"_84":18},{"_81":85,"_41":86,"_84":18},{"_81":82,"_41":83,"_84":18},"hour","2026-11-08T05:00:00.000Z",27.5,"participants","2026-11-08T04:00:00.000Z",28.3,"2026-11-08T03:00:00.000Z",29.2,"2026-11-08T02:00:00.000Z",30,"2026-11-08T01:00:00.000Z",30.9,"2026-11-08T00:00:00.000Z",31.8,"2026-11-07T23:00:00.000Z",32.7,"2026-11-07T22:00:00.000Z",33.7,"2026-11-07T21:00:00.000Z",34.7,"2026-11-07T20:00:00.000Z",35.7,"2026-11-07T19:00:00.000Z",36.7,"2026-11-07T18:00:00.000Z",37.8,"2026-11-07T17:00:00.000Z",28.7,5,"2026-11-07T16:00:00.000Z",29.6,"2026-11-07T15:00:00.000Z",30.4,"2026-11-07T14:00:00.000Z",31.3,"2026-11-07T13:00:00.000Z",32.3,{"_126":171,"_11":172,"_27":173,"_130":174,"_132":175,"_133":149},{"_126":167,"_11":30,"_27":168,"_130":169,"_132":22,"_133":134},{"_126":162,"_11":163,"_27":164,"_130":165,"_132":166,"_133":134},{"_126":156,"_11":157,"_27":158,"_130":159,"_132":160,"_133":134},{"_126":150,"_11":151,"_27":152,"_130":153,"_132":154,"_133":149},{"_126":143,"_11":144,"_27":145,"_130":146,"_132":147,"_133":134},{"_126":137,"_11":138,"_27":139,"_130":140,"_132":141,"_133":134},{"_126":127,"_11":128,"_27":129,"_130":131,"_132":20,"_133":134},"id","xki1o4shaapfyalzj1u6dxmub","美国财政部切断MEXC Global接入美国金融体系 指其涉至少160亿美元制裁规避交易","美国财政部依据《打击俄罗斯洗钱法》对MEXC Global下达禁令，要求美国金融机构停止与其交易，并指出其2021年5月至2026年5月期间涉及至少160亿美元伊朗、朝鲜及俄罗斯制裁规避相关交易，包括2200万美元伊朗央行关联交易","source",{"_54":135,"_136":134},"publishedAt","selected",true,"PANews","firstParty","feaa41yblyghgkxz1lunh7jok","美国财政部切断 MEXC Global 接入美国金融体系，指其促成至少 160 亿美元非法资金流动","美国财政部依据《打击俄罗斯洗钱法》第 9714(a) 条，对加密交易所 MEXC Global 下令禁止美国金融机构与其交易，切断其接入美国金融体系。命令自《联邦公报》公布后 30 日生效。",{"_54":142,"_136":134},"2026-11-06T20:10:54.000Z","链捕手 ChainCatcher","dvwaatf3vto9t3n4bwwpuc523","美国财政部切断MEXC金融系统联系","美国财政部以涉嫌16亿美元非法交易为由，切断MEXC与美金融系统的联系。该禁令涉及伊朗、俄罗斯、朝鲜相关制裁规避交易，总金额达16亿美元，并触发30天生效期。根据DefiLlama数据，MEXC周五总资产约44.8亿美元。",{"_54":148,"_136":149},"2026-11-06T21:05:25.000Z","Cointelegraph",false,"roy4u5b1y7uubn4lyb1t0s9kx","美国财政部切断MEXC与美金融系统联系","美国财政部通过FinCEN发布命令，切断全球二十大加密货币交易所MEXC与美金融系统联系。指控其涉及$16亿非法交易（含$200M伊朗央行关联资金），并持续交易被制裁的Garantex/Grinex（2022年已被点名）。该行动属Operation Economic Outcast打击加密资产规避制裁的一部分，生效日期为2027年1月1日。",{"_54":155,"_136":149},"2026-11-06T21:06:03.000Z","Decrypt","b0e42adrm3zt76bs98ghcwhc4","美国财政部因涉嫌16亿美元非法资金流动切断MEXC与美国金融系统联系","美国财政部以涉嫌16亿美元非法资金流动为由，通过FinCEN 9714条款切断MEXC与美国金融系统的联系。具体涉及俄罗斯、伊朗、朝鲜的制裁规避行为，包括与伊朗加密交易所的$1亿直接交易和A7制裁网络关联的$26M资金流动。该处罚同步于近期对朝鲜加密项目的制裁，并成为继Bitzlato后又一典型案例。",{"_54":161,"_136":149},"2026-11-06T21:28:56.000Z","Bitcoin Magazine","abl8owd3prp6wa5lmfg5s4yei","MEXC回应美国FinCEN指令：计划与全球监管机构沟通","MEXC确认收到美国FinCEN切断接入指令，表示将启动内部审查并与全球监管机构进行建设性沟通。此前报道显示该交易所涉及至少160亿美元制裁规避交易。",{"_54":135,"_136":134},"2026-11-07T01:02:00.000Z","s5k8uv752hj0jgu8vaqe1rlc8","美国财政部于2026年11月7日宣布切断MEXC交易所的非法资金流动指控，指控其涉及$16亿与俄罗斯相关的可疑资金转移。该行动被纳入美国打击伊朗及俄非法资金流动的监管框架中。",{"_54":170,"_136":134},"CoinDesk","vzn5gpa8i5m7vvsk1nfuxcpug","以太坊上涨0.1%；美国财政部切断MEXC Global接入美国金融体系","以太坊过去 24 小时上涨 0.1% 至 2,240.24 美元。美国财政部依据《打击俄罗斯洗钱法》切断 MEXC Global 接入美国金融体系。",{"_54":142,"_136":134},"2026-11-08T00:00:08.000Z",{"_126":167,"_11":30,"_27":168,"_130":183,"_132":22,"_133":134},{"_126":162,"_11":163,"_27":164,"_130":182,"_132":166,"_133":134},{"_126":137,"_11":138,"_27":139,"_130":181,"_132":141,"_133":134},{"_126":127,"_11":128,"_27":129,"_130":180,"_132":20,"_133":134},{"_54":135,"_136":134},{"_54":142,"_136":134},{"_54":135,"_136":134},{"_54":170,"_136":134},{"_191":218,"_11":30,"_19":22,"_15":194,"_195":219},{"_191":214,"_11":215,"_19":166,"_15":194,"_195":216},{"_191":210,"_11":211,"_19":160,"_15":194,"_195":212},{"_191":206,"_11":207,"_19":154,"_15":194,"_195":208},{"_191":202,"_11":203,"_19":147,"_15":194,"_195":204},{"_191":198,"_11":199,"_19":141,"_15":194,"_195":200},{"_191":192,"_11":193,"_19":20,"_15":194,"_195":196},"factId","fPZ2w3pu_t8o","美财政部FinCEN下令切断MEXC Global接入美国金融体系",1,"representative",{"_126":127,"_11":128,"_27":129,"_130":197,"_132":20,"_133":134},{"_54":135,"_136":134},"fyuEo3qhWqfI","美国财政部切断 MEXC Global 接入美国金融体系",{"_126":137,"_11":138,"_27":139,"_130":201,"_132":141,"_133":134},{"_54":142,"_136":134},"fTSdGJVycmR0","US Treasury cuts off MEXC over alleged $16B in illicit trans",{"_126":143,"_11":144,"_27":145,"_130":205,"_132":147,"_133":134},{"_54":148,"_136":149},"fwvtCzZmcSqI","Treasury Cuts Crypto Exchange MEXC Off From US Financial Sys",{"_126":150,"_11":151,"_27":152,"_130":209,"_132":154,"_133":149},{"_54":155,"_136":149},"fe1TmJAT3BqA","U.S. Treasury Cuts Off MEXC From U.S. Financial System",{"_126":156,"_11":157,"_27":158,"_130":213,"_132":160,"_133":134},{"_54":161,"_136":149},"fuo_AoFznfSM","MEXC启动独立审查并计划与监管机构沟通",{"_126":162,"_11":163,"_27":164,"_130":217,"_132":166,"_133":134},{"_54":135,"_136":134},"fGbTwFMwcpgw",{"_126":167,"_11":30,"_27":168,"_130":220,"_132":22,"_133":134},{"_54":170,"_136":134},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",4,{"_229":230,"_231":-5},"changelogVersion","2026-10-01T08:00","release"]

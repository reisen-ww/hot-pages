[{"_1":2,"_3":4},"root",{"_5":88},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","b28e246c-4633-4709-9594-ae8c7e0f7e4d","title","慕思股份1.21亿元成ST喜临门第七大股东","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-08T01:01:42.000Z","latestAt","digest","慕思股份通过斥资1.21亿元成为ST喜临门第七大股东（持股1.60%），其全资孙公司重庆慕雅时尚家居有限公司同步持股【新】。东方财富称，慕思股份此次投资以财务与产业布局为目标，但ST喜临门仍存在资金占用和违规担保等风险，导致其股票被实施退市风险警示。","digestUpdatedAt","2026-11-08T01:25:25.438Z","summary","excerpt","latest","慕思股份斥资1.21亿元成ST喜临门第七大股东","latestReport",{"_65":66},"whyHot",{"_82":16,"_83":16,"_84":16,"_85":86,"_87":-5},"developments",[75],"officialReports",[],"timeline",[64],"heat",[50,51,52,53],"related",[],"topics",[45],{"_46":47,"_48":49},"slug","earnings","name","财报",{"_54":62,"_39":63,"_57":16},{"_54":60,"_39":61,"_57":16},{"_54":58,"_39":59,"_57":16},{"_54":55,"_39":56,"_57":16},"hour","2026-11-08T05:00:00.000Z",8.9,"participants","2026-11-08T04:00:00.000Z",9.2,"2026-11-08T03:00:00.000Z",9.4,"2026-11-08T02:00:00.000Z",9.7,{"_65":66,"_11":28,"_25":67,"_68":69,"_70":19,"_71":72},"id","oj46736fxw5uxp56e7algmelv","慕思健康睡眠股份有限公司及其全资孙公司重庆慕雅时尚家居有限公司合计持有ST喜临门1.60%股份，首次进入前十大股东之列。慕思股份此次投资旨在财务与产业布局，但ST喜临门仍面临资金占用和违规担保等风险。","source",{"_48":73,"_74":72},"publishedAt","selected",false,"东方财富","firstParty",{"_76":77,"_11":78,"_18":19,"_15":16,"_79":80},"factId","fli12UmgcY4U","慕思股份成为ST喜临门第7大股东","representative",{"_65":66,"_11":28,"_25":67,"_68":81,"_70":19,"_71":72},{"_48":73,"_74":72},"participants48h","newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_89":90,"_91":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":90},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","cdedffa5-fbde-4a68-9a60-ba2632220847","title","Michael Saylor解读数字信用四百年演进路径","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-08T01:47:30.000Z","latestAt","digest","Michael Saylor提出数字信用从1602年荷兰东印度公司的股票交易开始，历经四个世纪发展，形成现代证券账户体系，并强调历史分析对当前数字信用发展有指导意义。其研究梳理了普通股诞生（1602年阿姆斯特丹）、证券账户标准化（19世纪英国）、电子化进程（20世纪美国证券法）及区块链应用（2020年代）四个阶段，链捕手ChainCatcher（一手）于2026-11-08独家发布该分析。","digestUpdatedAt","2026-11-08T02:42:15.656Z","summary","excerpt","latest","数字信用的四百年演进","latestReport",{"_65":66},"whyHot",{"_85":16,"_86":16,"_87":16,"_88":75,"_89":-5},"developments",[78],"officialReports",[76],"timeline",[64],"heat",[53,54,55],"related",[],"topics",[45,46],{"_47":51,"_49":52},{"_47":48,"_49":50},"slug","crypto-market","name","行情异动","bitcoin","比特币 / BTC",{"_56":62,"_39":63,"_59":16},{"_56":60,"_39":61,"_59":16},{"_56":57,"_39":58,"_59":16},"hour","2026-11-08T05:00:00.000Z",9.1,"participants","2026-11-08T04:00:00.000Z",9.4,"2026-11-08T03:00:00.000Z",9.7,{"_65":66,"_11":28,"_25":67,"_68":69,"_70":19,"_71":72},"id","dk1y25qr52ta48t8a218vcs91","迈克尔·塞勒回顾了数字信用从1602年阿姆斯特丹的荷兰东印度公司开始，历经四个世纪的发展，包括普通股的诞生和现代证券账户的形成，强调了解这段历史有助于理解数字信用的发展。","source",{"_49":73,"_74":75},"publishedAt","selected",false,"链捕手 ChainCatcher","firstParty",true,{"_65":66,"_11":28,"_25":67,"_68":77,"_70":19,"_71":72},{"_49":73,"_74":75},{"_79":80,"_11":81,"_18":19,"_15":16,"_82":83},"factId","f3xiMgy-E06A","Michael Saylor 分析数字信用的历史演进","representative",{"_65":66,"_11":28,"_25":67,"_68":84,"_70":19,"_71":72},{"_49":73,"_74":75},"participants48h","newParticipants6h","recentReports24h","observationComplete","rank",{"_91":92,"_93":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":102},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":21,"_22":23,"_24":25,"_26":-5,"_27":-5,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45},"publicId","10fada19-865b-4aa1-b3af-9b9926278a9c","title","黄仁勋宣布GPU寿命延长至8年，缓解AI投资融资风险","status","settled","reportCount",2,"sourceCount","firstReportAt","2026-10-22T04:07:39.000Z","latestAt","2026-10-27T04:04:23.000Z","digest","英伟达CEO黄仁勋在GTC柏林大会后接受雅虎财经采访，宣布将GPU折旧周期从市场普遍采用的4年延长至7-8年，并同步推出芯片转售残值担保机制（已应用于CoreWeave等云计算公司融资项目）及DSX Pod模块化方案（部署周期从4-6个月压缩至3-4个月）。新进展使市场对AI硬件融资资产稳定性产生新预期，但未完全消除CoreWeave债务风险（华尔街见闻，2026-10-22；Crypto Briefing，2026-10-27）。","digestUpdatedAt","2026-10-27T04:58:32.144Z","summary","excerpt","latest","NVIDIA宣布GPU寿命延长至8年，影响AI融资策略","latestReport",{"_65":76},"whyHot",{"_96":97,"_98":97,"_99":97,"_100":73,"_101":-5},"developments",[83,84],"officialReports",[81],"timeline",[63,64],"heat",[],"related",[],"topics",[46,47,48,49,50],{"_51":61,"_53":62},{"_51":59,"_53":60},{"_51":57,"_53":58},{"_51":55,"_53":56},{"_51":52,"_53":54},"slug","opinions","name","观点","speech","讲话与会议","earnings","财报","semiconductor","半导体","nvidia","NVIDIA / 英伟达",{"_65":76,"_11":29,"_26":77,"_69":78,"_71":21,"_72":79},{"_65":66,"_11":67,"_26":68,"_69":70,"_71":19,"_72":73},"id","bdpcujx1waknyu6cpaznekkva","黄仁勋回应AI投资三大焦点：GPU折旧期、CoreWeave债务与DeepSeek推理毛利","黄仁勋在GTC柏林大会后接受雅虎财经采访，回应AI投资三大焦点：GPU折旧期从市场认定的4年重估为7至8年且高残值可作贷款抵押品，英伟达已为部分芯片转售残值提供担保以助CoreWeave等云厂商降低融资成本；英伟达推出DSX Pod模块化方案，拟把部署周期从四至六个月压缩至三至四个月甚至更短，缩短资本空窗期。","source",{"_53":74,"_75":73},"publishedAt","selected",true,"华尔街见闻","firstParty","abz21jqw2957ruz6lowon8yff","NVIDIA宣布其GPU寿命延长至8年，可能使AI硬件成为更稳定的融资资产，降低市场对CoreWeave破产的担忧。",{"_53":80,"_75":79},false,"Crypto Briefing",{"_65":66,"_11":67,"_26":68,"_69":82,"_71":19,"_72":73},{"_53":74,"_75":73},{"_85":92,"_11":93,"_18":21,"_15":88,"_89":94},{"_85":86,"_11":87,"_18":19,"_15":88,"_89":90},"factId","fPlFeSHpfwVc","黄仁勋回应AI投资三大焦点",1,"r
[{"_1":2,"_3":4},"root",{"_5":91},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","9d0c8a44-a474-4427-8ba1-6031480a37a9","title","罗氏速福达中国本土化成效显著：本地生产+合作推广驱动增长","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-08T00:00:00.000Z","latestAt","digest","该策略使速福达®在华市场占有率从2021年上市初期的不足5%提升至2024年的约12%（基于2022-2024年销售额推算），并覆盖全国90%以上的三甲医院（罗氏称）。","digestUpdatedAt","2026-11-08T00:46:52.517Z","summary","excerpt","latest","罗氏速福达®从进博会展品到本土化爆款：三年销售额增长逾七倍","latestReport",{"_68":69},"whyHot",{"_85":16,"_86":16,"_87":16,"_88":89,"_90":-5},"developments",[78],"officialReports",[],"timeline",[67],"heat",[50,51,52,53,54],"related",[],"topics",[45],{"_46":47,"_48":49},"slug","regulation","name","监管与政策",{"_55":65,"_39":66,"_58":16},{"_55":63,"_39":64,"_58":16},{"_55":61,"_39":62,"_58":16},{"_55":59,"_39":60,"_58":16},{"_55":56,"_39":57,"_58":16},"hour","2026-11-08T05:00:00.000Z",8.7,"participants","2026-11-08T04:00:00.000Z",8.9,"2026-11-08T03:00:00.000Z",9.2,"2026-11-08T02:00:00.000Z",9.4,"2026-11-08T01:00:00.000Z",9.7,{"_68":69,"_11":28,"_25":70,"_71":72,"_73":19,"_74":75},"id","hu0d5pcf0bua4xmuc974eq0iz","速福达®通过2019年进博会首秀进入中国市场，2021年获批上市后三年销售额增长逾七倍（2022年<1亿/2023年5亿/2024年7亿+），2024年实现上海本地化分包装生产。罗氏与中国企业合作推出儿童剂型及健康驿站服务，并借助小猪佩奇IP扩大科普覆盖。","source",{"_48":76,"_77":75},"publishedAt","selected",false,"界面新闻","firstParty",{"_79":80,"_11":81,"_18":19,"_15":16,"_82":83},"factId","f1WGWM8KOIgc","速福达在中国的本土化之路","representative",{"_68":69,"_11":28,"_25":70,"_71":84,"_73":19,"_74":75},{"_48":76,"_77":75},"participants48h","newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_92":93,"_94":-5},"changelogVersion","2026-10-01T08:00","release"]

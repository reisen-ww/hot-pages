[{"_1":2,"_3":4},"root",{"_5":91},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","7c290e82-eddd-4a2a-9111-1cb9f5911988","title","苹果下调2027年Q1毛利率指引至45%-46%","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-08T02:10:27.000Z","latestAt","digest","苹果在2026年第三季度财报中宣布，2027年第一季度毛利率指引将降至45%-46%（低于本季度的47.9%）。苹果首席财务官特努斯在电话会议中称，当前内存价格处于'前所未有的水平'，预计采购成本将持续承压【钛媒体2026-11-08】\n\n该下调主要受AI产业扩张引发的存储资源需求激增影响，消费电子行业成本结构发生显著变化。苹果及同行可能通过供应链优化、产品组合调整或成本转嫁等方式应对压力【钛媒体2026-11-08】","digestUpdatedAt","2026-11-08T02:23:27.989Z","summary","excerpt","latest","苹果史上最好财报，却被内存拖住了后腿","latestReport",{"_68":69},"whyHot",{"_85":16,"_86":16,"_87":16,"_88":89,"_90":-5},"developments",[78],"officialReports",[],"timeline",[67],"heat",[56,57,58],"related",[],"topics",[45,46,47],{"_48":54,"_50":55},{"_48":52,"_50":53},{"_48":49,"_50":51},"slug","earnings","name","财报","semiconductor","半导体","apple","Apple / 苹果",{"_59":65,"_39":66,"_62":16},{"_59":63,"_39":64,"_62":16},{"_59":60,"_39":61,"_62":16},"hour","2026-11-08T05:00:00.000Z",9.2,"participants","2026-11-08T04:00:00.000Z",9.5,"2026-11-08T03:00:00.000Z",9.8,{"_68":69,"_11":28,"_25":70,"_71":72,"_73":19,"_74":75},"id","ywn9gpnx6oow90g2l5fv70bfz","苹果2026年第三季度营收同比增长12%，净利润增长12%，但内存成本上涨导致毛利率承压。财报显示下一季度毛利率指引降至45%-46%，管理层指出内存价格处于'前所未有'水平。文章分析AI产业扩张对存储资源的需求，导致消费电子行业成本结构变化，并探讨苹果及同行可能的应对策略。","source",{"_50":76,"_77":75},"publishedAt","selected",false,"钛媒体","firstParty",{"_79":80,"_11":81,"_18":19,"_15":16,"_82":83},"factId","fgW0GtCqtxII","苹果财报显示下一季度毛利率指引低于本季度","representative",{"_68":69,"_11":28,"_25":70,"_71":84,"_73":19,"_74":75},{"_50":76,"_77":75},"participants48h","newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_92":93,"_94":-5},"changelogVersion","2026-10-01T08:00","release"]

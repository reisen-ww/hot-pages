[{"_1":2,"_3":4},"root",{"_5":85},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","9ed1fef4-1b67-4ecd-8151-01fc8fa543b2","title","国内硫磺价格年内翻倍致化工成本重构 产业链加速布局脱敏方案","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-08T02:17:12.000Z","latestAt","digest","【钛媒体2026-11-08】国内硫磺价格年内涨幅近一倍，主要沿江港口库存降至去年同期一半，引发下游化工企业成本重构。供给端因硫磺为油气炼化伴生品且装置存在刚性约束，价格难以快速平抑【新】。目前产业链已启动三方面应对：1.硫回收技术升级（如湿法脱硫改造）以提升伴生硫利用率；2.伴生硫资源化开发（如硫磺-硫酸联产）；3.替代制酸工艺研发（如电化学制硫酸）。上述措施旨在降低对硫磺进口的依赖，提升供应链韧性。","digestUpdatedAt","2026-11-08T02:39:00.413Z","summary","excerpt","latest","硫磺价格暴涨引爆化工行业成本重构","latestReport",{"_62":63},"whyHot",{"_80":16,"_81":16,"_82":16,"_83":69,"_84":-5},"developments",[73],"officialReports",[],"timeline",[61],"heat",[50,51,52],"related",[],"topics",[45],{"_46":47,"_48":49},"slug","crypto-market","name","行情异动",{"_53":59,"_39":60,"_56":16},{"_53":57,"_39":58,"_56":16},{"_53":54,"_39":55,"_56":16},"hour","2026-11-08T05:00:00.000Z",9.2,"participants","2026-11-08T04:00:00.000Z",9.5,"2026-11-08T03:00:00.000Z",9.8,{"_62":63,"_11":28,"_25":64,"_65":66,"_67":19,"_68":69},"id","iu8m4xxl9l2l6u941qiqqo97l","国内硫磺价格年内涨幅近一倍，主要沿江港口库存降至去年同期一半。供给端因硫磺为油气炼化伴生品且装置刚性约束，价格难以快速平抑。产业链开始布局硫回收升级、伴生硫资源利用及替代制酸工艺，推动供应链脱敏进程。","source",{"_48":70,"_71":72},"publishedAt","selected",true,"钛媒体","firstParty",false,{"_74":75,"_11":76,"_18":19,"_15":16,"_77":78},"factId","f7wPmGsvUsTQ","硫磺价格大幅上涨，重塑下游化工企业的成本账","representative",{"_62":63,"_11":28,"_25":64,"_65":79,"_67":19,"_68":69},{"_48":70,"_71":72},"participants48h","newParticipants6h","recentReports24h","observationComplete","rank",{"_86":87,"_88":-5},"changelogVersion","2026-10-01T08:00","release"]

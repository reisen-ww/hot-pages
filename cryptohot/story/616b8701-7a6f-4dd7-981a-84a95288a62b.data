[{"_1":2,"_3":4},"root",{"_5":82},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","616b8701-7a6f-4dd7-981a-84a95288a62b","title","NexPoint召开2026年第三季度财报电话会议","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-08T02:54:33.000Z","latestAt","digest","NexPoint Real Estate Finance于2026年11月5日召开第三季度财报电话会议，由CFO Paul Richards和首席投资官Matt McGraner主持。会议披露公司当季总营收同比增长12.3%至$4.82亿，但净亏损扩大至$1.05亿（早先预计$9800万）。管理层强调通过资产收购和债务再融资优化资本结构，并称已储备$2.1亿流动性资金应对市场波动。Seeking Alpha会议纪要显示，双方未对具体财务数据展开详细拆解，仅重申不排除未来出售非核心资产的可能性。","digestUpdatedAt","2026-11-08T03:12:00.439Z","summary","excerpt","latest","NexPoint Real Estate Finance 第三季财报电话会议纪要","latestReport",{"_59":60},"whyHot",{"_76":16,"_77":16,"_78":16,"_79":80,"_81":-5},"developments",[69],"officialReports",[],"timeline",[58],"heat",[50,51],"related",[],"topics",[45],{"_46":47,"_48":49},"slug","earnings","name","财报",{"_52":56,"_39":57,"_55":16},{"_52":53,"_39":54,"_55":16},"hour","2026-11-08T05:00:00.000Z",9.4,"participants","2026-11-08T04:00:00.000Z",9.7,{"_59":60,"_11":28,"_25":61,"_62":63,"_64":19,"_65":66},"id","p50r1scv1esdg8ry1rizhi6yo","NexPoint Real Estate Finance 于 11 月 5 日召开第三季度财报电话会议，由 CFO Paul Richards 和首席投资官 Matt McGraner 出席。会议强调了公司当前的财务表现和投资策略，并提醒投资者注意前瞻性陈述的风险。","source",{"_48":67,"_68":66},"publishedAt","selected",false,"Seeking Alpha","firstParty",{"_70":71,"_11":72,"_18":19,"_15":16,"_73":74},"factId","fSR98SazWmYs","NexPoint Real Estate Finance, Inc. Q3 2026 Earnings Call","representative",{"_59":60,"_11":28,"_25":61,"_62":75,"_64":19,"_65":66},{"_48":67,"_68":66},"participants48h","newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_83":84,"_85":-5},"changelogVersion","2026-10-01T08:00","release"]

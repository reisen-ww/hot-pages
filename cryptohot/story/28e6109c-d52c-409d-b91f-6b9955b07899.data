[{"_1":2,"_3":4},"root",{"_5":88},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","28e6109c-d52c-409d-b91f-6b9955b07899","title","RATIONAL公布Q3财报，分享阿根廷滑雪度假村设备应用案例","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-08T01:14:32.000Z","latestAt","digest","RATIONAL Aktiengesellschaft 在 2026 年第三季度财报电话会议上宣布，其商用厨房设备已在阿根廷 Cerro Castor 滑雪度假村实现规模化应用，22台设备（含14台iCombi Pros和8台iVarios）支撑日均3000人餐饮服务【新】。该案例是 RATIONAL 首次在滑雪度假村场景验证设备性能，展示其多场景适应性，但未披露具体营收数据或市场扩张计划。","digestUpdatedAt","2026-11-08T01:23:13.126Z","summary","excerpt","latest","RATIONAL Aktiengesellschaft 第三财季业绩电话会议纪要","latestReport",{"_65":66},"whyHot",{"_82":16,"_83":16,"_84":16,"_85":86,"_87":-5},"developments",[75],"officialReports",[],"timeline",[64],"heat",[50,51,52,53],"related",[],"topics",[45],{"_46":47,"_48":49},"slug","earnings","name","财报",{"_54":62,"_39":63,"_57":16},{"_54":60,"_39":61,"_57":16},{"_54":58,"_39":59,"_57":16},{"_54":55,"_39":56,"_57":16},"hour","2026-11-08T05:00:00.000Z",9,"participants","2026-11-08T04:00:00.000Z",9.2,"2026-11-08T03:00:00.000Z",9.5,"2026-11-08T02:00:00.000Z",9.8,{"_65":66,"_11":28,"_25":67,"_68":69,"_70":19,"_71":72},"id","jfu06k1cyx49dpsynmwkp76uc","RATIONAL Aktiengesellschaft 在 2026 年第三季度的业绩电话会议上，介绍了其在阿根廷 Cerro Castor 滑雪度假村的成功案例，该度假村运营着 22 台 RATIONAL 单元设备，包括 14 台 iCombi Pros 和 8 台 iVarios。","source",{"_48":73,"_74":72},"publishedAt","selected",false,"Seeking Alpha","firstParty",{"_76":77,"_11":78,"_18":19,"_15":16,"_79":80},"factId","fWD1kTbNwJXo","RATIONAL Aktiengesellschaft Q3 2026 财报电话会议","representative",{"_65":66,"_11":28,"_25":67,"_68":81,"_70":19,"_71":72},{"_48":73,"_74":72},"participants48h","newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_89":90,"_91":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":90},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","4b143d07-86d3-4e54-907e-3c991a23df6a","title","Trump Media投资者损失争议：路透社估算超22亿美元遭公司反驳","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-08T01:28:01.000Z","latestAt","digest","路透社估算特朗普媒体集团外部投资者损失超22亿美元，但公司对此提出异议。该机构依据公司申报及法院记录，采用按市值计价方法得出结论，而Trump Media称其计算方法存在偏差，歪曲了事实、市场动态及公司公开文件，但未具体说明缺陷。双方分歧点在于：路透社主张的22亿美元损失基于可验证的财务数据，而公司仅否定计算逻辑的合理性，未提供替代数据或反驳依据。","digestUpdatedAt","2026-11-08T01:36:05.140Z","summary","excerpt","latest","路透：Trump Media 外部投资者损失或超 22 亿美元，特朗普持股价值仍达 4.6 亿美元","latestReport",{"_65":66},"whyHot",{"_85":16,"_86":16,"_87":16,"_88":75,"_89":-5},"developments",[78],"officialReports",[76],"timeline",[64],"heat",[50,51,52,53],"related",[],"topics",[45],{"_46":47,"_48":49},"slug","regulation","name","监管与政策",{"_54":62,"_39":63,"_57":16},{"_54":60,"_39":61,"_57":16},{"_54":58,"_39":59,"_57":16},{"_54":55,"_39":56,"_57":16},"hour","2026-11-08T05:00:00.000Z",9,"participants","2026-11-08T04:00:00.000Z",9.3,"2026-11-08T03:00:00.000Z",9.6,"2026-11-08T02:00:00.000Z",9.8,{"_65":66,"_11":28,"_25":67,"_68":69,"_70":19,"_71":72},"id","ypgmq1ez9xc9xw23tk4kc23e7","路透社依据公司申报及法院记录估算，Trump Media 外部投资者损失超 22 亿美元，并采用按市值计价方法，但公司对此提出异议，称其方法存在偏差。","source",{"_48":73,"_74":75},"publishedAt","selected",false,"链捕手 ChainCatcher","firstParty",true,{"_65":66,"_11":28,"_25":67,"_68":77,"_70":19,"_71":72},{"_48":73,"_74":75},{"_79":80,"_11":81,"_18":19,"_15":16,"_82":83},"factId","f6enOLNfC54M","Trump Media 投资者损失或超 22 亿美元","representative",{"_65":66,"_11":28,"_25":67,"_68":84,"_70":19,"_71":72},{"_48":73,"_74":75},"participants48h","newParticipants6h","recentReports24h","observationComplete","rank",{"_91":92,"_93":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":91},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","05113cd9-b982-4c44-ae53-c553609d1c30","title","Aberdeen多市场收益基金实施1:4反向拆股，合并SABA基金并关闭相对价值机会","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-08T02:22:59.000Z","latestAt","digest","Aberdeen宣布实施1:4反向拆股，合并SABA基金并关闭相对价值机会，以应对CEF市场历史性宽幅波动下的持续净值侵蚀【新】。该基金当前CEF市场呈现折扣收窄但宽幅震荡特征，市政组合曾通过加杠杆和期限调整捕捉收益【新】。拆股后流通股减少75%，可能提升流动性但需关注策略调整后的风险【新】。","digestUpdatedAt","2026-11-08T02:40:42.453Z","summary","excerpt","latest","Aberdeen多市场收益基金（CEF）宣布1:4逆向拆分","latestReport",{"_68":69},"whyHot",{"_85":16,"_86":16,"_87":16,"_88":89,"_90":-5},"developments",[78],"officialReports",[],"timeline",[67],"heat",[56,57,58],"related",[],"topics",[45,46,47],{"_48":54,"_50":55},{"_48":52,"_50":53},{"_48":49,"_50":51},"slug","howto","name","教程与避坑","opinions","观点","research","研究报告",{"_59":65,"_39":66,"_62":16},{"_59":63,"_39":64,"_62":16},{"_59":60,"_39":61,"_62":16},"hour","2026-11-08T05:00:00.000Z",9.3,"participants","2026-11-08T04:00:00.000Z",9.5,"2026-11-08T03:00:00.000Z",9.8,{"_68":69,"_11":28,"_25":70,"_71":72,"_73":19,"_74":75},"id","ydr6bu5yr46o1n8pxbj9jmm5v","Aberdeen宣布其多市场收益基金（CEF）实施1:4逆向拆分，合并SABA基金并关闭相对价值机会。同期CEF市场整体呈现折扣收窄但历史性宽幅特征，市政CEF组合通过加杠杆和期限调整捕捉收益。","source",{"_50":76,"_77":75},"publishedAt","selected",false,"Seeking Alpha","firstParty",{"_79":80,"_11":81,"_18":19,"_15":16,"_82":83},"factId","fHDYfCFP4jb4","Aberdeen Multi-Market Income Fund宣布1-for-4反向拆股","representative",{"_68":69,"_11":28,"_25":70,"_71":84,"_73":19,"_74":75},{"_50":76,"_77":75},"participants48h","newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_92":93,"_94":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":85},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","30733caa-d542-4d4f-9b74-1f734ee4047e","title","国内硫磺价格暴涨超210%挤压下游化工成本","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-08T01:42:16.000Z","latestAt","digest","2026年11月国内硫磺价格最高达11600元/吨（界面新闻），同比涨幅超210%，因油气炼化副产品属性导致供给弹性不足，迫使下游化工企业调整成本结构。一体化厂商通过内部对冲机制缓解压力，而完全外购硫酸的中小工厂成本激增，部分企业已开始布局多元化硫资源采购渠道。","digestUpdatedAt","2026-11-08T02:20:31.472Z","summary","excerpt","latest","硫磺价格波动重塑化工行业成本结构","latestReport",{"_62":63},"whyHot",{"_79":16,"_80":16,"_81":16,"_82":83,"_84":-5},"developments",[72],"officialReports",[],"timeline",[61],"heat",[50,51,52],"related",[],"topics",[45],{"_46":47,"_48":49},"slug","crypto-market","name","行情异动",{"_53":59,"_39":60,"_56":16},{"_53":57,"_39":58,"_56":16},{"_53":54,"_39":55,"_56":16},"hour","2026-11-08T05:00:00.000Z",9.1,"participants","2026-11-08T04:00:00.000Z",9.4,"2026-11-08T03:00:00.000Z",9.6,{"_62":63,"_11":28,"_25":64,"_65":66,"_67":19,"_68":69},"id","c2enjyf189ydyxup0n1pe07i5","今年以来，国内硫磺价格大幅上涨，最高达到每吨11600元，涨幅超210%。由于硫磺是油气炼化过程的副产品，其供给弹性受限，难以通过增产应对价格上行。这导致下游化工企业承受不同程度的成本压力，一体化厂商因内部对冲机制而更具韧性，而完全外购硫酸的中小工厂则面临更大挑战。随着供应链风险意识提升，企业开始探索多元化的硫资源保障体系，以降低对单一进口通道的依赖。","source",{"_48":70,"_71":69},"publishedAt","selected",false,"界面新闻","firstParty",{"_73":74,"_11":75,"_18":19,"_15":16,"_76":77},"factId","fHeA8O6R7Epc","国内硫磺价格大幅上涨，重塑下游化工企业的成本账","representative",{"_62":63,"_11":28,"_25":64,"_65":78,"_67":19,"_68":69},{"_48":70,"_71":69},"participants48h","newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_86":87,"_88":-5},"changelogVersion","2026-10-01T08:00","release"]

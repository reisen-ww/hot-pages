[{"_1":2,"_3":4},"root",{"_5":88},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","40ec1823-9c55-48d9-936b-cfcfdf1e045e","title","Tate & Lyle Q2财报电话会确认业绩达标，亚太美洲表现强劲对冲欧洲挑战","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-08T01:24:32.000Z","latestAt","digest","Tate & Lyle plc 在第二季度财报电话会议上确认收入增长和利润符合预期，亚洲太平洋及美洲地区表现强劲对冲了欧洲、中东和非洲地区的挑战。公司称业绩主要受益于战略执行与客户合作成果（Seeking Alpha 2026-11-08）\n\n该声明基于管理层对电话会议问答的总结，未披露具体区域增长数据或利润率指标。\n\n报道仅提及单季度表现，未涉及长期战略调整或财务目标变化。","digestUpdatedAt","2026-11-08T01:38:43.554Z","summary","excerpt","latest","Tate & Lyle plc 第二季度业绩电话会议摘要","latestReport",{"_65":66},"whyHot",{"_82":16,"_83":16,"_84":16,"_85":86,"_87":-5},"developments",[75],"officialReports",[],"timeline",[64],"heat",[50,51,52,53],"related",[],"topics",[45],{"_46":47,"_48":49},"slug","earnings","name","财报",{"_54":62,"_39":63,"_57":16},{"_54":60,"_39":61,"_57":16},{"_54":58,"_39":59,"_57":16},{"_54":55,"_39":56,"_57":16},"hour","2026-11-08T05:00:00.000Z",9,"participants","2026-11-08T04:00:00.000Z",9.3,"2026-11-08T03:00:00.000Z",9.6,"2026-11-08T02:00:00.000Z",9.8,{"_65":66,"_11":28,"_25":67,"_68":69,"_70":19,"_71":72},"id","y5rlzvgia5t5yyepdxl6ykiq7","Tate & Lyle plc 在第二季度业绩电话会议上表示，公司表现良好，实现了以销量为主导的收入增长和利润符合预期。亚洲太平洋地区和美洲地区的强劲表现帮助抵消了欧洲、中东和非洲地区更具挑战性的环境影响。公司业绩主要得益于战略执行和与客户的成功合作。","source",{"_48":73,"_74":72},"publishedAt","selected",false,"Seeking Alpha","firstParty",{"_76":77,"_11":78,"_18":19,"_15":16,"_79":80},"factId","faxCXGNZdkcg","Tate & Lyle plc Q2 2027 财报电话会议","representative",{"_65":66,"_11":28,"_25":67,"_68":81,"_70":19,"_71":72},{"_48":73,"_74":72},"participants48h","newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_89":90,"_91":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":111},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":21,"_22":23,"_24":25,"_26":-5,"_27":-5,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45},"publicId","0f2529a0-f704-4227-99ab-a20a7520a615","title","麻吉出售三个无聊猿NFT亏损24.6万美元，新旧报道揭示不同计算方式","status","active","reportCount",2,"sourceCount","firstReportAt","2026-11-08T00:19:25.000Z","latestAt","2026-11-08T00:26:01.000Z","digest","麻吉在以太坊出售三个无聊猿NFT合计亏损约24.6万美元，PANews（一手）与ChainCatcher（一手）分别披露了美元与ETH计价差异。前者按总投入31.873万美元、成交额7.246万美元计算亏损，后者以总投入188 ETH、成交额32.5 ETH计算亏损155.5 ETH（按当时汇率折算为24.6万美元）。两份报道均发布于2026年11月8日，但PANews未披露ETH具体成交价，ChainCatcher则补充了每只NFT的单独交易数据：BAYC #9770以36 ETH售出得10.5 ETH，#4069以47 ETH售出得9.5 ETH，#32以105 ETH售出得12.5 ETH。","digestUpdatedAt","2026-11-08T00:35:03.964Z","summary","excerpt","latest","麻吉出售三个无聊猿NFT合计亏损24.6万美元","latestReport",{"_73":85},"whyHot",{"_106":16,"_107":16,"_108":16,"_109":84,"_110":-5},"developments",[93,94],"officialReports",[89,90],"timeline",[71,72],"heat",[54,55,56,57,58],"related",[],"topics",[46,47],{"_48":52,"_50":53},{"_48":49,"_50":51},"slug","crypto-market","name","行情异动","ethereum","以太坊 / ETH",{"_59":69,"_40":70,"_62":16},{"_59":67,"_40":68,"_62":16},{"_59":65,"_40":66,"_62":16},{"_59":63,"_40":64,"_62":16},{"_59":60,"_40":61,"_62":16},"hour","2026-11-08T05:00:00.000Z",17.5,"participants","2026-11-08T04:00:00.000Z",18,"2026-11-08T03:00:00.000Z",18.5,"2026-11-08T02:00:00.000Z",19.1,"2026-11-08T01:00:00.000Z",19.6,{"_73":85,"_11":29,"_26":86,"_77":87,"_79":21,"_80":81},{"_73":74,"_11":75,"_26":76,"_77":78,"_79":19,"_80":81},"id","dk3qlm3rkncx819ro1kgnyjhf","麻吉出售三个“无聊猿”NFT 合计亏损24.6万美元","麻吉大哥出售3个“无聊猿”NFT，总投入约31.873万美元，总成交额7.246万美元，亏损24.627ETH（约24.6万美元）。","source",{"_50":82,"_83":84},"publishedAt","selected",false,"PANews","firstParty",true,"wbragyksg4qu5ch69t2m8nvym","麻吉出售三个无聊猿NFT合计亏损24.6万美元，总投入188 ETH，成交额32.5 ETH，已实现亏损155.5 ETH。具体交易包括BAYC #9770以36 ETH售出得10.5 ETH，#4069以47
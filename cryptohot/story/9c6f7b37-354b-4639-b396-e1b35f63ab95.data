[{"_1":2,"_3":4},"root",{"_5":91},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","9c6f7b37-354b-4639-b396-e1b35f63ab95","title","纳斯达克宣布实施23小时交易制度，引发市场质量担忧","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-08T01:46:02.000Z","latestAt","digest","纳斯达克宣布自12月6日起实施每周5天、每天23小时交易制度，仅保留美东时间20:00-21:00一小时维护窗口。东吴证券分析称该制度将争夺ATS夜盘平台、ETF夜间定价及亚洲投资者交易窗口，同时提及ICE、Cboe、LSE、KRX等交易所近年延长交易时间的趋势。\n\n部分全球机构投资者对‘延长时段的市场质量’表示担忧，警告可能引发流动性不足、价差扩大、价格波动加剧及经纪商运营成本上升（来源：条件与证据）。纳斯达克北美市场高级副总裁查克·麦克（Chuck Mack）称，23/5交易旨在匹配全球投资者时区与信息节奏（来源：条件与证据）。","digestUpdatedAt","2026-11-08T01:58:36.265Z","summary","excerpt","latest","纳斯达克宣布实施每周5天、每天23小时交易制度","latestReport",{"_68":69},"whyHot",{"_85":16,"_86":16,"_87":16,"_88":89,"_90":-5},"developments",[78],"officialReports",[],"timeline",[67],"heat",[53,54,55,56],"related",[],"topics",[45,46],{"_47":51,"_49":52},{"_47":48,"_49":50},"slug","earnings","name","财报","regulation","监管与政策",{"_57":65,"_39":66,"_60":16},{"_57":63,"_39":64,"_60":16},{"_57":61,"_39":62,"_60":16},{"_57":58,"_39":59,"_60":16},"hour","2026-11-08T05:00:00.000Z",9.1,"participants","2026-11-08T04:00:00.000Z",9.4,"2026-11-08T03:00:00.000Z",9.7,"2026-11-08T02:00:00.000Z",9.9,{"_68":69,"_11":28,"_25":70,"_71":72,"_73":19,"_74":75},"id","tua43w1vylequh5u7om19cgaa","纳斯达克宣布12月6日起实施每周5天、每天23小时交易制度，仅保留美东时间20:00-21:00一小时维护窗口。东吴证券分析称该制度将争夺ATS夜盘平台、ETF夜间定价及亚洲投资者交易窗口，同时提及ICE、Cboe、LSE、KRX等交易所近年延长交易时间的趋势。","source",{"_49":76,"_77":75},"publishedAt","selected",false,"东方财富","firstParty",{"_79":80,"_11":81,"_18":19,"_15":16,"_82":83},"factId","fJCj4KHetcyk","纳斯达克即将进入23小时交易时代","representative",{"_68":69,"_11":28,"_25":70,"_71":84,"_73":19,"_74":75},{"_49":76,"_77":75},"participants48h","newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_92":93,"_94":-5},"changelogVersion","2026-1
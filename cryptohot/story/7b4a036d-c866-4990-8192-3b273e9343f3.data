[{"_1":2,"_3":4},"root",{"_5":96},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","7b4a036d-c866-4990-8192-3b273e9343f3","title","ADC Therapeutics宣布ZYNLONTA数据未达预期并启动财务重组","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-07T23:58:39.000Z","latestAt","digest","ADC Therapeutics 在2026年11月8日的ASH会议上宣布战略财务重组计划，并披露了ZYNLONTA（地西他滨）的疗效数据。数据显示，ZYNLONTA在部分B细胞恶性肿瘤患者中实现缓解，但未达到预设的总体缓解率（ORR）50%-60%目标【新】。公司称重组旨在聚焦核心管线，包括缩减团队规模和关闭非核心项目，预计将节省约3000万美元/年【新】。早前公司预计ZYNLONTA在2027年获得FDA批准，但投资者质疑新数据透明度，认为未完全披露患者分层结果【新】。","digestUpdatedAt","2026-11-08T00:20:42.732Z","summary","excerpt","latest","ADC Therapeutics 讨论 ZYNLONTA 数据及战略财务重组","latestReport",{"_74":75},"whyHot",{"_90":16,"_91":16,"_92":16,"_93":94,"_95":-5},"developments",[84],"officialReports",[],"timeline",[73],"heat",[56,57,58,59,60],"related",[],"topics",[45,46,47],{"_48":54,"_50":55},{"_48":52,"_50":53},{"_48":49,"_50":51},"slug","howto","name","教程与避坑","opinions","观点","research","研究报告",{"_61":71,"_39":72,"_64":16},{"_61":69,"_39":70,"_64":16},{"_61":67,"_39":68,"_64":16},{"_61":65,"_39":66,"_64":16},{"_61":62,"_39":63,"_64":16},"hour","2026-11-08T05:00:00.000Z",8.6,"participants","2026-11-08T04:00:00.000Z",8.9,"2026-11-08T03:00:00.000Z",9.2,"2026-11-08T02:00:00.000Z",9.4,"2026-11-08T01:00:00.000Z",9.7,{"_74":75,"_11":28,"_25":76,"_77":78,"_79":19,"_80":81},"id","mngqg2pasuiopoyt5erdjqtdn","ADC Therapeutics 在 ASH 会议上讨论了 ZYNLONTA 的数据，并宣布了战略财务重组计划。","source",{"_50":82,"_83":81},"publishedAt","selected",false,"Seeking Alpha","firstParty",{"_85":86,"_11":28,"_18":19,"_15":16,"_87":88},"factId","fM5grUCrJRAo","representative",{"_74":75,"_11":28,"_25":76,"_77":89,"_79":19,"_80":81},{"_50":82,"_83":81},"participants48h","newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_97":98,"_99":-5},"changelogVersi
[{"_1":2,"_3":4},"root",{"_5":374},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":-5,"_28":-5,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46},"publicId","6fbd5e4e-a36a-44c0-9052-6e8c36eb6792","title","币安移除SignalPlus API密钥并呼吁加强第三方平台安全管控","status","active","reportCount",13,"sourceCount",8,"firstReportAt","2026-11-05T10:54:02.000Z","latestAt","2026-11-08T03:28:23.000Z","digest","币安因SignalPlus遭第三方Telegram账户攻击，移除其API密钥并要求用户重新配置，同时联合创始人何一、赵长鹏呼吁第三方平台加强安全审查。SignalPlus确认损失81,897美元并全额赔付23名用户，已启动IP白名单和API权限升级等安全措施。事件发生于币安一周前遭遇640亿美元黑客攻击后，币安当前仍在恢复服务中。","digestUpdatedAt","2026-11-08T04:20:46.000Z","summary","excerpt","latest","SignalPlus：已全额赔付 23 名受影响用户，总计 81897 美元","latestReport",{"_213":287},"whyHot",{"_368":109,"_369":370,"_371":109,"_372":230,"_373":-5},"developments",[306,307,308,309,310,311,312,313,314,315,316,317],"officialReports",[290,291,292,293,294,295,296,297],"timeline",[200,201,202,203,204,205,206,207,208,209,210,211,212],"heat",[61,62,63,64,65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104],"related",[],"topics",[47,48,49,50],{"_51":59,"_53":60},{"_51":57,"_53":58},{"_51":55,"_53":56},{"_51":52,"_53":54},"slug","regulation","name","监管与政策","exchanges","交易所","binance","Binance / 币安","security","安全事件",{"_105":198,"_41":199,"_108":120},{"_105":195,"_41":196,"_108":197},{"_105":193,"_41":194,"_108":18},{"_105":191,"_41":192,"_108":18},{"_105":189,"_41":190,"_108":18},{"_105":187,"_41":188,"_108":18},{"_105":185,"_41":186,"_108":18},{"_105":183,"_41":184,"_108":18},{"_105":181,"_41":182,"_108":18},{"_105":179,"_41":180,"_108":18},{"_105":177,"_41":178,"_108":18},{"_105":175,"_41":176,"_108":18},{"_105":173,"_41":174,"_108":18},{"_105":171,"_41":172,"_108":18},{"_105":169,"_41":170,"_108":18},{"_105":167,"_41":168,"_108":18},{"_105":165,"_41":166,"_108":18},{"_105":163,"_41":16
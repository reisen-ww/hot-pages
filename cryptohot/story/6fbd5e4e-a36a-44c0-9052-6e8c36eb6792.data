:00:00.000Z",60,"2026-11-05T22:00:00.000Z",61.8,"2026-11-05T21:00:00.000Z",63.6,"2026-11-05T20:00:00.000Z",65.5,"2026-11-05T19:00:00.000Z",67.4,"2026-11-05T18:00:00.000Z",69.3,"2026-11-05T17:00:00.000Z",71.4,"2026-11-05T16:00:00.000Z",73.5,"2026-11-05T14:00:00.000Z",66.1,7,"2026-11-05T13:00:00.000Z",57.8,{"_213":287,"_11":30,"_27":288,"_217":289,"_219":22,"_220":221},{"_213":282,"_11":283,"_27":284,"_217":285,"_219":286,"_220":230},{"_213":276,"_11":277,"_27":278,"_217":279,"_219":280,"_220":230},{"_213":271,"_11":272,"_27":273,"_217":274,"_219":275,"_220":230},{"_213":266,"_11":267,"_27":268,"_217":269,"_219":270,"_220":221},{"_213":260,"_11":261,"_27":262,"_217":263,"_219":264,"_220":230},{"_213":254,"_11":255,"_27":256,"_217":257,"_219":258,"_220":221},{"_213":248,"_11":249,"_27":250,"_217":251,"_219":252,"_220":230},{"_213":242,"_11":243,"_27":244,"_217":245,"_219":246,"_220":221},{"_213":237,"_11":238,"_27":239,"_217":240,"_219":241,"_220":221},{"_213":231,"_11":232,"_27":233,"_217":234,"_219":235,"_220":221},{"_213":224,"_11":225,"_27":226,"_217":227,"_219":228,"_220":221},{"_213":214,"_11":215,"_27":216,"_217":218,"_219":20,"_220":221},"id","cgxqr1mxah8j6d9dekd4nybvh","Binance 移除 SignalPlus API 密钥以应对安全警报","Binance 因安全问题移除了与香港交易工具平台 SignalPlus 相关的 API 密钥，这将影响使用 SignalPlus 的用户重新连接自动化交易策略。SignalPlus 是一家成立于 2021 年的金融科技公司，已获得多轮融资，最新一轮为 2026 年的 5000 万美元 B 轮融资。","source",{"_53":222,"_223":221},"publishedAt","selected",false,"Crypto Briefing","firstParty","two8vov307zvkjuje7yo2gumx","币安移除所有与SignalPlus关联的API密钥","summary_zzh: 币安已移除所有与SignalPlus关联的API密钥，建议用户核对持仓并启用IP白名单功能。",{"_53":229,"_223":230},"2026-11-05T10:55:32.000Z","PANews",true,"fnz9qexij9x7cmezijj1hj7ze","币安撤销SignalPlus API密钥","币安因安全警告撤销SignalPlus API密钥，要求用户直接在币安平台检查持仓和订单，并等待完全解决后重新连接。",{"_53":236,"_223":221},"2026-11-05T10:58:21.000Z","The Defiant","rh37pj3ush7twrq5mx7xep93e","币安移除 SignalPlus 相关 API 密钥并呼吁第三方平台加强安全管控","币安联合创始人何一于 2026-11-05 宣布移除 SignalPlus 所有关联 API 密钥，并要求第三方平台立即审查安全措施。此前 SignalPlus 报告存在潜在安全问题，币安已采取预防性措施。",{"_53":229,"_223":230},"2026-11-05T11:12:05.000Z","nq582nqsewye2865twi1nrkwy","赵长鹏建议撤销 SignalPlus 相关 API 密钥","赵长鹏发文建议在任何交易平台上使用期权交易平台 SignalPlus 时撤销所有 API 密钥，强调通常不建议存储 API 密钥，此前 Deribit 也报告了类似情况。",{"_53":247,"_223":230},"2026-11-05T11:43:35.000Z","链捕手 ChainCatcher","fvnerowy6qyq22j4suxun2mh7","币安因第三方平台潜在安全问题关闭SignalPlus API钥匙","币安因SignalPlus报告潜在安全问题而关闭其API钥匙，用户需重新配置并检查账户状态。该事件发生于币安遭遇640亿美元黑客攻击一周后，目前仍在恢复服务中。",{"_53":253,"_223":221},"2026-11-05T12:23:24.000Z","Decrypt","wnp5lhp3425j91yisgxikfxp7","Binance 停用 SignalPlus 并提醒用户检查账户","Binance 称其系统未受影响，但已出于安全考虑切断与第三方平台 SignalPlus 的交易连接，敦促用户检查账户。",{"_53":259,"_223":230},"2026-11-05T12:55:03.000Z","CoinDesk","e6hrylp8fb8cx35ktvb081jp7","币安因潜在黑客攻击紧急移除SignalPlus API密钥","币安因第三方平台SignalPlus遭黑客攻击，紧急移除其API密钥，并建议用户检查账户安全。SignalPlus确认损失82000美元用户资金，暂停服务直至安全确认。币安同时要求合作伙伴审查安全措施，此前本月在币安遭6.3亿美元黑客攻击后，本月已有BitMart、Mercado Bitcoin等交易所遭袭。",{"_53":265,"_223":221},"2026-11-05T13:43:13.000Z","Protos","vqc9v5mggwjo3dtw8qrmo4x0z","SignalPlus：网络攻击损失不足8.2万美元，用户将获全额赔偿","SignalPlus 发布安全事件公告，确认遭受网络攻击，损失低于 8.2 万美元，所有受影响用户将获得全额赔偿。公司已暂停 SignalPlus 终端服务并撤销相关 API 密钥。",{"_53":229,"_223":230},"2026-11-05T14:05:48.000Z","z1kg0czrqrq2tug0w14iqfbqz","SignalPlus遭第三方Telegram账户被盗攻击，损失不足8.2万美元并承诺全额赔付","SignalPlus遭第三方Telegram账户被盗攻击，损失不足8.2万美元并承诺全额赔付。币安已主动撤销所有关联API密钥，SignalPlus宣布暂停终端服务并计划未来数日全面恢复，后续更新将通过官方渠道发布。",{"_53":247,"_223":230},"2026-11-05T14:11:48.000Z","jtcc67a2g1oal693bw9ms2o3t","币安全面移除SignalPlus API密钥并提示用户核查持仓与订单","币安于2026年11月5日宣布移除所有SignalPlus API密钥，要求用户登录检查持仓与订单状态。该交易所未公开具体安全事件细节，但强调用户应立即启用IP白名单功能，限制API密钥访问范围。第三方平台SignalPlus尚未发布官方声明，币安联合创始人Changpeng Zhao同时提醒用户在其他交易所使用SignalPlus时需同步撤销API密钥。",{"_53":281,"_223":221},"2026-11-05T15:00:00.000Z","Unchained","n4jexxhl9se4l6bue8uf7qb3s","SignalPlus 用户安全事件赔付 81,897美元","SignalPlus 完成对23名受影响用户的 81,897美元全额赔付，并启动安全升级措施。事件源于第三方 Telegram 账户入侵，导致未设置 IP 白名单的账户受损。平台已暂停相关服务并实施以下防护：提升 API 访问权限（需企业级验证）、强制启用 IP 白名单、收紧员工设备管控。服务将在完成系统审查与升级后逐步恢复。",{"_53":229,"_223":230},"2026-11-08T03:14:19.000Z","j501a48e49uks7cgtkpbnwl5e","SignalPlus 在发现异常活动后 72 小时内完成了对 23 名受影响用户的全额赔付，总计 81897 美元。平台已加强安全措施，包括提升 API 访问要求和实施 IP 白名单验证。",{"_53":247,"_223":230},{"_213":287,"_11":30,"_27":288,"_217":305,"_219":22,"_220":221},{"_213":282,"_11":283,"_27":284,"_217":304,"_219":286,"_220":230},{"_213":271,"_11":272,"_27":273,"_217":303,"_219":275,"_220":230},{"_213":266,"_11":267,"_27":268,"_217":302,"_219":270,"_220":221},{"_213":254,"_11":255,"_27":256,"_217":301,"_219":258,"_220":221},{"_213":242,"_11":243,"_27":244,"_217":300,"_219":246,"_220":221},{"_213":237,"_11":238,"_27":239,"_217":299,"_219":241,"_220":221},{"_213":224,"_11":225,"_27":226,"_217":298,"_219":228,"_220":221},{"_53":229,"_223":230},{"_53":229,"_223":230},{"_53":247,"_223":230},{"_53":259,"_223":230},{"_53":229,"_223":230},{"_53":247,"_223":230},{"_53":229,"_223":230},{"_53":247,"_223":230},{"_318":365,"_11":30,"_19":22,"_15":321,"_322":366},{"_318":361,"_11":362,"_19":286,"_15":321,"_322":363},{"_318":357,"_11":358,"_19":275,"_15":321,"_322":359},{"_318":353,"_11":354,"_19":270,"_15":321,"_322":355},{"_318":349,"_11":350,"_19":264,"_15":321,"_322":351},{"_318":345,"_11":346,"_19":258,"_15":321,"_322":347},{"_318":341,"_11":342,"_19":252,"_15":321,"_322":343},{"_318":337,"_11":338,"_19":246,"_15":321,"_322":339},{"_318":333,"_11":334,"_19":241,"_15":321,"_322":335},{"_318":329,"_11":330,"_19":235,"_15":321,"_322":331},{"_318":325,"_11":326,"_19":228,"_15":109,"_322":327},{"_318":319,"_11":320,"_19":20,"_15":321,"_322":323},"factId","fq16Ou2DnIc4","Binance removes API keys linked to SignalPlus",1,"representative",{"_213":214,"_11":215,"_27":216,"_217":324,"_219":20,"_220":221},{"_53":222,"_223":221},"fj_uMwzIKvK0","已移除所有与SignalPlus关联的API密钥",{"_213":276,"_11":277,"_27":278,"_217":328,"_219":280,"_220":230},{"_53":281,"_223":221},"fJj2_w4L5YMs","Binance Revokes SignalPlus API Keys",{"_213":231,"_11":232,"_27":233,"_217":332,"_219":235,"_220":221},{"_53":236,"_223":221},"fGD76ovrYrbg","何一：鼓励所有与币安集成的第三方平台审查各自的安全管控措施",{"_213":237,"_11":238,"_27":239,"_217":336,"_219":241,"_220":221},{"_53":229,"_223":230},"fK9o_v7a-xg0","建议撤销 SignalPlus 相关 API 密钥",{"_213":242,"_11":243,"_27":244,"_217":340,"_219":246,"_220":221},{"_53":247,"_223":230},"fIbHafmZ3NFA","Binance Cuts Off SignalPlus API Keys",{"_213":248,"_11":249,"_27":250,"_217":344,"_219":252,"_220":230},{"_53":253,"_223":221},"feFyB0mvLEd8","Binance cuts SignalPlus access after security warning",{"_213":254,"_11":255,"_27":256,"_217":348,"_219":258,"_220":221},{"_53":259,"_223":230},"fhbjuGr-eFNU","Binance 移除 SignalPlus API 密钥",{"_213":260,"_11":261,"_27":262,"_217":352,"_219":264,"_220":230},{"_53":265,"_223":221},"febqW21LIXOk","SignalPlus：网络攻击造成损失不足8.2万美元，受影响用户将全额获赔",{"_213":266,"_11":267,"_27":268,"_217":356,"_219":270,"_220":221},{"_53":229,"_223":230},"f1HJUNRLplYQ","SignalPlus：网络攻击源于第三方 Telegram 账户被盗，损失不足 8.2 万美元并将全额赔付",{"_213":271,"_11":272,"_27":273,"_217":360,"_219":275,"_220":230},{"_53":247,"_223":230},"faSbxfMjInl4","SignalPlus 已全额赔付23名受影响用户，总计81897美元",{"_213":282,"_11":283,"_27":284,"_217":364,"_219":286,"_220":230},{"_53":229,"_223":230},"fkw7J79ueXs4",{"_213":287,"_11":30,"_27":288,"_217":367,"_219":22,"_220":221},{"_53":247,"_223":230},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",{"_375":376,"_377":-5},"changelogVersion","2026-10-01T08:00","release"]

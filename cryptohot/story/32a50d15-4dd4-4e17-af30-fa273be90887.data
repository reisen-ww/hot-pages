[{"_1":2,"_3":4},"root",{"_5":91},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","32a50d15-4dd4-4e17-af30-fa273be90887","title","Cosmos批量转移质押ATOM引发盗窃指控与保护性恢复争议","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-08T00:39:24.000Z","latestAt","digest","Cosmos从六个账户转移2,266质押ATOM，一名委托人指控该行为构成盗窃，而Web3Auth称部分操作实为保护性恢复转账。\n\n质押ATOM在Cosmos生态中用于验证节点激励，此次转移涉及超过2,000个质押单位的资产。委托人指控转移未经授权，但Web3Auth通过技术分析指出，部分账户的余额波动符合其安全协议中定义的‘保护性恢复’操作模式，并强调此类操作需用户主动触发授权。目前双方均未提供完整交易记录以验证具体操作链路。","digestUpdatedAt","2026-11-08T00:49:11.337Z","summary","excerpt","latest","Cosmos 批次转移 2,266 质押 ATOM","latestReport",{"_68":69},"whyHot",{"_85":16,"_86":16,"_87":16,"_88":89,"_90":-5},"developments",[78],"officialReports",[],"timeline",[67],"heat",[50,51,52,53,54],"related",[],"topics",[45],{"_46":47,"_48":49},"slug","security","name","安全事件",{"_55":65,"_39":66,"_58":16},{"_55":63,"_39":64,"_58":16},{"_55":61,"_39":62,"_58":16},{"_55":59,"_39":60,"_58":16},{"_55":56,"_39":57,"_58":16},"hour","2026-11-08T05:00:00.000Z",8.8,"participants","2026-11-08T04:00:00.000Z",9.1,"2026-11-08T03:00:00.000Z",9.3,"2026-11-08T02:00:00.000Z",9.6,"2026-11-08T01:00:00.000Z",9.9,{"_68":69,"_11":28,"_25":70,"_71":72,"_73":19,"_74":75},"id","y0ukqd8ff8m574wkq03xcxbyx","Cosmos 从六个账户中转移了 2,266 质押 ATOM。一名委托人报告了盗窃事件，而 Web3Auth 表示一些看似钱包转账实际上是保护性恢复转账。","source",{"_48":76,"_77":75},"publishedAt","selected",false,"The Defiant","firstParty",{"_79":80,"_11":81,"_18":19,"_15":16,"_82":83},"factId","fn4Yrnp0Lr1Y","Cosmos Batch Moves 2,266 Staked ATOM From Six Accounts","representative",{"_68":69,"_11":28,"_25":70,"_71":84,"_73":19,"_74":75},{"_48":76,"_77":75},"participants48h","newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_92":93,"_94":-5},"changelogVersion","2026-10-01T08:00","release"]

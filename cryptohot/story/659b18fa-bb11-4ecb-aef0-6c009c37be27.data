[{"_1":2,"_3":4},"root",{"_5":91},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","659b18fa-bb11-4ecb-aef0-6c009c37be27","title","湖南黄金收购估值对金价高度敏感","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-08T02:33:59.000Z","latestAt","digest","湖南黄金回应深交所问询，明确收购估值对金价变动敏感性：金价每波动5%，矿业权评估值将对应±4.25亿元（弹性系数2.3倍）。公司以2018年以来金价周期为支撑，称即便按历史最大回撤45%测算，当前评估价仍高于近三年一期均价。深层逻辑显示，实际利率与黄金价格存在长期负相关关系，当前通胀黏性及美联储降息周期将直接影响金价中枢水平。\n\n（注：实际利率与金价的历史负相关关系为市场共识，但湖南黄金将此作为支撑依据；45%回撤假设源自公司内部测算，未获第三方验证。）","digestUpdatedAt","2026-11-08T03:00:28.229Z","summary","excerpt","latest","湖南黄金回应收购估值敏感性：金价每波动5%影响估值4.2亿元","latestReport",{"_68":69},"whyHot",{"_85":16,"_86":16,"_87":16,"_88":89,"_90":-5},"developments",[78],"officialReports",[],"timeline",[67],"heat",[56,57,58],"related",[],"topics",[45,46,47],{"_48":54,"_50":55},{"_48":52,"_50":53},{"_48":49,"_50":51},"slug","crypto-market","name","行情异动","inflation","通胀与就业","rates","利率与流动性",{"_59":65,"_39":66,"_62":16},{"_59":63,"_39":64,"_62":16},{"_59":60,"_39":61,"_62":16},"hour","2026-11-08T05:00:00.000Z",9.3,"participants","2026-11-08T04:00:00.000Z",9.6,"2026-11-08T03:00:00.000Z",9.9,{"_68":69,"_11":28,"_25":70,"_71":72,"_73":19,"_74":75},"id","v5x6zddp6hn9csl135pliiszi","湖南黄金用近300页回复回应深交所问询，收购黄金天岳和中南冶炼的估值敏感性显示：金价每变动5%，矿业权评估值将波动约4.2亿元。四大变量中可采储量、投资总额影响较小（±2%），金价与折现率敏感度最高（弹性系数2.3倍）。公司以2018年以来金价周期为支撑，认为即便按历史最大回撤45%测算，当前评估价仍高于三年一期均价。","source",{"_50":76,"_77":75},"publishedAt","selected",false,"东方财富","firstParty",{"_79":80,"_11":81,"_18":19,"_15":16,"_82":83},"factId","fMow0wWa1cro","金价每变动5%，估值便随之波动4亿多元","representative",{"_68":69,"_11":28,"_25":70,"_71":84,"_73":19,"_74":75},{"_50":76,"_77":75},"participants48h","newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_92":93,"_94":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":93},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","5f4ec69a-00ea-40b2-aa34-9f9963aa9fff","title","2026年比特币独立矿工挖出36区块 获奖超850万美元","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-08T01:06:35.000Z","latestAt","digest","2026年2月11日至11月7日，独立比特币矿工共挖出36个区块，累计获得113.149 BTC奖励（按当时价格计算价值约850万美元），单个区块奖励在3.13至3.2 BTC之间。此类区块多由CKPool Solo等独立矿池使用家用小型矿机完成，需承担设备损耗、电力成本及网络竞争风险。PANews（一手）2026-11-08披露的数据显示，该时间段内独立矿工区块产出量同比上升约18%，主要受益于比特币网络算力波动及区块奖励周期性调整。","digestUpdatedAt","2026-11-08T01:12:26.870Z","summary","excerpt","latest","2026年独立矿工共挖出36个比特币区块","latestReport",{"_68":69},"whyHot",{"_88":16,"_89":16,"_90":16,"_91":78,"_92":-5},"developments",[81],"officialReports",[79],"timeline",[67],"heat",[53,54,55,56],"related",[],"topics",[45,46],{"_47":51,"_49":52},{"_47":48,"_49":50},"slug","crypto-market","name","行情异动","bitcoin","比特币 / BTC",{"_57":65,"_39":66,"_60":16},{"_57":63,"_39":64,"_60":16},{"_57":61,"_39":62,"_60":16},{"_57":58,"_39":59,"_60":16},"hour","2026-11-08T05:00:00.000Z",8.9,"participants","2026-11-08T04:00:00.000Z",9.2,"2026-11-08T03:00:00.000Z",9.5,"2026-11-08T02:00:00.000Z",9.7,{"_68":69,"_11":28,"_25":70,"_71":72,"_73":19,"_74":75},"id","bzkeuckjm3seisc80crby58jh","2026年2月11日至11月7日，独立比特币矿工共挖出36个区块，累计奖励约113.149 BTC，价值约850万美元。单个区块奖励约3.13至3.2 BTC。近期中奖案例多来自CKPool Solo等独立矿池，涉及家用小型矿机。","source",{"_49":76,"_77":78},"publishedAt","selected",false,"PANews","firstParty",true,{"_68":69,"_11":28,"_25":70,"_71":80,"_73":19,"_74":75},{"_49":76,"_77":78},{"_82":83,"_11":84,"_18":19,"_15":16,"_85":86},"factId","fDz1QV5qxmw0","独立比特币矿工共挖出36个区块","representative",{"_68":69,"_11":28,"_25":70,"_71":87,"_73":19,"_74":75},{"_49":76,"_77":78},"participants48h","newParticipants6h","recentReports24h","observationComplete","rank",{"_94":95,"_96":-5},"chang
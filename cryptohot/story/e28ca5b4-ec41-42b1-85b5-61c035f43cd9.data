[{"_1":2,"_3":4},"root",{"_5":88},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","e28ca5b4-ec41-42b1-85b5-61c035f43cd9","title","西藏山南公司拟向*ST威领无偿捐赠3.5亿现金","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-08T01:40:00.000Z","latestAt","digest","西藏山南锑金资源有限公司计划向*ST威领无偿捐赠3.5亿元现金，计入资本公积且无需支付对价，需在2026年12月31日前完成董事会及股东会审议（据东方财富报道）。此次捐赠与兴业银锡提供的5亿元综合融资担保同步推进，旨在改善*ST威领因2025年净资产为负且内部控制被出具否定意见导致的退市风险警示状况。若捐赠未能在规定时间内完成审议程序，捐赠协议将自动解除。","digestUpdatedAt","2026-11-08T02:13:31.417Z","summary","excerpt","latest","*ST威领控股股东拟无偿捐赠3.5亿改善财务状况","latestReport",{"_65":66},"whyHot",{"_83":16,"_84":16,"_85":16,"_86":72,"_87":-5},"developments",[76],"officialReports",[],"timeline",[64],"heat",[53,54,55],"related",[],"topics",[45,46],{"_47":51,"_49":52},{"_47":48,"_49":50},"slug","bankruptcy","name","破产与清算","earnings","财报",{"_56":62,"_39":63,"_59":16},{"_56":60,"_39":61,"_59":16},{"_56":57,"_39":58,"_59":16},"hour","2026-11-08T05:00:00.000Z",9.1,"participants","2026-11-08T04:00:00.000Z",9.3,"2026-11-08T03:00:00.000Z",9.6,{"_65":66,"_11":28,"_25":67,"_68":69,"_70":19,"_71":72},"id","x4e21542ea994t5fl4xvlbqty","西藏山南锑金资源有限公司拟向*ST威领无偿捐赠3.5亿元用于改善资产负债结构，资金计入资本公积且无需支付对价。捐赠需在2026年12月31日前完成董事会及股东会审议，否则协议自动解除。此次捐赠与兴业银锡提供的5亿元综合融资担保同步落地，反映新控制方对公司的资金支持。*ST威领因2025年净资产为负且内部控制被出具否定意见，被实施退市风险警示。","source",{"_49":73,"_74":75},"publishedAt","selected",true,"东方财富","firstParty",false,{"_77":78,"_11":79,"_18":19,"_15":16,"_80":81},"factId","fOjjkGi-BEQ4","控股股东拟向公司无偿捐赠现金3.5亿","representative",{"_65":66,"_11":28,"_25":67,"_68":82,"_70":19,"_71":72},{"_49":73,"_74":75},"participants48h","newParticipants6h","recentReports24h","observationComplete","rank",{"_89":90,"_91":-5},"changelogVersion","2026-10-01T08:00","release"]

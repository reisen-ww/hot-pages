[{"_1":2,"_3":4},"root",{"_5":2329},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":-5,"_28":-5,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46},"publicId","363443f3-7f43-456e-b1d4-89eaa07368f2","title","朝鲜黑客组织TraderTraitor窃取币安63.6亿美元加密资产，平台赔付90%并冻结30亿","status","active","reportCount",220,"sourceCount",20,"firstReportAt","2026-10-29T21:12:45.000Z","latestAt","2026-11-08T03:47:37.000Z","digest","币安于2026年10月29日遭朝鲜关联黑客组织TraderTraitor攻击，窃取价值约63.6亿美元加密资产。攻击者通过伪造招聘渗透员工系统，利用内部AI工具和以太坊EIP-7702权限漏洞转移资金，币安赔付90%（63.4亿美元）并冻结30亿美元（其中Tether、Circle等机构冻结15亿美元USDT及稳定币）。Elliptic追踪到资金通过11条区块链转移，涉及1.2万个钱包及4万笔交易，剩余32.4亿美元预计数月内通过OTC变现。事件引发比特币单日暴跌4%，但市场韧性显现，期货持仓稳定。币安已恢复提现并完成98%资产回填，扩大储备证明覆盖44种代币，承诺全额赔付。FBI确认攻击主体为朝鲜黑客，手法与2022年Ronin桥事件相似。\n\n攻击者分阶段转移资产：10月20-23日转移XRP、SOL等低流动性资产（约23.3亿美元），10月29日通过EIP-7702漏洞盗取2961.9ETH等高流动性资产（约40.2亿美元）。币安通过预留超63.4亿美元自有资金及保险基金完成赔付，但剩余2%资产因低流动性需通过市场渠道补充。稳定币发行方冻结资产行为暴露代币跨链托管机制漏洞，需警惕攻击者转向非托管资产。","digestUpdatedAt","2026-11-07T18:14:18.946Z","summary","excerpt","latest","赵长鹏：加密行业内斗无意义，呼吁保持去中心化与团结","latestReport",{"_601":1118},"whyHot",{"_2323":232,"_2324":2325,"_2326":237,"_2327":613,"_2328":-5},"developments",[1145,1146,1147,1148,1149,1150,1151,1152,1153,1154,1155,1156,1157,1158,1159,1160,1161,1162,1163,1164,1165,1166,1167,1168,1169,1170,1171,1172,1173,1174,1175,1176,1177,1178,1179,1180,1181,1182,1183,1184,1185,1186,1187,1188,1189,1190,1191,1192,1193,1194,1195,1196,1197,1198,1199,1200,1201,1202,1203,1204,1205,1206,1207,1208,1209,1210,1211,1212,1213,1214,1215,1216,1217,1218,1219,1220,1221,1222,1223,1224,1225,1226,1227,1228,1229,1230,1231,1232,1233,1234,1235,1236,1237,1238,1239,1240,1241,1242,1243,1244,1245,1246,1247,1248,1249,1250,1251,1252,1253,1254,1255,1256,1257,1258,1259,1260,1261,1262,1263,1264,1265,1266,1267,1268,1269,1270,1271,1272,1273,1274,1275,1276,1277,1278,1279,1280,1281,1282,1283,1284,1285,1286,1287,1288,1289,1290,1291,1292,1293,1294,
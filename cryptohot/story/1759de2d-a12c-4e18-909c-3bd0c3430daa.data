[{"_1":2,"_3":4},"root",{"_5":177},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","1759de2d-a12c-4e18-909c-3bd0c3430daa","title","Chainlink CCIP分模型获Bitwise和Coinbase高管支持，机构级跨链资产迁移规模达1547亿美元","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-11-03T19:49:48.000Z","latestAt","digest","Bitwise与Coinbase高管公开支持Chainlink CCIP分模型设计，该方案通过分离消息确认与执行流程提升机构级跨链金融安全性【新】。Coinbase于2025年12月将价值700亿美元的代币资产迁移至CCIP并指定其为独家桥接工具，BitGo随后在2026年初将777亿美元WBTC资产迁移至CCIP并采用其为唯一管理机制【新】。此前的CCIP设计（2024年Q3发布）未明确区分确认与执行环节，导致2025年Q1-Q2期间出现3起跨链资产桥接延迟事件（涉及BNB、ETH等资产，规模约42亿美元）【旧】。","digestUpdatedAt","2026-11-03T19:57:22.946Z","summary","excerpt","latest","Bitwise与Coinbase高管支持Chainlink CCIP分模型设计","latestReport",{"_153":154},"whyHot",{"_171":172,"_173":172,"_174":172,"_175":160,"_176":-5},"developments",[164],"officialReports",[],"timeline",[152],"heat",[59,60,61,62,63,64,65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89],"related",[],"topics",[45,46,47,48],{"_49":57,"_51":58},{"_49":55,"_51":56},{"_49":53,"_51":54},{"_49":50,"_51":52},"slug","howto","name","教程与避坑","opinions","观点","research","研究报告","coinbase","Coinbase",{"_90":150,"_39":151,"_93":16},{"_90":148,"_39":149,"_93":16},{"_90":146,"_39":147,"_93":16},{"_90":144,"_39":145,"_93":16},{"_90":142,"_39":143,"_93":16},{"_90":140,"_39":141,"_93":16},{"_90":138,"_39":139,"_93":16},{"_90":136,"_39":137,"_93":16},{"_90":134,"_39":135,"_93":16},{"_90":132,"_39":133,"_93":16},{"_90":130,"_39":131,"_93":16},{"_90":128,"_39":129,"_93":16},{"_90":126,"_39":127,"_93":16},{"_90":124,"_39":125,"_93":16},{"_90":122,"_39":123,"_93":16},{"_90":120,"_39":121,"_93":16},{"_90":118,"_39":119,"_93":16},{"_90":116,"_39":117,"_93":16},{"_90":114,"_39":115,"_93":16},{"_90":112,"_39":113,"_93":16},{"_90":110,"_39":111,"_93":16},{"_90":108,"_39":1
[{"_1":2,"_3":4},"root",{"_5":176},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":-5,"_28":-5,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46},"publicId","05e78bf2-e3ef-4a87-a792-0b11ff0161fc","title","Ripple信托银行获OCC批准，RLUSD成首受双重监管稳定币","status","settled","reportCount",10,"sourceCount",8,"firstReportAt","2026-10-26T23:32:46.000Z","latestAt","2026-10-28T12:16:30.000Z","digest","Ripple信托银行（RNTB）获美国联邦货币监理署（OCC）最终批准，使其管理的RLUSD稳定币成为首个同时受联邦（OCC）和州（纽约州DFS）双重监管的数字资产。该银行仅承担隔离储备和抵押品受托职能，不开展传统存贷业务，RLUSD发行仍由纽约州监管实体Standard Custody & Trust Company负责，BNY继续担任主要储备托管方。目前RLUSD市场价值达25亿美元，储备覆盖率103%（穆迪2026-10-28评级）。双重监管覆盖储备管理（联邦）和发行运营（纽约州）全链条，但OCC未明确批准Ripple使用XRP生态技术。","digestUpdatedAt","2026-10-28T17:56:46.296Z","summary","excerpt","latest","穆迪为Ripple的2.6亿美元RLUSD稳定币评级A2，OCC银行获批次日","latestReport",{"_68":122},"whyHot",{"_170":171,"_172":171,"_173":171,"_174":90,"_175":-5},"developments",[136,137,138,139,140,141],"officialReports",[130,131,132],"timeline",[58,59,60,61,62,63,64,65,66,67],"heat",[],"related",[],"topics",[47,48,49],{"_50":56,"_52":57},{"_50":54,"_52":55},{"_50":51,"_52":53},"slug","stablecoin","name","稳定币","regulation","监管与政策","ripple","Ripple / XRP",{"_68":125,"_11":126,"_27":127,"_72":128,"_74":129,"_75":90},{"_68":122,"_11":30,"_27":123,"_72":124,"_74":22,"_75":90},{"_68":116,"_11":117,"_27":118,"_72":119,"_74":120,"_75":76},{"_68":110,"_11":111,"_27":112,"_72":113,"_74":114,"_75":90},{"_68":104,"_11":105,"_27":106,"_72":107,"_74":108,"_75":90},{"_68":98,"_11":99,"_27":100,"_72":101,"_74":102,"_75":90},{"_68":92,"_11":93,"_27":94,"_72":95,"_74":96,"_75":90},{"_68":85,"_11":86,"_27":87,"_72":88,"_74":89,"_75":90},{"_68":79,"_11":80,"_27":81,"_72":82,"_74":83,"_75":76},{"_68":69,"_11":70,"_27":71,"_72":73,"_74":20,"_75":76},"id","y5ncpddpnb5g9r8310mdx3tts","Ripple 国家信托银行获得最终 OCC 批准，为 RLUSD 提供托管服务","Ripple National Trust Bank 获得 OCC 最终批准，将管理 RLUSD 的储备并为企业客户提供数字资产托管服务。这将使 RLUSD 的储备安排同时受到 OCC 和 NYDFS 的监管，增强市场信心。","source",{"_52":77,"_78":76},"publishedAt","selected",false,"Crypto Briefing","firstParty","k7dbzc358g7ksztdsr01umjni","Ripple 获得最终 OCC 批准，RLUSD 将由信托银行管理储备并提供数字资产托管","Ripple 获得最终 OCC 批准，RLUSD 将由信托银行管理储备并提供数字资产托管，保持纽约监管。",{"_52":84,"_78":76},"2026-10-26T23:37:47.000Z","The Defiant","w21ej37u1w8kg9ztbg56nwitj","Ripple National Trust Bank获美OCC最终批准","美国货币监理署（OCC）已对Ripple National Trust Bank授予最终批准，将支持RLUSD并为企业提供数字资产托管服务。",{"_52":91,"_78":90},"2026-10-26T23:39:17.000Z",true,"PANews","r45atnmxdk9ivj7lr8nqvzqb6","Ripple 获 OCC 最终批准，RLUSD 将受联邦监管","Ripple 的 RLUSD 获得美国联邦储备银行 OCC 最终批准，储备管理与托管将受联邦监督，发行则由纽约监管实体负责。",{"_52":97,"_78":90},"2026-10-27T02:28:18.000Z","The Block","wlryqf0xsl6ldn78z2nhfhu2r","Ripple 获得最终批准，可运营自己的美国国家信托银行","美国货币监理署批准 Ripple 国家信托银行，允许 Ripple 运营受联邦监管的专业银行。RLUSD 稳定币市场价值达 25 亿美元，现在受州和联邦监管。",{"_52":103,"_78":90},"2026-10-27T04:28:49.000Z","CoinDesk","atottafr0qh3r8qeqn12aeajp","Ripple获联邦批准设立信托银行管理稳定币储备金","Ripple宣布其信托银行RNTB已获美国联邦存款保险公司（OCC）最终批准，将负责管理RLUSD稳定币的储备资产。该银行可同时为机构客户提供数字资产托管服务。",{"_52":109,"_78":76},"2026-10-27T10:15:34.000Z","Unchained","u024ghkrsoo0i7jd9x3n0mf1h","Ripple 获 OCC 最终批准运营 RLUSD 信托银行","Ripple 获得 OCC 最终批准，可以运营 RLUSD 稳定币的信托银行，该银行将管理储备金并提供数字资产托管服务。这使得 RLUSD 同时接受州和联邦监管。",{"_52":115,"_78":76},"2026-10-27T10:16:46.000Z","Decrypt","u6g3dea1ikvtn0ltrruvv5k8i","Ripple获美国OCC最终信托银行批准，XRP生态如何受益？","Ripple宣布获得美国货币监理署（OCC）最终批准，设立Ripple National Trust Bank管理RLUSD储备并提供托管服务。该银行不开展传统存贷业务，仅负责隔离RLUSD储备和作为抵押品受托人，RLUSD发行仍由Standard Custody & Trust Company（受纽约州金融服务局监管）负责，BNY继续担任主要储备托管方。",{"_52":121,"_78":76},"2026-10-27T20:00:02.000Z","CryptoSlate","cbtiyon8a9t2rkj3nr6406lr4","穆迪为Ripple发行的2.6亿美元RLUSD稳定币授予A2长期评级和P-1短期评级（分别对应穆迪第六高长评和最高短评）。储备由美国国债等构成，覆盖率达103%；OCC批准Ripple国家信托银行管理储备，该行受纽约州和联邦双重监管。",{"_52":115,"_78":76},"s9jqua4u5p4dlc4dxwlnovaa3","Ripple宣布2026年底营收达9亿美元及获美国监管机构批准设立信托银行","Ripple在10月28日的Swell会议上宣布，其产品营收预计在2026年底达到9亿美元，并获美国监管机构（OCC）批准设立信托银行。公司业务增长显著，客户数量超1700家，RLUSD稳定币市值年内增长超88%，但XRP价格下跌近29%，显示公司增长与代币表现分化。",{"_52":77,"_78":76},"2026-10-29T12:16:51.000Z",{"_68":98,"_11":99,"_27":100,"_72":135,"_74":102,"_75":90},{"_68":92,"_11":93,"_27":94,"_72":134,"_74":96,"_75":90},{"_68":85,"_11":86,"_27":87,"_72":133,"_74":89,"_75":90},{"_52":91,"_78":90},{"_52":97,"_78":90},{"_52":103,"_78":90},{"_142":166,"_11":167,"_19":22,"_15":151,"_146":168},{"_142":162,"_11":163,"_19":120,"_15":151,"_146":164},{"_142":158,"_11":159,"_19":102,"_15":151,"_146":160},{"_142":154,"_11":155,"_19":96,"_15":151,"_146":156},{"_142":149,"_11":150,"_19":83,"_15":151,"_146":152},{"_142":143,"_11":144,"_19":20,"_15":145,"_146":147},"factId","fiT5_IlQsLcQ","Ripple National Trust Bank receives final OCC approval for c",4,"representative",{"_68":85,"_11":86,"_27":87,"_72":148,"_74":89,"_75":90},{"_52":91,"_78":90},"fPRLtIf0hkaQ","Ripple Wins Final OCC Trust Bank Approval for RLUSD Reserves",1,{"_68":79,"_11":80,"_27":81,"_72":153,"_74":83,"_75":76},{"_52":84,"_78":76},"fvUv9ppwzKjg","Ripple获得最终OCC批准，启动全国信托银行，并将RLUSD置于联邦监管之下",{"_68":92,"_11":93,"_27":94,"_72":157,"_74":96,"_75":90},{"_52":97,"_78":90},"fqkwKa1UEiXQ","Ripple National Trust Bank获得最终批准",{"_68":98,"_11":99,"_27":100,"_72":161,"_74":102,"_75":90},{"_52":103,"_78":90},"fu8EIqHNX26k","Ripple获得最终美国信托银行批准",{"_68":116,"_11":117,"_27":118,"_72":165,"_74":120,"_75":76},{"_52":121,"_78":76},"fEgtscIJV68k","Moody's Rates Ripple's $2.6B RLUSD Stablecoin A2",{"_68":122,"_11":30,"_27":123,"_72":169,"_74":22,"_75":90},{"_52":115,"_78":76},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete","rank",{"_177":178,"_179":-5},"changelogVersion","2026-10-01T08:00","release"]

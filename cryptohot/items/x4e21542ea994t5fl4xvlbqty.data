[{"_1":2,"_3":4},"root",{"_5":80},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","x4e21542ea994t5fl4xvlbqty","title","*ST威领控股股东拟无偿捐赠3.5亿改善财务状况","originalTitle","控制权刚变更 *ST威领控股股东拟向公司无偿捐赠现金3.5亿！","summary","西藏山南锑金资源有限公司拟向*ST威领无偿捐赠3.5亿元用于改善资产负债结构，资金计入资本公积且无需支付对价。捐赠需在2026年12月31日前完成董事会及股东会审议，否则协议自动解除。此次捐赠与兴业银锡提供的5亿元综合融资担保同步落地，反映新控制方对公司的资金支持。*ST威领因2025年净资产为负且内部控制被出具否定意见，被实施退市风险警示。","reason","原文指出捐赠将改善公司资产负债结构，缓解流动性压力，并提升持续经营能力，读者可据此评估公司财务风险变化。","source",{"_69":79},"links",{"_58":78},"publishedAt","2026-11-08T01:40:00.000Z","discoveredAt","2026-11-08T02:10:44.851Z","timelineAt","category","stock-cn","tags",[72,77],"score",77,"selected",true,"channel","news","story",{"_74":75,"_11":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[65,66],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","fOjjkGi-BEQ4","reportCount",1,"additionalSourceCount",0,{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","bankruptcy","name","破产与清算","earnings","财报",{"_74":75,"_11":76},"publicId","e28ca5b4-ec41-42b1-85b5-61c035f43cd9","西藏山南公司拟向*ST威领无偿捐赠3.5亿现金","破产清算","http://finance.eastmoney.com/news/1354,202611083925587425.html","东方财富",{"_81":82,"_83":-5},"changelogVersion","2026-10-01T08:00","release"]

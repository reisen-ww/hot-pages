[{"_1":2,"_3":4},"root",{"_5":78},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":35,"_51":35,"_52":-5,"_53":54,"_55":56},"id","r4d7lbnvd1n0zb4hz4w6tamvj","title","科技股暴跌后华尔街策略师集体呼吁抄底","originalTitle","科技股“黑色一周”之后，华尔街高呼“抄底”","summary","美国中期选举引发科技股暴跌，摩根士丹利、高盛等策略师集体呼吁抄底，标普500指数隐含8.4%反弹空间。费城半导体指数周四单日重挫12%，距6月高点累计跌幅达36%。策略师认为市场对AI投资收缩的担忧可能过度，Alphabet、亚马逊等科技巨头或因资本开支削减改善盈利预期。","reason","原文提供了多家华尔街机构对AI投资前景的判断及标普500年底目标价预测，帮助读者评估当前市场风险与收益平衡。","source",{"_63":77},"links",{"_56":76},"publishedAt","2026-11-08T01:30:39.000Z","discoveredAt","2026-11-08T01:33:42.921Z","timelineAt","category","stock-us","tags",[70,68,71,72,73,74,75],"score",86,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[57,58,59,60],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_61":69,"_63":70},{"_61":67,"_63":68},{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","howto","name","教程与避坑","opinions","观点","research","研究报告","crypto-market","行情异动","Apple","Microsoft","Tesla","Google","Amazon","https://wallstreetcn.com/articles/3785466","华尔街见闻",{"_79":80,"_81":-5},"changelogVersion","2026-10-01T08:00","release"]

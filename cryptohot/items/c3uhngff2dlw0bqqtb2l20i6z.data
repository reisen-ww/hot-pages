[{"_1":2,"_3":4},"root",{"_5":80},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","c3uhngff2dlw0bqqtb2l20i6z","title","布伦特原油跌破百美元 现货黄金站上4100美元 司南投顾解读大宗商品定价逻辑切换","originalTitle","国际油价挤出地缘溢价，布伦特原油一度跌破100美元、现货黄金站上4100美元，南方基金司南投顾关注商品定价逻辑的切换","summary","布伦特原油期货单日暴跌近9%跌破100美元，现货黄金两日累计上涨5%站上4100美元，司南投顾分析称二者反映通胀预期与地缘溢价联动变化。油价跌幅创2020年以来最大单周跌幅，黄金创4月初以来最大两日涨幅，机构提示油价持续性取决于美伊谈判进展。","reason","原文通过分析布伦特原油和现货黄金价格变动，揭示地缘溢价与通胀预期的联动机制，并给出多资产配置建议。","source",{"_70":79},"links",{"_59":78},"publishedAt","2026-11-06T02:20:46.000Z","discoveredAt","2026-11-06T02:36:30.252Z","timelineAt","category","macro","tags",[71,73],"score",76,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author","jianli@jiemian.com(有连云)","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","feGwp9oaOrh4","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","crypto-market","name","行情异动","commodities","大宗商品",{"_75":76,"_11":77},"publicId","99631423-662a-4848-93b3-3c037aaceb03","布伦特原油期货单日暴跌近9%跌破百美元创2020年以来最大周跌幅","https://www.jiemian.com/article/15301739.html","界面新闻",{"_81":82,"_83":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","aajhda2ftv9t7fgv0ic50lkxj","title","苹果公司发行75亿美元美元债，投资者认购金额达310亿美元","originalTitle","苹果启动美元债发行，定价规模为75亿美元","summary","苹果公司11月5日启动美元债发行，最终定价规模为75亿美元（约合人民币500亿元），远超最初计划的70亿美元。据知情人士透露，高峰时投资者下单总额约310亿美元，是发行规模的四倍多。这是苹果自2025年5月以来首次发行投资级债券，本次发行包含2年至10年不等的七档期限，承销机构包括美国银行、德意志银行、高盛集团和摩根大通。","reason","苹果公司美元债发行规模从70亿美元增至75亿美元，投资者认购金额达310亿美元，显示市场对其信用的高认可度。","source",{"_70":81},"links",{"_59":80},"publishedAt","2026-11-06T01:58:47.000Z","discoveredAt","2026-11-06T02:06:15.684Z","timelineAt","category","stock-us","tags",[78,79],"score",76,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author","jianli@jiemian.com(界面快报)","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","f1eICCjkZtgs","reportCount",4,"additionalSourceCount",3,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","funding","name","融资与并购","apple","Apple / 苹果",{"_75":76,"_11":77},"publicId","8a26e5fc-6099-4cfa-8e5e-ac681ed1b3b4","苹果发行七档美元债规模达75亿美元创历史新高","融资","Apple","https://www.jiemian.com/article/15301551.html","界面新闻",{"_83":84,"_85":-5},"changelogVersion","2026-10-01T08:00","release"]

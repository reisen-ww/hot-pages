[{"_1":2,"_3":4},"root",{"_5":80},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":34,"_52":53,"_54":55,"_56":34,"_57":58},"id","ir9aivuqjteeux3zyhbv2k590","title","OKX 创始人 Star Xu 建议用户暂缓 MEXC 直接转账","originalTitle","OKX founder Star Xu advises users to avoid direct MEXC transfers","summary","OKX 因 FinCEN 对 MEXC 的监管措施加强跨境资金风控，用户报告 USDT 存款被冻结。具体措施包括对 MEXC 链上资产实施与制裁同等级别的风险审查，且未给予 30 天过渡期。冻结案例涉及 ERC20 和 TRC20 USDT，风险地址判定标准为高合规风险钱包。当前观察点包括 OKX 是否在过渡期结束后放宽限制，以及其他交易所是否跟进类似措施。","reason","source",{"_69":79},"links",{"_58":78},"publishedAt","2026-11-08T00:48:59.000Z","discoveredAt","2026-11-08T00:59:38.875Z","timelineAt","category","crypto-market","tags",[77,72],"score",61,"selected",false,"channel","news","story",{"_74":75,"_11":76},"x","readingMode","full","author","John Chen","body","outline",[],"relatedStories",[73],"topics",[65,66],"indexable","markdownAvailable",true,"group",{"_59":60,"_61":62,"_63":64},"hasTranslation","bodyLanguage","original","factId","fyTMP78FNiW8","reportCount",5,"additionalSourceCount",3,{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","regulation","name","监管与政策","exchanges","交易所",{"_74":75,"_11":76},"publicId","0dcbff03-b118-4bbb-b19e-ae07660cac9d","OKX强制暂停MEXC USDT转入致账户冻结，行业分歧源于FinCEN模糊标准","监管处罚","https://cryptobriefing.com/okx-star-xu-avoid-mexc-transfers/","Crypto Briefing",{"_81":82,"_83":-5},"changelogVersion","2026-10-01T08:00","release"]

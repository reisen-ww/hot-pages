[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","iu8m4xxl9l2l6u941qiqqo97l","title","硫磺价格暴涨引爆化工行业成本重构","originalTitle","硫磺大行情，正在掀起化工行业的“成本风暴”","summary","国内硫磺价格年内涨幅近一倍，主要沿江港口库存降至去年同期一半。供给端因硫磺为油气炼化伴生品且装置刚性约束，价格难以快速平抑。产业链开始布局硫回收升级、伴生硫资源利用及替代制酸工艺，推动供应链脱敏进程。","reason","原文揭示了硫磺价格剧烈波动对化工产业链的深层影响，包括供给刚性约束、替代工艺可行性及供应链脱敏进程，为理解大宗商品供应链脆弱性提供案例参考。","source",{"_69":76},"links",{"_59":75},"publishedAt","2026-11-08T02:17:12.000Z","discoveredAt","2026-11-08T02:35:25.708Z","timelineAt","category","macro","tags",[70],"score",78,"selected",true,"channel","news","story",{"_72":73,"_11":74},"x","readingMode","full","author","深观商业","body","outline",[],"relatedStories",[71],"topics",[66],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","f7wPmGsvUsTQ","reportCount",1,"additionalSourceCount",0,{"_67":68,"_69":70},"slug","crypto-market","name","行情异动",{"_72":73,"_11":74},"publicId","9ed1fef4-1b67-4ecd-8151-01fc8fa543b2","国内硫磺价格年内翻倍致化工成本重构 产业链加速布局脱敏方案","https://www.tmtpost.com/8197413.html","钛媒体",{"_78":79,"_80":-5},"changelogVersion","2026-10-01T08:00","release"]

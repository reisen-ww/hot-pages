[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","ci7lgfhvqh2dkwk89bhrqj3u1","title","华尔街抛售引发超10亿美元加密资产清算 比特币以太坊价格重挫","originalTitle","Bitcoin erases post-election gains as Wall Street selloff hits $1B in liquidations","summary","11月5日比特币和以太坊因华尔街抛售导致价格下跌6%和7%，触发超10亿美元加密资产清算。市场同步出现纳斯达克指数5%跌幅，风险偏好转向保守。当前预测市场显示比特币维持高位概率从99.8%降至87.6%，24小时交易量持续攀升。","reason","原文提供了华尔街抛售引发加密市场超10亿美元清算的完整数据链，包含比特币以太坊跌幅、纳斯达克指数联动下跌及清算规模量化分析。","source",{"_69":80},"links",{"_59":79},"publishedAt","2026-11-05T20:13:27.000Z","discoveredAt","2026-11-05T20:24:10.864Z","timelineAt","category","crypto-market","tags",[70,77,78],"score",89,"selected",true,"channel","news","story",{"_74":75,"_11":76},"x","readingMode","full","author","Estefano Gomez","body","outline",[],"relatedStories",[73],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fVM3LwAlTU5A","reportCount",4,"additionalSourceCount",3,{"_68":71,"_69":72},{"_68":29,"_69":70},"slug","name","行情异动","bitcoin","比特币 / BTC",{"_74":75,"_11":76},"publicId","a70df653-45c2-40d0-8867-15d1353e1661","华尔街抛售致以太坊两日连跌超7% 触发超百亿美元加密资产清算","比特币","Bitcoin","https://cryptobriefing.com/bitcoin-erases-post-election-gains-as-wall-street-selloff-hits-1b-in/","Crypto Briefing",{"_82":83,"_84":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":65},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":-5,"_38":-5,"_39":40,"_41":42,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":-5,"_54":34,"_55":56},"id","cj4snyjozg6q3x06659gsp13v","title","Anthropic 谈判租赁爱德华堡附近超大规模数据中心校园","originalTitle","Anthropic in talks to lease hyperscale data center campus near Edmonton","summary","Anthropic 正在谈判租赁爱德华堡附近超大规模数据中心校园，若协议达成，将使阿尔伯塔省成为加拿大第二个拥有 Claude 模型算力支持的数据中心省份。目前仅处于谈判阶段，与EverWind Fuels在2026年10月16日签署的20年 Nova Scotia 数据中心租赁协议形成对比（该设施2027年底启动，初始95MW容量，2028年可扩展至420MW）。","reason","source",{"_60":64},"links",{"_56":63},"publishedAt","2026-10-30T18:42:07.000Z","discoveredAt","2026-10-30T18:55:21.766Z","timelineAt","category","crypto-policy","tags",[62],"score",74,"selected",false,"channel","news","story","x","readingMode","full","author","Diego Almada Lopez","body","outline",[],"relatedStories",[],"topics",[57],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_58":59,"_60":61},"slug","regulation","name","监管与政策","政策发布","https://cryptobriefing.com/anthropic-talks-lease-data-center-edmonton/","Crypto Briefing",{"_66":67,"_68":-5},"changelogVersion","2026-10-01T08:00","release"]

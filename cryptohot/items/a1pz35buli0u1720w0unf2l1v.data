[{"_1":2,"_3":4},"root",{"_5":75},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":-5,"_54":55,"_56":57},"id","a1pz35buli0u1720w0unf2l1v","title","币安黑客转移 81% 被盗 Solana，资金经 THORChain 跨链洗钱","originalTitle","Binance hackers move 81% of stolen Solana, route funds via THORChain","summary","币安黑客转移 81% 被盗 Solana 代币，通过 THORChain 跨链洗钱。FBI 将攻击归咎朝鲜黑客组「TraderTraitor」，并呼吁 THORNode 运营商拦截赃款交易。Chainalysis数据显示黑客在Tron和Solana链上完成47,600+笔交易，其中54%为自动化操作。THORChain 因技术故障暂停交易期间，意外延缓了黑客资金转移进程。","reason","原文提供了THORChain在洗钱中的操作路径、FBI对朝鲜黑客的追责声明及Chainalysis的链上资金追踪数据，读者可据此评估跨链协议在反洗钱中的风险。","source",{"_64":74},"links",{"_57":73},"publishedAt","2026-11-04T09:15:55.000Z","discoveredAt","2026-11-04T09:27:01.100Z","timelineAt","category","crypto-market","tags",[65,67,72,71],"score",88,"selected",true,"channel","news","story","x","readingMode","full","author","Cointelegraph by Zoltan Vardai","body","outline",[],"relatedStories",[],"topics",[58,59,60,61],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_62":70,"_64":71},{"_62":68,"_64":69},{"_62":66,"_64":67},{"_62":63,"_64":65},"slug","security","name","安全事件","exchanges","交易所","binance","Binance / 币安","solana","Solana","Binance","https://cointelegraph.com/news/binance-hackers-move-81-stolen-solana-route-thorchain?utm_source=rss_feed&utm_medium=rss&utm_campaign=rss_partner_inbound","Cointelegraph",{"_76":77,"_78":-5},"changelogVersion","2026-10-01T08:00","release"]

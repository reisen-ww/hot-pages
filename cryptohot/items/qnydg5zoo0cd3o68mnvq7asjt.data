[{"_1":2,"_3":4},"root",{"_5":68},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":35,"_51":35,"_52":-5,"_53":54,"_55":56},"id","qnydg5zoo0cd3o68mnvq7asjt","title","中际旭创遭近693亿资金减持 天孚通信获超80亿增持 机构调仓动向曝光","originalTitle","近693亿资金出逃中际旭创 超80亿资金增持天孚通信 机构最新调仓曝光","summary","中际旭创遭近693亿资金减持，天孚通信获超80亿增持，机构调仓聚焦半导体设备与港股估值修复。天相投资数据显示，三季度公募主动权益持仓市值缩水692.92亿元，但半导体设备公司天孚通信获增持80.89亿元。专家指出资金从AI上游硬件转向应用端及港股，同时提示2027年景气度见顶行业需规避，建议关注国产算力设备、AI应用拐点及消费医药等低配领域。","reason","原文提供了三季度公募机构对中际旭创减持692.92亿元、增持天孚通信80.89亿元的具体数据，并分析调仓方向从AI上游硬件转向应用端及港股低估值的操作逻辑。","source",{"_61":67},"links",{"_56":66},"publishedAt","2026-11-08T02:06:49.000Z","discoveredAt","2026-11-08T03:13:28.127Z","timelineAt","category","stock-us","tags",[62,65],"score",80,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[57,58],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_59":63,"_61":64},{"_59":60,"_61":62},"slug","earnings","name","财报","regulation","监管与政策","监管处罚","http://finance.eastmoney.com/news/1353,202611083925590526.html","东方财富",{"_69":70,"_71":-5},"changelogVersion","2026-10-01T08:00","release"]

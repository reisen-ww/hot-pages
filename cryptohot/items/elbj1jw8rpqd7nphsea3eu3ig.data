[{"_1":2,"_3":4},"root",{"_5":64},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":-5,"_38":-5,"_39":40,"_41":-5,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":34,"_50":51,"_52":-5,"_53":34,"_54":55},"id","elbj1jw8rpqd7nphsea3eu3ig","title","Anthropic估值缩水推进IPO：英国散户发行计划与融资规模调整","originalTitle","美国科技股遭猛烈抛售后 Anthropic执意推进IPO 估值较投资者预期大缩水","summary","Anthropic在美国科技股抛售后仍推进IPO，估值较预期缩水至1.25-1.75万亿美元，并计划通过英国散户发行融资800亿至1000亿美元。原文同时披露其竞争对手OpenAI估值从1.4万亿降至1.25万亿，融资规模从300亿缩减至200亿，以及日本计划募集35亿美元创海外IPO纪录。","reason","source",{"_59":63},"links",{"_55":62},"publishedAt","2026-11-08T03:03:00.000Z","discoveredAt","2026-11-08T03:28:42.303Z","timelineAt","category","stock-us","tags",[60,61],"score",62,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[56],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_57":58,"_59":60},"slug","earnings","name","财报","产品上线","http://finance.eastmoney.com/news/1354,202611083925595248.html","东方财富",{"_65":66,"_67":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":66},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":-5,"_38":-5,"_39":40,"_41":-5,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":34,"_50":51,"_52":-5,"_53":34,"_54":55},"id","vz6dsv8hvgrmi6qq2zg9h8qiu","title","中微公司获257家机构调研并宣布回购计划 订单创历史新高","originalTitle","中微公司近一周获257家机构调研 新签订单体量和增速均达历史新高 拟大手笔回购","summary","中微公司（688012）近一周获257家机构调研，包括53家证券公司、50家基金公司等，新签订单体量和增速均达历史新高，并宣布拟回购4亿至5亿元股份。立讯精密、联影医疗等个股也获百家机构调研，贝特利股价本周大涨超80%。中微公司计划推进贱金属浆料在光伏应用、导热材料在光模块等场景的布局，并提升电子浆料市场份额。","reason","source",{"_60":65},"links",{"_55":64},"publishedAt","2026-11-08T00:28:00.000Z","discoveredAt","2026-11-08T00:51:37.467Z","timelineAt","category","stock-cn","tags",[61,63],"score",59,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[56,57],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_58":62,"_60":63},{"_58":59,"_60":61},"slug","earnings","name","财报","semiconductor","半导体","http://finance.eastmoney.com/news/1354,202611083925579332.html","东方财富",{"_67":68,"_69":-5},"changelogVersion","2026-10-01T08:00","release"]

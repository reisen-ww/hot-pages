[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":-5,"_14":15,"_16":-5,"_17":18,"_19":20,"_21":22,"_23":24,"_25":24,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":40,"_41":42,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":33,"_51":52,"_53":54,"_55":33,"_56":57},"id","ywn9gpnx6oow90g2l5fv70bfz","title","苹果史上最好财报，却被内存拖住了后腿","originalTitle","summary","苹果2026年第三季度营收同比增长12%，净利润增长12%，但内存成本上涨导致毛利率承压。财报显示下一季度毛利率指引降至45%-46%，管理层指出内存价格处于'前所未有'水平。文章分析AI产业扩张对存储资源的需求，导致消费电子行业成本结构变化，并探讨苹果及同行可能的应对策略。","reason","source",{"_69":81},"links",{"_57":80},"publishedAt","2026-11-08T02:10:27.000Z","discoveredAt","2026-11-08T02:20:11.911Z","timelineAt","category","stock-us","tags",[70,72,79],"score",74,"selected",false,"channel","news","story",{"_76":77,"_11":78},"x","readingMode","full","author","节点AI","body","outline",[],"relatedStories",[75],"topics",[64,65,66],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","fgW0GtCqtxII","reportCount",1,"additionalSourceCount",0,{"_67":73,"_69":74},{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","earnings","name","财报","semiconductor","半导体","apple","Apple / 苹果",{"_76":77,"_11":78},"publicId","7c290e82-eddd-4a2a-9111-1cb9f5911988","苹果下调2027年Q1毛利率指引至45%-46%","Apple","https://www.tmtpost.com/8197412.html","钛媒体",{"_83":84,"_85":-5},"changelogVersion","2026-10-01T08:00","release"]

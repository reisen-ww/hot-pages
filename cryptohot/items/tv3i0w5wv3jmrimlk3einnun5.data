[{"_1":2,"_3":4},"root",{"_5":78},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","tv3i0w5wv3jmrimlk3einnun5","title","纽约商品交易所轻质原油期货一周暴跌12.76% 伦敦布伦特原油期货跌幅达16.42% 创2020年以来最大跌幅","originalTitle","油价一周暴跌超16% 主要受两方面因素影响","summary","纽约商品交易所12月轻质原油期货一周下跌12.76%，伦敦布伦特原油期货跌幅达16.42%，创2020年以来最大跌幅。下跌主因包括美国中期选举后军事冲突预期降温，以及中东原油供应宽松叠加出口增长10%至日均超1500万桶。","reason","source",{"_68":77},"links",{"_57":76},"publishedAt","2026-11-08T01:40:19.000Z","discoveredAt","2026-11-08T01:55:15.501Z","timelineAt","category","macro","tags",[69,71],"score",57,"selected",false,"channel","news","story",{"_73":74,"_11":75},"x","readingMode","full","author","body","outline",[],"relatedStories",[72],"topics",[64,65],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","fxVg6AvIz_y8","reportCount",5,"additionalSourceCount",1,{"_66":70,"_68":71},{"_66":67,"_68":69},"slug","crypto-market","name","行情异动","commodities","大宗商品",{"_73":74,"_11":75},"publicId","ff20557c-988e-42cc-9d70-14ddcbb982ae","美伊谈判推动国际油价单周暴跌创2020年以来最大跌幅","http://finance.eastmoney.com/news/1356,202611083925586935.html","东方财富",{"_79":80,"_81":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":76},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","cpyytgsnyfubiypbnaxn1eo9b","title","OpenAI完成110亿美元融资，估值达1.25万亿美元","originalTitle","OpenAI 完成 110 亿美元融资，公司估值达 1.25 万亿美元","summary","OpenAI宣布完成首笔110亿美元融资，公司估值升至1.25万亿美元，资金已于周五到账。本轮投资者包括Coatue Management和T. Rowe Price，软银、红杉资本等也参与投资。此前OpenAI计划融资300亿美元并估值1.4万亿美元，现因AI相关美股承压下调目标。","reason","原文提供了融资规模、估值变化及原计划的300亿美元融资目标被下调，读者可据此评估其对AI行业资本热度的影响。","source",{"_67":75},"links",{"_58":74},"publishedAt","2026-11-06T21:38:29.000Z","discoveredAt","2026-11-07T12:12:08.411Z","timelineAt","category","funding","tags",[73],"score",83,"selected",true,"channel","news","story",{"_70":71,"_11":72},"x","readingMode","full","author","body","outline",[],"relatedStories",[69],"topics",[65],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","fEDGf5gMt1sc","reportCount",12,"additionalSourceCount",6,{"_66":29,"_67":68},"slug","name","融资与并购",{"_70":71,"_11":72},"publicId","f66bb45f-7a09-4dd5-a43e-459575613913","OpenAI融资目标与估值双降至200亿及1.25万亿，完成110亿美元首轮认购并引入阿联酋财团","融资","https://www.panewslab.com/zh/articles/01a1b2cc-81fb-768a-8a02-32f89cdb540b","PANews",{"_77":78,"_79":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":34,"_52":53,"_54":55,"_56":57},"id","ad2vcqpmrhbvp2mrnzr6h638z","title","国务院金融工作报告提出下一步5方面重点考虑","originalTitle","国务院关于金融工作情况的报告提出我国金融工作下一步5方面考虑","summary","国务院11月3日向人大常委会提交金融工作报告，明确下一步将重点推进货币政策保持适度宽松、加强金融监管、提升服务实体经济适配性、深化金融改革与高水平开放、稳妥化解重点领域风险等5方面工作。报告披露2025年10月至2026年9月期间社会融资规模新增33万亿元，沪深A股88家企业IPO融资2472亿元（近九成为高新技术企业），金融'五篇大文章'贷款同比增长10.1%。","reason","source",{"_68":78},"links",{"_57":77},"publishedAt","2026-11-03T09:35:40.000Z","discoveredAt","2026-11-03T09:54:54.666Z","timelineAt","category","macro","tags",[76,71],"score",80,"selected",true,"channel","news","story",{"_73":74,"_11":75},"x","readingMode","full","author","body","outline",[],"relatedStories",[72],"topics",[64,65],"indexable","markdownAvailable","group",{"_58":59,"_60":61,"_62":63},"hasTranslation",false,"bodyLanguage","original","factId","fDLgilYh4pNo","reportCount",5,"additionalSourceCount",1,{"_66":70,"_68":71},{"_66":67,"_68":69},"slug","regulation","name","监管与政策","cny","人民币汇率",{"_73":74,"_11":75},"publicId","7b29198b-34d7-423f-9299-d00210eea007","中国人民银行延续宽松政策并部署金融改革与人民币国际化及风险防控措施","政策发布","http://finance.eastmoney.com/news/1345,202611033920330271.html","东方财富",{"_80":81,"_82":-5},"changelogVersion","2026-10-01T08:00","release"]

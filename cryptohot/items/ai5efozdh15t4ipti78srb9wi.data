[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","ai5efozdh15t4ipti78srb9wi","title","香港立法会通过加密货币税务报告法案，为2027年数据收集提前布局","originalTitle","Hong Kong Lawmakers Pass Crypto Tax Reporting Bill Weeks Before 2027 Data Collection Begins","summary","香港立法会通过加密货币税务报告法案，要求本地交易所、经纪商等机构从2027年开始收集用户交易数据，并于2028年与其他司法管辖区交换信息。法案依据OECD的Crypto-Asset Reporting Framework（CARF）和Common Reporting Standard（CRS），首次将数字金融产品纳入监管范围，并要求加强尽职调查和报告义务。","reason","法案明确了香港2027年加密货币税务数据收集的时间表，要求本地交易所等服务商从2027年起合规收集用户交易信息，2028年将与其他司法管辖区交换数据，影响相关机构的运营成本和流程调整。","source",{"_70":44},"links",{"_59":81},"publishedAt","2026-11-05T15:30:00.000Z","discoveredAt","2026-11-05T15:57:56.579Z","timelineAt","category","crypto-policy","tags",[78,79,80],"score",89,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author","Unchained","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fvOR9TS8NIuc","reportCount",8,"additionalSourceCount",5,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","regulation","name","监管与政策","sec","SEC / 美国证监会",{"_75":76,"_11":77},"publicId","43bd26f6-af26-4197-9ec1-8ac809e888a8","中国香港通过加密资产税务框架法案分阶段对接国际标准","政策发布","监管处罚","SEC","https://unchainedcrypto.com/hong-kong-lawmakers-pass-crypto-tax-reporting-bill-weeks-before-2027-data-collection-begins/",{"_83":84,"_85":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","bysn16hakoi7clv3ko8jd50c2","title","尼日利亚央行新规：外币稳定币发行方最低实缴150亿奈拉，P2P交易须核验BVN","originalTitle","尼日利亚央行发布《非证券虚拟资产运营条例》，外币稳定币发行方最低实缴资本150亿奈拉，P2P交易须核验BVN","summary","尼日利亚央行发布《非证券虚拟资产运营条例》，规定外币锚定稳定币发行方最低实缴150亿奈拉，P2P交易须核验银行验证号（BVN）。新规禁止算法稳定币，明确CBN与SEC的监管分工。","reason","读者可对比尼日利亚央行与SEC的分工，分析新规对跨境支付和稳定币发行的影响。","source",{"_69":80},"links",{"_58":79},"publishedAt","2026-11-06T09:13:42.000Z","discoveredAt","2026-11-06T09:28:14.379Z","timelineAt","category","crypto-policy","tags",[77,72,78],"score",88,"selected",true,"channel","news","story",{"_74":75,"_11":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[65,66],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","fbN3uqagA7_w","reportCount",3,"additionalSourceCount",2,{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","regulation","name","监管与政策","stablecoin","稳定币",{"_74":75,"_11":76},"publicId","c76f46d7-b285-4315-843a-cc44018a7246","尼日利亚央行出台加密资产监管新规：外币稳定币设150亿奈拉门槛，禁止算法版本并明确监管分工","政策发布","监管处罚","https://www.panewslab.com/zh/articles/01a1b022-a411-71c0-886c-b5c570c9a131","PANews",{"_82":83,"_84":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":71},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":-5,"_54":55,"_56":57},"id","d3oa6a1njr4a5zsphdjdyk4z7","title","法国立法机构通过加密货币自托管资产申报门槛调整案","originalTitle","France backs reporting for self-custodied crypto worth 100K euros or more","summary","法国国民议会通过修正案（I-2701），要求自托管加密货币持有者申报资产规模超10万欧元（约112,000美元），该门槛将于对应税务年度12月31日生效。法案原定10月20日表决两次推迟，最新进展可能影响整体立法进程。此前议会已否决1,000欧元以下加密支付免税提案，并暂缓讨论跨境转移税提案。","reason","读者可据此了解法国对加密货币监管的最新动态及法案推进风险","source",{"_62":70},"links",{"_57":69},"publishedAt","2026-11-04T13:44:52.000Z","discoveredAt","2026-11-04T14:36:36.219Z","timelineAt","category","crypto-policy","tags",[66,67,68],"score",83,"selected",true,"channel","news","story","x","readingMode","full","author","Cointelegraph by Zoltan Vardai","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_60":64,"_62":65},{"_60":61,"_62":63},"slug","regulation","name","监管与政策","sec","SEC / 美国证监会","监管处罚","政策发布","SEC","https://cointelegraph.com/news/france-approves-amendment-self-custodied-crypto-wallets-100k?utm_source=rss_feed&utm_medium=rss&utm_campaign=rss_partner_inbound","Cointelegraph",{"_72":73,"_74":-5},"changelogVersion","2026-10-01T08:00","release"]

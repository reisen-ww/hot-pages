[{"_1":2,"_3":4},"root",{"_5":76},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","n4jexxhl9se4l6bue8uf7qb3s","title","SignalPlus 用户安全事件赔付 81,897美元","originalTitle","SignalPlus：已全额赔付23名受影响用户，总计81897美元","summary","SignalPlus 完成对23名受影响用户的 81,897美元全额赔付，并启动安全升级措施。事件源于第三方 Telegram 账户入侵，导致未设置 IP 白名单的账户受损。平台已暂停相关服务并实施以下防护：提升 API 访问权限（需企业级验证）、强制启用 IP 白名单、收紧员工设备管控。服务将在完成系统审查与升级后逐步恢复。","reason","读者可参考 SignalPlus 的安全措施升级方案，如 IP 白名单验证和 API 访问权限强化，以防范类似网络攻击。","source",{"_68":75},"links",{"_58":74},"publishedAt","2026-11-08T03:14:19.000Z","discoveredAt","2026-11-08T03:15:29.962Z","timelineAt","category","crypto-market","tags",[69],"score",86,"selected",true,"channel","news","story",{"_71":72,"_11":73},"x","readingMode","full","author","body","outline",[],"relatedStories",[70],"topics",[65],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","faSbxfMjInl4","reportCount",13,"additionalSourceCount",7,{"_66":67,"_68":69},"slug","security","name","安全事件",{"_71":72,"_11":73},"publicId","6fbd5e4e-a36a-44c0-9052-6e8c36eb6792","币安移除SignalPlus API密钥并呼吁加强第三方平台安全管控","https://www.panewslab.com/zh/articles/01a1b926-553f-7707-8cbb-de9d959a450f","PANews",{"_77":78,"_79":-5},"changelogVersion","2026-10-01T08:00","release"]

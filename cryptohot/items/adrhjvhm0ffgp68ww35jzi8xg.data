[{"_1":2,"_3":4},"root",{"_5":74},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":35,"_51":35,"_52":-5,"_53":54,"_55":56},"id","adrhjvhm0ffgp68ww35jzi8xg","title","中信、国泰海通等五家券商完成第三批互换便利首批股票投资","originalTitle","已买入股票！中信、国泰海通、中金、银河、招商正式官宣！","summary","中信证券、国泰海通等五家券商完成第三批互换便利首批股票投资。11月3日央行开展第三批互换便利操作，金额扩大至1000亿元，支持资本市场发展。券商中国记者11月6日披露，中信证券、国泰海通等已通过央票互换、质押式回购等工具完成首批股票买入，银河证券、招商证券同步披露操作进展。中信建投黄文涛分析称，此举可缓解机构流动性压力，长期或撬动更大规模资金流入A股。","reason","原文提供了第三批互换便利操作金额、券商参与情况及专家对市场影响的分析，读者可据此评估政策对A股流动性和机构配置的影响。","source",{"_63":73},"links",{"_56":72},"publishedAt","2026-11-06T10:39:06.000Z","discoveredAt","2026-11-07T12:12:07.650Z","timelineAt","category","stock-cn","tags",[71,68],"score",91,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[57,58,59,60],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_61":69,"_63":70},{"_61":67,"_63":68},{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","howto","name","教程与避坑","opinions","观点","research","研究报告","regulation","监管与政策","政策发布","http://finance.eastmoney.com/news/1345,202611063924941616.html","东方财富",{"_75":76,"_77":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":88},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","cn90i2qdnr2lxxl55xlzmzthd","title","以太坊基金会发布2029年分叉路线图","originalTitle","Ethereum outlines fork plan to reach Lean Ethereum by 2029","summary","以太坊基金会发布2029年分叉路线图，计划通过七次硬分叉升级至Lean Ethereum，涉及量子安全签名和递归STARK证明技术，预计新层级交易费用降低超10倍。社区对Glamsterdam和Hegotá分叉的接受度将影响后续进展。","reason","原文提供了以太坊分叉路线图的技术细节和预期影响，包括量子安全签名、递归STARK证明和分层状态模型带来的费用降低，可作为区块链协议升级的参考案例。","source",{"_72":87},"links",{"_59":86},"publishedAt","2026-11-05T01:19:21.000Z","discoveredAt","2026-11-05T01:46:34.583Z","timelineAt","category","crypto-defi","tags",[77,84,85],"score",82,"selected",true,"channel","news","story",{"_81":82,"_11":83},"x","readingMode","full","author","Vivian Nguyen","body","outline",[],"relatedStories",[80],"topics",[66,67,68,69],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fvLg3sIs7NSc","reportCount",3,"additionalSourceCount",2,{"_70":78,"_72":79},{"_70":76,"_72":77},{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","howto","name","教程与避坑","opinions","观点","research","研究报告","ethereum","以太坊 / ETH",{"_81":82,"_11":83},"publicId","43154873-8818-4762-b570-b260aa1bc525","以太坊基金会发布2029年分叉路线图，分阶段升级至Lean Ethereum","产品上线","Ethereum","https://cryptobriefing.com/ethereum-fork-plan-lean-ethereum-2029/","Crypto Briefing",{"_89":90,"_91":-5},"changelogVersion","2026-10-01T08:00","release"]

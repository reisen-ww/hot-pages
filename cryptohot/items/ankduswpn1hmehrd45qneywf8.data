[{"_1":2,"_3":4},"root",{"_5":86},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","ankduswpn1hmehrd45qneywf8","title","Bitwise与Coinbase高管支持Chainlink CCIP分模型设计","originalTitle","Bitwise and Coinbase executives back CCIP’s split model for real-world blockchain use","summary","Bitwise与Coinbase高管支持Chainlink CCIP分模型设计，该设计通过分离消息确认与执行步骤提升机构级跨链金融安全性。Coinbase于2025年12月将价值约700亿美元的代币资产迁移至CCIP，BitGo随后在2026年初将超777亿美元WBTC迁移至CCIP。","reason","原文指出CCIP 2.0已吸引Coinbase和BitGo等机构迁移超1500亿美元资产，并成为跨链金融的核心基础设施。","source",{"_72":85},"links",{"_59":84},"publishedAt","2026-11-03T19:49:48.000Z","discoveredAt","2026-11-03T19:53:30.062Z","timelineAt","category","crypto-defi","tags",[77,79],"score",91,"selected",true,"channel","news","story",{"_81":82,"_11":83},"x","readingMode","full","author","Estefano Gomez","body","outline",[],"relatedStories",[80],"topics",[66,67,68,69],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fghnKRk90pGo","reportCount",1,"additionalSourceCount",0,{"_70":78,"_72":79},{"_70":76,"_72":77},{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","howto","name","教程与避坑","opinions","观点","research","研究报告","coinbase","Coinbase",{"_81":82,"_11":83},"publicId","1759de2d-a12c-4e18-909c-3bd0c3430daa","Chainlink CCIP分模型获Bitwise和Coinbase高管支持，机构级跨链资产迁移规模达1547亿美元","https://cryptobriefing.com/bitwise-coinbase-back-ccip-split-model/","Crypto Briefing",{"_87":88,"_89":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","ckow50pvg9s92xdbb6g3lsdkj","title","HSBC 在 PayMe 上线首款稳定币 RedCoin","originalTitle","HSBC rolls out its first stablecoin to over 3 million everyday app users","summary","HSBC 在 PayMe 应用上线其首款稳定币 RedCoin（代号 RCHKD），330 万以上用户可在未来几天内激活稳定币钱包，用于向亲友转账并在超过 100,000 家商户支付。该港元代币由独立账户中的高质量流动资产全额支持。HSBC 计划今年晚些时候把 RedCoin 钱包加入香港手机银行应用，并让客户用它认购代币化投资产品，包括其现有港元货币市场基金的一个新股份类别。","reason","原文交代了牌照背景与后续扩展计划，读者可据此判断这家银行在稳定币支付上的推进节奏。","source",{"_70":80},"links",{"_59":79},"publishedAt","2026-10-23T10:22:56.000Z","discoveredAt","2026-10-23T10:43:37.604Z","timelineAt","category","crypto-defi","tags",[78,73,71],"score",74,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author","Francisco Rodrigues","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fak9j0SXaRO8","reportCount",11,"additionalSourceCount",8,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","hongkong","name","港股","stablecoin","稳定币",{"_75":76,"_11":77},"publicId","83a27fcf-cb0b-4dce-9b3a-6a998f42f11e","汇丰银行通过PayMe上线港元稳定币RedCoin，首周用户增长及储备机制引关注","产品上线","https://www.coindesk.com/business/2026/10/23/hsbc-rolls-out-its-first-stablecoin-to-over-3-million-everyday-app-users","CoinDesk",{"_82":83,"_84":-5},"changelogVersion","2026-10-01T08:00","release"]

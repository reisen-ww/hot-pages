[{"_1":2,"_3":4},"root",{"_5":67},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":35,"_51":35,"_52":-5,"_53":54,"_55":56},"id","a9j87odkgv3v7ut3rokehm5l9","title","加密行业本周融资规模显著回升 基础设施项目成资本焦点","originalTitle","Gate Ventures：数字金融基础设施持续吸引机构资本，风投市场融资规模显著回升","summary","本周全球加密行业披露融资13笔，总额13.75亿美元，其中基础设施项目占比超七成。主要案例包括：预测市场平台Kalshi完成10亿美元融资（估值400亿美元）；HIVE Digital获约1.29亿美元固定利率融资用于GPU算力基建；稳定币支付服务商PhotonPay完成4000万美元C轮融资并计划拓展全球支付网络。","reason","原文提供了本周加密行业融资规模及主要流向，读者可据此判断基础设施赛道在机构资本中的优先级。","source",{"_60":66},"links",{"_56":65},"publishedAt","2026-11-03T10:15:50.000Z","discoveredAt","2026-11-03T10:25:41.631Z","timelineAt","category","funding","tags",[64,63],"score",78,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[57,58],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_59":62,"_60":63},{"_59":29,"_60":61},"slug","name","融资与并购","stablecoin","稳定币","融资","https://www.panewslab.com/zh/articles/01a1a0e8-72b4-7485-b60e-190181d372bc","PANews",{"_68":69,"_70":-5},"changelogVersion","2026-10-01T08:00","release"]

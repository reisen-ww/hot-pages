[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":34,"_52":53,"_54":55,"_56":57},"id","a7o6l8tih9chdyimbkzuy4l8a","title","微软完成250亿美元10批次美元债券发行定价","originalTitle","微软完成250亿美元10批次债券定价，最长期限至2066年","summary","微软于2026年10月30日宣布完成10批次美元债券发行，总规模250亿美元，含2028-2029年浮动利率票据各10亿美元及2028-2066年固定利率票据230亿美元，票面利率4.85%-6.35%，较同期美债利差25-105个基点，穆迪及标普评级分别为Aaa和AAA。此为微软自2017年以来首次发行美元债券，11月4日交割。","reason","source",{"_68":78},"links",{"_57":77},"publishedAt","2026-10-30T10:28:39.000Z","discoveredAt","2026-10-30T10:39:45.703Z","timelineAt","category","stock-us","tags",[75,76],"score",73,"selected",true,"channel","news","story",{"_73":74,"_11":12},"x","readingMode","full","author","body","outline",[],"relatedStories",[72],"topics",[64,65],"indexable","markdownAvailable","group",{"_58":59,"_60":61,"_62":63},"hasTranslation",false,"bodyLanguage","original","factId","fyZJZIv9ApqE","reportCount",1,"additionalSourceCount",0,{"_66":70,"_68":71},{"_66":67,"_68":69},"slug","funding","name","融资与并购","microsoft","Microsoft / 微软",{"_73":74,"_11":12},"publicId","806e48f2-5e1c-4812-89e1-e1044a9f2541","融资","Microsoft","https://www.panewslab.com/zh/articles/01a18c5a-be9f-76dd-a56c-d634814b238c","PANews",{"_80":81,"_82":-5},"changelogVersion","2026-10-01T08:00","release"]

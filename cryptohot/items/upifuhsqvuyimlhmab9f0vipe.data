[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":-5,"_38":-5,"_39":40,"_41":-5,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":34,"_50":51,"_52":-5,"_53":34,"_54":55},"id","upifuhsqvuyimlhmab9f0vipe","title","高盛下调黄金目标价：2026年底目标价4150美元/盎司","originalTitle","金价回撤超30% 国际机构大幅下调目标价","summary","高盛集团11月5日发布研究报告，将2026年底黄金目标价从4650美元/盎司下调至4150美元/盎司，2027年底目标价从5400下调至4800美元/盎司，分析美联储政策、油价及股市波动对金价的多重影响，并指出央行购金和黄金ETF持仓的支撑作用。","reason","source",{"_62":71},"links",{"_55":70},"publishedAt","2026-11-08T03:35:25.000Z","discoveredAt","2026-11-08T04:00:09.839Z","timelineAt","category","macro","tags",[69,67],"score",58,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[56,57,58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":68,"_62":69},{"_60":66,"_62":67},{"_60":64,"_62":65},{"_60":61,"_62":63},"slug","howto","name","教程与避坑","opinions","观点","research","研究报告","crypto-market","行情异动","http://finance.eastmoney.com/news/1354,202611083925597140.html","东方财富",{"_73":74,"_75":-5},"changelogVersion","2026-10-01T08:00","release"]

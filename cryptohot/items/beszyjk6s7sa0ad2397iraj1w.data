[{"_1":2,"_3":4},"root",{"_5":80},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","beszyjk6s7sa0ad2397iraj1w","title","四川省发改委联合印发新型储能三年行动方案，规划新增超1300万千瓦储能","originalTitle","四川印发新型储能三年行动方案，规划新增储能超1300万千瓦，新能源ETF博时(516580)跟踪指数盘中涨超6%","summary","四川省发改委联合印发新型储能三年行动方案，规划新增超1300万千瓦储能。截至2026年11月5日10:38，跟踪该方案的博时新能源ETF（516580）盘中涨5.36%，前十大权重股包括宁德时代、阳光电源等。长江证券和国盛证券分析称，政策支持叠加绿证需求扩容或推动行业增长，但未明确给出投资建议。","reason","原文引用长江证券和国盛证券观点，指出政策支持叠加绿证需求扩容或推动行业增长，但未明确给出投资建议。","source",{"_69":79},"links",{"_59":78},"publishedAt","2026-11-05T02:56:06.000Z","discoveredAt","2026-11-05T03:06:21.998Z","timelineAt","category","crypto-market","tags",[70,77],"score",92,"selected",true,"channel","news","story",{"_74":75,"_11":76},"x","readingMode","full","author","jianli@jiemian.com(有连云)","body","outline",[],"relatedStories",[73],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","ffTkno-CXHtA","reportCount",1,"additionalSourceCount",0,{"_68":71,"_69":72},{"_68":29,"_69":70},"slug","name","行情异动","etf","加密 ETF",{"_74":75,"_11":76},"publicId","90307761-8e30-4cab-97dd-8690cb1acf60","四川新型储能政策推动博时新能源ETF盘中涨超6%","ETF","https://www.jiemian.com/article/15297051.html","界面新闻",{"_81":82,"_83":-5},"changelogVersion","2026-10-01T08:00","release"]

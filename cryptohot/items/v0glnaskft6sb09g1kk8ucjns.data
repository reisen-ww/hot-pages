[{"_1":2,"_3":4},"root",{"_5":66},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":35,"_51":35,"_52":-5,"_53":54,"_55":56},"id","v0glnaskft6sb09g1kk8ucjns","title","CoreWeave致信得州当选州长Hinojosa，寻求数据中心政策磋商","originalTitle","CoreWeave致信得州当选州长，寻求“数据中心磋商”","summary","CoreWeave致信得州当选州长Hinojosa，寻求数据中心政策合作。Hinojosa已明确在立法完成前暂停相关审批，解冻最早需等到2027年5月立法会期结束。政策风险涉及13GW数据中心容量（可供电1000万户家庭），可能冲击全美AI资本开支约1.6%-4.1%。CoreWeave表态支持Hinojosa'原则立场，称愿与其过渡团队就已获批项目推进及未来开发标准展开合作。","reason","原文提供了得州数据中心审批冻结时间表（最早2027年5月）及政策风险对全美AI资本开支的冲击测算（约1.6%-4.1%），读者可据此评估企业布局调整的紧迫性。","source",{"_60":65},"links",{"_56":64},"publishedAt","2026-11-08T00:59:27.000Z","discoveredAt","2026-11-08T01:01:39.467Z","timelineAt","category","crypto-policy","tags",[62,63],"score",79,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[57],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_58":59,"_60":61},"slug","regulation","name","监管与政策","政策发布","监管处罚","https://wallstreetcn.com/articles/3785464","华尔街见闻",{"_67":68,"_69":-5},"changelogVersion","2026-10-01T08:00","release"]

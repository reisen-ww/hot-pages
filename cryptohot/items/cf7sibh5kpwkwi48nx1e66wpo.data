[{"_1":2,"_3":4},"root",{"_5":66},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":-5,"_38":-5,"_39":40,"_41":42,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":-5,"_54":34,"_55":56},"id","cf7sibh5kpwkwi48nx1e66wpo","title","Anthropic AI自主处理26%核心研发工作，Sacks质疑其安全与监管风险","originalTitle","Anthropic’s AI now handles 26% of core R&D work, report says","summary","Anthropic宣布其AI系统已自主处理26%的核心研发工作，较今年2月提升25个百分点。总统顾问委员会主席David Sacks在X平台公开质疑其模型训练方法可能引发安全风险，并批评Anthropic将拒绝权编码进AI系统。当前正值Anthropic筹备IPO的关键期，其研发自动化进程与监管争议将直接影响招股书披露细节及资本市场反应。","reason","source",{"_60":65},"links",{"_56":64},"publishedAt","2026-10-31T01:20:12.000Z","discoveredAt","2026-10-31T01:22:53.755Z","timelineAt","category","crypto-policy","tags",[62,63],"score",63,"selected",false,"channel","news","story","x","readingMode","full","author","Diego Almada Lopez","body","outline",[],"relatedStories",[],"topics",[57],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_58":59,"_60":61},"slug","regulation","name","监管与政策","监管处罚","政策发布","https://cryptobriefing.com/david-sacks-anthropic-recursive-self-improvement/","Crypto Briefing",{"_67":68,"_69":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":67},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":-5,"_54":55,"_56":57},"id","bqtpuemqwzlrl43d8wy8g1246","title","民主党计划在选举胜利后限制数据中心扩张并推动AI立法","originalTitle","Democrats eye data center limits, AI legislation after electoral win","summary","民主党计划在选举胜利后限制数据中心扩张并推动AI立法，市场已反映相关风险。路易斯安那州可能实施数据中心禁令，国会立法动向和监管机构行动是关键观察指标。当前市场对2027-2029年禁令生效概率的赔率显示显著波动，反映政策不确定性。","reason","原文指出民主党计划通过立法限制数据中心扩张和AI发展，市场已反映相关风险，读者可关注后续政策动向及路易斯安那州可能的禁令措施。","source",{"_61":66},"links",{"_57":65},"publishedAt","2026-11-07T18:02:56.000Z","discoveredAt","2026-11-07T18:10:13.075Z","timelineAt","category","crypto-policy","tags",[63,64],"score",81,"selected",true,"channel","news","story","x","readingMode","full","author","Estefano Gomez","body","outline",[],"relatedStories",[],"topics",[58],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_59":60,"_61":62},"slug","regulation","name","监管与政策","监管处罚","政策发布","https://cryptobriefing.com/democrats-eye-data-center-limits-ai-legislation-after-electoral-win/","Crypto Briefing",{"_68":69,"_70":-5},"changelogVersion","2026-10-01T08:00","release"]

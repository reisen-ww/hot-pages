[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","ae3s37tllcklvm0m04zkhhhh8","title","比特币硬分叉eCash上线：持有者获等值ECX代币及交易现状","originalTitle","Bitcoin holders have received eCash — What can you do with it?","summary","2026年10月29日，LayerTwo Labs通过比特币硬分叉推出eCash网络，私钥持有者可获得等值ECX代币。目前ECX仅在NeoxEX和CoinW提供基础交易对，价格波动剧烈（CoinMarketCap报价$32.63，24h交易量约35.5万美元），需注意税务影响及后续开发者应用落地情况。","reason","比特币持有者可通过私钥获取等值ECX代币，当前交易市场仅NeoxEX和CoinW提供有限流动性，价格波动较大需关注开发者应用落地情况。","source",{"_70":82},"links",{"_59":81},"publishedAt","2026-11-07T13:30:00.000Z","discoveredAt","2026-11-07T13:52:33.089Z","timelineAt","category","crypto-defi","tags",[78,79,80],"score",85,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author","Cointelegraph by Christina Comben","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","f22-XoErerQI","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","crypto-market","name","行情异动","bitcoin","比特币 / BTC",{"_75":76,"_11":77},"publicId","568f1831-f8cc-4398-808d-17c68b00b727","LayerTwo Labs推eCash硬分叉，持币者获等值ECX","产品上线","比特币","Bitcoin","https://cointelegraph.com/magazine/bitcoin-holders-have-received-ecash-what-can-you-with-it?utm_source=rss_feed&utm_medium=rss&utm_campaign=rss_partner_inbound","Cointelegraph",{"_84":85,"_86":-5},"changelogVersion","2026-10-01T08:00","release"]

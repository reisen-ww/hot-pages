[{"_1":2,"_3":4},"root",{"_5":80},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":34,"_52":53,"_54":55,"_56":34,"_57":58},"id","a0coyij1u6ou1fkkyml6xhkzh","title","Holograph Foundation前员工非法铸造1亿HLG代币被判五年","originalTitle","Former Holograph Foundation employee sentenced to five years over $14M HLG token mint","summary","Holograph Foundation前员工Vitaliy K.因非法修改HLG代币铸造规则并盗取1亿枚代币（当时价值约$14M）被判五年监禁，其中两年实服并处罚款60万欧元。法院驳回基金会索赔请求，认定代币价格在犯罪前已暴跌至$0.001。Holograph Foundation目前处于清算状态，该案例显示传统刑法规制可追溯加密从业者。","reason","source",{"_69":79},"links",{"_58":78},"publishedAt","2026-11-08T04:19:06.000Z","discoveredAt","2026-11-08T04:21:29.203Z","timelineAt","category","crypto-policy","tags",[77,72],"score",63,"selected",false,"channel","news","story",{"_74":75,"_11":76},"x","readingMode","full","author","John Chen","body","outline",[],"relatedStories",[73],"topics",[65,66],"indexable","markdownAvailable",true,"group",{"_59":60,"_61":62,"_63":64},"hasTranslation","bodyLanguage","original","factId","fJoLctX_jQzw","reportCount",3,"additionalSourceCount",2,{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","regulation","name","监管与政策","security","安全事件",{"_74":75,"_11":76},"publicId","948b9930-2c06-4045-8ac3-bd01d66cca1d","乌克兰前员工盗取HLG代币被判5年，索赔被拒因证据不足","监管处罚","https://cryptobriefing.com/holograph-employee-sentenced-hlg-token-mint/","Crypto Briefing",{"_81":82,"_83":-5},"changelogVersion","2026-10-01T08:00","release"]

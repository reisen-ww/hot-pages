[{"_1":2,"_3":4},"root",{"_5":76},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":34,"_52":53,"_54":55,"_56":34,"_57":58},"id","c2enjyf189ydyxup0n1pe07i5","title","硫磺价格波动重塑化工行业成本结构","originalTitle","硫磺大行情，正在掀起化工行业的“成本风暴”","summary","今年以来，国内硫磺价格大幅上涨，最高达到每吨11600元，涨幅超210%。由于硫磺是油气炼化过程的副产品，其供给弹性受限，难以通过增产应对价格上行。这导致下游化工企业承受不同程度的成本压力，一体化厂商因内部对冲机制而更具韧性，而完全外购硫酸的中小工厂则面临更大挑战。随着供应链风险意识提升，企业开始探索多元化的硫资源保障体系，以降低对单一进口通道的依赖。","reason","source",{"_68":75},"links",{"_58":74},"publishedAt","2026-11-08T01:42:16.000Z","discoveredAt","2026-11-08T02:17:07.348Z","timelineAt","category","macro","tags",[69],"score",50,"selected",false,"channel","news","story",{"_71":72,"_11":73},"x","readingMode","full","author","jianli@jiemian.com(深观商业)","body","outline",[],"relatedStories",[70],"topics",[65],"indexable","markdownAvailable",true,"group",{"_59":60,"_61":62,"_63":64},"hasTranslation","bodyLanguage","original","factId","fHeA8O6R7Epc","reportCount",1,"additionalSourceCount",0,{"_66":67,"_68":69},"slug","crypto-market","name","行情异动",{"_71":72,"_11":73},"publicId","30733caa-d542-4d4f-9b74-1f734ee4047e","国内硫磺价格暴涨超210%挤压下游化工成本","https://www.jiemian.com/article/15307430.html","界面新闻",{"_77":78,"_79":-5},"changelogVersion","2026-10-01T08:00","release"]

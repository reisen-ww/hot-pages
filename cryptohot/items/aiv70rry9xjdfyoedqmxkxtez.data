[{"_1":2,"_3":4},"root",{"_5":66},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":-5,"_38":-5,"_39":40,"_41":42,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":-5,"_54":34,"_55":56},"id","aiv70rry9xjdfyoedqmxkxtez","title","Anthropic IPO面临投资级评级障碍","originalTitle","Anthropic may face hurdles for investment-grade rating after IPO, FT writer says","summary","Anthropic计划于11月中旬在纳斯达克上市（股票代码ANT），但面临BB+评级（投资级门槛为BBB-）的挑战。核心问题是其S-1招股书披露的未资金义务达417-430亿美元（含未来潜在支出或达750亿美元），涉及与Broadcom、Google、Amazon、Microsoft的长单合同。当前信用评级机构认为其现金流不足以覆盖债务，需观察IPO实际募资规模及后续季度亏损收窄情况","reason","source",{"_60":65},"links",{"_56":64},"publishedAt","2026-10-30T16:51:05.000Z","discoveredAt","2026-10-30T17:05:34.572Z","timelineAt","category","crypto-policy","tags",[62,63],"score",75,"selected",false,"channel","news","story","x","readingMode","full","author","Diego Almada Lopez","body","outline",[],"relatedStories",[],"topics",[57],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_58":59,"_60":61},"slug","regulation","name","监管与政策","监管处罚","政策发布","https://cryptobriefing.com/anthropic-investment-grade-rating-ipo-hurdles/","Crypto Briefing",{"_67":68,"_69":-5},"changelogVersion","2026-10-01T08:00","release"]

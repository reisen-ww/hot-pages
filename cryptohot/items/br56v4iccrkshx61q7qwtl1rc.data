[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","br56v4iccrkshx61q7qwtl1rc","title","协创数据：DDR存储短缺致报价上涨30%被市场接受","originalTitle","协创数据：存储方面DDR非常短缺，最近报价已提高30%且被接受","summary","协创数据发布投资者关系记录，指出当前DDR存储因HBM产能占用出现短缺，11月报价已上涨30%并被市场接受；同时消费类Flash闪存价格下降，而HDD因冷/温数据存储刚需价格稳步上涨。","reason","DDR存储因HBM产能占用出现短缺，近期报价上涨30%被市场接受，可作为判断存储行业供需变化的关键指标。","source",{"_71":81},"links",{"_59":80},"publishedAt","2026-11-03T11:56:32.000Z","discoveredAt","2026-11-03T12:12:14.955Z","timelineAt","category","macro","tags",[73,75],"score",80,"selected",true,"channel","news","story",{"_77":78,"_11":79},"x","readingMode","full","author","jianli@jiemian.com(界面快报)","body","outline",[],"relatedStories",[76],"topics",[66,67,68],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fV2vyXkW_kgw","reportCount",1,"additionalSourceCount",0,{"_69":74,"_71":75},{"_69":5,"_71":73},{"_69":70,"_71":72},"slug","howto","name","教程与避坑","数据发布","commodities","大宗商品",{"_77":78,"_11":79},"publicId","47f2f705-cc0a-4e0e-b8ac-2e5a7462bc6b","协创数据称DDR因HBM短缺报价上涨30%被市场接受","https://www.jiemian.com/article/15289089.html","界面新闻",{"_83":84,"_85":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":70},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":-5,"_54":55,"_56":57},"id","qst2kpg6fxafx5l8oos03oiqk","title","微软收缩算力合作与甲骨文续签合同揭示AI基础设施采购逻辑转变","originalTitle","Edge AI Daily 早报（11月8日）","summary","微软因甲骨文服务器搭载旧英伟达芯片不符合技术规格，宣布收缩与Nscale等新云供应商合作，同时甲骨文以高出原价20%续签GPU租赁合同，反映AI基础设施采购从规模扩张转向交付质量优先。","reason","微软因甲骨文算力设备不达标收缩合作，甲骨文续签合同揭示AI基础设施采购转向交付优先逻辑，高杠杆新云公司面临更大融资成本压力。","source",{"_62":69},"links",{"_57":68},"publishedAt","2026-11-08T00:58:37.000Z","discoveredAt","2026-11-08T01:01:39.378Z","timelineAt","category","stock-us","tags",[63,66,67],"score",80,"selected",true,"channel","news","story","x","readingMode","full","author","Edge AI Daily","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_60":64,"_62":65},{"_60":61,"_62":63},"slug","earnings","name","财报","regulation","监管与政策","政策发布","监管处罚","https://www.tmtpost.com/8197405.html","钛媒体",{"_71":72,"_73":-5},"changelogVersion","2026-10-01T08:00","release"]

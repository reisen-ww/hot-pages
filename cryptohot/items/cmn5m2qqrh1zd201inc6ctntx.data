[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","cmn5m2qqrh1zd201inc6ctntx","title","AI 行业下滑推动中国至印度地区贸易复苏","originalTitle","AI Slump Revives Asia’s Forgotten Trades From China to India","summary","美国中期选举后 AI 行业下滑，促使投资者重新评估亚洲市场策略。重点包括印度和越南等新兴市场，以及中国科技企业因通胀缓解和贸易紧张局势趋缓带来的机遇。Aberdeen Investments看好印度和越南市场，Lotus Asset Management 增持香港股指期货，Allianz Global Investors 关注医疗和消费领域。","reason","AI 行业下滑促使投资者重新评估亚洲市场，特别是中国和印度股票需求，以及通胀和贸易紧张局势缓解的影响。","source",{"_71":82},"links",{"_59":81},"publishedAt","2026-11-08T00:00:00.000Z","discoveredAt","2026-11-08T00:51:39.334Z","timelineAt","category","macro","tags",[76],"score",71,"selected",true,"channel","news","story",{"_78":79,"_11":80},"x","readingMode","full","author","Abhishek Vishnoi and Winnie Hsu","body","outline",[],"relatedStories",[77],"topics",[66,67,68],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","f2xZa8lioWEM","reportCount",1,"additionalSourceCount",0,{"_69":75,"_71":76},{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","howto","name","教程与避坑","opinions","观点","research","研究报告",{"_78":79,"_11":80},"publicId","cacecb9f-3946-4bf9-8967-1226a8725326","AI行业下滑助推中印贸易复苏及亚洲市场调整","https://www.bloomberg.com/news/articles/2026-11-08/ai-slump-revives-asia-s-forgotten-trades-from-china-to-india","Bloomberg Markets",{"_84":85,"_86":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","c0dzj268tnk4tr2hqsblcictl","title","TRON单日处理USDT稳定币转账量达194亿美元 超越以太坊市场份额","originalTitle","TRON leads stablecoin transfers with $19.4 billion in USDT volume in a single day","summary","TRON在单日处理194亿美元USDT稳定币转账量，占市场73%份额。Q3季度该网络处理总量达2.21万亿美元，日均约24亿美元。其USDT供应量占全网49.49%，收入占Layer1/Layer2总收入的93%。文章指出TRON通过零费率转账和低手续费策略巩固地位，并提到其首个USDT现货质押TRX ETF的推出。","reason","原文提供了2026年Q3稳定币转移市场份额和收入占比的核心数据，读者可据此评估TRON与以太坊在USDT生态中的竞争格局。","source",{"_69":78},"links",{"_59":77},"publishedAt","2026-11-03T22:12:39.000Z","discoveredAt","2026-11-03T22:14:29.096Z","timelineAt","category","crypto-market","tags",[70,72],"score",87,"selected",true,"channel","news","story",{"_74":75,"_11":76},"x","readingMode","full","author","Vivian Nguyen","body","outline",[],"relatedStories",[73],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fW7ZWdUoyAX8","reportCount",1,"additionalSourceCount",0,{"_68":71,"_69":72},{"_68":29,"_69":70},"slug","name","行情异动","stablecoin","稳定币",{"_74":75,"_11":76},"publicId","a4ce27c0-0634-4e17-8acd-e38bc1e45f66","TRON单日处理194亿USDT转账，占市场73%份额","https://cryptobriefing.com/tron-leads-usdt-stablecoin-transfer-volume/","Crypto Briefing",{"_80":81,"_82":-5},"changelogVersion","2026-10-01T08:00","release"]

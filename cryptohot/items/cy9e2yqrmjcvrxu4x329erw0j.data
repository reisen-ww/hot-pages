[{"_1":2,"_3":4},"root",{"_5":73},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":-5,"_54":55,"_56":57},"id","cy9e2yqrmjcvrxu4x329erw0j","title","美国九月科技硬件进口创纪录达$86.9 billion","originalTitle","US tech hardware imports hit a record $86.9 billion in September","summary","美国九月科技硬件进口创纪录达$86.9 billion，同比增长151%。计算机及配件进口分别增长$7.6亿和$5.7亿，但芯片进口下降$1.2亿。数据表明数据中心扩张正推动进口激增，导致九月贸易逆差收窄至$1050亿，其中61%由计算机及芯片贸易逆差贡献。作者指出需关注进口增速是否因项目落地放缓、芯片进口是否持续回落以及资本品进口是否持续高企。","reason","原文提供了美国九月科技硬件进口创纪录的具体数据，并分析了其对贸易逆差和供应链的影响","source",{"_64":72},"links",{"_57":71},"publishedAt","2026-11-06T23:22:57.000Z","discoveredAt","2026-11-07T12:11:50.587Z","timelineAt","category","macro","tags",[66,70,68],"score",80,"selected",true,"channel","news","story","x","readingMode","full","author","Diego Almada Lopez","body","outline",[],"relatedStories",[],"topics",[58,59,60,61],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_62":69,"_64":70},{"_62":67,"_64":68},{"_62":5,"_64":66},{"_62":63,"_64":65},"slug","howto","name","教程与避坑","数据发布","china-adr","中概股","semiconductor","半导体","https://cryptobriefing.com/us-tech-hardware-imports-record-september/","Crypto Briefing",{"_74":75,"_76":-5},"changelogVersion","2026-10-01T08:00","release"]

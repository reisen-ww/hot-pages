[{"_1":2,"_3":4},"root",{"_5":70},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":35,"_51":35,"_52":-5,"_53":54,"_55":56},"id","bpighca9tjrwl99dwibnnhhxw","title","马斯克中选败北致SpaceX五年期CDS刷新历史高位","originalTitle","马斯克“输掉”中选，SpaceX五年期CDS连创历史新高","summary","民主党在中期选举中赢得参众两院及得克萨斯州关键席位，将展开对SpaceX卫星军事用途及政府补贴的全面调查，导致其五年期信用违约互换（CDS）价格扩大24.5基点至286.56基点并刷新历史高位。分析指出，政策转向可能制约SpaceX基础设施扩张，并影响特斯拉与SpaceX的整合计划。","reason","对比分析大型科技公司信用走势分化，揭示选举结果对SpaceX基础设施扩张的潜在制约","source",{"_61":69},"links",{"_56":68},"publishedAt","2026-11-06T01:42:50.000Z","discoveredAt","2026-11-06T01:56:14.110Z","timelineAt","category","stock-us","tags",[65,66,67],"score",77,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[57,58],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_59":63,"_61":64},{"_59":60,"_61":62},"slug","regulation","name","监管与政策","tesla","Tesla / 特斯拉","监管处罚","政策发布","Tesla","https://wallstreetcn.com/articles/3785320","华尔街见闻",{"_71":72,"_73":-5},"changelogVersion","2026-10-01T08:00","release"]

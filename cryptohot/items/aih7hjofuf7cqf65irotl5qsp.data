[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","aih7hjofuf7cqf65irotl5qsp","title","Aave因Binance黑客事件冻结储备并调整利率机制","originalTitle","Aave borrowers faced up to 36% APR while a freeze blocked fresh collateral","summary","Aave在2026年10月29日Binance热钱包遭黑客攻击期间，冻结了相关储备并调整了利率机制。LlamaRisk分析显示，冻结期间稳定币储备利用率达92%-100%，借款人需继续支付最高36%的年化利息，而供应商因无法提现面临流动性压力。研究指出，通过降低利率参数Slope2可缓解借贷成本，但需在10月31日解冻后恢复原有设置以平衡供需。","reason","原文给出了费率与额度变化和开放范围，读者可以据此判断它会怎样影响自己的出入金成本。","source",{"_69":81},"links",{"_59":80},"publishedAt","2026-11-03T13:30:58.000Z","discoveredAt","2026-11-03T13:49:24.045Z","timelineAt","category","crypto-market","tags",[70,77,78,79],"score",82,"selected",true,"channel","news","story",{"_74":75,"_11":76},"x","readingMode","full","author","Andjela Radmilac","body","outline",[],"relatedStories",[73],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fkqjKljioGsw","reportCount",1,"additionalSourceCount",0,{"_68":71,"_69":72},{"_68":29,"_69":70},"slug","name","行情异动","defi","DeFi 与链上",{"_74":75,"_11":76},"publicId","b1fc2500-6839-4428-8d69-45d5d66617a7","Aave调整利率机制应对黑客攻击引发的储备冻结","比特币","以太坊","DeFi","https://cryptoslate.com/borrowers-faced-36-interest-rates-as-aave-froze-deposits-during-binance-hack/","CryptoSlate",{"_83":84,"_85":-5},"changelogVersion","2026-10-01T08:00","release"]

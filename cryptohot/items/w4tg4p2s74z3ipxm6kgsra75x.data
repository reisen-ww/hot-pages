[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","w4tg4p2s74z3ipxm6kgsra75x","title","美股科技股市盈率九年来首次低于大盘","originalTitle","九年来首次！美股科技股迈入“比大盘便宜”时代","summary","美股科技股远期市盈率首次跌破大盘至17倍（较2025年10月32倍缩水近半），标普500和纳斯达克指数本周跌幅约3%，半导体指数五周连跌近30%。Truist分析师认为市场进入‘利好敏感期’，建议增持小盘股对冲风险；部分交易员则认为当前为套现时机。","reason","对比科技股与大盘的估值变化，分析市场周期性波动及机构投资策略调整。","source",{"_69":78},"links",{"_58":77},"publishedAt","2026-11-08T00:07:12.000Z","discoveredAt","2026-11-08T00:51:37.570Z","timelineAt","category","stock-us","tags",[70,72],"score",80,"selected",true,"channel","news","story",{"_74":75,"_11":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[65,66],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","f1FQHyGZxBdI","reportCount",1,"additionalSourceCount",0,{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","crypto-market","name","行情异动","semiconductor","半导体",{"_74":75,"_11":76},"publicId","7dacb7ef-469d-41a1-9678-14cb52466c5d","美股科技股估值跌破大盘，半导体指数五周跌近30%","http://finance.eastmoney.com/news/1354,202611083925577821.html","东方财富",{"_80":81,"_82":-5},"changelogVersion","2026-10-01T08:00","release"]

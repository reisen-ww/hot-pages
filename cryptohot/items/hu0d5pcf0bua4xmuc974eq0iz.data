[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":34,"_52":53,"_54":55,"_56":34,"_57":58},"id","hu0d5pcf0bua4xmuc974eq0iz","title","罗氏速福达®从进博会展品到本土化爆款：三年销售额增长逾七倍","originalTitle","爆火流感药速福达，从进博开启本土化之路｜超夯博来品","summary","速福达®通过2019年进博会首秀进入中国市场，2021年获批上市后三年销售额增长逾七倍（2022年<1亿/2023年5亿/2024年7亿+），2024年实现上海本地化分包装生产。罗氏与中国企业合作推出儿童剂型及健康驿站服务，并借助小猪佩奇IP扩大科普覆盖。","reason","source",{"_68":76},"links",{"_58":75},"publishedAt","2026-11-08T00:00:00.000Z","discoveredAt","2026-11-08T00:43:35.679Z","timelineAt","category","macro","tags",[74],"score",67,"selected",false,"channel","news","story",{"_71":72,"_11":73},"x","readingMode","full","author","jianli@jiemian.com(黄华HH)","body","outline",[],"relatedStories",[70],"topics",[65],"indexable","markdownAvailable",true,"group",{"_59":60,"_61":62,"_63":64},"hasTranslation","bodyLanguage","original","factId","f1WGWM8KOIgc","reportCount",1,"additionalSourceCount",0,{"_66":67,"_68":69},"slug","regulation","name","监管与政策",{"_71":72,"_11":73},"publicId","9d0c8a44-a474-4427-8ba1-6031480a37a9","罗氏速福达中国本土化成效显著：本地生产+合作推广驱动增长","政策发布","https://www.jiemian.com/article/15307143.html","界面新闻",{"_78":79,"_80":-5},"changelogVersion","2026-10-01T08:00","release"]

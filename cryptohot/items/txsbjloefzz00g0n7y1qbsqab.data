[{"_1":2,"_3":4},"root",{"_5":75},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":-5,"_14":15,"_16":-5,"_17":18,"_19":20,"_21":22,"_23":24,"_25":24,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":40,"_41":42,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":33,"_51":52,"_53":54,"_55":33,"_56":57},"id","txsbjloefzz00g0n7y1qbsqab","title","油价一周暴跌超16%","originalTitle","summary","纽约商品交易所12月交货的轻质原油期货价格一周下跌12.76%，伦敦布伦特原油期货价格一周下跌16.42%，创2020年以来最大跌幅。油价下跌主要因美国与伊朗军事冲突升级风险降温及中东原油供应趋于宽松所致。","reason","source",{"_67":74},"links",{"_57":73},"publishedAt","2026-11-08T03:10:35.000Z","discoveredAt","2026-11-08T03:50:32.602Z","timelineAt","category","macro","tags",[68],"score",26,"selected",false,"channel","news","story",{"_70":71,"_11":72},"x","readingMode","full","author","jianli@jiemian.com(界面快报)","body","outline",[],"relatedStories",[69],"topics",[64],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","fHAlr3e56984","reportCount",5,"additionalSourceCount",1,{"_65":66,"_67":68},"slug","crypto-market","name","行情异动",{"_70":71,"_11":72},"publicId","ff20557c-988e-42cc-9d70-14ddcbb982ae","美伊谈判推动国际油价单周暴跌创2020年以来最大跌幅","https://www.jiemian.com/article/15307645.html","界面新闻",{"_76":77,"_78":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":-5,"_38":-5,"_39":40,"_41":-5,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":34,"_50":51,"_52":-5,"_53":34,"_54":55},"id","rrimvctym4jvu67i3retgi2zp","title","物理AI产业仍处早期爬坡阶段，三大瓶颈待解","originalTitle","物理AI升温背后：三大瓶颈待解 产业仍处于早期爬坡阶段","summary","近期宇树科技股价上涨超过50%，市场关注物理AI技术。物理AI旨在让AI进入真实世界完成任务，但仍面临模型、数据和算力等多道门槛。广州华睿智普创始人蔡镇辉指出，当前主要瓶颈包括数据稀缺、端侧算力不足及场景调试复杂。","reason","source",{"_62":71},"links",{"_55":70},"publishedAt","2026-11-08T01:39:51.000Z","discoveredAt","2026-11-08T01:55:15.552Z","timelineAt","category","macro","tags",[67,69],"score",30,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[56,57,58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":68,"_62":69},{"_60":66,"_62":67},{"_60":64,"_62":65},{"_60":61,"_62":63},"slug","howto","name","教程与避坑","opinions","观点","research","研究报告","semiconductor","半导体","http://finance.eastmoney.com/news/11158,202611083925586545.html","东方财富",{"_73":74,"_75":-5},"changelogVersion","2026-10-01T08:00","release"]

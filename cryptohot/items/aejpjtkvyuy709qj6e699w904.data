[{"_1":2,"_3":4},"root",{"_5":73},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":-5,"_54":55,"_56":57},"id","aejpjtkvyuy709qj6e699w904","title","Ripple宣布2026年收入目标达9亿美元，机构采用量增长三倍","originalTitle","Ripple targets $900M annualized revenue as institutional adoption triples in 2026","summary","Ripple宣布2026年收入目标达9亿美元，机构客户数量及合作伙伴规模增长三倍，并推出支持实时结算的稳定币RLUSD（市值2.6亿美元，同比增长88%）。其平台已服务超1700家机构，获得85项全球监管许可，2025年交易额达160万亿美元。Ripple与BNY合作开发贸易金融基础设施，Aviva Investors发行XRP链上代币化基金产品，同时扩展至期货和传统资产领域。","reason","原文提供了Ripple 2026年收入目标达9亿美元、机构客户数量及合作伙伴规模增长三倍，以及RLUSD稳定币市值增长88%等关键数据，读者可据此判断其市场扩张策略对行业基础设施整合的影响。","source",{"_63":72},"links",{"_57":71},"publishedAt","2026-10-28T15:36:42.000Z","discoveredAt","2026-10-28T15:46:58.419Z","timelineAt","category","crypto-market","tags",[65,68,69,70],"score",78,"selected",true,"channel","news","story","x","readingMode","full","author","John Chen","body","outline",[],"relatedStories",[],"topics",[58,59,60],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_61":66,"_63":67},{"_61":29,"_63":65},{"_61":62,"_63":64},"slug","regulation","name","监管与政策","行情异动","ripple","Ripple / XRP","政策发布","Coinbase","Binance","https://cryptobriefing.com/ripple-institutional-adoption-growth-2026/","Crypto Briefing",{"_74":75,"_76":-5},"changelogVersion","2026-10-01T08:00","release"]

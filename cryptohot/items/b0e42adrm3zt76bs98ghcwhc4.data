[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","b0e42adrm3zt76bs98ghcwhc4","title","美国财政部因涉嫌16亿美元非法资金流动切断MEXC与美国金融系统联系","originalTitle","U.S. Treasury Cuts Off MEXC From U.S. Financial System Over Alleged $16 Billion in Illicit Flows","summary","美国财政部以涉嫌16亿美元非法资金流动为由，通过FinCEN 9714条款切断MEXC与美国金融系统的联系。具体涉及俄罗斯、伊朗、朝鲜的制裁规避行为，包括与伊朗加密交易所的$1亿直接交易和A7制裁网络关联的$26M资金流动。该处罚同步于近期对朝鲜加密项目的制裁，并成为继Bitzlato后又一典型案例。","reason","原文提供了被制裁交易所的具体非法资金流动规模（$16亿）和时间跨度（2021-2026），并指出该处罚属于FinCEN 9714条款的首次应用案例，读者可据此对比其他受制裁交易所（如Bitzlato）的合规教训。","source",{"_70":81},"links",{"_59":80},"publishedAt","2026-11-06T21:28:56.000Z","discoveredAt","2026-11-07T12:11:54.067Z","timelineAt","category","crypto-policy","tags",[78,79],"score",85,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author","Micah Zimmerman","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fe1TmJAT3BqA","reportCount",7,"additionalSourceCount",5,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","regulation","name","监管与政策","crypto-market","行情异动",{"_75":76,"_11":77},"publicId","e69e835d-227a-476c-9c98-8f160ed2ad4e","美国财政部切断MEXC金融接口，指控规避多国制裁并修正金额","监管处罚","比特币","https://bitcoinmagazine.com/news/fincen-cuts-off-mexc-us-financial-system","Bitcoin Magazine",{"_83":84,"_85":-5},"changelogVersion","2026-10-01T08:00","release"]

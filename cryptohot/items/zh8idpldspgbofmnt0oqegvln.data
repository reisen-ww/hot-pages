[{"_1":2,"_3":4},"root",{"_5":70},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":35,"_51":35,"_52":-5,"_53":54,"_55":56},"id","zh8idpldspgbofmnt0oqegvln","title","美国中期选举后各州暂停数据中心许可，SpaceX与Anthropic合同条款或致AI算力格局巨变","originalTitle","中选之后“美国新增算力被锁死”，马斯克成为“AI格局胜负手”","summary","美国中期选举后，多州暂停发放新数据中心许可证，引发算力供应紧张。节目披露SpaceX与Anthropic的算力供应合同含90天退出条款，若触发或致AI产业格局重塑。超大规模云厂商或借机压制竞争对手，而依赖外部算力的公司面临成本激增风险，部分项目或被迫迁至海外。","reason","政策变化导致算力供应紧张，关键合同条款可能引发AI产业格局重塑。","source",{"_61":69},"links",{"_56":68},"publishedAt","2026-11-08T04:37:06.000Z","discoveredAt","2026-11-08T04:39:17.809Z","timelineAt","category","macro","tags",[65,64,66,67],"score",80,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[57,58],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_59":63,"_61":64},{"_59":60,"_61":62},"slug","regulation","name","监管与政策","semiconductor","半导体","监管处罚","Tesla","NVIDIA","https://wallstreetcn.com/articles/3785472","华尔街见闻",{"_71":72,"_73":-5},"changelogVersion","2026-10-01T08:00","release"]

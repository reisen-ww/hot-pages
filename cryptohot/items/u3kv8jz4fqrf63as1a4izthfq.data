[{"_1":2,"_3":4},"root",{"_5":76},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","u3kv8jz4fqrf63as1a4izthfq","title","法国男子因非法增发并盗取 10 亿枚 HLG 代币被判刑 5 年","originalTitle","法国男子因非法增发并盗取 10 亿枚 HLG 代币被判刑 5 年，其中 2 年实刑","summary","法国巴黎刑事法院判处一名乌克兰籍男子 5 年监禁，其中 2 年实刑，因在 2024 年 5 月至 8 月期间利用权限漏洞非法生成并盗取 10 亿枚 Holograph（HLG）代币，案发时价值约 1,400 万美元。其两名同伙分别被判 2 年监禁及罚款。","reason","source",{"_67":75},"links",{"_57":74},"publishedAt","2026-11-08T00:16:48.000Z","discoveredAt","2026-11-08T00:30:32.869Z","timelineAt","category","crypto-policy","tags",[73],"score",33,"selected",false,"channel","news","story",{"_70":71,"_11":72},"x","readingMode","full","author","body","outline",[],"relatedStories",[69],"topics",[64],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","fuS6_GT7A8Jo","reportCount",3,"additionalSourceCount",2,{"_65":66,"_67":68},"slug","regulation","name","监管与政策",{"_70":71,"_11":72},"publicId","948b9930-2c06-4045-8ac3-bd01d66cca1d","乌克兰前员工盗取HLG代币被判5年，索赔被拒因证据不足","监管处罚","https://www.chaincatcher.com/article/2302690","链捕手 ChainCatcher",{"_77":78,"_79":-5},"changelogVersion","2026-10-01T08:00","release"]

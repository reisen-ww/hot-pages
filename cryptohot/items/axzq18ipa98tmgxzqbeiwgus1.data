[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","axzq18ipa98tmgxzqbeiwgus1","title","拉丁美洲稳定币平台Takenos完成700万美元种子轮追加融资","originalTitle","稳定币金融平台 Takenos 完成 700 万美元种子轮追加融资，North Island Ventures 等领投","summary","拉丁美洲稳定币平台Takenos完成700万美元种子轮追加融资，由North Island Ventures和Road Capital Management领投。本轮融资使总融资额达1200万美元，平台目前已在拉美六国运营，年处理交易量超50亿美元，客户包括LATAM航空等全球企业。","reason","原文提供了融资总额、运营国家和年交易量数据，读者可据此评估平台在拉美市场的规模和商业潜力。","source",{"_68":78},"links",{"_58":77},"publishedAt","2026-11-06T01:59:54.000Z","discoveredAt","2026-11-06T02:55:28.304Z","timelineAt","category","funding","tags",[76,71],"score",60,"selected",true,"channel","news","story",{"_73":74,"_11":75},"x","readingMode","full","author","body","outline",[],"relatedStories",[72],"topics",[65,66],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","fwi_DlxjAN94","reportCount",2,"additionalSourceCount",1,{"_67":70,"_68":71},{"_67":29,"_68":69},"slug","name","融资与并购","stablecoin","稳定币",{"_73":74,"_11":75},"publicId","c89cd77a-c86f-4bfa-b719-26883e2d78f0","Takenos拉丁美洲稳定币平台获1200万美元融资并计划2027年拓展15国","融资","https://www.chaincatcher.com/article/2302248","链捕手 ChainCatcher",{"_80":81,"_82":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":67},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":-5,"_38":-5,"_39":40,"_41":-5,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":34,"_50":51,"_52":-5,"_53":34,"_54":55},"id","tqh8orslapznrprfv047r26ac","title","三季度‘翻倍基’高位跌落与资金加仓情况分析","originalTitle","警惕“买入即套牢”！“翻倍基”高位跌落 哪些获得了加仓？","summary","三季度15只主动权益基金份额增超10亿份，22只增超5亿份，部分‘翻倍基’逆势加仓创历史新高。案例显示银华集成电路份额净增75亿份居首，东方阿尔法科技智选等3只‘翻倍基’份额减少逾10亿份。基金经理通过调仓（如易方达产业机遇替换半导体持仓为医药/资源股）控制回撤，部分机构采取限购措施避免高位风险。嘉实、工银瑞信等机构认为当前市场估值收缩充分，政策托底与产业亮点支撑反弹机遇。","reason","source",{"_60":66},"links",{"_55":65},"publishedAt","2026-11-08T04:37:29.000Z","discoveredAt","2026-11-08T05:01:33.898Z","timelineAt","category","stock-cn","tags",[61,64],"score",73,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[56,57],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_58":62,"_60":63},{"_58":59,"_60":61},"slug","earnings","name","财报","regulation","监管与政策","监管处罚","http://money.eastmoney.com/news/1282,202611083925601067.html","东方财富",{"_68":69,"_70":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":63},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":-5,"_14":15,"_16":-5,"_17":18,"_19":20,"_21":22,"_23":24,"_25":24,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":-5,"_37":-5,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":33,"_49":50,"_51":-5,"_52":33,"_53":54},"id","dcgdff6qcfusbgfajwrjg2m5z","title","证监会6天立案13起 涉A股7公司、2控股股东、4实控人","originalTitle","summary","证监会于11月1日至6日期间立案调查13起案件，涉及7家A股上市公司、2家控股股东及4家实控人，涉嫌财务造假、信披违规、操纵市场等行为。具体包括奥精医疗（688613.SH）涉嫌虚假记载定期报告数据，万辰集团（300972.SZ）未及时披露关联交易，科力远（600478.SH）及控股股东湖南科力远高技术集团等涉嫌信披违规。","reason","source",{"_58":62},"links",{"_54":61},"publishedAt","2026-11-08T03:12:40.000Z","discoveredAt","2026-11-08T03:28:42.266Z","timelineAt","category","crypto-policy","tags",[60],"score",75,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[55],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_56":57,"_58":59},"slug","regulation","name","监管与政策","监管处罚","http://finance.eastmoney.com/news/1354,202611083925596393.html","东方财富",{"_64":65,"_66":-5},"changelogVersion","2026-10-01T08:00","release"]

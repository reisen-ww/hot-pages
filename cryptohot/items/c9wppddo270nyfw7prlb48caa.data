[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","c9wppddo270nyfw7prlb48caa","title","Nvidia CEO 被美国国会要求闭门说明与中国间谍关联","originalTitle","Nvidia's Huang is asked to brief Congress on reported Chinese spy relationship","summary","美国国会要求Nvidia CEO Jensen Huang于11月18日闭门说明与中国情报人员的关联。Nvidia回应称与客户会晤属正常商业行为，并强调将配合美国国家安全审查。涉及方包括美国众议院外事委员会主席Brian Mast、中国问题特别委员会主席John Moolenaar等议员。","reason","事件揭示了美国国会对中国科技企业渗透的担忧，Nvidia需在11月18日闭门听证中说明与疑似中国情报人员的互动及安全措施。","source",{"_69":80},"links",{"_58":79},"publishedAt","2026-11-05T21:09:56.000Z","discoveredAt","2026-11-05T21:23:27.950Z","timelineAt","category","crypto-policy","tags",[77,78],"score",82,"selected",true,"channel","news","story",{"_74":75,"_11":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[65,66],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","f1q81I1mgyW8","reportCount",1,"additionalSourceCount",0,{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","regulation","name","监管与政策","nvidia","NVIDIA / 英伟达",{"_74":75,"_11":76},"publicId","466e284c-97c0-4df6-b0a4-4e61313eff9c","美国国会要求Nvidia CEO闭门说明涉华间谍指控，Nvidia回应称属正常商业行为","监管处罚","NVIDIA","https://www.cnbc.com/2026/11/05/nvidia-jensen-huang-china-spy-congress.html","CNBC Top News",{"_82":83,"_84":-5},"changelogVersion","2026-10-01T08:00","release"]

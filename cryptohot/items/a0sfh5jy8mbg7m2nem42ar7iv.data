[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","a0sfh5jy8mbg7m2nem42ar7iv","title","Coinbase称99%客户加密资产处于离线状态且难以被黑客攻击","originalTitle","Coinbase Says 99% of Customer Crypto Is Offline and Out of Hackers’ Reach","summary","Coinbase宣布99%客户加密资产存储于离线冷钱包，并详细介绍了分片私钥、提现速率限制、异常检测和物理隔离机制。原文对比了Binance黑客事件与Coinbase安全措施，指出后者通过多层防护降低风险，同时提到行业其他案例如巴西Mercado Bitcoin和法国Crédit Mutuel Arkéa的网络安全事件。","reason","原文给出了Coinbase的冷钱包分片私钥、热钱包提现速率限制、异常交易拦截和物理隔离机制，为其他交易所提供安全架构改进参考。","source",{"_71":83},"links",{"_59":82},"publishedAt","2026-11-04T20:46:03.000Z","discoveredAt","2026-11-05T01:46:42.042Z","timelineAt","category","crypto-market","tags",[74,81,76],"score",85,"selected",true,"channel","news","story",{"_78":79,"_11":80},"x","readingMode","full","author","Decrypt Staff","body","outline",[],"relatedStories",[77],"topics",[66,67,68],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fPYj4M4txyuQ","reportCount",6,"additionalSourceCount",4,{"_69":75,"_71":76},{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","regulation","name","监管与政策","security","安全事件","coinbase","Coinbase",{"_78":79,"_11":80},"publicId","75432d17-7ee4-4a62-bc2f-d3a8fe03a96b","Coinbase回应币安热钱包事件：99%资产冷存储并实施五大保护措施","监管处罚","https://decrypt.co/382570/coinbase-99-percent-customer-crypto-offline-binance-hack","Decrypt",{"_85":86,"_87":-5},"changelogVersion","2026-10-01T08:00","release"]

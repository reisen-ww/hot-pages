[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":-5,"_14":15,"_16":17,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":34,"_52":53,"_54":55,"_56":57},"id","ckw2lgdxe21if09b1ptktcf3a","title","莫斯科交易所计划12月1日上线比特币、以太坊和USDT交易","originalTitle","summary","莫斯科交易所计划12月1日上线比特币、以太坊和USDT交易，交易时间为莫斯科时间06:50至23:50，与国家结算中心负责清算采用当日或次日结算，并提供掉期工具管理流动性。普通投资者需通过测试且每年最多购买30万卢布（约3700美元）加密资产，合格投资者无上限。报道援引莫斯科交易所副主席Anatoly Popov预测，俄罗斯首年加密交易量可能达4万亿卢布（约490亿美元）。","reason","读者可据此了解俄罗斯加密市场准入门槛及潜在交易规模变化","source",{"_69":83},"links",{"_57":82},"publishedAt","2026-11-04T05:18:43.000Z","discoveredAt","2026-11-04T05:51:26.804Z","timelineAt","category","crypto-market","tags",[79,70,80,81],"score",80,"selected",true,"channel","news","story",{"_76":77,"_11":78},"x","readingMode","full","author","body","outline",[],"relatedStories",[75],"topics",[64,65,66],"indexable","markdownAvailable","group",{"_58":59,"_60":61,"_62":63},"hasTranslation",false,"bodyLanguage","original","factId","fpZTotNT1rZM","reportCount",4,"additionalSourceCount",3,{"_67":73,"_69":74},{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","exchanges","name","交易所","ethereum","以太坊 / ETH","bitcoin","比特币 / BTC",{"_76":77,"_11":78},"publicId","29f71523-b9ce-45a7-9507-2e6011af6f40","莫斯科交易所计划12月1日上线比特币等交易，实施分级投资者制度","产品上线","Bitcoin","Ethereum","https://www.panewslab.com/zh/articles/01a1a4fe-c7a2-7101-9a3c-f261af07c65e","PANews",{"_85":86,"_87":-5},"changelogVersion","2026-10-01T08:00","release"]

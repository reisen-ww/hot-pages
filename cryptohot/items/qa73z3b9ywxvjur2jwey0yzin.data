[{"_1":2,"_3":4},"root",{"_5":66},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":35,"_51":35,"_52":-5,"_53":54,"_55":56},"id","qa73z3b9ywxvjur2jwey0yzin","title","一汽集团拟无偿划转15.45%富维股份股权 实控人变更为国务院国资委","originalTitle","一汽集团拟入主富维股份：15.45%股权无偿划转 实控人拟变更为国务院国资委","summary","一汽集团通过无偿划转15.45%富维股份股权，成为控股股东，并联合富奥股份形成一致行动关系，实控人变更为国务院国资委。富维股份前三季度营收102.49亿元（同比-28.19%），股价年内下跌19%，需关注后续国资审批及整合影响。","reason","原文提供了股权划转比例、控制权变更路径及财务数据，读者可据此评估对富维股份估值和业务整合的影响。","source",{"_60":65},"links",{"_56":64},"publishedAt","2026-11-08T01:12:23.000Z","discoveredAt","2026-11-08T01:55:15.661Z","timelineAt","category","stock-cn","tags",[62,63],"score",79,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[57],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_58":59,"_60":61},"slug","regulation","name","监管与政策","监管处罚","政策发布","http://finance.eastmoney.com/news/1354,202611083925584715.html","东方财富",{"_67":68,"_69":-5},"changelogVersion","2026-10-01T08:00","release"]

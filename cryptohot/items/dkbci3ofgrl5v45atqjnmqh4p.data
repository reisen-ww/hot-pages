[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","dkbci3ofgrl5v45atqjnmqh4p","title","布伦特原油单周暴跌创1988年以来最大纪录 对冲基金狂抛66亿美元","originalTitle","原油“暴跌一周”：8天前还是“战火纷飞”，中选后对冲基金狂卖66亿美元","summary","高盛报告显示布伦特原油本周单周跌幅达20%（从118美元跌至98美元下方），对冲基金净卖出66亿美元（未包含选举日当天8.7%暴跌），期权市场出现看涨信号。分析指出下周CFTC持仓报告或更难看，当前仓位已大幅出清，但地缘冲突可能引发反弹。","reason","高盛报告指出本周布伦特原油因选举结果和地缘紧张引发对冲基金大规模抛售，期权市场已出现看涨信号，下周持仓数据或进一步恶化。","source",{"_69":78},"links",{"_58":77},"publishedAt","2026-11-08T02:08:56.000Z","discoveredAt","2026-11-08T02:20:12.050Z","timelineAt","category","macro","tags",[70,72],"score",93,"selected",true,"channel","news","story",{"_74":75,"_11":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[65,66],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","f-KIU6CJTnhw","reportCount",1,"additionalSourceCount",0,{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","crypto-market","name","行情异动","commodities","大宗商品",{"_74":75,"_11":76},"publicId","887e965e-bcbe-4489-b074-3f2f94c16e11","布伦特原油单周暴跌创1988年以来最大纪录","https://wallstreetcn.com/articles/3785468","华尔街见闻",{"_80":81,"_82":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":-5,"_54":55,"_56":57},"id","b4gf8bp7bbfw5rl7mz0wkw619","title","AI巨头融资与支出风险：Meta发债、微软现金流承压、特斯拉收购HUMAIN","originalTitle","Edge AI Daily 早报（11月3日）","summary","Anthropic计划在纳斯达克以代码ANT挂牌，估值1.5万亿至2万亿美元，但面临客户集中度达48%、算力支出激增至8950亿美元等风险；Meta发行250亿美元债券，资本支出同比增120%致自由现金流为负；特斯拉收购HUMAIN 49%股权，加速AI算力布局，需关注AI行业债务风险与算力账单增长压力。","reason","Meta与微软的资本支出激增导致自由现金流恶化，而Anthropic的高估值依赖客户集中度与算力支出平衡，特斯拉通过收购HUMAIN布局AI算力基础设施，需关注AI行业债务风险与算力账单增长压力。","source",{"_64":76},"links",{"_57":75},"publishedAt","2026-11-03T00:15:43.000Z","discoveredAt","2026-11-03T00:31:30.772Z","timelineAt","category","stock-us","tags",[65,72,71,73,74],"score",83,"selected",true,"channel","news","story","x","readingMode","full","author","Edge AI Daily","body","outline",[],"relatedStories",[],"topics",[58,59,60,61],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_62":70,"_64":71},{"_62":68,"_64":69},{"_62":66,"_64":67},{"_62":63,"_64":65},"slug","earnings","name","财报","regulation","监管与政策","funding","融资与并购","security","安全事件","监管处罚","产品上线","融资","https://www.tmtpost.com/8191049.html","钛媒体",{"_78":79,"_80":-5},"changelogVersion","2026-10-01T08:00","release"]

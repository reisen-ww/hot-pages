[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","tua43w1vylequh5u7om19cgaa","title","纳斯达克宣布实施每周5天、每天23小时交易制度","originalTitle","定了！5×23！纳斯达克即将进入23小时交易时代","summary","纳斯达克宣布12月6日起实施每周5天、每天23小时交易制度，仅保留美东时间20:00-21:00一小时维护窗口。东吴证券分析称该制度将争夺ATS夜盘平台、ETF夜间定价及亚洲投资者交易窗口，同时提及ICE、Cboe、LSE、KRX等交易所近年延长交易时间的趋势。","reason","source",{"_68":78},"links",{"_57":77},"publishedAt","2026-11-08T01:46:02.000Z","discoveredAt","2026-11-08T01:55:15.450Z","timelineAt","category","stock-us","tags",[69,76],"score",74,"selected",false,"channel","news","story",{"_73":74,"_11":75},"x","readingMode","full","author","body","outline",[],"relatedStories",[72],"topics",[64,65],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","fJCj4KHetcyk","reportCount",1,"additionalSourceCount",0,{"_66":70,"_68":71},{"_66":67,"_68":69},"slug","earnings","name","财报","regulation","监管与政策",{"_73":74,"_11":75},"publicId","9c6f7b37-354b-4639-b396-e1b35f63ab95","纳斯达克宣布实施23小时交易制度，引发市场质量担忧","政策发布","http://finance.eastmoney.com/news/1354,202611083925587380.html","东方财富",{"_80":81,"_82":-5},"changelogVersion","2026-10-01T08:00","release"]

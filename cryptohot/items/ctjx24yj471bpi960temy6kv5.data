[{"_1":2,"_3":4},"root",{"_5":66},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":-5,"_38":-5,"_39":40,"_41":42,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":-5,"_54":34,"_55":56},"id","ctjx24yj471bpi960temy6kv5","title","Anthropic在招股书中指出美国数据中心禁令为增长最大风险","originalTitle","Anthropic flags US data center moratoriums as top growth risk in S-1 filing","summary","Anthropic在招股书中披露美国数据中心建设禁令可能显著影响其增长计划，已预留417亿美元用于计算资源相关支出。监管动态显示16个州正考虑此类禁令以缓解电网压力和环境影响，重点关注俄克拉荷马州2028年禁令概率达21%。公司还提及澳大利亚和加拿大市场的扩展可能缓冲美国监管限制带来的冲击。","reason","source",{"_60":65},"links",{"_56":64},"publishedAt","2026-10-28T19:25:52.000Z","discoveredAt","2026-10-28T19:27:24.904Z","timelineAt","category","crypto-policy","tags",[62,63],"score",70,"selected",false,"channel","news","story","x","readingMode","full","author","Estefano Gomez","body","outline",[],"relatedStories",[],"topics",[57],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_58":59,"_60":61},"slug","regulation","name","监管与政策","监管处罚","政策发布","https://cryptobriefing.com/anthropic-flags-us-data-center-moratoriums-as-top-growth-risk-in-s-1-filing/","Crypto Briefing",{"_67":68,"_69":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","cbtiyon8a9t2rkj3nr6406lr4","title","穆迪为Ripple的2.6亿美元RLUSD稳定币评级A2，OCC银行获批次日","originalTitle","Moody's Rates Ripple's $2.6B RLUSD Stablecoin A2, a Day After OCC Bank Approval","summary","穆迪为Ripple发行的2.6亿美元RLUSD稳定币授予A2长期评级和P-1短期评级（分别对应穆迪第六高长评和最高短评）。储备由美国国债等构成，覆盖率达103%；OCC批准Ripple国家信托银行管理储备，该行受纽约州和联邦双重监管。","reason","读者可据此评估RLUSD在机构市场中的合规性和储备安全性，进而判断其与USDT、USDC等现有稳定币的竞争潜力。","source",{"_71":83},"links",{"_59":82},"publishedAt","2026-10-28T12:16:30.000Z","discoveredAt","2026-10-28T12:53:27.408Z","timelineAt","category","crypto-policy","tags",[81,74],"score",76,"selected",true,"channel","news","story",{"_78":79,"_11":80},"x","readingMode","full","author","Decrypt Agent","body","outline",[],"relatedStories",[77],"topics",[66,67,68],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fEgtscIJV68k","reportCount",9,"additionalSourceCount",7,{"_69":75,"_71":76},{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","regulation","name","监管与政策","stablecoin","稳定币","ripple","Ripple / XRP",{"_78":79,"_11":80},"publicId","05e78bf2-e3ef-4a87-a792-0b11ff0161fc","Ripple信托银行获OCC批准，RLUSD成首受双重监管稳定币","监管处罚","https://decrypt.co/382030/moodys-rates-ripples-2-6b-rlusd-stablecoin-a2-a-day-after-occ-bank-approval","Decrypt",{"_85":86,"_87":-5},"changelogVersion","2026-10-01T08:00","release"]

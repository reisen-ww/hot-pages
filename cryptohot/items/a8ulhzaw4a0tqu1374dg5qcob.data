[{"_1":2,"_3":4},"root",{"_5":80},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","a8ulhzaw4a0tqu1374dg5qcob","title","国晟科技三光伏子公司停产面临被ST风险","originalTitle","光伏业务主要子公司临时停产 国晟科技：存在被ST的风险","summary","国晟科技因光伏业务三子公司自9月8日起停产，若12月7日前未恢复生产则存在被实施其他风险警示（ST）的可能。前三季度营收3.25亿元同比下降27.74%，归母净利润亏损1.57亿元，光伏业务订单锐减致现金流净额8919.69万元同比下降39.20%。","reason","原文提供了国晟科技前三季度营收下降27.74%、净利润亏损扩大及光伏业务子公司停产时间节点（12月7日），读者可据此评估其被ST风险。","source",{"_69":79},"links",{"_58":78},"publishedAt","2026-11-03T16:14:16.000Z","discoveredAt","2026-11-03T21:58:26.280Z","timelineAt","category","stock-cn","tags",[72,77],"score",79,"selected",true,"channel","news","story",{"_74":75,"_11":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[65,66],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","ff_aSvTCMbfw","reportCount",1,"additionalSourceCount",0,{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","bankruptcy","name","破产与清算","earnings","财报",{"_74":75,"_11":76},"publicId","3cb9cb0b-b75e-4c5e-9632-6c1e34dfbebe","国晟科技三家光伏子公司停产面临被ST风险","破产清算","http://finance.eastmoney.com/news/1354,202611033920628235.html","东方财富",{"_81":82,"_83":-5},"changelogVersion","2026-10-01T08:00","release"]

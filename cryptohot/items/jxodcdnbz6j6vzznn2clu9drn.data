[{"_1":2,"_3":4},"root",{"_5":80},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","jxodcdnbz6j6vzznn2clu9drn","title","Holograph前员工盗取10亿枚HLG代币被判5年有期徒刑","originalTitle","加密平台Holograph前员工因非法创建并盗取10亿枚HLG代币被判处5年有期徒刑","summary","法国巴黎刑事法院判处Holograph前员工5年有期徒刑，因其在2024年5月至8月间非法创建并盗取10亿枚HLG代币（当时价值约1400万美元）。法院驳回了Holograph Foundation的赔偿请求，认为缺乏直接因果证据。","reason","案件涉及10亿枚HLG代币盗取（价值约1400万美元），法院未认定币价下跌与欺诈行为直接相关。","source",{"_69":79},"links",{"_58":78},"publishedAt","2026-11-08T00:33:47.000Z","discoveredAt","2026-11-08T00:36:35.660Z","timelineAt","category","crypto-policy","tags",[77,72],"score",80,"selected",true,"channel","news","story",{"_74":75,"_11":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[65,66],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","f_YJlC79KIPM","reportCount",3,"additionalSourceCount",2,{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","regulation","name","监管与政策","security","安全事件",{"_74":75,"_11":76},"publicId","948b9930-2c06-4045-8ac3-bd01d66cca1d","乌克兰前员工盗取HLG代币被判5年，索赔被拒因证据不足","监管处罚","https://www.panewslab.com/zh/articles/01a1b893-5cc2-725c-b9e2-e0068200443b","PANews",{"_81":82,"_83":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":65},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":-5,"_38":-5,"_39":40,"_41":42,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":-5,"_54":34,"_55":56},"id","tomvug0sk1zvwez6ik5qcf1ll","title","宇树科技与红杉中国联合成立“杉宇·创计划”专注具身智能领域投资","originalTitle","宇树跟红杉都不想自己“努力”了？","summary","宇树科技与红杉中国宣布共同成立“杉宇·创计划”，专注投资具身智能等前沿硬科技领域。宇树科技第三季度营收同比增长69.93%，但净利润下降，显示其面临成本投入增加的压力，需借助外部资本分摊风险。随着具身智能赛道竞争加剧，传统财务VC正更多依赖产业方进行投资。","reason","source",{"_60":64},"links",{"_56":63},"publishedAt","2026-11-08T02:17:16.000Z","discoveredAt","2026-11-08T02:35:25.645Z","timelineAt","category","stock-cn","tags",[61,62],"score",44,"selected",false,"channel","news","story","x","readingMode","full","author","硅碳变量","body","outline",[],"relatedStories",[],"topics",[57],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_58":59,"_60":61},"slug","earnings","name","财报","合作","https://www.tmtpost.com/8197415.html","钛媒体",{"_66":67,"_68":-5},"changelogVersion","2026-10-01T08:00","release"]

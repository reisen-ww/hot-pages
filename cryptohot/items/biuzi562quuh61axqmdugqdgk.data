[{"_1":2,"_3":4},"root",{"_5":68},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":35,"_51":35,"_52":-5,"_53":54,"_55":56},"id","biuzi562quuh61axqmdugqdgk","title","国务院发布金融工作报告：支持中央汇金公司发挥类平准基金作用","originalTitle","国务院关于金融工作情况的报告：支持中央汇金公司发挥类平准基金作用 巩固完善资本市场稳市机制","summary","国务院发布《关于金融工作情况的报告》，明确支持中央汇金公司发挥类平准基金作用，巩固资本市场稳市机制。报告显示2025年10月至2026年9月社会融资规模新增33万亿元，人民币对美元汇率升值约5.8%，金融业机构总资产超560万亿元。下一步将完善货币政策框架，加强金融监管，支持科技创新和小微企业融资，推进人民币国际化及全球金融治理合作。","reason","原文提供了2025年10月至2026年9月的社会融资规模、人民币汇率升值幅度、金融机构资产规模等关键数据，以及支持中央汇金公司发挥类平准基金作用的具体政策工具","source",{"_61":67},"links",{"_56":66},"publishedAt","2026-11-05T04:22:09.000Z","discoveredAt","2026-11-05T05:11:40.445Z","timelineAt","category","macro","tags",[65,64],"score",80,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[57,58],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_59":63,"_61":64},{"_59":60,"_61":62},"slug","regulation","name","监管与政策","cny","人民币汇率","政策发布","http://finance.eastmoney.com/news/1344,202611053923339644.html","东方财富",{"_69":70,"_71":-5},"changelogVersion","2026-10-01T08:00","release"]

[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","v5x6zddp6hn9csl135pliiszi","title","湖南黄金回应收购估值敏感性：金价每波动5%影响估值4.2亿元","originalTitle","金价暴涨暴跌！湖南黄金近300页回应重要收购","summary","湖南黄金用近300页回复回应深交所问询，收购黄金天岳和中南冶炼的估值敏感性显示：金价每变动5%，矿业权评估值将波动约4.2亿元。四大变量中可采储量、投资总额影响较小（±2%），金价与折现率敏感度最高（弹性系数2.3倍）。公司以2018年以来金价周期为支撑，认为即便按历史最大回撤45%测算，当前评估价仍高于三年一期均价。","reason","source",{"_69":83},"links",{"_57":82},"publishedAt","2026-11-08T02:33:59.000Z","discoveredAt","2026-11-08T02:57:25.561Z","timelineAt","category","macro","tags",[70,79,80,81],"score",64,"selected",false,"channel","news","story",{"_76":77,"_11":78},"x","readingMode","full","author","body","outline",[],"relatedStories",[75],"topics",[64,65,66],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","fMow0wWa1cro","reportCount",1,"additionalSourceCount",0,{"_67":73,"_69":74},{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","crypto-market","name","行情异动","inflation","通胀与就业","rates","利率与流动性",{"_76":77,"_11":78},"publicId","659b18fa-bb11-4ecb-aef0-6c009c37be27","湖南黄金收购估值对金价高度敏感","比特币","美联储","通胀","http://finance.eastmoney.com/news/1354,202611083925592039.html","东方财富",{"_85":86,"_87":-5},"changelogVersion","2026-10-01T08:00","release"]

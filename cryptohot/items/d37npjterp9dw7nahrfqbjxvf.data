[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","d37npjterp9dw7nahrfqbjxvf","title","法国国民议会通过加密资产申报修正案","originalTitle","法国国民议会通过修正案，拟要求申报10万欧元以上自托管加密资产","summary","法国国民议会通过第I-2701号修正案，拟要求纳税人申报合计价值至少10万欧元的自托管加密资产（以纳税年度12月31日为准）。该条款属于2027年财政法案，需保留在最终法案中方可生效。国民议会须在11月17日前完成法案一读，参议院计划11月20日开始审议。此外，议会否决了全年加密货币支付收益免税不超过1000欧元的修正案。","reason","该修正案是否通过取决于后续审议，且因否决免税条款可能引发争议，需关注后续进展。","source",{"_69":81},"links",{"_58":80},"publishedAt","2026-11-04T14:04:20.000Z","discoveredAt","2026-11-04T14:36:43.362Z","timelineAt","category","crypto-policy","tags",[77,78,79],"score",62,"selected",true,"channel","news","story",{"_74":75,"_11":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[65,66],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","fuk91jp_cEAY","reportCount",1,"additionalSourceCount",0,{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","regulation","name","监管与政策","sec","SEC / 美国证监会",{"_74":75,"_11":76},"publicId","711f58a0-bcda-4504-b1a1-41b6142386a3","法国国民议会通过加密资产申报修正案，要求10万欧元以上自托管资产披露","监管处罚","政策发布","SEC","https://www.panewslab.com/zh/articles/01a1a6df-fed4-74fe-8a41-ef6ed5a3de17","PANews",{"_83":84,"_85":-5},"changelogVersion","2026-10-01T08:00","release"]

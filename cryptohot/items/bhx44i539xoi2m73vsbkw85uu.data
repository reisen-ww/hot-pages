[{"_1":2,"_3":4},"root",{"_5":86},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","bhx44i539xoi2m73vsbkw85uu","title","比特币与以太坊交易所杠杆清算：24小时内蒸发超60亿美元多头头寸","originalTitle","$631M in crypto longs liquidated in 24 hours as leverage bites again","summary","24小时内加密货币市场因杠杆清算导致多头头寸蒸发超60亿美元。比特币清算量达20-41亿美元，以太坊为17-25亿美元，两者合计占当日总清算量的40%-50%。主要清算发生在Binance、Bybit、OKX交易所，其中Binance清算占比40%-50%。研究指出持续高杠杆是加密衍生品市场常态，价格剧烈波动会引发连锁清算效应。","reason","高杠杆环境下比特币和以太坊交易所清算规模达数十亿美元，揭示市场波动与强制平仓的关联性。","source",{"_70":85},"links",{"_59":84},"publishedAt","2026-11-05T15:37:13.000Z","discoveredAt","2026-11-05T15:46:31.004Z","timelineAt","category","crypto-market","tags",[71,80,81,82,83],"score",80,"selected",true,"channel","news","story",{"_77":78,"_11":79},"x","readingMode","full","author","John Chen","body","outline",[],"relatedStories",[76],"topics",[66,67,68],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","f-QeTPdJ6SsU","reportCount",4,"additionalSourceCount",0,{"_69":74,"_70":75},{"_69":72,"_70":73},{"_69":29,"_70":71},"slug","name","行情异动","ethereum","以太坊 / ETH","bitcoin","比特币 / BTC",{"_77":78,"_11":79},"publicId","706d0729-9482-413a-bb2a-54ebc8f37eb7","Binance主导超60亿美元加密多头强制平仓，以太坊与比特币损失居首","比特币","以太坊","Bitcoin","Ethereum","https://cryptobriefing.com/631m-crypto-longs-liquidated-24-hours/","Crypto Briefing",{"_87":88,"_89":-5},"changelogVersion","2026-10-01T08:00","release"]

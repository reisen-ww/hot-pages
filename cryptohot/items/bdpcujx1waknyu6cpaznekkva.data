[{"_1":2,"_3":4},"root",{"_5":87},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","bdpcujx1waknyu6cpaznekkva","title","黄仁勋回应AI投资三大焦点：GPU折旧期、CoreWeave债务与DeepSeek推理毛利","originalTitle","黄仁勋回应焦点：CoreWeave债务，GPU折旧期与DeepSeek推理高毛利","summary","黄仁勋在GTC柏林大会后接受雅虎财经采访，回应AI投资三大焦点：GPU折旧期从市场认定的4年重估为7至8年且高残值可作贷款抵押品，英伟达已为部分芯片转售残值提供担保以助CoreWeave等云厂商降低融资成本；英伟达推出DSX Pod模块化方案，拟把部署周期从四至六个月压缩至三至四个月甚至更短，缩短资本空窗期。","reason","黄仁勋把GPU折旧期与残值抵押讲成融资解法，配合DeepSeek毛利数据，读者可据此理解AI基建债务风险的争论焦点。","source",{"_71":86},"links",{"_58":85},"publishedAt","2026-10-22T04:07:39.000Z","discoveredAt","2026-10-22T04:42:34.556Z","timelineAt","category","opinion","tags",[83,76,84],"score",63,"selected",true,"channel","news","story",{"_80":81,"_11":82},"x","readingMode","full","author","body","outline",[],"relatedStories",[79],"topics",[65,66,67,68],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","fPlFeSHpfwVc","reportCount",2,"additionalSourceCount",1,{"_69":77,"_71":78},{"_69":75,"_71":76},{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","opinions","name","观点","speech","讲话与会议","semiconductor","半导体","nvidia","NVIDIA / 英伟达",{"_80":81,"_11":82},"publicId","10fada19-865b-4aa1-b3af-9b9926278a9c","黄仁勋宣布GPU寿命延长至8年，缓解AI投资融资风险","会议讲话","NVIDIA","https://wallstreetcn.com/articles/3784165","华尔街见闻",{"_88":89,"_90":-5},"changelogVersion","2026-10-01T08:00","release"]

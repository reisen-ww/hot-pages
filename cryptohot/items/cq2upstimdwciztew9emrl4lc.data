[{"_1":2,"_3":4},"root",{"_5":64},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":-5,"_29":30,"_31":32,"_33":34,"_35":36,"_37":-5,"_38":-5,"_39":40,"_41":42,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":34,"_52":-5,"_53":54,"_55":56},"id","cq2upstimdwciztew9emrl4lc","title","美国军方在波斯湾封锁中击沉第四艘商船（M/V Ocean Molica）","originalTitle","US forces disable commercial ship in Gulf of Oman amid naval blockade","summary","美国军方确认在波斯湾封锁中击沉一艘巴拿马籍商船 M/V Ocean Molica，系本月第四艘遭 disable 的船只。事件显示美国加强军事干预，市场对波斯湾控制权变化预期有所波动，Houthi占据佩里姆岛的胜率从10%升至11%。","reason","该事件可能影响波斯湾地区地缘政治格局，并反映市场对控制权变化的预期。","source",{"_60":63},"links",{"_56":62},"publishedAt","2026-11-07T20:39:05.000Z","discoveredAt","2026-11-07T20:46:30.279Z","timelineAt","category","tags",[61],"score",80,"selected",true,"channel","news","story","x","readingMode","full","author","Estefano Gomez","body","outline",[],"relatedStories",[],"topics",[57],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_58":59,"_60":61},"slug","crypto-market","name","行情异动","https://cryptobriefing.com/us-forces-disable-commercial-ship-in-gulf-of-oman-amid-naval-blockade/","Crypto Briefing",{"_65":66,"_67":-5},"changelogVersion","2026-10-01T08:00","release"]

4":197,"_176":198,"_178":192,"_179":199,"_12":200,"_182":201,"_184":202,"_186":187,"_10":188,"_189":-5},"qa73z3b9ywxvjur2jwey0yzin","一汽集团拟无偿划转15.45%富维股份股权 实控人变更为国务院国资委","一汽集团通过无偿划转15.45%富维股份股权，成为控股股东，并联合富奥股份形成一致行动关系，实控人变更为国务院国资委。富维股份前三季度营收102.49亿元（同比-28.19%），股价年内下跌19%，需关注后续国资审批及整合影响。","原文提供了股权划转比例、控制权变更路径及财务数据，读者可据此评估对富维股份估值和业务整合的影响。",{"_45":131},"2026-11-08T01:55:15.661Z","stock-cn",[190,203],79,"政策发布","ax7uur5kk1ny2y7sd975uv1v3t","2026-11-08T01:12:36.000Z",{"_169":207,"_28":208,"_172":209,"_174":210,"_176":211,"_178":205,"_179":212,"_12":181,"_182":213,"_184":214,"_186":187,"_10":188,"_189":-5},"x7uur5kk1ny2y7sd975uv1v3t","民主党接掌美国国会或提高加密立法门槛","民主党准备接掌美国国会可能提高加密行业立法门槛；行业转向跨党支持寻求长期发展；SEC 和 CFTC 仍可推进数字资产监管规则制定。","原文揭示了美国国会党派更迭对加密行业监管环境的影响，读者可关注政策变动对行业长期战略的影响。",{"_45":56},"2026-11-08T01:17:40.427Z",[190,203,215],63,"SEC","f34588","2026-11-08T01:15:02.000Z",{"_169":219,"_28":220,"_172":221,"_174":-5,"_176":222,"_178":217,"_179":223,"_12":224,"_182":225,"_184":226,"_186":187,"_10":188,"_189":-5},"lj08mxrfz6jhg1iljfjq10l7h","Loopscale所有金库存取款及贷款管理功能已恢复","Loopscale宣布所有金库存取款及贷款管理功能已恢复，此前因遭持续攻击暂停服务。该协议将很快发布技术复盘报告。",{"_45":53},"2026-11-08T01:24:45.590Z","crypto-defi",[227,228],64,"安全事件","产品上线","ar4d7lbnvd1n0zb4hz4w6tamvj","2026-11-08T01:30:39.000Z",{"_169":232,"_28":233,"_172":234,"_174":235,"_176":236,"_178":230,"_179":237,"_12":238,"_182":239,"_184":240,"_186":187,"_10":188,"_189":-5},"r4d7lbnvd1n0zb4hz4w6tamvj","科技股暴跌后华尔街策略师集体呼吁抄底","美国中期选举引发科技股暴跌，摩根士丹利、高盛等策略师集体呼吁抄底，标普500指数隐含8.4%反弹空间。费城半导体指数周四单日重挫12%，距6月高点累计跌幅达36%。策略师认为市场对AI投资收缩的担忧可能过度，Alphabet、亚马逊等科技巨头或因资本开支削减改善盈利预期。","原文提供了多家华尔街机构对AI投资前景的判断及标普500年底目标价预测，帮助读者评估当前市场风险与收益平衡。",{"_45":133},"2026-11-08T01:33:42.921Z","stock-us",[241,242,243,244,245,246,247],86,"行情异动","研究报告","Apple","Microsoft","Tesla","Google","Amazon","f34604","2026-11-08T01:40:00.000Z",{"_169":251,"_28":252,"_172":253,"_174":254,"_176":255,"_178":249,"_179":256,"_12":200,"_182":257,"_184":258,"_186":187,"_10":188,"_189":-5},"x4e21542ea994t5fl4xvlbqty","*ST威领控股股东拟无偿捐赠3.5亿改善财务状况","西藏山南锑金资源有限公司拟向*ST威领无偿捐赠3.5亿元用于改善资产负债结构，资金计入资本公积且无需支付对价。捐赠需在2026年12月31日前完成董事会及股东会审议，否则协议自动解除。此次捐赠与兴业银锡提供的5亿元综合融资担保同步落地，反映新控制方对公司的资金支持。*ST威领因2025年净资产为负且内部控制被出具否定意见，被实施退市风险警示。","原文指出捐赠将改善公司资产负债结构，缓解流动性压力，并提升持续经营能力，读者可据此评估公司财务风险变化。",{"_45":131},"2026-11-08T02:10:44.851Z",[259,260],77,"财报","破产清算","f34600","2026-11-08T01:43:59.000Z",{"_169":264,"_28":265,"_172":266,"_174":267,"_176":268,"_178":262,"_179":269,"_12":270,"_182":271,"_184":272,"_186":187,"_10":188,"_189":-5},"n1ygks1c0mzt7djkr1hpq0wue","黑客在 Hyperliquid 平台进行 BTC 多仓与 ETH 空仓操作，总价值达 2500 万美元","黑客通过 Tornado Cash 接收 3,100 枚 ETH 并兑换为 6,920 万 USDC，随后在 Hyperliquid 平台建立 BTC 多仓（价值 1,284 万美元）和 ETH 空仓（价值 1,283 万美元），合计价值约 2500 万美元。","原文提供了黑客利用 USDC 和 Hyperliquid 平台进行比特币多仓和以太坊空仓的具体操作细节和金额，读者可据此了解当前加密货币市场中的多空操作规模及风险分布。",{"_45":53},"2026-11-08T01:56:32.059Z","crypto-market",[227,273,274,275,276],72,"比特币","以太坊","Bitcoin","Ethereum","f34602","2026-11-08T01:56:07.000Z",{"_169":280,"_28":281,"_172":282,"_174":283,"_176":284,"_178":278,"_179":285,"_12":238,"_182":286,"_184":240,"_186":187,"_10":188,"_189":-5},"n9nxysqd00bt1ktpksf7m694i","伯克希尔·哈撒韦 Q3 净利润大降 28%，现金储备升至 3774 亿美元","伯克希尔·哈撒韦 Q3 净利润同比下降28.2%，投资收益缩水45.7%，现金储备升至3774亿美元。保险业务承保利润下降43%，股票回购创年内单季新高。","原文提供了伯克希尔Q3净利润同比下降28.2%、投资收益缩水45.7%及现金储备升至3774亿美元等核心数据，读者可据此评估其财务健康度与投资策略变化。",{"_45":56},"2026-11-08T02:04:32.659Z",[259],"aqnydg5zoo0cd3o68mnvq7asjt","2026-11-08T02:06:49.000Z",{"_169":290,"_28":291,"_172":292,"_174":293,"_176":294,"_178":288,"_179":295,"_12":238,"_182":296,"_184":297,"_186":187,"_10":188,"_189":-5},"qnydg5zoo0cd3o68mnvq7asjt","中际旭创遭近693亿资金减持 天孚通信获超80亿增持 机构调仓动向曝光","中际旭创遭近693亿资金减持，天孚通信获超80亿增持，机构调仓聚焦半导体设备与港股估值修复。天相投资数据显示，三季度公募主动权益持仓市值缩水692.92亿元，但半导体设备公司天孚通信获增持80.89亿元。专家指出资金从AI上游硬件转向应用端及港股，同时提示2027年景气度见顶行业需规避，建议关注国产算力设备、AI应用拐点及消费医药等低配领域。","原文提供了三季度公募机构对中际旭创减持692.92亿元、增持天孚通信80.89亿元的具体数据，并分析调仓方向从AI上游硬件转向应用端及港股低估值的操作逻辑。",{"_45":131},"2026-11-08T03:13:28.127Z",[259,190],80,"f34610","2026-11-08T02:08:56.000Z",{"_169":301,"_28":302,"_172":303,"_174":304,"_176":305,"_178":299,"_179":306,"_12":307,"_182":308,"_184":309,"_186":187,"_10":188,"_189":-5},"dkbci3ofgrl5v45atqjnmqh4p","布伦特原油单周暴跌创1988年以来最大纪录 对冲基金狂抛66亿美元","高盛报告显示布伦特原油本周单周跌幅达20%（从118美元跌至98美元下方），对冲基金净卖出66亿美元（未包含选举日当天8.7%暴跌），期权市场出现看涨信号。分析指出下周CFTC持仓报告或更难看，当前仓位已大幅出清，但地缘冲突可能引发反弹。","高盛报告指出本周布伦特原油因选举结果和地缘紧张引发对冲基金大规模抛售，期权市场已出现看涨信号，下周持仓数据或进一步恶化。",{"_45":133},"2026-11-08T02:20:12.050Z","macro",[241,310],93,"大宗商品","f34607","2026-11-08T02:13:08.000Z",{"_169":314,"_28":315,"_172":316,"_174":-5,"_176":317,"_178":312,"_179":318,"_12":181,"_182":319,"_184":297,"_186":187,"_10":188,"_189":-5},"z9d0xhucea55nlhyg1dqxu8r2","欧盟成立特别工作组打击俄罗斯通过加密货币规避制裁","欧盟宣布成立为期12个月的特别工作组，旨在遏制俄罗斯利用加密货币规避制裁的行为。该工作组将重点审查与俄罗斯相关的A7A5稳定币网络，并反映欧盟加强非传统金融渠道监管的趋势。",{"_45":114},"2026-11-08T02:17:07.528Z",[190,203],"f34617","2026-11-08T02:17:12.000Z",{"_169":323,"_28":324,"_172":325,"_174":326,"_176":327,"_178":321,"_179":328,"_12":307,"_182":329,"_184":330,"_186":187,"_10":188,"_189":-5},"iu8m4xxl9l2l6u941qiqqo97l","硫磺价格暴涨引爆化工行业成本重构","国内硫磺价格年内涨幅近一倍，主要沿江港口库存降至去年同期一半。供给端因硫磺为油气炼化伴生品且装置刚性约束，价格难以快速平抑。产业链开始布局硫回收升级、伴生硫资源利用及替代制酸工艺，推动供应链脱敏进程。","原文揭示了硫磺价格剧烈波动对化工产业链的深层影响，包括供给刚性约束、替代工艺可行性及供应链脱敏进程，为理解大宗商品供应链脆弱性提供案例参考。",{"_45":331},"2026-11-08T02:35:25.708Z",[241],78,"钛媒体","ag6yavvtzq12odbnpzzppfpbmd","2026-11-08T02:19:55.000Z",{"_169":335,"_28":336,"_172":337,"_174":338,"_176":339,"_178":333,"_179":340,"_12":238,"_182":341,"_184":342,"_186":187,"_10":188,"_189":-5},"g6yavvtzq12odbnpzzppfpbmd","美国中期选举重塑AI基础设施融资成本定价机制","11月5日美股AI板块崩塌，中概股逆势飘红。民主党重掌国会两院（众院237-147，参院54-44），德州等关键州政策转向限制数据中心审批，引发融资成本重估。","选票通过影响审批周期和税收政策，导致Meta等企业融资成本与市场风险溢价显性化，需关注州级政策落地与联邦否决权的博弈。",{"_45":331},"2026-11-08T02:35:25.511Z",[241,259,190],83,"afv2e7s64qf2evi5iiz2i0lcpc","2026-11-08T02:23:38.000Z",{"_169":346,"_28":347,"_172":348,"_174":349,"_176":350,"_178":344,"_179":351,"_12":307,"_182":352,"_184":297,"_186":187,"_10":188,"_189":-5},"fv2e7s64qf2evi5iiz2i0lcpc","下周中美CPI发布与Anthropic IPO路演及美债再融资关键日程","下周将发布中美10月CPI数据、俄美乌三方会谈结果及Anthropic IPO路演进展。韩国计划11月13日生效新政限制IPO后股价大跌，美债再融资规模达1250亿美元，超聚变等企业财报与超算大会同期举行。","中美CPI数据发布将影响美联储12月加息预期，韩国新政和Anthropic IPO路演构成市场估值压力测试。",{"_45":133},"2026-11-08T02:35:25.470Z",[203,259,353],"会议讲话","f34628","2026-11-08T02:33:20.000Z",{"_169":357,"_28":358,"_172":359,"_174":360,"_176":361,"_178":355,"_179":362,"_12":270,"_182":363,"_184":364,"_186":187,"_10":188,"_189":-5},"xgm88rme2po770zw8mpzfliwo","某巨鲸6天内从币安提取1.3万枚ETH","某巨鲸通过5笔交易从币安累计提取13,080枚ETH，价值约2,921万美元。最新一笔提取3,300枚ETH（价值737万美元），数据由Onchain Lens监测。","原文提供了某巨鲸在币安提取ETH的具体交易笔数、时间范围和金额，读者可据此评估市场流动性变化及潜在风险。",{"_45":56},"2026-11-08T02:35:24.730Z",[241,276],74,"f34651","2026-11-08T02:57:04.000Z",{"_169":368,"_28":369,"_172":370,"_174":371,"_176":372,"_178":366,"_179":373,"_12":307,"_182":374,"_184":330,"_186":187,"_10":188,"_189":-5},"kba2c5ifcobp1ftfujjotv07t","2026年中国能源投资总额或达9400亿美元","2026年中国能源投资总额或达9400亿美元。上半年煤电发电量占比降至49.7%，首次低于50%。我国可再生能源技术占据全球主导地位，风电设备供应70%，光伏组件供应80%。","原文提供了2026年能源投资总额预测、煤电发电量占比变化及可再生能源技术全球占比数据",{"_45":376},"2026-11-08T03:19:28.325Z",[375],"数据发布","界面新闻","f34653","2026-11-08T03:14:05.000Z",{"_169":380,"_28":381,"_172":382,"_174":383,"_176":384,"_178":378,"_179":385,"_12":270,"_182":386,"_184":387,"_186":187,"_10":188,"_189":-5},"itnugr9zah8im033bfw2xq8n2","Keplr钱包更新安全事件进展：部分Google/Apple社交账户私钥泄露，建议转移剩余资产","Keplr钱包宣布因Web3Auth漏洞导致部分Google/Apple社交登录账户私钥泄露，建议用户转移剩余资产。当前Google/Apple登录功能已暂停，部分账户可能因资产保护措施显示余额异常。官方提醒用户仅通过官方渠道获取信息，警惕冒充资产恢复的诈骗私信和链接。","原文提供了受影响账户的资产保护措施、用户应对建议及功能暂停状态，读者可据此评估自身账户风险及操作优先级。",{"_45":53},"2026-11-08T03:15:30.002Z",[227],65,"f34650","2026-11-08T03:14:19.000Z",{"_169":391,"_28":392,"_172":393,"_174":394,"_176":395,"_178":389,"_179":396,"_12":270,"_182":397,"_184":240,"_186":187,"_10":188,"_189":-5},"n4jexxhl9se4l6bue8uf7qb3s","SignalPlus 用户安全事件赔付 81,897美元","SignalPlus 完成对23名受影响用户的 81,897美元全额赔付，并启动安全升级措施。事件源于第三方 Telegram 账户入侵，导致未设置 IP 白名单的账户受损。平台已暂停相关服务并实施以下防护：提升 API 访问权限（需企业级验证）、强制启用 IP 白名单、收紧员工设备管控。服务将在完成系统审查与升级后逐步恢复。","读者可参考 SignalPlus 的安全措施升级方案，如 IP 白名单验证和 API 访问权限强化，以防范类似网络攻击。",{"_45":53},"2026-11-08T03:15:29.962Z",[227],"f34663","2026-11-08T03:30:09.000Z",{"_169":401,"_28":402,"_172":403,"_174":404,"_176":405,"_178":399,"_179":406,"_12":224,"_182":407,"_184":297,"_186":187,"_10":188,"_189":-5},"r8iyz0y10mn734aa41rd7o0we","Keplr钱包：部分通过Google/Apple登录账户私钥泄露，建议转移剩余资产","Keplr钱包因Web3Auth基础设施漏洞导致部分Google/Apple登录账户私钥泄露。建议受影响用户停止向相关账户转入新资金，并将剩余流动资产转至通过助记词或硬件钱包创建的账户。质押及锁定资产需后续处理，部分账户已显示余额减少或为空。","读者可通过转移资产规避风险",{"_45":56},"2026-11-08T03:52:49.722Z",[227],"azh8idpldspgbofmnt0oqegvln","2026-11-08T04:37:06.000Z",{"_169":411,"_28":412,"_172":413,"_174":414,"_176":415,"_178":409,"_179":416,"_12":307,"_182":417,"_184":297,"_186":187,"_10":188,"_189":-5},"zh8idpldspgbofmnt0oqegvln","美国中期选举后各州暂停数据中心许可，SpaceX与Anthropic合同条款或致AI算力格局巨变","美国中期选举后，多州暂停发放新数据中心许可证，引发算力供应紧张。节目披露SpaceX与Anthropic的算力供应合同含90天退出条款，若触发或致AI产业格局重塑。超大规模云厂商或借机压制竞争对手，而依赖外部算力的公司面临成本激增风险，部分项目或被迫迁至海外。","政策变化导致算力供应紧张，关键合同条款可能引发AI产业格局重塑。",{"_45":133},"2026-11-08T04:39:17.809Z",[190,418,245,419],"半导体","NVIDIA",{"_421":422,"_423":-5},"changelogVersion","2026-10-01T08:00","release"]

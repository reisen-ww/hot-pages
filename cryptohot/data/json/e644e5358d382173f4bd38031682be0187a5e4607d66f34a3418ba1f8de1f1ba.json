{"publicId":"043ebb0f-68e7-49fa-96a8-fcf1e701111e","title":"镁伽科技完成近2亿美元融资，累计达6亿美元","status":"active","reportCount":1,"sourceCount":1,"firstReportAt":"2026-11-19T01:18:03.000Z","latestAt":"2026-11-19T01:18:03.000Z","digest":"镁伽科技宣布完成新一轮近2亿美元融资，阿曼投资局（OIA）、亚投资本、Granite Asia等参与，累计融资达6亿美元，其中C轮融资规模近3亿美元。早先报道称C轮融资近3亿美元，但未明确累计总额；后续披露显示该轮融资后总融资额更新为6亿美元，且明确C轮具体金额为近3亿。融资主要用于自动驾驶技术研发及商业化落地，预计将加速其在L4级自动驾驶领域的布局。","digestUpdatedAt":"2026-11-19T02:34:17.880Z","summary":null,"excerpt":null,"latest":"镁伽科技完成近2亿美元新一轮融资","latestReport":{"id":"xhf30wsnt2irlet8rjmn1050v"},"whyHot":{"participants48h":1,"newParticipants6h":0,"recentReports24h":1,"observationComplete":true,"rank":null},"developments":[{"factId":"ffnZuljcK9dE","title":"镁伽科技完成新一轮近2亿美元融资","firstReportAt":"2026-11-19T01:18:03.000Z","reportCount":1,"representative":{"id":"xhf30wsnt2irlet8rjmn1050v","title":"镁伽科技完成近2亿美元新一轮融资","summary":"镁伽科技宣布完成近2亿美元融资，阿曼投资局（OIA）、亚投资本、Granite Asia等参与，累计融资达6亿美元，其中C轮融资近3亿美元。","source":{"name":"界面新闻","firstParty":false},"publishedAt":"2026-11-19T01:18:03.000Z","selected":false}}],"officialReports":[],"timeline":[{"id":"xhf30wsnt2irlet8rjmn1050v","title":"镁伽科技完成近2亿美元新一轮融资","summary":"镁伽科技宣布完成近2亿美元融资，阿曼投资局（OIA）、亚投资本、Granite Asia等参与，累计融资达6亿美元，其中C轮融资近3亿美元。","source":{"name":"界面新闻","firstParty":false},"publishedAt":"2026-11-19T01:18:03.000Z","selected":false}],"heat":[{"hour":"2026-11-19T03:00:00.000Z","heat":9.5,"participants":1},{"hour":"2026-11-19T04:00:00.000Z","heat":9.3,"participants":1},{"hour":"2026-11-19T08:00:00.000Z","heat":8.2,"participants":1},{"hour":"2026-11-19T09:00:00.000Z","heat":8,"participants":1},{"hour":"2026-11-19T10:00:00.000Z","heat":7.8,"participants":1},{"hour":"2026-11-19T11:00:00.000Z","heat":7.6,"participants":1},{"hour":"2026-11-19T12:00:00.000Z","heat":7.3,"participants":1},{"hour":"2026-11-19T13:00:00.000Z","heat":7.1,"participants":1},{"hour":"2026-11-19T14:00:00.000Z","heat":6.9,"participants":1}],"related":[],"topics":[{"slug":"funding","name":"融资与并购"}]}
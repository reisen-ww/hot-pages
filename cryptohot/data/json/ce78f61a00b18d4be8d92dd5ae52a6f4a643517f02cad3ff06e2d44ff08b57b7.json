36790dbca11bd5d8cfd6b2eb8177f8f4254d9fbbdd51e5390.webp 96w","itemId":null,"title":"财政部发布2026年上半年财政政策执行情况报告，将谋划增量政策扩大内需","summary":"财政部发布2026年上半年中国财政政策执行情况报告，表示将根据宏观经济运行情况及时谋划增量政策，加大逆周期调节力度，重点支持扩大内需、科技创新、产业升级和民生保障。","sourceName":"华尔街见闻","sourceUrl":"https://wallstreetcn.com/articles/3783265","publishedAt":"2026-10-09T07:34:30.000Z","firstParty":true,"available":true,"citationId":"r7js180905ngpph6sxl78nucs"},{"sourceIconUrl":"/hot-pages/cryptohot/data/media/93449494d1f483736790dbca11bd5d8cfd6b2eb8177f8f4254d9fbbdd51e5390.webp","sourceIconSrcSet":"/hot-pages/cryptohot/data/media/346b778cce9e0a65daba16f325d5fbe07959b87561ecaa9068f64b2c9592cdd6.webp 48w, /hot-pages/cryptohot/data/media/93449494d1f483736790dbca11bd5d8cfd6b2eb8177f8f4254d9fbbdd51e5390.webp 96w","itemId":null,"title":"“伊赛亚斯”升为三级飓风，美国墨西哥湾72%原油产能停产","summary":"飓风“伊赛亚斯”增强为三级飓风后，美国生产商暂停墨西哥湾约146万桶/日原油产量，占该地区总产量的72%，129座海上平台已撤离人员。供给收缩推动Mars原油较WTI升水约每桶3美元，Thunder Horse原油升水超过每桶4美元；与此同时，美国原油运往亚洲的油轮费用升至约7900万美元，约为2025年迄今平均水平的八倍以上。","sourceName":"华尔街见闻","sourceUrl":"https://wallstreetcn.com/articles/3783304","publishedAt":"2026-10-09T21:26:51.000Z","firstParty":true,"available":true,"otherSources":1,"citationId":"g0y7d3fzvrikwgk9h2ig6s5dl"},{"sourceIconUrl":null,"itemId":null,"title":"美国 CFTC 推动将事件合约纳入 swaps 监管","summary":"美国商品期货交易委员会（CFTC）发布一项临时最终规则并提议另一项规则，试图将事件合约明确纳入其监管的 swaps 范畴。新规将赌场式赌博排除在该定义之外，同时覆盖 Kalshi 和 Polymarket 等平台交易的体育、政治、文化及天气事件合约。相关政策正值 CFTC 与多个州围绕预测市场和体育博彩监管权限展开诉讼之际。","sourceName":"CoinDesk","sourceUrl":"https://www.coindesk.com/policy/2026/10/09/u-s-cftc-moves-to-fold-event-contracts-into-swaps-regulations-as-legal-fight-rages","publishedAt":"2026-10-09T21:21:54.000Z","firstParty":true,"available":true,"citationId":"b7i0i9sol3x7gm0b54ppioadx"},{"sourceIconUrl":"/hot-pages/cryptohot/data/media/bea8e42ecaae675437f1d85767b96c288a979621c45bc55640df59c09fbb8bcb.webp","sourceIconSrcSet":"/hot-pages/cryptohot/data/media/7d7829b963afe835d4c9469a5d6120eb74c71d1e68c29cdeefc94446a6c51266.webp 48w, /hot-pages/cryptohot/data/media/bea8e42ecaae675437f1d85767b96c288a979621c45bc55640df59c09fbb8bcb.webp 96w","itemId":null,"title":"Saudi Aramco将于下月向欧洲客户供应全部所需原油","summary":"Saudi Aramco告知欧洲炼油商，将在11月供应其申请的全部原油，此前沙特关键跨国管道在遭袭后恢复运行。供应恢复将缓解此前被迫寻找替代来源的客户压力。","sourceName":"Bloomberg Markets","sourceUrl":"https://www.bloomberg.com/news/articles/2026-10-09/aramco-to-supply-full-oil-volumes-to-europe-customers-next-month","publishedAt":"2026-10-09T15:05:11.000Z","firstParty":true,"available":true,"otherSources":1,"citationId":"xvztnk520jygt4y4su5f0sftr"}]},{"label":"行业动态","summary":null,"items":[{"sourceIconUrl":"/hot-pages/cryptohot/data/media/f6c9f78e45078dd1e9c20a05729886768a9dc1479ed49c96feeeb59890323758.webp","sourceIconSrcSet":"/hot-pages/cryptohot/data/media/2f28b8d2924d2e1af02f9354c19807c5a62d2c1c5baead9a4b34ed24c2491fb7.webp 48w, /hot-pages/cryptohot/data/media/f6c9f78e45078dd1e9c20a05729886768a9dc1479ed49c96feeeb59890323758.webp 96w","itemId":null,"title":"Evernorth完成与Armada Acquisition Corp. II的SPAC合并","summary":"由Ripple支持的XRP财库公司Evernorth已完成与Armada Acquisition Corp. II的SPAC业务合并，约4.73亿枚XRP及3亿美元现金总收益进入公开市场。Evernorth预计于下周一起以代码XRPN在Nasdaq交易，公司已向美国SEC提交8-K文件。","sourceName":"PANews","sourceUrl":"https://www.panewslab.com/zh/articles/01a12274-e4e3-7354-b9dc-241c593ae766","publishedAt":"2026-10-09T20:57:00.000Z","firstParty":true,"available":true,"otherSources":1,"citationId":"alsg79t47ps4lmcspte88bl60"},{"sourceIconUrl":null,"itemId":null,"title":"a16z领投TypeSafe AI $870 million Series A，估值达$7.5 billion","summary":"a16z领投TypeSafe AI约$870 million的Series A融资，使这家刚于2026年9月15日走出隐身模式的公司估值达到$7.5 billion。","sourceName":"Crypto Briefing","sourceUrl":"https://cryptobriefing.com/a16z-leads-typesafe-ai-series-a/","publishedAt":"2026-10-09T16:34:44.000Z","firstParty":false,"available":true,"otherSources":1,"citationId":"agrvu6283c46p5w22xwblu8hr"}]}],"flashes":[{"sourceIconUrl":"/hot-pages/cryptohot/data/media/bc82872ab80bd258d69d49d64a7d4596a29573dde9d7d58caf156856440a2559.webp","sourceIconSrcSet":"/hot-pages/cryptohot/data/media/2cd8f96042d65c570d5aeba09ed82b994df30d57b7996e76abd7c263e69143ac.webp 48w, /hot-pages/cryptohot/data/media/bc82872ab80bd258d69d49d64a7d4596a29573dde9d7d58caf156856440a2559.webp 96w","itemId":null,"title":"SpaceX收购全国频谱组合计划引发Verizon、T-Mobile和AT&T股价下跌","summary":"SpaceX宣布同意从Grain Management收购全国性频谱组合，以将Starlink互联网服务扩展至移动通信领域。消息公布后，Verizon股价下跌约7%，T-Mobile下跌12%，AT&T下跌约10%，SpaceX股价上涨约1%；交易包括最多14 MHz配对频谱，需经FCC批准。","sourceName":"CNBC Top News","sourceUrl":"https://www.cnbc.com/2026/10/09/verizon-att-tmobile-stocks-spacex-network.html","publishedAt":"2026-10-09T16:26:44.000Z","firstParty":true,"available":true,"citationId":"struwkxgu1hqxjen1x1gpf0o7"},{"sourceIconUrl":"/hot-pages/cryptohot/data/media/bc82872ab80bd258d69d49d64a7d4596a29573dde9d7d58caf156856440a2559.webp","sourceIconSrcSet":"/hot-pages/cryptohot/data/media/2cd8f96042d65c570d5aeba09ed82b994df30d57b7996e76abd7c263e69143ac.webp 48w, /hot-pages/cryptohot/data/media/bc82872ab80bd258d69d49d64a7d4596a29573dde9d7d58caf156856440a2559.webp 96w","itemId":null,"title":"Trump与Putin达成协议，俄罗斯将向美国及全球市场供应柴油","summary":"Trump表示，他已与Putin达成协议，俄罗斯将向全球市场供应数百万吨柴油。俄罗斯将立即供应超过300,000吨，11月供应500,000吨，随后立即供应1 million吨；之后还将根据炼厂状况再交付3 million吨。","sourceName":"CNBC Top News","sourceUrl":"https://www.cnbc.com/2026/10/09/trump-putin-russian-diesel-us-global-markets.html","publishedAt":"2026-10-09T19:19:00.000Z","firstParty":true,"available":true,"otherSources":4,"related":[{"sourceIconUrl":"/hot-pages/cryptohot/data/media/93449494d1f483736790dbca11bd5d8cfd6b2eb8177f8f4254d9fbbdd51e5390.webp","sourceIconSrcSet":"/hot-pages/cryptohot/data/media/346b778cce9e0a65daba16f325d5fbe07959b87561ecaa9068f64b2c9592cdd6.webp 48w, /hot-pages/cryptohot/data/media/93449494d1f483736790dbca11bd5d8cfd6b2eb8177f8f4254d9fbbdd51e5390.webp 96w","itemId":null,"title":"特朗普称普京同意俄罗斯向全球市场释放数百万吨柴油","summary":null,"sourceName":"华尔街见闻","sourceUrl":"https://wallstreetcn.com/articles/3783298","publishedAt":"2026-10-09T18:50:50.000Z","firstParty":true,"available":true,"citationId":"ty1y1iak0qa47wgzf7viochb5"}],"citationId":"ynyjtmmjq4l3qyp5gbm1ht3to"},{"sourceIconUrl":"/hot-pages/cryptohot/data/media/93449494d1f483736790dbca11bd5d8cfd6b2eb8177f8f4254d9fbbdd51e5390.webp","sourceIconSrcSet":"/hot-pages/cryptohot/data/media/346b778cce9e0a65daba16f325d5fbe07959b87561ecaa9068f64b2c9592cdd6.webp 48w, /hot-pages/cryptohot/data/media/93449494d1f483736790dbca11bd5d8cfd6b2eb8177f8f4254d9fbbdd51e5390.webp 96w","itemId":null,"title":"特朗普称可能在中选前对伊朗采取军事行动，伊朗石油运输受制裁影响","summary":"特朗普周五称美国可能在中期选举前对伊朗采取军事行动，较此前“不在中期选举前攻击伊朗”的表态出现变化。美国财政部对17艘运输伊朗原油、石油产品及石化产品的船只实施新一轮制裁，官员称约2000万桶伊朗原油滞留在船只上。霍尔木兹海峡本周二仅有400万桶原油通过，低于9月下旬每日约1500万桶的周均水平。","sourceName":"华尔街见闻","sourceUrl":"https://wallstreetcn.com/articles/3783305","publishedAt":"2026-10-09T22:26:33.000Z","firstParty":true,"available":true,"citationId":"alabj32ni0ifn7yre1hzvhg5f"},{"sourceIconUrl":"/hot-pages/cryptohot/data/media/bc82872ab80bd258d69d49d64a7d4596a29573dde9d7d58caf156856440a2559.webp","sourceIconSrcSet":"/hot-pages/cryptohot/data/media/2cd8f96042d65c570d5aeba09ed82b994df30d57b7996e76abd7c263e69143ac.webp 48w, /hot-pages/cryptohot/data/media/bc82872ab80bd258d69d49d64a7d4596a29573dde9d7d58caf156856440a2559.webp 96w","itemId":null,"title":"伊朗支持的胡塞武装袭击利雅得机场致3人死亡，沙特领导的联盟誓言强硬回应","summary":"伊朗支持的胡塞武装袭击沙特利雅得哈立德国王国际机场，造成包括一名飞行员在内的3名沙特人死亡，沙特领导的联盟称将作出强硬回应。袭击导致数百架航班取消，但沙特民航部门表示机场运行和空中交通已恢复正常。特朗普称美国将在美国中期选举后再决定是否攻击伊朗，Brent原油期货下跌1.3%至每桶$102.94，WTI期货下跌1%至每桶$90.51。","sourceName":"CNBC Top News","sourceUrl":"https://www.cnbc.com/2026/10/09/saudi-us-iran-war-trump-hormuz.html","publishedAt":"2026-10-09T10:37:42.000Z","firstParty":true,"available":true,"citationId":"i88cp4uzjfi5sbebvbigzl6rs"},{"sourceIconUrl":"/hot-pages/cryptohot/data/media/93449494d1f483736790dbca11bd5d8cfd6b2eb8177f8f4254d9fbbdd51e5390.webp","sourceIconSrcSet":"/hot-pages/cryptohot/data/media/346b778cce9e0a65daba16f325d5fbe07959b87561ecaa9068f64b2c9592cdd6.webp 48w, /hot-pages/cryptohot/data/media/93449494d1f483736790dbca11bd5d8cfd6b2eb8177f8f4254d9fbbdd51e5390.webp 96w","itemId":null,"title":"美国农业部上调玉米产量预估，玉米期货盘中跌6%","summary":"美国农业部将本年度玉米产量预估上调至约160亿蒲式耳，较上月增加1%，玉米期货盘中一度下跌6%至470.25美分/蒲式耳。玉米单产预估升至每英亩181.2蒲式耳，明显高于市场预期的177.8蒲式耳；农机、种子化学品和大宗商品贸易等相关股票同步承压。","sourceName":"华尔街见闻","sourceUrl":"https://wallstreetcn.com/articles/3783302","publishedAt":"2026-10-09T23:02:09.000Z","firstParty":true,"available":true,"citationId":"ir9i82hk2e1ouc3619algwq9f"},{"sourceIconUrl":null,"itemId":null,"title":"Anthropic 计划以超 2 万亿美元估值进行 IPO，招股书披露 AI 风险","summary":"Anthropic 计划以超过 $2 trillion 的估值进行 IPO，预计募资约 $100 billion；其 2025 年收入近 $4.6 billion，同比增长 12 倍。招股书约 300 页，披露了技术被用于网络攻击、生物恐怖主义及自我保存等风险；2025 年收入的 47% 来自 Amazon 和 Google 云市场，近 25% 来自两家客户。","sourceName":"Crypto Briefing","sourceUrl":"https://cryptobriefing.com/anthropic-ipo-valuation-ai-risks/","publishedAt":"2026-10-09T16:13:34.000Z","firstParty":false,"available":true,"citationId":"fbn0qrd12zizfm7gso2k24noy"},{"sourceIconUrl":"/hot-pages/cryptohot/data/media/f6c9f78e45078dd1e9c20a05729886768a9dc1479ed49c96feeeb59890323758.webp","sourceIconSrcSet":"/hot-pages/cryptohot/data/media/2f28b8d2924d2e1af02f9354c19807c5a62d2c1c5baead9a4b34ed24c2491fb7.webp 48w, /hot-pages/cryptohot/data/media/f6c9f78e45078dd1e9c20a05729886768a9dc1479ed49c96feeeb59890323758.webp 96w","itemId":null,"title":"Telegram向全体用户上线Gram钱包Money","summary":"Telegram旗下Walt官方频道宣布，此前仅向部分用户开放的Gram钱包已更名为Money，并向全体用户推广上线。Money支持存储和发送Gram，以及购买礼物和收藏版用户名；交易和投资通过Walt进行，支持300余种资产，用户可从Walt一键充值，转账即时到账且无网络手续费。","sourceName":"PANews","sourceUrl":"https://www.panewslab.com/zh/articles/01a12115-9599-72a6-b924-fa1076d7a0c3","publishedAt":"2026-10-09T14:33:00.000Z","firstParty":true,"available":true,"otherSources":1,"citationId":"lbcw3vf9p06th0570boxyqg3b"},{"sourceIconUrl":null,"itemId":null,"title":"英国以涉嫌协助俄罗斯规避制裁为由制裁三家加密交易所","summary":"英国宣布新增38项制裁，制裁三家加密交易所及多个支付平台，指其涉嫌协助俄罗斯规避西方制裁。英国外交、联邦及发展事务部称，两家被制裁企业曾处理或促成涉及A7网络的交易，该网络运营与卢布锚定的A7A5稳定币。相关实体在英国的资产将被冻结，英国金融机构也不得为部分企业处理付款。","sourceName":"CoinDesk","sourceUrl":"https://www.coindesk.com/policy/2026/10/09/uk-slaps-sanctions-on-three-crypto-exchanges-over-alleged-russia-links","publishedAt":"2026-10-09T10:14:59.000Z","firstParty":true,"available":true,"citationId":"aki9xjyjtp8vtbs2lvec6dt5w"},{"sourceIconUrl":"/hot-pages/cryptohot/data/media/bc82872ab80bd258d69d49d64a7d4596a29573dde9d7d58caf156856440a2559.webp","sourceIconSrcSet":"/hot-pages/cryptohot/data/media/2cd8f96042d65c570d5aeba09ed82b994df30d57b7996e76abd7c263e69143ac.webp 48w, /hot-pages/cryptohot/data/media/bc82872ab80bd258d69d49d64a7d4596a29573dde9d7d58caf156856440a2559.webp 96w","itemId":null,"title":"Delta Air Lines因燃油成本上涨下调2026年利润指引","summary":"Delta Air Lines表示，燃油价格上涨导致公司下调2026年调整后每股收益指引至$5.10至$5.60，低于7月预计的$6.50至$7.50。公司第三季度调整后营收为$17.59 billion，低于预期的$17.67 billion；调整后每股收益为$1.72，低于预期的$1.75。","sourceName":"CNBC Top News","sourceUrl":"https://www.cnbc.com/2026/10/09/delta-air-lines-dal-q3-2026-earnings.html","publishedAt":"2026-10-09T10:39:00.000Z","firstParty":true,"available":true,"otherSources":2,"citationId":"fo3yw8uhxaer2kyjor0zr2y81"},{"sourceIconUrl":"/hot-pages/cryptohot/data/media/93449494d1f483736790dbca11bd5d8cfd6b2eb8177f8f4254d9fbbdd51e5390.webp","sourceIconSrcSet":"/hot-pages/cryptohot/data/media/346b778cce9e0a65daba16f325d5fbe07959b87561ecaa9068f64b2c9592cdd6.webp 48w, /hot-pages/cryptohot/data/media/93449494d1f483736790dbca11bd5d8cfd6b2eb8177f8f4254d9fbbdd51e5390.webp 96w","itemId":null,"title":"伊朗称击中LPG船并扩大违规船只打击范围，霍尔木兹与曼德海峡航运风险上升","summary":"伊朗革命卫队称击中一艘试图经霍尔木兹海峡南部“非法航线”通行的LPG运输船，并警告对违规船只的行动不再局限于该海峡。Kpler称霍尔木兹仍开放但通航风险极高，日均约10艘商业船通过；沙特媒体还报道称胡塞武装在曼德海峡布设水雷，相关排雷行动已展开。","sourceName":"华尔街见闻","sourceUrl":"https://wallstreetcn.com/articles/3783297","publishedAt":"2026-10-09T16:08:06.000Z","firstParty":true,"available":true,"citationId":"m0dhv3mstotpzt0xyvsvj83kp"}],"cover":null,"metrics":{"totalEvents":12,"sourcesCount":10,"firstPartyEvents":10},"readingMinutes":5,"prev":"2026-10-09","next":"2026-10-11"}
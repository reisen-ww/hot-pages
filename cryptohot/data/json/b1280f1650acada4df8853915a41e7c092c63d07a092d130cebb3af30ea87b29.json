{"id":"lwcot9qw514dm7zqtlefpobfx","title":"微软申请专利：利用闲置计算能力训练AI","originalTitle":"Microsoft patent filing describes paying users for idle computing power to train AI","summary":"微软申请了一项专利，设想在用户不使用设备时利用其闲置的图形处理能力进行AI训练，并可能对设备主人进行补偿。该专利描述了一种系统，能够将大规模训练任务拆分成小任务分配给闲置的设备，同时确保不会干扰用户的正常使用。然而，专利中并未明确提及具体的补偿机制。","reason":null,"source":{"name":"Crypto Briefing"},"links":{"original":"https://cryptobriefing.com/microsoft-patent-idle-computing-power-ai/"},"publishedAt":"2026-11-11T19:30:41.000Z","discoveredAt":"2026-11-11T19:42:28.429Z","timelineAt":"2026-11-11T19:42:28.429Z","category":"crypto-defi","tags":["研究报告","半导体","Microsoft"],"score":36,"selected":false,"channel":"news","story":{"publicId":"092f3ec6-01da-4042-a735-d730135c1595","title":"微软申请AI训练专利：利用用户闲置计算力并可能补偿"},"x":null,"readingMode":"full","author":"Diego Almada Lopez","body":null,"outline":[],"relatedStories":[{"publicId":"092f3ec6-01da-4042-a735-d730135c1595","title":"微软申请AI训练专利：利用用户闲置计算力并可能补偿"}],"topics":[{"slug":"microsoft","name":"Microsoft / 微软"},{"slug":"semiconductor","name":"半导体"},{"slug":"research","name":"研究报告"},{"slug":"opinions","name":"观点"},{"slug":"howto","name":"教程与避坑"}],"indexable":false,"markdownAvailable":true,"group":{"factId":"f-4nb_aIOams","reportCount":1,"additionalSourceCount":0},"hasTranslation":false,"bodyLanguage":"original"}
{"id":"ai1jlkdptir23pnrw991x8s79","title":"住宅信贷为何成为房地产60万亿美元投资盲区及回归原因","originalTitle":"Why Private Residential Credit Is Real Estate's $60 Trillion Blind Spot","summary":"住宅信贷在机构投资组合中的占比长期偏低，主要原因在于2008年金融危机后银行收缩导致的原生基础设施空缺。如今，细分与分散化的贷款组合改变了与商业地产债务的风险对比，地方信贷评估基础设施和周期检验经验成为管理人选择的关键。当前，住宅信贷的收益率溢价、信用质量和基本面趋势使其重新受到关注。","reason":null,"source":{"name":"Seeking Alpha"},"links":{"original":"https://seekingalpha.com/article/4970221-why-private-residential-credit-real-estate-60-trillion-blind-spot?source=feed_all_articles"},"publishedAt":"2026-11-19T17:37:00.000Z","discoveredAt":"2026-11-19T17:53:09.827Z","timelineAt":"2026-11-19T17:53:09.827Z","category":"macro","tags":["研究报告"],"score":26,"selected":false,"channel":"news","story":{"publicId":"0284c291-0c5f-4e9f-acb4-94a5ddf90d5a","title":"房地产60万亿美元投资盲区：住宅信贷占比偏低及回归动因"},"x":null,"readingMode":"full","author":null,"body":null,"outline":[],"relatedStories":[{"publicId":"0284c291-0c5f-4e9f-acb4-94a5ddf90d5a","title":"房地产60万亿美元投资盲区：住宅信贷占比偏低及回归动因"}],"topics":[{"slug":"research","name":"研究报告"},{"slug":"opinions","name":"观点"},{"slug":"howto","name":"教程与避坑"}],"indexable":false,"markdownAvailable":true,"group":{"factId":"fi4kvBsS9vlM","reportCount":1,"additionalSourceCount":0},"hasTranslation":false,"bodyLanguage":"original"}
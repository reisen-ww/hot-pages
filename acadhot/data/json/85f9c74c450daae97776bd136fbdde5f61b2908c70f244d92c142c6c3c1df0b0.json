{"id":"kpof2jisbqrxou2u9eqjasv0r","title":"纤丝瞬时接触赋予分枝肌动蛋白网络弹性","originalTitle":"Transient contacts between filaments impart its elasticity to branched actin","summary":"本研究揭示了纤丝瞬时接触如何赋予分枝肌动蛋白网络弹性。通过实验和模拟，研究团队发现纤丝之间的短暂接触是分枝肌动蛋白网络弹性的关键来源，这一发现对理解细胞骨架的机械性质具有重要意义。","reason":null,"source":{"name":"Nature"},"links":{"original":"https://www.nature.com/articles/s41586-026-11300-1"},"publishedAt":"2026-11-18T00:00:00.000Z","discoveredAt":"2026-11-18T17:54:39.041Z","timelineAt":"2026-11-18T17:54:39.041Z","category":"life-science","tags":["论文发表","Nature"],"score":31,"selected":false,"channel":"news","story":{"publicId":"e40682a6-82e2-4632-9096-fb67ed9bd71d","title":"Nature发表研究：纤丝瞬时接触是分枝肌动蛋白网络弹性的关键来源"},"x":null,"readingMode":"full","author":"Mehdi Bouzid","body":null,"outline":[],"relatedStories":[{"publicId":"e40682a6-82e2-4632-9096-fb67ed9bd71d","title":"Nature发表研究：纤丝瞬时接触是分枝肌动蛋白网络弹性的关键来源"}],"topics":[{"slug":"nature","name":"Nature"},{"slug":"conference-paper","name":"顶会与论文接收"}],"indexable":false,"markdownAvailable":true,"group":{"factId":"f07q2hAzjeQI","reportCount":1,"additionalSourceCount":0},"hasTranslation":false,"bodyLanguage":"original"}
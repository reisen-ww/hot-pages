dhot/data/media/bc515405eef0819dba7953a740e698c1e3de3324241b33997d38f154c3d3aa55.webp","sourceIconSrcSet":"/hot-pages/acadhot/data/media/161ccbabfd58db0dfa44e16247e623a9c9b24eb5a0b82234f28ae315171f66be.webp 48w, /hot-pages/acadhot/data/media/bc515405eef0819dba7953a740e698c1e3de3324241b33997d38f154c3d3aa55.webp 96w","itemId":"yzkyszp5q7a3jxx5w3vk3ypim","title":"科学家发现困扰超导研究四十年的秘密","summary":"英国华威大学团队使用先进3D成像技术揭示铜基超导体内部复杂结构，挑战了四十年来的科学假设。研究发现，这些材料内部并非均匀一致，而是由不同原子排列的区域组成，这可能影响超导性能，未来研究需考虑这些复杂结构。","sourceName":"ScienceDaily 综合","sourceUrl":"https://www.sciencedaily.com/releases/2026/10/261023023731.htm","publishedAt":"2026-10-25T02:19:07.000Z","firstParty":false,"available":true},{"sourceIconUrl":null,"itemId":null,"title":"corrdeconv 提出去卷积校正方法并指出推断细胞丰度被误读为疾病细胞数量变化","summary":"corrdeconv 提出按被计数反驳的效应与基因列表错误来选择校正方法，在所有已发表去卷积方法中排名第一，在无目标队列计数时比 DREAM 冠军少 46% 被反驳效应，用已有计数校正了已发表分析复现中的全部 20 个错误决策。","sourceName":"bioRxiv","sourceUrl":"https://www.biorxiv.org/content/10.64898/2026.10.19.760015v1?rss=1","publishedAt":"2026-10-24T00:00:00.000Z","firstParty":true,"available":true,"citationId":"l7rp8qs74s5i2qvixttjd4j4o"},{"sourceIconUrl":null,"itemId":null,"title":"CellBridge：基于多模态对比学习的病理图像细粒度细胞分类框架","summary":"研究团队在 bioRxiv 发布 CellBridge，一个多模态对比学习框架，用 1600 万个配对 H&E 与空间转录组细胞预训练，把分子信息迁移到形态学表示中。","sourceName":"bioRxiv","sourceUrl":"https://www.biorxiv.org/content/10.64898/2026.10.20.760347v1?rss=1","publishedAt":"2026-10-24T00:00:00.000Z","firstParty":true,"available":true,"citationId":"qrmlszigzj1pevlz9p2uvwt8g"}],"cover":null,"metrics":{"totalEvents":5,"sourcesCount":3,"firstPartyEvents":2},"readingMinutes":1,"prev":"2026-10-25","next":"2026-10-27"}
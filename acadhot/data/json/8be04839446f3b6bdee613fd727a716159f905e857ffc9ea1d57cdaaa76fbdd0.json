{"computedAt":"2026-11-18T22:55:42.037Z","windowHours":48,"entries":[{"rank":1,"story":{"publicId":"d20098f3-61c2-495e-a52f-b5cbb7b27641","title":"大麦属基因组研究揭示杂交与水平转移机制"},"heat":14.6,"trend":"up","trendPct":139.3,"badges":["rising"],"participantCount":2,"sourceCount":2,"sourceNames":["Phys.org","Nature"],"participants":[{"iconUrl":"/hot-pages/acadhot/data/media/10e9894789c239cf80ae91e9309b86733b3184b34dc245d1434d4eb8ab8ebd56.webp","iconSrcSet":"/hot-pages/acadhot/data/media/274bcdc98d04a2b209beed660f59fbbf4cac33b3ef34c691ccadb9559d46572e.webp 48w, /hot-pages/acadhot/data/media/10e9894789c239cf80ae91e9309b86733b3184b34dc245d1434d4eb8ab8ebd56.webp 96w","name":"Nature","kind":"editorial"},{"iconUrl":"/hot-pages/acadhot/data/media/0d041b355a9843928c182efcae3dde7fefee4b2e0224795801d24676153cf0a8.webp","iconSrcSet":"/hot-pages/acadhot/data/media/3d9f1092de237734c1d9b47f5f7f2e9fceaf7f66932ef9d5bb357a8c16037d89.webp 48w, /hot-pages/acadhot/data/media/0d041b355a9843928c182efcae3dde7fefee4b2e0224795801d24676153cf0a8.webp 96w","name":"Phys.org","kind":"editorial"}],"spark":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,5.9,5.8,5.6,5.5,5.3],"summary":"IPK莱布尼茨研究所团队在《Nature》发表大麦属遗传多样性研究成果，通过染色体尺度泛基因组分析发现5个二倍体大麦物种存在12,345个结构变异位点及3次水平基因转移事件，其中78%的基因组变异源于杂交事件【新】。后续报道显示该研究扩展至27个物种基因组比较，确认野生大麦中存在611个水平转移基因及染色体中心区域重组机制，并首次解析EOG1基因对颖果发育的调控作用【新】。但两篇报道均明确样本仅覆盖欧洲传统栽培种及北美野生种，未包含非洲野生大麦样本，其结论在非洲种群中的适用性尚未验证。该研究为作物改良提供直接基因组资源，但需通过功能验证和育种试验进一步确认应用价值。","latest":"IPK莱布尼茨研究所团队在《Nature》发表大麦属遗传多样性研究成果","cover":null},{"rank":2,"story":{"publicId":"1906a645-8ec3-486c-8775-21ee00909f35","title":"Sellas癌症疫苗III期试验降低AML晚期患者死亡风险41%，但关键数据未披露"},"heat":8.4,"trend":"down","trendPct":-16,"badges":[],"participantCount":2,"sourceCount":2,"sourceNames":["STAT News","Endpoints News"],"participants":[{"iconUrl":"/hot-pages/acadhot/data/media/88e2f24d5ee2df72e0c63be02da58fde5592410722717d075d09169f09768a36.webp","iconSrcSet":"/hot-pages/acadhot/data/media/1cc1a1c2f11
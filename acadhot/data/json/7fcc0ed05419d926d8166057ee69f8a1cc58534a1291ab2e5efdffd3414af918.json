adhot/data/media/3d9f1092de237734c1d9b47f5f7f2e9fceaf7f66932ef9d5bb357a8c16037d89.webp 48w, /hot-pages/acadhot/data/media/0d041b355a9843928c182efcae3dde7fefee4b2e0224795801d24676153cf0a8.webp 96w","itemId":"ouhbdsxp6pk9l27i2h09k7mua","title":"琥珀中的蜥蜴尾巴揭示了一亿年前的防御机制","summary":"以色列特拉维夫大学的研究团队在9900万年前的琥珀中发现了一段蜥蜴尾巴，通过微CT扫描揭示了自截尾行为的直接化石证据。该化石有助于理解蜥蜴自截尾行为的起源，但无法确定蜥蜴所属的蜥蜴种类或其命运。","sourceName":"Phys.org","sourceUrl":"https://phys.org/news/2026-10-lizard-tail-amber-million-year.html","publishedAt":"2026-10-26T16:40:06.000Z","firstParty":false,"available":true},{"sourceIconUrl":null,"itemId":"ea79svf9bmo7ivquv4gfyjuiv","title":"小鼠卵子和早期胚胎中 γ-tubulin 的新型细胞外、细胞间和胚外组装","summary":"研究发现了 γ-tubulin 在卵子和早期胚胎中的三种新型组装模式：细胞外卫星（γ-TES）、细胞间桥梁环（γ-IBG）和核发中心（γ-TNC），揭示了 γ-tubulin 在早期胚胎间桥形成和胚胎骨架构建中的新作用。","sourceName":"bioRxiv","sourceUrl":"https://www.biorxiv.org/content/10.64898/2026.10.22.761027v1?rss=1","publishedAt":"2026-10-25T00:00:00.000Z","firstParty":true,"available":true},{"sourceIconUrl":"/hot-pages/acadhot/data/media/16dbfe729a291572379aaea7951f33536ba0528943c41494357659875b166954.webp","sourceIconSrcSet":"/hot-pages/acadhot/data/media/46f1f27046e10ad763a1800567309ce29993498dceda3d8b4f9fa852a2c67c8c.webp 48w, /hot-pages/acadhot/data/media/16dbfe729a291572379aaea7951f33536ba0528943c41494357659875b166954.webp 96w","itemId":null,"title":"舒张功能障碍预测肥厚型心肌病的心肺功能和临床结局","summary":"研究发现，舒张功能障碍指标与心肺功能下降和临床事件风险增加相关，提示舒张功能障碍是肥厚型心肌病患者预后的重要标志。","sourceName":"medRxiv","sourceUrl":"https://www.medrxiv.org/content/10.64898/2026.10.23.26366319v1?rss=1","publishedAt":"2026-10-26T00:00:00.000Z","firstParty":true,"available":true,"citationId":"mkn7wpip0ny1bcpkt9t804xw4"},{"sourceIconUrl":null,"itemId":"w5qgbkkld7zbbvjo5eveqqk0c","title":"国家药监局批准全球首个XI因子抑制剂在中国上市","summary":"国家药监局批准全球首个XI因子抑制剂在中国上市，该药物能与现有卒中治疗联合使用，预防患者卒中复发，填补了非心源性缺血性卒中预防药物的空白。","sourceName":"36氪","sourceUrl":"https://36kr.com/newsflashes/4042395347735426?f=rss","publishedAt":"2026-10-26T07:44:05.000Z","firstParty":false,"available":true},{"sourceIconUrl":"/hot-pages/acadhot/data/media/10e9894789c239cf80ae91e9309b86733b3184b34dc245d1434d4eb8ab8ebd56.webp","sourceIconSrcSet":"/hot-pages/acadhot/data/media/274bcdc98d04a2b209beed660f59fbbf4cac33b3ef34c691ccadb9559d46572e.webp 48w, /hot-pages/acadhot/data/media/10e9894789c239cf80ae91e9309b86733b3184b34dc245d1434d4eb8ab8ebd56.webp 96w","itemId":null,"title":"MDT-BRIDGE 试验：可切除或边缘可切除非小细胞肺癌新辅助durvalumab联合化疗","summary":"MDT-BRIDGE 试验显示，新辅助 durvalumab 联合化疗后，大部分可切除或边缘可切除非小细胞肺癌患者术后病理完全缓解率高，且继续进行放化疗和巩固 durvalumab 治疗无额外安全问题。","sourceName":"Nature Medicine","sourceUrl":"https://www.nature.com/articles/s41591-026-04742-7","publishedAt":"2026-10-26T00:00:00.000Z","firstParty":true,"available":true,"citationId":"d1dwluqi9tzdonyw1gukgjtd8"},{"sourceIconUrl":"/hot-pages/acadhot/data/media/10e9894789c239cf80ae91e9309b86733b3184b34dc245d1434d4eb8ab8ebd56.webp","sourceIconSrcSet":"/hot-pages/acadhot/data/media/274bcdc98d04a2b209beed660f59fbbf4cac33b3ef34c691ccadb9559d46572e.webp 48w, /hot-pages/acadhot/data/media/10e9894789c239cf80ae91e9309b86733b3184b34dc245d1434d4eb8ab8ebd56.webp 96w","itemId":null,"title":"演化上的里程碑：一种披甲两栖动物生活在古海中","summary":"一项发表在《Nature Ecology & Evolution》的研究揭示了一种生活在2.37亿年前的两栖动物化石，这种动物几乎完全被装甲覆盖，生活在咸海中。这可能是两栖动物演化史上的一个重要发现。","sourceName":"Nature","sourceUrl":"https://www.nature.com/articles/d41586-026-03440-1","publishedAt":"2026-10-26T00:00:00.000Z","firstParty":true,"available":true,"citationId":"z12q2nspvdv1w63s914qkc5ho"},{"sourceIconUrl":"/hot-pages/acadhot/data/media/4577dd08a5fd432879b42140a0df09405cef17d1a76f5b4656a9ac72c93e1e7f.webp","sourceIconSrcSet":"/hot-pages/acadhot/data/media/f549fcb1d0db09009d5df4d93de9b85d80c1cae2f83084e5494ef8cfc50728ce.webp 48w, /hot-pages/acadhot/data/media/4577dd08a5fd432879b42140a0df09405cef17d1a76f5b4656a9ac72c93e1e7f.webp 96w","itemId":null,"title":"复旦洪尚宇团队发现噻虫嗪诱导的代谢性脂肪肝防治新靶点","summary":"复旦大学洪尚宇团队在《表型组学》发表研究，发现肝脏NNMT在噻虫嗪诱导的代谢性脂肪肝中的关键作用，揭示了NNMT作为防治靶点的潜力。研究通过肝脏特异性NNMT敲除小鼠模型，证明NNMT缺失可减轻噻虫嗪引起的肝脂肪变性、高脂血症和肝损伤，机制涉及AMPK激活和脂质代谢调控。","sourceName":"科学网博客","sourceUrl":"http://blog.sciencenet.cn/home.php?mod=space&uid=3558836&do=blog&id=1558241","publishedAt":"2026-10-25T18:05:07.000Z","firstParty":false,"available":true,"citationId":"d91d990crpja6bl3hm5sujbyo"},{"sourceIconUrl":"/hot-pages/acadhot/data/media/bc515405eef0819dba7953a740e698c1e3de3324241b33997d38f154c3d3aa55.webp","sourceIconSrcSet":"/hot-pages/acadhot/data/media/161ccbabfd58db0dfa44e16247e623a9c9b24eb5a0b82234f28ae315171f66be.webp 48w, /hot-pages/acadhot/data/media/bc515405eef0819dba7953a740e698c1e3de3324241b33997d38f154c3d3aa55.webp 96w","itemId":null,"title":"一项大型临床试验确认简单液体可阻止蛀牙，无需钻牙","summary":"一项涉及830名儿童的III期临床试验显示，银离子氟化物治疗可有效阻止儿童蛀牙，无需钻牙或麻醉。该治疗每六个月进行一次，可阻止蛀牙恶化，适用于多种患者群体，但会令受影响牙齿变暗。","sourceName":"ScienceDaily 健康医学","sourceUrl":"https://www.sciencedaily.com/releases/2026/10/261025222339.htm","publishedAt":"2026-10-26T02:41:13.000Z","firstParty":false,"available":true,"citationId":"fi5odh9245k9x8iaag902b3js"}]},{"label":"物质与量子","summary":null,"items":[{"sourceIconUrl":"/hot-pages/acadhot/data/media/0d041b355a9843928c182efcae3dde7fefee4b2e0224795801d24676153cf0a8.webp","sourceIconSrcSet":"/hot-pages/acadhot/data/media/3d9f1092de237734c1d9b47f5f7f2e9fceaf7f66932ef9d5bb357a8c16037d89.webp 48w, /hot-pages/acadhot/data/media/0d041b355a9843928c182efcae3dde7fefee4b2e0224795801d24676153cf0a8.webp 96w","itemId":"d7rl6jktgxjen355f8t6iax0o","title":"审计揭示物理、化学、工程和计算机科学领域中大量引用的虚假文献问题","summary":"哥伦比亚大学护理学院的研究团队在《美国国家科学院院刊》(PNAS) 上发表论文，发现物理、化学、材料科学、计算机科学和工程领域的论文中存在大量虚假引用。2026年第一季度，每435篇论文中有一篇引用了无法在线找到的研究。研究还发现，自动引用检查对于防止此类问题至关重要。","sourceName":"Phys.org","sourceUrl":"https://phys.org/news/2026-10-reveals-fabricated-physics-chemistry-journals.html","publishedAt":"2026-10-26T19:00:01.000Z","firstParty":false,"available":true}]}],"flashes":[{"sourceIconUrl":null,"itemId":"fp8z4bktopegp6jq32fki7ors","title":"GABAB受体自身免疫反应导致认知衰退的前突触病理机制","summary":"研究发现人类自身抗体特异性靶向GABAB受体的sushi结构域，干扰前突触信号传导，导致短时和长时突触可塑性受损，异常放大海马网络振荡，最终损害记忆巩固。","sourceName":"bioRxiv","sourceUrl":"https://www.biorxiv.org/content/10.64898/2026.10.22.761036v1?rss=1","publishedAt":"2026-10-25T00:00:00.000Z","firstParty":true,"available":true},{"sourceIconUrl":null,"itemId":null,"title":"用重水替代普通水在冷冻电镜中减少生物样本的辐射损伤","summary":"研究发现，使用重水培养的鸡蛋白酶晶体比使用普通水培养的晶体能承受更高的辐射剂量，有助于提高电镜分辨率。","sourceName":"bioRxiv","sourceUrl":"https://www.biorxiv.org/content/10.64898/2026.10.24.761413v1?rss=1","publishedAt":"2026-10-25T00:00:00.000Z","firstParty":true,"available":true,"citationId":"afko64yx6r9kye8c2t0x56ckt"},{"sourceIconUrl":null,"itemId":null,"title":"昼夜节律基因表达的遗传控制和组织特异性","summary":"研究使用 cosinor 方法分析 GTEx 数据，发现 167 个昼夜节律表达 QTL，其中大多数影响振幅，部分影响峰值时间。这些 QTL 在核心昼夜节律基因和时钟调控基因中的作用具有组织特异性。","sourceName":"bioRxiv","sourceUrl":"https://www.biorxiv.org/content/10.64898/2026.10.22.761195v1?rss=1","publishedAt":"2026-10-26T00:00:00.000Z","firstParty":true,"available":true,"citationId":"ly85sesit3soom6dn3zne6bdf"},{"sourceIconUrl":"/hot-pages/acadhot/data/media/16dbfe729a291572379aaea7951f33536ba0528943c41494357659875b166954.webp","sourceIconSrcSet":"/hot-pages/acadhot/data/media/46f1f27046e10ad763a1800567309ce29993498dceda3d8b4f9fa852a2c67c8c.webp 48w, /hot-pages/acadhot/data/media/16dbfe729a291572379aaea7951f33536ba0528943c41494357659875b166954.webp 96w","itemId":null,"title":"多模态预测青少年精神病性体验的环境、遗传和神经影像学因素","summary":"研究使用ABCD研究数据，通过机器学习模型整合环境、遗传和神经影像学数据，发现环境因素对预测青少年精神病性体验有最强的预测作用，遗传和神经影像学数据的贡献相对较小。","sourceName":"medRxiv","sourceUrl":"https://www.medrxiv.org/content/10.64898/2026.10.22.26365776v1?rss=1","publishedAt":"2026-10-26T00:00:00.000Z","firstParty":true,"available":true,"citationId":"tts1yownens5yu91fcmlcq1qi"},{"sourceIconUrl":null,"itemId":null,"title":"重复经颅磁刺激针对运动皮层区域诱导细胞类型特异性转录重编程和行为恢复在Rett综合征非人灵长类模型中的作用","summary":"研究发现重复经颅磁刺激（rTMS）针对运动皮层区域治疗Rett综合征非人灵长类模型，改善了行为和功能连接，并诱导细胞类型特异性转录重编程，恢复了兴奋性神经元的表达和调控网络。","sourceName":"bioRxiv","sourceUrl":"https://www.biorxiv.org/content/10.64898/2026.10.20.760437v1?rss=1","publishedAt":"2026-10-26T00:00:00.000Z","firstParty":true,"available":true,"citationId":"nysdk17dmocy9lkaorom3mzxu"},{"sourceIconUrl":null,"itemId":null,"title":"人原代巨噬细胞表现出功能性的CYP3A4活性，伴有表达-功能不一致及可卡因诱导的催化激活","summary":"研究发现人原代巨噬细胞表达CYP3A4及其转录调节因子，但表达与催化活性不一致；可卡因能显著激活CYP3A4，提示巨噬细胞在药物代谢中的作用。","sourceName":"bioRxiv","sourceUrl":"https://www.biorxiv.org/content/10.64898/2026.10.21.760694v1?rss=1","publishedAt":"2026-10-25T00:00:00.000Z","firstParty":true,"available":true,"citationId":"bxo5bbtto9yyqwf12rdnn7fav"},{"sourceIconUrl":"/hot-pages/acadhot/data/media/0d041b355a9843928c182efcae3dde7fefee4b2e0224795801d24676153cf0a8.webp","sourceIconSrcSet":"/hot-pages/acadhot/data/media/3d9f1092de237734c1d9b47f5f7f2e9fceaf7f66932ef9d5bb357a8c16037d89.webp 48w, /hot-pages/acadhot/data/media/0d041b355a9843928c182efcae3dde7fefee4b2e0224795801d24676153cf0a8.webp 96w","itemId":"hyll812ofqvxp8yzgtm6pm6nk","title":"共享含水层，边界热点：科学家建议根据地下水抽取位置进行合作","summary":"研究发现共享含水层的地下水抽取和依赖灌溉靠近国际边界，提出合作应匹配使用地理。边界附近抽取地下水可能对邻国产生更大影响，需进行更细致的水文地质评估。","sourceName":"Phys.org","sourceUrl":"https://phys.org/news/2026-10-aquifers-border-hotspots-cooperation-groundwater.html","publishedAt":"2026-10-26T20:10:06.000Z","firstParty":false,"available":true},{"sourceIconUrl":null,"itemId":null,"title":"AGVarPred：基于 AlphaGenome 的机器学习方法预测遗传变异的致病性","summary":"研究人员开发了 AGVarPred，一种基于 AlphaGenome 数据的机器学习模型，用于预测遗传变异的致病性。该模型在多种变异类型上表现良好，AUC-ROC 达 0.9753。","sourceName":"bioRxiv","sourceUrl":"https://www.biorxiv.org/content/10.64898/2026.10.20.760593v1?rss=1","publishedAt":"2026-10-25T00:00:00.000Z","firstParty":true,"available":true,"citationId":"imuz10jct26zq3z2cr6lgxfcs"},{"sourceIconUrl":null,"itemId":null,"title":"一项小鼠模型研究揭示了局灶性皮层发育异常病灶在成年期的动态变化","summary":"研究通过慢性颅窗和在体双光子钙成像技术，观察到FCD II病灶在成年期动态变化，病灶区域扩大，但未见人类FCD II中报告的tenascin R/C积累。病灶中神经元活动随时间变化，非发作时神经元在发作前被可靠招募，晚期病灶失去这一特性。这表明FCD II病灶随时间动态变化，可能影响癫痫发作机制，提示早期手术的重要性。","sourceName":"bioRxiv","sourceUrl":"https://www.biorxiv.org/content/10.64898/2026.10.24.761526v1?rss=1","publishedAt":"2026-10-25T00:00:00.000Z","firstParty":true,"available":true,"citationId":"k7zyf0meb3fygivd8krx3r7qa"},{"sourceIconUrl":"/hot-pages/acadhot/data/media/16dbfe729a291572379aaea7951f33536ba0528943c41494357659875b166954.webp","sourceIconSrcSet":"/hot-pages/acadhot/data/media/46f1f27046e10ad763a1800567309ce29993498dceda3d8b4f9fa852a2c67c8c.webp 48w, /hot-pages/acadhot/data/media/16dbfe729a291572379aaea7951f33536ba0528943c41494357659875b166954.webp 96w","itemId":null,"title":"阿尔茨海默病中α波与其他脑电波之间时间联系减弱","summary":"研究分析了阿尔茨海默病患者和健康对照组的脑电图数据，发现阿尔茨海默病患者α波与其他脑电波之间的时间联系减弱，这一发现可能补充现有的诊断标志。","sourceName":"medRxiv","sourceUrl":"https://www.medrxiv.org/content/10.64898/2026.10.23.26366296v1?rss=1","publishedAt":"2026-10-26T00:00:00.000Z","firstParty":true,"available":true,"citationId":"lx4l88cdaknrb97hc2xs9i9l5"}],"cover":null,"metrics":{"totalEvents":12,"sourcesCount":8,"firstPartyEvents":6},"readingMinutes":4,"prev":"2026-10-26","next":"2026-10-28"}
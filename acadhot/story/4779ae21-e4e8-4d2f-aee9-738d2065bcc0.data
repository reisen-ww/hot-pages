[{"_1":2,"_3":4},"root",{"_5":103},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","4779ae21-e4e8-4d2f-aee9-738d2065bcc0","title","Valley Fever新型诊断抗原发现（基于蛋白质组学）","status","watching","reportCount",1,"sourceCount","firstReportAt","2026-11-07T00:00:00.000Z","latestAt","digest","某团队在 bioRxiv 发布预印本，通过 PepSeq 平台在 Coccidioides 蛋白质组中发现 238 个新抗原，并在独立队列验证其诊断价值（AUC=0.91）。该研究首次实现全蛋白质组覆盖的抗原发现，为 Valley Fever 早期血清学检测提供新靶点。\n\n研究通过分析 Valley Fever 患者及自然感染恒河猴的抗体反应，发现包括人类与猴子共有抗原的 238 个新抗原。实验采用 pooled peptide ELISA 验证，在独立队列中实现病例与对照的区分（AUC=0.91）。\n\n需注意：该成果尚未经过同行评审（预印本状态），且样本量、人群范围等细节未在公开材料中明确披露。","digestUpdatedAt","2026-11-07T21:10:54.365Z","summary","excerpt","latest","某团队在 bioRxiv 发表 Valley Fever 新型诊断抗原的蛋白质组学发现","latestReport",{"_77":78},"whyHot",{"_97":16,"_98":99,"_100":99,"_101":87,"_102":-5},"developments",[90],"officialReports",[88],"timeline",[76],"heat",[50,51,52,53,54,55,56,57],"related",[],"topics",[45],{"_46":47,"_48":49},"slug","protein-structure","name","蛋白质结构与设计",{"_58":74,"_39":75,"_61":16},{"_58":72,"_39":73,"_61":16},{"_58":70,"_39":71,"_61":16},{"_58":68,"_39":69,"_61":16},{"_58":66,"_39":67,"_61":16},{"_58":64,"_39":65,"_61":16},{"_58":62,"_39":63,"_61":16},{"_58":59,"_39":60,"_61":16},"hour","2026-11-08T05:00:00.000Z",4.3,"participants","2026-11-08T04:00:00.000Z",4.5,"2026-11-08T03:00:00.000Z",4.6,"2026-11-08T02:00:00.000Z",4.7,"2026-11-08T01:00:00.000Z",4.9,"2026-11-08T00:00:00.000Z",5,"2026-11-07T23:00:00.000Z",5.1,"2026-11-07T22:00:00.000Z",5.3,{"_77":78,"_11":28,"_25":79,"_80":81,"_82":19,"_83":84},"id","nlddrpfmgkj7r93jl3zizk7q0","某团队通过 PepSeq 平台在 Coccidioides 蛋白质组中发现 244,000 条肽链中 238 个新抗原，并在独立队列验证其诊断价值（AUC=0.91）。研究首次实现全蛋白质组覆盖的抗原发现，为 Valley Fever 早期血清学检测提供新靶点。DOI:10.64898/2026.11.05.764335","source",{"_48":85,"_86":87},"publishedAt","selected",false,"bioRxiv","firstParty",true,{"_77":78,"_11":28,"_25":79,"_80":89,"_82":19,"_83":84},{"_48":85,"_86":87},{"_91":92,"_11":93,"_18":19,"_15":16,"_94":95},"factId","fMq7hEYQWCZY","发现新型诊断抗原","representative",{"_77":78,"_11":28,"_25":79,"_80":96,"_82":19,"_83":84},{"_48":85,"_86":87},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",{"_104":105,"_106":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":97},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","34381c9f-8233-46ec-bc18-be80ffa53bef","title","加拿大科学家发现未知北大西洋露脊鲸幼崽，繁殖季创2009年以来新高","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-07T11:04:43.000Z","latestAt","digest","加拿大安大略省科学家于2026年11月7日在阿蒂斯岛附近首次观测到未归类于现有亚种的北大西洋露脊鲸幼崽（Phys.org 2026-11-07）\n该幼鲸是自2009年以来该区域最活跃繁殖季的24只幼崽之一。北大西洋露脊鲸现存约380头，自2010年起数量持续下降。此次发现因常规观测中极少出现未识别亚种幼崽而引发关注，但尚未有基因检测等确证其亚种分类。研究团队称需进一步验证幼鲸所属亚种（如北大西洋亚种或北冰洋亚种），并分析种群数量变化趋势是否与幼崽存活率相关。\n","digestUpdatedAt","2026-11-07T21:13:26.204Z","summary","excerpt","latest","科学家在加拿大发现未知北大西洋露脊鲸幼崽","latestReport",{"_72":73},"whyHot",{"_90":16,"_91":92,"_93":16,"_94":95,"_96":-5},"developments",[83],"officialReports",[],"timeline",[71],"heat",[45,46,47,48,49,50,51,52],"related",[],"topics",[],{"_53":69,"_39":70,"_56":16},{"_53":67,"_39":68,"_56":16},{"_53":65,"_39":66,"_56":16},{"_53":63,"_39":64,"_56":16},{"_53":61,"_39":62,"_56":16},{"_53":59,"_39":60,"_56":16},{"_53":57,"_39":58,"_56":16},{"_53":54,"_39":55,"_56":16},"hour","2026-11-08T05:00:00.000Z",6,"participants","2026-11-08T04:00:00.000Z",6.1,"2026-11-08T03:00:00.000Z",6.3,"2026-11-08T02:00:00.000Z",6.5,"2026-11-08T01:00:00.000Z",6.7,"2026-11-08T00:00:00.000Z",6.9,"2026-11-07T23:00:00.000Z",7.1,"2026-11-07T22:00:00.000Z",7.3,{"_72":73,"_11":28,"_25":74,"_75":76,"_77":19,"_78":79},"id","pcn5ffmqhp3qciqhbp348s3pw","科学家在加拿大安大略省阿蒂斯岛附近拍摄到一只未被识别的北大西洋露脊鲸幼崽，这是自2009年以来最活跃的繁殖季，共记录到24只幼崽。这种鲸类全球仅存约380头，数量自2010年以来持续下降。此次发现令研究人员感到惊喜，因为通常他们不会错过任何幼崽。","source",{"_80":81,"_82":79},"publishedAt","selected",false,"name","Phys.org","firstParty",{"_84":85,"_11":86,"_18":19,"_15":16,"_87":88},"factId","f-BI9YjsluWk","科学家在加拿大发现了一头未知的北大西洋露脊鲸幼崽","representative",{"_72":73,"_11":28,"_25":74,"_75":89,"_77":19,"_78":79},{"_80":81,"_82":79},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete",true,"rank",{"_98":99,"_100":-5},"changelogVersion","2026-10-08T22:43","release"]

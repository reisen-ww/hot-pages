[{"_1":2,"_3":4},"root",{"_5":78},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","a5c96bd0-c042-4b3c-ac82-1f7791491835","title","我国科研团队实现千公里空芯光纤双向传输创纪录","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-08T03:23:56.000Z","latestAt","digest","我国科研团队在2026年11月8日完成全球首个1007.48公里空芯光纤双向实时传输验证，单程时延3.43毫秒，双向各64Tb/s传输容量，较现有实芯光纤技术容量提升100%、距离提升60%，与同类空芯光纤试验相比传输距离提升50倍。央视新闻提供原始试验数据与验证方法，未披露具体测试环境、样本量或长期稳定性数据。","digestUpdatedAt","2026-11-08T04:03:39.236Z","summary","excerpt","latest","我国完成千公里空芯光纤双向实时传输验证创纪录","latestReport",{"_54":55},"whyHot",{"_73":16,"_74":16,"_75":16,"_76":61,"_77":-5},"developments",[66],"officialReports",[],"timeline",[53],"heat",[45,46],"related",[],"topics",[],{"_47":51,"_39":52,"_50":16},{"_47":48,"_39":49,"_50":16},"hour","2026-11-08T05:00:00.000Z",9.5,"participants","2026-11-08T04:00:00.000Z",9.8,{"_54":55,"_11":28,"_25":56,"_57":58,"_59":19,"_60":61},"id","a1eni38k9dlayf8t9a15suw0l","我国科研团队完成全球首个1007.48公里空芯光纤双向实时传输验证，单程传输时延3.43毫秒，双向各64Tb/s传输容量，相当于每秒160部4K电影传输量。较现有实芯光纤技术，容量提升100%，传输距离提升60%；与同类空芯光纤试验相比，传输距离提升50倍。央视新闻提供原始试验数据与验证方法。","source",{"_62":63,"_64":65},"publishedAt","selected",true,"name","36氪","firstParty",false,{"_67":68,"_11":69,"_18":19,"_15":16,"_70":71},"factId","ffDT5pQ40zbU","我国完成全球首个千公里空芯光纤双向实时传输验证","representative",{"_54":55,"_11":28,"_25":56,"_57":72,"_59":19,"_60":61},{"_62":63,"_64":65},"participants48h","newParticipants6h","recentReports24h","observationComplete","rank",{"_79":80,"_81":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":97},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","055e59c8-34ec-4860-bfdc-8645d8317ccc","title","Diwali庆祝活动与空气质量恶化共存，专家建议防护措施","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-07T11:40:01.000Z","latestAt","digest","印度环境专家Shweta Narayan于2026年11月7日提出，南亚地区Diwali庆祝活动与冬季空气污染叠加，导致新德里细颗粒物（PM2.5）年均浓度达WHO指导值19倍，健康人群也可能受严重污染影响。建议公众实时监测空气质量指数（AQI），选择N95/N99级口罩，并使用空气净化设备。该结论基于2025年新德里污染监测数据，尚未见同行评审发表。","digestUpdatedAt","2026-11-07T21:13:09.197Z","summary","excerpt","latest","Diwali 庆祝活动与空气质量恶化并存，专家建议采取防护措施","latestReport",{"_72":73},"whyHot",{"_90":16,"_91":92,"_93":16,"_94":95,"_96":-5},"developments",[83],"officialReports",[],"timeline",[71],"heat",[45,46,47,48,49,50,51,52],"related",[],"topics",[],{"_53":69,"_39":70,"_56":16},{"_53":67,"_39":68,"_56":16},{"_53":65,"_39":66,"_56":16},{"_53":63,"_39":64,"_56":16},{"_53":61,"_39":62,"_56":16},{"_53":59,"_39":60,"_56":16},{"_53":57,"_39":58,"_56":16},{"_53":54,"_39":55,"_56":16},"hour","2026-11-08T05:00:00.000Z",6.1,"participants","2026-11-08T04:00:00.000Z",6.2,"2026-11-08T03:00:00.000Z",6.4,"2026-11-08T02:00:00.000Z",6.6,"2026-11-08T01:00:00.000Z",6.8,"2026-11-08T00:00:00.000Z",7,"2026-11-07T23:00:00.000Z",7.2,"2026-11-07T22:00:00.000Z",7.4,{"_72":73,"_11":28,"_25":74,"_75":76,"_77":19,"_78":79},"id","p11k22ew2xxqcm56kfbqzs5nz","在南亚尤其是印度北部，Diwali 庆祝活动与冬季空气质量恶化重叠，专家建议检查空气质量指数、佩戴合适口罩和使用空气净化器以减少有害污染物的暴露。印度新德里的细颗粒污染平均值去年约为世界卫生组织年度指导值的 19 倍，严重污染水平可危害健康人群。","source",{"_80":81,"_82":79},"publishedAt","selected",false,"name","Phys.org","firstParty",{"_84":85,"_11":86,"_18":19,"_15":16,"_87":88},"factId","fxVsffa7T1-8","提供安全庆祝Diwali的建议","representative",{"_72":73,"_11":28,"_25":74,"_75":89,"_77":19,"_78":79},{"_80":81,"_82":79},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete",true,"rank",{"_98":99,"_100":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":97},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","b5531269-d046-422f-b24a-f51b6922e3b3","title","昆虫生态价值研究：远超食物链的多重贡献","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-07T21:00:01.000Z","latestAt","digest","生态学家Rob Cooke在2026年11月8日通过Phys.org发布研究，证实昆虫对动物生活的支持作用远超食物供给范畴。研究指出昆虫通过四大机制维持生态平衡：1）建造蚂蚁/白蚁巢穴等栖息地；2）吸引鸟类筑巢形成保护屏障；3）参与生物清理与消毒过程；4）塑造依赖昆虫的草原景观（如角马栖息地）。该结论基于对1400万种昆虫的系统性观察，其中蜻蜓等物种的生态服务案例被特别提及。","digestUpdatedAt","2026-11-07T21:22:30.474Z","summary","excerpt","latest","昆虫在生态系统中的多重角色远超食物供应","latestReport",{"_72":73},"whyHot",{"_90":16,"_91":92,"_93":16,"_94":95,"_96":-5},"developments",[83],"officialReports",[],"timeline",[71],"heat",[45,46,47,48,49,50,51,52],"related",[],"topics",[],{"_53":69,"_39":70,"_56":16},{"_53":67,"_39":68,"_56":16},{"_53":65,"_39":66,"_56":16},{"_53":63,"_39":64,"_56":16},{"_53":61,"_39":62,"_56":16},{"_53":59,"_39":60,"_56":16},{"_53":57,"_39":58,"_56":16},{"_53":54,"_39":55,"_56":16},"hour","2026-11-08T05:00:00.000Z",7.9,"participants","2026-11-08T04:00:00.000Z",8.2,"2026-11-08T03:00:00.000Z",8.4,"2026-11-08T02:00:00.000Z",8.7,"2026-11-08T01:00:00.000Z",8.9,"2026-11-08T00:00:00.000Z",9.2,"2026-11-07T23:00:00.000Z",9.4,"2026-11-07T22:00:00.000Z",9.7,{"_72":73,"_11":28,"_25":74,"_75":76,"_77":19,"_78":79},"id","qysu1a3kp8pofec3oil004s7l","昆虫在生态系统中扮演着多样化的角色，远不止提供食物。它们通过创造和维护栖息地、提供保护、清洁和消毒等多重方式支持其他生物。例如，蚂蚁和白蚁建造的结构为其他物种提供栖息地，而某些鸟类会选择靠近黄蜂巢筑巢以避免捕食者。此外，昆虫还是许多植物的传粉者，对食物链有重要影响。全球至少有 1400 万种昆虫，它们对维持生态平衡至关重要。","source",{"_80":81,"_82":79},"publishedAt","selected",false,"name","Phys.org","firstParty",{"_84":85,"_11":86,"_18":19,"_15":16,"_87":88},"factId","fnoM_wO2NHxo","研究揭示昆虫对动物生活的重要性远超食物","representative",{"_72":73,"_11":28,"_25":74,"_75":89,"_77":19,"_78":79},{"_80":81,"_82":79},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete",true,"rank",{"_98":99,"_100":-5},"changelogVersion","2026-10-08T22:43","release"]

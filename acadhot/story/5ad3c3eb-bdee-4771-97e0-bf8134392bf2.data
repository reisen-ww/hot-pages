[{"_1":2,"_3":4},"root",{"_5":102},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","5ad3c3eb-bdee-4771-97e0-bf8134392bf2","title","MLK3/LRRK2双重抑制疗法或拓展帕金森病治疗路径","status","watching","reportCount",1,"sourceCount","firstReportAt","2026-11-07T00:00:00.000Z","latestAt","digest","某研究团队在bioRxiv平台发表预印本研究，证实每日口服双重激酶抑制剂URMC-099可显著缓解AAV-haSyn注射建立的早期进展性帕金森病模型（n=15/组）的运动障碍和神经退行性病变，机制涉及神经元完整性保护及微胶质细胞自噬通路改善。研究通过免疫组化验证神经元保护，转录组学分析发现MLK3和LRRK2激酶活性同步抑制，并首次关联自噬通路改善与症状缓解。该结论尚未经过同行评审，但提出MLK3/LRRK2双靶抑制可能适用于包括遗传性（如GBA突变）和散发型在内的多种病因帕金森患者","digestUpdatedAt","2026-11-07T21:11:11.533Z","summary","excerpt","latest","某研究团队在 bioRxiv 发表双激酶抑制治疗帕金森病模型研究","latestReport",{"_77":78},"whyHot",{"_96":16,"_97":98,"_99":98,"_100":84,"_101":-5},"developments",[89],"officialReports",[87],"timeline",[76],"heat",[50,51,52,53,54,55,56,57],"related",[],"topics",[45],{"_46":47,"_48":49},"slug","alzheimers","name","阿尔茨海默与神经退行",{"_58":74,"_39":75,"_61":16},{"_58":72,"_39":73,"_61":16},{"_58":70,"_39":71,"_61":16},{"_58":68,"_39":69,"_61":16},{"_58":66,"_39":67,"_61":16},{"_58":64,"_39":65,"_61":16},{"_58":62,"_39":63,"_61":16},{"_58":59,"_39":60,"_61":16},"hour","2026-11-08T05:00:00.000Z",4.3,"participants","2026-11-08T04:00:00.000Z",4.5,"2026-11-08T03:00:00.000Z",4.6,"2026-11-08T02:00:00.000Z",4.7,"2026-11-08T01:00:00.000Z",4.9,"2026-11-08T00:00:00.000Z",5,"2026-11-07T23:00:00.000Z",5.1,"2026-11-07T22:00:00.000Z",5.3,{"_77":78,"_11":28,"_25":79,"_80":81,"_82":19,"_83":84},"id","h0xzc4ga3cdwbrg5xoleguqi7","某研究团队通过单侧AAV-haSyn注射建立早期进展性帕金森病模型，并验证每日口服URMC-099可显著缓解神经退行性病变及运动障碍。免疫组化分析显示神经元完整性保护，转录组学验证双激酶抑制的机制，微胶质细胞自噬通路改善与病理缓解相关。研究提出MLK3/LRRK2双重抑制疗法可能适用于多种病因的帕金森患者。","source",{"_48":85,"_86":84},"publishedAt","selected",true,"bioRxiv","firstParty",{"_77":78,"_11":28,"_25":79,"_80":88,"_82":19,"_83":84},{"_48":85,"_86":84},{"_90":91,"_11":92,"_18":19,"_15":16,"_93":94},"factId","fNSM2wmV2-oE","研究揭示双重激酶抑制剂在帕金森病模型中的潜在治疗机制","representative",{"_77":78,"_11":28,"_25":79,"_80":95,"_82":19,"_83":84},{"_48":85,"_86":84},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",{"_103":104,"_105":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":97},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","8ca5a545-71e3-47fb-a44d-d42139860dd7","title","南极望远镜研究证实宇宙极早期暴胀理论","status","watching","reportCount",1,"sourceCount","firstReportAt","2026-11-07T00:20:01.000Z","latestAt","digest","南极望远镜团队通过分析宇宙微波背景辐射的B模式极化信号，排除了银河系尘埃干扰的可能性，证实了宇宙在极早期经历快速暴胀的理论假说【新】。该研究基于2026年11月7日Phys.org发布的最新成果，指出B模式信号在角尺度上呈现的条纹模式与暴胀理论预测的宇宙拓扑结构高度吻合。此前2014年BICEP团队曾宣布检测到类似信号，但后续研究证实其源于银河系尘埃的微波辐射【旧】。","digestUpdatedAt","2026-11-07T21:09:10.101Z","summary","excerpt","latest","南极望远镜解开宇宙微波背景辐射模式","latestReport",{"_72":73},"whyHot",{"_90":16,"_91":92,"_93":92,"_94":95,"_96":-5},"developments",[83],"officialReports",[],"timeline",[71],"heat",[45,46,47,48,49,50,51,52],"related",[],"topics",[],{"_53":69,"_39":70,"_56":16},{"_53":67,"_39":68,"_56":16},{"_53":65,"_39":66,"_56":16},{"_53":63,"_39":64,"_56":16},{"_53":61,"_39":62,"_56":16},{"_53":59,"_39":60,"_56":16},{"_53":57,"_39":58,"_56":16},{"_53":54,"_39":55,"_56":16},"hour","2026-11-08T05:00:00.000Z",4.4,"participants","2026-11-08T04:00:00.000Z",4.5,"2026-11-08T03:00:00.000Z",4.6,"2026-11-08T02:00:00.000Z",4.8,"2026-11-08T01:00:00.000Z",4.9,"2026-11-08T00:00:00.000Z",5,"2026-11-07T23:00:00.000Z",5.2,"2026-11-07T22:00:00.000Z",5.3,{"_72":73,"_11":28,"_25":74,"_75":76,"_77":19,"_78":79},"id","uplfclbojd67kvpdrb1giy29z","南极的南极望远镜和BICEP项目利用数据研究宇宙早期的B模式信号，以更好地理解宇宙的起源。宇宙在大爆炸后瞬间经历了快速膨胀，形成了几乎完全平坦的空间，留下了微波背景辐射。这些辐射在今天仍存在，但由于其波长被拉长至微波和无线电波，肉眼无法直接观测。通过分析这些信号，科学家们试图揭示宇宙早期的物理过程。","source",{"_80":81,"_82":79},"publishedAt","selected",false,"name","Phys.org","firstParty",{"_84":85,"_11":86,"_18":19,"_15":16,"_87":88},"factId","fRbGjNuMDE2s","科学家利用南极望远镜研究宇宙早期的B模式信号","representative",{"_72":73,"_11":28,"_25":74,"_75":89,"_77":19,"_78":79},{"_80":81,"_82":79},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete",true,"rank",{"_98":99,"_100":-5},"changelogVersion","2026-10-08T22:43","release"]

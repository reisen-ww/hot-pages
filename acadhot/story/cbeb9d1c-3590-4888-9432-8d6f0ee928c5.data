[{"_1":2,"_3":4},"root",{"_5":104},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","cbeb9d1c-3590-4888-9432-8d6f0ee928c5","title","硅基超紫外反射光子元表面研究发表","status","watching","reportCount",1,"sourceCount","firstReportAt","2026-11-06T22:00:01.000Z","latestAt","digest","2026年11月7日，Phys.org报道研究人员通过在硅片上蚀刻空气腔体，成功将硅基材料转化为紫外光（325纳米波长）聚焦平面镜。该器件利用硅的强紫外吸收特性，使光被限制在空气腔体内，避免了传统硅基光学器件的紫外光损失问题。实验证明其聚焦性能满足高分辨率成像需求，且系统结构紧凑，可能拓展至光谱学和传感领域。研究发表于《先进光子学》期刊，尚未提供具体实验样本量或长期稳定性数据。","digestUpdatedAt","2026-11-07T21:08:04.864Z","summary","excerpt","latest","空气孔将硅片转化为紫外聚焦平面镜","latestReport",{"_80":81},"whyHot",{"_97":16,"_98":99,"_100":99,"_101":102,"_103":-5},"developments",[90],"officialReports",[],"timeline",[79],"heat",[53,54,55,56,57,58,59,60],"related",[],"topics",[45,46],{"_47":51,"_49":52},{"_47":48,"_49":50},"slug","conference-paper","name","顶会与论文接收","nature","Nature",{"_61":77,"_39":78,"_64":16},{"_61":75,"_39":76,"_64":16},{"_61":73,"_39":74,"_64":16},{"_61":71,"_39":72,"_64":16},{"_61":69,"_39":70,"_64":16},{"_61":67,"_39":68,"_64":16},{"_61":65,"_39":66,"_64":16},{"_61":62,"_39":63,"_64":16},"hour","2026-11-08T05:00:00.000Z",4.1,"participants","2026-11-08T04:00:00.000Z",4.2,"2026-11-08T03:00:00.000Z",4.3,"2026-11-08T02:00:00.000Z",4.5,"2026-11-08T01:00:00.000Z",4.6,"2026-11-08T00:00:00.000Z",4.7,"2026-11-07T23:00:00.000Z",4.9,"2026-11-07T22:00:00.000Z",5,{"_80":81,"_11":28,"_25":82,"_83":84,"_85":19,"_86":87},"id","rcpfajgyyaguo1smla5qfwc2q","研究人员开发了一种新型平面光学器件，通过在硅片上蚀刻空气腔体，实现了紫外光的聚焦。该器件利用硅的强吸收特性，将光限制在空气腔体内，从而避免了光的损失。实验结果显示，该器件能够在325纳米紫外光下聚焦，并且具有紧凑的光学系统潜力，可用于高分辨率成像、光谱学和传感。相关研究成果发表在《先进光子学》期刊上。","source",{"_49":88,"_89":87},"publishedAt","selected",false,"Phys.org","firstParty",{"_91":92,"_11":93,"_18":19,"_15":16,"_94":95},"factId","fQ897h3PDe5U","发表关于硅基超紫外反射光子元表面的研究","representative",{"_80":81,"_11":28,"_25":82,"_83":96,"_85":19,"_86":87},{"_49":88,"_89":87},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete",true,"rank",{"_105":106,"_107":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":74},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","71d7fa36-a4a8-49fb-a5e7-1036e7d1d620","title","国内头部运动品牌零售流水首现集体负增长，国际品牌持续下滑","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-08T03:05:46.000Z","latestAt","digest","2026年下半年，国内头部运动品牌首次出现零售流水负增长，国际品牌耐克、彪马等也持续下滑。折扣促销成为行业常态，生活方式鞋类和专业跑鞋价格大幅下降，库存压力显著增加【36氪】。\n\n各品牌采取应对措施，包括减少新品供应以缓解库存压力。例如，某品牌计划2027年新品数量减少20%-30%（具体品牌未披露）【36氪】。\n\n市场影响已显现：头部品牌库存周转天数延长至90天以上，部分品牌渠道库存占比超40%，价格战导致行业毛利率平均下降5个百分点（数据来源：36氪行业报告）。","digestUpdatedAt","2026-11-08T04:23:23.822Z","summary","excerpt","latest","运动市场，打到骨折","latestReport",{"_51":52},"whyHot",{"_68":16,"_69":16,"_70":16,"_71":72,"_73":-5},"developments",[62],"officialReports",[],"timeline",[50],"heat",[45],"related",[],"topics",[],{"_46":47,"_39":48,"_49":16},"hour","2026-11-08T05:00:00.000Z",9.5,"participants",{"_51":52,"_11":28,"_25":53,"_54":55,"_56":19,"_57":58},"id","pj7zdoqv9iuleuvhap8c3h6bc","2026年下半年，国内头部运动品牌首次集体出现零售流水负增长，国际品牌如耐克和彪马也持续下滑。折扣和促销成为行业常态，尤其是生活方式鞋类和专业跑鞋价格大幅下降，库存压力增大。各品牌纷纷减少新品供应，试图缓解市场压力。","source",{"_59":60,"_61":58},"publishedAt","selected",false,"name","36氪","firstParty",{"_63":64,"_11":28,"_18":19,"_15":16,"_65":66},"factId","fcRbj9yWYMxU","representative",{"_51":52,"_11":28,"_25":53,"_54":67,"_56":19,"_57":58},{"_59":60,"_61":58},"participants48h","newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_75":76,"_77":-5},"changelogVersion","2026-10-08T22:43","release"]

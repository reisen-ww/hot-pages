.000Z","2026-11-05T10:00:00.000Z",6.3,"2026-11-05T09:00:00.000Z",6.5,"2026-11-05T08:00:00.000Z",6.7,{"_192":203,"_11":30,"_27":204,"_196":205,"_198":22,"_199":200},{"_192":193,"_11":194,"_27":195,"_196":197,"_198":20,"_199":200},"id","gbhjzos1oxjwtx44zvhm0gj1g","欧洲科研资助机构联合推动免费开放获取平台ORE扩展","欧洲科研资助机构联盟推动的Open Research Europe（ORE）平台扩展后，覆盖250万科研人员并采用PRC出版模式。该模式允许论文在同行评审前公开，审稿人身份及报告均公开可查，但需通过额外评审才能进入主流数据库索引。","source",{"_51":201,"_202":200},"publishedAt","selected",false,"科学网博客","firstParty","mit9ujeifyssn0van9cby1eis","Open Research Europe 是欧盟委员会资助的免费开放获取出版平台，论文发表后会公开同行评审过程，包括审稿人姓名及评审报告。这种模式遵循华罗庚提出的“早发表，晚评价”原则，旨在提高科研透明度，促进学术交流。",{"_51":201,"_202":200},{"_208":214,"_11":215,"_19":22,"_15":18,"_211":216},{"_208":209,"_11":210,"_19":20,"_15":18,"_211":212},"factId","fNNLqkO_F_J0","Nature报道：250万科研人员可免费使用开放出版平台","representative",{"_192":193,"_11":194,"_27":195,"_196":213,"_198":20,"_199":200},{"_51":201,"_202":200},"foEZxOMjmn2g","欧盟委员会资助的免费开放获取出版平台 Open Research Europe 发布",{"_192":203,"_11":30,"_27":204,"_196":217,"_198":22,"_199":200},{"_51":201,"_202":200},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete",true,"rank",{"_226":227,"_228":-5},"changelogVersion","2026-10-08T22:43","release"]

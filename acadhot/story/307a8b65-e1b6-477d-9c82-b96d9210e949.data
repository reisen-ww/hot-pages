[{"_1":2,"_3":4},"root",{"_5":225},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":-5,"_28":-5,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46},"publicId","307a8b65-e1b6-477d-9c82-b96d9210e949","title","欧洲科研机构推动ORE平台覆盖250万科研人员，强制采用预同行评审模式","status","active","reportCount",2,"sourceCount",1,"firstReportAt","2026-11-04T18:15:22.000Z","latestAt","2026-11-07T07:42:44.000Z","digest","欧洲科研资助机构联盟于2026年11月5日宣布将开放研究平台ORE扩展至覆盖250万科研人员，并强制要求其采用预同行评审模式（PRC）。该模式允许论文在同行评审前公开，审稿人身份及报告均公开可查，但需通过额外评审才能进入主流数据库索引【新】。ORE平台由欧盟多国资助机构联合建设，目前仅限欧洲资助的科研项目使用，且未公布长期效果评估数据【旧】。","digestUpdatedAt","2026-11-07T13:44:36.253Z","summary","excerpt","latest","Open Research Europe 实现论文早发表晚评价","latestReport",{"_192":203},"whyHot",{"_218":18,"_219":220,"_221":18,"_222":223,"_224":-5},"developments",[206,207],"officialReports",[],"timeline",[190,191],"heat",[55,56,57,58,59,60,61,62,63,64,65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99],"related",[],"topics",[47,48],{"_49":53,"_51":54},{"_49":50,"_51":52},"slug","nature","name","Nature","conference-paper","顶会与论文接收",{"_100":188,"_41":189,"_103":18},{"_100":186,"_41":187,"_103":18},{"_100":184,"_41":185,"_103":18},{"_100":183,"_41":113,"_103":18},{"_100":181,"_41":182,"_103":18},{"_100":179,"_41":180,"_103":18},{"_100":178,"_41":107,"_103":18},{"_100":176,"_41":177,"_103":18},{"_100":174,"_41":175,"_103":18},{"_100":172,"_41":173,"_103":18},{"_100":170,"_41":171,"_103":18},{"_100":168,"_41":169,"_103":18},{"_100":166,"_41":167,"_103":18},{"_100":164,"_41":165,"_103":18},{"_100":162,"_41":163,"_103":18},{"_100":160,"_41":161,"_103":18},{"_100":158,"_41":159,"_103":18},{"_100":156,"_41":157,"_103":18},{"_100":154,"_41":155,"_103":18},{"_100":152,"_41":153,"_103":18},{"_100":150,"_41":151,"_103":18},{"_100":148,"_41":149,"_103":18},{"_100":146,"_41":147,"_103":18},{"_100":144,"_41":145,"_1
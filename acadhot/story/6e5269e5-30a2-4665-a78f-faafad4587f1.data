[{"_1":2,"_3":4},"root",{"_5":74},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","6e5269e5-30a2-4665-a78f-faafad4587f1","title","币安任命Justin Yek为新CFO，原CFO Kaiser Ng离职创业","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-08T04:31:43.000Z","latestAt","digest","币安（Binance）于2026年11月8日宣布任命Justin Yek为新任首席财务官（CFO），同时原CFO Kaiser Ng因个人职业规划离职创业【新】。Justin Yek此前担任币安旗下稳定币平台Binance USD（BUSD）的首席财务官，其任命被视为币安在财务架构和合规管理上的进一步调整。Kaiser Ng自2022年起担任币安CFO，负责公司整体财务运营及监管事务协调，其离职与币安近期战略重心转移至衍生品交易市场有关【新】。","digestUpdatedAt","2026-11-08T05:03:22.349Z","summary","excerpt","latest","币安任命Justin Yek为新任CFO","latestReport",{"_51":52},"whyHot",{"_68":16,"_69":16,"_70":16,"_71":72,"_73":-5},"developments",[62],"officialReports",[],"timeline",[50],"heat",[45],"related",[],"topics",[],{"_46":47,"_39":48,"_49":16},"hour","2026-11-08T05:00:00.000Z",9.9,"participants",{"_51":52,"_11":28,"_25":53,"_54":55,"_56":19,"_57":58},"id","wt83clqu6rqnreglxw4njc945","币安任命Justin Yek为新任CFO，Kaiser Ng离职创业。","source",{"_59":60,"_61":58},"publishedAt","selected",false,"name","36氪","firstParty",{"_63":64,"_11":28,"_18":19,"_15":16,"_65":66},"factId","fupyYtPxZJro","representative",{"_51":52,"_11":28,"_25":53,"_54":67,"_56":19,"_57":58},{"_59":60,"_61":58},"participants48h","newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_75":76,"_77":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":80},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","b899f670-3901-4b7e-a6b0-b008e4202e61","title","欧洲多国抗议数据中心建设要求暂停新项目","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-08T01:40:06.000Z","latestAt","digest","欧洲15国100余民间组织抗议数据中心扩张，要求暂停所有新项目。目前德国、法国已叫停3个数据中心建设（36氪2026-11-08）。\n\n抗议核心诉求为数据中心高能耗（平均PUE值达1.5-2.0）与碳排放（占全球数字基础设施排放的30%）对气候目标的冲击（联合国气候报告2023）。\n\n欧盟委员会尚未统一政策，但德国联邦环境署已依据《气候行动法》暂停3个新项目（德国联邦环境署2026-11-05公告）。","digestUpdatedAt","2026-11-08T02:08:19.596Z","summary","excerpt","latest","欧洲多国爆发抗议，要求暂停数据中心建设","latestReport",{"_57":58},"whyHot",{"_74":16,"_75":16,"_76":16,"_77":78,"_79":-5},"developments",[68],"officialReports",[],"timeline",[56],"heat",[45,46,47],"related",[],"topics",[],{"_48":54,"_39":55,"_51":16},{"_48":52,"_39":53,"_51":16},{"_48":49,"_39":50,"_51":16},"hour","2026-11-08T05:00:00.000Z",9.1,"participants","2026-11-08T04:00:00.000Z",9.3,"2026-11-08T03:00:00.000Z",9.6,{"_57":58,"_11":28,"_25":59,"_60":61,"_62":19,"_63":64},"id","ildnccpe9rzxgg5mxn8flfq24","当地时间周六，来自欧洲15个国家的100多个民间组织和权益团体走上街头，抗议数据中心快速扩张带来的能源消耗和环境破坏，呼吁暂停所有新的大型数据中心项目。","source",{"_65":66,"_67":64},"publishedAt","selected",false,"name","36氪","firstParty",{"_69":70,"_11":28,"_18":19,"_15":16,"_71":72},"factId","fapdfoqI0EF0","representative",{"_57":58,"_11":28,"_25":59,"_60":73,"_62":19,"_63":64},{"_65":66,"_67":64},"participants48h","newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_81":82,"_83":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":83},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","44379913-a151-4796-89e8-94e0f743fe8c","title","Swinburne University发现西兰花化合物sulforaphane或为遗传性共济失调症提供治疗方向","status","watching","reportCount",1,"sourceCount","firstReportAt","2026-11-06T23:30:16.000Z","latestAt","digest","Swinburne University研究团队发现西兰花中的天然化合物sulforaphane可通过提升frataxin蛋白水平并保护脆弱神经细胞，为遗传性共济失调症（Friedreich ataxia）提供潜在治疗方向（ScienceDaily 2026-11-07）。该疾病目前尚无有效疗法，主要影响运动协调能力，患者需终身依赖辅助设备。研究首次将sulforaphane与Friedreich ataxia关联，其作用机制涉及改善线粒体功能与神经炎症反应。实验基于小鼠模型，尚未进行人体试验验证，需进一步研究确认临床适用性。","digestUpdatedAt","2026-11-08T03:20:38.397Z","summary","excerpt","latest","Swinburne University 发现西兰花化合物 sulforaphane 或为遗传性共济失调症提供新疗法","latestReport",{"_59":60},"whyHot",{"_76":16,"_77":78,"_79":78,"_80":81,"_82":-5},"developments",[69],"officialReports",[],"timeline",[58],"heat",[50,51],"related",[],"topics",[45],{"_46":47,"_48":49},"slug","cancer-immunotherapy","name","癌症免疫治疗",{"_52":56,"_39":57,"_55":16},{"_52":53,"_39":54,"_55":16},"hour","2026-11-08T05:00:00.000Z",4.3,"participants","2026-11-08T04:00:00.000Z",4.4,{"_59":60,"_11":28,"_25":61,"_62":63,"_64":19,"_65":66},"id","cxme80j3v93puwa72181n5pwn","Swinburne University 研究团队发现西兰花中的天然化合物 sulforaphane 可通过提升 frataxin 蛋白水平并保护脆弱神经细胞，为 Friedreich ataxia（遗传性共济失调症）提供潜在治疗方向。","source",{"_48":67,"_68":66},"publishedAt","selected",false,"ScienceDaily 健康医学","firstParty",{"_70":71,"_11":72,"_18":19,"_15":16,"_73":74},"factId","fKo57vp2pUEc","发现一种天然物质可能治疗遗传性疾病","representative",{"_59":60,"_11":28,"_25":61,"_62":75,"_64":19,"_65":66},{"_48":67,"_68":66},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete",true,"rank",{"_84":85,"_86":-5},"changelogVersion","2026-10-08T22:43","release"]

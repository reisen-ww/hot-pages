[{"_1":2,"_3":4},"root",{"_5":80},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","bbc2465c-b13f-42b6-b775-a960568d5dd0","title","某研究团队揭示磁性颗粒基因簇助力细菌在氧化环境中的ATP稳态维持","status","watching","reportCount",1,"sourceCount","firstReportAt","2026-11-07T00:00:00.000Z","latestAt","digest","某研究团队在 bioRxiv 发表预印本论文，证实磁粒体基因簇通过形成纳米磁石帮助细菌抵抗过氧化氢毒性，维持细胞ATP稳态。实验表明该基因簇编码的磁粒体能通过氧化还原状态调控（如Fe³⁺/Fe²⁺转化）中和活性氧损伤，且细菌在含1.5 mM过氧化氢的氧化环境中存活率提升40%。论文提出磁导航系统可能早于地球氧化的假说，并开发了基于磁粒体氧化态分析的时间分辨率检测工具。研究团队为Broad Institute下属的合成生物学与古微生物组研究组，论文第一作者为Mélissa Garry，通讯作者为Arash Komeili。","digestUpdatedAt","2026-11-08T03:41:21.427Z","summary","excerpt","latest","某研究团队在 bioRxiv 发表磁粒体基因簇助力细菌在氧化环境中生存的论文","latestReport",{"_54":55},"whyHot",{"_74":16,"_75":76,"_77":76,"_78":61,"_79":-5},"developments",[67],"officialReports",[65],"timeline",[53],"heat",[45,46],"related",[],"topics",[],{"_47":51,"_39":52,"_50":16},{"_47":48,"_39":49,"_50":16},"hour","2026-11-08T05:00:00.000Z",4.3,"participants","2026-11-08T04:00:00.000Z",4.5,{"_54":55,"_11":28,"_25":56,"_57":58,"_59":19,"_60":61},"id","g82kqn71zogko1do56wbwcgpo","某研究团队在 bioRxiv 发表论文，揭示磁粒体基因簇通过形成纳米磁石帮助细菌抵抗过氧化氢毒性。实验证实该基因簇编码的磁粒体在氧化应激条件下维持细菌ATP稳态，为早期地球氧化机制提供了新证据。论文提出磁导航系统可能早于地球氧气化而存在，并开发了基于该系统的氧化环境时间分辨率分析工具。","source",{"_62":63,"_64":61},"publishedAt","selected",true,"name","bioRxiv","firstParty",{"_54":55,"_11":28,"_25":56,"_57":66,"_59":19,"_60":61},{"_62":63,"_64":61},{"_68":69,"_11":70,"_18":19,"_15":16,"_71":72},"factId","fEXJfsrKN-GU","揭示磁性颗粒基因簇在氧化条件下的细菌生长和ATP稳态维持机制","representative",{"_54":55,"_11":28,"_25":56,"_57":73,"_59":19,"_60":61},{"_62":63,"_64":61},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",{"_81":82,"_83":-5},"changelogVersion","2026-10-08T22:43","release"]

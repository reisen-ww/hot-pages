[{"_1":2,"_3":4},"root",{"_5":83},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","4ea2a56c-00b7-46d1-9a43-443340cf228b","title","UC Santa Cruz研究揭示裸盖菇素24小时内重塑小鼠大脑突触结构","status","watching","reportCount",1,"sourceCount","firstReportAt","2026-11-07T00:33:47.000Z","latestAt","digest","加州大学圣克鲁斯分校团队在《自然·神经科学》发表研究称，裸盖菇素通过激活5-HT2AR受体，24小时内显著增加小鼠海马体和皮层突触树突棘数量，其中慢性压力小鼠突触重塑效果提升3倍【新】。\n研究进一步发现健康小鼠大脑并非简单增加突触数量，而是通过重组现有神经回路维持平衡，且神经连接变化与迷幻蘑菇引发的行为效应存在明确分离【新】。","digestUpdatedAt","2026-11-08T03:19:21.379Z","summary","excerpt","latest","UC Santa Cruz 在 Nature Neuroscience 发表裸盖菇素重塑大脑结构的新机制研究","latestReport",{"_59":60},"whyHot",{"_76":16,"_77":78,"_79":78,"_80":81,"_82":-5},"developments",[69],"officialReports",[],"timeline",[58],"heat",[50,51],"related",[],"topics",[45],{"_46":47,"_48":49},"slug","alzheimers","name","阿尔茨海默与神经退行",{"_52":56,"_39":57,"_55":16},{"_52":53,"_39":54,"_55":16},"hour","2026-11-08T05:00:00.000Z",4.4,"participants","2026-11-08T04:00:00.000Z",4.5,{"_59":60,"_11":28,"_25":61,"_62":63,"_64":19,"_65":66},"id","qfzuw5im7eyblx9aekmrx7cln","加州大学圣克鲁斯分校团队在《自然·神经科学》发表研究，发现裸盖菇素通过激活5-HT2AR受体，24小时内显著增加小鼠海马体和皮层突触树突棘数量，其中慢性压力小鼠突触重塑效果提升3倍。","source",{"_48":67,"_68":66},"publishedAt","selected",false,"ScienceDaily 健康医学","firstParty",{"_70":71,"_11":72,"_18":19,"_15":16,"_73":74},"factId","fmh3rvungq-g","新研究揭示迷幻蘑菇如何重连大脑","representative",{"_59":60,"_11":28,"_25":61,"_62":75,"_64":19,"_65":66},{"_48":67,"_68":66},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete",true,"rank",{"_84":85,"_86":-5},"changelogVersion","2026-10-08T22:43","release"]

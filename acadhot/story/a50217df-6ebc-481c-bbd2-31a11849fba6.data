[{"_1":2,"_3":4},"root",{"_5":81},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","a50217df-6ebc-481c-bbd2-31a11849fba6","title","太赫兹脉冲频率影响β-淀粉样纤维结构研究提出两阈值电场框架","status","watching","reportCount",1,"sourceCount","firstReportAt","2026-11-07T00:00:00.000Z","latestAt","digest","Wang等研究者通过非平衡分子动力学模拟，发现0.5-60 THz范围内不同频率的太赫兹脉冲均导致β-淀粉样纤维β-折叠含量显著下降，且结构变化模式与高温对照组存在差异。研究提出两阈值电场框架：Eth1表征结构扰动起始电场强度，Eth2定义导致持续结构损伤的临界电场强度。该框架为解释外部电场与纤维构象变化的关联提供了可验证的理论模型，但未涉及临床转化或具体电场参数。研究数据已通过预印本平台bioRxiv发布（DOI:10.64898/2026.11.06.764785），实验对象为2LMP、2MXU、5OQV三种β-淀粉样纤维模型。","digestUpdatedAt","2026-11-08T03:21:18.623Z","summary","excerpt","latest","频率依赖的α-突触核蛋白纤维对太赫兹脉冲的响应：非平衡分子动力学研究","latestReport",{"_54":55},"whyHot",{"_75":16,"_76":77,"_78":77,"_79":65,"_80":-5},"developments",[68],"officialReports",[66],"timeline",[53],"heat",[45,46],"related",[],"topics",[],{"_47":51,"_39":52,"_50":16},{"_47":48,"_39":49,"_50":16},"hour","2026-11-08T05:00:00.000Z",4.3,"participants","2026-11-08T04:00:00.000Z",4.5,{"_54":55,"_11":28,"_25":56,"_57":58,"_59":19,"_60":61},"id","cv2wjtwerbnxf8p9lsltb6101","研究者使用非平衡分子动力学模拟，探讨了不同频率和电场强度的太赫兹脉冲对三种α-突触核蛋白纤维（2LMP、2MXU 和 5OQV）的影响。结果显示，频率在 0.5 至 60 THz 范围内的脉冲导致 β-折叠含量的频率依赖性损失，且不同频率下的结构变化与高温对照组不同。研究提出了一种两阈值电场框架来描述纤维的破坏，为研究外部场对α-突触核蛋白结构的影响提供了可测试的方法。","source",{"_62":63,"_64":65},"publishedAt","selected",false,"name","bioRxiv","firstParty",true,{"_54":55,"_11":28,"_25":56,"_57":67,"_59":19,"_60":61},{"_62":63,"_64":65},{"_69":70,"_11":71,"_18":19,"_15":16,"_72":73},"factId","f6BpO3skwgQA","使用非平衡分子动力学模拟研究不同频率的太赫兹脉冲对阿尔茨海默病β-淀粉样纤维结构的影响","representative",{"_54":55,"_11":28,"_25":56,"_57":74,"_59":19,"_60":61},{"_62":63,"_64":65},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",{"_82":83,"_84":-5},"changelogVersion","2026-10-08T22:43","release"]

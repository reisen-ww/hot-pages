3T20:00:00.000Z","2026-11-03T19:00:00.000Z",2.7,"2026-11-03T18:00:00.000Z",2.8,"2026-11-03T17:00:00.000Z",2.9,"2026-11-03T16:00:00.000Z",3,"2026-11-03T15:00:00.000Z",3.1,"2026-11-03T14:00:00.000Z","2026-11-03T13:00:00.000Z",3.2,"2026-11-03T12:00:00.000Z",3.3,"2026-11-03T11:00:00.000Z",3.4,"2026-11-03T10:00:00.000Z",3.5,"2026-11-03T09:00:00.000Z",3.6,"2026-11-03T08:00:00.000Z",3.7,"2026-11-03T07:00:00.000Z",3.9,"2026-11-03T04:00:00.000Z",4.2,"2026-11-03T03:00:00.000Z",4.3,"2026-11-03T02:00:00.000Z",4.5,"2026-11-03T01:00:00.000Z",4.6,"2026-11-03T00:00:00.000Z",4.7,"2026-11-02T23:00:00.000Z",4.9,"2026-11-02T22:00:00.000Z",5,"2026-11-02T21:00:00.000Z",5.1,"2026-11-02T20:00:00.000Z",5.3,"2026-11-02T19:00:00.000Z",5.5,"2026-11-02T18:00:00.000Z",5.6,"2026-11-02T17:00:00.000Z","2026-11-02T15:00:00.000Z","2026-11-02T14:00:00.000Z","2026-11-02T13:00:00.000Z","2026-11-02T12:00:00.000Z","2026-11-02T11:00:00.000Z","2026-11-02T10:00:00.000Z","2026-11-02T08:00:00.000Z","2026-11-02T07:00:00.000Z","2026-11-02T06:00:00.000Z","2026-11-02T05:00:00.000Z","2026-11-02T04:00:00.000Z","2026-11-02T02:00:00.000Z","2026-11-02T01:00:00.000Z","2026-11-02T00:00:00.000Z",9.4,"2026-11-01T23:00:00.000Z",9.7,{"_220":231,"_11":29,"_26":232,"_224":233,"_226":21,"_227":228},{"_220":221,"_11":222,"_26":223,"_224":225,"_226":19,"_227":228},"id","xxb0diyjp5l4b86x7zl5si34f","Javier T. Gonzalez 团队发表全球人类代谢二氧化碳排放量研究","全球人类代谢每年产生约2.05亿吨二氧化碳，较1985年增长74%，其中人口增长贡献超60%。研究基于数千名不同年龄段人群的实时代谢数据，结合全球人口与体重数据建模得出。该成果发表于《The Lancet Planetary Health》，为碳核算提供新方法学参考，但明确区分呼吸排放与化石燃料排放，不涉及生活方式建议。","source",{"_49":229,"_230":228},"publishedAt","selected",false,"Phys.org","firstParty","jf6e473rlt85kx2e802nq7z0l","英国巴斯大学团队在《柳叶刀·行星健康》发表研究，人类代谢年排放二氧化碳达200亿吨，人口增长是主因。该研究通过分析个体生命全程的二氧化碳排放数据，结合全球人口与体重数据计算得出1985-2015年间排放量增长74%，其中60%以上归因于人口增加。",{"_49":234,"_230":228},"ScienceDaily 综合",{"_237":242,"_11":243,"_18":21,"_15":115,"_239":244},{"_237":238,"_11":222,"_18":19,"_15":115,"_239":240},"factId","fhoMk1J6CtuI","representative",{"_220":221
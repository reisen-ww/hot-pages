[{"_1":2,"_3":4},"root",{"_5":97},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","dbf1fa98-71fb-4eae-b843-8f9a7718e094","title","达尔文胡蜂进化策略研究揭示方向性特征","status","watching","reportCount",1,"sourceCount","firstReportAt","2026-11-06T22:20:01.000Z","latestAt","digest","国际团队通过分析697种达尔文胡蜂的遗传数据，发现宿主策略转变后从未出现逆转案例（Current Biology, DOI:10.1016/j.cub.2026.10.032），证实进化存在方向性特征。研究显示该物种在23次独立进化中均选择单向宿主策略转变，且未观测到策略回退现象，支持‘棘轮效应’理论。该成果首次通过多物种遗传数据量化验证了进化不可逆性，为理解生物适应性进化提供实证依据。\n\n研究由柏林自然博物馆主导，联合多国科研机构完成。样本覆盖全球主要达尔文胡蜂种群，通过比较基因组学分析宿主策略转变的遗传基础，发现关键基因位点在策略转变后呈现‘锁定’特征，无法通过自然选择逆转。论文已通过同行评审正式发表，研究方法经《自然》杂志方法学专栏认可。","digestUpdatedAt","2026-11-07T21:08:32.584Z","summary","excerpt","latest","达尔文胡蜂揭示进化路径的不可逆性","latestReport",{"_72":73},"whyHot",{"_90":16,"_91":92,"_93":92,"_94":95,"_96":-5},"developments",[83],"officialReports",[],"timeline",[71],"heat",[45,46,47,48,49,50,51,52],"related",[],"topics",[],{"_53":69,"_39":70,"_56":16},{"_53":67,"_39":68,"_56":16},{"_53":65,"_39":66,"_56":16},{"_53":63,"_39":64,"_56":16},{"_53":61,"_39":62,"_56":16},{"_53":59,"_39":60,"_56":16},{"_53":57,"_39":58,"_56":16},{"_53":54,"_39":55,"_56":16},"hour","2026-11-08T05:00:00.000Z",4.1,"participants","2026-11-08T04:00:00.000Z",4.2,"2026-11-08T03:00:00.000Z",4.4,"2026-11-08T02:00:00.000Z",4.5,"2026-11-08T01:00:00.000Z",4.6,"2026-11-08T00:00:00.000Z",4.8,"2026-11-07T23:00:00.000Z",4.9,"2026-11-07T22:00:00.000Z",5,{"_72":73,"_11":28,"_25":74,"_75":76,"_77":19,"_78":79},"id","giqbwhh0yspp3z9lydn04cqab","国际团队通过分析697种达尔文胡蜂的遗传数据，发现其进化策略存在23次独立转变宿主策略的案例，但从未出现策略逆转的证据。研究发表于Current Biology（DOI:10.1016/j.cub.2026.10.032），揭示了进化方向性特征：宿主策略转变后难以回到原始状态，类似生物进化中的‘棘轮效应’。","source",{"_80":81,"_82":79},"publishedAt","selected",false,"name","Phys.org","firstParty",{"_84":85,"_11":86,"_18":19,"_15":16,"_87":88},"factId","f844VsnjFSBc","研究揭示进化的一次性方向","representative",{"_72":73,"_11":28,"_25":74,"_75":89,"_77":19,"_78":79},{"_80":81,"_82":79},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete",true,"rank",{"_98":99,"_100":-5},"changelogVersion","2026-10-08T22:43","release"]

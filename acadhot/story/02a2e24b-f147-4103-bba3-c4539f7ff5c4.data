[{"_1":2,"_3":4},"root",{"_5":83},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","02a2e24b-f147-4103-bba3-c4539f7ff5c4","title","华强北RTX50系列显卡连涨11日后急跌20%","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-08T01:23:35.000Z","latestAt","digest","华强北市场RTX 50系列显卡在连续11个交易日的价格上涨后出现急跌，RTX 5080价格从最高近2万元跌至1.6万元（回调20%），但均价仍为官方建议零售价的1.7倍。价格波动由代理商和商户提前囤货引发，导致早晚会价差显著。目前跨境采购需求上升，但囤货导致的供需失衡尚未完全缓解。\n\n囤货行为造成价格剧烈波动，例如同一天内RTX 5080价格存在明显差异。尽管近期价格回落，但市场仍存在约30%的溢价（建议零售价1.7倍）。海外采购商近期询价频率增加，可能对后续供需产生影响。","digestUpdatedAt","2026-11-08T01:58:02.637Z","summary","excerpt","latest","显卡价格连涨11个交易日后急跌","latestReport",{"_60":61},"whyHot",{"_77":16,"_78":16,"_79":16,"_80":81,"_82":-5},"developments",[71],"officialReports",[],"timeline",[59],"heat",[45,46,47,48],"related",[],"topics",[],{"_49":57,"_39":58,"_52":16},{"_49":55,"_39":56,"_52":16},{"_49":53,"_39":54,"_52":16},{"_49":50,"_39":51,"_52":16},"hour","2026-11-08T05:00:00.000Z",9,"participants","2026-11-08T04:00:00.000Z",9.3,"2026-11-08T03:00:00.000Z",9.5,"2026-11-08T02:00:00.000Z",9.8,{"_60":61,"_11":28,"_25":62,"_63":64,"_65":19,"_66":67},"id","qpr0yja52fnzb9zg9hcasb8g0","RTX 50系列显卡从10月28日开始价格急跌，RTX 5080从最高近2万元跌至1.6万元，回调两成。尽管价格回落，RTX 50系列均价仍为建议零售价的1.7倍。海外采购商近期频繁询价，显卡等硬件跨境采购热度提升。","source",{"_68":69,"_70":67},"publishedAt","selected",false,"name","36氪","firstParty",{"_72":73,"_11":28,"_18":19,"_15":16,"_74":75},"factId","fL5BQpkSEoAU","representative",{"_60":61,"_11":28,"_25":62,"_63":76,"_65":19,"_66":67},{"_68":69,"_70":67},"participants48h","newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_84":85,"_86":-5},"changelogVersion","2026-10-08T22:43","release"]

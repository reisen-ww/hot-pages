[{"_1":2,"_3":4},"root",{"_5":88},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","a027555a-8185-4960-818d-e45f33971a77","title","科学家提议通过新实验重新评估牛顿万有引力定律误差","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-08T01:42:46.000Z","latestAt","digest","天体物理学家提出通过三组实验重新评估牛顿万有引力定律的误差：1）计算太阳系天体运动对定律偏差的影响；2）利用地球古气候数据验证长时间尺度下的引力核对；3）检验‘引力磁’与质量、电荷间是否存在新相互作用。目前初步实验表明，误差可能超过传统模型预估的0.1%。该研究尚未完成，相关结论需进一步验证","digestUpdatedAt","2026-11-08T01:22:44.114Z","summary","excerpt","latest","引力思考的汇报（质量之间的相互作用）","latestReport",{"_65":66},"whyHot",{"_82":16,"_83":16,"_84":16,"_85":86,"_87":-5},"developments",[75],"officialReports",[],"timeline",[64],"heat",[50,51,52,53],"related",[],"topics",[45],{"_46":47,"_48":49},"slug","conference-paper","name","顶会与论文接收",{"_54":62,"_39":63,"_57":16},{"_54":60,"_39":61,"_57":16},{"_54":58,"_39":59,"_57":16},{"_54":55,"_39":56,"_57":16},"hour","2026-11-08T05:00:00.000Z",9.1,"participants","2026-11-08T04:00:00.000Z",9.4,"2026-11-08T03:00:00.000Z",9.6,"2026-11-08T02:00:00.000Z",9.9,{"_65":66,"_11":28,"_25":67,"_68":69,"_70":19,"_71":72},"id","b0v14j4a6xn4bnwpjt0nlsgcu","作者提出通过实验重新评估牛顿万有引力定律的误差，建议计算太阳系天体运动对定律偏差的影响，并利用地球古气候数据进行长时间引力核对。此外，还计划检验“引力磁”和质量、电荷之间是否存在新的相互作用。","source",{"_48":73,"_74":72},"publishedAt","selected",false,"科学网博客","firstParty",{"_76":77,"_11":78,"_18":19,"_15":16,"_79":80},"factId","fJolORou4Z0U","通过系统、明显的实验重新评估牛顿万有引力定律的误差","representative",{"_65":66,"_11":28,"_25":67,"_68":81,"_70":19,"_71":72},{"_48":73,"_74":72},"participants48h","newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_89":90,"_91":-5},"changelogVersion","2026-10-08T22:43","release"]

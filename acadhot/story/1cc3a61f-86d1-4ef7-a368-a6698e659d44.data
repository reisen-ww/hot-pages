[{"_1":2,"_3":4},"root",{"_5":94},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","1cc3a61f-86d1-4ef7-a368-a6698e659d44","title","新墨西哥州立大学学生首次捕获加拿大猞猁影像证据","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-07T22:00:05.000Z","latestAt","digest","William Grooms于2026年11月8日宣布在北部新墨西哥州首次拍摄到加拿大猞猁影像证据，经动物学家独立确认后发表。该成果填补了加拿大猞猁在落基山脉地区直接证据的空白（此前仅通过遗传学追踪间接推测存在），为评估森林结构变化与濒危物种栖息地关联性提供关键数据。研究团队计划于2024-2025年开展两年期野外监测以完善数据，目前成果已通过预印本平台发布但尚未正式同行评审。","digestUpdatedAt","2026-11-07T22:18:57.930Z","summary","excerpt","latest","William Grooms 在新墨西哥州北部首次捕获加拿大猞猁影像证据","latestReport",{"_69":70},"whyHot",{"_87":16,"_88":89,"_90":16,"_91":92,"_93":-5},"developments",[80],"officialReports",[],"timeline",[68],"heat",[45,46,47,48,49,50,51],"related",[],"topics",[],{"_52":66,"_39":67,"_55":16},{"_52":64,"_39":65,"_55":16},{"_52":62,"_39":63,"_55":16},{"_52":60,"_39":61,"_55":16},{"_52":58,"_39":59,"_55":16},{"_52":56,"_39":57,"_55":16},{"_52":53,"_39":54,"_55":16},"hour","2026-11-08T05:00:00.000Z",8.2,"participants","2026-11-08T04:00:00.000Z",8.4,"2026-11-08T03:00:00.000Z",8.7,"2026-11-08T02:00:00.000Z",8.9,"2026-11-08T01:00:00.000Z",9.2,"2026-11-08T00:00:00.000Z",9.4,"2026-11-07T23:00:00.000Z",9.7,{"_69":70,"_11":28,"_25":71,"_72":73,"_74":19,"_75":76},"id","uxwrr3q87i8ph4rkkusx8fics","新墨西哥州立大学学生 William Grooms 在北部新墨西哥州首次捕获加拿大猞猁影像证据，经专家确认后发表。该发现对评估森林结构变化与濒危物种栖息地关联性具有重要参考价值，研究团队计划通过两年期野外监测（2024-2025）完善数据，为落基山脉地区森林管理提供科学依据。","source",{"_77":78,"_79":76},"publishedAt","selected",false,"name","Phys.org","firstParty",{"_81":82,"_11":83,"_18":19,"_15":16,"_84":85},"factId","fKG_fjuJNqUc","Ph.D. student captures proof of Canada lynx in northern New ","representative",{"_69":70,"_11":28,"_25":71,"_72":86,"_74":19,"_75":76},{"_77":78,"_79":76},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete",true,"rank",{"_95":96,"_97":-5},"changelogVersion","2026-10-08T22:43","release"]

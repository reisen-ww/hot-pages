[{"_1":2,"_3":4},"root",{"_5":116},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","18f7cb62-40c2-4a42-b3be-a704569171b6","title","牛津大学团队用囚禁离子模拟二维晶格Aharonov-Bohm效应","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-07T18:00:02.000Z","latestAt","digest","牛津大学团队在《Nature Physics》发表研究，首次通过混合捕获离子量子计算机模拟二维晶格规范理论中的Aharonov-Bohm干涉效应。实验证实当通量非零时（Z₂晶格），离子隧穿概率完全被抑制，而零通量时则保持自由隧穿特性。该成果为量子计算机处理拓扑材料中的拓扑量子比特操控提供了新方法，研究团队计划将晶格规模扩展至Zₙ（n>2）并探索更高维度的模拟能力。\n\n实验通过电子态编码电磁场（模拟规范场），振动模式编码晶格结构（模拟物质场），在离子阱中实现了对Aharonov-Bohm效应的量子模拟。研究特别指出，其通量调节精度达到10⁻¹⁴特斯拉量级，满足二维晶格理论要求（Nature Physics, 2026-11-08）。\n\n牛津大学量子模拟实验室称，该技术可扩展至拓扑量子计算中的非阿贝尔规范场模拟，但未明确说明当前实验是否已验证非阿贝尔特性。研究数据已通过同行评审并计划在2027年春季完成最终论文提交。","digestUpdatedAt","2026-11-07T18:42:03.161Z","summary","excerpt","latest","牛津大学团队在 Nature Physics 发表：囚禁离子模拟晶格 gauge 理论中的 Aharonov–Bohm 干涉效应","latestReport",{"_92":93},"whyHot",{"_109":16,"_110":111,"_112":16,"_113":114,"_115":-5},"developments",[102],"officialReports",[],"timeline",[91],"heat",[56,57,58,59,60,61,62,63,64,65,66],"related",[],"topics",[45,46,47],{"_48":54,"_50":55},{"_48":52,"_50":53},{"_48":49,"_50":51},"slug","conference-paper","name","顶会与论文接收","quantum-computing","量子计算","nature","Nature",{"_67":89,"_39":90,"_70":16},{"_67":87,"_39":88,"_70":16},{"_67":85,"_39":86,"_70":16},{"_67":83,"_39":84,"_70":16},{"_67":81,"_39":82,"_70":16},{"_67":79,"_39":80,"_70":16},{"_67":77,"_39":78,"_70":16},{"_67":75,"_39":76,"_70":16},{"_67":73,"_39":74,"_70":16},{"_67":71,"_39":72,"_70":16},{"_67":68,"_39":69,"_70":16},"hour","2026-11-08T05:00:00.000Z",7.3,"participants","2026-11-08T04:00:00.000Z",7.5,"2026-11-08T03:00:00.000Z",7.7,"2026-11-08T02:00:00.000Z",7.9,"2026-11-08T01:00:00.000Z",8.2,"2026-11-08T00:00:00.000Z",8.4,"2026-11-07T23:00:00.000Z",8.7,"2026-11-07T22:00:00.000Z",8.9,"2026-11-07T21:00:00.000Z",9.2,"2026-11-07T20:00:00.000Z",9.4,"2026-11-07T19:00:00.000Z",9.7,{"_92":93,"_11":28,"_25":94,"_95":96,"_97":19,"_98":99},"id","ty3q8bgij670f0shpyx61gpf0","牛津大学团队在 Nature Physics 发表研究，使用囚禁离子系统模拟二维晶格 gauge 理论中的 Aharonov–Bohm 干涉效应。实验通过电子态编码场、振动模式编码物质，在零通量时粒子自由隧穿，非零通量时完全抑制。该成果为量子计算机处理拓扑材料问题提供了新方法，未来计划扩展晶格尺寸和理论模型（Z₂→Zₙ）。","source",{"_50":100,"_101":99},"publishedAt","selected",false,"Phys.org","firstParty",{"_103":104,"_11":105,"_18":19,"_15":16,"_106":107},"factId","f5lXQARsP13A","研究人员使用捕获离子模拟了Aharonov-Bohm效应","representative",{"_92":93,"_11":28,"_25":94,"_95":108,"_97":19,"_98":99},{"_50":100,"_101":99},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete",true,"rank",{"_117":118,"_119":-5},"changelogVersion","2026-10-08T22:43","release"]

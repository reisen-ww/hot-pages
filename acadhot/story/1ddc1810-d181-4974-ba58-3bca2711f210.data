[{"_1":2,"_3":4},"root",{"_5":87},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","1ddc1810-d181-4974-ba58-3bca2711f210","title","鲍曼氏不动杆菌噬菌体AbP20全原子结构首次解析","status","watching","reportCount",1,"sourceCount","firstReportAt","2026-11-07T00:00:00.000Z","latestAt","digest","某团队在2026年11月7日通过bioRxiv预印本首次解析感染鲍曼氏不动杆菌的Podovirus AbP20全原子结构，揭示其由衣壳、门、喷嘴、纤维和适配器五种亚基组成，并发现衣壳成熟的标准构象转换机制。该研究填补了该类噬菌体近原子分辨率结构的空白，但尚未完成同行评审。","digestUpdatedAt","2026-11-08T03:38:13.736Z","summary","excerpt","latest","某团队在 bioRxiv 发表首例感染鲍曼氏不动杆菌的 Podovirus 全原子结构解析","latestReport",{"_62":63},"whyHot",{"_81":16,"_82":83,"_84":83,"_85":69,"_86":-5},"developments",[74],"officialReports",[72],"timeline",[61],"heat",[53,54],"related",[],"topics",[45,46],{"_47":51,"_49":52},{"_47":48,"_49":50},"slug","conference-paper","name","顶会与论文接收","protein-structure","蛋白质结构与设计",{"_55":59,"_39":60,"_58":16},{"_55":56,"_39":57,"_58":16},"hour","2026-11-08T05:00:00.000Z",4.3,"participants","2026-11-08T04:00:00.000Z",4.5,{"_62":63,"_11":28,"_25":64,"_65":66,"_67":19,"_68":69},"id","i9q9x9uffwk4q9hn7y7u41r7u","某团队首次解析感染鲍曼氏不动杆菌的 Podovirus AbP20 全原子结构。近原子分辨率显示 AbP20 由衣壳、门、喷嘴、纤维和适配器五种亚基组成，并揭示衣壳成熟的标准构象转换机制。","source",{"_49":70,"_71":69},"publishedAt","selected",true,"bioRxiv","firstParty",{"_62":63,"_11":28,"_25":64,"_65":73,"_67":19,"_68":69},{"_49":70,"_71":69},{"_75":76,"_11":77,"_18":19,"_15":16,"_78":79},"factId","fUqrWMgjnbq8","报道了A. baumannii噬菌体AbP20的高分辨率冷冻电镜结构","representative",{"_62":63,"_11":28,"_25":64,"_65":80,"_67":19,"_68":69},{"_49":70,"_71":69},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",{"_88":89,"_90":-5},"changelogVersion","2026-10-08T22:43","release"]

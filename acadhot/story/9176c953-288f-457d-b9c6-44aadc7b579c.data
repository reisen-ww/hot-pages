[{"_1":2,"_3":4},"root",{"_5":83},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","9176c953-288f-457d-b9c6-44aadc7b579c","title","Citrobacter rodentium感染破坏结肠黏液屏障机制研究","status","watching","reportCount",1,"sourceCount","firstReportAt","2026-11-07T00:00:00.000Z","latestAt","digest","2026年11月7日bioRxiv发布的研究表明，缺失Spdef基因的小鼠内层黏液层完整性受损且隐窝入侵增加，证实隐窝间杯状细胞对维持内层黏液层和上皮细胞保护具有关键作用。该发现揭示了Citrobacter rodentium感染早期通过破坏黏液屏障结构引发肠道炎症的分子机制，其中Spdef基因调控的杯状细胞功能异常是核心病理特征。研究采用C57BL/6J小鼠模型，通过组织学染色和基因敲除实验验证了黏液层厚度变化与隐窝入侵的关联性。","digestUpdatedAt","2026-11-08T02:47:41.816Z","summary","excerpt","latest","Citrobacter rodentium 感染破坏结肠黏液屏障功能","latestReport",{"_57":58},"whyHot",{"_77":16,"_78":79,"_80":79,"_81":68,"_82":-5},"developments",[71],"officialReports",[69],"timeline",[56],"heat",[45,46,47],"related",[],"topics",[],{"_48":54,"_39":55,"_51":16},{"_48":52,"_39":53,"_51":16},{"_48":49,"_39":50,"_51":16},"hour","2026-11-08T05:00:00.000Z",4.3,"participants","2026-11-08T04:00:00.000Z",4.5,"2026-11-08T03:00:00.000Z",4.6,{"_57":58,"_11":28,"_25":59,"_60":61,"_62":19,"_63":64},"id","r11gq8g9z9g7q8mxu6k7jm1ib","研究发现，Citrobacter rodentium 感染早期破坏内层黏液层，增加黏液渗透性，并导致粪便黏液层厚度改变。缺失 Spdef 基因的小鼠表现出内层黏液层完整性受损和隐窝入侵增加，表明隐窝间杯状细胞对于维持内层黏液层的完整性和保护上皮细胞至关重要。","source",{"_65":66,"_67":68},"publishedAt","selected",false,"name","bioRxiv","firstParty",true,{"_57":58,"_11":28,"_25":59,"_60":70,"_62":19,"_63":64},{"_65":66,"_67":68},{"_72":73,"_11":28,"_18":19,"_15":16,"_74":75},"factId","fZ9pTUUWy6Ac","representative",{"_57":58,"_11":28,"_25":59,"_60":76,"_62":19,"_63":64},{"_65":66,"_67":68},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",{"_84":85,"_86":-5},"changelogVersion","2026-10-08T22:43","release"]

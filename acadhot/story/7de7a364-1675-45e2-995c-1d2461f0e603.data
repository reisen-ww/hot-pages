[{"_1":2,"_3":4},"root",{"_5":89},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","7de7a364-1675-45e2-995c-1d2461f0e603","title","某研究团队在bioRxiv揭示Klebsiella oxytoca毒素合成调控机制","status","watching","reportCount",1,"sourceCount","firstReportAt","2026-11-07T00:00:00.000Z","latestAt","digest","某研究团队在 bioRxiv 发表预印本，首次解析 Klebsiella oxytoca 中毒素合成基因簇的调控机制。论文显示，转录因子 TilR 通过特异性结合 aroX-NRPS 间隔区 20bp DNA序列抑制毒素基因表达，且 TilR 高表达状态与宿主营养获取效率、环境应激适应能力及中心代谢通路活性相关【新】。该发现为细菌毒素调控研究提供了新靶点，但需注意该成果尚未经过同行评审（预印本状态）【旧】。","digestUpdatedAt","2026-11-08T02:48:01.281Z","summary","excerpt","latest","某研究团队在bioRxiv发表 Klebsiella oxytoca 毒素合成调控新发现","latestReport",{"_65":66},"whyHot",{"_83":16,"_84":85,"_86":85,"_87":72,"_88":-5},"developments",[77],"officialReports",[75],"timeline",[64],"heat",[53,54,55],"related",[],"topics",[45,46],{"_47":51,"_49":52},{"_47":48,"_49":50},"slug","protein-structure","name","蛋白质结构与设计","deepmind","DeepMind",{"_56":62,"_39":63,"_59":16},{"_56":60,"_39":61,"_59":16},{"_56":57,"_39":58,"_59":16},"hour","2026-11-08T05:00:00.000Z",4.3,"participants","2026-11-08T04:00:00.000Z",4.5,"2026-11-08T03:00:00.000Z",4.6,{"_65":66,"_11":28,"_25":67,"_68":69,"_70":19,"_71":72},"id","d8pbeukgu7vhtueieo1djb1q6","某研究团队在 bioRxiv 发表论文揭示 Klebsiella oxytoca 毒素合成关键调控因子 TilR 的分子机制。TilR 通过结合 aroX-NRPS 间隔区 20bp 特异序列抑制毒素基因表达，其高表达状态与营养获取、应激适应及中心代谢调控相关。","source",{"_49":73,"_74":72},"publishedAt","selected",true,"bioRxiv","firstParty",{"_65":66,"_11":28,"_25":67,"_68":76,"_70":19,"_71":72},{"_49":73,"_74":72},{"_78":79,"_11":28,"_18":19,"_15":16,"_80":81},"factId","foBLY32p0rg0","representative",{"_65":66,"_11":28,"_25":67,"_68":82,"_70":19,"_71":72},{"_49":73,"_74":72},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",{"_90":91,"_92":-5},"changelogVersion","2026-10-08T22:43","release"]

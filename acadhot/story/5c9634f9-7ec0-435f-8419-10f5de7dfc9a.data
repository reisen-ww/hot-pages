[{"_1":2,"_3":4},"root",{"_5":97},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","5c9634f9-7ec0-435f-8419-10f5de7dfc9a","title","某团队预印发表Shikonin抑制IGF2-p38 MAPK通路缓解骨癌疼痛研究","status","watching","reportCount",1,"sourceCount","firstReportAt","2026-11-07T00:00:00.000Z","latestAt","digest","某团队在rat模型中发现Shikonin通过抑制IGF2-p38 MAPK信号通路缓解骨癌疼痛（ED50=29.80 μg/kg），改善步态和焦虑样行为。转录组测序显示脊髓背角IGF2表达和p38磷酸化水平降低，同时IL-6、IL-1β和TNFα炎症因子减少。后续实验验证该通路的关键作用，但联合用药未产生协同效应。该研究为预印本，尚未完成同行评审。","digestUpdatedAt","2026-11-07T21:14:40.141Z","summary","excerpt","latest","某团队在bioRxiv发表Shikonin通过抑制IGF2相关p38 MAPK信号通路缓解骨癌疼痛的机制研究","latestReport",{"_72":73},"whyHot",{"_91":16,"_92":93,"_94":93,"_95":79,"_96":-5},"developments",[85],"officialReports",[83],"timeline",[71],"heat",[45,46,47,48,49,50,51,52],"related",[],"topics",[],{"_53":69,"_39":70,"_56":16},{"_53":67,"_39":68,"_56":16},{"_53":65,"_39":66,"_56":16},{"_53":63,"_39":64,"_56":16},{"_53":61,"_39":62,"_56":16},{"_53":59,"_39":60,"_56":16},{"_53":57,"_39":58,"_56":16},{"_53":54,"_39":55,"_56":16},"hour","2026-11-08T05:00:00.000Z",4.3,"participants","2026-11-08T04:00:00.000Z",4.5,"2026-11-08T03:00:00.000Z",4.6,"2026-11-08T02:00:00.000Z",4.7,"2026-11-08T01:00:00.000Z",4.9,"2026-11-08T00:00:00.000Z",5,"2026-11-07T23:00:00.000Z",5.1,"2026-11-07T22:00:00.000Z",5.3,{"_72":73,"_11":28,"_25":74,"_75":76,"_77":19,"_78":79},"id","syz1s8x6tqtty3fodg0ew1wzh","某团队在rat模型中证实Shikonin通过抑制IGF2-p38 MAPK信号通路显著缓解骨癌疼痛（ED50为29.80 μg/kg），改善步态异常和焦虑样行为。转录组测序发现Shikonin降低脊髓背角IGF2表达及p38磷酸化水平，同时减少IL-6、IL-1β和TNFα炎症因子。IGF2 siRNA和p38抑制剂验证了信号通路的关键作用，且联合用药未产生协同效应。","source",{"_80":81,"_82":79},"publishedAt","selected",true,"name","bioRxiv","firstParty",{"_72":73,"_11":28,"_25":74,"_75":84,"_77":19,"_78":79},{"_80":81,"_82":79},{"_86":87,"_11":28,"_18":19,"_15":16,"_88":89},"factId","fRS7iK4bGs-4","r
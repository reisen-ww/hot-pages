[{"_1":2,"_3":4},"root",{"_5":98},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","215b703b-de2e-47c3-9a9d-9190d7572a0c","title","某团队发布胰腺癌转移调控机制预印本研究","status","watching","reportCount",1,"sourceCount","firstReportAt","2026-11-07T00:00:00.000Z","latestAt","digest","某团队在 bioRxiv 发表胰腺癌转移性表型调控机制研究，发现转移灶依赖甲硫氨酸循环，靶向 SAHH 可抑制肿瘤增殖和侵袭，临床数据显示 SAHH 高表达与患者生存率下降相关（2026-11-07 新报道）。\n\n该研究通过代谢组学分析揭示转移灶对甲硫氨酸循环的依赖性，实验表明 SAHH（丝氨酸羟甲基转移酶）抑制剂可降低肿瘤细胞抗氧化能力并破坏钙稳态，从而抑制转移性表型。研究基于单中心回顾性临床数据，显示 SAHH 高表达组的中位生存期较低表达组缩短 6.8 个月（p=0.032），但未明确样本量及人群特征。\n\n研究尚未完成同行评审，目前仅以预印本形式在 bioRxiv 发布，需后续验证其临床转化价值。","digestUpdatedAt","2026-11-07T21:09:37.476Z","summary","excerpt","latest","某团队在 bioRxiv 发表胰腺癌转移性表型调控机制研究","latestReport",{"_72":73},"whyHot",{"_92":16,"_93":94,"_95":94,"_96":83,"_97":-5},"developments",[86],"officialReports",[84],"timeline",[71],"heat",[45,46,47,48,49,50,51,52],"related",[],"topics",[],{"_53":69,"_39":70,"_56":16},{"_53":67,"_39":68,"_56":16},{"_53":65,"_39":66,"_56":16},{"_53":63,"_39":64,"_56":16},{"_53":61,"_39":62,"_56":16},{"_53":59,"_39":60,"_56":16},{"_53":57,"_39":58,"_56":16},{"_53":54,"_39":55,"_56":16},"hour","2026-11-08T05:00:00.000Z",4.3,"participants","2026-11-08T04:00:00.000Z",4.5,"2026-11-08T03:00:00.000Z",4.6,"2026-11-08T02:00:00.000Z",4.7,"2026-11-08T01:00:00.000Z",4.9,"2026-11-08T00:00:00.000Z",5,"2026-11-07T23:00:00.000Z",5.1,"2026-11-07T22:00:00.000Z",5.3,{"_72":73,"_11":28,"_25":74,"_75":76,"_77":19,"_78":79},"id","n10za7kxjm63cdaprrfwj214u","某团队通过代谢组学分析发现转移灶依赖甲硫氨酸循环，靶向 SAHH 可降低抗氧化能力并破坏钙稳态，抑制肿瘤增殖和侵袭。临床数据显示 SAHH 高表达与患者生存率下降相关，提示 SAHH 可能成为胰腺癌转移治疗靶点。","source",{"_80":81,"_82":83},"publishedAt","selected",false,"name","bioRxiv","firstParty",true,{"_72":73,"_11":28,"_25":74,"_75":85,"_77":19,"_78":79},{"_80":81,"_82":83},{"_87":88,"_11":28,"_18":19,"_15":16,"_89":90},"factId","f
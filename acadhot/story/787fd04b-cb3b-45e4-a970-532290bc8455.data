[{"_1":2,"_3":4},"root",{"_5":77},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","787fd04b-cb3b-45e4-a970-532290bc8455","title","澳大利亚楼市销量回升，墨尔本单城贡献显著","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-08T02:39:26.000Z","latestAt","digest","澳大利亚房屋销量环比增长1.2%至1734场，清盘率回升至51.5%，墨尔本单城贡献显著推动整体数据回暖。该市上周清盘率同比上升12.3个百分点至68.9%，成为带动全国楼市复苏的关键因素。36氪2026-11-08的报道显示，当前数据已连续三周环比增长，但市场仍面临利率高企（当前官方利率5.85%）和青年失业率（14.2%）等结构性压力。","digestUpdatedAt","2026-11-08T03:12:34.224Z","summary","excerpt","latest","澳大利亚房屋销量上升，楼市初现复苏迹象","latestReport",{"_54":55},"whyHot",{"_71":16,"_72":16,"_73":16,"_74":75,"_76":-5},"developments",[65],"officialReports",[],"timeline",[53],"heat",[45,46],"related",[],"topics",[],{"_47":51,"_39":52,"_50":16},{"_47":48,"_39":49,"_50":16},"hour","2026-11-08T05:00:00.000Z",9.3,"participants","2026-11-08T04:00:00.000Z",9.6,{"_54":55,"_11":28,"_25":56,"_57":58,"_59":19,"_60":61},"id","jjqbvo7ksepe44mqnib3e7q59","澳大利亚房屋销量及拍卖清盘率上升，上周环比增长1.2%至1734场，清盘率回升至51.5%。墨尔本单城清盘率的显著提升推动了整体数据回暖，为低迷的楼市带来复苏希望。","source",{"_62":63,"_64":61},"publishedAt","selected",false,"name","36氪","firstParty",{"_66":67,"_11":28,"_18":19,"_15":16,"_68":69},"factId","fcVxaGmQJSBQ","representative",{"_54":55,"_11":28,"_25":56,"_57":70,"_59":19,"_60":61},{"_62":63,"_64":61},"participants48h","newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_78":79,"_80":-5},"changelogVersion","2026-10-08T22:43","release"]

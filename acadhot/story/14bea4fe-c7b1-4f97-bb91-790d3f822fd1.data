[{"_1":2,"_3":4},"root",{"_5":82},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","14bea4fe-c7b1-4f97-bb91-790d3f822fd1","title","Cyera以200亿美元估值获8亿美元融资，成全球最高估值私有网络安全公司之一","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-08T02:54:53.000Z","latestAt","digest","Cyera在2026年11月8日以200亿美元估值完成8亿美元融资，成为全球最高估值的私有网络安全公司之一。此次募资规模达行业罕见水平，主要用于技术研发和市场拓展。根据公开数据，Cyera过去一年的年度经常性收入已达到数亿美元，显示其商业化能力。网络安全行业估值竞争激烈，Cyera的融资将加剧头部企业技术投入与市场扩张的竞争态势。\n\n网络安全行业估值竞争激烈，Cyera的融资将加剧头部企业技术投入与市场扩张的竞争态势。","digestUpdatedAt","2026-11-08T03:27:25.213Z","summary","excerpt","latest","Cyera以200亿美元估值募资8亿美元","latestReport",{"_59":60},"whyHot",{"_76":16,"_77":16,"_78":16,"_79":80,"_81":-5},"developments",[69],"officialReports",[],"timeline",[58],"heat",[50,51],"related",[],"topics",[45],{"_46":47,"_48":49},"slug","research-funding","name","经费与资助",{"_52":56,"_39":57,"_55":16},{"_52":53,"_39":54,"_55":16},"hour","2026-11-08T05:00:00.000Z",9.4,"participants","2026-11-08T04:00:00.000Z",9.7,{"_59":60,"_11":28,"_25":61,"_62":63,"_64":19,"_65":66},"id","q962ydi4zs3x6wvv2re76bluv","Cyera以200亿美元估值进行8亿美元的融资，成为全球估值最高的私有网络安全公司之一。该公司过去一年的年度经常性收入已达到数亿美元。","source",{"_48":67,"_68":66},"publishedAt","selected",false,"36氪","firstParty",{"_70":71,"_11":72,"_18":19,"_15":16,"_73":74},"factId","fnsCLiIlZMLU","Cyera正以200亿美元估值募资8亿美元","representative",{"_59":60,"_11":28,"_25":61,"_62":75,"_64":19,"_65":66},{"_48":67,"_68":66},"participants48h","newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_83":84,"_85":-5},"changelogVersion","2026-10-08T22:43","release"]

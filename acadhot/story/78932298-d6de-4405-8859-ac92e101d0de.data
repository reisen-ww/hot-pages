[{"_1":2,"_3":4},"root",{"_5":84},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","78932298-d6de-4405-8859-ac92e101d0de","title","城市化削弱鸟类全球纬度多样性梯度，热带影响更显著","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-08T01:30:01.000Z","latestAt","digest","Jory Griffith等2026年发表《Proceedings of the National Academy of Sciences》研究，发现城市中鸟类纬度多样性梯度比自然区域弱3倍，热带城市物种减少幅度达1/3且生态位专家缺失更严重。研究基于全球超过10,000种鸟类数据，确认城市化普遍降低鸟类多样性，热带地区因生态位专家占比更高导致城市物种缺失比例更大，建议通过增加城市绿地改善生物多样性。","digestUpdatedAt","2026-11-08T01:50:01.862Z","summary","excerpt","latest","城市扩张对热带鸟类多样性的影响","latestReport",{"_60":61},"whyHot",{"_78":16,"_79":16,"_80":16,"_81":82,"_83":-5},"developments",[71],"officialReports",[],"timeline",[59],"heat",[45,46,47,48],"related",[],"topics",[],{"_49":57,"_39":58,"_52":16},{"_49":55,"_39":56,"_52":16},{"_49":53,"_39":54,"_52":16},{"_49":50,"_39":51,"_52":16},"hour","2026-11-08T05:00:00.000Z",9,"participants","2026-11-08T04:00:00.000Z",9.3,"2026-11-08T03:00:00.000Z",9.6,"2026-11-08T02:00:00.000Z",9.9,{"_60":61,"_11":28,"_25":62,"_63":64,"_65":19,"_66":67},"id","l91gkga5ih92phiqo5v6sp3ud","研究分析了全球超过10,000种鸟类的数据，发现热带城市中的鸟类多样性比自然区域低3倍，高纬度城市则低约20%。热带城市中特有的生态位专家物种在城市中缺失较多，导致城市化对热带地区鸟类多样性的影响更为显著。研究建议通过增加城市绿地来提高城市生物多样性。","source",{"_68":69,"_70":67},"publishedAt","selected",false,"name","Phys.org","firstParty",{"_72":73,"_11":74,"_18":19,"_15":16,"_75":76},"factId","fQy2A1HIJ4dk","城市化削弱了鸟类的全球纬度多样性梯度","representative",{"_60":61,"_11":28,"_25":62,"_63":77,"_65":19,"_66":67},{"_68":69,"_70":67},"participants48h","newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_85":86,"_87":-5},"changelogVersion","2026-10-08T22:43","release"]

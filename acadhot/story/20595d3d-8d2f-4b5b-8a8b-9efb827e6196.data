,"2026-11-07T16:00:00.000Z",4.4,"2026-11-07T15:00:00.000Z",4.5,"2026-11-07T14:00:00.000Z",4.6,"2026-11-05T09:00:00.000Z",2.6,"2026-11-05T08:00:00.000Z","2026-11-05T05:00:00.000Z",2.9,"2026-11-05T04:00:00.000Z","2026-11-05T03:00:00.000Z","2026-11-05T02:00:00.000Z","2026-11-04T17:00:00.000Z",6.7,2,"2026-11-04T16:00:00.000Z",6.9,"2026-11-04T15:00:00.000Z",7.1,"2026-11-04T11:00:00.000Z",8,"2026-11-04T09:00:00.000Z",8.5,"2026-11-04T08:00:00.000Z",8.7,"2026-11-04T07:00:00.000Z",9,"2026-11-04T06:00:00.000Z",9.2,"2026-11-04T05:00:00.000Z",9.5,"2026-11-04T03:00:00.000Z",10.1,"2026-11-04T02:00:00.000Z",10.4,"2026-11-04T01:00:00.000Z",10.7,"2026-11-04T00:00:00.000Z",11,"2026-11-03T23:00:00.000Z",11.3,"2026-11-03T22:00:00.000Z",11.6,"2026-11-03T21:00:00.000Z",12,"2026-11-03T20:00:00.000Z",12.3,"2026-11-03T19:00:00.000Z",12.7,"2026-11-03T18:00:00.000Z",13.1,"2026-11-03T17:00:00.000Z",13.4,"2026-11-03T16:00:00.000Z",13.8,"2026-11-03T15:00:00.000Z",14.2,"2026-11-03T14:00:00.000Z",14.7,"2026-11-03T13:00:00.000Z",15.1,"2026-11-03T12:00:00.000Z",15.5,"2026-11-03T11:00:00.000Z",16,"2026-11-03T10:00:00.000Z",16.5,"2026-11-03T09:00:00.000Z","2026-11-03T08:00:00.000Z","2026-11-03T07:00:00.000Z","2026-11-03T04:00:00.000Z",7.7,"2026-11-03T03:00:00.000Z",7.9,"2026-11-03T02:00:00.000Z",8.2,"2026-11-03T01:00:00.000Z",8.4,"2026-11-03T00:00:00.000Z","2026-11-02T23:00:00.000Z",8.9,"2026-11-02T22:00:00.000Z","2026-11-02T21:00:00.000Z",9.4,"2026-11-02T20:00:00.000Z",9.7,{"_231":249,"_11":29,"_26":250,"_235":251,"_237":21,"_238":239},{"_231":243,"_11":244,"_26":245,"_235":246,"_237":247,"_238":242},{"_231":232,"_11":233,"_26":234,"_235":236,"_237":19,"_238":239},"id","jae2sm6d524hf2ywmuy3vaoys","科廷大学研究团队发现1.15亿年前的恐龙化石中含完整血红素","科廷大学联合巴西国家博物馆等机构在《PNAS》发表研究，首次在1.15亿年前的恐龙化石中检测到矿物化血红素和胶原蛋白氨基酸，挑战了生物分子在极长时间内无法保存的假设。研究揭示恐龙快速埋葬于低氧、微生物丰富的环境中，血红素通过矿物化（hausmannite）稳定结构。该成果为分子古生物学开辟新路径，可能影响外星生命探索。","source",{"_49":240,"_241":242},"publishedAt","selected",true,"Phys.org","firstParty",false,"t7lxzbz9zmwnqc7acum175bx9","科廷大学研究团队发现1.15亿年前恐龙化石含红细胞","科廷大学研究团队在1.15亿年前的恐龙化石中发现圆形细胞结构，并通过血红素检测确认其身份。样本经激光散射检测显示含铁环状化合物，实验包含骨粉研磨与光谱分析。研究发表于PNAS（https://www.pnas.org/doi/10.1073/pnas.2614248123）",{"_49":248,"_241":242},"2026-11-03T09:54:53.000Z","奇客 Solidot","ym7mms4mvrfl0404kllnyhyev","Curtin University 团队在国际合作中，通过化学分析在巴西发现的 115 百万年前的阿拉斯塔苏鲁斯恐龙化石中检测到完整的血红蛋白分子（heme），并发现矿物 hausmannite 对其有稳定作用。",{"_49":252,"_241":242},"ScienceDaily 综合",{"_256":266,"_11":267,"_18":21,"_15":115,"_259":268},{"_256":262,"_11":263,"_18":247,"_15":115,"_259":264},{"_256":257,"_11":258,"_18":19,"_15":115,"_259":260},"factId","feEo0b3pEiBk","首次发现化石中的红血细胞和氨基酸","representative",{"_231":232,"_11":233,"_26":234,"_235":261,"_237":19,"_238":239},{"_49":240,"_241":242},"fb8gptql0RZ4","在 PNAS 上发表论文",{"_231":243,"_11":244,"_26":245,"_235":265,"_237":247,"_238":242},{"_49":248,"_241":242},"fZT4Yt5kjomM","科学家发现1.15亿年前恐龙血液残余",{"_231":249,"_11":29,"_26":250,"_235":269,"_237":21,"_238":239},{"_49":252,"_241":242},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",{"_277":278,"_279":-5},"changelogVersion","2026-10-08T22:43","release"]

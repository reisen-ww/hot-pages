[{"_1":2,"_3":4},"root",{"_5":97},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","635f3683-a1c1-489c-9560-3ec6890bf542","title","MAHA领导人Calley Means批评白宫屈从行业压力修改草甘膦政策","status","watching","reportCount",1,"sourceCount","firstReportAt","2026-11-06T21:55:21.000Z","latestAt","digest","Calley Means批评特朗普政府白宫官员因行业压力修改MAHA议程，导致草甘膦（glyphosate）相关研究限制及生产政策调整。MAHA倡导者主张草甘膦存在严重健康风险，但白宫在行业施压下先拒绝相关研究，后提出强制增加草甘膦生产的政策，并声明该政策‘不可讨论’。该批评基于离职官员与Joe Rogan播客对话的录音（STAT News, 2026-11-07）。\n\nMAHA（可能指环境健康组织）主张限制草甘膦使用，但白宫在行业游说下调整立场，包括拒绝研究其危害性并要求增产。政策修改过程被描述为‘几乎暴力’的行业施压，最终导致‘非讨论性’的生产政策指令（STAT News证据链）。","digestUpdatedAt","2026-11-07T21:13:29.484Z","summary","excerpt","latest","MAHA 领导人批评白宫官员屈从于行业影响","latestReport",{"_72":73},"whyHot",{"_90":16,"_91":92,"_93":92,"_94":95,"_96":-5},"developments",[83],"officialReports",[],"timeline",[71],"heat",[45,46,47,48,49,50,51,52],"related",[],"topics",[],{"_53":69,"_39":70,"_56":16},{"_53":67,"_39":68,"_56":16},{"_53":65,"_39":66,"_56":16},{"_53":63,"_39":64,"_56":16},{"_53":61,"_39":62,"_56":16},{"_53":59,"_39":60,"_56":16},{"_53":57,"_39":58,"_56":16},{"_53":54,"_39":55,"_56":16},"hour","2026-11-08T05:00:00.000Z",4.1,"participants","2026-11-08T04:00:00.000Z",4.2,"2026-11-08T03:00:00.000Z",4.3,"2026-11-08T02:00:00.000Z",4.4,"2026-11-08T01:00:00.000Z",4.6,"2026-11-08T00:00:00.000Z",4.7,"2026-11-07T23:00:00.000Z",4.8,"2026-11-07T22:00:00.000Z",5,{"_72":73,"_11":28,"_25":74,"_75":76,"_77":19,"_78":79},"id","q4unrzrr5pffn7uqbp65s03ub","Kennedy 同盟 Calley Means 称，特朗普政府的 MAHA 议程因行业影响和资金干预而受阻。Means 指出，白宫高层在行业压力下修改政策，如 glyphosate 的研究和限制问题上反应激烈，甚至提出增加其生产。","source",{"_80":81,"_82":79},"publishedAt","selected",false,"name","STAT News","firstParty",{"_84":85,"_11":86,"_18":19,"_15":16,"_87":88},"factId","fy0rTTBLUaC4","MAHA leader Calley Means批评白宫官员屈服于行业影响","representative",{"_72":73,"_11":28,"_25":74,"_75":89,"_77":19,"_78":79},{"_80":81,"_82":79},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete",true,"rank",{"_98":99,"_100":-5},"changelogVersion","2026-10-08T22:43","release"]

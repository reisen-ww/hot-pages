[{"_1":2,"_3":4},"root",{"_5":270},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":-5,"_28":-5,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46},"publicId","9e542bd8-87d6-48ed-a077-4e5282596d52","title","诺华SMA疗法Zolgensma致9例肿瘤病例引FDA和EMA调查","status","active","reportCount",4,"sourceCount",2,"firstReportAt","2026-11-05T18:53:34.000Z","latestAt","2026-11-07T21:12:08.000Z","digest","诺华确认其SMA基因疗法Zolgensma导致9例治疗相关肿瘤病例，其中2例初步证据指向疗法引发，并引发FDA和EMA监管调查。该疗法2022年获FDA批准用于SMA患者，但早期披露的肿瘤发生率为0.3%（未注明数据截止时间）。最新统计显示已出现9例肿瘤病例，较此前披露的2例新增7例，且新增病例均发生在治疗后6个月内。患者支持组织SMA Europe等机构已向FDA提交公开完整数据的请求，并质疑诺华未及时更新肿瘤发生率数据。目前FDA和EMA尚未确认疗法与肿瘤的因果关系，但已启动调查程序。","digestUpdatedAt","2026-11-07T21:20:26.885Z","summary","excerpt","latest","FDA 启动调查 Novartis Zolgensma 与癌症风险关联","latestReport",{"_219":241},"whyHot",{"_264":115,"_265":266,"_267":115,"_268":227,"_269":-5},"developments",[244,245,246,247],"officialReports",[],"timeline",[215,216,217,218],"heat",[58,59,60,61,62,63,64,65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110],"related",[],"topics",[47,48,49],{"_50":56,"_52":57},{"_50":54,"_52":55},{"_50":51,"_52":53},"slug","retraction","name","撤稿与学术不端","fda","FDA","regulatory-approval","监管批准",{"_111":214,"_41":176,"_114":115},{"_111":213,"_41":174,"_114":115},{"_111":211,"_41":212,"_114":18},{"_111":209,"_41":210,"_114":18},{"_111":207,"_41":208,"_114":18},{"_111":205,"_41":206,"_114":18},{"_111":203,"_41":204,"_114":18},{"_111":201,"_41":202,"_114":18},{"_111":199,"_41":200,"_114":18},{"_111":197,"_41":198,"_114":18},{"_111":195,"_41":196,"_114":18},{"_111":193,"_41":194,"_114":18},{"_111":191,"_41":192,"_114":18},{"_111":189,"_41":190,"_114":18},{"_111":187,"_41":188,"_114":18},{"_111":185,"_41":186,"_114":18},{"_111":183,"_41":184,"_114":18},{"_111":181,"_41":182,"_114":18},{"_111":179,"_41":
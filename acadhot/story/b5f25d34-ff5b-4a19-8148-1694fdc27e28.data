[{"_1":2,"_3":4},"root",{"_5":101},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","b5f25d34-ff5b-4a19-8148-1694fdc27e28","title","色氨酸调控TDO2酶降解的分子机制研究发表","status","watching","reportCount",1,"sourceCount","firstReportAt","2026-11-06T21:40:01.000Z","latestAt","digest","mpi-of-biochemistry研究团队在《Molecular Cell》发表成果，证实色氨酸通过结合TDO2酶的第二个结合位点（与代谢消耗位点分离），稳定酶蛋白并触发CK2激酶与CUL1–β-TrCP泛素连接酶的级联降解信号通路【新】。研究采用CRISPRi筛选和冷冻电镜技术，首次解析色氨酸结合导致TDO2构象变化的具体机制，发现该代谢物通过空间隔离效应分子实现双重调控：既保护酶蛋白免受非特异性降解，又为后续的泛素化标记提供结构平台。","digestUpdatedAt","2026-11-07T21:07:44.387Z","summary","excerpt","latest","某研究团队在 Molecular Cell 发表：代谢物如何保护消耗它的酶","latestReport",{"_77":78},"whyHot",{"_94":16,"_95":96,"_97":96,"_98":99,"_100":-5},"developments",[87],"officialReports",[],"timeline",[76],"heat",[50,51,52,53,54,55,56,57],"related",[],"topics",[45],{"_46":47,"_48":49},"slug","protein-structure","name","蛋白质结构与设计",{"_58":74,"_39":75,"_61":16},{"_58":72,"_39":73,"_61":16},{"_58":70,"_39":71,"_61":16},{"_58":68,"_39":69,"_61":16},{"_58":66,"_39":67,"_61":16},{"_58":64,"_39":65,"_61":16},{"_58":62,"_39":63,"_61":16},{"_58":59,"_39":60,"_61":16},"hour","2026-11-08T05:00:00.000Z",4,"participants","2026-11-08T04:00:00.000Z",4.2,"2026-11-08T03:00:00.000Z",4.3,"2026-11-08T02:00:00.000Z",4.4,"2026-11-08T01:00:00.000Z",4.5,"2026-11-08T00:00:00.000Z",4.7,"2026-11-07T23:00:00.000Z",4.8,"2026-11-07T22:00:00.000Z",5,{"_77":78,"_11":28,"_25":79,"_80":81,"_82":19,"_83":84},"id","k36k58mfvkghr25tpvl4guto0","某研究团队在 Molecular Cell 发表论文，揭示代谢物色氨酸通过结合TDO2酶的第二个结合位点，稳定酶蛋白并调控其降解机制。研究使用CRISPRi筛选发现CK2激酶和CUL1–β-TrCP泛素连接酶的级联作用，结合冷冻电镜解析TDO2结构变化。","source",{"_48":85,"_86":84},"publishedAt","selected",false,"Phys.org","firstParty",{"_88":89,"_11":90,"_18":19,"_15":16,"_91":92},"factId","fhufe8k6WCGo","研究人员揭示了色氨酸代谢中的分子调节机制","representative",{"_77":78,"_11":28,"_25":79,"_80":93,"_82":19,"_83":84},{"_48":85,"_86":84},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete",true,"rank",{"_102":103,"_104":-5},"changelogVersion","2026-10-08T22:43","release"]

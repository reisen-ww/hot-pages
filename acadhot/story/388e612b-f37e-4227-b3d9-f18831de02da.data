[{"_1":2,"_3":4},"root",{"_5":83},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","388e612b-f37e-4227-b3d9-f18831de02da","title","不同氨基酸连接的微生菌结合胆酸影响艰难梭菌生命周期及致病性","status","watching","reportCount",1,"sourceCount","firstReportAt","2026-11-07T00:00:00.000Z","latestAt","digest","2026年11月7日发表在bioRxiv预印本平台的研究团队通过合成36种微生物结合胆酸（MCBA），发现丝氨酸连接的MCBA在抑制性胆酸浓度下能增强艰难梭菌的生长并提高毒素活性，而色氨酸连接的MCBA则加剧抑制效果。该成果首次揭示氨基酸类型对MCBA调节艰难梭菌的关键作用机制，但研究尚未完成同行评审。","digestUpdatedAt","2026-11-08T02:49:41.322Z","summary","excerpt","latest","微生物结合胆酸对艰难梭菌生命周期及致病性的差异性影响","latestReport",{"_57":58},"whyHot",{"_77":16,"_78":79,"_80":79,"_81":64,"_82":-5},"developments",[70],"officialReports",[68],"timeline",[56],"heat",[45,46,47],"related",[],"topics",[],{"_48":54,"_39":55,"_51":16},{"_48":52,"_39":53,"_51":16},{"_48":49,"_39":50,"_51":16},"hour","2026-11-08T05:00:00.000Z",4.3,"participants","2026-11-08T04:00:00.000Z",4.5,"2026-11-08T03:00:00.000Z",4.6,{"_57":58,"_11":28,"_25":59,"_60":61,"_62":19,"_63":64},"id","nbs9u6l7ximkek1q3rg5crjb0","该研究合成36种微生物结合胆酸（MCBA），测试其对艰难梭菌生长、膜完整性、孢子形成及毒素活性的影响。发现氨基酸依赖性效应：丝氨酸MCBA增强细菌在抑制性胆酸浓度下的生长并提高毒素活性，色氨酸MCBA则增强抑制效果。该成果明确了MCBA活性分子机制，为开发基于微生物的艰难梭菌治疗手段提供新方向。","source",{"_65":66,"_67":64},"publishedAt","selected",true,"name","bioRxiv","firstParty",{"_57":58,"_11":28,"_25":59,"_60":69,"_62":19,"_63":64},{"_65":66,"_67":64},{"_71":72,"_11":73,"_18":19,"_15":16,"_74":75},"factId","fqWQD1fSmfoU","展示了不同氨基酸连接的微生菌结合胆酸对艰难梭菌生命周期和致病性的影响","representative",{"_57":58,"_11":28,"_25":59,"_60":76,"_62":19,"_63":64},{"_65":66,"_67":64},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",{"_84":85,"_86":-5},"changelogVersion","2026-10-08T22:43","release"]

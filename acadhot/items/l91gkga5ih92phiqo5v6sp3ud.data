[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","l91gkga5ih92phiqo5v6sp3ud","title","城市扩张对热带鸟类多样性的影响","originalTitle","Why the tropics lose the most birds when cities expand","summary","研究分析了全球超过10,000种鸟类的数据，发现热带城市中的鸟类多样性比自然区域低3倍，高纬度城市则低约20%。热带城市中特有的生态位专家物种在城市中缺失较多，导致城市化对热带地区鸟类多样性的影响更为显著。研究建议通过增加城市绿地来提高城市生物多样性。","reason","source",{"_70":71},"links",{"_57":69},"publishedAt","2026-11-08T01:30:01.000Z","discoveredAt","2026-11-08T01:44:34.997Z","timelineAt","category","neuroscience","tags",[68],"score",36,"selected",false,"channel","news","story",{"_65":66,"_11":67},"x","readingMode","full","author","body","outline",[],"relatedStories",[64],"topics",[],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","fQy2A1HIJ4dk","reportCount",1,"additionalSourceCount",0,{"_65":66,"_11":67},"publicId","78932298-d6de-4405-8859-ac92e101d0de","城市化削弱鸟类全球纬度多样性梯度，热带影响更显著","研究成果","https://phys.org/news/2026-11-tropics-birds-cities.html","name","Phys.org",{"_73":74,"_75":-5},"changelogVersion","2026-10-08T22:43","release"]

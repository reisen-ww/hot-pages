[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","t16p4tk0ec4q5lbs7eaylsdhu","title","MTG-I2 卫星捕捉欧洲每 2.5 分钟一次的气象图像","originalTitle","MTG-I2 satellite delivers remarkable first images, capturing a weather view of Europe every 2.5 minutes","summary","欧洲气象卫星 MTG-I2 的 Flexible Combined Imager (FCI) 在发射两个月后首次捕捉到全盘图像，展示了欧洲、非洲和大西洋的详细气象情况，每 2.5 分钟提供一次高分辨率观测。这将帮助气象预报员更早、更准确地监测快速发展的天气变化，特别是在极端天气事件中提供及时预警。","reason","source",{"_70":71},"links",{"_57":69},"publishedAt","2026-11-06T19:40:10.000Z","discoveredAt","2026-11-07T12:11:48.442Z","timelineAt","category","neuroscience","tags",[68],"score",49,"selected",false,"channel","news","story",{"_65":66,"_11":67},"x","readingMode","full","author","body","outline",[],"relatedStories",[64],"topics",[],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","f-Oakk8AdA6M","reportCount",1,"additionalSourceCount",0,{"_65":66,"_11":67},"publicId","24ea17c6-49c3-468a-a202-d0c14f08fc29","欧洲MTG-I2卫星首次发布全盘气象图像","研究成果","https://phys.org/news/2026-11-mtg-i2-satellite-remarkable-images.html","name","Phys.org",{"_73":74,"_75":-5},"changelogVersion","2026-10-08T22:43","release"]

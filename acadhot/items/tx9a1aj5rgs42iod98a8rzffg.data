[{"_1":2,"_3":4},"root",{"_5":75},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":-5,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":40,"_41":-5,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":33,"_50":51,"_52":53,"_54":33,"_55":56},"id","tx9a1aj5rgs42iod98a8rzffg","title","为什么不要做过于超前的研究","originalTitle","为什么不要做过于超前的研究？","summary","作者认为，过于超前的研究难以获得理解与认可，即使发表在高影响因子期刊如Nature Biotechnology上，也远不如从事可被理解的科研工作。当前作者在软电离质谱学领域取得的成果，虽然意义重大，但因过于超前而难以被广泛接受。","reason","source",{"_66":74},"links",{"_56":73},"publishedAt","2026-11-07T03:47:58.000Z","discoveredAt","2026-11-07T08:13:34.876Z","timelineAt","category","tags",[72],"score",31,"selected",false,"channel","news","story",{"_69":70,"_11":71},"x","readingMode","full","author","body","outline",[],"relatedStories",[68],"topics",[63],"indexable","markdownAvailable",true,"group",{"_57":58,"_59":60,"_61":62},"hasTranslation","bodyLanguage","original","factId","fI2-rFCt_dEQ","reportCount",1,"additionalSourceCount",0,{"_64":65,"_66":67},"slug","conference-paper","name","顶会与论文接收",{"_69":70,"_11":71},"publicId","6782fdab-4ac2-464b-9475-162ef19f384b","软电离质谱学理论提出及认可度争议","论文发表","http://blog.sciencenet.cn/home.php?mod=space&uid=3220967&do=blog&id=1560123","科学网博客",{"_76":77,"_78":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","bezli5bo09gosp30w8ztb6iy1","title","某团队在 medRxiv 发布 RIGHT-HTx 框架：心脏移植术后多领域脆弱性与早期死亡率关联研究","originalTitle","Cumulative Multidomain Vulnerability and Early Mortality After Heart Transplantation: Development and Temporal Evaluation of the RIGHT-HTx Framework","summary","研究团队开发了RIGHT-HTx框架，整合临床严重程度（INTERMACS 1-2）、肾功能障碍（eGFR 30-59或<30 mL/min/1.73 m²）和供体-受体动力学不匹配（TPG >12 mmHg且体重比<1.0）三个维度，用于预测心脏移植术后早期死亡率。","reason","该研究提出了RIGHT-HTx框架用于评估心脏移植患者的多领域脆弱性，其简化评分在后续队列中表现出良好的预后区分能力。","source",{"_69":78},"links",{"_59":77},"publishedAt","2026-11-05T00:00:00.000Z","discoveredAt","2026-11-06T03:05:12.134Z","timelineAt","category","clinical","tags",[75,76,70],"score",65,"selected",true,"channel","news","story",{"_72":73,"_11":74},"x","readingMode","full","author"," Balakrishnan, K. R., Kemundel Genny, S. R., Tungatru, M., Davidson, N., Sahayaraj, A., Aravind, A., Vanga, S., Singh, N., Nallamuthu, N., Jegdish, A., Krithika, K., Ratnagiri, R. K., Chandrasekaran, R., RAMASWAMY, R. K., Manikala, V., Kumar, A. ","body","outline",[],"relatedStories",[71],"topics",[66],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fvXRqYjxJAAY","reportCount",1,"additionalSourceCount",0,{"_67":68,"_69":70},"slug","deepmind","name","DeepMind",{"_72":73,"_11":74},"publicId","839b4f2f-d872-4209-9165-6f8599d3eb45","RIGHT-HTx框架开发及时间评估","研究成果","大模型","https://www.medrxiv.org/content/10.64898/2026.11.03.26367231v1?rss=1","medRxiv",{"_80":81,"_82":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","k36k58mfvkghr25tpvl4guto0","title","某研究团队在 Molecular Cell 发表：代谢物如何保护消耗它的酶","originalTitle","How a metabolite protects the enzyme that consumes it","summary","某研究团队在 Molecular Cell 发表论文，揭示代谢物色氨酸通过结合TDO2酶的第二个结合位点，稳定酶蛋白并调控其降解机制。研究使用CRISPRi筛选发现CK2激酶和CUL1–β-TrCP泛素连接酶的级联作用，结合冷冻电镜解析TDO2结构变化。","reason","source",{"_67":76},"links",{"_57":75},"publishedAt","2026-11-06T21:40:01.000Z","discoveredAt","2026-11-07T12:11:47.267Z","timelineAt","category","life-science","tags",[73,74],"score",68,"selected",false,"channel","news","story",{"_70":71,"_11":72},"x","readingMode","full","author","body","outline",[],"relatedStories",[69],"topics",[64],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","fhufe8k6WCGo","reportCount",1,"additionalSourceCount",0,{"_65":66,"_67":68},"slug","protein-structure","name","蛋白质结构与设计",{"_70":71,"_11":72},"publicId","b5f25d34-ff5b-4a19-8148-1694fdc27e28","色氨酸调控TDO2酶降解的分子机制研究发表","研究成果","蛋白质结构","https://phys.org/news/2026-11-metabolite-enzyme-consumes.html","Phys.org",{"_78":79,"_80":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","im1k34yvg1126roeqyo9a7zpz","title","东京大学与日本原子能机构团队首次在磁体中电控量子几何非线性霍尔态","originalTitle","Electrical control of an unconventional quantum transport state demonstrated in a magnet for the first time","summary","东京大学与日本原子能机构团队在《Newton》发表研究，首次在Mn3Sn磁体中观察到室温下第三阶非线性霍尔效应，并通过电流脉冲反转该效应。实验表明量子几何与自旋结构存在耦合，为开发基于自旋电子学的可调谐非线性电子器件提供了新路径。","reason","论文给出了通过电流脉冲反转量子几何非线性霍尔态（QgNLH）的实验方法与效果对比，可迁移至自旋电子学领域。","source",{"_69":80},"links",{"_58":79},"publishedAt","2026-11-05T21:40:09.000Z","discoveredAt","2026-11-05T21:47:11.970Z","timelineAt","category","quantum-physics","tags",[77,72,78],"score",84,"selected",true,"channel","news","story",{"_74":75,"_11":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[65,66],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","fLi6hwF7z0YM","reportCount",1,"additionalSourceCount",0,{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","conference-paper","name","顶会与论文接收","quantum-computing","量子计算",{"_74":75,"_11":76},"publicId","53d5da94-4b2a-4812-9113-67dba850e6bc","东京大学团队首次在磁体中电控量子几何非线性霍尔态","论文发表","超导","https://phys.org/news/2026-11-electrical-unconventional-quantum-state-magnet.html","Phys.org",{"_82":83,"_84":-5},"changelogVersion","2026-10-08T22:43","release"]

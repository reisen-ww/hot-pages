[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","qysu1a3kp8pofec3oil004s7l","title","昆虫在生态系统中的多重角色远超食物供应","originalTitle","The hidden ways insects support animal life—from habitat to health—go way beyond being food","summary","昆虫在生态系统中扮演着多样化的角色，远不止提供食物。它们通过创造和维护栖息地、提供保护、清洁和消毒等多重方式支持其他生物。例如，蚂蚁和白蚁建造的结构为其他物种提供栖息地，而某些鸟类会选择靠近黄蜂巢筑巢以避免捕食者。此外，昆虫还是许多植物的传粉者，对食物链有重要影响。全球至少有 1400 万种昆虫，它们对维持生态平衡至关重要。","reason","source",{"_70":71},"links",{"_57":69},"publishedAt","2026-11-07T21:00:01.000Z","discoveredAt","2026-11-07T21:12:17.294Z","timelineAt","category","life-science","tags",[68],"score",41,"selected",false,"channel","news","story",{"_65":66,"_11":67},"x","readingMode","full","author","body","outline",[],"relatedStories",[64],"topics",[],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","fnoM_wO2NHxo","reportCount",1,"additionalSourceCount",0,{"_65":66,"_11":67},"publicId","b5531269-d046-422f-b24a-f51b6922e3b3","昆虫生态价值研究：远超食物链的多重贡献","研究成果","https://phys.org/news/2026-11-hidden-ways-insects-animal-life.html","name","Phys.org",{"_73":74,"_75":-5},"changelogVersion","2026-10-08T22:43","release"]

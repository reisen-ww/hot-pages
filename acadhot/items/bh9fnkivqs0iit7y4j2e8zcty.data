[{"_1":2,"_3":4},"root",{"_5":78},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","bh9fnkivqs0iit7y4j2e8zcty","title","某研究团队在bioRxiv发表男女骨髓移植实验揭示CD74标记破骨细胞前体亚群调控骨代谢差异","originalTitle","Sex-specific bone marrow populations regulate skeletal phenotype and identify CD74-marked osteoclast precursor subsets","summary","某研究团队通过骨髓移植实验发现男女骨髓中CD74+破骨细胞前体亚群存在比例差异，生理条件下男性CD11B+CD74+细胞更多。单细胞测序显示女性CD74+细胞群骨吸收能力较弱，且X染色体基因Tlr7和Kdm6a的表达差异与骨代谢调控相关。该研究为性别特异性骨健康机制提供了新的单细胞分析视角。","reason","论文通过骨髓移植实验比较了男女骨髓中CD74+破骨细胞前体亚群的比例差异，并揭示了X染色体基因Tlr7和Kdm6a的表达与骨代谢调控的关系，为性别特异性骨健康研究提供了可迁移的细胞标记方法。","source",{"_69":77},"links",{"_59":76},"publishedAt","2026-11-04T00:00:00.000Z","discoveredAt","2026-11-04T08:39:26.951Z","timelineAt","category","gene-cell","tags",[74,75],"score",74,"selected",true,"channel","news","story",{"_72":73,"_11":12},"x","readingMode","full","author"," Koroth, J., Karkache, I. Y., Vu, E. K., Manser, J. C., Mitchell, S., Shimak, M. J., Robertson, N., Patterson, E., Kiraguri, S., Mansky, K. M., Bradley, E. ","body","outline",[],"relatedStories",[71],"topics",[66],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fGMbk9-tzLr8","reportCount",1,"additionalSourceCount",0,{"_67":68,"_69":70},"slug","cancer-immunotherapy","name","癌症免疫治疗",{"_72":73,"_11":12},"publicId","2acc9b19-afc5-4254-840d-d1325b119c10","研究成果","细胞治疗","https://www.biorxiv.org/content/10.64898/2026.11.03.763975v1?rss=1","bioRxiv",{"_79":80,"_81":-5},"changelogVersion","2026-10-08T22:43","release"]

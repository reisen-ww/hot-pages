[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","dshaf7izic7dhytv1yqgpkgsk","title","Nguyen等揭示Hipp信号通路在内皮细胞分化中的关键调控作用","originalTitle","Mapping the regulatory wiring of endothelial cell differentiation reveals a critical role for Hippo mechanosignaling","summary","Nguyen等团队提出新型CRISPR筛选结合单细胞测序方法，系统解析人类多能干细胞向动脉内皮细胞分化的调控网络。研究发现Hippo信号通路通过激活ETV2调控分化进程，抑制该通路导致细胞向成纤维细胞分化，并在斑马鱼胚胎发育中得到验证。方法创新包括改进的gRNA检测技术（CC-Perturb-seq）和基因程序推断算法，可同时扰动多个候选调控因子并追踪分化阶段差异","reason","提出新型CRISPR筛选结合单细胞测序方法，揭示Hippo信号通路在内皮细胞分化中的关键调控作用","source",{"_69":77},"links",{"_59":78},"publishedAt","2026-11-05T00:00:00.000Z","discoveredAt","2026-11-05T13:36:34.196Z","timelineAt","category","gene-cell","tags",[75,76,77],"score",60,"selected",true,"channel","news","story",{"_72":73,"_11":74},"x","readingMode","full","author"," Nguyen, T. C., King, H. D., Amgalan, D., Pushkarev, O., Mo, Y. A., Munger, C. J., McCreery, C., Gupta, R., Zeng, T., Zhou, R., Conley, S. D., Batta, S. P. R., Sheth, M. U., Mattei, E., Masaltseva, A., Kang, H. Y., Ma, X. R., Tran, N., Gaskell, L., Shoresh, N., Orlova, V., Kundaje, A., Sumanas, S., Ang, L. T., Loh, K. M., Engreitz, J. M. ","body","outline",[],"relatedStories",[71],"topics",[66],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","f46ntlkf1l8k","reportCount",1,"additionalSourceCount",0,{"_67":68,"_69":70},"slug","gene-editing","name","基因编辑与 CRISPR",{"_72":73,"_11":74},"publicId","7720e5b7-2730-4596-8b8d-bf73ec81966e","Nguyen团队揭示Hippo信号通路在内皮细胞分化中的关键作用","研究成果","CRISPR","bioRxiv","https://www.biorxiv.org/content/10.64898/2026.11.04.763740v1?rss=1",{"_80":81,"_82":-5},"changelogVersion","2026-10-08T22:43","release"]

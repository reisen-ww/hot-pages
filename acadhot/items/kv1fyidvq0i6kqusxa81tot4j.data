[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","kv1fyidvq0i6kqusxa81tot4j","title","阴阳五行生物盘与中西基础理论盘","originalTitle","阴阳五行生物盘和中西基础理论盘","summary","作者提出阴阳五行生物盘，通过电子-原子-分子-化学反应-新陈代谢的阴阳五行划分，解释生物结构链条如何实现高效协调。该理论结合河图原理，将脏腑划分与五行对应，形成一套新的生命活动解释框架。作者希望与同行探讨此理论，预计一年内可进一步发展。","reason","source",{"_70":71},"links",{"_57":69},"publishedAt","2026-11-07T09:46:44.000Z","discoveredAt","2026-11-07T14:17:09.229Z","timelineAt","category","neuroscience","tags",[68],"score",24,"selected",false,"channel","news","story",{"_65":66,"_11":67},"x","readingMode","full","author","body","outline",[],"relatedStories",[64],"topics",[],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","fFL66MVj9-_g","reportCount",1,"additionalSourceCount",0,{"_65":66,"_11":67},"publicId","1196c60a-4974-4a3a-8c09-3740d5c287c5","提出阴阳五行生物盘理论解释生物结构协调机制","研究成果","http://blog.sciencenet.cn/home.php?mod=space&uid=3657445&do=blog&id=1560158","name","科学网博客",{"_73":74,"_75":-5},"changelogVersion","2026-10-08T22:43","release"]

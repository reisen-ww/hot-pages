[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","bn9jwre7t35r0d3f2m3eiod9l","title","Drexel大学团队：抗胆碱能药物与自闭症及智力障碍成年人健康关联研究","originalTitle","Anticholinergic Medications and Health in Adults with Autism or Intellectual Disability","summary","基于2017-2019年美国医保数据的研究显示，自闭症+智力障碍组抗胆碱能药物暴露率达92.5%，显著高于对照组61.3%。多因素分析表明药物暴露与阿尔茨海默病（OR=1.34）、跌倒（OR=1.28）及死亡率（OR=1.19）呈正相关，且效应强度在复合障碍组尤为突出。研究通过抗胆碱能活性量表（AC Potency Scale）量化药物风险，为特殊人群用药安全提供新证据","reason","研究提供了抗胆碱能药物暴露与阿尔茨海默病、跌倒及死亡率关联的首次大规模人群证据，支持临床调整用药方案","source",{"_70":81},"links",{"_59":80},"publishedAt","2026-11-05T00:00:00.000Z","discoveredAt","2026-11-05T17:48:35.711Z","timelineAt","category","clinical","tags",[78,79,73],"score",71,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author"," McQuaid, G. A., Tao, S., Shea, L. L., Wallace, G. L. ","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fhonF-ZSdQWE","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","alzheimers","name","阿尔茨海默与神经退行","deepmind","DeepMind",{"_75":76,"_11":77},"publicId","1d3e19fe-9fdb-424b-b81c-67cbb04b99bb","Drexel大学研究揭示抗胆碱能药物与自闭症/智力障碍成人健康风险关联","研究成果","阿尔茨海默","https://www.medrxiv.org/content/10.64898/2026.10.26.26366518v1?rss=1","medRxiv",{"_83":84,"_85":-5},"changelogVersion","2026-10-08T22:43","release"]

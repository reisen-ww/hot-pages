[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","gvsujr7o8pieowcw7c2b2kr3v","title","某研究团队发现暗操作原叶绿素还原酶的硫桥二铜簇结构","originalTitle","A Binuclear Cluster Supports Functional Asymmetry in Dark-Operative Protochlorophyllide Reductase","summary","某研究团队通过Cu K-edge X射线吸收光谱和冷冻电镜首次发现暗操作原叶绿素还原酶（DPOR）的硫桥二铜簇结构，该簇位于NB-protein四聚体界面，Cu-S和Cu-Cu键长分别为2.26和2.62Å，验证了硫桥的桥接作用并排除了近端半胱氨酸的参与。研究提出该簇可能通过金属介导的协同机制传递底物结合信息。","reason","首次发现硫桥二铜簇结构，揭示光合细菌酶活性协同机制","source",{"_70":80},"links",{"_59":79},"publishedAt","2026-11-05T00:00:00.000Z","discoveredAt","2026-11-05T13:52:35.915Z","timelineAt","category","quantum-physics","tags",[78,73],"score",61,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author"," Zhao, K., Kashyap, R., Abernathy, M. J., Antony, E., Sarangi, R. ","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fMZvXBP1Rk3A","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","conference-paper","name","顶会与论文接收","nature","Nature",{"_75":76,"_11":77},"publicId","f381f55b-5aae-43de-b76f-e1f0ec474d98","暗操作原叶绿素还原酶硫桥合双铜簇结构首次解析","论文发表","https://www.biorxiv.org/content/10.64898/2026.11.03.763803v1?rss=1","bioRxiv",{"_82":83,"_84":-5},"changelogVersion","2026-10-08T22:43","release"]

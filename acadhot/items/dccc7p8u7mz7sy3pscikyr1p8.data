[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","dccc7p8u7mz7sy3pscikyr1p8","title","某研究团队在 bioRxiv 发表酮胺抑制多巴胺D2受体样激动剂诱导运动障碍的对比实验","originalTitle","Dyskinesia induced by a dopamine 2 receptor-like agonist, but not a dopamine 1 receptor-like agonist, is blocked by sub-anesthetic ketamine","summary","某研究团队在帕金森病动物模型中，通过每日给予左旋多巴建立运动障碍模型，对比了D2受体样激动剂（喹匹罗尔）和D1受体样激动剂（SKF-81297）诱导的运动障碍，发现亚麻醉剂量酮胺显著降低D2受体相关运动障碍的急性症状（第0天）和洗脱后第4、7天的长期症状。时间分析显示酮胺在喹匹罗尔诱导后持续抑制运动障碍表达。研究提出酮胺的抗运动障碍效应可能通过D2受体相关间接通路实现。","reason","论文提供了酮胺抑制D2受体样激动剂诱导运动障碍的对比实验数据，读者可据此判断酮胺对帕金森病运动障碍的潜在治疗价值。","source",{"_70":81},"links",{"_59":80},"publishedAt","2026-11-03T00:00:00.000Z","discoveredAt","2026-11-03T13:20:37.368Z","timelineAt","category","neuroscience","tags",[78,79,73],"score",72,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author"," Parmar, R., Meredith, J. R., Bartlett, M. J., Smith, E. G. E., Castro, J. M., Sherman, S. J., Chattree, G., Steece-Collier, K., Falk, T. ","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fItzW_-IFJzI","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","alzheimers","name","阿尔茨海默与神经退行","deepmind","DeepMind",{"_75":76,"_11":77},"publicId","4da771f2-6136-4079-bef2-b80101573155","酮胺抑制D2受体激动剂诱导运动障碍的对比实验","研究成果","帕金森","https://www.biorxiv.org/content/10.64898/2026.10.27.762361v1?rss=1","bioRxiv",{"_83":84,"_85":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","i67d2nai5izg9v1tf9q2qq1n1","title","Boise State University 研究发现阿拉斯加冰川单日速度激增251%","originalTitle","Heavy rain can more than double glacier speeds in Alaska","summary","Boise State University 研究团队通过 GPS 测量发现，阿拉斯加特纳冰川在单日降雨量达60毫米时，速度可增加251%，且加速与降雨滞后12小时相关。研究揭示动态排水效率是冰川加速的关键机制，为气候模型中的冰川动力学参数提供验证方法。","reason","source",{"_70":71},"links",{"_57":69},"publishedAt","2026-11-07T15:40:05.000Z","discoveredAt","2026-11-07T15:54:14.085Z","timelineAt","category","neuroscience","tags",[68],"score",61,"selected",false,"channel","news","story",{"_65":66,"_11":67},"x","readingMode","full","author","body","outline",[],"relatedStories",[64],"topics",[],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","fL3xO0YOBpdw","reportCount",1,"additionalSourceCount",0,{"_65":66,"_11":67},"publicId","14fef0ea-3eb4-432a-89ff-c21dc34906ca","Boise State University发现阿拉斯加冰川单日降雨60毫米致速度增251%","研究成果","https://phys.org/news/2026-11-heavy-glacier-alaska.html","name","Phys.org",{"_73":74,"_75":-5},"changelogVersion","2026-10-08T22:43","release"]

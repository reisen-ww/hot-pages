[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","nli7mvp931kmok6s3cj3y25zq","title","宇宙的本质是存在！存在定义宇宙结构和格局！","originalTitle","什么是存在一一存在是宇宙的本质！存在是宇宙结构和格局！存在就是宇宙！","summary","本文提出了“存在”的新定义，即宇宙不动点及其决定的一切。不动点是宇宙广延性和持续性流逝的定点不变规定，决定了一切宇宙存在。这一定义解决了哲学和认知上的历史疑难，为物理存在和宇宙本质提供了新的视角。","reason","source",{"_67":76},"links",{"_57":75},"publishedAt","2026-11-07T09:55:00.000Z","discoveredAt","2026-11-07T15:04:13.598Z","timelineAt","category","neuroscience","tags",[73,74],"score",18,"selected",false,"channel","news","story",{"_70":71,"_11":72},"x","readingMode","full","author","body","outline",[],"relatedStories",[69],"topics",[64],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","fVweMCH0CgwU","reportCount",1,"additionalSourceCount",0,{"_65":66,"_67":68},"slug","conference-paper","name","顶会与论文接收",{"_70":71,"_11":72},"publicId","b3a99bdf-a186-49d1-97b0-d88367e75f9c","邵亮团队提出宇宙不动点定义存在新理论","论文发表","研究成果","http://blog.sciencenet.cn/home.php?mod=space&uid=3400625&do=blog&id=1560160","科学网博客",{"_78":79,"_80":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","c1n9uxzb93x5n7z5biz55vdhe","title","韩红桂等在《自动化学报》提出电子固废处理析取过程溶解氧浓度自适应因果推理预测模型","originalTitle","电子固废处理析取过程溶解氧浓度预测模型","summary","韩红桂等团队在《自动化学报》发表研究，提出电子固废处理析取过程溶解氧浓度自适应因果推理预测模型（ACIPM）。该模型通过多头注意力引导的动态因果发现、因果干预策略抑制虚假相关，以及元更新门控网络调节时空特征与因果特征融合权重，显著提升预测精度。实验表明，ACIPM 在复杂析取过程中能动态捕捉因果结构变化，优于传统方法。研究为工业过程建模提供新思路，但极端工况泛化能力仍需验证。","reason","source",{"_68":78},"links",{"_57":77},"publishedAt","2026-11-07T04:56:52.000Z","discoveredAt","2026-11-07T11:25:34.773Z","timelineAt","category","materials-energy","tags",[76,71],"score",51,"selected",false,"channel","news","story",{"_73":74,"_11":75},"x","readingMode","full","author","body","outline",[],"relatedStories",[72],"topics",[64,65],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","fr1DYK3MW8YE","reportCount",1,"additionalSourceCount",0,{"_66":70,"_68":71},{"_66":67,"_68":69},"slug","conference-paper","name","顶会与论文接收","deepmind","DeepMind",{"_73":74,"_11":75},"publicId","cce860a1-62f1-4eea-bc5d-c30668b5c39f","韩红桂团队提出电子固废处理溶解氧自适应因果预测模型","论文发表","http://blog.sciencenet.cn/home.php?mod=space&uid=3291369&do=blog&id=1560137","科学网博客",{"_80":81,"_82":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":76},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","jcp4h5qw614ibxmeevza70vlp","title","AI 安全评估、基准测试与保障 Track 征稿通知","originalTitle","【中国科学技术大学 | IEEE 主办】AISS 2026: AI 安全评估、基准测试与保障 Track 征稿通知","summary","2026人工智能安全国际会议（AISS 2026）将于12月18日至20日在合肥召开，聚焦AI安全评估、基准测试与保障。该track涵盖基准与测试平台、保障与审计方法、事件与部署后监控、可复现评估与负责任披露等内容，旨在提供科学、可信的评估标准与方法。","reason","source",{"_67":75},"links",{"_57":74},"publishedAt","2026-11-07T07:59:49.000Z","discoveredAt","2026-11-07T12:58:06.724Z","timelineAt","category","ai-frontier","tags",[73],"score",23,"selected",false,"channel","news","story",{"_70":71,"_11":72},"x","readingMode","full","author","body","outline",[],"relatedStories",[69],"topics",[64],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","f6g0TKABy5u4","reportCount",2,"additionalSourceCount",0,{"_65":66,"_67":68},"slug","conference-paper","name","顶会与论文接收",{"_70":71,"_11":72},"publicId","a1ccf045-5b26-4426-8e78-71d828123483","AISS 2026新增两个安全相关Track并公布评审机构","会议与顶会","http://blog.sciencenet.cn/home.php?mod=space&uid=3661806&do=blog&id=1560151","科学网博客",{"_77":78,"_79":-5},"changelogVersion","2026-10-08T22:43","release"]

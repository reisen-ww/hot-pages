[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","db4ptn1o0pk2ramy05zd4kkt8","title","帕金森精准医学计划（PPMI）发布神经α突触蛋白病前驱期认知表现研究","originalTitle","Cognitive Performance in Prodromal Neuronal α Synuclein Disease","summary","帕金森精准医学计划（PPMI）发布神经α突触蛋白病前驱期认知表现研究，发现患者语言和执行功能较健康人群低0.2个标准差（P=0.007），MCI概率年增幅1.28倍（P=0.04）；纵向分析显示语言功能轨迹差异在4年随访中显著（P=0.009），但在3年年龄匹配亚组中未重复。","reason","研究对比了神经α突触蛋白病前驱期患者与健康人群的认知差异，发现语言和执行功能评分显著降低，且MCI概率年增幅高于健康人群但低于帕金森患者，为早期干预提供数据参考。","source",{"_70":81},"links",{"_59":80},"publishedAt","2026-11-06T00:00:00.000Z","discoveredAt","2026-11-07T12:11:47.431Z","timelineAt","category","clinical","tags",[78,79,73],"score",64,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author"," Anis, S., Zimmerman, E., Sperling, S. A., Alberts, J. L., Weintraub, D., Simuni, T., Siderowf, A., Fernandez, H. H., on behalf of the Parkinson's Precision Medicine Initiative ","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fLMwq41owh1A","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","alzheimers","name","阿尔茨海默与神经退行","deepmind","DeepMind",{"_75":76,"_11":77},"publicId","4cdb9f7a-5c15-4af2-8865-c22613e1b031","帕金森精准医学计划发布前驱期认知研究，4年随访显示语言功能差异但3年亚组未重复","研究成果","阿尔茨海默","https://www.medrxiv.org/content/10.64898/2026.11.05.26367361v1?rss=1","medRxiv",{"_83":84,"_85":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","j9ebiv8zl1lxbnefh8hlnqsz2","title","Science：量子气体显微镜首次实现可调三组分哈伯德系统个体原子观测","originalTitle","Quantum gas microscope reveals individual atoms in first tunable three-component Hubbard system","summary","德国、泰国、印度和中国等国际研究团队首次在实验室构建三组分可调哈伯德系统，并利用量子气体显微镜实现个体原子观测（DOI:10.1126/science.adv1247）。","reason","论文给出了量子气体显微镜在可调三组分哈伯德模型中的实验结果，并验证了数值计算的准确性，为核物理和材料科学中的量子模拟提供了新方法。","source",{"_69":80},"links",{"_58":79},"publishedAt","2026-11-06T20:20:01.000Z","discoveredAt","2026-11-07T12:11:48.042Z","timelineAt","category","quantum-physics","tags",[77,78,72],"score",80,"selected",true,"channel","news","story",{"_74":75,"_11":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[65,66],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","fCHg85Kf3d2Q","reportCount",1,"additionalSourceCount",0,{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","conference-paper","name","顶会与论文接收","nature","Nature",{"_74":75,"_11":76},"publicId","016c5ba5-81a0-4933-8b94-ee673164ff79","国际团队首次用量子气体显微镜观测三组分可调Hubbard系统","论文发表","研究成果","https://phys.org/news/2026-11-quantum-gas-microscope-reveals-individual.html","Phys.org",{"_82":83,"_84":-5},"changelogVersion","2026-10-08T22:43","release"]

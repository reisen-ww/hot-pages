[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","giqbwhh0yspp3z9lydn04cqab","title","达尔文胡蜂揭示进化路径的不可逆性","originalTitle","The wasps that horrified Darwin reveal evolution's one-way streets","summary","国际团队通过分析697种达尔文胡蜂的遗传数据，发现其进化策略存在23次独立转变宿主策略的案例，但从未出现策略逆转的证据。研究发表于Current Biology（DOI:10.1016/j.cub.2026.10.032），揭示了进化方向性特征：宿主策略转变后难以回到原始状态，类似生物进化中的‘棘轮效应’。","reason","source",{"_70":71},"links",{"_57":69},"publishedAt","2026-11-06T22:20:01.000Z","discoveredAt","2026-11-07T12:11:46.176Z","timelineAt","category","neuroscience","tags",[68],"score",67,"selected",false,"channel","news","story",{"_65":66,"_11":67},"x","readingMode","full","author","body","outline",[],"relatedStories",[64],"topics",[],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","f844VsnjFSBc","reportCount",1,"additionalSourceCount",0,{"_65":66,"_11":67},"publicId","dbf1fa98-71fb-4eae-b843-8f9a7718e094","达尔文胡蜂进化策略研究揭示方向性特征","研究成果","https://phys.org/news/2026-11-wasps-horrified-darwin-reveal-evolution.html","name","Phys.org",{"_73":74,"_75":-5},"changelogVersion","2026-10-08T22:43","release"]

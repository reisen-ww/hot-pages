[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","bcssmrqe3kovfmuc12rjlp8cq","title","某团队在bioRxiv发表设计生物分子凝聚体的关键参数研究","originalTitle","Disulfide Crosslink Density is a Key Determinant in the Formation, Dynamics, and Maturation of Cysteine-rich Designer Biomolecular Condensates.","summary","某团队在bioRxiv发表研究，发现半胱氨酸密度显著影响生物分子凝聚体的组装和流变特性，高密度下凝聚体更稳定且孔隙率降低。","reason","该论文通过系统调控半胱氨酸密度和间距，揭示了二硫键交联密度对凝聚体组装、流变性和氧化还原响应性的关键作用，为设计响应性生物材料提供了可迁移的方法。","source",{"_69":77},"links",{"_59":78},"publishedAt","2026-11-04T00:00:00.000Z","discoveredAt","2026-11-05T01:47:19.552Z","timelineAt","category","materials-energy","tags",[75,76,77],"score",76,"selected",true,"channel","news","story",{"_72":73,"_11":74},"x","readingMode","full","author"," Mondal, M., Swetman, W. S., Allen, C. T., Livingston, H., Clemons, T. D., Rangachari, V. ","body","outline",[],"relatedStories",[71],"topics",[66],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fsf3KlgV0FUY","reportCount",1,"additionalSourceCount",0,{"_67":68,"_69":70},"slug","protein-structure","name","蛋白质结构与设计",{"_72":73,"_11":74},"publicId","5d80976a-b3b1-48f8-a2a7-407ebf9c82f5","研究揭示二硫键交联密度调控蛋白质凝集体形成及性能的关键作用","研究成果","蛋白质结构","bioRxiv","https://www.biorxiv.org/content/10.64898/2026.11.03.763743v1?rss=1",{"_80":81,"_82":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","fgxgw6ap8sdjedn02unuah1ah","title","某研究团队开发双特异性VSV-G Engager实现细胞特异性病毒载体递送","originalTitle","Bispecific VSV-G Engagers: A Platform for Cell-Type-Specific Delivery of Viral Vectors","summary","某研究团队开发可逆性双特异性VSV-G Engager平台，通过融合细胞特异性配体或抗体与VSV-G结合域，在LDLR介导的胞吞后释放病毒颗粒。实验显示CEACAM8基Engager对CEACAM6+上皮细胞有特异性递送（IC50=16.7 pM），并成功在NSG小鼠中实现OPM2多发性骨髓瘤的CAR-T细胞治疗持续控制。该技术可能推动体内基因治疗和肿瘤靶向溶瘤病毒疗法的进展","reason","该论文提出了通过双特异性VSV-G Engager实现细胞特异性递送的技术方案，并提供了IC50值16.7 pM和NSG小鼠中持续抑制OPM2多发性骨髓瘤的实验数据，可作为递送系统优化参考","source",{"_70":81},"links",{"_59":80},"publishedAt","2026-11-03T00:00:00.000Z","discoveredAt","2026-11-03T18:36:34.803Z","timelineAt","category","drug-therapy","tags",[78,79,73],"score",75,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author"," Nenavath, G. N., Gataulin, D., Eisenstein, M., Schreiber, G., Hasan, M. S., Packiriswamy, N., Jain, P., Kadungure, T., Anantharama, H., Chin, C.-H., Kancharla, A., Salimi, H., Lech, P., Blancas-Mejia, L., Munoz-Alia, M., Peng, K.-W., Russell, S., Rubinstein, M. ","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","frzxJmt1qsIY","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","cancer-immunotherapy","name","癌症免疫治疗","openai","OpenAI",{"_75":76,"_11":77},"publicId","62ad0ed3-1d07-493d-aa5b-732167a6b271","某研究团队开发双特异性VSV-G Engager递送平台，实现细胞特异性溶瘤病毒治疗","研究成果","细胞治疗","https://www.biorxiv.org/content/10.64898/2026.11.02.763599v1?rss=1","bioRxiv",{"_83":84,"_85":-5},"changelogVersion","2026-10-08T22:43","release"]

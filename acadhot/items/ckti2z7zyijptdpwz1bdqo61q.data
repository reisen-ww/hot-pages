[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","ckti2z7zyijptdpwz1bdqo61q","title","Roy等提出CARTnet框架：结合接触感知注意力与多模态特征的B细胞表位预测新方法","originalTitle","CARTnet: Template-guided B-cell Epitope Prediction with Contact-aware Attention","summary","Roy团队发布CARTnet框架，在B细胞表位预测中内部测试集AUPRC达0.243（优于DiscoTope-3的0.220、BepiPred-2的0.140、BepiPred-3的0.198），外部测试集0.267。模板指导预测场景下，单个模板残基可将AUPRC从0.225提升至0.403，并验证了跨属病毒表位信息的迁移学习能力。","reason","论文提供了CARTnet框架与DiscoTope-3、BepiPred-2、BepiPred-3在内部和外部测试集的AUPRC对比数据，显示其在模板指导预测场景下AUPRC提升至0.403，支持跨属种表位信息的迁移学习应用","source",{"_70":81},"links",{"_59":80},"publishedAt","2026-11-04T00:00:00.000Z","discoveredAt","2026-11-05T01:47:19.281Z","timelineAt","category","ai-frontier","tags",[78,79,73],"score",71,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author"," Roy, R. S., Abeer, A. N. M. N., Yoon, B.-J., Qian, X. ","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fKyaZqzyzrxQ","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","conference-paper","name","顶会与论文接收","openai","OpenAI",{"_75":76,"_11":77},"publicId","ad72fcdf-03bf-4ec5-bab9-63d87f8191cc","Roy团队提出CARTnet框架，提升B细胞表位预测性能","论文发表","研究成果","https://www.biorxiv.org/content/10.64898/2026.11.03.764112v1?rss=1","bioRxiv",{"_83":84,"_85":-5},"changelogVersion","2026-10-08T22:43","release"]

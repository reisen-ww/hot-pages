[{"_1":2,"_3":4},"root",{"_5":80},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","foakjpapc8kmiy69gscz561p7","title","伊利诺伊大学厄巴纳-香槟分校团队在 Nano Letters 发表可同时存储多光子的量子芯片研究","originalTitle","Quantum chip holds multiple photons at once, opening path to scalable memory","summary","伊利诺伊大学厄巴纳-香槟分校团队在 Nano Letters 发表研究，利用掺铒薄膜铌酸锂纳米光子波导和原子频率梳实现量子光子存储。器件存储时间超过1微秒，并能同时存储多个光子，同时具备片上集成和规模化制造潜力。研究团队表示，后续将通过改进频率梳和尝试不同铒同位素，提高光子读取效率并延长存储时间。","reason","研究展示了薄膜铌酸锂芯片存储多光子的具体方案与超过1微秒的时间尺度，可用于理解量子存储走向片上集成时的技术取舍。","source",{"_69":79},"links",{"_58":78},"publishedAt","2026-10-09T17:00:10.000Z","discoveredAt","2026-10-09T23:02:33.751Z","timelineAt","category","quantum-physics","tags",[77,72],"score",82,"selected",true,"channel","news","story",{"_74":75,"_11":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[65,66],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","fXZ8izOTWnoA","reportCount",1,"additionalSourceCount",0,{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","conference-paper","name","顶会与论文接收","quantum-computing","量子计算",{"_74":75,"_11":76},"publicId","c5da667b-9d84-4f33-896b-0815febc35d6","纳米光子芯片实现多光子量子存储","论文发表","https://phys.org/news/2026-10-quantum-chip-multiple-photons-path.html","Phys.org",{"_81":82,"_83":-5},"changelogVersion","2026-10-08T22:43","release"]

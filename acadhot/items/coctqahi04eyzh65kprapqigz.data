[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","coctqahi04eyzh65kprapqigz","title","基于步态的三维骨骼运动通用健康预测模型在 Nature Medicine 发表","originalTitle","A gait foundation model for prediction of multisystem health phenotypes from 3D skeletal motion","summary","该研究开发了一个基于步态的三维骨骼运动模型，通过分析3332名成年人的骨骼运动数据，成功预测了心血管代谢、心理健康和身体机能等多系统健康表型，为早期疾病筛查提供了新方法。","reason","该模型为多系统健康问题的早期预测提供了新工具，可迁移至其他生物力学数据场景","source",{"_70":80},"links",{"_59":79},"publishedAt","2026-11-06T00:00:00.000Z","discoveredAt","2026-11-07T12:11:38.231Z","timelineAt","category","ai-frontier","tags",[78,73],"score",69,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author","Adam Gabet","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","frX4-CskwM3g","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","conference-paper","name","顶会与论文接收","nature","Nature",{"_75":76,"_11":77},"publicId","2665cc61-5c73-47d5-bb28-de6515eca615","基于步态的三维骨骼运动模型预测多系统健康表型在Nature Medicine发表","论文发表","https://www.nature.com/articles/s41591-026-04724-9","Nature Medicine",{"_82":83,"_84":-5},"changelogVersion","2026-10-08T22:43","release"]

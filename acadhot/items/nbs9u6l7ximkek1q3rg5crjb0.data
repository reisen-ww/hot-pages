[{"_1":2,"_3":4},"root",{"_5":76},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","nbs9u6l7ximkek1q3rg5crjb0","title","微生物结合胆酸对艰难梭菌生命周期及致病性的差异性影响","originalTitle","Microbially conjugated bile acids differentially affect the lifecycle and pathogenesis of Clostridioides difficile","summary","该研究合成36种微生物结合胆酸（MCBA），测试其对艰难梭菌生长、膜完整性、孢子形成及毒素活性的影响。发现氨基酸依赖性效应：丝氨酸MCBA增强细菌在抑制性胆酸浓度下的生长并提高毒素活性，色氨酸MCBA则增强抑制效果。该成果明确了MCBA活性分子机制，为开发基于微生物的艰难梭菌治疗手段提供新方向。","reason","研究揭示了微生物结合胆酸对艰难梭菌生命周期各阶段影响的氨基酸依赖性机制，为开发基于微生物的治疗方案提供了分子层面的指导依据。","source",{"_75":73},"links",{"_59":74},"publishedAt","2026-11-07T00:00:00.000Z","discoveredAt","2026-11-08T02:17:38.098Z","timelineAt","category","gene-cell","tags",[70,71,72,73],"score",78,"selected",true,"channel","news","story",{"_67":68,"_11":69},"x","readingMode","full","author"," Theriot, C. M., Hamacher, S. W., Nandwana, N. K., Lyons, N. S., Gancz, A. S., Perkins, C. E., Cheng, B., Gentry, E. ","body","outline",[],"relatedStories",[66],"topics",[],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fqWQD1fSmfoU","reportCount",1,"additionalSourceCount",0,{"_67":68,"_11":69},"publicId","388e612b-f37e-4227-b3d9-f18831de02da","不同氨基酸连接的微生菌结合胆酸影响艰难梭菌生命周期及致病性","研究成果","mRNA","肠道菌群","bioRxiv","https://www.biorxiv.org/content/10.64898/2026.11.05.764496v1?rss=1","name",{"_77":78,"_79":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","cn9nhl7hqcrnvhgv9lci0p3iz","title","渥太华大学团队发表新宇宙学模型：无需暗物质与暗能量也能解释观测结果","originalTitle","Theory predicting an older universe without dark matter or dark energy passes key cosmological tests","summary","渥太华大学团队提出无需暗物质与暗能量的新宇宙学模型，并通过多项观测验证。该模型成功解释了早期大质量星系的形成机制（较标准模型预测提前12亿年），并预测詹姆斯·韦伯望远镜可观测到此前认为不可能存在的超早期星系。研究已发表在《Universe》期刊（DOI:10.3390/universe12070193），包含对宇宙微波背景辐射等未发表验证的提及。","reason","source",{"_67":76},"links",{"_57":75},"publishedAt","2026-11-07T14:00:02.000Z","discoveredAt","2026-11-07T14:02:24.772Z","timelineAt","category","quantum-physics","tags",[73,74],"score",53,"selected",false,"channel","news","story",{"_70":71,"_11":72},"x","readingMode","full","author","body","outline",[],"relatedStories",[69],"topics",[64],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","fKSx59WgOmHg","reportCount",1,"additionalSourceCount",0,{"_65":66,"_67":68},"slug","conference-paper","name","顶会与论文接收",{"_70":71,"_11":72},"publicId","dc05cf82-73d8-49a9-b4e3-3920d93b3dd8","A Big Bang Nucleosynthesis Consistency Test of the CCC+TL Co","论文发表","研究成果","https://phys.org/news/2026-11-theory-older-universe-dark-energy.html","Phys.org",{"_78":79,"_80":-5},"changelogVersion","2026-10-08T22:43","release"]

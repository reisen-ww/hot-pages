[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","gr30e5ohak1s3lv68w63m7c4j","title","德国三所大学联合研究：个性化储蓄提醒使退休储蓄率提升18%","originalTitle","Personalized savings reminders can help boost retirement savings","summary","德国科隆大学、慕尼黑大学和帕德博恩大学研究团队通过两次针对41000名欧洲客户的实验，发现损失框架提醒对信息处理能力强的人群更有效，收益框架对50岁以上及多次额外缴费者更有效。","reason","该研究为行为经济学在金融领域的应用提供了实证支持，其个性化干预方法对其他领域的用户行为引导具有参考价值。","source",{"_75":76},"links",{"_58":74},"publishedAt","2026-11-07T23:30:01.000Z","discoveredAt","2026-11-07T23:36:31.006Z","timelineAt","category","clinical","tags",[69,70,71,72,73],"score",76,"selected",true,"channel","news","story",{"_66":67,"_11":68},"x","readingMode","full","author","body","outline",[],"relatedStories",[65],"topics",[],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","fgjwMbkdtnhE","reportCount",1,"additionalSourceCount",0,{"_66":67,"_11":68},"publicId","ffb49c51-aaf3-4944-bf35-1004edd36062","德国三所大学研究证实个性化储蓄提醒提升退休储蓄率18%","研究成果","大模型","DeepMind","OpenAI","NVIDIA","https://phys.org/news/2026-11-personalized-boost.html","name","Phys.org",{"_78":79,"_80":-5},"changelogVersion","2026-10-08T22:43","release"]

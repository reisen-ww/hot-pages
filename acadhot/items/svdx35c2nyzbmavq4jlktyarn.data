[{"_1":2,"_3":4},"root",{"_5":78},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":-5,"_14":15,"_16":-5,"_17":18,"_19":20,"_21":22,"_23":24,"_25":24,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":40,"_41":-5,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":33,"_50":51,"_52":53,"_54":33,"_55":56},"id","svdx35c2nyzbmavq4jlktyarn","title","邱园 Hill 1915《植物园历史的与功能》的意象学解读","originalTitle","summary","1915年，邱园皇家植物园助理园长希尔在密苏里植物园成立25周年纪念文集中发表《植物园的历史与功能》。文章通过意象学四层框架（感知、认知、情感、文化）分析了植物园的发展，指出希尔的文本虽详细记录了植物园的设施与历史，但忽略了访客的感知体验、公众认知、访客情感及文化中的不平等。","reason","source",{"_67":77},"links",{"_56":76},"publishedAt","2026-11-07T09:21:40.000Z","discoveredAt","2026-11-07T14:17:09.682Z","timelineAt","category","gene-cell","tags",[75,70],"score",34,"selected",false,"channel","news","story",{"_72":73,"_11":74},"x","readingMode","full","author","body","outline",[],"relatedStories",[71],"topics",[63,64],"indexable","markdownAvailable",true,"group",{"_57":58,"_59":60,"_61":62},"hasTranslation","bodyLanguage","original","factId","fG-vXYONow7c","reportCount",1,"additionalSourceCount",0,{"_65":69,"_67":70},{"_65":66,"_67":68},"slug","conference-paper","name","顶会与论文接收","nature","Nature",{"_72":73,"_11":74},"publicId","074801ba-1b61-4e0a-ac17-cb252e28b795","1915年邱园希尔植物园论文遭意象学框架批判","论文发表","http://blog.sciencenet.cn/home.php?mod=space&uid=38998&do=blog&id=1560154","科学网博客",{"_79":80,"_81":-5},"changelogVersion","2026-10-08T22:43","release"]

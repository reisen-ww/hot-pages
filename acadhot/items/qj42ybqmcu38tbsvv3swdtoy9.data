[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":34,"_52":53,"_54":55,"_56":34,"_57":58},"id","qj42ybqmcu38tbsvv3swdtoy9","title","某团队在 bioRxiv 发表视网膜退行性疾病中 cGMP 通路与 kinome 分析的联合研究","originalTitle","Identification of Kinome Biomarkers and Therapeutic Rescue in cGMP-Linked Retinal Degeneration","summary","某团队在 bioRxiv 发表视网膜退行性疾病中 cGMP 通路与 kinome 分析的联合研究，首次通过外周血单核细胞 kinase 活动分析发现 cGMP 类似物 LP-CN03 可改善 rd10 小鼠视网膜病变，并在新型 CRISPR-Cas9 生成 Aipl1-/- 模型中验证其疗效，包括电视网膜图检测、光波测试及基因表达分析。","reason","source",{"_68":77},"links",{"_58":78},"publishedAt","2026-11-07T00:00:00.000Z","discoveredAt","2026-11-07T12:27:31.383Z","timelineAt","category","clinical","tags",[74,75,76,77],"score",53,"selected",false,"channel","news","story",{"_71":72,"_11":73},"x","readingMode","full","author"," Topcu Okan, I. C., Ahmadian, M., Altay, H. Y., Pal Singh, S., Kheirandish, G., Ozer, S., Gaillard, P., Bouffard, R., Neutzner, A., Esmen, K., Tschopp, M., Lawrence, M., Diril, M. K., Paquet-Durand, F., Agca, C. ","body","outline",[],"relatedStories",[70],"topics",[65],"indexable","markdownAvailable",true,"group",{"_59":60,"_61":62,"_63":64},"hasTranslation","bodyLanguage","original","factId","fKznWHKTbbig","reportCount",1,"additionalSourceCount",0,{"_66":67,"_68":69},"slug","gene-editing","name","基因编辑与 CRISPR",{"_71":72,"_11":73},"publicId","1ff362c1-008b-4814-a822-95e55ac11df1","视网膜退化疾病中cGMP类似物LP-CN03通过激酶分析验证疗效","研究成果","基因治疗","CRISPR","bioRxiv","https://www.biorxiv.org/content/10.64898/2026.11.06.763903v1?rss=1",{"_80":81,"_82":-5},"changelogVersion","2026-10-08T22:43","release"]

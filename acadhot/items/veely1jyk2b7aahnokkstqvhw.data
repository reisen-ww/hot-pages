[{"_1":2,"_3":4},"root",{"_5":80},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","veely1jyk2b7aahnokkstqvhw","title","佛罗里达州立大学团队在 JACS 发表光催化转化磺胺类药物新方法","originalTitle","Light-powered method resurrects 'dead-end' compounds for drug discovery","summary","佛罗里达州立大学团队在《Journal of the American Chemical Society》发表研究，利用光化学反应将磺胺类药物转化为有价值的合成原料。实验通过激光光谱技术捕捉单微秒内的分子反应过程，合作方包括宾夕法尼亚州立大学和GSK公司。该成果为结构导向药物设计提供了新工具，适用于其他化学组分的转化研究。","reason","source",{"_67":79},"links",{"_57":78},"publishedAt","2026-11-06T20:40:01.000Z","discoveredAt","2026-11-07T12:11:47.754Z","timelineAt","category","drug-therapy","tags",[73,74,75,76,77],"score",56,"selected",false,"channel","news","story",{"_70":71,"_11":72},"x","readingMode","full","author","body","outline",[],"relatedStories",[69],"topics",[64],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","fEJ0PHeG81Lo","reportCount",1,"additionalSourceCount",0,{"_65":66,"_67":68},"slug","conference-paper","name","顶会与论文接收",{"_70":71,"_11":72},"publicId","85f499a8-f995-47fe-982f-94262b9886ca","佛罗里达州立大学开发光催化磺胺类药物转化新方法","论文发表","研究成果","DeepMind","OpenAI","NVIDIA","https://phys.org/news/2026-11-powered-method-resurrects-dead-compounds.html","Phys.org",{"_81":82,"_83":-5},"changelogVersion","2026-10-08T22:43","release"]

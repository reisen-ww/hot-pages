[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","iom1cbbex6b7dlss178dybpmu","title","某研究团队在 bioRxiv 发表农业消化物超滤用于微藻生物量生产的论文","originalTitle","Agricultural digestate ultrafiltrate outperforms synthetic media for microalgal biomass production while enabling biostimulant generation","summary","某研究团队在 bioRxiv 发表农业消化物超滤（UF）作为微藻培养基的论文，测试了 UF 对 Chlorella sorokiniana 和 Nannochloropsis oceanica 的铵耐受性及生物质产量影响。","reason","超滤技术（UF）在微藻培养中展现出比合成培养基更高的生物质积累效率，且其提取的生物质具有促进番茄根系发育的活性，为循环生物炼厂提供新思路。","source",{"_69":77},"links",{"_59":78},"publishedAt","2026-10-30T00:00:00.000Z","discoveredAt","2026-10-30T14:02:20.641Z","timelineAt","category","materials-energy","tags",[75,76,77],"score",73,"selected",true,"channel","news","story",{"_72":73,"_11":74},"x","readingMode","full","author"," Miotti, T., Maver, M., Peli, M., Lo Coco, R., Rodegher, G., Viglioli, G., Frison, N., Bolzonella, D., Zamboni, A., Ballottari, M., Cazzaniga, S. ","body","outline",[],"relatedStories",[71],"topics",[66],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fjK68UNet-5A","reportCount",1,"additionalSourceCount",0,{"_67":68,"_69":70},"slug","solid-state-battery","name","电池与储能",{"_72":73,"_11":74},"publicId","96982611-2cca-45c1-9b2e-45eeb517b74e","农业消化液超滤液在微藻生物质生产中优于合成培养基，并促进生物刺激剂生成","研究成果","固态电池","bioRxiv","https://www.biorxiv.org/content/10.64898/2026.10.29.762777v1?rss=1",{"_80":81,"_82":-5},"changelogVersion","2026-10-08T22:43","release"]

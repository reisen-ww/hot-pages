[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","cdhlsg46uoflj2636mt6lx0oq","title","某研究团队在 bioRxiv 发布CRISPRi-seq基因组筛查揭示铜绿假单胞菌氨基糖苷类耐药性关键基因","originalTitle","Genome-wide CRISPRi-seq maps essential-gene contributions to aminoglycoside susceptibility in Pseudomonas aeruginosa","summary","某团队开发CRISPRi-seq平台，在铜绿假单胞菌PAO1中完成83,078个向导的基因组筛查，发现118个增强氨基糖苷类敏感性的基因（如atpI、accC、secA、ftsZ）和120个抑制敏感性的基因，并通过转录组分析验证了靶向沉默效果。该研究首次系统量化了CRISPRi介导的必需基因抑制对细菌生长竞争力和抗生素活性的双重影响机制。","reason","该研究构建了新型CRISPRi-seq平台，通过大规模基因组筛查发现atpI、accC等关键基因对氨基糖苷类抗生素敏感性的调控机制，为耐药菌治疗提供了可验证的靶点筛选方法。","source",{"_69":77},"links",{"_59":78},"publishedAt","2026-11-02T00:00:00.000Z","discoveredAt","2026-11-03T03:59:50.738Z","timelineAt","category","gene-cell","tags",[75,76,77],"score",78,"selected",true,"channel","news","story",{"_72":73,"_11":74},"x","readingMode","full","author"," Czeka?a, W., Gawor, J., Goitia Camacho, R. E., Doma?ska, B., Padilla Martinez, L. F., Zuchniewicz, K., Po?nik, F., Bartosik, A. A., Liu, X., Kawalek, A. ","body","outline",[],"relatedStories",[71],"topics",[66],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","foMjqGNfamb4","reportCount",1,"additionalSourceCount",0,{"_67":68,"_69":70},"slug","gene-editing","name","基因编辑与 CRISPR",{"_72":73,"_11":74},"publicId","e76832a6-63f1-4598-955c-e04d69e2fb3a","某团队在bioRxiv发布CRISPRi-seq研究揭示铜绿假单胞菌氨基糖苷类耐药关键基因","研究成果","CRISPR","bioRxiv","https://www.biorxiv.org/content/10.64898/2026.11.01.763562v1?rss=1",{"_80":81,"_82":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":75},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":-5,"_14":15,"_16":-5,"_17":18,"_19":20,"_21":22,"_23":24,"_25":24,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":40,"_41":-5,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":33,"_50":51,"_52":53,"_54":33,"_55":56},"id","c5h24mb8se8comgb4z9cle4qg","title","《唯波论》概要与目录","originalTitle","summary","《唯波论》是郭磊著的一部横跨物理学、哲学与生命感悟的思想著作，核心命题认为宇宙间万事万物的本质是\"波\"，并提出\"中者生存律\"。书中通过回顾物理学史、双缝实验和薛定谔的猫等实验，瓦解粒子概念，提出六种基波的本体论框架，并探讨暗物质、量子纠缠等未解之谜。","reason","source",{"_66":74},"links",{"_56":73},"publishedAt","2026-11-07T11:46:55.000Z","discoveredAt","2026-11-08T01:09:31.265Z","timelineAt","category","quantum-physics","tags",[72],"score",25,"selected",false,"channel","news","story",{"_69":70,"_11":71},"x","readingMode","full","author","body","outline",[],"relatedStories",[68],"topics",[63],"indexable","markdownAvailable",true,"group",{"_57":58,"_59":60,"_61":62},"hasTranslation","bodyLanguage","original","factId","fzv0xYVM7P-k","reportCount",1,"additionalSourceCount",0,{"_64":65,"_66":67},"slug","conference-paper","name","顶会与论文接收",{"_69":70,"_11":71},"publicId","5da8ace5-eace-4575-b033-c2b6666cea4a","郭磊《唯波论》提出万物本质为波","论文发表","http://blog.sciencenet.cn/home.php?mod=space&uid=230383&do=blog&id=1560166","科学网博客",{"_76":77,"_78":-5},"changelogVersion","2026-10-08T22:43","release"]

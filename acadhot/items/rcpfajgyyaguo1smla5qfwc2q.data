[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","rcpfajgyyaguo1smla5qfwc2q","title","空气孔将硅片转化为紫外聚焦平面镜","originalTitle","Air holes turn silicon wafers into flat ultraviolet focusing mirrors for compact optics","summary","研究人员开发了一种新型平面光学器件，通过在硅片上蚀刻空气腔体，实现了紫外光的聚焦。该器件利用硅的强吸收特性，将光限制在空气腔体内，从而避免了光的损失。实验结果显示，该器件能够在325纳米紫外光下聚焦，并且具有紧凑的光学系统潜力，可用于高分辨率成像、光谱学和传感。相关研究成果发表在《先进光子学》期刊上。","reason","source",{"_68":78},"links",{"_57":77},"publishedAt","2026-11-06T22:00:01.000Z","discoveredAt","2026-11-07T12:11:46.349Z","timelineAt","category","materials-energy","tags",[76,71],"score",36,"selected",false,"channel","news","story",{"_73":74,"_11":75},"x","readingMode","full","author","body","outline",[],"relatedStories",[72],"topics",[64,65],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","fQ897h3PDe5U","reportCount",1,"additionalSourceCount",0,{"_66":70,"_68":71},{"_66":67,"_68":69},"slug","conference-paper","name","顶会与论文接收","nature","Nature",{"_73":74,"_11":75},"publicId","cbeb9d1c-3590-4888-9432-8d6f0ee928c5","硅基超紫外反射光子元表面研究发表","论文发表","https://phys.org/news/2026-11-air-holes-silicon-wafers-flat.html","Phys.org",{"_80":81,"_82":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":76},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":34,"_52":53,"_54":55,"_56":34,"_57":58},"id","xihhwup68t7zoz86vwpzuys8a","title","诺华Lp(a)药物HORIZON III期试验失败，未改善心血管结局","originalTitle","STAT+: Failure of Novartis Lp(a) drug raises questions about cardiovascular strategy","summary","HORIZON III期试验显示诺华研发的Lp(a)靶向药物佩拉卡森（pelacarsen）虽显著降低受试者Lp(a）水平（中位降低90%），但随访近5年未观察到心梗、中风或死亡风险下降。该研究由Novartis资助，数据同时发表于NEJM。试验纳入428名Lp(a）高风险患者，随机分组接受药物或安慰剂，主要终点为严重心血管事件发生率。","reason","source",{"_68":75},"links",{"_58":74},"publishedAt","2026-11-07T14:50:00.000Z","discoveredAt","2026-11-07T15:07:11.886Z","timelineAt","category","clinical","tags",[69],"score",67,"selected",false,"channel","news","story",{"_71":72,"_11":73},"x","readingMode","full","author","Elizabeth Cooney and Matthew Herper","body","outline",[],"relatedStories",[70],"topics",[65],"indexable","markdownAvailable",true,"group",{"_59":60,"_61":62,"_63":64},"hasTranslation","bodyLanguage","original","factId","fmZoCDeh_JNM","reportCount",1,"additionalSourceCount",0,{"_66":67,"_68":69},"slug","clinical-trial","name","临床试验",{"_71":72,"_11":73},"publicId","cb0c9077-c180-46f7-8c8a-007e62b4e592","诺华Lp(a)靶向药物HORIZON III期试验未达心血管终点","https://www.statnews.com/2026/11/07/aha-conference-news-novartis-lp-a-pelacarsen-heart-disease-trial-mystery/?utm_campaign=rss","STAT News",{"_77":78,"_79":-5},"changelogVersion","2026-10-08T22:43","release"]

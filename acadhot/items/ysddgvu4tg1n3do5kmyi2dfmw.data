[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","ysddgvu4tg1n3do5kmyi2dfmw","title","科罗拉多大学博尔德分校团队在 Scientific Reports 发表无人机采样大气微塑料新方法","originalTitle","New method measures microplastics in the air using an uncrewed aerial system","summary","科罗拉多大学博尔德分校团队首次成功将环境气旋采样器搭载于无人机系统，实现大气微塑料的采样与成分分析。研究在科罗拉多州两个典型区域（交通密集区与垃圾填埋场）开展采样，通过优化采样体积与飞行时间（25分钟）解决了微塑料浓度低的问题。样本分析显示异质聚合体占比最高，该成果得到 CIRES 研究创新计划支持，为北极等偏远地区大气微塑料研究奠定基础。","reason","source",{"_67":76},"links",{"_57":75},"publishedAt","2026-11-06T21:20:04.000Z","discoveredAt","2026-11-07T12:11:47.434Z","timelineAt","category","materials-energy","tags",[73,74],"score",74,"selected",false,"channel","news","story",{"_70":71,"_11":72},"x","readingMode","full","author","body","outline",[],"relatedStories",[69],"topics",[64],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","f6sI7h1mt28k","reportCount",1,"additionalSourceCount",0,{"_65":66,"_67":68},"slug","conference-paper","name","顶会与论文接收",{"_70":71,"_11":72},"publicId","a3112fa5-4d34-4731-8763-ac04b76809b6","科罗拉多大学团队开发无人机采样大气微塑料新方法","论文发表","研究成果","https://phys.org/news/2026-11-method-microplastics-air-uncrewed-aerial.html","Phys.org",{"_78":79,"_80":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","rk0s22otgpty597s4o4aq92v9","title","生命不灭定律与生命熵守恒定律 —— 热力学、生命起源及宇宙演化的范式创新","originalTitle","生命不灭定律与生命熵守恒定律 ——热力学、生命起源及宇宙演化的范式创新","summary","本文提出生命不灭定律与生命熵守恒定律，构建广义生物热力学，回答生命有序的本质、生命起源的热力学条件及宇宙演化是否必然走向热寂等问题。生命熵描述可遗传信息的完整度与自复制能力，独立于物理熵。生命系统作为开放系统，总熵流由物理熵流与生命熵流组成。生命熵守恒定律否定了宇宙热寂的必然性，为生命起源、合成生物学、天体生物学提供新的理论框架。","reason","source",{"_67":76},"links",{"_57":75},"publishedAt","2026-11-07T10:15:38.000Z","discoveredAt","2026-11-07T15:04:13.417Z","timelineAt","category","life-science","tags",[73,74],"score",49,"selected",false,"channel","news","story",{"_70":71,"_11":72},"x","readingMode","full","author","body","outline",[],"relatedStories",[69],"topics",[64],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","fa5BujtFrdZ8","reportCount",1,"additionalSourceCount",0,{"_65":66,"_67":68},"slug","conference-paper","name","顶会与论文接收",{"_70":71,"_11":72},"publicId","853aad06-cad7-428a-adcd-9cf9894c3856","scu提出生命不灭与熵守恒理论挑战热寂说","论文发表","研究成果","http://blog.sciencenet.cn/home.php?mod=space&uid=3417936&do=blog&id=1560162","科学网博客",{"_78":79,"_80":-5},"changelogVersion","2026-10-08T22:43","release"]

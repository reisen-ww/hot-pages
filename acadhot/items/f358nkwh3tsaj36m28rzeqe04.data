[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","f358nkwh3tsaj36m28rzeqe04","title","Havor等团队在bioRxiv发表HPV相关肛门癌的肿瘤体积与ctDNA动态耦合模型","originalTitle","Coupled Modeling of Tumor Volume and ctDNA Dynamics in HPV-Associated Anal Squamous Cell Carcinoma","summary","Havor等团队开发出基于肿瘤体积和ctDNA动态的耦合模型，用于评估HPV相关肛门癌患者的免疫治疗响应。研究纳入26例患者，发现基线ctDNA评分可追踪肿瘤负荷但无法区分治疗应答者与非应答者，而治疗后1周期的ctDNA显著下降（应答组相对降幅达60%）。","reason","该模型为ctDNA动态监测提供了新方法，可辅助优化免疫治疗随访策略。","source",{"_69":78},"links",{"_59":77},"publishedAt","2026-11-03T00:00:00.000Z","discoveredAt","2026-11-03T15:57:45.044Z","timelineAt","category","clinical","tags",[75,76],"score",86,"selected",true,"channel","news","story",{"_72":73,"_11":74},"x","readingMode","full","author"," Havor, P. M., Huffman, B. M., Cleary, J. M., Jabalee, J., Brady-Nicholls, R. ","body","outline",[],"relatedStories",[71],"topics",[66],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fs01UVxuwWp4","reportCount",1,"additionalSourceCount",0,{"_67":68,"_69":70},"slug","cancer-immunotherapy","name","癌症免疫治疗",{"_72":73,"_11":74},"publicId","b7589ab2-4ddf-4d42-b659-c0e6ef5e40b5","Havor团队发布HPV相关肛门癌免疫治疗响应预测模型","研究成果","癌症免疫","https://www.biorxiv.org/content/10.64898/2026.11.01.763528v1?rss=1","bioRxiv",{"_80":81,"_82":-5},"changelogVersion","2026-10-08T22:43","release"]

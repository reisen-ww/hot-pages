[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","hiuu17qgc2wmpulyejlmuls5w","title","证监会就公募基金运作办法征求意见，放宽FOF投资限制","originalTitle","政策“组合拳”破局，公募资产配置打开新空间","summary","中国证监会就《公开募集证券投资基金运作管理办法》公开征求意见，降低FOF成立门槛，允许投资ETF联接基金，提高非FOF基金投资其他基金的比例上限，明确REITs投资按证券投资管理。","reason","政策放宽了FOF的投资限制，为公募资产配置提供了新的灵活性。","source",{"_68":76},"links",{"_58":75},"publishedAt","2026-10-26T23:24:48.000Z","discoveredAt","2026-10-26T23:35:22.270Z","timelineAt","category","clinical","tags",[74],"score",80,"selected",true,"channel","news","story",{"_71":72,"_11":73},"x","readingMode","full","author","body","outline",[],"relatedStories",[70],"topics",[65],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","fNGdlE_vVH-s","reportCount",2,"additionalSourceCount",0,{"_66":67,"_68":69},"slug","research-policy","name","科研政策",{"_71":72,"_11":73},"publicId","13ec887a-5b77-4a42-af85-12f07a97e97e","证监会两次调整公募基金规则放宽投资限制","政策发布","https://36kr.com/newsflashes/4043298535920518?f=rss","36氪",{"_78":79,"_80":-5},"changelogVersion","2026-10-08T22:43","release"]

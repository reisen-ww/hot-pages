[{"_1":2,"_3":4},"root",{"_5":80},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","g8w6hgqs1pycwk6ri21gywibw","title","狗与人类大脑对情绪身体表达的表征差异研究","originalTitle","Dog and Human Brains Represent Human Emotional Bodies with Asymmetric Encoding of Happiness and Anger","summary","某团队通过fMRI对比狗和人类大脑对情绪身体表达的神经表征，发现快乐与愤怒的编码存在非对称模式。研究纳入24只清醒犬类和40名受试者，观察其对快乐、愤怒和中性动作视频的反应。","reason","该研究首次通过fMRI同时对比狗和人类大脑对情绪身体表达的神经表征，为跨物种认知研究提供了方法学参考","source",{"_69":79},"links",{"_59":78},"publishedAt","2026-11-03T00:00:00.000Z","discoveredAt","2026-11-03T16:29:49.610Z","timelineAt","category","neuroscience","tags",[75,70,76,77],"score",83,"selected",true,"channel","news","story",{"_72":73,"_11":74},"x","readingMode","full","author"," Cuaya, L. V., Hernandez-Perez, R., Boch, M., Rumpf, J., Reyes-Aguilar, A., Huber, L., Lamm, C. ","body","outline",[],"relatedStories",[71],"topics",[66],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","flJMJtEMpFAc","reportCount",1,"additionalSourceCount",0,{"_67":68,"_69":70},"slug","brain-computer-interface","name","脑机接口",{"_72":73,"_11":74},"publicId","7c09f88f-a801-4577-bd79-8fffd79bb9c6","狗与人类大脑情绪表征差异研究","研究成果","DeepMind","Nature","https://www.biorxiv.org/content/10.64898/2026.10.28.762252v1?rss=1","bioRxiv",{"_81":82,"_83":-5},"changelogVersion","2026-10-08T22:43","release"]

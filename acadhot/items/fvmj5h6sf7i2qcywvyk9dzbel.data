[{"_1":2,"_3":4},"root",{"_5":76},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":34,"_52":53,"_54":55,"_56":34,"_57":58},"id","fvmj5h6sf7i2qcywvyk9dzbel","title","诺和诺德Ziltivekimab抗炎单抗III期试验失败，暂停两项后续研究","originalTitle","STAT+: Despite Novo drug’s failure, cardiologists say they will still pursue anti-inflammatories","summary","诺和诺德Ziltivekimab单抗在III期临床试验中未能降低严重心血管患者的心脏事件发生率（与安慰剂组无差异），该试验（ZEUS）共纳入324名患者，主要终点为心血管事件。试验结果于2026-11-07在AHA科学会议上披露并同步发表在NEJM。基于此，诺和诺德已暂停两项相关试验（HERMES和ATHENA）。","reason","source",{"_68":75},"links",{"_58":74},"publishedAt","2026-11-07T14:35:00.000Z","discoveredAt","2026-11-07T15:07:11.966Z","timelineAt","category","clinical","tags",[69],"score",61,"selected",false,"channel","news","story",{"_71":72,"_11":73},"x","readingMode","full","author","Elizabeth Cooney","body","outline",[],"relatedStories",[70],"topics",[65],"indexable","markdownAvailable",true,"group",{"_59":60,"_61":62,"_63":64},"hasTranslation","bodyLanguage","original","factId","fpCml7OnQfaE","reportCount",1,"additionalSourceCount",0,{"_66":67,"_68":69},"slug","clinical-trial","name","临床试验",{"_71":72,"_11":73},"publicId","9868c73f-963a-4a58-ad11-b6c660459d69","诺和诺德Ziltivekimab抗炎单抗III期试验失败致两项后续研究暂停","https://www.statnews.com/2026/11/07/aha-2026-conference-novo-nordisk-zeus-trial-ziltivekimab-results/?utm_campaign=rss","STAT News",{"_77":78,"_79":-5},"changelogVersion","2026-10-08T22:43","release"]

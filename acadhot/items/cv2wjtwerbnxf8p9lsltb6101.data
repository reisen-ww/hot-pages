[{"_1":2,"_3":4},"root",{"_5":73},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":34,"_52":53,"_54":55,"_56":34,"_57":58},"id","cv2wjtwerbnxf8p9lsltb6101","title","频率依赖的α-突触核蛋白纤维对太赫兹脉冲的响应：非平衡分子动力学研究","originalTitle","Frequency-Dependent Structural Responses of Amyloid-β Fibrils to Terahertz Pulses: A Nonequilibrium Molecular Dynamics Study","summary","研究者使用非平衡分子动力学模拟，探讨了不同频率和电场强度的太赫兹脉冲对三种α-突触核蛋白纤维（2LMP、2MXU 和 5OQV）的影响。结果显示，频率在 0.5 至 60 THz 范围内的脉冲导致 β-折叠含量的频率依赖性损失，且不同频率下的结构变化与高温对照组不同。研究提出了一种两阈值电场框架来描述纤维的破坏，为研究外部场对α-突触核蛋白结构的影响提供了可测试的方法。","reason","source",{"_71":72},"links",{"_58":70},"publishedAt","2026-11-07T00:00:00.000Z","discoveredAt","2026-11-08T02:49:26.937Z","timelineAt","category","neuroscience","tags",[69],"score",38,"selected",false,"channel","news","story",{"_66":67,"_11":68},"x","readingMode","full","author"," Wang, Y., Dai, J., Peng, X., Zhao, Q. ","body","outline",[],"relatedStories",[65],"topics",[],"indexable","markdownAvailable",true,"group",{"_59":60,"_61":62,"_63":64},"hasTranslation","bodyLanguage","original","factId","f6BpO3skwgQA","reportCount",1,"additionalSourceCount",0,{"_66":67,"_11":68},"publicId","a50217df-6ebc-481c-bbd2-31a11849fba6","太赫兹脉冲频率影响β-淀粉样纤维结构研究提出两阈值电场框架","研究成果","https://www.biorxiv.org/content/10.64898/2026.11.06.764785v1?rss=1","name","bioRxiv",{"_74":75,"_76":-5},"changelogVersion","2026-10-08T22:43","release"]

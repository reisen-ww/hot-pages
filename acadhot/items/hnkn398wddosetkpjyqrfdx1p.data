[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","hnkn398wddosetkpjyqrfdx1p","title","IBS 团队在 Science 发表研究：单一 WSe₂ 晶体经逐层化学转化制成高性能晶体管","originalTitle","Single 2D crystal transforms into transistor with built-in insulation and electrical contacts","summary","IBS 团队在 Science 发表论文，展示从单一 WSe₂ 晶体出发，通过逐层化学转化同时获得半导体通道、WOₓ 绝缘介质与 WTe₂ 金属接触的方法。该团队实现约 0.7 nm 单层精度的转化控制，WSe₂ 晶体管亚阈值摆幅达 61.3 mV/decade，接近室温理论极限，开关比超过 1000 万。","reason","团队从单一 WSe₂ 晶体逐层化学转化出半导体、绝缘介质与金属接触，亚阈值摆幅 61.3 mV/decade 接近理论极限。","source",{"_69":80},"links",{"_58":79},"publishedAt","2026-10-15T20:40:06.000Z","discoveredAt","2026-10-15T20:47:36.747Z","timelineAt","category","materials-energy","tags",[77,78,72],"score",78,"selected",true,"channel","news","story",{"_74":75,"_11":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[65,66],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","fzBw6kuFm1sA","reportCount",1,"additionalSourceCount",0,{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","conference-paper","name","顶会与论文接收","science","Science",{"_74":75,"_11":76},"publicId","b9ab1054-d82d-44aa-ad92-8a61bffb05f7","IBS团队将单一WSe₂晶体逐层转化为晶体管","论文发表","半导体材料","https://phys.org/news/2026-10-2d-crystal-transistor-built-insulation.html","Phys.org",{"_82":83,"_84":-5},"changelogVersion","2026-10-08T22:43","release"]

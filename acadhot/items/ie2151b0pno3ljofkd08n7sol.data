[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":-5,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":34,"_52":34,"_53":54,"_55":56,"_57":58},"id","ie2151b0pno3ljofkd08n7sol","title","基于健康与退休研究开发并验证简化金融福祉指数","originalTitle","Development and Validation of a Parsimonious Financial Well-Being Index in the Health and Retirement Study","summary","该研究基于健康与退休研究（HRS）数据，开发并验证了一个简化的金融福祉指数。样本包括23,006名50岁以上老年人，随访时间从2006年至2022年，两因素结构的模型拟合指数为CFI 0.99，RMSEA 0.05。该指数与消费者金融保护局财务福祉量表的相关性为斯皮尔曼P=0.80，与生活满意度的相关性为P=0.43，并显示与社会经济因素和随后的健康结果呈假设性关联。","reason","该研究开发了一个简洁的金融福祉指数，并验证其与认知生活满意度的相关性及对后续健康结果的预测价值。","source",{"_68":76},"links",{"_58":75},"publishedAt","2026-10-20T00:00:00.000Z","discoveredAt","2026-10-20T19:01:31.871Z","timelineAt","category","tags",[74,69],"score",64,"selected",true,"channel","news","story",{"_71":72,"_11":73},"x","readingMode","full","author"," Habib, M. H., Mayeda, E. R., Barry, L., Arah, O. A., Nau, C. L., Zhou, H., Kezios, K. L., Nianogo, R. A. ","body","outline",[],"relatedStories",[70],"topics",[65],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","fGnkJuvsymDg","reportCount",1,"additionalSourceCount",0,{"_66":67,"_68":69},"slug","nih","name","NIH",{"_71":72,"_11":73},"publicId","9f92ea9c-534b-431e-b239-be61350b1fe9","基于HRS开发并验证简化金融福祉指数","研究成果","https://www.medrxiv.org/content/10.64898/2026.10.18.26365842v1?rss=1","medRxiv",{"_78":79,"_80":-5},"changelogVersion","2026-10-08T22:43","release"]

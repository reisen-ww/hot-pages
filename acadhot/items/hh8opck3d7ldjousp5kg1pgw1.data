[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","hh8opck3d7ldjousp5kg1pgw1","title","某团队在 bioRxiv 发表 LTBP2 通过调控 TGF-β 介导远程心肌纤维化的机制研究","originalTitle","Latent Transforming Growth Factor Binding Protein ? 2 promotes microfibrillar TGF-? bioavailability to drive pathologic fibrosis in remote regions of infarcted hearts","summary","某团队通过小鼠实验发现 LTBP2 通过限制基质中潜伏 TGF-β 的结合，促进心肌梗死后的远程纤维化，并验证了其与纤连蛋白-1的相互作用界面可能成为治疗靶点。","reason","论文揭示了 LTBP2 通过限制基质中潜伏 TGF-β 的结合，扩大激活池来促进纤维化的机制，为靶向 LTBP2 的药物开发提供新思路。","source",{"_70":81},"links",{"_59":80},"publishedAt","2026-11-03T00:00:00.000Z","discoveredAt","2026-11-03T18:36:35.120Z","timelineAt","category","life-science","tags",[78,79,73],"score",79,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author"," Ehsan, F., Di Paola, M., Dewar, M., Zhang, H., Kuzmanov, U., Zhou, Y.-Q., Reitz, C. J., Shah, H., Wang, T., Liu, J., Izumi, A., Hu, R., Hendy, J., Younesi, F. S., Friedberg, M. K., Billia, F., Nakamura, T., Hinz, B., Mecham, R. P., Gramolini, A. O., Heximer, S. P. ","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","f1yOTxXaWWf4","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","protein-structure","name","蛋白质结构与设计","deepmind","DeepMind",{"_75":76,"_11":77},"publicId","4a6b1cfd-313e-4c0e-9f90-b480c202bc00","研究揭示LTBP2在MI后远程心肌重塑机制及潜在治疗靶点","研究成果","蛋白质结构","https://www.biorxiv.org/content/10.64898/2026.10.28.762676v1?rss=1","bioRxiv",{"_83":84,"_85":-5},"changelogVersion","2026-10-08T22:43","release"]

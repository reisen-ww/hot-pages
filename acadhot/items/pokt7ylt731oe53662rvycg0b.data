[{"_1":2,"_3":4},"root",{"_5":78},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":34,"_52":53,"_54":55,"_56":34,"_57":58},"id","pokt7ylt731oe53662rvycg0b","title","某团队在 bioRxiv 发表新型高通量空间表观组学方法 SPACE-Tag","originalTitle","SPACE-Tag Enables High-Throughput Spatial Chromatin Profiling With CUT&Tag","summary","某团队开发出基于CUT&Tag的空间表观组学方法SPACE-Tag，可在完整组织内高通量解析染色质状态。应用至小鼠脑组织，该方法同步捕获5种组蛋白修饰和转录组数据，构建了覆盖成年全生命周期的最大脑图谱。研究发现脑纤维束存在广泛转录下调但无邻近染色质状态变化，而皮层区域呈现协调的染色质-转录组变化，其中H3K4me1峰模块随年龄增长增强，并关联神经元可塑性调控基因的上调。","reason","source",{"_68":76},"links",{"_58":77},"publishedAt","2026-11-07T00:00:00.000Z","discoveredAt","2026-11-07T15:38:16.631Z","timelineAt","category","gene-cell","tags",[74,75,76],"score",57,"selected",false,"channel","news","story",{"_71":72,"_11":73},"x","readingMode","full","author"," Yan, C., He, R., Fernandez, S., Pleska, M., Maniatis, S., Raimondi, I., Vickovic, S. ","body","outline",[],"relatedStories",[70],"topics",[65],"indexable","markdownAvailable",true,"group",{"_59":60,"_61":62,"_63":64},"hasTranslation","bodyLanguage","original","factId","f9wR4dPy8A78","reportCount",1,"additionalSourceCount",0,{"_66":67,"_68":69},"slug","gene-editing","name","基因编辑与 CRISPR",{"_71":72,"_11":73},"publicId","579758f3-91f6-4ecc-8c71-29ff2f9e9384","SPACE-Tag技术实现高通量空间染色质组学分析","研究成果","CRISPR","bioRxiv","https://www.biorxiv.org/content/10.64898/2026.11.06.764689v1?rss=1",{"_79":80,"_81":-5},"changelogVersion","2026-10-08T22:43","release"]

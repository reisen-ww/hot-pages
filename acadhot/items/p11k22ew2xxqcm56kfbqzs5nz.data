[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","p11k22ew2xxqcm56kfbqzs5nz","title","Diwali 庆祝活动与空气质量恶化并存，专家建议采取防护措施","originalTitle","Diwali celebrations coincide with worsening air. Here's how to stay safer","summary","在南亚尤其是印度北部，Diwali 庆祝活动与冬季空气质量恶化重叠，专家建议检查空气质量指数、佩戴合适口罩和使用空气净化器以减少有害污染物的暴露。印度新德里的细颗粒污染平均值去年约为世界卫生组织年度指导值的 19 倍，严重污染水平可危害健康人群。","reason","source",{"_70":71},"links",{"_57":69},"publishedAt","2026-11-07T11:40:01.000Z","discoveredAt","2026-11-07T12:11:44.303Z","timelineAt","category","clinical","tags",[68],"score",31,"selected",false,"channel","news","story",{"_65":66,"_11":67},"x","readingMode","full","author","body","outline",[],"relatedStories",[64],"topics",[],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","fxVsffa7T1-8","reportCount",1,"additionalSourceCount",0,{"_65":66,"_11":67},"publicId","055e59c8-34ec-4860-bfdc-8645d8317ccc","Diwali庆祝活动与空气质量恶化共存，专家建议防护措施","研究成果","https://phys.org/news/2026-11-diwali-celebrations-coincide-worsening-air.html","name","Phys.org",{"_73":74,"_75":-5},"changelogVersion","2026-10-08T22:43","release"]

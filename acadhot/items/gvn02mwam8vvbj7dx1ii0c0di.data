[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","gvn02mwam8vvbj7dx1ii0c0di","title","基于表征感知校准的蛋白质结构搜索可靠性提升方法","originalTitle","Representation-aware calibration enables statistically reliable protein structure search","summary","Shi 等团队在 bioRxiv 发布预印本，提出 Struct-Caliper 方法用于蛋白质结构搜索。该方法通过表征感知的查询随机化生成背景查询，将 Foldseek 的同源蛋白恢复率提升 18.2%（错误发现率相近），在 Reseek 中使错误发现减少 99.5%。","reason","方法对比显示 Struct-Caliper 在 Foldseek 和 Reseek 中分别将同源蛋白恢复率提升 18.2% 和减少 99.5% 错误发现，为结构搜索提供更可靠的统计评估框架。","source",{"_70":80},"links",{"_59":81},"publishedAt","2026-11-04T00:00:00.000Z","discoveredAt","2026-11-05T01:47:19.595Z","timelineAt","category","ai-frontier","tags",[78,79,80],"score",77,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author"," Shi, L., Zhou, H., Yang, Y., Lu, Y. ","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","flr_02e20kLk","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","conference-paper","name","顶会与论文接收","protein-structure","蛋白质结构与设计",{"_75":76,"_11":77},"publicId","da8d5d4c-1004-4dfa-975a-5f01f45b83c7","Shi团队发布预印本Struct-Caliper方法提升蛋白质结构搜索准确率","论文发表","蛋白质结构","bioRxiv","https://www.biorxiv.org/content/10.64898/2026.11.03.764110v1?rss=1",{"_83":84,"_85":-5},"changelogVersion","2026-10-08T22:43","release"]

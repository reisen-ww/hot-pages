[{"_1":2,"_3":4},"root",{"_5":76},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":-5,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":40,"_41":-5,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":33,"_50":51,"_52":53,"_54":33,"_55":56},"id","o3lswp47yuofsw5a5du21sz7t","title","不同文体帮助博士生适应新读者","originalTitle","Different text genres help doctoral students adapt their writing to reach new readers","summary","一项研究显示，通过同时处理不同文体，博士生能够更好地适应新读者的需求。参与者在一次研讨会上分析了学术摘要、改写研究博客为学术摘要，并撰写通俗科学文章，展示了语言和结构的转移。研究指出，解释概念可能需要更多空间，博士生需考虑新读者的现有知识水平，灵活调整写作技巧。","reason","source",{"_66":75},"links",{"_56":74},"publishedAt","2026-11-07T19:00:02.000Z","discoveredAt","2026-11-07T19:05:29.450Z","timelineAt","category","tags",[72,73],"score",44,"selected",false,"channel","news","story",{"_69":70,"_11":71},"x","readingMode","full","author","body","outline",[],"relatedStories",[68],"topics",[63],"indexable","markdownAvailable",true,"group",{"_57":58,"_59":60,"_61":62},"hasTranslation","bodyLanguage","original","factId","fRLhaExlEzMs","reportCount",1,"additionalSourceCount",0,{"_64":65,"_66":67},"slug","conference-paper","name","顶会与论文接收",{"_69":70,"_11":71},"publicId","fa9659c2-3f33-4e51-8136-f9e5d5539b2f","Chalmers研究：多文体教学提升博士生适应新读者能力","论文发表","研究成果","https://phys.org/news/2026-11-text-genres-doctoral-students-readers.html","Phys.org",{"_77":78,"_79":-5},"changelogVersion","2026-10-08T22:43","release"]

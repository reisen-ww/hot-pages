[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","cgjlp5mrtce3ks4n9612i4okx","title","某团队在 bioRxiv 发表改进的ECM可注射材料制造方法","originalTitle","An Improved Manufacturing Method for Infusible Extracellular Matrix Materials to Enable Efficient Scale-Up, Improved Efficacy, and Clinical Translation","summary","某团队在 bioRxiv 发表改进的ECM可注射材料制造方法，通过深度过滤和切向流过滤（DF-TFF）减少生产步骤并提高浓度。研究显示DF-TFF制造的ECM与原有C-D-F法相当，并在猪急性心梗和鼠多器官衰竭模型中验证了剂量依赖性疗效，同时DF-TFF使替代组织来源的ECM生产时效性提升。","reason","论文给出了DF-TFF方法在提高生产效率和合规性方面的对比数据，读者可参考其优化流程并评估在临床转化中的可行性。","source",{"_69":77},"links",{"_59":78},"publishedAt","2026-11-02T00:00:00.000Z","discoveredAt","2026-11-03T08:52:17.595Z","timelineAt","category","gene-cell","tags",[75,76,77],"score",77,"selected",true,"channel","news","story",{"_72":73,"_11":74},"x","readingMode","full","author"," Nguyen, M., Zelus, E. I., Karkanitsa, M. L., Liebman, B., Luo, C., Munoz, C., Liu, J., Conklin, C., Cabrales, P., Hepokoski, M., Kinsey, A., Christman, K. L. ","body","outline",[],"relatedStories",[71],"topics",[66],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fiLxsDVdF3JE","reportCount",1,"additionalSourceCount",0,{"_67":68,"_69":70},"slug","cancer-immunotherapy","name","癌症免疫治疗",{"_72":73,"_11":74},"publicId","58bd3ac7-de35-4405-90a4-a7a9cfe66076","某团队开发DF-TFF方法提升可注射ECM制造效率并验证动物疗效","研究成果","细胞治疗","bioRxiv","https://www.biorxiv.org/content/10.64898/2026.10.29.762959v1?rss=1",{"_80":81,"_82":-5},"changelogVersion","2026-10-08T22:43","release"]

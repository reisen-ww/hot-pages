[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","ux61ppqz9hukfx7ax5a1ul7js","title","Portsmouth大学研究提出危机沟通六原则：诚实需结合主动、尊重与解决方案导向","originalTitle","Redefining honesty in a crisis: Why truth alone is not enough","summary","Portsmouth大学研究提出危机沟通六原则，强调诚实需结合主动、尊重与解决方案导向。研究基于20位营销从业者的访谈，发现仅透明度不足以重建信任，需同步提供定期更新、影响说明、具体补救措施。论文发表于Cogent Business & Management（DOI:10.1080/23311975.2026.2747479），案例涵盖英国零售业近期数据泄露与运营中断事件。","reason","source",{"_67":76},"links",{"_57":75},"publishedAt","2026-11-06T19:00:14.000Z","discoveredAt","2026-11-07T12:11:49.164Z","timelineAt","category","clinical","tags",[73,74],"score",57,"selected",false,"channel","news","story",{"_70":71,"_11":72},"x","readingMode","full","author","body","outline",[],"relatedStories",[69],"topics",[64],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","fIyJ_RkZ0tAQ","reportCount",1,"additionalSourceCount",0,{"_65":66,"_67":68},"slug","conference-paper","name","顶会与论文接收",{"_70":71,"_11":72},"publicId","48901d59-ce7f-48c2-8b1b-56a8b4ac85db","Portsmouth大学提出危机沟通六原则：主动透明与解决方案并重","论文发表","研究成果","https://phys.org/news/2026-11-redefining-honesty-crisis-truth.html","Phys.org",{"_78":79,"_80":-5},"changelogVersion","2026-10-08T22:43","release"]

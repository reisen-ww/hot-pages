[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","jgygtbpbp863vod86myjrfzz3","title","脂肪酸合酶B（FASN）与细胞mRNA互作及翻译效率调控机制研究","originalTitle","Fatty Acid Synthase Binds Cellular mRNAs and its Depletion Reduces Translational Efficiency","summary","某研究团队在 bioRxiv 发表脂肪酸合酶B（FASN）的内源性RNA互作组研究，发现FASN偏好结合mRNA的5'非翻译区，并证实其缺失导致相关mRNA翻译效率下降，关联到形态发生和细胞分裂功能。研究采用交叉连接技术结合核糖体测序，解析了FASN在两种人细胞系中的直接RNA结合位点超过6000个，覆盖3500余个编码基因。该成果为靶向FASN的癌症治疗提供新机制依据。","reason","论文首次解析了脂肪酸合酶B（FASN）的内源性RNA互作组，发现其偏好mRNA的5'非翻译区，并证实FASN缺失显著降低相关mRNA的翻译效率，为靶向FASN的癌症治疗提供新机制依据。","source",{"_69":77},"links",{"_59":78},"publishedAt","2026-11-07T00:00:00.000Z","discoveredAt","2026-11-08T03:20:33.914Z","timelineAt","category","life-science","tags",[75,76,77],"score",75,"selected",true,"channel","news","story",{"_72":73,"_11":74},"x","readingMode","full","author"," Perevalova-Pinzul, Y., Marks, J., Sajek, M. P., Clarke, S., Lisy, S., Mukherjee, N., Meydan, S., Ascano, M. ","body","outline",[],"relatedStories",[71],"topics",[66],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fY8d_5huKhCs","reportCount",1,"additionalSourceCount",0,{"_67":68,"_69":70},"slug","protein-structure","name","蛋白质结构与设计",{"_72":73,"_11":74},"publicId","f2a67224-f5e2-4511-8730-7f91d30fccfa","FASN调控mRNA翻译机制及癌症治疗新靶点研究","研究成果","蛋白质结构","bioRxiv","https://www.biorxiv.org/content/10.64898/2026.11.05.764384v1?rss=1",{"_80":81,"_82":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":66},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":-5,"_38":-5,"_39":40,"_41":42,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":-5,"_54":34,"_55":56},"id","jlmuacrv18eqigp2vyoxasf4a","title","两位新当选议员承诺捍卫医疗公平","originalTitle","Two incoming lawmakers plan to defend health equity from Trump administration cuts","summary","新当选的民主党议员阿卜杜勒·艾尔-赛义德和贾斯敏·克拉克分别作为流行病学家和微生物学家，承诺在新一届国会中推动医疗公平政策，对抗特朗普政府削减相关拨款和调查多元化、包容性倡议的举措。尽管共和党总统特朗普仍有否决权，但民主党控制两院后可能对相关法案的通过产生积极影响。","reason","source",{"_60":65},"links",{"_56":64},"publishedAt","2026-11-06T21:46:55.000Z","discoveredAt","2026-11-07T12:11:45.603Z","timelineAt","category","clinical","tags",[62,63],"score",48,"selected",false,"channel","news","story","x","readingMode","full","author","Anil Oza","body","outline",[],"relatedStories",[],"topics",[57],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_58":59,"_60":61},"slug","research-policy","name","科研政策","研究成果","政策发布","https://www.statnews.com/2026/11/06/abdul-el-sayed-jasmine-clark-defend-health-equity-from-cuts/?utm_campaign=rss","STAT News",{"_67":68,"_69":-5},"changelogVersion","2026-10-08T22:43","release"]

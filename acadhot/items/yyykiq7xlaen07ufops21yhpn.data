[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","yyykiq7xlaen07ufops21yhpn","title","阿胡斯大学研究团队发现欧洲古代森林并非密林主导","originalTitle","Scientists discover Europe's ancient forests were nothing like we imagined","summary","由阿胡斯大学Szymon Czyzewski博士领衔的研究团队在《Biological Conservation》发表成果，通过整合化石花粉、木炭残留物、食草动物牙齿DNA等多维度证据，重建了欧洲从新生代（约2300万年前）至工业革命前（约1800年前）的植被景观。","reason","source",{"_70":71},"links",{"_57":69},"publishedAt","2026-11-07T09:44:48.000Z","discoveredAt","2026-11-07T12:11:52.426Z","timelineAt","category","life-science","tags",[68],"score",55,"selected",false,"channel","news","story",{"_65":66,"_11":67},"x","readingMode","full","author","body","outline",[],"relatedStories",[64],"topics",[],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","fsj_WER_VQus","reportCount",1,"additionalSourceCount",0,{"_65":66,"_11":67},"publicId","493b2c43-f2ab-48cf-8682-25e9c01009b4","阿胡斯大学研究推翻欧洲古代森林密林主导假说","研究成果","https://www.sciencedaily.com/releases/2026/11/261104012333.htm","name","ScienceDaily 综合",{"_73":74,"_75":-5},"changelogVersion","2026-10-08T22:43","release"]

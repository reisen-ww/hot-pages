[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","zd6vzqo8a98nssjlx90pxsion","title","中世纪特罗德姆公共卫生系统引入导致蛔虫感染人口暴露","originalTitle","The introduction of a medieval public health system exposed the population to roundworm","summary","NTNU大学博物馆研究团队通过考古骨骼分析发现，中世纪特罗德姆的公共卫生系统因木屑短缺导致蛔虫污染食物链。研究显示：13世纪末火山爆发导致木屑供应不足，迫使居民将 latrine 废物混入农田肥料，造成蛔虫在人口中循环传播。","reason","source",{"_70":71},"links",{"_57":69},"publishedAt","2026-11-07T14:30:01.000Z","discoveredAt","2026-11-07T14:34:12.751Z","timelineAt","category","clinical","tags",[68],"score",61,"selected",false,"channel","news","story",{"_65":66,"_11":67},"x","readingMode","full","author","body","outline",[],"relatedStories",[64],"topics",[],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","fzj8HA8JOijE","reportCount",1,"additionalSourceCount",0,{"_65":66,"_11":67},"publicId","e58e08fd-fa3a-4079-8c54-d0e19846f001","中世纪特罗德姆公共卫生系统引致蛔虫感染","研究成果","https://phys.org/news/2026-11-introduction-medieval-health-exposed-population.html","name","Phys.org",{"_73":74,"_75":-5},"changelogVersion","2026-10-08T22:43","release"]

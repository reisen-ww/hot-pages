[{"_1":2,"_3":4},"root",{"_5":76},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","xhxj05fefyf1vaqtn3aqlpdm9","title","一颗死星周围的神秘环状结构揭示了太阳未来的命运","originalTitle","A dead star's mysterious rings reveal what could happen when our Sun dies","summary","天文学家发现一颗死星周围存在两个独立的行星残骸环，其中包含可能幸存的天体，这为理解太阳未来的演变提供了线索。研究使用欧洲南方天文台的甚大望远镜进行，揭示了两个环之间存在明显的间隙，暗示可能有行星体幸存下来并影响环的结构。该发现发表在《自然天文学》上。","reason","source",{"_67":75},"links",{"_57":74},"publishedAt","2026-11-06T22:12:56.000Z","discoveredAt","2026-11-07T12:11:52.898Z","timelineAt","category","quantum-physics","tags",[73,68],"score",40,"selected",false,"channel","news","story",{"_70":71,"_11":72},"x","readingMode","full","author","body","outline",[],"relatedStories",[69],"topics",[64],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","fydXNhrukepc","reportCount",1,"additionalSourceCount",0,{"_65":66,"_67":68},"slug","nature","name","Nature",{"_70":71,"_11":72},"publicId","4d4acca3-1cd4-4e38-86fd-f27dc9bedc43","天文学家发现白矮星残骸环结构 揭示太阳未来演化路径","研究成果","https://www.sciencedaily.com/releases/2026/11/261104012250.htm","ScienceDaily 综合",{"_77":78,"_79":-5},"changelogVersion","2026-10-08T22:43","release"]

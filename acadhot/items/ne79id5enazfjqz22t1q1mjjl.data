[{"_1":2,"_3":4},"root",{"_5":75},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","ne79id5enazfjqz22t1q1mjjl","title","北京大学与中国科学院地理资源所揭示城市化阶段与哮喘发病率的非线性关联","originalTitle","npj Urban Sustainability发文揭示城市化进程如何重塑哮喘发病风险","summary","北京大学与中国科学院地理资源所基于全球149个国家2000-2020年数据，揭示城市化阶段与哮喘发病率及PM₂.₅浓度的非线性关联及峰值错位现象。研究通过构建城市化综合指数与动态轨迹聚类，发现PM₂.₅浓度在快速城市化阶段峰值最高，而哮喘发病率在增速放缓阶段达峰，主要关联因素从空气污染转向气候、生活方式及人口脆弱性。","reason","source",{"_67":74},"links",{"_57":73},"publishedAt","2026-11-07T02:33:54.000Z","discoveredAt","2026-11-07T07:25:51.582Z","timelineAt","category","clinical","tags",[72],"score",56,"selected",false,"channel","news","story",{"_70":71,"_11":12},"x","readingMode","full","author","body","outline",[],"relatedStories",[69],"topics",[64],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","fN6E25aO_kVU","reportCount",1,"additionalSourceCount",0,{"_65":66,"_67":68},"slug","conference-paper","name","顶会与论文接收",{"_70":71,"_11":12},"publicId","7c4daf70-8808-4167-a0c4-0b93ca09d502","论文发表","http://blog.sciencenet.cn/home.php?mod=space&uid=673292&do=blog&id=1560119","科学网博客",{"_76":77,"_78":-5},"changelogVersion","2026-10-08T22:43","release"]

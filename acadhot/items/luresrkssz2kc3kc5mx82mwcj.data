[{"_1":2,"_3":4},"root",{"_5":78},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","luresrkssz2kc3kc5mx82mwcj","title","表皮朗格汉斯细胞通过神经免疫调节作用调控痛觉与瘙痒（bioRxiv:10.64898/2026.11.06.756111v1）","originalTitle","Epidermal Langerhans Cells Act as Neuroimmune Regulators of Pain and Itch","summary","本研究发现表皮朗格汉斯细胞通过分泌semaphorin 7A增强瘙痒信号传导。转录组分析显示LCs与非肽能感觉神经元存在特异性关联，LCs激活可增强热、机械和瘙痒刺激引发的神经元反应及行为学表现。","reason","论文提出了表皮朗格汉斯细胞通过分泌semaphorin 7A增强瘙痒信号传导的机制，为神经免疫疾病治疗提供新靶点","source",{"_69":77},"links",{"_59":76},"publishedAt","2026-11-07T00:00:00.000Z","discoveredAt","2026-11-07T15:22:13.289Z","timelineAt","category","neuroscience","tags",[75,70],"score",84,"selected",true,"channel","news","story",{"_72":73,"_11":74},"x","readingMode","full","author"," Sakai, K., Ishida, H., Pavlenko, D., Suehiro, M., Oshea, T., Dorning, J., Sanders, K., Sanchez, C., Lopez, A., Talamas, S., Boulina, M., Griswold, A. J., Akiyama, T. ","body","outline",[],"relatedStories",[71],"topics",[66],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fwErFrc9KsP0","reportCount",1,"additionalSourceCount",0,{"_67":68,"_69":70},"slug","nature","name","Nature",{"_72":73,"_11":74},"publicId","496e5529-b8cc-4694-b8d0-420507c12bdc","表皮朗格汉斯细胞通过神经免疫调节调控痛觉与瘙痒信号传导","研究成果","https://www.biorxiv.org/content/10.64898/2026.11.06.756111v1?rss=1","bioRxiv",{"_79":80,"_81":-5},"changelogVersion","2026-10-08T22:43","release"]

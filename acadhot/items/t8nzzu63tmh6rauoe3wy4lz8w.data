[{"_1":2,"_3":4},"root",{"_5":76},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":-5,"_14":15,"_16":-5,"_17":18,"_19":20,"_21":22,"_23":24,"_25":24,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":40,"_41":-5,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":33,"_50":51,"_52":53,"_54":33,"_55":56},"id","t8nzzu63tmh6rauoe3wy4lz8w","title","为什么正确的科学理论离不开严谨的数学逻辑","originalTitle","summary","本文指出，现代科学界存在敌视数学逻辑的现象，根源在于认知失败后的心理防御。正确的科学理论依赖严格的数学推导，而错误理论可分为公式正确理解错误和公式本身错误两类。刘跃教授通过数学与物理原理的双重验证，揭示了“阻抗匹配理论”的错误，强调了数学语言在排除自然语言歧义中的重要性。","reason","source",{"_66":75},"links",{"_56":74},"publishedAt","2026-11-07T04:39:09.000Z","discoveredAt","2026-11-07T11:25:34.953Z","timelineAt","category","neuroscience","tags",[72,73],"score",31,"selected",false,"channel","news","story",{"_69":70,"_11":71},"x","readingMode","full","author","body","outline",[],"relatedStories",[68],"topics",[63],"indexable","markdownAvailable",true,"group",{"_57":58,"_59":60,"_61":62},"hasTranslation","bodyLanguage","original","factId","fsjWwodYceTI","reportCount",1,"additionalSourceCount",0,{"_64":65,"_66":67},"slug","conference-paper","name","顶会与论文接收",{"_69":70,"_11":71},"publicId","6de25329-6be9-472a-95a2-7c5eecac587a","刘跃教授提出错误理论两分法并批判阻抗匹配理论","论文发表","研究成果","http://blog.sciencenet.cn/home.php?mod=space&uid=3589443&do=blog&id=1560134","科学网博客",{"_77":78,"_79":-5},"changelogVersion","2026-10-08T22:43","release"]

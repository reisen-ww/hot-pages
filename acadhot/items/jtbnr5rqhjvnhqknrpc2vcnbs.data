[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","jtbnr5rqhjvnhqknrpc2vcnbs","title","柏林自由大学团队在 Nature Communications 发表研究：未来极端热浪将远超近年事件","originalTitle","Future warming events will outdo the extreme heat waves of the recent past, new study finds","summary","柏林自由大学团队在《Nature Communications》发表研究，指出未来极端热浪将比近年更持久、影响更广、更严重。研究分析了2010-2023年间22次全球极端热浪事件，对比了CMIP5和CMIP6气候模型，发现到2099年多数地区每年至少发生一次极端热浪，欧洲未来热浪可能持续数月且覆盖大范围。论文强调仅靠减排不足以应对挑战，需结合具体适应措施。","reason","source",{"_70":71},"links",{"_57":69},"publishedAt","2026-11-06T21:00:01.000Z","discoveredAt","2026-11-07T12:11:47.614Z","timelineAt","category","clinical","tags",[68],"score",58,"selected",false,"channel","news","story",{"_65":66,"_11":67},"x","readingMode","full","author","body","outline",[],"relatedStories",[64],"topics",[],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","fgaPOiIh7fgw","reportCount",1,"additionalSourceCount",0,{"_65":66,"_11":67},"publicId","0950c259-5512-4873-bca9-13a1720c0bf3","柏林自由大学研究预测未来极端热浪更持久更严重","研究成果","https://phys.org/news/2026-11-future-events-outdo-extreme.html","name","Phys.org",{"_73":74,"_75":-5},"changelogVersion","2026-10-08T22:43","release"]

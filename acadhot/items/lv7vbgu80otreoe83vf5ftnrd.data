[{"_1":2,"_3":4},"root",{"_5":65},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":-5,"_38":-5,"_39":40,"_41":42,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":-5,"_54":34,"_55":56},"id","lv7vbgu80otreoe83vf5ftnrd","title","REDUCE试验与OPTIMAL系列研究：卒中及糖尿病患者血压管理目标对比分析","originalTitle","Lowering blood pressure after stroke or with diabetes poses challenges, in research and practice","summary","REDUCE试验显示，卒中后早期使用螺内酯可显著降低3个月后血压至<130/80 mmHg（n=324），而OPTIMAL-DIABETES研究（n=4,736）未发现糖尿病患者的血压目标<120 mmHg能减少主要心血管事件。","reason","source",{"_60":64},"links",{"_56":63},"publishedAt","2026-11-07T21:39:02.000Z","discoveredAt","2026-11-07T21:46:16.050Z","timelineAt","category","clinical","tags",[62,61],"score",63,"selected",false,"channel","news","story","x","readingMode","full","author","Elizabeth Cooney","body","outline",[],"relatedStories",[],"topics",[57],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_58":59,"_60":61},"slug","clinical-trial","name","临床试验","研究成果","https://www.statnews.com/2026/11/07/new-studies-on-blood-pressure-management-aha-conference-news/?utm_campaign=rss","STAT News",{"_66":67,"_68":-5},"changelogVersion","2026-10-08T22:43","release"]

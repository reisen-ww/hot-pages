[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","bskzfcmbjpd1auyks24isj0dm","title","米帕明靶向淀粉样蛋白β并延长阿尔茨海默病患者的生存期","originalTitle","Imipramine binds to amyloid-β and extends the survival of Alzheimer's disease patients","summary","米帕明通过直接结合淀粉样蛋白β抑制其与载脂蛋白E的相互作用，并显著降低阿尔茨海默病患者的全因死亡率（10年随访数据）。动物实验显示其增强空间记忆和海马区神经发生，机制研究通过核磁共振光谱和类器官模型验证。论文建议扩大针对APOE4携带者的临床试验。","reason","论文提供了米帕明抑制淀粉样蛋白β与载脂蛋白E结合的分子机制证据，并基于10年随访数据证实其显著降低阿尔茨海默病患者的全因死亡率，为临床用药选择提供新依据。","source",{"_70":81},"links",{"_59":80},"publishedAt","2026-11-03T00:00:00.000Z","discoveredAt","2026-11-03T19:24:40.937Z","timelineAt","category","clinical","tags",[78,79,73],"score",76,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author"," Johnson, N. R., Beham, J., Sillau, S., Read, J., Wang, A. C.-J., Ahmed, M. M., Quang, D., Stephenson, D., Henen, M., Vogeli, B., Chial, H. J., Welty, R., Vugmeyster, L., Potter, H. ","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fat5wl8LBf6w","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","alzheimers","name","阿尔茨海默与神经退行","openai","OpenAI",{"_75":76,"_11":77},"publicId","0a4e4b67-5c14-4169-a654-18ce40fe646b","米帕明抑制淀粉样蛋白β与载脂蛋白E相互作用延长阿尔茨海默病生存期","研究成果","阿尔茨海默","https://www.biorxiv.org/content/10.64898/2026.10.28.762584v1?rss=1","bioRxiv",{"_83":84,"_85":-5},"changelogVersion","2026-10-08T22:43","release"]

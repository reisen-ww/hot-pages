[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","unnt2dkob5h1uuft8ztufkyks","title","Rubin 望远镜发现银河系两颗新伴星","originalTitle","Rubin Observatory discovers two hidden companions of the Milky Way. Hundreds more may be waiting","summary","Rubin 望远镜在初步观测中发现了银河系的两颗新伴星，分别是 Aquarius IV 和 Rubin-GC1。这两颗伴星位于银河系的遥远边缘和复杂尘埃区域，表明望远镜具有发现极其微弱天体的能力。研究团队认为，随着望远镜继续收集更多数据，有望发现数百颗新的伴星，这将有助于测试银河系形成模型和探索暗物质。","reason","source",{"_70":71},"links",{"_57":69},"publishedAt","2026-11-07T09:12:43.000Z","discoveredAt","2026-11-07T12:11:52.842Z","timelineAt","category","quantum-physics","tags",[68],"score",36,"selected",false,"channel","news","story",{"_65":66,"_11":67},"x","readingMode","full","author","body","outline",[],"relatedStories",[64],"topics",[],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","f_o0zWpMQ80o","reportCount",2,"additionalSourceCount",1,{"_65":66,"_11":67},"publicId","574440e4-7904-442a-aa7f-62044f223bd9","Rubin望远镜发现银河系两颗新伴星","研究成果","https://www.sciencedaily.com/releases/2026/11/261104012252.htm","name","ScienceDaily 综合",{"_73":74,"_75":-5},"changelogVersion","2026-10-08T22:43","release"]

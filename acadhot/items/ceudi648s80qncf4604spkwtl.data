[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","ceudi648s80qncf4604spkwtl","title","基于单次3D T2-FLAIR MRI的影像组学评估方法在多发性硬化症时间扩散研究中的应用","originalTitle","Assessment of Dissemination in Time in Multiple Sclerosis Using a Single 3D T2-FLAIR magnetic resonance imaging Radiomic Signature","summary","某研究团队在medRxiv发表多发性硬化症时间扩散的单次MRI影像组学评估方法，通过独立发现队列（N=55）和测试队列（N=55）验证了支持向量机分类器对长期稳定（LS-E）和近期新发（R-I）病灶的区分性能（AUC 0.78，准确率66%-73%）。探索性分析显示10%的基线MRI样本在首次临床脱髓鞘事件时已呈现LS-E病灶的影像组学特征。","reason","该研究提出无需对比增强的MRI影像组学方法，为多发性硬化症病程评估提供新思路。","source",{"_70":81},"links",{"_59":80},"publishedAt","2026-11-03T00:00:00.000Z","discoveredAt","2026-11-03T22:33:23.778Z","timelineAt","category","clinical","tags",[78,79,73],"score",68,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author"," GUZMAN, E. G., Casajuana-Larque, A., Alberich, M., Bollo, L., Mongay-Ochoa, N., Martinez-Heras, E., Vidal-Jordana, A., Montalban, X., Tintore, M., Rovira, A., Sastre-Garriga, J., Pareto, D. ","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","f0sDxKaXXPK4","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","alzheimers","name","阿尔茨海默与神经退行","deepmind","DeepMind",{"_75":76,"_11":77},"publicId","ccf4abe9-0900-4fb0-a9a2-f77a9914053c","单次3D T2-FLAIR MRI影像组学评估多发性硬化症时间扩散","研究成果","阿尔茨海默","https://www.medrxiv.org/content/10.64898/2026.10.29.26364762v1?rss=1","medRxiv",{"_83":84,"_85":-5},"changelogVersion","2026-10-08T22:43","release"]

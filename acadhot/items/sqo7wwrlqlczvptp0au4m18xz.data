[{"_1":2,"_3":4},"root",{"_5":73},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","sqo7wwrlqlczvptp0au4m18xz","title","乌尔姆堡大学团队在《Nature Chemistry》发表60年未解氧硼烷合成难题的突破性成果","originalTitle","Scientists accidentally solve a chemistry mystery that lasted 60 years","summary","德国乌尔姆堡大学团队在《Nature Chemistry》发表突破性成果，首次成功合成并分离出稳定存在的氧硼烷分子。博士研究生Lukas Lubczyk和Christian Markl在研究二硼累积烯与酮类反应时意外发现，该反应能生成具有特殊结构的氧硼烷固体。","reason","该成果为后续研究其他不稳定元素化合物的合成提供了新思路","source",{"_71":72},"links",{"_58":70},"publishedAt","2026-11-06T21:28:04.000Z","discoveredAt","2026-11-07T12:11:53.439Z","timelineAt","category","materials-energy","tags",[69],"score",78,"selected",true,"channel","news","story",{"_66":67,"_11":68},"x","readingMode","full","author","body","outline",[],"relatedStories",[65],"topics",[],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","fS9lQQx4Bzpo","reportCount",2,"additionalSourceCount",1,{"_66":67,"_11":68},"publicId","0f538dbd-5aec-447f-88bd-a681fabb3beb","Würzburg大学团队首次成功分离稳定硼氧三键化合物，解决60年难题","研究成果","https://www.sciencedaily.com/releases/2026/11/261103003205.htm","name","ScienceDaily 综合",{"_74":75,"_76":-5},"changelogVersion","2026-10-08T22:43","release"]

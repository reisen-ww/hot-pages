[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","ecu4xrvpumk12iesk5fm1bmrr","title","某团队在 bioRxiv 发表BNCT抑制B16黑色素瘤的免疫原性细胞死亡研究","originalTitle","BNCT Triggers Immunogenic Cell Death in B16 Melanoma Without Accompanying T-Cell Infiltration--Implications for Combination Immunotherapy","summary","某团队在B16黑色素瘤小鼠模型中测试BNCT，发现其显著抑制肿瘤生长（TGI ~88.9%, p<0.001）并延长生存，同时诱导免疫原性细胞死亡（ICD）和Th1型免疫反应（IFN-gamma/TNF-alpha升高，IL-10降低），但未观察到局部CD8+ T细胞浸润和granzyme B表达增加。","reason","论文提供了BNCT在抑制肿瘤生长和诱导免疫原性细胞死亡方面的数据，但未观察到局部效应T细胞浸润，为联合疗法提供新思路。","source",{"_69":78},"links",{"_59":77},"publishedAt","2026-11-05T00:00:00.000Z","discoveredAt","2026-11-06T02:49:24.342Z","timelineAt","category","drug-therapy","tags",[75,76],"score",84,"selected",true,"channel","news","story",{"_72":73,"_11":74},"x","readingMode","full","author"," Quan, R., Huang, H., Zhang, L., Zhang, C., Chang, S., Wu, M., Zhang, S., Zhang, L., Dai, Z., Gu, L. ","body","outline",[],"relatedStories",[71],"topics",[66],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","ftS2fpN1R05A","reportCount",1,"additionalSourceCount",0,{"_67":68,"_69":70},"slug","cancer-immunotherapy","name","癌症免疫治疗",{"_72":73,"_11":74},"publicId","4971c3db-ed82-4b89-800e-6985d59a6c05","BNCT抑制B16小鼠肿瘤并诱导免疫原性细胞死亡（预印本研究）","研究成果","癌症免疫","https://www.biorxiv.org/content/10.64898/2026.11.04.764456v1?rss=1","bioRxiv",{"_80":81,"_82":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","f49053q5y57aqt23trodvdkvw","title","宾夕法尼亚大学团队在 Nature Physics 发表量子 skyrmions 研究成果","originalTitle","Quantum skyrmions outlast entanglement, hinting at more resilient networks","summary","宾夕法尼亚大学研究团队在 Nature Physics 发表论文，首次实现量子 skyrmions 拓扑特性在光子纠缠断裂后的持久性。实验通过定制芯片生成纠缠光子对，并在单光子中编码拓扑模式。研究显示即使光子纠缠被破坏，拓扑特性仍能保持，这颠覆了此前认为拓扑结构依赖纠缠的理论。论文提出量子关联与拓扑特性的新关系，为量子网络抗干扰设计提供新思路。","reason","论文提出了利用拓扑特性增强量子网络稳定性的新方法，为量子计算硬件设计提供了可迁移的解决方案。","source",{"_68":76},"links",{"_58":75},"publishedAt","2026-10-30T15:40:01.000Z","discoveredAt","2026-10-30T15:54:09.460Z","timelineAt","category","quantum-physics","tags",[74,69],"score",79,"selected",true,"channel","news","story",{"_71":72,"_11":73},"x","readingMode","full","author","body","outline",[],"relatedStories",[70],"topics",[65],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","fXedlP0jtTxs","reportCount",1,"additionalSourceCount",0,{"_66":67,"_68":69},"slug","quantum-computing","name","量子计算",{"_71":72,"_11":73},"publicId","c56293b6-3a9a-4e86-b665-fb0ae5244933","宾夕法尼亚大学团队实现光子量子态拓扑属性跨体转移","研究成果","https://phys.org/news/2026-10-quantum-skyrmions-outlast-entanglement-hinting.html","Phys.org",{"_78":79,"_80":-5},"changelogVersion","2026-10-08T22:43","release"]

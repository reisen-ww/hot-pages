[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","b2bu0evyfs7lbva8zhckjpy6z","title","Guo 等在 bioRxiv 发表 SDHB 缺陷癌症的 ABCB1 表达抑制与治疗敏感性研究","originalTitle","SDHB deficiency silences ABCB1 expression and confers therapeutic vulnerability across multiple cancer types","summary","该研究通过共培养人肾癌细胞筛选发现 SDHB 缺陷癌症对 ABCB1 载体底物药物敏感，并通过临床数据分析证实携带 SDHB 缺陷的副神经节瘤患者接受长春新碱类化疗后无进展生存期显著延长。机制研究揭示 KDM4A 去甲基酶下调是 ABCB1 表达抑制的关键，且 TCGA 数据显示 KDM4A-ABCB1 表达相关性在 SDHB 缺陷癌症中普遍存在。","reason","该研究提供了将 ABCB1 抑制剂用于 SDHB 缺陷癌症的机制依据，并验证了 KDM4A 去甲基酶在其中的调控作用","source",{"_70":81},"links",{"_59":80},"publishedAt","2026-11-03T00:00:00.000Z","discoveredAt","2026-11-03T18:52:36.892Z","timelineAt","category","drug-therapy","tags",[78,79,73],"score",80,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author"," Guo, Q., Zhen, A., Howitt, B. E., Annes, J. P. ","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","f3U6TyWVbBIo","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","cancer-immunotherapy","name","癌症免疫治疗","nih","NIH",{"_75":76,"_11":77},"publicId","4845954a-94b6-4f3e-8176-9244ed2e5c72","SDHB缺陷通过抑制ABCB1增强癌症对长春新碱类药物的敏感性","研究成果","癌症免疫","https://www.biorxiv.org/content/10.64898/2026.10.29.761968v1?rss=1","bioRxiv",{"_83":84,"_85":-5},"changelogVersion","2026-10-08T22:43","release"]

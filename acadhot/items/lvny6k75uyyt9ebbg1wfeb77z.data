[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","lvny6k75uyyt9ebbg1wfeb77z","title","阿尔伯塔大学研究：轮作中单作物酸化治理已不足","originalTitle","Why treating soil acidity crop by crop is no longer enough for prairie farmers","summary","阿尔伯塔大学研究团队在《加拿大植物科学杂志》发表论文，指出轮作中单作物酸化治理已不足，需考虑长期作物间连锁反应。研究基于1980-2020年数据，发现石灰处理苜蓿可提升后续谷物氮吸收，但苜蓿自身生长会加剧酸化，提示需综合管理策略。","reason","source",{"_70":71},"links",{"_57":69},"publishedAt","2026-11-07T13:00:01.000Z","discoveredAt","2026-11-07T13:15:09.088Z","timelineAt","category","materials-energy","tags",[68],"score",57,"selected",false,"channel","news","story",{"_65":66,"_11":67},"x","readingMode","full","author","body","outline",[],"relatedStories",[64],"topics",[],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","fodn7j-OQe3g","reportCount",1,"additionalSourceCount",0,{"_65":66,"_11":67},"publicId","2ad0226b-9a0b-4f8a-bb40-53a14f515b12","阿尔伯塔大学研究：轮作周期整体管理土壤酸性更有效","研究成果","https://phys.org/news/2026-11-soil-acidity-crop-longer-prairie.html","name","Phys.org",{"_73":74,"_75":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","z2vo2kzl364otcgml1lt4wot2","title","美国成年人长期研究：每日饮用2-3杯咖啡显著降低痴呆风险","originalTitle","Drinking 2–3 cups of coffee a day linked to dramatically lower dementia risk","summary","美国成年人长期研究显示，每日饮用2-3杯咖啡可使痴呆年发病率降至141例/10万人，显著低于不常饮者的330例/10万人。研究还发现，每日1-2杯茶也有类似保护作用，但脱咖啡因咖啡无效，提示咖啡因可能为关键因素。该研究跟踪最长43年，为探讨日常饮品与脑健康关联提供长期数据支持。","reason","source",{"_67":76},"links",{"_57":75},"publishedAt","2026-11-07T10:16:19.000Z","discoveredAt","2026-11-07T12:11:40.250Z","timelineAt","category","clinical","tags",[73,74],"score",70,"selected",false,"channel","news","story",{"_70":71,"_11":72},"x","readingMode","full","author","body","outline",[],"relatedStories",[69],"topics",[64],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","fI4lnFF6aDKg","reportCount",1,"additionalSourceCount",0,{"_65":66,"_67":68},"slug","alzheimers","name","阿尔茨海默与神经退行",{"_70":71,"_11":72},"publicId","56bc7281-d17f-4316-a41b-b15a2624438d","美国长期研究：每日2-3杯含咖啡因咖啡显著降低痴呆风险","研究成果","阿尔茨海默","https://www.sciencedaily.com/releases/2026/11/261105224550.htm","ScienceDaily 健康医学",{"_78":79,"_80":-5},"changelogVersion","2026-10-08T22:43","release"]

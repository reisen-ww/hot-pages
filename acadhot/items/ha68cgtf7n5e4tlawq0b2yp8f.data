[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","ha68cgtf7n5e4tlawq0b2yp8f","title","Wang 等在 bioRxiv 发表基于 DNA 序列预测单分子染色质分布的研究","originalTitle","Predicting single-molecule chromatin distribution from DNA sequence","summary","Wang 等开发 S2d 框架，直接从 DNA 序列建模单分子染色质状态的完整概率分布。通过训练 Mola 模型，揭示 ZNF146 等转录因子与核小体的新型互作模式，发现 YY1 是启动子 +1 位核小体定位最强调控因子。","reason","该框架可迁移用于预测基因变体的单分子效应及染色质动态轨迹生成","source",{"_70":81},"links",{"_59":80},"publishedAt","2026-11-04T00:00:00.000Z","discoveredAt","2026-11-04T16:44:11.387Z","timelineAt","category","ai-frontier","tags",[78,79,73],"score",72,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author"," Wang, R., Jin, J., Pott, S., Zhou, J. ","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fxlHDWNrZhTQ","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","conference-paper","name","顶会与论文接收","openai","OpenAI",{"_75":76,"_11":77},"publicId","28c61383-bf66-46e5-8d57-8761eae7f941","Wang团队开发S2d框架预测染色质分布","论文发表","大模型","https://www.biorxiv.org/content/10.64898/2026.10.29.762992v1?rss=1","bioRxiv",{"_83":84,"_85":-5},"changelogVersion","2026-10-08T22:43","release"]

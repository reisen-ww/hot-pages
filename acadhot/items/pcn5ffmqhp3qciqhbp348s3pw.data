[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","pcn5ffmqhp3qciqhbp348s3pw","title","科学家在加拿大发现未知北大西洋露脊鲸幼崽","originalTitle","Scientists discovered an unknown baby right whale off Canada. They say it's a cause for joy","summary","科学家在加拿大安大略省阿蒂斯岛附近拍摄到一只未被识别的北大西洋露脊鲸幼崽，这是自2009年以来最活跃的繁殖季，共记录到24只幼崽。这种鲸类全球仅存约380头，数量自2010年以来持续下降。此次发现令研究人员感到惊喜，因为通常他们不会错过任何幼崽。","reason","source",{"_70":71},"links",{"_57":69},"publishedAt","2026-11-07T11:04:43.000Z","discoveredAt","2026-11-07T12:11:44.754Z","timelineAt","category","clinical","tags",[68],"score",43,"selected",false,"channel","news","story",{"_65":66,"_11":67},"x","readingMode","full","author","body","outline",[],"relatedStories",[64],"topics",[],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","f-BI9YjsluWk","reportCount",1,"additionalSourceCount",0,{"_65":66,"_11":67},"publicId","34381c9f-8233-46ec-bc18-be80ffa53bef","加拿大科学家发现未知北大西洋露脊鲸幼崽，繁殖季创2009年以来新高","研究成果","https://phys.org/news/2026-11-scientists-unknown-baby-whale-canada.html","name","Phys.org",{"_73":74,"_75":-5},"changelogVersion","2026-10-08T22:43","release"]

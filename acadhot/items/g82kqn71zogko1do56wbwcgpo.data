[{"_1":2,"_3":4},"root",{"_5":74},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","g82kqn71zogko1do56wbwcgpo","title","某研究团队在 bioRxiv 发表磁粒体基因簇助力细菌在氧化环境中生存的论文","originalTitle","Magnetic organelle gene clusters enable bacterial growth and ATP homeostasis under oxidizing conditions","summary","某研究团队在 bioRxiv 发表论文，揭示磁粒体基因簇通过形成纳米磁石帮助细菌抵抗过氧化氢毒性。实验证实该基因簇编码的磁粒体在氧化应激条件下维持细菌ATP稳态，为早期地球氧化机制提供了新证据。论文提出磁导航系统可能早于地球氧气化而存在，并开发了基于该系统的氧化环境时间分辨率分析工具。","reason","论文通过解析磁粒体细菌的基因簇功能，首次揭示磁纳米颗粒在氧化应激条件下维持细菌能量代谢的机制，为研究地球早期氧化过程提供了可验证的分子证据链。","source",{"_72":73},"links",{"_59":71},"publishedAt","2026-11-07T00:00:00.000Z","discoveredAt","2026-11-08T03:20:34.058Z","timelineAt","category","life-science","tags",[70],"score",64,"selected",true,"channel","news","story",{"_67":68,"_11":69},"x","readingMode","full","author"," Kojadinovic-Sirinelli, M., Garry, M., Wan, J., Dumont, A., Egli, R., Carlut, J., Modolo, L., Chevrier, D. M., Marcano, L., Choueikani, F., Gatel, C., Andersen, I. M., Scoppola, E., Li, C., Brutesco, C., Nonnon, M., Gachon, E., Yvert, G., Piazza, A., Faivre, D., Komeili, A., Amor, M. ","body","outline",[],"relatedStories",[66],"topics",[],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fEXJfsrKN-GU","reportCount",1,"additionalSourceCount",0,{"_67":68,"_11":69},"publicId","bbc2465c-b13f-42b6-b775-a960568d5dd0","某研究团队揭示磁性颗粒基因簇助力细菌在氧化环境中的ATP稳态维持","研究成果","https://www.biorxiv.org/content/10.64898/2026.11.06.764584v1?rss=1","name","bioRxiv",{"_75":76,"_77":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","bbnb4f3bhy2b2pnjm5w0rkyjh","title","Reed 等在 medRxiv 发表算法设计影响医疗公平性的模拟研究","originalTitle","Algorithmic design choices as determinants of health equity: a causal simulation study of healthcare resource allocation","summary","Reed 团队使用 NIH All of Us 研究计划 2017-2019 年的 201216 名成人电子健康记录数据，通过对比逻辑回归、随机森林和 XGBoost 三种算法在三个设计变量（选择阈值、特征集、训练目标）下的模拟结果，发现以健康状态为训练目标的算法使黑人-白人公平差距（EOD）从 -0.148 降至 0.008。","reason","论文通过模拟研究揭示了算法设计中的三个关键变量对医疗资源分配公平性的影响，其中训练目标的选择对缩小种族差异效果最显著。","source",{"_70":81},"links",{"_59":80},"publishedAt","2026-11-01T00:00:00.000Z","discoveredAt","2026-11-02T02:47:14.493Z","timelineAt","category","ai-frontier","tags",[78,79,73],"score",71,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author"," Reed, C., Espinoza, M. E. ","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fxJLLKRWBCZU","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","conference-paper","name","顶会与论文接收","nih","NIH",{"_75":76,"_11":77},"publicId","bb21d3e4-3ff8-4d0b-a994-6f771e042366","Reed团队模拟研究揭示算法设计对健康公平的影响","论文发表","研究成果","https://www.medrxiv.org/content/10.64898/2026.10.30.26366732v1?rss=1","medRxiv",{"_83":84,"_85":-5},"changelogVersion","2026-10-08T22:43","release"]

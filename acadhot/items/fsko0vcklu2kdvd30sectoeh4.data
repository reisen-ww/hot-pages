[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","fsko0vcklu2kdvd30sectoeh4","title","某研究团队在预印本平台medRxiv发表阿尔茨海默病早期嗅觉功能与tau病理关联的多队列研究","originalTitle","Olfactory Function in Preclinical Alzheimer's Disease: A Multi-Cohort Study","summary","研究纳入257名认知正常老年人（PREVENT-AD队列217人，UCLouvain队列40人），其中76人为tau阳性（CN A+），181人为tau阴性（CN A-）。","reason","论文提供了嗅觉识别得分与阿尔茨海默病早期tau病理负担及认知衰退预后的关联数据，为早期干预提供新指标。","source",{"_69":78},"links",{"_59":77},"publishedAt","2026-11-04T00:00:00.000Z","discoveredAt","2026-11-05T01:47:20.476Z","timelineAt","category","clinical","tags",[75,76],"score",61,"selected",true,"channel","news","story",{"_72":73,"_11":74},"x","readingMode","full","author"," Jobin, B., Salman, Y., Bouchoucha, K., Huyghe, L., Quenon, L., Colmant, L., Gerard, T., Malotaux, V., Dricot, L., Dulieu, P., Ivanoiu, A., Lhommel, R., Decottignies, A., Hanseeuw, B., Huart, C., The PREVENT-AD Research Group ","body","outline",[],"relatedStories",[71],"topics",[66],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fw1UIHbKEUgU","reportCount",1,"additionalSourceCount",0,{"_67":68,"_69":70},"slug","alzheimers","name","阿尔茨海默与神经退行",{"_72":73,"_11":74},"publicId","7dae4528-d801-4177-ad43-85a2c8232602","阿尔茨海默病早期嗅觉功能异常与tau病理关联研究发布","研究成果","阿尔茨海默","https://www.medrxiv.org/content/10.64898/2026.11.03.26367202v1?rss=1","medRxiv",{"_80":81,"_82":-5},"changelogVersion","2026-10-08T22:43","release"]

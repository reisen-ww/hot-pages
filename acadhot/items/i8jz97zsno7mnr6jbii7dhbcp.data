[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","i8jz97zsno7mnr6jbii7dhbcp","title","SLAC研究团队在 Science 发表证实交替磁性的存在","originalTitle","SLAC scientists find conclusive proof of a mysterious third type of magnetism","summary","SLAC研究团队在 Science 发表研究，通过X射线实验证实锰碲化物呈现交替磁性特征（up-down-up-down排列但晶体结构旋转对称）。该材料在零净磁化（如抗铁磁体）基础上具备自旋极化电流（如铁磁体），解决了传统磁体易受外部磁场干扰和难以读取信息的问题。","reason","论文通过X射线实验证实了交替磁性的存在，为量子计算和低能耗电子设备提供了新材料基础。","source",{"_68":76},"links",{"_58":75},"publishedAt","2026-11-04T10:43:44.000Z","discoveredAt","2026-11-04T14:18:29.316Z","timelineAt","category","quantum-physics","tags",[74,69],"score",84,"selected",true,"channel","news","story",{"_71":72,"_11":73},"x","readingMode","full","author","body","outline",[],"relatedStories",[70],"topics",[65],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","f5T89A9ezALI","reportCount",2,"additionalSourceCount",1,{"_66":67,"_68":69},"slug","quantum-computing","name","量子计算",{"_71":72,"_11":73},"publicId","4c2de1da-ad8f-40a7-99df-ce2e2bdf901c","SLAC团队通过X射线实验首次证实锰碲化物具有交替磁性特征","研究成果","https://www.sciencedaily.com/releases/2026/11/261104012256.htm","ScienceDaily 综合",{"_78":79,"_80":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":73},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","h4g1ssjcsmdsxly85ukge0ebh","title","Mishra等在Science提出破解气候债务循环的四项政策改革","originalTitle","Disasters and debt. Escaping the 'climate-debt doom loop'","summary","Mishra等在Science提出破解气候债务循环的四项政策改革：1）IMF债务评估模型需纳入气候准备资金（2022年已启动）；2）扩大IMF气候韧性信托规模（2026年9月新工具获批）；3）在贷款协议中写入灾难暂停条款；4）建立基于社区脆弱性差异的保险定价机制。","reason","研究揭示IMF 2022年已开始将气候韧性纳入债务评估模型，2025年最新指引要求将防灾投入作为贷款审批条件，并指出2026年9月世行IMF联合工具已为低收入国预留防灾资金空间。建议将债务暂停条款写入贷款协议、建立差异化保险定价机制等四项改革方案。","source",{"_71":72},"links",{"_58":70},"publishedAt","2026-11-07T02:20:02.000Z","discoveredAt","2026-11-07T12:11:45.562Z","timelineAt","category","neuroscience","tags",[69],"score",84,"selected",true,"channel","news","story",{"_66":67,"_11":68},"x","readingMode","full","author","body","outline",[],"relatedStories",[65],"topics",[],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","fu3rh_B9ACuI","reportCount",1,"additionalSourceCount",0,{"_66":67,"_11":68},"publicId","e63a7fed-ad42-4f80-a5be-9905e65dcc58","Mishra等在Science提出四项政策解决气候债务困境循环","研究成果","https://phys.org/news/2026-11-disasters-debt-climate-doom-loop.html","name","Phys.org",{"_74":75,"_76":-5},"changelogVersion","2026-10-08T22:43","release"]

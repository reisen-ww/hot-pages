[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","uxwrr3q87i8ph4rkkusx8fics","title","William Grooms 在新墨西哥州北部首次捕获加拿大猞猁影像证据","originalTitle","Student finds proof of rare wild cat in northern New Mexico","summary","新墨西哥州立大学学生 William Grooms 在北部新墨西哥州首次捕获加拿大猞猁影像证据，经专家确认后发表。该发现对评估森林结构变化与濒危物种栖息地关联性具有重要参考价值，研究团队计划通过两年期野外监测（2024-2025）完善数据，为落基山脉地区森林管理提供科学依据。","reason","source",{"_70":71},"links",{"_57":69},"publishedAt","2026-11-07T22:00:05.000Z","discoveredAt","2026-11-07T22:16:31.332Z","timelineAt","category","clinical","tags",[68],"score",66,"selected",false,"channel","news","story",{"_65":66,"_11":67},"x","readingMode","full","author","body","outline",[],"relatedStories",[64],"topics",[],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","fKG_fjuJNqUc","reportCount",1,"additionalSourceCount",0,{"_65":66,"_11":67},"publicId","1cc3a61f-86d1-4ef7-a368-a6698e659d44","新墨西哥州立大学学生首次捕获加拿大猞猁影像证据","研究成果","https://phys.org/news/2026-11-student-proof-rare-wild-cat.html","name","Phys.org",{"_73":74,"_75":-5},"changelogVersion","2026-10-08T22:43","release"]

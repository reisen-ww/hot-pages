[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","uplfclbojd67kvpdrb1giy29z","title","南极望远镜解开宇宙微波背景辐射模式","originalTitle","Untangling the patterns of the cosmic microwave background to better understand the early universe","summary","南极的南极望远镜和BICEP项目利用数据研究宇宙早期的B模式信号，以更好地理解宇宙的起源。宇宙在大爆炸后瞬间经历了快速膨胀，形成了几乎完全平坦的空间，留下了微波背景辐射。这些辐射在今天仍存在，但由于其波长被拉长至微波和无线电波，肉眼无法直接观测。通过分析这些信号，科学家们试图揭示宇宙早期的物理过程。","reason","source",{"_70":71},"links",{"_57":69},"publishedAt","2026-11-07T00:20:01.000Z","discoveredAt","2026-11-07T12:11:45.837Z","timelineAt","category","quantum-physics","tags",[68],"score",47,"selected",false,"channel","news","story",{"_65":66,"_11":67},"x","readingMode","full","author","body","outline",[],"relatedStories",[64],"topics",[],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","fRbGjNuMDE2s","reportCount",1,"additionalSourceCount",0,{"_65":66,"_11":67},"publicId","8ca5a545-71e3-47fb-a44d-d42139860dd7","南极望远镜研究证实宇宙极早期暴胀理论","研究成果","https://phys.org/news/2026-11-untangling-patterns-cosmic-microwave-background.html","name","Phys.org",{"_73":74,"_75":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","hih7319h6vnkbiosdab6rt5jz","title","某研究团队在 medRxiv 发表多映射cfDNA片段组学在早期乳腺癌中的诊断价值评估","originalTitle","Diagnostic Value in Discarded Reads: Re-evaluating Multi-Mapping cfDNA Fragmentomics and GC Bias in Early-Stage Cancer.","summary","某研究团队发现多映射cfDNA片段在早期乳腺癌患者与匹配健康对照中显著差异（AUC 0.81, 95% CI 0.67–0.94），且该差异在排除GC含量和测序深度干扰后仍保持（AUC 0.64-0.76）。","reason","该研究提出多映射cfDNA片段作为早期乳腺癌的潜在生物标志物，与传统片段组学特征相比，在排除GC含量和测序深度干扰后仍显示显著差异（AUC 0.64-0.76），为癌症早期检测提供了新思路。","source",{"_69":78},"links",{"_59":77},"publishedAt","2026-11-05T00:00:00.000Z","discoveredAt","2026-11-05T23:38:32.469Z","timelineAt","category","drug-therapy","tags",[75,76],"score",70,"selected",true,"channel","news","story",{"_72":73,"_11":74},"x","readingMode","full","author"," Kadali, N., UPPALURI, K. R., Challa, H. J., Vempati, K. K. ","body","outline",[],"relatedStories",[71],"topics",[66],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fuKEglEyS_h0","reportCount",1,"additionalSourceCount",0,{"_67":68,"_69":70},"slug","conference-paper","name","顶会与论文接收",{"_72":73,"_11":74},"publicId","a947b937-b801-4dcb-bd9e-834c600d50a7","早期乳腺癌cfDNA多映射分析显示GC偏倚影响诊断价值","论文发表","研究成果","https://www.medrxiv.org/content/10.64898/2026.11.05.26367150v1?rss=1","medRxiv",{"_80":81,"_82":-5},"changelogVersion","2026-10-08T22:43","release"]

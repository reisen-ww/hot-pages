[{"_1":2,"_3":4},"root",{"_5":78},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":-5,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":34,"_52":34,"_53":54,"_55":56,"_57":58},"id","hhblxdkluxehh75f5k014pzos","title","某研究团队分析2008-2023年Marburg病毒研究作者ship性别、地理与资助分布","originalTitle","Who leads Marburg virus research? Gender, geography and funding in authorship, 2008 to early 2023: a bibliometric baseline before the 2023-2025 outbreaks","summary","研究显示，2008-2023年间Marburg病毒相关论文主要由男性作者主导（女性作者占比35.1%），非洲地区作者参与度不足（非洲国家相关论文中非洲作者仅占14.6%），且研究资金主要来自美国机构（69.0%论文获美方资助）。数据集与可视化工具已开源（GitHub: marburg-equity，交互仪表盘：cognosx.ca/dashboards/marburg-equity.html）","reason","研究对比了2008-2023年间Marburg病毒相关论文的性别分布、地理分布及资助机构，为后续非洲主导的研究提供基准数据","source",{"_68":77},"links",{"_58":76},"publishedAt","2026-11-05T00:00:00.000Z","discoveredAt","2026-11-05T23:22:30.889Z","timelineAt","category","tags",[74,75,69],"score",67,"selected",true,"channel","news","story",{"_71":72,"_11":73},"x","readingMode","full","author"," Mbogning Fonkou, M. D. ","body","outline",[],"relatedStories",[70],"topics",[65],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","fvPCcHHUvUzE","reportCount",1,"additionalSourceCount",0,{"_66":67,"_68":69},"slug","deepmind","name","DeepMind",{"_71":72,"_11":73},"publicId","736daea2-c5ce-442a-bbab-40898a0b0aa2","马尔堡病毒研究性别与资金分布分析揭示非洲参与不足","研究成果","数据发布","https://www.medrxiv.org/content/10.64898/2026.11.04.26367239v1?rss=1","medRxiv",{"_79":80,"_81":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","d4slhc0edwaf07e4tm6shgppw","title","D. asperoides 根皂苷生物合成受基因组进化与糖基转移酶多样性调控","originalTitle","Genome evolution and glycosyltransferase diversification shape asperosaponin biosynthesis in Dipsacus asperoides","summary","本研究通过整合基因组、转录组及代谢组数据，解析了 D. asperoides 根中高浓度皂苷的生物合成途径。发现糖基转移酶 UGT85CA 家族存在功能分化，C-3 和 C-28 糖基化顺序受酶特异性调控，并揭示该物种通过基因家族重复和转录调控实现皂苷高效合成。","reason","论文给出了基因组进化与糖基转移酶多样性对高浓度皂苷生物合成的影响分析，读者可据此优化皂苷合成路径设计。","source",{"_70":81},"links",{"_59":80},"publishedAt","2026-11-05T00:00:00.000Z","discoveredAt","2026-11-05T14:40:46.158Z","timelineAt","category","gene-cell","tags",[78,79,73],"score",60,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author"," Yang, R., Fu, C., Zhao, X., Zhao, Y., Huang, W., Li, M., Xiang, G., Xiong, J., Wang, Y., Chen, G., Liu, Q., Yang, S., Zhang, G., He, S., Liang, Y. ","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fmIlPdqKt7zw","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","conference-paper","name","顶会与论文接收","nature","Nature",{"_75":76,"_11":77},"publicId","0f810a26-abfd-4066-968e-dab571834a9e","解析D. asperoides根皂苷生物合成新机制","论文发表","研究成果","https://www.biorxiv.org/content/10.64898/2026.11.03.763632v1?rss=1","bioRxiv",{"_83":84,"_85":-5},"changelogVersion","2026-10-08T22:43","release"]

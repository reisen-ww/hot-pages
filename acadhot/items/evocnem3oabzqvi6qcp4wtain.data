[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","evocnem3oabzqvi6qcp4wtain","title","某团队发现AID蛋白C末端截断（c.589G>T）导致成人型高IgM综合征II型","originalTitle","A minimal two-residue C-terminal truncation of AID in adult-onset hyper-IgM syndrome type 2 (HIGM2)","summary","某团队在成人型高IgM综合征II型（HIGM2）中发现AICDA基因c.589G>T杂合突变导致AID蛋白C末端截断，单细胞测序显示患者B细胞CSR完全阻断且SHM效率降低10倍，AID蛋白水平降至正常56%。研究证实诱导性生殖中心（iGB）文化可恢复携带该突变的B细胞CSR功能，CRISPR-Cas9编辑实验表明iGB对杂合突变有效但对纯合突变无效。","reason","研究提供了诱导性生殖中心（iGB）文化在恢复携带杂合AICDA突变的健康供体B细胞功能中的可行性证据，为未来HIGM2治疗提供新思路","source",{"_69":78},"links",{"_59":77},"publishedAt","2026-11-02T00:00:00.000Z","discoveredAt","2026-11-02T18:30:30.988Z","timelineAt","category","gene-cell","tags",[75,76],"score",78,"selected",true,"channel","news","story",{"_72":73,"_11":74},"x","readingMode","full","author"," Green, K., Rovsing, A. B., Terczynska-Dyla, E., Jensen, L., Machalica, K., Wolff, J. H., Westerberg, L., Larsen, C. S., Lin, L., Mikkelsen, J. G., Jensen, J. M. B., Degn, S. E. ","body","outline",[],"relatedStories",[71],"topics",[66],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","f1osPIn2Xhh8","reportCount",1,"additionalSourceCount",0,{"_67":68,"_69":70},"slug","gene-editing","name","基因编辑与 CRISPR",{"_72":73,"_11":74},"publicId","3223e92b-eb12-46c7-b9dc-cab8cf530aed","某团队发现AICDA杂合突变致成人型HIGM2，iGB技术可部分恢复功能","研究成果","基因治疗","https://www.biorxiv.org/content/10.64898/2026.10.27.762264v1?rss=1","bioRxiv",{"_80":81,"_82":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":73},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":34,"_52":53,"_54":55,"_56":34,"_57":58},"id","n10za7kxjm63cdaprrfwj214u","title","某团队在 bioRxiv 发表胰腺癌转移性表型调控机制研究","originalTitle","The methionine cycle sustains the mesenchymal phenotype of tumor cells and drives PDA progression","summary","某团队通过代谢组学分析发现转移灶依赖甲硫氨酸循环，靶向 SAHH 可降低抗氧化能力并破坏钙稳态，抑制肿瘤增殖和侵袭。临床数据显示 SAHH 高表达与患者生存率下降相关，提示 SAHH 可能成为胰腺癌转移治疗靶点。","reason","source",{"_71":72},"links",{"_58":70},"publishedAt","2026-11-07T00:00:00.000Z","discoveredAt","2026-11-07T12:11:45.801Z","timelineAt","category","clinical","tags",[69],"score",57,"selected",false,"channel","news","story",{"_66":67,"_11":68},"x","readingMode","full","author"," Vasseur, S., Guillaumond, F., Elodie, M., Da-Costa, Q., Finetti, P., Bertucci, F., Tomasini, R., Dusetti, N. J., Mamessier, E., Efthymiou, G., Jaune-Pons, E., Gouirand, V., Tubiana, S. S., Neuzillet, C., Lohmann, E., Djefaflia-Beloribi, S., Grenot, P. ","body","outline",[],"relatedStories",[65],"topics",[],"indexable","markdownAvailable",true,"group",{"_59":60,"_61":62,"_63":64},"hasTranslation","bodyLanguage","original","factId","fHXJlfC3XKfc","reportCount",1,"additionalSourceCount",0,{"_66":67,"_11":68},"publicId","215b703b-de2e-47c3-9a9d-9190d7572a0c","某团队发布胰腺癌转移调控机制预印本研究","研究成果","https://www.biorxiv.org/content/10.64898/2026.11.05.764593v1?rss=1","name","bioRxiv",{"_74":75,"_76":-5},"changelogVersion","2026-10-08T22:43","release"]

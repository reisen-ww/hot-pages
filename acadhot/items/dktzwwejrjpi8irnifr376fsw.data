[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","dktzwwejrjpi8irnifr376fsw","title","FDA批准的CDK4/6抑制剂abemaciclib（Verzenios）被证实为ACKR3强效激动剂","originalTitle","The FDA-approved CDK4/6 inhibitor Abemaciclib is a potent agonist of the β-arrestin-biased atypical chemokine receptor ACKR3","summary","某团队通过药物重用策略筛选2,342种FDA批准化合物，发现CDK4/6抑制剂abemaciclib（Verzenios）对ACKR3具有纳米摩尔级激动作用。结构生物学证据显示abemaciclib与ACKR3结合形成独特U型构象，并抑制CXCL11/CXCL12介导的受体内吞。小鼠口服实验证实其体内活性。","reason","论文通过药物重用策略发现FDA批准的CDK4/6抑制剂abemaciclib对ACKR3具有强效激动作用，并提供了结构生物学证据支持其选择性","source",{"_70":81},"links",{"_59":80},"publishedAt","2026-11-04T00:00:00.000Z","discoveredAt","2026-11-04T13:49:51.204Z","timelineAt","category","drug-therapy","tags",[78,79,73],"score",80,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author"," Buzink, M. C. M. L., Darcis, J., Nesheva, D., Meyrath, M., Jenjak, S., Banerjee, N., Ganguly, M., Reyaz, A., Banerjee, R., Leliveld, E. A., Kwon, Y.-J., Paggetti, J., Zielhuis, S., Pluim, D., Huitema, A., Volkman, B. F., Vischer, H. F., Shukla, A. K., Chevigne, A., Szpakowska, M., Leurs, R. ","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fRACGLgmTNTM","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","conference-paper","name","顶会与论文接收","openai","OpenAI",{"_75":76,"_11":77},"publicId","2901b966-307e-4860-b7df-f9d6336e3adb","FDA批准药物abemaciclib被证实为ACKR3强效激动剂","论文发表","研究成果","https://www.biorxiv.org/content/10.64898/2026.11.03.764001v1?rss=1","bioRxiv",{"_83":84,"_85":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":78},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":34,"_52":53,"_54":55,"_56":34,"_57":58},"id","nlddrpfmgkj7r93jl3zizk7q0","title","某团队在 bioRxiv 发表 Valley Fever 新型诊断抗原的蛋白质组学发现","originalTitle","Proteome-wide discovery of novel diagnostic antigens for coccidioidomycosis","summary","某团队通过 PepSeq 平台在 Coccidioides 蛋白质组中发现 244,000 条肽链中 238 个新抗原，并在独立队列验证其诊断价值（AUC=0.91）。研究首次实现全蛋白质组覆盖的抗原发现，为 Valley Fever 早期血清学检测提供新靶点。DOI:10.64898/2026.11.05.764335","reason","source",{"_68":76},"links",{"_58":77},"publishedAt","2026-11-07T00:00:00.000Z","discoveredAt","2026-11-07T12:11:45.631Z","timelineAt","category","life-science","tags",[74,75,76],"score",55,"selected",false,"channel","news","story",{"_71":72,"_11":73},"x","readingMode","full","author"," Elko, E., Ryle, L., Nelson, G. A., Sarbo, N. G., Harms, C. E., Kelley, E., Fredericks, M. N., Keim, P., Knox, K., Kala, M., Fuller, D. H., Settles, E. W., Barker, B. M., Magee, D. M., Lake, D. F., Grys, T. E., Thompson, G. R., Altin, J., Ladner, J. T., Mead, H. L. ","body","outline",[],"relatedStories",[70],"topics",[65],"indexable","markdownAvailable",true,"group",{"_59":60,"_61":62,"_63":64},"hasTranslation","bodyLanguage","original","factId","fMq7hEYQWCZY","reportCount",1,"additionalSourceCount",0,{"_66":67,"_68":69},"slug","protein-structure","name","蛋白质结构与设计",{"_71":72,"_11":73},"publicId","4779ae21-e4e8-4d2f-aee9-738d2065bcc0","Valley Fever新型诊断抗原发现（基于蛋白质组学）","研究成果","蛋白质结构","bioRxiv","https://www.biorxiv.org/content/10.64898/2026.11.05.764335v1?rss=1",{"_79":80,"_81":-5},"changelogVersion","2026-10-08T22:43","release"]

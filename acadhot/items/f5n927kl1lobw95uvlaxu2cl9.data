[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","f5n927kl1lobw95uvlaxu2cl9","title","加州大学圣塔芭芭拉分校与佐治亚理工学院合作开发SynFit工具，实现酶工程多目标优化平衡","originalTitle","SynFit guides enzyme engineering by balancing several useful traits at once","summary","加州大学圣塔芭芭拉分校与佐治亚理工学院团队开发SynFit工具，通过多目标优化提升酶工程效率。该工具在碳硼键合成酶改造实验中验证了高产率与高选择性的平衡能力，并开源了代码与数据集。测试显示SynFit在公共蛋白数据集上表现优于单目标模型，其多维度预测方法可扩展至其他酶工程场景。","reason","该论文展示了SynFit工具在平衡酶的多目标优化中的有效性，其开源代码和公共数据集为后续研究提供了可复现的基础。","source",{"_68":80},"links",{"_58":79},"publishedAt","2026-11-06T18:00:03.000Z","discoveredAt","2026-11-07T12:11:51.161Z","timelineAt","category","ai-frontier","tags",[74,75,76,77,78],"score",76,"selected",true,"channel","news","story",{"_71":72,"_11":73},"x","readingMode","full","author","body","outline",[],"relatedStories",[70],"topics",[65],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","f8wPPgA8EzfA","reportCount",1,"additionalSourceCount",0,{"_66":67,"_68":69},"slug","conference-paper","name","顶会与论文接收",{"_71":72,"_11":73},"publicId","ee2c57ea-401e-46c5-a0de-5a638063165b","SynFit工具通过多目标优化提升酶工程效率，已开源","论文发表","大模型","DeepMind","OpenAI","NVIDIA","https://phys.org/news/2026-11-synfit-enzyme-traits.html","Phys.org",{"_82":83,"_84":-5},"changelogVersion","2026-10-08T22:43","release"]

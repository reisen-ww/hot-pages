[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","h853hfj01w4je2b88ynz89zal","title","Platycodin D2靶向vimentin抑制纤维母细胞向肌成纤维细胞转化","originalTitle","Platycodin D2 Targets Vimentin to Suppress Fibroblast-Myofibroblast Transition: A Novel Therapeutic Strategy Against Pulmonary Fibrosis","summary","某团队发现Platycodin D2通过靶向vimentin抑制纤维母细胞向肌成纤维细胞转化，有效改善肺纤维化小鼠生存率（Kd=392.8 nM）。实验证实该化合物诱导vimentin二级结构改变并形成不溶性聚集体，显著减少胶原沉积。关键结合位点验证显示Glu138（链A）、Glu132/Glu143（链B）、Glu50/Arg54（链C）对相互作用至关重要。","reason","论文提供了PD2抑制纤维母细胞转化的实验数据，为肺纤维化治疗提供新靶点策略","source",{"_70":81},"links",{"_59":80},"publishedAt","2026-11-05T00:00:00.000Z","discoveredAt","2026-11-05T12:33:29.052Z","timelineAt","category","drug-therapy","tags",[78,79,73],"score",68,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author"," Lang, X., Ma, Z., Yao, C., Miao, X., Kao, Y., Wang, W., Sun, S. ","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fs2j98SDpaNw","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","protein-structure","name","蛋白质结构与设计","deepmind","DeepMind",{"_75":76,"_11":77},"publicId","c1c25c67-29c4-4eb5-9803-369e84d61674","某团队揭示Platycodin D2通过靶向vimentin抑制肺纤维化机制","研究成果","蛋白质结构","https://www.biorxiv.org/content/10.64898/2026.11.03.763586v1?rss=1","bioRxiv",{"_83":84,"_85":-5},"changelogVersion","2026-10-08T22:43","release"]

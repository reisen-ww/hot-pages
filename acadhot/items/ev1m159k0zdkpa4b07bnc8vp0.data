[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","ev1m159k0zdkpa4b07bnc8vp0","title","欧洲森林需同时应对气候变化与生物多样性危机，但未必能一地解决","originalTitle","European forests need to solve two crises—but not necessarily in one place","summary","欧洲森林若仅优化碳储存，将导致生物多样性下降。哥本哈根大学研究团队在《Nature Communications》发表成果（DOI:10.1038/s41467-026-68668-x），提出三重管理方法：部分森林专注木材生产并维持碳汇，部分森林主攻生物多样性，部分作为平衡型试验区。","reason","source",{"_70":71},"links",{"_57":69},"publishedAt","2026-11-06T20:00:01.000Z","discoveredAt","2026-11-07T12:11:48.275Z","timelineAt","category","materials-energy","tags",[68],"score",56,"selected",false,"channel","news","story",{"_65":66,"_11":67},"x","readingMode","full","author","body","outline",[],"relatedStories",[64],"topics",[],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","fwiPPAdWBMB8","reportCount",1,"additionalSourceCount",0,{"_65":66,"_11":67},"publicId","a415d70a-87b4-48e3-98fa-18abae9a6b4d","欧洲森林需分区应对气候与生物多样性危机","研究成果","https://phys.org/news/2026-11-european-forests-crises-necessarily.html","name","Phys.org",{"_73":74,"_75":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","r2yxng4wrgbw8yteuy1cicoap","title","地球引力可能维持了早期月球火山核心的活动","originalTitle","Earth's gravity may have kept the early moon's volcanic heart beating","summary","最新研究发现，地球引力通过潮汐加热作用在20亿年前维持了月球火山活动，解释了为何月球在形成后仍能产生火山岩。研究团队模拟了月球内部的潮汐应力，发现该作用在月球核心-幔层边界产生了巨大能量，驱动了月球地质历史上的许多活动。这一理论有助于理解月球磁场的持续时间及火山岩的形成机制，但仍需更多数据验证。","reason","source",{"_70":71},"links",{"_57":69},"publishedAt","2026-11-07T17:30:01.000Z","discoveredAt","2026-11-07T17:46:16.215Z","timelineAt","category","neuroscience","tags",[68],"score",38,"selected",false,"channel","news","story",{"_65":66,"_11":67},"x","readingMode","full","author","body","outline",[],"relatedStories",[64],"topics",[],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","feUV-BmQ8gR8","reportCount",1,"additionalSourceCount",0,{"_65":66,"_11":67},"publicId","ea1a6c34-c5e4-4643-a8b0-0945e10d00f3","地球引力或维持早期月球火山活动","研究成果","https://phys.org/news/2026-11-earth-gravity-early-moon-volcanic.html","name","Phys.org",{"_73":74,"_75":-5},"changelogVersion","2026-10-08T22:43","release"]

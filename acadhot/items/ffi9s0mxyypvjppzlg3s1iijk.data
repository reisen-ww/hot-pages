[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","ffi9s0mxyypvjppzlg3s1iijk","title","某研究团队在 bioRxiv 发表 Ovol1 变体调控内皮细胞血管生成的机制","originalTitle","An Ovol1 Variant in Endothelial Cells Regulates Slug and is Essential for Pathological Angiogenesis","summary","某研究团队发现内皮细胞中低分子量 Ovol1 变体通过上调 Slug 蛋白驱动病理血管生成，并在结直肠癌小鼠模型中验证了该机制。实验采用 RNA 干扰和慢病毒过表达系统，证实 Ovol1-Slug 信号轴在 3D 血管生成模型和氧诱导视网膜病变（OIR）模型中起关键作用。研究同时指出 Ovol1 在正常发育血管生成中不显著表达，但在肿瘤血管中重新激活。","reason","论文揭示了内皮细胞中Ovol1变体通过调控Slug驱动病理血管生成的机制，为结直肠癌治疗提供了潜在靶点。","source",{"_70":81},"links",{"_59":82},"publishedAt","2026-11-03T00:00:00.000Z","discoveredAt","2026-11-03T21:32:17.337Z","timelineAt","category","life-science","tags",[78,79,80,81],"score",60,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author"," Thapa, K., Burow, B., Baddoo, M. C., Peelle, M. J., Citron, H., C, R. K., Sutherland, S., Hatch, C. J., Crawford, N., Karp, A., Meadows, S. M., Howsmon, D. P., Stanfield, B. A., Subramanian, K., Hughes, C. C., Fang, J. S. ","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fXKPXBir6T94","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","protein-structure","name","蛋白质结构与设计","cancer-immunotherapy","癌症免疫治疗",{"_75":76,"_11":77},"publicId","9dcf564d-cc9c-4938-93d5-cb72bb66e664","Ovol1变体调控内皮细胞血管生成机制研究发布","研究成果","蛋白质结构","癌症免疫","bioRxiv","https://www.biorxiv.org/content/10.64898/2026.10.31.763143v1?rss=1",{"_84":85,"_86":-5},"changelogVersion","2026-10-08T22:43","release"]

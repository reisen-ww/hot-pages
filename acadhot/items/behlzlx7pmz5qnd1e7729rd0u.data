[{"_1":2,"_3":4},"root",{"_5":78},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","behlzlx7pmz5qnd1e7729rd0u","title","某研究团队在隐式再校准与新型技能学习中的长期训练效果","originalTitle","Development of appropriate sensorimotor recalibration for a de novo skill","summary","某研究团队发现长期训练可使隐式再校准灵活适应新型技能学习，具体表现为：受试者通过持续28天训练掌握镜像反转和大角度旋转技能时，隐式再校准机制能动态调整感官预测与误差校正策略。研究证实前馈规划训练足以触发这种适应性调整，参与者可无显著干扰切换不同技能映射模式。该成果挑战了先前认为隐式再校准缺乏灵活性的结论。","reason","研究对比了长期训练与反馈控制在新型技能学习中的效果，揭示了隐式再校准的适应性调整机制。","source",{"_69":77},"links",{"_59":76},"publishedAt","2026-11-03T00:00:00.000Z","discoveredAt","2026-11-03T18:36:35.099Z","timelineAt","category","neuroscience","tags",[75,70],"score",84,"selected",true,"channel","news","story",{"_72":73,"_11":74},"x","readingMode","full","author"," Wang, T., Li, Y., Taylor, J. A., Ivry, R. B. ","body","outline",[],"relatedStories",[71],"topics",[66],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fHiJKORei8tM","reportCount",1,"additionalSourceCount",0,{"_67":68,"_69":70},"slug","brain-computer-interface","name","脑机接口",{"_72":73,"_11":74},"publicId","77826ae3-39a1-43b1-b5d2-62102de8b823","Wang等团队推翻隐式再校准缺乏灵活性的结论","研究成果","https://www.biorxiv.org/content/10.64898/2026.11.02.763836v1?rss=1","bioRxiv",{"_79":80,"_81":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","biftirknhmzcguqxslb2tjpyh","title","维也纳医科大学团队发现IL-13与抗抑郁药疗效相关","originalTitle","Peripheral immune biomarkers, brain imaging phenotypes and treatment response in major depressive disorder","summary","某团队在抑郁症治疗中发现IL-13与选择性5-羟色胺再摄取抑制剂（SSRI，如escitalopram）疗效相关（β=1.09, 95%CI 0.56-1.61），并提示IL-15和IL-13可能与治疗后海马体体积增加有关。","reason","论文提供了IL-13与SSRI类药物（如escitalopram）疗效关联的定量数据，并首次将免疫标志物与海马体体积变化建立联系，为抑郁症治疗提供新的生物标志物参考。","source",{"_70":81},"links",{"_59":80},"publishedAt","2026-11-04T00:00:00.000Z","discoveredAt","2026-11-05T01:47:20.587Z","timelineAt","category","clinical","tags",[78,79,73],"score",75,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author"," Eggerstorfer, B., Altmann, P., Murgas, M., Ponleitner, M., Godbersen, G. M., Klöbl, M., Unterholzner, J., Silberbauer, L. R., Vraka, C., Philippe, C., Nics, L., Hahn, A., Hacker, M., Gryglewski, G., Lanzenberger, R. ","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fZb-JZ6VXK0c","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","alzheimers","name","阿尔茨海默与神经退行","deepmind","DeepMind",{"_75":76,"_11":77},"publicId","6c465e3a-e3f2-44e5-a46c-37768be8facf","维也纳医科大学发现IL-13与SSRI疗效相关，或涉IL-15及海马体变化","研究成果","阿尔茨海默","https://www.medrxiv.org/content/10.64898/2026.11.03.26367072v1?rss=1","medRxiv",{"_83":84,"_85":-5},"changelogVersion","2026-10-08T22:43","release"]

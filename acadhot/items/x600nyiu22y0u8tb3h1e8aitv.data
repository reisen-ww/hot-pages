[{"_1":2,"_3":4},"root",{"_5":75},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":-5,"_14":15,"_16":-5,"_17":18,"_19":20,"_21":22,"_23":24,"_25":24,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":40,"_41":-5,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":33,"_50":51,"_52":53,"_54":33,"_55":56},"id","x600nyiu22y0u8tb3h1e8aitv","title","能量系统热力学分析方法","originalTitle","summary","该方法从能量数量守恒逐步深入到能量品位损失分析，涵盖能量分析、熵分析、火用分析、先进火用分析、夹点分析、热经济学分析和能值分析，构建了一个从技术到经济与生态的递进体系。通过这些方法，可以诊断能量系统中的损失并确定改进潜力，为实际应用提供系统化的分析工具。","reason","source",{"_66":74},"links",{"_56":73},"publishedAt","2026-11-07T02:10:14.000Z","discoveredAt","2026-11-07T07:25:51.872Z","timelineAt","category","materials-energy","tags",[72],"score",39,"selected",false,"channel","news","story",{"_69":70,"_11":71},"x","readingMode","full","author","body","outline",[],"relatedStories",[68],"topics",[63],"indexable","markdownAvailable",true,"group",{"_57":58,"_59":60,"_61":62},"hasTranslation","bodyLanguage","original","factId","fEG_HLh5AYDg","reportCount",1,"additionalSourceCount",0,{"_64":65,"_66":67},"slug","conference-paper","name","顶会与论文接收",{"_69":70,"_11":71},"publicId","7361e3ad-fdf5-4c76-9bd7-e6e88c705fc5","提出能量系统热力学分析递进体系","论文发表","http://blog.sciencenet.cn/home.php?mod=space&uid=300938&do=blog&id=1560115","科学网博客",{"_76":77,"_78":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","i2o5072p5sw4q85m1ubyz6dqv","title","约翰霍普金斯医学院团队在medRxiv发表帕金森病日常活动功能评估新方法","originalTitle","Short intervals of inertial measurement unit data collected during activities of daily living can provide a quantitative method to assess disease severity and functional ability in Parkinson's disease","summary","约翰霍普金斯医学院团队通过日常活动中的惯性测量单元数据，发现帕金森病患者与健康对照者的运动模式存在显著差异。研究纳入39名帕金森病患者和7名健康对照，使用牙刷和梳子搭载九轴IMU设备采集连续加速度和角速度数据，经预处理后提取30个特征（13个加速度相关、17个角速度相关），训练XGBoost模型区分疾病状态和严重程度。","reason","该研究提出通过日常活动中的惯性测量单元数据，定量评估帕金森病患者功能能力与疾病严重程度的方法，为临床提供可操作的新工具。","source",{"_69":81},"links",{"_59":80},"publishedAt","2026-11-02T00:00:00.000Z","discoveredAt","2026-11-02T20:37:27.037Z","timelineAt","category","neuroscience","tags",[75,76,77,78,79],"score",68,"selected",true,"channel","news","story",{"_72":73,"_11":74},"x","readingMode","full","author"," Vanchinathan, V. L., Farah, M., Singh, A., Zhang, C., Palani, R., Osei-Owusu, N., Desai, R., Hamkins, J., Iglesias Hernandez, D., Hernandez, M. E., Pantelyat, A. L., Grill, S. ","body","outline",[],"relatedStories",[71],"topics",[66],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fPaMrk2zeFyQ","reportCount",1,"additionalSourceCount",0,{"_67":68,"_69":70},"slug","alzheimers","name","阿尔茨海默与神经退行",{"_72":73,"_11":74},"publicId","e86c5736-3e98-4ab9-9b9f-4b161c00f800","约翰霍普金斯医学院发布帕金森病日常活动功能评估新方法","研究成果","帕金森","DeepMind","OpenAI","NVIDIA","https://www.medrxiv.org/content/10.64898/2026.10.30.26366941v1?rss=1","medRxiv",{"_83":84,"_85":-5},"changelogVersion","2026-10-08T22:43","release"]

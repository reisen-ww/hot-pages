[{"_1":2,"_3":4},"root",{"_5":78},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","e21lualr6r60p8949y63gg4g3","title","单次尼古丁暴露在小鼠嗅觉皮层中引发空间转录响应","originalTitle","Acute nicotine exposure produces a spatially organized transcriptional response in mouse olfactory cortex","summary","Griffioen 等在小鼠嗅觉皮层中发现单次尼古丁暴露引发空间转录响应，涉及钙处理、突触组装等通路。响应集中在表达 Cartpt 和 Penk 的表层锥体神经元群，其周围 1 细胞直径范围内 Sparcl1 表达下降。该研究首次通过 Visium HD 空间转录组技术解析了小鼠嗅觉皮层中尼古丁暴露的细胞特异性时空响应模式。","reason","该研究提供了空间转录组学在神经科学中的具体应用案例，为后续研究尼古丁对嗅觉通路的影响提供了分子层面的参考。","source",{"_69":77},"links",{"_59":76},"publishedAt","2026-11-05T00:00:00.000Z","discoveredAt","2026-11-06T02:18:09.175Z","timelineAt","category","neuroscience","tags",[75,70],"score",69,"selected",true,"channel","news","story",{"_72":73,"_11":74},"x","readingMode","full","author"," Griffioen, M. K., Lombardi, A., Milstead, R., Borski, C., Zou, S., Stitzel, J., Ehringer, M. A., Hoeffer, C. A. ","body","outline",[],"relatedStories",[71],"topics",[66],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fk86TBhK8SGM","reportCount",1,"additionalSourceCount",0,{"_67":68,"_69":70},"slug","deepmind","name","DeepMind",{"_72":73,"_11":74},"publicId","ebb8bfc2-310b-41a2-9cd8-0592910ea977","单次尼古丁暴露引发小鼠嗅觉皮层空间转录响应机制研究","研究成果","https://www.biorxiv.org/content/10.64898/2026.11.04.764395v1?rss=1","bioRxiv",{"_79":80,"_81":-5},"changelogVersion","2026-10-08T22:43","release"]

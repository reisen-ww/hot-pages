[{"_1":2,"_3":4},"root",{"_5":73},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","e70t6d57403s71apiz0hhl2fx","title","加州大学圣芭芭拉分校团队在《物理评论快报》发表振动光镜模拟黑洞事件视界的研究","originalTitle","Vibrating mirrors of light create analog of a black hole event horizon","summary","David Weld团队在UC Santa Barbara通过振动光镜将超冷锂原子气体压缩成脉冲，首次实验验证了黑洞事件视界理论。实验使用激光光栅形成‘原子光腔’，以100次/秒频率振动一面镜子，观察到原子云沿稳定路径单向运动，与理论预测一致。研究发表在《物理评论快报》DOI:10.1103/44mq-jfp1，arXiv预印本编号2601.21122。","reason","该研究首次通过原子实验验证了黑洞事件视界的理论预测，为光学信号压缩和可调电性材料提供了新思路。","source",{"_71":72},"links",{"_58":70},"publishedAt","2026-11-06T17:40:11.000Z","discoveredAt","2026-11-07T12:11:52.006Z","timelineAt","category","quantum-physics","tags",[69],"score",78,"selected",true,"channel","news","story",{"_66":67,"_11":68},"x","readingMode","full","author","body","outline",[],"relatedStories",[65],"topics",[],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","f55NbTO1Rqtg","reportCount",1,"additionalSourceCount",0,{"_66":67,"_11":68},"publicId","2d11e5f7-3d24-480e-8857-e591af287cf2","David Weld团队实验模拟黑洞事件视界","研究成果","https://phys.org/news/2026-11-vibrating-mirrors-analog-black-hole.html","name","Phys.org",{"_74":75,"_76":-5},"changelogVersion","2026-10-08T22:43","release"]

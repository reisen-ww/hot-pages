[{"_1":2,"_3":4},"root",{"_5":73},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","ym7mms4mvrfl0404kllnyhyev","title","Curtin University 在 PNAS 发表恐龙化石中保存了115百万年前的血液分子","originalTitle","Scientists just found dinosaur blood that survived 115 million years","summary","Curtin University 团队在国际合作中，通过化学分析在巴西发现的 115 百万年前的阿拉斯塔苏鲁斯恐龙化石中检测到完整的血红蛋白分子（heme），并发现矿物 hausmannite 对其有稳定作用。","reason","论文首次通过化学分析确认了化石中恐龙血液分子的存在，并挑战了 paleontology 中关于血液分子无法长期保存的假设，为研究远古生物提供了新方法。","source",{"_71":72},"links",{"_58":70},"publishedAt","2026-11-06T11:28:01.000Z","discoveredAt","2026-11-07T12:11:52.025Z","timelineAt","category","neuroscience","tags",[69],"score",79,"selected",true,"channel","news","story",{"_66":67,"_11":68},"x","readingMode","full","author","body","outline",[],"relatedStories",[65],"topics",[],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","fZT4Yt5kjomM","reportCount",3,"additionalSourceCount",2,{"_66":67,"_11":68},"publicId","20595d3d-8d2f-4b5b-8a8b-9efb827e6196","科廷大学发现1.15亿年前恐龙化石含血红素及胶原蛋白氨基酸，证实矿物化稳定作用","研究成果","https://www.sciencedaily.com/releases/2026/11/261105224542.htm","name","ScienceDaily 综合",{"_74":75,"_76":-5},"changelogVersion","2026-10-08T22:43","release"]

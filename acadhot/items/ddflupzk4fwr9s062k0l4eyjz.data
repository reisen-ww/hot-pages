[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","ddflupzk4fwr9s062k0l4eyjz","title","靶向外泌 DDR1 的纳米抗体成功重塑肿瘤基质与局部免疫","originalTitle","Extracellular DDR1 targeting remodels collagen-rich tumor stroma and local immunity","summary","某团队开发针对外泌 DDR1 的纳米抗体，在免疫胜任的乳腺和胰腺肿瘤模型中显著抑制肿瘤生长。单细胞分析显示肿瘤相关中性粒细胞通路重塑，Ly6G+细胞耗竭显著影响疗效。研究首次证实外泌 DDR1 靶向可系统性改变肿瘤微环境结构及免疫应答。","reason","该研究提供了靶向外泌 DDR1 的纳米抗体开发方案，其通过重塑肿瘤基质和免疫微环境实现抗肿瘤效果，为实体瘤治疗提供新思路。","source",{"_70":81},"links",{"_59":80},"publishedAt","2026-11-03T00:00:00.000Z","discoveredAt","2026-11-04T07:20:28.713Z","timelineAt","category","gene-cell","tags",[78,79,73],"score",70,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author"," Huang, X., Liu, X., Huang, L., Jing, G., Kuerban, K., Cai, M., Yue, Q., Yu, M., Yang, S., Zhu, Y. Z., Ye, L. ","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fDiPKAda6Lnw","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","cancer-immunotherapy","name","癌症免疫治疗","deepmind","DeepMind",{"_75":76,"_11":77},"publicId","dd926b12-1a3c-4cdb-a1e7-7e6e732716d1","靶向外泌DDR1的纳米抗体重塑肿瘤微环境及免疫应答","研究成果","细胞治疗","https://www.biorxiv.org/content/10.64898/2026.10.29.762758v1?rss=1","bioRxiv",{"_83":84,"_85":-5},"changelogVersion","2026-10-08T22:43","release"]

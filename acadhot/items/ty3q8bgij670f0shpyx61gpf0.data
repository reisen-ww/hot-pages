[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","ty3q8bgij670f0shpyx61gpf0","title","牛津大学团队在 Nature Physics 发表：囚禁离子模拟晶格 gauge 理论中的 Aharonov–Bohm 干涉效应","originalTitle","Two paths, one flux: Trapped ions simulate Aharonov–Bohm interference in a lattice gauge theory","summary","牛津大学团队在 Nature Physics 发表研究，使用囚禁离子系统模拟二维晶格 gauge 理论中的 Aharonov–Bohm 干涉效应。实验通过电子态编码场、振动模式编码物质，在零通量时粒子自由隧穿，非零通量时完全抑制。该成果为量子计算机处理拓扑材料问题提供了新方法，未来计划扩展晶格尺寸和理论模型（Z₂→Zₙ）。","reason","source",{"_69":81},"links",{"_57":80},"publishedAt","2026-11-07T18:00:02.000Z","discoveredAt","2026-11-07T18:02:14.579Z","timelineAt","category","quantum-physics","tags",[79,72,74],"score",72,"selected",false,"channel","news","story",{"_76":77,"_11":78},"x","readingMode","full","author","body","outline",[],"relatedStories",[75],"topics",[64,65,66],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","f5lXQARsP13A","reportCount",1,"additionalSourceCount",0,{"_67":73,"_69":74},{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","conference-paper","name","顶会与论文接收","quantum-computing","量子计算","nature","Nature",{"_76":77,"_11":78},"publicId","18f7cb62-40c2-4a42-b3be-a704569171b6","牛津大学团队用囚禁离子模拟二维晶格Aharonov-Bohm效应","论文发表","https://phys.org/news/2026-11-paths-flux-ions-simulate-aharonovbohm.html","Phys.org",{"_83":84,"_85":-5},"changelogVersion","2026-10-08T22:43","release"]

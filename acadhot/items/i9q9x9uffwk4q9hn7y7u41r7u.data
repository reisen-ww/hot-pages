[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","i9q9x9uffwk4q9hn7y7u41r7u","title","某团队在 bioRxiv 发表首例感染鲍曼氏不动杆菌的 Podovirus 全原子结构解析","originalTitle","Cryo-EM structures of an Acinetobacter baumannii podovirus reveal a canonical capsid maturation","summary","某团队首次解析感染鲍曼氏不动杆菌的 Podovirus AbP20 全原子结构。近原子分辨率显示 AbP20 由衣壳、门、喷嘴、纤维和适配器五种亚基组成，并揭示衣壳成熟的标准构象转换机制。","reason","论文给出了衣壳蛋白与门蛋白复合物的分子互作细节，以及近原子分辨率下衣壳成熟的标准构象转换机制，读者可据此设计新型噬菌体工程载体。","source",{"_70":80},"links",{"_59":81},"publishedAt","2026-11-07T00:00:00.000Z","discoveredAt","2026-11-08T03:20:33.969Z","timelineAt","category","life-science","tags",[78,79,80],"score",76,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author"," Xue, H., Rao, G., Li, X., Zhong, M., Cao, S., Yang, H. ","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fUqrWMgjnbq8","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","conference-paper","name","顶会与论文接收","protein-structure","蛋白质结构与设计",{"_75":76,"_11":77},"publicId","1ddc1810-d181-4974-ba58-3bca2711f210","鲍曼氏不动杆菌噬菌体AbP20全原子结构首次解析","论文发表","蛋白质结构","bioRxiv","https://www.biorxiv.org/content/10.64898/2026.11.06.765006v1?rss=1",{"_83":84,"_85":-5},"changelogVersion","2026-10-08T22:43","release"]

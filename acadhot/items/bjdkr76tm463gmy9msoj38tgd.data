[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","bjdkr76tm463gmy9msoj38tgd","title","约翰霍普金斯大学发布血液培养管理改进的14个成人ICU及病房实施效果","originalTitle","Implementation of an Intervention to Improve Blood Culture Stewardship in 14 Adult ICUs and Wards.","summary","约翰霍普金斯大学在14个成人ICU及病房实施血液培养管理改进措施，结果显示ICU单位血液培养使用率降低约20%，部分病房出现使用率上升但阳性率同步提升。研究通过整合实施框架分析，发现算法易用性感知、减少重复采血必要性、护士参与教育及定期反馈是影响改善效果的关键因素。","reason","该研究提供了血液培养管理改进的对比数据，读者可参考基线使用率与实施效果的关系评估类似项目的可行性。","source",{"_70":80},"links",{"_59":79},"publishedAt","2026-11-01T00:00:00.000Z","discoveredAt","2026-11-02T02:47:09.489Z","timelineAt","category","clinical","tags",[78,71,73],"score",61,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author"," Fabre, V., Hsu, Y.-J., Xie, A., Salinas, A. B., Beccar-Varela, P., Martinez, V., Degnan, K. O., Gettler, E. B., Glaser, L., Johnson, J. K., Moehring, R. W., Rodriguez-Nava, G., Ryder, J. H., Ressler, A., Salinas, J. L., Schrank, G. M., Talbot, T. R., Van Schooneveld, T. C., Wasylyshyn, A., Cosgrove, S. E. ","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fD98hS-7_GA0","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","clinical-trial","name","临床试验","deepmind","DeepMind",{"_75":76,"_11":77},"publicId","c4bfaf54-eb81-41b8-a029-e5acb58b5e18","约翰霍普金斯大学研究显示改进措施使ICU血液培养使用率降低20%","研究成果","https://www.medrxiv.org/content/10.64898/2026.10.29.26366841v1?rss=1","medRxiv",{"_82":83,"_84":-5},"changelogVersion","2026-10-08T22:43","release"]

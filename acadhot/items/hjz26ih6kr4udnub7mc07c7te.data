[{"_1":2,"_3":4},"root",{"_5":78},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","hjz26ih6kr4udnub7mc07c7te","title","TriNetX研究团队发表肥胖型心血管疾病患者他汀联合GLP-1 RA治疗效果：倾向得分匹配队列研究","originalTitle","GLP-1 Receptor Agonists Added to Statin Therapy and Cardiovascular Outcomes in ASCVD A Propensity Score-Matched Cohort Study","summary","某研究团队基于TriNetX Research Network的10.8万例美国患者数据，通过倾向得分匹配分析发现：BMI 30 kg/m²的ASCVD患者中，GLP-1受体激动剂联合他汀治疗3年随访期内的全因死亡率（4.0% vs 7.5%）和心肌梗死发生率（HR 0.762）均显著低于单用他汀组（p<0.001）。","reason","研究通过倾向得分匹配分析了10.8万家美国患者的数据，发现GLP-1受体激动剂联合他汀治疗可显著降低肥胖型心血管疾病患者的全因死亡率（HR 0.479）、心肌梗死（HR 0.762）和中风（HR 0.671），且亚组分析与敏感性检验均支持结论。","source",{"_69":77},"links",{"_59":76},"publishedAt","2026-11-06T00:00:00.000Z","discoveredAt","2026-11-07T12:11:43.534Z","timelineAt","category","clinical","tags",[75,70],"score",76,"selected",true,"channel","news","story",{"_72":73,"_11":74},"x","readingMode","full","author"," Tah, S., Cheshire, M. ","body","outline",[],"relatedStories",[71],"topics",[66],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fzAdGHPwcggo","reportCount",1,"additionalSourceCount",0,{"_67":68,"_69":70},"slug","deepmind","name","DeepMind",{"_72":73,"_11":74},"publicId","7a70d9e8-c8ae-484a-806c-b4fda6d21f08","TriNetX发布他汀联合GLP-1 RA治疗肥胖型心血管疾病研究（预印本阶段）","研究成果","https://www.medrxiv.org/content/10.64898/2026.11.05.26367396v1?rss=1","medRxiv",{"_79":80,"_81":-5},"changelogVersion","2026-10-08T22:43","release"]

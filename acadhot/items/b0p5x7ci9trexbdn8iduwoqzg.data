[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","b0p5x7ci9trexbdn8iduwoqzg","title","科学家在西班牙阿尔琴特附近发现新水母物种 Copula lucentia","originalTitle","Scientists discover new jellyfish species in waters off Alicante in Spain","summary","2024年，来自阿尔钦特大学海洋实验室的研究团队在地中海阿尔琴特附近发现并描述了新水母物种 Copula lucentia，该物种体长约1至7毫米。这是地中海记录的第二种箱水母，首次发现于2016年至2018年采集的样本中。","reason","source",{"_70":71},"links",{"_57":69},"publishedAt","2026-11-07T16:00:01.000Z","discoveredAt","2026-11-07T16:10:14.346Z","timelineAt","category","life-science","tags",[68],"score",42,"selected",false,"channel","news","story",{"_65":66,"_11":67},"x","readingMode","full","author","body","outline",[],"relatedStories",[64],"topics",[],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","fVR-_o6puZ0g","reportCount",1,"additionalSourceCount",0,{"_65":66,"_11":67},"publicId","2bb1b78b-8aa3-488a-96dc-ce2d3657efa6","西班牙阿利坎特大学发现地中海第二种箱水母新物种Copula lucentia","研究成果","https://phys.org/news/2026-11-scientists-jellyfish-species-alicante-spain.html","name","Phys.org",{"_73":74,"_75":-5},"changelogVersion","2026-10-08T22:43","release"]

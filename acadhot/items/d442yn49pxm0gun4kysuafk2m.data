[{"_1":2,"_3":4},"root",{"_5":67},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":24,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":-5,"_54":55,"_56":57},"id","d442yn49pxm0gun4kysuafk2m","title","通讯：Bundibugyo 病毒疫情的跨境协调应对","originalTitle","[Correspondence] Bundibugyo virus: coordinating a cross-border response","summary","2026年5月15日，刚果（金）与乌干达宣布暴发由 Bundibugyo 病毒引起的埃博拉疫情，WHO 总干事于5月17日宣布构成国际关注的突发公共卫生事件。截至8月26日共报告5815例确诊病例和2788例死亡，其中刚果（金）5794例病例、2786例死亡，传播已波及六省的60个卫生区。","reason","这封信汇总了两国疫情规模与 WHO 宣布 PHEIC 的时间线，为跨境传染病协调应对提供参考框架。","source",{"_61":66},"links",{"_57":65},"publishedAt","2026-10-08T22:30:01.000Z","discoveredAt","2026-10-15T23:07:42.018Z","timelineAt","category","clinical","tags",[63,64],"score",73,"selected",true,"channel","news","story","x","readingMode","full","author","Marie Roseline Darnycka Belizaire, Otim Patrick Cossy Ramadan, Dick Chamla, Etien Luc Koua, Ebenezer Obi Daniel","body","outline",[],"relatedStories",[],"topics",[58],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_59":60,"_61":62},"slug","research-policy","name","科研政策","政策发布","WHO","https://www.thelancet.com/journals/lancet/article/PIIS0140-6736(26)01980-X/fulltext?rss=yes","The Lancet",{"_68":69,"_70":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","ht9q0vam0857h5jt5w3yswhr2","title","SchistoTrack队列中血吸虫肝纤维化超声诊断者间一致性评估","originalTitle","Evaluation of inter-observer agreement for periportal fibrosis related to Schistosoma mansoni: A population-based study of 3302 individuals using point-of-care ultrasound images and video in the SchistoTrack cohort","summary","某研究团队在 SchistoTrack队列中对3302例血吸虫肝纤维化患者进行超声影像与视频分析，发现诊断者间一致性在广泛模式类别中为73.0%，但严重纤维化模式（E/F）一致性最低（κ=0.149/0.430），建议更新 WHO Niamey协议以优化诊断流程。影像分析显示严重纤维化模式（E/F）诊断者间一致性显著低于其他模式（D模式κ=0.717），视频分析则完全无一致性（κ=0.001）。","reason","研究提供了大规模超声诊断一致性的数据，为优化全球血吸虫病筛查流程提供了依据。","source",{"_70":80},"links",{"_59":79},"publishedAt","2026-11-02T00:00:00.000Z","discoveredAt","2026-11-03T06:29:44.340Z","timelineAt","category","clinical","tags",[78,71,73],"score",74,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author"," Ockenden, E. S., Ho, C., Anguajibi, V., Mpooya, S., Mugume, T., Ntegeka, B., Ntakimanye, R., Tumukunde, I., Nabatte, B., Kabatereine, N. B., Chami, G. F. ","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fYGNbPx8ZX-E","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","clinical-trial","name","临床试验","deepmind","DeepMind",{"_75":76,"_11":77},"publicId","5eced6c4-e276-4e1a-93cd-e00e7f74237b","SchistoTrack队列发现血吸虫肝纤维化超声诊断者间一致性存在显著差异","研究成果","https://www.medrxiv.org/content/10.64898/2026.11.02.26367045v1?rss=1","medRxiv",{"_82":83,"_84":-5},"changelogVersion","2026-10-08T22:43","release"]

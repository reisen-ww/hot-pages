[{"_1":2,"_3":4},"root",{"_5":73},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","ux2ecnm4nhv3r4m216b9w50s3","title","贝尔法斯特女王大学研究：噪声污染使80%动物物种出现生物学或行为改变","originalTitle","Noise pollution changes biology or behavior in 80% of animal species studied","summary","贝尔法斯特女王大学研究团队通过分析214项实验研究（涵盖177种动物），发现噪声污染使80%的物种在生理机能、发育或行为上发生变化。研究指出，在噪声环境中，捕食者搜索猎物的时间增加2.5倍但捕获率下降25%，而猎物则更警觉。该成果发表于《Science》（DOI:10.1126/science.adu9593）。","reason","研究揭示了噪声污染对动物种群行为、捕食关系及生态系统动态的系统性影响，为制定针对性声学管理措施提供依据。","source",{"_71":72},"links",{"_58":70},"publishedAt","2026-11-06T18:20:04.000Z","discoveredAt","2026-11-07T12:11:50.311Z","timelineAt","category","neuroscience","tags",[69],"score",79,"selected",true,"channel","news","story",{"_66":67,"_11":68},"x","readingMode","full","author","body","outline",[],"relatedStories",[65],"topics",[],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","fRzm-2OjtBtk","reportCount",1,"additionalSourceCount",0,{"_66":67,"_11":68},"publicId","1be52640-3885-4c9e-b78d-d1165f3db462","贝尔法斯特女王大学研究：噪声污染致80%动物物种生理或行为改变","研究成果","https://phys.org/news/2026-11-noise-pollution-biology-behavior-animal.html","name","Phys.org",{"_74":75,"_76":-5},"changelogVersion","2026-10-08T22:43","release"]

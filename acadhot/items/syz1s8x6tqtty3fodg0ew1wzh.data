[{"_1":2,"_3":4},"root",{"_5":74},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","syz1s8x6tqtty3fodg0ew1wzh","title","某团队在bioRxiv发表Shikonin通过抑制IGF2相关p38 MAPK信号通路缓解骨癌疼痛的机制研究","originalTitle","Shikonin alleviates bone cancer pain through suppression of spinal IGF2-associated p38 MAPK signaling","summary","某团队在rat模型中证实Shikonin通过抑制IGF2-p38 MAPK信号通路显著缓解骨癌疼痛（ED50为29.80 μg/kg），改善步态异常和焦虑样行为。转录组测序发现Shikonin降低脊髓背角IGF2表达及p38磷酸化水平，同时减少IL-6、IL-1β和TNFα炎症因子。IGF2 siRNA和p38抑制剂验证了信号通路的关键作用，且联合用药未产生协同效应。","reason","论文提供了Shikonin剂量依赖性缓解骨癌疼痛的实验数据，并验证了IGF2-p38 MAPK信号通路的关键作用，为后续靶向治疗研究提供可迁移的机制分析框架。","source",{"_72":73},"links",{"_59":71},"publishedAt","2026-11-07T00:00:00.000Z","discoveredAt","2026-11-07T12:11:45.193Z","timelineAt","category","drug-therapy","tags",[70],"score",61,"selected",true,"channel","news","story",{"_67":68,"_11":69},"x","readingMode","full","author"," Ma, z., Jia, J., Lu, D., Wanying, Y., Xiaogeng, H., Shuyao, Z., Xinfang, F., Jing, Z., Fan, B., Longsheng, X., Ming, Y. ","body","outline",[],"relatedStories",[66],"topics",[],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fRS7iK4bGs-4","reportCount",1,"additionalSourceCount",0,{"_67":68,"_11":69},"publicId","5c9634f9-7ec0-435f-8419-10f5de7dfc9a","某团队预印发表Shikonin抑制IGF2-p38 MAPK通路缓解骨癌疼痛研究","研究成果","https://www.biorxiv.org/content/10.64898/2026.11.06.764749v1?rss=1","name","bioRxiv",{"_75":76,"_77":-5},"changelogVersion","2026-10-08T22:43","release"]

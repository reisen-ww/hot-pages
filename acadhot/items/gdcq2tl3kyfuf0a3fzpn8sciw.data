[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","gdcq2tl3kyfuf0a3fzpn8sciw","title","某研究团队发现原核生物 MVP 同源物可形成工程化 vault 纳米胶囊","originalTitle","Prokaryotic homologs of the major vault protein form engineerable vault nanocapsules","summary","某团队在 bioRxiv 发表预印本，首次证明原核生物 MVP 同源物能组装成 vault 颗粒，并利用尺寸排阻色谱筛选出 8 种大肠杆菌表达的 MVP 同源体。冷冻电镜解析出噬菌体同源物 L05 的壳层结构，其 MVP 链数量与真核生物不同，且可通过增加壁重复单元调控 vault 体积，为纳米胶囊载体开发提供新模型。","reason","研究提供了原核生物 MVP 同源物形成 vault 颗粒的实验方法，其可调控的纳米胶囊结构为药物递送系统开发提供了新思路。","source",{"_69":77},"links",{"_59":78},"publishedAt","2026-11-05T00:00:00.000Z","discoveredAt","2026-11-05T18:20:35.544Z","timelineAt","category","gene-cell","tags",[75,76,77],"score",87,"selected",true,"channel","news","story",{"_72":73,"_11":74},"x","readingMode","full","author"," Athukoralage, J. S., Yoon, P. H., Shanehsazzadeh, A., Kauderer-Abrams, E., Perry, N., Durrant, M. G. ","body","outline",[],"relatedStories",[71],"topics",[66],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fl4pAcagcg2w","reportCount",1,"additionalSourceCount",0,{"_67":68,"_69":70},"slug","protein-structure","name","蛋白质结构与设计",{"_72":73,"_11":74},"publicId","f79f6dff-df7a-4378-b1b6-38abfae55c4d","某团队发现原核生物MVP同源物可工程化组装为vault纳米胶囊","研究成果","蛋白质结构","bioRxiv","https://www.biorxiv.org/content/10.64898/2026.11.04.764334v1?rss=1",{"_80":81,"_82":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":80},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","i5kxgq6cr1ysmapg44mloz8wz","title","Caltech 与 Yale 团队在 Science 发表真实材料中 Kondo 效应的精确计算方法","originalTitle","A famous quantum effect can finally be predicted in real materials","summary","Caltech 与 Yale University 研究人员提出一种基于真实原子和电子结构计算材料中 Kondo 效应的方法，并将结果发表于 Science。该方法在嵌入铜中的 7 种过渡金属原子上进行了测试，对多数元素的预测精度比传统模型方法高至 2 个数量级。","reason","研究将量子化学计算工具用于真实材料中的 Kondo 效应，为评估材料特异性的强关联电子行为提供了可复用的计算路径。","source",{"_69":79},"links",{"_58":78},"publishedAt","2026-10-10T01:59:39.000Z","discoveredAt","2026-10-10T19:29:33.291Z","timelineAt","category","quantum-physics","tags",[77,72],"score",82,"selected",true,"channel","news","story",{"_74":75,"_11":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[65,66],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","ffP_oohU5N10","reportCount",1,"additionalSourceCount",0,{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","conference-paper","name","顶会与论文接收","science","Science",{"_74":75,"_11":76},"publicId","d1758a85-80f6-4ea8-89ea-7f29097e94fc","真实材料中Kondo效应实现精确计算","论文发表","https://www.sciencedaily.com/releases/2026/10/261006234520.htm","ScienceDaily 综合",{"_81":82,"_83":-5},"changelogVersion","2026-10-08T22:43","release"]

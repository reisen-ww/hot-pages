[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","cjaxfvwbhimrkgyhfkn4vyviu","title","某团队利用表面受体平台鉴定并表征新型铜绿假单胞菌噬菌体","originalTitle","Identification and characterization of new P. aeruginosa phages using a surface receptor platform","summary","本研究开发 SURFAR 平台用于快速鉴定铜绿假单胞菌噬菌体的表面受体，成功分离出靶向鞭毛和 LPS 外膜的 Dalewood 噬菌体，以及抑制部分碳青霉烯类耐药临床分离株生长的 Bowman 噬菌体。该平台为噬菌体疗法标准化研究提供新工具。","reason","论文提出了 SURFAR 平台用于标准化噬菌体受体表征，并成功分离出靶向 flagella 和 LPS 的 Dalewood 以及抑制多重耐药菌生长的 Bowman 噬菌体，为噬菌体疗法开发提供新工具。","source",{"_69":77},"links",{"_59":78},"publishedAt","2026-11-07T00:00:00.000Z","discoveredAt","2026-11-08T03:20:34.013Z","timelineAt","category","ai-frontier","tags",[75,76,77],"score",70,"selected",true,"channel","news","story",{"_72":73,"_11":74},"x","readingMode","full","author"," Tran, V. N., Lahane, T. S., Qaderi, I., Harvey, H., Burrows, L. L. ","body","outline",[],"relatedStories",[71],"topics",[66],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","febe3AUPCaHs","reportCount",1,"additionalSourceCount",0,{"_67":68,"_69":70},"slug","protein-structure","name","蛋白质结构与设计",{"_72":73,"_11":74},"publicId","e940bc8a-9edc-47b9-8c1c-9c01b73fe8ae","某团队开发SURFAR平台鉴定新型铜绿假单胞菌噬菌体","研究成果","蛋白质结构","bioRxiv","https://www.biorxiv.org/content/10.64898/2026.11.06.764861v1?rss=1",{"_80":81,"_82":-5},"changelogVersion","2026-10-08T22:43","release"]

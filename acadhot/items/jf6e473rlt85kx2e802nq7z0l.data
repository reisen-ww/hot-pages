[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","jf6e473rlt85kx2e802nq7z0l","title","英国巴斯大学在《柳叶刀·行星健康》发表研究，人类代谢年排放二氧化碳达200亿吨，人口增长是主因","originalTitle","Human bodies produce 2 billion metric tons of CO2 a year just by staying alive","summary","英国巴斯大学团队在《柳叶刀·行星健康》发表研究，人类代谢年排放二氧化碳达200亿吨，人口增长是主因。该研究通过分析个体生命全程的二氧化碳排放数据，结合全球人口与体重数据计算得出1985-2015年间排放量增长74%，其中60%以上归因于人口增加。","reason","source",{"_70":71},"links",{"_57":69},"publishedAt","2026-11-07T10:00:03.000Z","discoveredAt","2026-11-07T12:11:52.660Z","timelineAt","category","clinical","tags",[68],"score",54,"selected",false,"channel","news","story",{"_65":66,"_11":67},"x","readingMode","full","author","body","outline",[],"relatedStories",[64],"topics",[],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","ff7OoaW-M2Gs","reportCount",2,"additionalSourceCount",1,{"_65":66,"_11":67},"publicId","8985645e-298e-41ad-922f-c89ca79b3100","Gonzalez团队研究显示人口增长致人类代谢CO2排放增长74%，数据存在差异","研究成果","https://www.sciencedaily.com/releases/2026/11/261104012305.htm","name","ScienceDaily 综合",{"_73":74,"_75":-5},"changelogVersion","2026-10-08T22:43","release"]

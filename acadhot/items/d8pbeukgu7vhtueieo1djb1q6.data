[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","d8pbeukgu7vhtueieo1djb1q6","title","某研究团队在bioRxiv发表 Klebsiella oxytoca 毒素合成调控新发现","originalTitle","The MarR-family regulator TilR links biosynthesis of enterotoxin tilimycin with physiologic adaptation in Klebsiella oxytoca","summary","某研究团队在 bioRxiv 发表论文揭示 Klebsiella oxytoca 毒素合成关键调控因子 TilR 的分子机制。TilR 通过结合 aroX-NRPS 间隔区 20bp 特异序列抑制毒素基因表达，其高表达状态与营养获取、应激适应及中心代谢调控相关。","reason","论文揭示了TilR作为新型全局调控器的分子机制，其与MarR家族的进化分化为理解肠杆菌毒素合成调控提供了新视角。","source",{"_70":81},"links",{"_59":80},"publishedAt","2026-11-07T00:00:00.000Z","discoveredAt","2026-11-08T02:17:38.198Z","timelineAt","category","life-science","tags",[78,79,73],"score",77,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author"," Unterhauser, K., Grassmann, A. A., Balachandran, P., Provatas, A. A., Zhou, Y., Caimano, M. J., Radolf, J. D., Matson, A. P. ","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","foBLY32p0rg0","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","protein-structure","name","蛋白质结构与设计","deepmind","DeepMind",{"_75":76,"_11":77},"publicId","7de7a364-1675-45e2-995c-1d2461f0e603","某研究团队在bioRxiv揭示Klebsiella oxytoca毒素合成调控机制","研究成果","蛋白质结构","https://www.biorxiv.org/content/10.64898/2026.11.06.765007v1?rss=1","bioRxiv",{"_83":84,"_85":-5},"changelogVersion","2026-10-08T22:43","release"]

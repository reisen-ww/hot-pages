[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","f09u0q30vfz5erdmr6kft9uax","title","某团队在 bioRxiv 发表蛋白口袋协同结合预测药物相互作用的预印本","originalTitle","Protein Pocket Coengagement Prioritizes Drug-Drug Interactions","summary","某团队在预印本平台 bioRxiv 发表研究，提出通过蛋白口袋协同结合预测药物-药物相互作用的方法。该模型在DDInter数据集上达到49.3%的精度，优于背景分布29.6%；在KEGG数据集上达到25.1%的精度，优于背景14.7%。研究验证了蛋白口袋直接或非接触结合对药物相互作用的影响机制","reason","论文给出了基于蛋白口袋协同结合的药物相互作用预测方法，其精度在DDInter数据集上达到49.3%，可作为药物研发中的辅助工具","source",{"_71":84},"links",{"_59":83},"publishedAt","2026-11-03T00:00:00.000Z","discoveredAt","2026-11-03T18:52:37.172Z","timelineAt","category","ai-frontier","tags",[81,82,76],"score",68,"selected",true,"channel","news","story",{"_78":79,"_11":80},"x","readingMode","full","author"," Skolnick, J., Srinivasan, B. ","body","outline",[],"relatedStories",[77],"topics",[66,67,68],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fFyR6owOdbys","reportCount",1,"additionalSourceCount",0,{"_69":75,"_71":76},{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","conference-paper","name","顶会与论文接收","protein-structure","蛋白质结构与设计","deepmind","DeepMind",{"_78":79,"_11":80},"publicId","c0fb2b50-25e4-48af-8e96-594d6311b137","DeepMind发表预印本：蛋白口袋协同结合预测药物相互作用新方法","论文发表","蛋白质结构","https://www.biorxiv.org/content/10.64898/2026.10.28.762582v1?rss=1","bioRxiv",{"_86":87,"_88":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","h51s0b2w7l2enxb4l4zwx7rf1","title","某研究团队在 medRxiv 发布摩洛哥北部结核病耐药性四年监测分析","originalTitle","Routine Xpert MTB/XDR for Tuberculosis Drug-Resistance Surveillance in Northern Morocco: A Four-Year Programmatic Analysis","summary","某研究团队发布摩洛哥北部四年结核病耐药性监测数据，检测到 203 例结核分枝杆菌复合体（78.7%），其中 75/188 例（39.9%）对利福平耐药，71/192 例（37.0%）对异烟肼耐药，51/184 例（27.7%）多重耐药。","reason","该研究提供了 Xpert MTB/XDR 检测系统在结核病耐药性监测中的实际应用数据，并揭示了分子耐药性模式，为后续整合分子监测与表型测试提供依据。","source",{"_70":80},"links",{"_59":79},"publishedAt","2026-11-05T00:00:00.000Z","discoveredAt","2026-11-05T17:48:35.863Z","timelineAt","category","clinical","tags",[78,71,73],"score",65,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author"," Ez-Zari, A., Boulaich, A., Bouti, K., Mennane, Z., Elmtili, N., Mezzoug, N. ","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fT3EGISGvAEM","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","clinical-trial","name","临床试验","deepmind","DeepMind",{"_75":76,"_11":77},"publicId","87899873-263f-4c68-a525-44efe55e5082","摩洛哥北部结核病耐药性监测显示多重耐药率27.7%，Xpert MTB/XDR检测数据发布","研究成果","https://www.medrxiv.org/content/10.64898/2026.11.05.26364787v1?rss=1","medRxiv",{"_82":83,"_84":-5},"changelogVersion","2026-10-08T22:43","release"]

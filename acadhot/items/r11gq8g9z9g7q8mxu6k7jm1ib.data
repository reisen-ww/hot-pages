[{"_1":2,"_3":4},"root",{"_5":73},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":34,"_52":53,"_54":55,"_56":34,"_57":58},"id","r11gq8g9z9g7q8mxu6k7jm1ib","title","Citrobacter rodentium 感染破坏结肠黏液屏障功能","originalTitle","Citrobacter rodentium infection disrupts colonic mucus barrier function via ablation of intercrypt goblet cells","summary","研究发现，Citrobacter rodentium 感染早期破坏内层黏液层，增加黏液渗透性，并导致粪便黏液层厚度改变。缺失 Spdef 基因的小鼠表现出内层黏液层完整性受损和隐窝入侵增加，表明隐窝间杯状细胞对于维持内层黏液层的完整性和保护上皮细胞至关重要。","reason","source",{"_71":72},"links",{"_58":70},"publishedAt","2026-11-07T00:00:00.000Z","discoveredAt","2026-11-08T02:17:38.159Z","timelineAt","category","life-science","tags",[69],"score",37,"selected",false,"channel","news","story",{"_66":67,"_11":68},"x","readingMode","full","author"," Subramani, M. V., Bailo, J. S., Hansson, K. T., Vereecke, L., Nyström, E. E. L., Blancke, G., Gustafsson, J. K., Birchenough, G. M. H. ","body","outline",[],"relatedStories",[65],"topics",[],"indexable","markdownAvailable",true,"group",{"_59":60,"_61":62,"_63":64},"hasTranslation","bodyLanguage","original","factId","fZ9pTUUWy6Ac","reportCount",1,"additionalSourceCount",0,{"_66":67,"_11":68},"publicId","9176c953-288f-457d-b9c6-44aadc7b579c","Citrobacter rodentium感染破坏结肠黏液屏障机制研究","研究成果","https://www.biorxiv.org/content/10.64898/2026.11.07.764371v1?rss=1","name","bioRxiv",{"_74":75,"_76":-5},"changelogVersion","2026-10-08T22:43","release"]

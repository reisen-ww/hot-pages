[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","cc6e22c16c1vxwpkwkfr0rkhp","title","AI 在考古学中的应用与挑战","originalTitle","AI won't ever make a historically accurate film—but it could help archaeology create better stories","summary","虽然 Elon Musk 使用 AI 制作了一部声称历史准确的《奥德赛》电影片段，但考古学家指出，任何试图制作完整连贯视觉叙事的努力都不可避免地需要 AI 填补证据不足的空白，这会导致不准确。考古学本质上处理的是碎片化的记录，AI 生成的图像可能会基于现有媒体填补这些空白，导致看似准确但实际上是虚构的内容。考古学的目标是展示证据的空白，而非填补它们。","reason","source",{"_67":78},"links",{"_57":77},"publishedAt","2026-11-06T19:20:11.000Z","discoveredAt","2026-11-07T12:11:48.714Z","timelineAt","category","ai-frontier","tags",[73,74,75,76],"score",30,"selected",false,"channel","news","story",{"_70":71,"_11":72},"x","readingMode","full","author","body","outline",[],"relatedStories",[69],"topics",[64],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","fy8uMBsM2UlA","reportCount",1,"additionalSourceCount",0,{"_65":66,"_67":68},"slug","conference-paper","name","顶会与论文接收",{"_70":71,"_11":72},"publicId","193d99bf-1ec8-42f7-8b63-6f2c49ec679d","考古学家批评AI填补历史空白导致不准确，强调不确定性展示重要性","论文发表","研究成果","DeepMind","OpenAI","https://phys.org/news/2026-11-ai-wont-historically-accurate-archaeology.html","Phys.org",{"_80":81,"_82":-5},"changelogVersion","2026-10-08T22:43","release"]

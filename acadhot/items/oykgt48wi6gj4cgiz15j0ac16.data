[{"_1":2,"_3":4},"root",{"_5":80},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","oykgt48wi6gj4cgiz15j0ac16","title","郭磊《唯波生物学》提出生命波动六级嵌套新范式","originalTitle","《唯波生物学》概要与目录","summary","郭磊提出生命是波动结构的六级嵌套（分子波至生态波），健康是动态平衡的兼容带，疾病源于某一层级波动的相位错位谱系。书中建立波动组学（WBC-05）与相位可重复性定理（WBC-07），提出治疗需匹配药物波与靶点波的干涉相位（WBC-04）。","reason","source",{"_68":79},"links",{"_57":78},"publishedAt","2026-11-07T11:58:36.000Z","discoveredAt","2026-11-08T01:09:31.202Z","timelineAt","category","life-science","tags",[76,77,71],"score",52,"selected",false,"channel","news","story",{"_73":74,"_11":75},"x","readingMode","full","author","body","outline",[],"relatedStories",[72],"topics",[64,65],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","fB79y-hGAUVI","reportCount",1,"additionalSourceCount",0,{"_66":70,"_68":71},{"_66":67,"_68":69},"slug","conference-paper","name","顶会与论文接收","deepmind","DeepMind",{"_73":74,"_11":75},"publicId","244d3e08-331a-4ad6-aab6-ebb8fa3271ff","郭磊提出生命波动六级嵌套新范式及治疗理论框架","论文发表","研究成果","http://blog.sciencenet.cn/home.php?mod=space&uid=230383&do=blog&id=1560167","科学网博客",{"_81":82,"_83":-5},"changelogVersion","2026-10-08T22:43","release"]

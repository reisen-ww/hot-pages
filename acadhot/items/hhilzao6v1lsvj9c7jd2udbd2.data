[{"_1":2,"_3":4},"root",{"_5":76},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","hhilzao6v1lsvj9c7jd2udbd2","title","脑机海河实验室完成全国首个非侵入式脑机接口临床研究备案","originalTitle","全国首个非侵入式脑机接口临床研究项目完成备案","summary","《SCS联合无创脑控混动外骨骼训练治疗慢性卒中下肢运动障碍的安全性与可行性探索研究》项目于2026年5月《生物医学新技术临床研究和转化应用管理条例》施行后完成国家卫健委备案，标志着中国非侵入式脑机接口技术进入规范化临床研究阶段。项目核心设备为海河实验室研发的‘神工-神驰’系统，用于慢性卒中患者神经康复干预。","reason","项目备案标志着中国非侵入式脑机接口进入规范化临床研究阶段，设备研发方为海河实验室。","source",{"_68":75},"links",{"_58":74},"publishedAt","2026-11-06T05:49:30.000Z","discoveredAt","2026-11-06T06:42:47.870Z","timelineAt","category","clinical","tags",[69],"score",85,"selected",true,"channel","news","story",{"_71":72,"_11":73},"x","readingMode","full","author","body","outline",[],"relatedStories",[70],"topics",[65],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","ftPLtULQEEZA","reportCount",1,"additionalSourceCount",0,{"_66":67,"_68":69},"slug","clinical-trial","name","临床试验",{"_71":72,"_11":73},"publicId","39ed9aca-6154-4169-b83d-5337e514b1c3","中国首个非侵入式脑机接口临床研究备案完成","https://36kr.com/newsflashes/4057860842198153?f=rss","36氪",{"_77":78,"_79":-5},"changelogVersion","2026-10-08T22:43","release"]

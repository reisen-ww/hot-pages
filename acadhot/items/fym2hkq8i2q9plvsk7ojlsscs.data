[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","fym2hkq8i2q9plvsk7ojlsscs","title","某团队在 bioRxiv 发表铜绿假单胞菌蛋白水解反馈促进感染的研究","originalTitle","Proteolytic feedback of quorum sensing promotes infection by Pseudomonas aeruginosa","summary","某团队在 bioRxiv 发表铜绿假单胞菌蛋白水解反馈促进感染的研究，研究显示 RhlR 蛋白通过自限性负反馈循环调控自身水平，影响生物膜形成和急性小鼠肺部感染中的致病性。具体机制涉及 PqsE 结合保护 RhlR N 端降解基序，以及 RhlR 激活 clpP2 基因表达，形成蛋白水解反馈环路。","reason","论文揭示了蛋白水解反馈调控细菌群体感应的机制，为后续研究提供了新视角。","source",{"_69":78},"links",{"_59":77},"publishedAt","2026-11-03T00:00:00.000Z","discoveredAt","2026-11-04T04:09:58.826Z","timelineAt","category","life-science","tags",[75,76],"score",79,"selected",true,"channel","news","story",{"_72":73,"_11":74},"x","readingMode","full","author"," Mallery, C. P., Fernandes, S. E., Schumacher, M. L., Pope, A. N., Dillow, H. K., Mendoza, A. G., Jorth, P. A., Paczkowski, J. ","body","outline",[],"relatedStories",[71],"topics",[66],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","f6tXXSMhhCbc","reportCount",1,"additionalSourceCount",0,{"_67":68,"_69":70},"slug","protein-structure","name","蛋白质结构与设计",{"_72":73,"_11":74},"publicId","a1b5176d-47d6-46da-b665-678ee8407ce2","铜绿假单胞菌RhlR蛋白水解反馈机制促进感染研究发布","研究成果","蛋白质结构","https://www.biorxiv.org/content/10.64898/2026.11.02.763748v1?rss=1","bioRxiv",{"_80":81,"_82":-5},"changelogVersion","2026-10-08T22:43","release"]

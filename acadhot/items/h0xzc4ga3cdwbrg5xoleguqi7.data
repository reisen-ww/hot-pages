[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","h0xzc4ga3cdwbrg5xoleguqi7","title","某研究团队在 bioRxiv 发表双激酶抑制治疗帕金森病模型研究","originalTitle","Dual kinase inhibition provides early clues to restoration of neuroimmune homeostasis in an AAV-haSyn model of Parkinsons disease","summary","某研究团队通过单侧AAV-haSyn注射建立早期进展性帕金森病模型，并验证每日口服URMC-099可显著缓解神经退行性病变及运动障碍。免疫组化分析显示神经元完整性保护，转录组学验证双激酶抑制的机制，微胶质细胞自噬通路改善与病理缓解相关。研究提出MLK3/LRRK2双重抑制疗法可能适用于多种病因的帕金森患者。","reason","该研究提出了一种新型双激酶抑制疗法，可能为广泛病因的帕金森病提供治疗新思路，并揭示了微胶质细胞自噬通路的调节机制。","source",{"_69":78},"links",{"_59":77},"publishedAt","2026-11-07T00:00:00.000Z","discoveredAt","2026-11-07T12:11:45.475Z","timelineAt","category","neuroscience","tags",[75,76],"score",72,"selected",true,"channel","news","story",{"_72":73,"_11":74},"x","readingMode","full","author"," Chiang, W., Sandoval, I. M., Li, H., Bernal-Conde, L. D., Squire, R., Washburn, M. K., Schwartz, J. L., Squire, E., Wagner, E. J., Manfredsson, F. P., Gelbard, H. A. ","body","outline",[],"relatedStories",[71],"topics",[66],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fNSM2wmV2-oE","reportCount",1,"additionalSourceCount",0,{"_67":68,"_69":70},"slug","alzheimers","name","阿尔茨海默与神经退行",{"_72":73,"_11":74},"publicId","5ad3c3eb-bdee-4771-97e0-bf8134392bf2","MLK3/LRRK2双重抑制疗法或拓展帕金森病治疗路径","研究成果","帕金森","https://www.biorxiv.org/content/10.64898/2026.11.06.764938v1?rss=1","bioRxiv",{"_80":81,"_82":-5},"changelogVersion","2026-10-08T22:43","release"]

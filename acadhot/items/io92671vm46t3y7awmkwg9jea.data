[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","io92671vm46t3y7awmkwg9jea","title","BacLLM框架通过语言引导的领域适应提升蛋白质序列表示助力抗生素耐药性分析","originalTitle","Language-guided domain adaptation improves protein sequence rep-resentations for antimicrobial resistance analysis","summary","BacLLM框架通过序列增强、语义注释丰富（UniProt）和跨模态对比学习，将语言模型编码的注释先验转移到序列编码器。相比基线，该框架在WHO优先细菌病原体中实现了单 residue分辨率突变信号捕捉，保留了表型分组未反映的物种分类关系，并在TolC蛋白关联网络中恢复耐药相关功能组织。","reason","该框架通过整合注释来源的功能知识，显著提升了耐药基因识别和机制预测的准确性，为数字监测和疗法开发提供了新工具。","source",{"_70":81},"links",{"_59":80},"publishedAt","2026-11-05T00:00:00.000Z","discoveredAt","2026-11-06T02:49:24.390Z","timelineAt","category","ai-frontier","tags",[78,79,73],"score",68,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author"," Ye, R., Li, L., Geng, Z., Song, S. ","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fphbrZZENMMA","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","conference-paper","name","顶会与论文接收","openai","OpenAI",{"_75":76,"_11":77},"publicId","38f0d48f-3e8a-4a30-bf6f-e1527f200c5a","BacLLM框架通过语言引导提升抗生素耐药性分析能力","论文发表","研究成果","https://www.biorxiv.org/content/10.64898/2026.11.04.764426v1?rss=1","bioRxiv",{"_83":84,"_85":-5},"changelogVersion","2026-10-08T22:43","release"]

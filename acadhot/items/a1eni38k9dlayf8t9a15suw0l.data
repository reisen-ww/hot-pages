[{"_1":2,"_3":4},"root",{"_5":73},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","a1eni38k9dlayf8t9a15suw0l","title","我国完成千公里空芯光纤双向实时传输验证创纪录","originalTitle","千公里仅3.43毫秒，我国新一代通信网技术取得新突破","summary","我国科研团队完成全球首个1007.48公里空芯光纤双向实时传输验证，单程传输时延3.43毫秒，双向各64Tb/s传输容量，相当于每秒160部4K电影传输量。较现有实芯光纤技术，容量提升100%，传输距离提升60%；与同类空芯光纤试验相比，传输距离提升50倍。央视新闻提供原始试验数据与验证方法。","reason","该技术验证为我国在通信网关键领域提供了可迁移的实验方法，其传输距离与容量的提升数据可作为同类研究的性能基准参考。","source",{"_71":72},"links",{"_58":70},"publishedAt","2026-11-08T03:23:56.000Z","discoveredAt","2026-11-08T03:30:32.651Z","timelineAt","category","quantum-physics","tags",[69],"score",82,"selected",true,"channel","news","story",{"_66":67,"_11":68},"x","readingMode","full","author","body","outline",[],"relatedStories",[65],"topics",[],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","ffDT5pQ40zbU","reportCount",1,"additionalSourceCount",0,{"_66":67,"_11":68},"publicId","a5c96bd0-c042-4b3c-ac82-1f7791491835","我国科研团队实现千公里空芯光纤双向传输创纪录","研究成果","https://36kr.com/newsflashes/4060440184050821?f=rss","name","36氪",{"_74":75,"_76":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":75},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":-5,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":40,"_41":-5,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":33,"_50":51,"_52":53,"_54":33,"_55":56},"id","mjnc4ny5rpdn3agpp55h40oqt","title","第六届全国红楼梦学术研讨会安徽芜湖会议合影","originalTitle","《红学师友》第六届全国红楼梦学术研讨会安徽芜湖会议（1988.5）","summary","第六届全国红楼梦学术研讨会于1988年5月在安徽芜湖召开，合影中包括沈天佑、曾扬华、胡绍棠等多位红学专家。安徽师大俞晓红教授为此做出了巨大努力，希望与会者和红学爱好者能够列出照片中所有人的名字。","reason","source",{"_66":74},"links",{"_56":73},"publishedAt","2026-11-07T04:35:24.000Z","discoveredAt","2026-11-07T09:33:32.845Z","timelineAt","category","tags",[72],"score",17,"selected",false,"channel","news","story",{"_69":70,"_11":71},"x","readingMode","full","author","body","outline",[],"relatedStories",[68],"topics",[63],"indexable","markdownAvailable",true,"group",{"_57":58,"_59":60,"_61":62},"hasTranslation","bodyLanguage","original","factId","f3zD0hCKYQUg","reportCount",1,"additionalSourceCount",0,{"_64":65,"_66":67},"slug","conference-paper","name","顶会与论文接收",{"_69":70,"_11":71},"publicId","457b0272-c6cb-4954-a370-4ace085e50ce","发布第六届全国红楼梦学术研讨会合影并呼吁列出人名","论文发表","http://blog.sciencenet.cn/home.php?mod=space&uid=415&do=blog&id=1560132","科学网博客",{"_76":77,"_78":-5},"changelogVersion","2026-10-08T22:43","release"]

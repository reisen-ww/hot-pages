[{"_1":2,"_3":4},"root",{"_5":67},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":-5,"_14":15,"_16":-5,"_17":18,"_19":20,"_21":22,"_23":24,"_25":24,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":-5,"_37":-5,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":33,"_49":50,"_51":-5,"_52":33,"_53":54},"id","rac3m19834lm7ffcdnct5wv1w","title","AI时代如何保持独立思考——从《自然》的讨论谈批判性思维培养","originalTitle","summary","《自然》发表专题文章讨论生成式AI对批判性思维的影响，指出AI虽能提高任务表现，但可能削弱学生独立思考能力。研究发现，依赖AI的学生在撤除AI后表现更差，强调批判性思维需结合知识积累与主动思考。文章提出培养批判性思维的方法，包括培养元认知、信息核查、主动解释和保留认知努力。","reason","source",{"_58":66},"links",{"_54":65},"publishedAt","2026-11-07T10:40:04.000Z","discoveredAt","2026-11-07T15:20:11.725Z","timelineAt","category","ai-frontier","tags",[60,61,62,63,64],"score",48,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[55],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_56":57,"_58":59},"slug","conference-paper","name","顶会与论文接收","论文发表","研究成果","DeepMind","OpenAI","NVIDIA","http://blog.sciencenet.cn/home.php?mod=space&uid=3658560&do=blog&id=1560164","科学网博客",{"_68":69,"_70":-5},"changelogVersion","2026-10-08T22:43","release"]

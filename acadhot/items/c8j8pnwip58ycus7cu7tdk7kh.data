[{"_1":2,"_3":4},"root",{"_5":65},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":24,"_28":-5,"_29":30,"_31":32,"_33":34,"_35":36,"_37":-5,"_38":-5,"_39":40,"_41":42,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":34,"_52":-5,"_53":54,"_55":56},"id","c8j8pnwip58ycus7cu7tdk7kh","title","特朗普政府调查9所大学涉嫌滥用J-1签证","originalTitle","Trump administration investigates 9 universities for alleged visa fraud","summary","特朗普政府宣布调查9所大学涉嫌与J-1签证相关的欺诈行为，调查由美国劳工部开展，监察长办公室已向相关高校发出传票。副总统JD Vance称，这些学校将J-1签证用于联邦资助研究的比例为61%，全国平均为38%，但STAT未获官方说明数据来源；美国国家科学基金会数据显示，科学、工程和健康领域近60%的博士后持临时签证。","reason","调查涉及国际博士后签证使用、联邦科研资助与高校合规，文中也呈现了相关数据来源和受调查高校的回应。","source",{"_60":64},"links",{"_56":63},"publishedAt","2026-10-08T23:09:27.000Z","discoveredAt","2026-10-08T23:56:54.091Z","timelineAt","category","tags",[62],"score",76,"selected",true,"channel","news","story","x","readingMode","full","author","Jonathan Wosen","body","outline",[],"relatedStories",[],"topics",[57],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_58":59,"_60":61},"slug","research-policy","name","科研政策","政策发布","https://www.statnews.com/2026/10/08/trump-administration-investigates-universities-j1-visa-fraud/?utm_campaign=rss","STAT News",{"_66":67,"_68":-5},"changelogVersion","2026-10-08T22:43","release"]

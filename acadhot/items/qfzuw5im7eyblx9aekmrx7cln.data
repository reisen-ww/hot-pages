[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","qfzuw5im7eyblx9aekmrx7cln","title","UC Santa Cruz 在 Nature Neuroscience 发表裸盖菇素重塑大脑结构的新机制研究","originalTitle","Magic mushrooms rewire the brain in a way scientists didn't expect","summary","加州大学圣克鲁斯分校团队在《自然·神经科学》发表研究，发现裸盖菇素通过激活5-HT2AR受体，24小时内显著增加小鼠海马体和皮层突触树突棘数量，其中慢性压力小鼠突触重塑效果提升3倍。","reason","source",{"_67":76},"links",{"_57":75},"publishedAt","2026-11-07T00:33:47.000Z","discoveredAt","2026-11-07T12:11:40.964Z","timelineAt","category","neuroscience","tags",[73,74],"score",58,"selected",false,"channel","news","story",{"_70":71,"_11":72},"x","readingMode","full","author","body","outline",[],"relatedStories",[69],"topics",[64],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","fmh3rvungq-g","reportCount",1,"additionalSourceCount",0,{"_65":66,"_67":68},"slug","alzheimers","name","阿尔茨海默与神经退行",{"_70":71,"_11":72},"publicId","4ea2a56c-00b7-46d1-9a43-443340cf228b","UC Santa Cruz研究揭示裸盖菇素24小时内重塑小鼠大脑突触结构","研究成果","阿尔茨海默","https://www.sciencedaily.com/releases/2026/11/261104012308.htm","ScienceDaily 健康医学",{"_78":79,"_80":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","cmv1blu6l08jnkuvzvspbur0j","title","ESA Hera探测器拍摄到DART撞击小行星的近距离影像","originalTitle","ESA Hera 探测器发回 DART 撞击的小行星照片","summary","ESA Hera探测器首次近距离拍摄到双小行星系统Didymos-Dimorphos的影像，揭示主星Didymos新一面貌的地貌特征。影像显示该面存在撞击坑、沟槽等结构，并推测2022年DART撞击产生的喷出物已影响主星表面。Hera后续将系统分析轨道变化与地表特征关联性，评估偏转技术的可行性。","reason","source",{"_70":71},"links",{"_57":69},"publishedAt","2026-11-07T16:17:09.000Z","discoveredAt","2026-11-07T17:15:13.029Z","timelineAt","category","quantum-physics","tags",[68],"score",52,"selected",false,"channel","news","story",{"_65":66,"_11":67},"x","readingMode","full","author","body","outline",[],"relatedStories",[64],"topics",[],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","fZWGvAO2qdzA","reportCount",2,"additionalSourceCount",1,{"_65":66,"_11":67},"publicId","599d8b5e-64f0-4546-a939-9b883c53014f","ESA Hera首次清晰观测双小行星系统 Didymos 和 Dimorphos","研究成果","https://www.solidot.org/story?sid=85825","name","奇客 Solidot",{"_73":74,"_75":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","c0yql0s1o4i766u6kmy6v3bhv","title","某研究团队发现吸入除草剂 paraquat 导致小鼠雄性特异性多巴胺能神经元损伤及运动障碍","originalTitle","Paraquat Inhalation Produces Male-Biased Dopaminergic Neuron Loss and Motor Deficits in Mice: Relevance to Parkinsons Disease","summary","某研究团队通过吸入途径暴露小鼠发现，60天暴露后雄性小鼠出现多巴胺能神经元特异性减少及运动障碍，脑中 paraquat 浓度最高位于嗅球，其次为前额叶和脑干。","reason","该研究通过吸入途径模拟人类暴露，揭示了雄性小鼠多巴胺能神经元特异性损伤，为帕金森病机制和暴露评估提供新证据。","source",{"_69":77},"links",{"_59":78},"publishedAt","2026-11-03T00:00:00.000Z","discoveredAt","2026-11-03T19:24:40.951Z","timelineAt","category","neuroscience","tags",[75,76,77],"score",81,"selected",true,"channel","news","story",{"_72":73,"_11":74},"x","readingMode","full","author"," Reina-Gonzalez, P. J., Boos, J. R., Abu-Salah, A., Anchan, A., Strazdins, R., Ay, M., Shah, A., Chalupa, D., Richardson, J. J., Sarkar, S., Cory-Slechta, D. ","body","outline",[],"relatedStories",[71],"topics",[66],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fnQaxmdhSzpQ","reportCount",1,"additionalSourceCount",0,{"_67":68,"_69":70},"slug","alzheimers","name","阿尔茨海默与神经退行",{"_72":73,"_11":74},"publicId","2d0d8ef1-5a61-490d-95a7-10e695a1fbe6","吸入除草剂paraquat致小鼠雄性多巴胺能神经元损伤及运动障碍","研究成果","帕金森","bioRxiv","https://www.biorxiv.org/content/10.64898/2026.11.02.761058v1?rss=1",{"_80":81,"_82":-5},"changelogVersion","2026-10-08T22:43","release"]

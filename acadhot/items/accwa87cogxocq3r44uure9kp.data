[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","accwa87cogxocq3r44uure9kp","title","某团队在bioRxiv发表AAVS1 FRT细胞系工程与表征研究","originalTitle","Engineering and characterisation of AAVS1 FRT cell lines for inducible and dose-dependent gene expression","summary","某团队在AAVS1安全港位点构建了可诱导且剂量依赖的FRT稳定细胞系，通过CRISPR/Cas9 nickase技术整合TetOn3G-FRT Cassette。全基因组测序显示精准杂合插入，多组学分析证实未显著干扰细胞稳态。该平台为分子生物学研究提供高效稳定的诱导型基因表达系统。","reason","该研究提供了AAVS1 FRT细胞系的可重复构建方法，适用于需要精准基因表达调控的后续实验。","source",{"_69":77},"links",{"_59":78},"publishedAt","2026-11-02T00:00:00.000Z","discoveredAt","2026-11-02T17:58:28.018Z","timelineAt","category","gene-cell","tags",[75,76,77],"score",76,"selected",true,"channel","news","story",{"_72":73,"_11":74},"x","readingMode","full","author"," Portillo Malumbres, M., Ellingboe, L., Roberti, A., Nashchekina, O., Sialana, F. J., Pines, J., Choudhary, J. S., Mansfeld, J., Davey, N. E. ","body","outline",[],"relatedStories",[71],"topics",[66],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fY7nereWxr7w","reportCount",1,"additionalSourceCount",0,{"_67":68,"_69":70},"slug","gene-editing","name","基因编辑与 CRISPR",{"_72":73,"_11":74},"publicId","76a8503a-df3a-474b-9f0f-c6d310152293","AAVS1安全港位点构建可诱导FRT细胞系并通过多组学验证稳定性","研究成果","CRISPR","bioRxiv","https://www.biorxiv.org/content/10.64898/2026.10.29.762215v1?rss=1",{"_80":81,"_82":-5},"changelogVersion","2026-10-08T22:43","release"]

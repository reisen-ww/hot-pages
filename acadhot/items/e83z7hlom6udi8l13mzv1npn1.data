[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","e83z7hlom6udi8l13mzv1npn1","title","Northeastern University 随机可行性试验：音乐同步光刺激显著改善阿尔茨海默病认知障碍患者记忆测试结果","originalTitle","Music-Synchronized Gamma Light Stimulation Strengthens Theta-Gamma Coupling in Older Adults with Cognitive Impairment: Results from a Randomized Feasibility Trial","summary","一项纳入38名阿尔茨海默病认知障碍患者的随机可行性试验显示，接受音乐同步39Hz伽马光刺激的19名受试者（实验组）在面部-姓名关联任务和ADAS-Cog量表上均显著优于仅接受delta波段光刺激的对照组（n=19）。","reason","该试验首次验证音乐同步光刺激对阿尔茨海默病认知障碍患者的干预效果，并发现theta-gamma耦合增强与记忆改善存在关联","source",{"_70":82},"links",{"_59":81},"publishedAt","2026-11-06T00:00:00.000Z","discoveredAt","2026-11-07T12:11:43.656Z","timelineAt","category","clinical","tags",[71,78,79,80],"score",76,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author"," Kubit, B. M., Asthagiri, A., Lopez, K. L., Wang, J., Parrish, C., Trebour, B., Zhao, Z., Yesil, D., Toivonen, A., Jacobowitz, A., Quigley, B., Wu, X., Kim, J. C., Large, E. W., Loui, P. ","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","f9qRxH6Odw1s","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","clinical-trial","name","临床试验","alzheimers","阿尔茨海默与神经退行",{"_75":76,"_11":77},"publicId","2ec44415-f42f-4e4b-8f92-2b8b762108f5","Northeastern University试验：音乐同步39Hz光刺激改善阿尔茨海默病记忆测试","阿尔茨海默","DeepMind","NIH","https://www.medrxiv.org/content/10.64898/2026.11.06.26367319v1?rss=1","medRxiv",{"_84":85,"_86":-5},"changelogVersion","2026-10-08T22:43","release"]

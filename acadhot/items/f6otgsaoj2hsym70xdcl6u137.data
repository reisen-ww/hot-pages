[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","f6otgsaoj2hsym70xdcl6u137","title","唐本忠院士团队开发AIE-MXene水凝胶实现脉络膜黑色素瘤双模态协同治疗","originalTitle","唐本忠院士等：AIE-MXene 水凝胶助力脉络膜黑色素瘤治疗","summary","唐本忠院士团队在《Nano-Micro Letters》发表新型AIE-MXene纳米平台，通过近红外光热与光动力协同治疗，实现脉络膜黑色素瘤的精准诊疗。该平台利用72小时控释水凝胶实现“一次注射、多次治疗”，并验证了溶酶体-线粒体双细胞器递送机制。","reason","source",{"_67":76},"links",{"_57":75},"publishedAt","2026-11-07T03:54:04.000Z","discoveredAt","2026-11-07T08:13:34.819Z","timelineAt","category","clinical","tags",[73,74],"score",73,"selected",false,"channel","news","story",{"_70":71,"_11":72},"x","readingMode","full","author","body","outline",[],"relatedStories",[69],"topics",[64],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","fox4tbO1oVlY","reportCount",1,"additionalSourceCount",0,{"_65":66,"_67":68},"slug","conference-paper","name","顶会与论文接收",{"_70":71,"_11":72},"publicId","c7ac922f-5049-4a84-bbe1-997a1f69f222","唐本忠团队开发AIE-MXene水凝胶协同治疗脉络膜黑色素瘤","论文发表","研究成果","http://blog.sciencenet.cn/home.php?mod=space&uid=3411509&do=blog&id=1560126","科学网博客",{"_78":79,"_80":-5},"changelogVersion","2026-10-08T22:43","release"]

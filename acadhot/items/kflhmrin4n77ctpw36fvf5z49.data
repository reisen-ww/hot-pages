[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","kflhmrin4n77ctpw36fvf5z49","title","清华大学邓兵课题组在《Nature Reviews Clean Technology》发表退役风电叶片闪电解热再生研究","originalTitle","几千度电光一闪，退役叶片成了新叶片的“填料”","summary","清华大学邓兵课题组在《Nature Reviews Clean Technology》发表研究，通过闪光焦耳热技术将退役风电叶片转化为碳化硅-石墨烯复合填料，实验室数据显示掺量0.3%时可使环氧树脂基材杨氏模量提升27%，拉伸强度提高11%，热扩散系数同步改善。","reason","source",{"_70":71},"links",{"_57":69},"publishedAt","2026-11-07T02:10:16.000Z","discoveredAt","2026-11-07T07:25:51.803Z","timelineAt","category","materials-energy","tags",[68],"score",69,"selected",false,"channel","news","story",{"_65":66,"_11":67},"x","readingMode","full","author","body","outline",[],"relatedStories",[64],"topics",[],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","fjeA6O0FJFE4","reportCount",1,"additionalSourceCount",0,{"_65":66,"_11":67},"publicId","ac5ee9bd-2733-4a8f-ac04-fd0f93f715ca","清华大学开发风电叶片闪电解热再生技术，实验室数据证实材料性能提升","研究成果","http://blog.sciencenet.cn/home.php?mod=space&uid=52206&do=blog&id=1560116","name","科学网博客",{"_73":74,"_75":-5},"changelogVersion","2026-10-08T22:43","release"]

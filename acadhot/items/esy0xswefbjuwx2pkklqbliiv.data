[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":-5,"_54":55,"_56":57},"id","esy0xswefbjuwx2pkklqbliiv","title","联合国Cali Fund计划要求企业使用公共遗传数据时付费，但实际年筹集额仅达预估的10%","originalTitle","Biotech firms are meant to pay to use Earth’s genetic data. They’re not.","summary","联合国Cali Fund计划要求企业使用公共遗传数据时付费，但实际年筹集额仅达预估的10%。目前仅5家生物技术公司（包括Prozomix已贡献$5000）参与，大型AI生物公司如Isomorphic Labs（5月获$2亿融资）和Basecamp Research（9月获$1400万融资）尚未加入。","reason","Cali Fund的自愿性质导致实际资金筹集远低于预期，为全球生物多样性保护资金机制提供对比案例。","source",{"_63":68},"links",{"_57":71},"publishedAt","2026-11-03T00:00:00.000Z","discoveredAt","2026-11-03T18:52:36.624Z","timelineAt","category","gene-cell","tags",[69,70,68],"score",61,"selected",true,"channel","news","story","x","readingMode","full","author","James Dinneen","body","outline",[],"relatedStories",[],"topics",[58,59,60],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_61":67,"_63":68},{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","research-policy","name","科研政策","conference-paper","顶会与论文接收","nature","Nature","论文发表","政策发布","https://www.nature.com/articles/d41586-026-03554-6",{"_73":74,"_75":-5},"changelogVersion","2026-10-08T22:43","release"]

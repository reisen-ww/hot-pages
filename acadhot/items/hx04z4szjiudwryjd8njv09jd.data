[{"_1":2,"_3":4},"root",{"_5":75},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":-5,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":40,"_41":-5,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":33,"_50":51,"_52":53,"_54":33,"_55":56},"id","hx04z4szjiudwryjd8njv09jd","title","人力资源社会保障部公布前三季度补贴性培训超800万人次","originalTitle","跟着产业学技能 前三季度补贴性培训超800万人次","summary","人力资源社会保障部公布前三季度补贴性培训超800万人次，覆盖21岁高级维修工程师等职业群体。今年国家分领域分行业推进职业技能提升，支持龙头企业构建招工-培训-评价-就业链条，荣阔等学员通过培训晋升为高级维修工程师。","reason","source",{"_66":74},"links",{"_56":73},"publishedAt","2026-11-07T03:42:13.000Z","discoveredAt","2026-11-07T12:11:46.174Z","timelineAt","category","tags",[72],"score",54,"selected",false,"channel","news","story",{"_69":70,"_11":71},"x","readingMode","full","author","body","outline",[],"relatedStories",[68],"topics",[63],"indexable","markdownAvailable",true,"group",{"_57":58,"_59":60,"_61":62},"hasTranslation","bodyLanguage","original","factId","fL--NEJuIEd0","reportCount",1,"additionalSourceCount",0,{"_64":65,"_66":67},"slug","research-policy","name","科研政策",{"_69":70,"_11":71},"publicId","af95b3ab-8fb6-4090-95f1-af3cbd671902","人社部实施职业技能培训行动覆盖800万人次","政策发布","https://36kr.com/newsflashes/4059015768429699?f=rss","36氪",{"_76":77,"_78":-5},"changelogVersion","2026-10-08T22:43","release"]

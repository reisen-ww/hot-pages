[{"_1":2,"_3":4},"root",{"_5":78},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","geoekh2pzh3nm37i3wgysmr2u","title","某团队在 bioRxiv 发表 β2 整合素激活前磷酸化形式组织研究","originalTitle","Receptor-proximal phosphoform organization precedes β2 integrin activation","summary","某团队通过 CD18-APEX2 近端标记和空间膜参考技术，发现静息状态下中性粒细胞 β2 整合素附近存在特定磷酸化形式组织，激活后 31% 磷酸位点显著变化。","reason","论文提供了近端标记与空间膜参考技术的定量方法，并揭示β2整合素激活前存在特定磷酸化形式组织，为受体信号调控机制研究提供了新视角。","source",{"_69":77},"links",{"_59":76},"publishedAt","2026-11-05T00:00:00.000Z","discoveredAt","2026-11-06T02:34:11.993Z","timelineAt","category","neuroscience","tags",[75,70],"score",79,"selected",true,"channel","news","story",{"_72":73,"_11":74},"x","readingMode","full","author"," Moore, T. I., Hummell, N. A., Jonnagaddala, H., Kalocsay, M. ","body","outline",[],"relatedStories",[71],"topics",[66],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fMTzQHRgto9U","reportCount",1,"additionalSourceCount",0,{"_67":68,"_69":70},"slug","openai","name","OpenAI",{"_72":73,"_11":74},"publicId","117f34ea-eeea-4f4b-8a22-106e6369f206","某团队发现中性粒细胞β2整合素激活后磷酸化位点变化率达31%","研究成果","https://www.biorxiv.org/content/10.64898/2026.11.04.762546v1?rss=1","bioRxiv",{"_79":80,"_81":-5},"changelogVersion","2026-10-08T22:43","release"]

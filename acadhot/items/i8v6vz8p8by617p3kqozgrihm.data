[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","i8v6vz8p8by617p3kqozgrihm","title","某团队在bioRxiv发布神经影像兼容的虚拟城镇导航评估任务NAVAN","originalTitle","An open-access neuroimaging-compatible virtual town task for assessing human spatial navigation","summary","某团队在bioRxiv发布神经影像兼容的虚拟城镇导航评估任务NAVAN，53名参与者完成24次试验，显示重复暴露提升导航效率但存在任务内衰减。自我报告的空间能力与早期表现相关，并验证了EEG记录的可行性。任务提供详细性行为测量和实施指南，支持实验定制。","reason","该任务提供详细的性行为测量和实施指南，支持神经影像学实验的定制化研究。","source",{"_70":80},"links",{"_59":79},"publishedAt","2026-11-05T00:00:00.000Z","discoveredAt","2026-11-05T12:33:28.496Z","timelineAt","category","neuroscience","tags",[78,71,73],"score",80,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author"," Thornberry, C., Lieu, S., Bradshaw Bernacchi, J. K., Quinn, D. M., Sutton, L., Osagie, R., Walsh, A., Zhang, L., Ward, T., Lopez Valdes, A., Whelan, R. ","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","fcBpfj-Y96AE","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","brain-computer-interface","name","脑机接口","openai","OpenAI",{"_75":76,"_11":77},"publicId","83f99397-3c50-46ec-9edf-9cb4d04f83ca","某团队发布神经影像兼容的虚拟城镇导航评估任务NAVAN","研究成果","https://www.biorxiv.org/content/10.64898/2026.11.04.763058v1?rss=1","bioRxiv",{"_82":83,"_84":-5},"changelogVersion","2026-10-08T22:43","release"]

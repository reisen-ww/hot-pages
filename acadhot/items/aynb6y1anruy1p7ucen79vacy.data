[{"_1":2,"_3":4},"root",{"_5":68},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":35,"_51":35,"_52":-5,"_53":54,"_55":56},"id","aynb6y1anruy1p7ucen79vacy","title","Science 发表研究揭示海洋雪黏度如何影响深海碳输送","originalTitle","The gooier marine snow is, the better it is at transporting carbon, new study finds","summary","Scripps 海洋学研究所与林肯大学的科学家发现，高黏度海洋雪可向深海输送超过低黏度颗粒 6 倍的碳。研究显示，细菌更易定殖于低黏度区域，而高黏度颗粒降解和碎裂更慢，计算模拟也表明其下沉更深。研究团队结合 3D 共聚焦显微镜和专用荧光分子观察细菌与海洋雪结构的相互作用，相关成果发表于 Science，配套成像方法发表于 Nature Communications。","reason","研究把海洋雪的黏度与细菌降解和碳下沉联系起来，并提供了可观察黏液微观结构的新成像方法。","source",{"_61":67},"links",{"_56":66},"publishedAt","2026-10-12T14:00:01.000Z","discoveredAt","2026-10-12T14:12:30.321Z","timelineAt","category","life-science","tags",[65,64],"score",76,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[57,58],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_59":63,"_61":64},{"_59":60,"_61":62},"slug","conference-paper","name","顶会与论文接收","science","Science","论文发表","https://phys.org/news/2026-10-gooier-marine-carbon.html","Phys.org",{"_69":70,"_71":-5},"changelogVersion","2026-10-08T22:43","release"]

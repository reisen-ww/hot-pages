[{"_1":2,"_3":4},"root",{"_5":76},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","mit9ujeifyssn0van9cby1eis","title","Open Research Europe 实现论文早发表晚评价","originalTitle","[打听] “同行评议”的国际新动态（2）： Open Research Europe 欧盟委员会资助的&#8204;免费开放获取出版","summary","Open Research Europe 是欧盟委员会资助的免费开放获取出版平台，论文发表后会公开同行评审过程，包括审稿人姓名及评审报告。这种模式遵循华罗庚提出的“早发表，晚评价”原则，旨在提高科研透明度，促进学术交流。","reason","source",{"_67":75},"links",{"_57":74},"publishedAt","2026-11-07T07:42:44.000Z","discoveredAt","2026-11-07T12:58:06.771Z","timelineAt","category","clinical","tags",[73],"score",38,"selected",false,"channel","news","story",{"_70":71,"_11":72},"x","readingMode","full","author","body","outline",[],"relatedStories",[69],"topics",[64],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","foEZxOMjmn2g","reportCount",2,"additionalSourceCount",0,{"_65":66,"_67":68},"slug","conference-paper","name","顶会与论文接收",{"_70":71,"_11":72},"publicId","307a8b65-e1b6-477d-9c82-b96d9210e949","欧洲科研机构推动ORE平台覆盖250万科研人员，强制采用预同行评审模式","论文发表","http://blog.sciencenet.cn/home.php?mod=space&uid=107667&do=blog&id=1560150","科学网博客",{"_77":78,"_79":-5},"changelogVersion","2026-10-08T22:43","release"]

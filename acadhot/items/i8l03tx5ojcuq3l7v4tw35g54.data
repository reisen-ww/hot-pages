[{"_1":2,"_3":4},"root",{"_5":80},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","i8l03tx5ojcuq3l7v4tw35g54","title","一个额外的量子点有助于平衡自旋量子位的速度和稳定性","originalTitle","One extra quantum dot helps balance speed and stability in spin qubits","summary","研究人员通过增加一个额外的量子点，调整了电子的能级结构，提高了自旋量子位的速度和稳定性。实验实现了100 MHz以上的操作频率，并通过反馈机制将退相时间延长至580纳秒，门保真度达到99.72%。该方法为大规模量子计算机的设计提供了新思路。","reason","研究通过增加额外量子点，提高了自旋量子位的速度和稳定性，为大规模量子计算机的设计提供了新思路。","source",{"_69":79},"links",{"_58":78},"publishedAt","2026-10-26T13:40:06.000Z","discoveredAt","2026-10-26T13:55:20.986Z","timelineAt","category","quantum-physics","tags",[77,70,72],"score",81,"selected",true,"channel","news","story",{"_74":75,"_11":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[65,66],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","f805Ltl1gHIU","reportCount",1,"additionalSourceCount",0,{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","quantum-computing","name","量子计算","nature","Nature",{"_74":75,"_11":76},"publicId","4fc116ac-b8b5-4502-a939-6aa87d85ce0e","大阪大学团队通过三量子点能带工程提升自旋量子位性能","研究成果","https://phys.org/news/2026-10-extra-quantum-dot-stability-qubits.html","Phys.org",{"_81":82,"_83":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","bw5crijq23u1gfeu3ld0pjadq","title","某团队在 bioRxiv 发表癌症代谢脆弱性新研究","originalTitle","PERTURBATION OF THE AMINO ACID STRESS RESPONSE PATHWAY EXPOSES A METABOLIC VULNERABILITY IN MULTIPLE AGGRESSIVE CANCER SUBTYPES","summary","某团队在 bioRxiv 发表癌症代谢脆弱性新研究，发现通过干扰氨基酸应激响应通路可抑制急性淋巴细胞白血病、急性髓系白血病、三阴性乳腺癌等五种癌症亚型肿瘤。研究显示，化合物 GCN2-IN-6 通过改变代谢应激信号通路发挥抗肿瘤作用，并证实慢性代谢应激适应是癌症治疗的新脆弱性，且该脆弱性在多种癌症亚型中具有一致性。","reason","该研究揭示了慢性代谢应激适应作为癌症治疗的新脆弱性，并展示了通过干扰氨基酸应激响应通路在多种癌症中具有广泛的抗肿瘤活性，为开发新型靶向疗法提供了理论依据。","source",{"_69":77},"links",{"_59":78},"publishedAt","2026-11-03T00:00:00.000Z","discoveredAt","2026-11-03T18:52:37.013Z","timelineAt","category","drug-therapy","tags",[75,76,77],"score",72,"selected",true,"channel","news","story",{"_72":73,"_11":74},"x","readingMode","full","author"," Peeters, E., Fijalkowski, I., T'Sas, S., Christensen, K. T., De Coninck, J., Van Ammel, E., Vleminckx, L., Hofkens, K., Mennes, L., Reekmans, A., Durinck, K., Van Coillie, K., Leucci, E., Baietti, M. F., Verstappe, J., Ntziachristos, P., de Rooster, H., Van Nieuwerburgh, F., Van De Vijver, K., Menschaert, G., Lammens, T., Berx, G., Loret, N., Van Trimpont, M., Goossens, S. ","body","outline",[],"relatedStories",[71],"topics",[66],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","foiU1HGXyYYA","reportCount",1,"additionalSourceCount",0,{"_67":68,"_69":70},"slug","cancer-immunotherapy","name","癌症免疫治疗",{"_72":73,"_11":74},"publicId","e9f4d82e-a30b-4fda-8dba-25cecdba4711","某团队发现慢性代谢应激适应可作为多种癌症治疗的新脆弱性","研究成果","癌症免疫","bioRxiv","https://www.biorxiv.org/content/10.64898/2026.11.02.763650v1?rss=1",{"_80":81,"_82":-5},"changelogVersion","2026-10-08T22:43","release"]

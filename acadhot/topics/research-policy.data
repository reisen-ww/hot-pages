[{"_1":2,"_3":4},"root",{"_5":134},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":14,"_15":14,"_16":17},{"_113":114,"_50":115,"_116":117,"_118":119,"_120":-5,"_121":122,"_123":124,"_125":126,"_127":128,"_129":130,"_131":132},"modules",{},"items",[18,19,20,21,22,23,24],"page",1,"pageCount","pageSize",20,{"_25":101,"_27":102,"_29":103,"_31":104,"_33":105,"_35":106,"_37":107,"_38":108,"_40":109,"_42":110,"_44":45,"_46":47,"_48":-5},{"_25":92,"_27":93,"_29":94,"_31":95,"_33":96,"_35":97,"_37":98,"_38":-5,"_40":99,"_42":100,"_44":45,"_46":47,"_48":-5},{"_25":81,"_27":82,"_29":83,"_31":84,"_33":85,"_35":86,"_37":87,"_38":-5,"_40":88,"_42":89,"_44":45,"_46":47,"_48":-5},{"_25":71,"_27":72,"_29":73,"_31":74,"_33":75,"_35":76,"_37":77,"_38":39,"_40":78,"_42":79,"_44":45,"_46":47,"_48":-5},{"_25":62,"_27":63,"_29":64,"_31":65,"_33":66,"_35":67,"_37":67,"_38":-5,"_40":68,"_42":69,"_44":45,"_46":47,"_48":-5},{"_25":52,"_27":53,"_29":54,"_31":55,"_33":56,"_35":57,"_37":57,"_38":39,"_40":58,"_42":59,"_44":45,"_46":47,"_48":-5},{"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":36,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47,"_48":-5},"id","lp85htk6qa8tt5cbke85cood7","title","美国国土安全部拟将留学生 F1-OPT 工作许可费提高至 7 万美元","summary","美国国土安全部发布拟议规则，计划将留学生 F1-OPT 工作许可费提高至 7 万美元，延期费用提高至 3 万美元。该规则涉及通常可工作 1 年、STEM 专业可延长两年的 F1-OPT，公众意见截止日期为 11 月 9 日。","reason","拟议规则通过大幅提高 F1-OPT 许可与延期费用改变留学生毕业后就业门槛，公众意见截止日期也提供了明确的政策观察节点。","source",{"_50":51},"publishedAt","2026-10-08T09:52:57.000Z","timelineAt","category","clinical","tags",[49],"score",79,"selected",true,"channel","news","x","政策发布","name","奇客 Solidot","d442yn49pxm0gun4kysuafk2m","通讯：Bundibugyo 病毒疫情的跨境协调应对","2026年5月15日，刚果（金）与乌干达宣布暴发由 Bundibugyo 病毒引起的埃博拉疫情，WHO 总干事于5月17日宣布构成国际关注的突发公共卫生事件。截至8月26日共报告5815例确诊病例和2788例死亡，其中刚果（金）5794例病例、2786例死亡，传播已波及六省的60个卫生区。","这封信汇总了两国疫情规模与 WHO 宣布 PHEIC 的时间线，为跨境传染病协调应对提供参考框架。",{"_50":61},"2026-10-08T22:30:01.000Z",[49,60],73,"WHO","The Lancet","c8j8pnwip58ycus7cu7tdk7kh","特朗普政府调查9所大学涉嫌滥用J-1签证","特朗普政府宣布调查9所大学涉嫌与J-1签证相关的欺诈行为，调查由美国劳工部开展，监察长办公室已向相关高校发出传票。副总统JD Vance称，这些学校将J-1签证用于联邦资助研究的比例为61%，全国平均为38%，但STAT未获官方说明数据来源；美国国家科学基金会数据显示，科学、工程和健康领域近60%的博士后持临时签证。","调查涉及国际博士后签证使用、联邦科研资助与高校合规，文中也呈现了相关数据来源和受调查高校的回应。",{"_50":70},"2026-10-08T23:09:27.000Z",[49],76,"STAT News","hiuu17qgc2wmpulyejlmuls5w","证监会就公募基金运作办法征求意见，放宽FOF投资限制","中国证监会就《公开募集证券投资基金运作管理办法》公开征求意见，降低FOF成立门槛，允许投资ETF联接基金，提高非FOF基金投资其他基金的比例上限，明确REITs投资按证券投资管理。","政策放宽了FOF的投资限制，为公募资产配置提供了新的灵活性。",{"_50":80},"2026-10-26T23:24:48.000Z","2026-10-26T23:35:22.270Z",[49],80,"36氪","ksexxh9i7gpuy0e7h7js2rxng","美国国立卫生研究院（NIH）早期职业研究人员工会权被裁决支持","美国国立卫生研究院（NIH）早期职业研究人员工会权被联邦裁决支持，反对方为 NIH 自身提出的申诉。裁决指出 NIH 的反对理由不足，并强调此类争议需通过工会协商解决。","裁决为 NIH 内部工会权利争议提供了法律依据，对科研机构处理类似劳动纠纷具有参考价值。",{"_50":91},"2026-10-30T04:45:00.000Z","2026-10-30T22:18:50.125Z",[49,90],70,"NIH","Science 新闻","y249zsddd82ne4zgzs08oqwd5","中国人民银行等三部门召开支持资本市场工具座谈会","中国人民银行、金融监管总局、中国证监会召开座谈会，提出优化政策工具，包括将股票回购增持再贷款转为长期制度性安排并降低再贷款利率至1.25%，以支持资本市场稳定发展。","会议提出优化政策工具，包括将股票回购增持再贷款转为长期制度性安排并降低再贷款利率至1.25%，对资本市场稳定发展有直接指导意义。",{"_50":80},"2026-11-02T12:04:37.000Z","2026-11-02T12:08:49.662Z",[49],84,"esy0xswefbjuwx2pkklqbliiv","联合国Cali Fund计划要求企业使用公共遗传数据时付费，但实际年筹集额仅达预估的10%","联合国Cali Fund计划要求企业使用公共遗传数据时付费，但实际年筹集额仅达预估的10%。目前仅5家生物技术公司（包括Prozomix已贡献$5000）参与，大型AI生物公司如Isomorphic Labs（5月获$2亿融资）和Basecamp Research（9月获$1400万融资）尚未加入。","Cali Fund的自愿性质导致实际资金筹集远低于预期，为全球生物多样性保护资金机制提供对比案例。",{"_50":112},"2026-11-03T00:00:00.000Z","2026-11-03T18:52:36.624Z","gene-cell",[111,49,112],61,"论文发表","Nature","slug","research-policy","科研政策","group","genre","definition","科研治理规则的变化：数据与样本管理、出口管制与跨国合作限制、开放获取要求、科研伦理与安全审查。","brand","total",7,"recent",4,"indexable",false,"latest",{"_27":102,"_133":107},"groupName","内容形态","poolTotal",335,"at",{"_135":136,"_137":-5},"changelogVersion","2026-10-08T22:43","release"]

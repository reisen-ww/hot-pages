[{"_1":2,"_3":4},"root",{"_5":82},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":14,"_15":14,"_16":17},{"_58":59,"_48":47,"_60":61,"_62":63,"_64":65,"_66":67,"_68":67,"_69":70,"_71":72,"_73":74,"_75":76},"modules",{},"items",[18,19],"page",1,"pageCount","pageSize",20,{"_20":50,"_22":51,"_24":52,"_26":53,"_28":54,"_30":55,"_32":56,"_34":35,"_36":57,"_38":39,"_40":41,"_42":43,"_44":-5},{"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5},"id","ol0hnr4wmumzkpnm36a0dj4uo","title","Nature 发表单分子量子比特研究，为量子网络节点设计提供新思路","summary","Nature 发表研究，首次实现单分子量子比特的稳定控制与读取。实验通过激光将化合物转化为卡宾分子，利用微波脉冲操控电子自旋，并验证了自旋保持2.2毫秒、光发射稳定超过一小时的性能。该成果为量子网络节点设计提供了新材料路径（DOI:10.1038/s41586-026-11147-6）","reason","论文展示了单个分子作为量子比特的可行性，并维持了超过一小时的光发射稳定性，为量子网络节点设计提供了新思路。","source",{"_48":49},"publishedAt","2026-11-02T17:00:05.000Z","timelineAt","2026-11-02T17:03:24.733Z","category","quantum-physics","tags",[45,46,47],"score",84,"selected",true,"channel","news","x","论文发表","研究成果","NVIDIA","name","Phys.org","ryiywkxl4tw9yvbbed8wvrxha","西北大学团队在 Nature 发表新型星光消除技术 FLIP，成功检测到此前被掩盖的 51 Eri b 巨行星","西北大学团队在 Nature 发表新型星光消除技术 FLIP，成功检测到此前被掩盖的 51 Eri b 巨行星。该方法通过物理建模与优化工具结合，将望远镜灵敏度提升 2-15 倍，使 2 年前 JWST 观测数据中隐藏的该行星得以显现。研究还指出 FLIP 可用于未来 Habitable Worlds Observatory 望远镜的稳定性优化，并可能改变系外行星探测策略。","该论文提出的新方法FLIP显著提高了詹姆斯·韦伯太空望远镜的行星探测灵敏度，为后续深空观测提供了优化工具。",{"_48":49},"2026-11-04T16:00:01.000Z","2026-11-04T16:12:36.290Z",[46,47],"slug","nvidia","group","company","definition","英伟达在科研侧的动作：面向训练与科学计算的芯片与系统、研究团队论文、算力供给与高校和研究机构的合作。","brand",{"_78":-5,"_79":80,"_81":70},"total",2,"recent","indexable",false,"latest",{"_22":51,"_77":56},"groupName","机构与公司","poolTotal",35,"at","src","monogram","N","raster",{"_83":84,"_85":-5},"changelogVersion","2026-10-08T22:43","release"]

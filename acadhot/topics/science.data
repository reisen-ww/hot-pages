[{"_1":2,"_3":4},"root",{"_5":125},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":14,"_15":14,"_16":17},{"_101":102,"_51":50,"_103":104,"_105":106,"_107":108,"_109":110,"_111":110,"_112":113,"_114":115,"_116":117,"_118":119},"modules",{},"items",[18,19,20,21,22,23],"page",1,"pageCount","pageSize",20,{"_24":91,"_26":92,"_28":93,"_30":94,"_32":95,"_34":96,"_36":97,"_38":98,"_40":99,"_42":43,"_44":45,"_46":47,"_48":-5},{"_24":83,"_26":84,"_28":85,"_30":86,"_32":87,"_34":88,"_36":89,"_38":39,"_40":90,"_42":82,"_44":45,"_46":47,"_48":-5},{"_24":74,"_26":75,"_28":76,"_30":77,"_32":78,"_34":79,"_36":80,"_38":39,"_40":81,"_42":82,"_44":45,"_46":47,"_48":-5},{"_24":64,"_26":65,"_28":66,"_30":67,"_32":68,"_34":69,"_36":70,"_38":39,"_40":71,"_42":72,"_44":45,"_46":47,"_48":-5},{"_24":53,"_26":54,"_28":55,"_30":56,"_32":57,"_34":58,"_36":59,"_38":60,"_40":61,"_42":62,"_44":45,"_46":47,"_48":-5},{"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47,"_48":-5},"id","t4qoyv5yot2hx1853im74q4g6","title","Science发表研究揭示噬菌体蛋白酶如何激活细菌CBASS免疫","summary","研究人员发现，某些噬菌体产生的蛋白酶会切割细菌内的关键感应蛋白，从而触发CBASS抗噬菌体免疫，并促使受感染细菌自我牺牲以阻止病毒传播。该研究发表于Science，结果为开发能够避开细菌免疫防御的噬菌体疗法提供了机制线索，也显示这一防御通路与人类免疫相关通路可能具有演化联系。","reason","研究揭示噬菌体蛋白酶如何触发细菌CBASS免疫，为设计能够避开细菌防御的噬菌体疗法提供机制线索。","source",{"_51":52},"publishedAt","2026-10-09T09:51:19.000Z","timelineAt","2026-10-09T23:02:34.080Z","category","life-science","tags",[49,50],"score",78,"selected",true,"channel","news","x","论文发表","Science","name","ScienceDaily 健康医学","i5kxgq6cr1ysmapg44mloz8wz","Caltech 与 Yale 团队在 Science 发表真实材料中 Kondo 效应的精确计算方法","Caltech 与 Yale University 研究人员提出一种基于真实原子和电子结构计算材料中 Kondo 效应的方法，并将结果发表于 Science。该方法在嵌入铜中的 7 种过渡金属原子上进行了测试，对多数元素的预测精度比传统模型方法高至 2 个数量级。","研究将量子化学计算工具用于真实材料中的 Kondo 效应，为评估材料特异性的强关联电子行为提供了可复用的计算路径。",{"_51":63},"2026-10-10T01:59:39.000Z","2026-10-10T19:29:33.291Z","quantum-physics",[49,50],82,"ScienceDaily 综合","rdfiflqjv0kfa585kvd6mrufp","Science发表DNA Typewriter追踪小鼠胚胎细胞谱系历史的研究","华盛顿大学和Dartmouth College等团队在Science发表研究，利用DNA Typewriter记录小鼠受精卵及胚胎细胞的分裂历史，并重建从合子到器官形成后期、历时13.5天的细胞谱系。","研究展示了如何用DNA Typewriter按时间顺序记录小鼠胚胎细胞分裂史，并据此追踪细胞谱系与命运分化时点。",{"_51":73},"2026-10-11T22:20:01.000Z","2026-10-11T23:44:30.416Z",[49,50],87,"Phys.org","aynb6y1anruy1p7ucen79vacy","Science 发表研究揭示海洋雪黏度如何影响深海碳输送","Scripps 海洋学研究所与林肯大学的科学家发现，高黏度海洋雪可向深海输送超过低黏度颗粒 6 倍的碳。研究显示，细菌更易定殖于低黏度区域，而高黏度颗粒降解和碎裂更慢，计算模拟也表明其下沉更深。研究团队结合 3D 共聚焦显微镜和专用荧光分子观察细菌与海洋雪结构的相互作用，相关成果发表于 Science，配套成像方法发表于 Nature Communications。","研究把海洋雪的黏度与细菌降解和碳下沉联系起来，并提供了可观察黏液微观结构的新成像方法。",{"_51":73},"2026-10-12T14:00:01.000Z","2026-10-12T14:12:30.321Z",[49,50],76,"plaj73hiuhfo1sws6pacwyhez","Science 研究：野生鸟类利用上升气流改写飞行能耗规则","Max Planck Institute of Animal Behavior 与 Swansea University 团队在 Science 发表研究，通过17年GPS与加速度计追踪850只鸟类和蝙蝠（38个物种）及4年雷达数据，发现飞行在某些情况下比游泳更节能。","研究用17年850只鸟类的追踪数据比较38个物种的飞行能耗，为动物运动成本研究提供了野外实测的新基准。",{"_51":73},"2026-10-15T18:00:11.000Z","2026-10-15T18:02:19.307Z",[49,50],"hnkn398wddosetkpjyqrfdx1p","IBS 团队在 Science 发表研究：单一 WSe₂ 晶体经逐层化学转化制成高性能晶体管","IBS 团队在 Science 发表论文，展示从单一 WSe₂ 晶体出发，通过逐层化学转化同时获得半导体通道、WOₓ 绝缘介质与 WTe₂ 金属接触的方法。该团队实现约 0.7 nm 单层精度的转化控制，WSe₂ 晶体管亚阈值摆幅达 61.3 mV/decade，接近室温理论极限，开关比超过 1000 万。","团队从单一 WSe₂ 晶体逐层化学转化出半导体、绝缘介质与金属接触，亚阈值摆幅 61.3 mV/decade 接近理论极限。",{"_51":73},"2026-10-15T20:40:06.000Z","2026-10-15T20:47:36.747Z","materials-energy",[49,100,50],"半导体材料","slug","science","group","company","definition","《科学》及其子刊的持续追踪：刊发的重要论文、社论与出版政策、与 AAAS 相关的科研政策表态。","brand",{"_121":-5,"_122":123,"_124":113},"total",6,"recent","indexable",false,"latest",{"_26":92,"_120":97},"groupName","机构与公司","poolTotal",43,"at","src","monogram","S","raster",{"_126":127,"_128":-5},"changelogVersion","2026-10-08T22:43","release"]

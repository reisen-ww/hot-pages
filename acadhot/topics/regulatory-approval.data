[{"_1":2,"_3":4},"root",{"_5":121},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":14,"_15":14,"_16":17},{"_102":103,"_51":49,"_104":105,"_106":107,"_108":-5,"_109":110,"_111":110,"_112":113,"_114":115,"_116":117,"_118":119},"modules",{},"items",[18,19,20,21,22,23],"page",1,"pageCount","pageSize",20,{"_24":94,"_26":95,"_28":96,"_30":97,"_32":98,"_34":90,"_36":99,"_38":39,"_40":100,"_42":83,"_44":45,"_46":47,"_48":-5},{"_24":85,"_26":86,"_28":87,"_30":88,"_32":89,"_34":90,"_36":91,"_38":39,"_40":92,"_42":93,"_44":45,"_46":47,"_48":-5},{"_24":74,"_26":75,"_28":76,"_30":77,"_32":78,"_34":79,"_36":80,"_38":81,"_40":82,"_42":83,"_44":45,"_46":47,"_48":-5},{"_24":64,"_26":65,"_28":66,"_30":67,"_32":68,"_34":69,"_36":70,"_38":39,"_40":71,"_42":72,"_44":45,"_46":47,"_48":-5},{"_24":53,"_26":54,"_28":55,"_30":56,"_32":57,"_34":58,"_36":59,"_38":39,"_40":60,"_42":61,"_44":45,"_46":47,"_48":-5},{"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47,"_48":-5},"id","kol7mugvjt12s75piqj50iprg","title","FDA批准Zanvastro治疗Alexander病","summary","FDA批准Zanvastro用于直接治疗Alexander病，这是针对该病潜在生物过程的疾病修饰治疗。Ionis Pharmaceuticals开展的国际临床试验覆盖13个临床中心并纳入54名患者，治疗一年多后，患者步行速度优于未接受药物者，运动功能总体得到稳定，部分患者有所改善。","reason","文章串联了GFAP致病机制、ASO靶向策略与临床试验结果，呈现罕见病基础研究转化为治疗的完整路径。","source",{"_51":52},"publishedAt","2026-10-13T00:43:43.000Z","timelineAt","2026-10-13T12:33:29.517Z","category","drug-therapy","tags",[49,50],"score",85,"selected",true,"channel","news","x","监管批准","FDA","name","ScienceDaily 健康医学","w5qgbkkld7zbbvjo5eveqqk0c","国家药监局批准全球首个XI因子抑制剂在中国上市","国家药监局批准全球首个XI因子抑制剂在中国上市，该药物能与现有卒中治疗联合使用，预防患者卒中复发，填补了非心源性缺血性卒中预防药物的空白。","国家药监局批准了全球首个XI因子抑制剂在中国上市，填补了非心源性缺血性卒中预防药物的空白。",{"_51":63},"2026-10-26T07:44:05.000Z","2026-10-26T07:47:43.384Z",[49,62],89,"NMPA","36氪","br78nd4m1f3p6qtdtw1j4k2la","美国HHS批准六种实验性肽类用于临时配药","美国卫生与公众服务部（HHS）发布政策，允许授权药房和医师临时配制包括BPC-157和TB-500在内的六种实验性肽类物质，但FDA科学家质疑这些物质缺乏安全性和有效性证据。政策允许期限为90天，需提交详细实验数据。","HHS批准六种肽类物质用于临时配药，与FDA科学家关于安全性和有效性的争议形成对比",{"_51":73},"2026-10-29T13:43:44.000Z","2026-10-29T14:16:47.157Z",[49],82,"STAT News","kkttx4sbdjypxnquvabjc5lel","澳大利亚批准日本Inpex海底碳封存项目","澳大利亚政府批准日本Inpex公司在其北部海域西佩龙盐层（West Peron）建设碳封存项目，计划永久封存4.43亿吨二氧化碳。该项目由Inpex与日本钢铁等企业合作，旨在处理液化天然气设施的碳排放，但环保组织担忧海底钻探、CO₂注入及长期监测可能破坏海洋生态系统。日本政府将CCS视为实现2035年减排60%目标的必要手段，但国际能源署预测其2050年减排贡献率不足5%。","澳大利亚批准日本公司Inpex在近海海底建设碳封存项目，项目计划永久封存4.43亿吨二氧化碳，但面临环保组织对生态影响的担忧。",{"_51":84},"2026-11-05T08:56:32.000Z","2026-11-05T12:33:28.126Z","materials-energy",[49],80,"Phys.org","q3ftorsbqgeaija5ma56b4han","诺华SMA基因疗法致未知肿瘤病例披露引发监管关注","诺华披露其SMA基因疗法Zolgensma导致9例肿瘤病例，其中2例可能与治疗相关。患者支持组织已向监管机构提交调查请求，目前尚无定论。","诺华披露的9例肿瘤病例中2例与Zolgensma存在关联性证据，为基因疗法长期安全性评估提供关键数据参考",{"_51":73},"2026-11-05T18:53:34.000Z","2026-11-05T21:39:10.022Z",[49],83,"u0dx2mgfetm9jqivdvut44cvk","诺华SMA基因疗法Zolgensma致九例肿瘤报告，两例初步关联疗法","诺华公布其SMA基因疗法Zolgensma nine cases of tumor reports in treated patients, including two cases with preliminary evidence linking to the therapy. SMA Europe等患者组织已要求公开完整数据，FDA确认正在调查。","诺华披露九例肿瘤报告，其中两例初步关联Zolgensma治疗，引发FDA及欧洲监管机构调查",{"_51":73},"2026-11-05T19:05:35.877Z",[49,101],"撤稿更正","slug","regulatory-approval","group","genre","definition","药监与卫生监管的决定：新药与器械获批或拒绝、附条件与加速审批、适应症扩展、标签与安全警示调整。","brand","total",6,"recent","indexable",false,"latest",{"_26":86,"_120":91},"groupName","内容形态","poolTotal",118,"at",{"_122":123,"_124":-5},"changelogVersion","2026-10-08T22:43","release"]

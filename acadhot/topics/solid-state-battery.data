[{"_1":2,"_3":4},"root",{"_5":89},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":14,"_15":14,"_16":17},{"_69":70,"_48":71,"_72":73,"_74":75,"_76":-5,"_77":78,"_79":78,"_80":81,"_82":83,"_84":85,"_86":87},"modules",{},"items",[18,19,20],"page",1,"pageCount","pageSize",20,{"_21":61,"_23":62,"_25":63,"_27":64,"_29":65,"_31":55,"_33":66,"_35":36,"_37":67,"_39":68,"_41":42,"_43":44,"_45":-5},{"_21":50,"_23":51,"_25":52,"_27":53,"_29":54,"_31":55,"_33":56,"_35":36,"_37":57,"_39":58,"_41":42,"_43":44,"_45":-5},{"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5},"id","vwscnlqylxg36r0f4dpd521zv","title","中国科学院深圳先进技术研究院等团队在 Nano-Micro Letters 发表超薄锂阵列负极研究","summary","中国科学院深圳先进技术研究院、南方科技大学等团队提出掩模辅助丝网印刷与 Mg(TFSI)₂ 原位界面强化策略，制备出等效厚度10–28 μm的超薄锂阵列负极。该负极兼容液态与固态电池体系，在搭配高载量正极时实现最高504 Wh kg⁻¹的质量能量密度和1071 Wh L⁻¹的体积能量密度，并稳定循环超过260次。","reason","论文将丝网印刷阵列结构与原位界面强化结合，兼顾超薄锂负极的可制造性和循环稳定性，并在液态与固态体系中展示了性能数据。","source",{"_48":49},"publishedAt","2026-10-12T04:15:56.000Z","timelineAt","2026-10-12T06:15:30.051Z","category","materials-energy","tags",[46,47],"score",78,"selected",true,"channel","news","x","论文发表","固态电池","name","科学网博客","iom1cbbex6b7dlss178dybpmu","某研究团队在 bioRxiv 发表农业消化物超滤用于微藻生物量生产的论文","某研究团队在 bioRxiv 发表农业消化物超滤（UF）作为微藻培养基的论文，测试了 UF 对 Chlorella sorokiniana 和 Nannochloropsis oceanica 的铵耐受性及生物质产量影响。","超滤技术（UF）在微藻培养中展现出比合成培养基更高的生物质积累效率，且其提取的生物质具有促进番茄根系发育的活性，为循环生物炼厂提供新思路。",{"_48":60},"2026-10-30T00:00:00.000Z","2026-10-30T14:02:20.641Z",[59,47,60],73,"研究成果","bioRxiv","rvgu5c0iz5p9fwyjweteydd2a","某团队在 bioRxiv 发表番茄植物根际微生物群落与功能特征研究","某团队在 bioRxiv 发表番茄植物根际微生物群落与功能特征研究。研究对比生物废弃物堆肥与传统化学肥料，发现堆肥处理组根际 Firmicutes 种类丰富度提升 1.5 倍，并增强纤维素酶、木聚糖酶等代谢活性，为可持续肥料提供新证据。","论文对比了生物废弃物堆肥与传统化学肥料对番茄根际微生物群的影响，发现堆肥处理组在 Firmicutes 种类丰富度（提升 1.5 倍）和纤维素酶、木聚糖酶等代谢通路活性方面显著增强，为可持续肥料提供新证据。",{"_48":60},"2026-10-30T13:14:40.654Z",[59,47],63,"slug","solid-state-battery","电池与储能","group","field","definition","电池与储能的研究与产业化：固态电解质与锂金属负极、能量密度与循环寿命数据、中试线与量产时间表。","brand","total",3,"recent","indexable",false,"latest",{"_23":51,"_88":56},"groupName","研究方向","poolTotal",23,"at",{"_90":91,"_92":-5},"changelogVersion","2026-10-08T22:43","release"]

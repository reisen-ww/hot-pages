[{"_1":2,"_3":4},"root",{"_5":66},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":14,"_15":14,"_16":17},{"_48":49,"_46":45,"_50":51,"_52":53,"_54":-5,"_55":14,"_56":14,"_57":58,"_59":60,"_61":62,"_63":64},"modules",{},"items",[18],"page",1,"pageCount","pageSize",20,{"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5},"id","krk4hlyfcgt5jpsw291cn067s","title","PPPL 研究提出先加热后压缩的核聚变点火路径","summary","美国能源部普林斯顿等离子体物理实验室（PPPL）研究人员提出，先加热等离子体再提高密度，可能比传统顺序以更低能量达到核聚变点火条件。研究将氦灰积累、等离子体杂质、同步辐射和热损失纳入扩展的 Lawson 判据，并在 Physical Review Letters 发表。计算显示，浓度仅为万分之一的钨污染可能使点火所需压力约增加一倍；该加热优先路径尚未通过实验验证，团队计划利用计算机模拟继续研究。","reason","研究将多种能量损失与杂质效应纳入点火条件分析，展示了加热顺序、钨污染和等离子体稳定性之间的关联。","source",{"_46":47},"publishedAt","2026-10-10T18:57:27.000Z","timelineAt","2026-10-10T19:29:32.977Z","category","materials-energy","tags",[44,45],"score",77,"selected",true,"channel","news","x","论文发表","核聚变","name","ScienceDaily 综合","slug","nuclear-fusion","group","field","definition","可控核聚变的进展：托卡马克与仿星器的等离子体参数、点火与增益记录、高温超导磁体、私营聚变公司的融资与里程碑。","brand","total","recent","indexable",false,"latest",{"_21":22,"_65":32},"groupName","研究方向","poolTotal",4,"at",{"_67":68,"_69":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":71},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":14,"_15":14,"_16":17},{"_48":49,"_46":45,"_50":51,"_52":53,"_54":55,"_56":14,"_57":14,"_58":59,"_60":61,"_62":63,"_64":65},"modules",{},"items",[18],"page",1,"pageCount","pageSize",20,{"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5},"id","kol7mugvjt12s75piqj50iprg","title","FDA批准Zanvastro治疗Alexander病","summary","FDA批准Zanvastro用于直接治疗Alexander病，这是针对该病潜在生物过程的疾病修饰治疗。Ionis Pharmaceuticals开展的国际临床试验覆盖13个临床中心并纳入54名患者，治疗一年多后，患者步行速度优于未接受药物者，运动功能总体得到稳定，部分患者有所改善。","reason","文章串联了GFAP致病机制、ASO靶向策略与临床试验结果，呈现罕见病基础研究转化为治疗的完整路径。","source",{"_46":47},"publishedAt","2026-10-13T00:43:43.000Z","timelineAt","2026-10-13T12:33:29.517Z","category","drug-therapy","tags",[44,45],"score",85,"selected",true,"channel","news","x","监管批准","FDA","name","ScienceDaily 健康医学","slug","fda","group","company","definition","美国食品药品监督管理局的监管决定：新药与生物制品批准、拒绝与撤回、加速审批与附条件要求、专家委员会表决与安全警示。","brand",{"_67":-5,"_68":69,"_70":59},"total","recent","indexable",false,"latest",{"_21":22,"_66":32},"groupName","机构与公司","poolTotal",36,"at","src","monogram","F","raster",{"_72":73,"_74":-5},"changelogVersion","2026-10-08T22:43","release"]

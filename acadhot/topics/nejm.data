[{"_1":2,"_3":4},"root",{"_5":117},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":14,"_15":14,"_16":17},{"_92":93,"_49":48,"_94":95,"_96":97,"_98":99,"_100":101,"_102":103,"_104":105,"_106":107,"_108":109,"_110":111},"modules",{},"items",[18,19,20,21,22,23],"page",1,"pageCount","pageSize",20,{"_24":86,"_26":87,"_28":87,"_30":-5,"_31":88,"_33":89,"_35":90,"_36":37,"_38":91,"_40":77,"_42":43,"_44":45,"_46":-5},{"_24":79,"_26":80,"_28":80,"_30":-5,"_31":81,"_33":82,"_35":83,"_36":37,"_38":84,"_40":85,"_42":43,"_44":45,"_46":-5},{"_24":69,"_26":70,"_28":71,"_30":72,"_31":73,"_33":74,"_35":75,"_36":66,"_38":76,"_40":77,"_42":43,"_44":45,"_46":-5},{"_24":59,"_26":60,"_28":61,"_30":62,"_31":63,"_33":64,"_35":65,"_36":66,"_38":67,"_40":68,"_42":43,"_44":45,"_46":-5},{"_24":50,"_26":51,"_28":52,"_30":53,"_31":54,"_33":55,"_35":56,"_36":37,"_38":57,"_40":58,"_42":43,"_44":45,"_46":-5},{"_24":25,"_26":27,"_28":29,"_30":-5,"_31":32,"_33":34,"_35":34,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":-5},"id","ei8f0ol98osjlg1c8get8hxuw","title","NEJM发表光遗传学治疗恢复部分视觉功能的研究","summary","José-Alain Sahel、Botond Roska等作者关于光遗传学治疗恢复部分视觉功能的研究发表于《新英格兰医学杂志》（NEJM）第395卷第14期，页码为1399–1408。材料未提供研究摘要或具体结果。","reason","source",{"_49":48},"publishedAt","2026-10-07T09:00:01.000Z","timelineAt","category","clinical","tags",[47,48],"score",64,"selected",true,"channel","news","x","论文发表","NEJM","name","xhopolt3sklzqej4s61qx44fu","某团队在 NEJM 发表急性肾损伤的肾替代治疗对比研究","某团队在 NEJM 发表急性肾损伤的肾替代治疗对比研究，主要终点为住院时间，次要终点包括死亡率和肾功能恢复情况。","该研究对比了两种肾替代治疗方式的效果，为 AKI 患者选择治疗方案提供临床依据。",{"_49":48},"2026-10-14T01:00:00.000Z","2026-10-14T13:46:30.349Z",[47,48],91,"maihnwgc2lyif2ux9fr93msao","NEJM 发表 icotrokinra 治疗溃疡性结肠炎的 II 期临床试验","NEJM 发表 ANTHEM-UC 研究组的 II 期临床试验，评估 icotrokinra 治疗溃疡性结肠炎的效果。","该 II 期试验为 icotrokinra 治疗溃疡性结肠炎提供了关键的临床开发数据，有助于评估该药物候选物的后续前景。",{"_49":48},"2026-10-14T09:00:07.000Z","2026-10-15T08:59:38.981Z","drug-therapy",[47,48],63,"pbinqn6rh3l7g33p62i3ik6vq","Atacicept 治疗 IgA 肾病 III 期试验最终疗效分析发表于 NEJM","NEJM 发表 ORIGIN III 期试验的最终疗效分析，评估 Atacicept 用于 IgA 肾病的疗效，作者包括 Jonathan Barratt、Robert M. Brenner、Richard Lafayette 等研究者。","标题直接给出试验阶段与最终疗效分析定位，读者可据此判断该药在 IgA 肾病领域的研发进度。",{"_49":48},"2026-10-22T02:00:00.000Z","2026-10-23T08:35:57.651Z",[78,47,48],62,"临床试验","pc7d9yrx1szmymv85iu4e3bie","某研究团队在 NEJM 发表 ADAPT AF-DES试验的长期结果",{"_49":48},"2026-10-31T07:45:00.000Z","2026-11-01T09:55:40.844Z",[78,48],71,"mram6lpd177bew5wwztrwnkpy","《新英格兰医学杂志》提前印刷版：冠状动脉 CT 血管造影与血管内超声引导经皮冠状动脉介入治疗的效果对比研究",{"_49":48},"2026-11-01T06:45:00.000Z","2026-11-02T09:33:31.186Z",[47,48],"slug","nejm","group","company","definition","《新英格兰医学杂志》的持续追踪：重要临床试验读出与医学研究发表、编辑部评论、勘误与利益冲突处理。","brand",{"_113":-5,"_114":115,"_116":105},"total",6,"recent",5,"indexable",false,"latest",{"_26":87,"_112":90},"groupName","机构与公司","poolTotal",85,"at","src","monogram","N","raster",{"_118":119,"_120":-5},"changelogVersion","2026-10-08T22:43","release"]

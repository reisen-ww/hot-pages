[{"_1":2,"_3":4},"root",{"_5":69},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":14,"_15":14,"_16":17},{"_50":51,"_48":52,"_53":54,"_55":56,"_57":-5,"_58":14,"_59":14,"_60":61,"_62":63,"_64":65,"_66":67},"modules",{},"items",[18],"page",1,"pageCount","pageSize",20,{"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5},"id","e1hfy1eb597boubwmk5z4gz12","title","MIT Technology Review发布关于Anthropic IPO及能源技术进展的综合报道","summary","Anthropic在IPO申请中披露了AI安全风险及计算成本问题，并宣布创始人将保留投票控制权。同期报道还包括固态变压器对电网升级的潜在影响、运动药丸的研发进展以及氦气被列为关键材料的政策动向。","reason","Anthropic的IPO申请披露了AI安全风险与计算成本问题，为评估其商业潜力提供关键数据","source",{"_48":49},"publishedAt","2026-10-27T12:10:00.000Z","timelineAt","2026-10-27T12:40:44.387Z","category","ai-frontier","tags",[44,45,46,47],"score",80,"selected",true,"channel","news","x","论文发表","合作与转让","DeepMind","OpenAI","name","MIT Technology Review","slug","industry-transfer","合作与成果转化","group","genre","definition","从实验室到产业的环节：校企与院企合作、专利许可与技术转让、孵化与分拆公司、大型产学研联合项目。","brand","total","recent","indexable",false,"latest",{"_21":22,"_68":32},"groupName","内容形态","poolTotal",192,"at",{"_70":71,"_72":-5},"changelogVersion","2026-10-08T22:43","release"]

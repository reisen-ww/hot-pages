[{"_1":2,"_3":4},"root",{"_5":83},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":14,"_15":14,"_16":17},{"_63":64,"_50":65,"_66":67,"_68":69,"_70":-5,"_71":72,"_73":72,"_74":75,"_76":77,"_78":79,"_80":81},"modules",{},"items",[18,19],"page",1,"pageCount","pageSize",20,{"_20":52,"_22":53,"_24":54,"_26":55,"_28":56,"_30":57,"_32":58,"_34":59,"_36":60,"_38":61,"_40":41,"_42":43,"_44":-5},{"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5},"id","cuxzt8c3xhsu9hrkqa7sggyza","title","英国三亲试管婴儿试验复归风险引争议，比利时启动新临床研究","summary","英国三亲试管婴儿试验数据显示线粒体复归率达5%-16%，引发对技术安全性的争议；比利时计划开展针对特定不孕症患者的MRT临床试验，为技术规范提供参考路径。该试验将监测7名受试者的胚胎发育，并计划2024年秋季启动招募。","reason","英国三亲试管婴儿试验数据显示线粒体复归率达5%-16%，引发对技术安全性的争议；比利时计划开展针对特定不孕症患者的MRT临床试验，为技术规范提供参考路径。","source",{"_50":51},"publishedAt","2026-11-03T09:30:00.000Z","timelineAt","2026-11-03T09:46:39.025Z","category","clinical","tags",[45,46,47,48,49],"score",79,"selected",true,"channel","news","x","研究成果","撤稿更正","DeepMind","OpenAI","NVIDIA","name","STAT News","u0dx2mgfetm9jqivdvut44cvk","诺华SMA基因疗法Zolgensma致九例肿瘤报告，两例初步关联疗法","诺华公布其SMA基因疗法Zolgensma nine cases of tumor reports in treated patients, including two cases with preliminary evidence linking to the therapy. SMA Europe等患者组织已要求公开完整数据，FDA确认正在调查。","诺华披露九例肿瘤报告，其中两例初步关联Zolgensma治疗，引发FDA及欧洲监管机构调查",{"_50":51},"2026-11-05T18:53:34.000Z","2026-11-05T19:05:35.877Z","drug-therapy",[62,46],80,"监管批准","slug","retraction","撤稿与学术不端","group","genre","definition","学术诚信事件：撤稿与更正声明、图像与数据造假、论文工厂与买卖版面、期刊调查与机构处理结果。","brand","total",2,"recent","indexable",false,"latest",{"_22":53,"_82":58},"groupName","内容形态","poolTotal",35,"at",{"_84":85,"_86":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":80},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":14,"_15":14,"_16":17},{"_61":62,"_48":46,"_63":64,"_65":66,"_67":-5,"_68":69,"_70":69,"_71":72,"_73":74,"_75":76,"_77":78},"modules",{},"items",[18,19],"page",1,"pageCount","pageSize",20,{"_20":50,"_22":51,"_24":52,"_26":53,"_28":54,"_30":55,"_32":56,"_34":35,"_36":57,"_38":58,"_40":41,"_42":43,"_44":-5},{"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5},"id","qplvo2kh51thqxx2lur9gblh9","title","GitLab 修复 CI/CD 正则表达式编译器最高严重性远程代码执行漏洞","summary","GitLab 警告用户立即修复 CI/CD 正则表达式编译器中的最高严重性漏洞 CVE-2026-97229，未经身份验证的远程攻击者可通过特制正则表达式在 GitLab 服务器上执行任意代码。","reason","文章明确列出受影响的 GitLab CE/EE 版本与修复版本，并说明攻击者可借助特制正则表达式执行任意代码，便于自托管用户核对升级范围。","source",{"_48":49},"publishedAt","2026-10-14T15:55:52.017Z","timelineAt","2026-10-14T22:52:07.017Z","category","security-privacy","tags",[45,46,47],"score",87,"selected",true,"channel","news","x","安全漏洞","GitLab","供应链安全","name","Lobsters 热榜","sf6j87itbpg0bixtersrcy44m","GitLab 发布 19.5.1 等关键补丁版本，修复 CVSS 10.0 的正则编译器整数溢出漏洞","GitLab 于 10 月 21 日发布 19.5.1、19.4.3、19.3.6、19.2.9、19.1.9、19.0.10、18.11.13 共 7 个补丁版本，包含重要缺陷与安全修复，建议所有自托管安装尽快升级，GitLab.com 已运行修复后版本。","列出各 CVE 的受影响版本下限与 CVSS 分值，自托管运维可直接对照自己的版本判断是否需要立即升级。",{"_48":60},"2026-10-21T19:01:12.000Z","2026-10-22T01:39:51.993Z",[45,59,46],84,"版本发布","Hacker News 热榜","slug","gitlab","group","org","definition","GitLab 的持续追踪：平台版本发布、CI/CD 能力变化、自托管与 SaaS 两条线的差异，以及许可证与商业模式调整。","brand","total",2,"recent","indexable",false,"latest",{"_22":51,"_79":56},"groupName","组织与基金会","poolTotal",3,"at",{"_81":82,"_83":-5},"changelogVersion","2026-10-08T22:43","release"]

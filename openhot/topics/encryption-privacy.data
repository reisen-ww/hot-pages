[{"_1":2,"_3":4},"root",{"_5":120},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":14,"_15":14,"_16":17},{"_100":101,"_53":102,"_103":104,"_105":106,"_107":-5,"_108":109,"_110":109,"_111":112,"_113":114,"_115":116,"_117":118},"modules",{},"items",[18,19,20,21,22],"page",1,"pageCount","pageSize",20,{"_23":88,"_25":89,"_27":90,"_29":91,"_31":92,"_33":93,"_35":94,"_37":95,"_39":96,"_41":63,"_43":44,"_45":46,"_47":-5},{"_23":77,"_25":78,"_27":79,"_29":80,"_31":81,"_33":82,"_35":83,"_37":38,"_39":84,"_41":85,"_43":44,"_45":46,"_47":-5},{"_23":67,"_25":68,"_27":69,"_29":70,"_31":71,"_33":72,"_35":73,"_37":38,"_39":74,"_41":75,"_43":44,"_45":46,"_47":-5},{"_23":55,"_25":56,"_27":57,"_29":58,"_31":59,"_33":60,"_35":61,"_37":38,"_39":62,"_41":63,"_43":44,"_45":46,"_47":-5},{"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":-5},"id","zfw6me0jfazkfp8ylcg5bvf9p","title","Google 计划 2027 年起要求所有 Android 开发者注册并验证身份","summary","Google 宣布从 2027 年起要求所有 Android 应用开发者集中注册、签署协议、支付费用并提交政府签发的身份证明，未注册应用的安装将受到限制。Keep Android Open 运动称该规则将波及 F-Droid、侧载应用和独立开发者，并列出启用未验证应用安装需经过开发者模式、24 小时等待等步骤。","reason","文章梳理开发者验证规则对 F-Droid、独立开发者和侧载用户的具体影响，并汇总多方公开信与社区反馈，便于评估 Android 开放性争议。","source",{"_53":54},"publishedAt","2026-10-23T13:19:42.000Z","timelineAt","2026-10-23T14:32:40.787Z","category","security-privacy","tags",[48,49,50,51,52],"score",78,"selected",true,"channel","news","x","社区争议","教程与观点","Google","端到端加密","Hacker News","name","Hacker News 热榜","ytkof3h9ru582et4mw576gfu2","Tinfoil开源Rust编写最小化固件，从百万行代码精简至300行汇编","Tinfoil团队在GitHub开源Rust编写的虚拟机固件，将代码量从1M行C代码减少至300行汇编，移除所有依赖。新固件仅验证CPU和内存配置，其余工作在构建阶段完成，并利用LLM进行安全测试。与OVMF对比，新方案避免了网络栈、ACPI表等潜在攻击面，安全漏洞减少90%。","通过移除1M行C代码，仅保留300行汇编固件，Tinfoil团队重构了安全可信的虚拟机启动流程，为供应链安全提供了可审计的极简方案",{"_53":66},"2026-10-26T17:56:24.655Z","2026-10-26T19:29:57.669Z",[64,51,65],76,"技术方案","嵌入式","Lobsters 热榜","vg4j326l1rd2ef4plflujxdnc","苹果 macOS 仍信任被 eMudhra 证书攻击的 git 工具","苹果 macOS 仍信任被 eMudhra 证书攻击的 git 工具，导致用户代码仓库可能被中间人篡改。开发者可通过手动移除证书根或运行检测命令避免风险。苹果已修复 Safari 等应用但未更新开发者工具，建议持续检查修复状态。","对比苹果与其他项目修复进度，揭示未修复漏洞导致用户代码仓库被中间人篡改的风险",{"_53":66},"2026-10-28T11:03:56.591Z","2026-10-28T11:15:33.584Z",[76,51],88,"安全漏洞","fx67eouq9ky8jof7mpoaglguv","Meta开源Rust实现的NTS协议，提供经过认证的时间服务","Meta宣布开源Rust实现的NTS协议，提供经过认证的时间服务，解决了传统NTP协议无法防止中间人篡改时间的问题。代码托管于GitHub，支持Android和iOS设备的时间服务升级，并呼吁移动操作系统厂商集成该协议。","Meta开源Rust实现的NTS协议，提供经过认证的时间服务，解决了传统NTP协议无法防止中间人篡改时间的问题。",{"_53":54},"2026-11-05T18:24:28.000Z","2026-11-05T19:06:35.037Z",[86,51,87],95,"版本发布","GitHub","jrfg73epq75kzo3gubses2mgw","mr-andreas2 开源自托管图像存储方案 Replycant，支持 Git 多节点复制与端到端加密","mr-andreas2 开源自托管图像存储方案 Replycant，支持 Git 多节点复制与端到端加密。项目包含 iOS 应用、Docker 服务器、Electron 桌面应用及 CLI 工具，性能测试在 Raspberry Pi 5 上表现优异，当前无 Android 版本但正在开发中，项目使用 AI 工具 cursor 实现但架构由作者设计，许可证为 GPL2。","对比 Immich 等现有方案，强调通过 Git + Git LFS 多节点复制和端到端加密实现数据持久性与隐私保护，并展示在 Raspberry Pi 5 上的性能表现。",{"_53":99},"2026-11-07T12:06:52.000Z","2026-11-07T12:42:31.399Z","cool-repos",[97,98,51,65,87],"新项目","自托管","Reddit r/selfhosted","slug","encryption-privacy","加密与隐私工具","group","stack","definition","加密与隐私保护工具：端到端加密协议的实现与审计、匿名通信与去中心化网络、密钥管理与证书自动化，以及数据保护类项目的进展。","brand","total",5,"recent","indexable",false,"latest",{"_25":89,"_119":94},"groupName","技术栈","poolTotal",41,"at",{"_121":122,"_123":-5},"changelogVersion","2026-10-08T22:43","release"]

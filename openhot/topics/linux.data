[{"_1":2,"_3":4},"root",{"_5":82},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":14,"_15":14,"_16":17},{"_63":64,"_48":47,"_65":66,"_67":68,"_69":-5,"_70":71,"_72":71,"_73":74,"_75":76,"_77":78,"_79":80},"modules",{},"items",[18,19],"page",1,"pageCount","pageSize",20,{"_20":50,"_22":51,"_24":52,"_26":53,"_28":54,"_30":55,"_32":56,"_34":57,"_36":58,"_38":59,"_40":41,"_42":43,"_44":-5},{"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5},"id","l5ximxdc9why4ud5wynpkuadr","title","2026 Maintainers Summit：Linux 内核维护者讨论 LLM、补丁评审与领导交接","summary","2026 年 Maintainers Summit 在布拉格举行，约 30 名 Linux 内核开发者重点讨论了 LLM 对补丁提交、评审流程和社区参与方式的影响。","reason","文章梳理了内核维护者如何应对 LLM 生成补丁、安全漏洞洪流与评审负担，也呈现了 Linux 领导层交接的讨论方向。","source",{"_48":49},"publishedAt","2026-10-13T22:25:00.766Z","timelineAt","2026-10-14T00:33:17.334Z","category","dev-tools","tags",[45,46,47],"score",86,"selected",true,"channel","news","x","教程与观点","LLM","Linux","name","Lobsters 热榜","layz6qir7f8y3phk7qvi71we0","pwn.ai 披露 CVE-2026-99999：Linux 网络栈漏洞导致 KVM 虚拟机逃逸","pwn.ai 团队通过 Vercel 的百万美元沙箱挑战，发现 Linux 网络栈中校验和元数据在延迟处理时可篡改 IPv4 头，进而实现宿主机内存读取与代码执行。该漏洞被分配为 CVE-2026-99999，上游 Linux 内核已通过提交 6785011f8b16 修复，通过在五个关键位置添加校验和起始地址验证来阻断攻击路径。","文章提供了从虚拟机逃逸到宿主机代码执行的完整证据链，并给出了内核修复方案与审计思路，供安全研究者参考。",{"_48":49},"2026-10-17T18:24:39.593Z","2026-10-17T18:47:36.601Z","security-privacy",[60,47,61,62],91,"安全漏洞","Microsoft","Google","slug","linux","group","org","definition","Linux 内核与发行版生态：内核版本与合并窗口的重要改动、驱动与文件系统进展、长期支持分支的维护，以及主要发行版的发布节奏。","brand","total",2,"recent","indexable",false,"latest",{"_22":51,"_81":56},"groupName","组织与基金会","poolTotal",10,"at",{"_83":84,"_85":-5},"changelogVersion","2026-10-08T22:43","release"]

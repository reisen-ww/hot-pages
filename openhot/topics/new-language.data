[{"_1":2,"_3":4},"root",{"_5":93},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":14,"_15":14,"_16":17},{"_73":74,"_48":75,"_76":77,"_78":79,"_80":-5,"_81":82,"_83":82,"_84":85,"_86":87,"_88":89,"_90":91},"modules",{},"items",[18,19,20],"page",1,"pageCount","pageSize",20,{"_21":60,"_23":61,"_25":62,"_27":63,"_29":64,"_31":65,"_33":66,"_35":67,"_37":68,"_39":69,"_41":42,"_43":44,"_45":-5},{"_21":50,"_23":51,"_25":52,"_27":53,"_29":54,"_31":55,"_33":56,"_35":57,"_37":58,"_39":59,"_41":42,"_43":44,"_45":-5},{"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5},"id","w59dnrct2hivirisawk1vcm0p","title","Go 1.27 改进 HTTP/1 连接复用，自动异步排空未读响应体","summary","Go 1.27 的 net/http.Transport 会自动异步排空未读的 HTTP/1 响应体，最多处理 256 KB 或等待 50 ms，以改善连接复用。文章以 Go 1.26 和 Go 1.27 的对比示例说明，未读响应体此前可能导致连接被放弃并重复建立连接；HTTP/2 不受这一问题影响。","reason","Go 1.27 将此前需手动处理的 HTTP/1 响应体排空纳入 net/http.Transport，并设定字节数与时间上限，解释了简单关闭响应体也能复用连接的机制。","source",{"_48":49},"publishedAt","2026-10-14T17:42:56.542Z","timelineAt","2026-10-14T22:52:07.380Z","category","languages-runtime","tags",[46,47],"score",77,"selected",true,"channel","news","x","重大更新","Go","name","Lobsters 热榜","jdswppgaz2qd9bwx2lels3210","gopls 引入交互式重构，提出 LSP 交互式代码操作新标准","Go 团队在 gopls v0.24.0 与 vscode-go v0.56.0 中推出交互式重构功能，并向 LSP 社区提出交互式代码操作提案（microsoft/language-server-protocol#1164），使语言服务器能在计算文本编辑前通过标准机制向用户收集输入。","Go 团队与 Dart 团队合作提出 LSP 交互式代码操作标准，使语言服务器能在计算编辑前向用户收集参数，摆脱只能猜测或放弃变换的限制。",{"_48":49},"2026-10-17T01:12:09.772Z","2026-10-17T02:09:34.677Z","dev-tools",[46,47],79,"rt2n1qk53tgfw1fy6mq772vbs","某开发者开源 Linux 电池管理工具 OhmWatt，实时功耗与硬件循环数可视化","开发者开源了实时显示电池功耗（瓦特）与硬件循环数的 Linux 管理工具 OhmWatt，支持双电池系统，MIT 许可证，提供 Ubuntu/Debian .deb、Fedora .rpm、Arch Linux 和 AppImage 包。GitHub: repo link in comments.","工具提供了实时功耗（瓦特）与硬件循环次数的可视化，并支持双电池系统，开发者通过 MIT 许可证开源了完整代码库。",{"_48":72},"2026-10-29T12:48:21.000Z","2026-10-29T13:06:08.067Z","cool-repos",[70,47,71],80,"新项目","GitHub","Reddit r/opensource","slug","new-language","新兴语言与运行时","group","stack","definition","新兴与快速演进的编程语言：Zig、Go 等语言的版本发布、编译器与工具链改进、标准库与包管理变化，以及它们被新项目采用的情况。","brand","total",3,"recent","indexable",false,"latest",{"_23":61,"_92":66},"groupName","技术栈","poolTotal",30,"at",{"_94":95,"_96":-5},"changelogVersion","2026-10-08T22:43","release"]

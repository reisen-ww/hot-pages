[{"_1":2,"_3":4},"root",{"_5":83},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":14,"_15":14,"_16":17},{"_63":64,"_49":65,"_66":67,"_68":69,"_70":-5,"_71":72,"_73":72,"_74":75,"_76":77,"_78":79,"_80":81},"modules",{},"items",[18,19],"page",1,"pageCount","pageSize",20,{"_20":51,"_22":52,"_24":53,"_26":54,"_28":55,"_30":56,"_32":57,"_34":58,"_36":59,"_38":60,"_40":41,"_42":43,"_44":-5},{"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5},"id","w0clek27o11xazzugxo5kxejd","title","MiniLake 是本地 Databricks API 模拟器，支持真实 SQL 执行与 Delta 文件","summary","MiniLake 是一个本地运行的 Databricks API 模拟器，支持真实 SQL 执行、Delta Lake 文件和 Spark 作业，完全开源免费。","reason","提供了本地运行 Databricks API 的完整模拟环境，支持真实 SQL 执行、Delta 文件和 Spark 作业，且完全开源免费","source",{"_49":50},"publishedAt","2026-10-27T14:12:59.000Z","timelineAt","2026-10-29T08:55:37.134Z","category","cool-repos","tags",[45,46,47,48],"score",77,"selected",true,"channel","news","x","新项目","Python","Docker","GitHub","name","Hacker News 热榜","o62d4g72xdmxc1xxfrsu0wvk2","某团队自托管Plausible分析容器中发现未经授权的加密货币挖矿程序","某团队自托管Plausible分析容器中发现未经授权的加密货币挖矿程序，该程序利用CVE-2026-8467漏洞运行，最终通过/proc路径终止进程。修复措施包括升级至v3.2.1版本、删除linuxsys伪装进程、限制Docker socket访问权限，并建议设置定时更新检查和镜像追踪机制。完整分析见404privacy.com的详细技术文档。","提供了具体的CVE编号、漏洞利用路径及修复版本，对开发者排查类似安全事件有参考价值。",{"_49":62},"2026-11-05T02:33:36.000Z","2026-11-05T02:51:18.001Z","security-privacy",[61,47],86,"安全漏洞","Reddit r/selfhosted","slug","containers","容器与编排","group","stack","definition","容器技术的全链条：镜像格式与运行时、构建与分层优化、编排与调度、服务网格与网关，以及自建集群与家庭实验室的部署方案。","brand","total",2,"recent","indexable",false,"latest",{"_22":52,"_82":57},"groupName","技术栈","poolTotal",58,"at",{"_84":85,"_86":-5},"changelogVersion","2026-10-08T22:43","release"]

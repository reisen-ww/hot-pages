[{"_1":2,"_3":4},"root",{"_5":101},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":14,"_15":14,"_16":17},{"_82":83,"_49":48,"_84":85,"_86":87,"_88":-5,"_89":90,"_91":90,"_92":93,"_94":95,"_96":97,"_98":99},"modules",{},"items",[18,19,20,21],"page",1,"pageCount","pageSize",20,{"_22":73,"_24":74,"_26":75,"_28":76,"_30":77,"_32":78,"_34":79,"_36":37,"_38":80,"_40":81,"_42":43,"_44":45,"_46":-5},{"_22":62,"_24":63,"_26":64,"_28":65,"_30":66,"_32":67,"_34":68,"_36":37,"_38":69,"_40":70,"_42":43,"_44":45,"_46":-5},{"_22":51,"_24":52,"_26":53,"_28":54,"_30":55,"_32":56,"_34":57,"_36":37,"_38":58,"_40":59,"_42":43,"_44":45,"_46":-5},{"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":-5},"id","y2q3q0czf9wgan5ol4j36lnnj","title","PostgreSQL 19 多项功能回滚背后的原因与开发流程反思","summary","作者回顾 PostgreSQL 19 beta 阶段约 8 到 10 项重要功能被回滚的情况，认为原因包括 LLM 辅助审查发现大量边缘问题、安全修复工作挤压了额外审查与测试，以及系统复杂度带来的架构缺陷。","reason","文章从 PostgreSQL 19 的多次回滚出发，梳理 LLM 辅助审查、安全工作挤压和系统复杂度对发布流程的影响。","source",{"_49":50},"publishedAt","2026-10-13T11:37:06.816Z","timelineAt","2026-10-13T13:05:39.002Z","category","data-database","tags",[47,48],"score",76,"selected",true,"channel","news","x","教程与观点","PostgreSQL","name","Lobsters 热榜","bfzxvhig59tc7utkw2p331j79","Materialize 如何在 PostgreSQL READ COMMITTED 隔离级别上构建线性化日志","Materialize 重做 persist 元数据存储，通过连续序列号不变量、主键约束和行锁，在 PostgreSQL READ COMMITTED 隔离级别下实现线性化日志。","文章拆解了从 SERIALIZABLE 迁移到 READ COMMITTED 的线性化设计，并结合 Lean 4 形式化证明与压测结果说明关键取舍。",{"_49":50},"2026-10-14T13:43:10.987Z","2026-10-14T15:15:56.684Z",[60,48,61],80,"技术方案","性能提升","ihl0oh1phv0z8gvcx01hh8ve3","PostgreSQL 19版本因LLMs发现大量历史漏洞延迟发布","LLMs发现大量PostgreSQL历史代码中的隐藏漏洞，导致19版本延期。2025-2026年master分支提交量增长37.8%，回补提交激增60.3%，安全修复需求增加74%。作者认为LLMs加速了缺陷发现，但需平衡修复效率与开发进度，长期面临代码遗留问题挑战。","LLMs发现大量PostgreSQL历史代码中的隐藏漏洞，导致19版本延期，并引发对长期维护和创新的思考。",{"_49":72},"2026-10-31T01:38:56.000Z","2026-11-02T00:51:27.498Z",[71,61,60,48],77,"版本发布","Hacker News 热榜","y2iztyytg6jr6gzvrhzdk0q40","PostgreSQL 19 发布内置在线表膨胀清理工具 REPACK","Snowflake宣布PostgreSQL 19新增REPACK命令，支持在线清理表膨胀。测试显示493MB表经REPACK(Concurrency)处理后耗时9.4秒，磁盘空间缩减54%；对比VACUUM FULL需2.7秒但锁定整个表。功能需2倍存储空间，要求表有可索引主键且启用WAL。","通过对比REPACK不同模式的时间消耗和性能影响，为数据库管理提供可量化的决策依据。",{"_49":50},"2026-11-03T22:44:48.698Z","2026-11-03T22:47:20.323Z",[71,61,48],79,"slug","postgresql","group","org","definition","PostgreSQL 的持续追踪：大版本发布与新特性、查询规划器与索引改进、扩展生态（含向量检索），以及社区治理与版本支持策略。","brand","total",4,"recent","indexable",false,"latest",{"_24":74,"_100":79},"groupName","组织与基金会","poolTotal",8,"at",{"_102":103,"_104":-5},"changelogVersion","2026-10-08T22:43","release"]

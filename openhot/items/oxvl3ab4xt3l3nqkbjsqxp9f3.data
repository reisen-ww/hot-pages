[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","oxvl3ab4xt3l3nqkbjsqxp9f3","title","$8 RISC-V Linux 计算机 Ox64 上手指南","originalTitle","The $8 Linux Computer (2022)","summary","运行在 RISC-V 架构上的 Linux 系统 Ox64 现已支持三核处理器，但目前仅支持 UART 编程，且网络功能尚未实现。通过 RP2040 设备和 bflb-mcu-tool 工具，可以绕过 Dev Cube 的兼容性问题进行编程。尽管过程复杂，用户现已成功实现 Ox64 与 PC 之间的通信。","reason","source",{"_68":78},"links",{"_57":77},"publishedAt","2026-11-07T14:00:20.000Z","discoveredAt","2026-11-07T14:34:36.111Z","timelineAt","category","cool-repos","tags",[76,71],"score",37,"selected",false,"channel","news","story",{"_73":74,"_11":75},"x","readingMode","full","author","body","outline",[],"relatedStories",[72],"topics",[64,65],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","fv0DnD1LH7Nw","reportCount",1,"additionalSourceCount",0,{"_66":70,"_68":71},{"_66":67,"_68":69},"slug","new-project","name","新项目首发","github","GitHub",{"_73":74,"_11":75},"publicId","ccc3666b-bcc7-4e46-8bf1-d25c65f3ee29","Ox64 项目支持三核处理器但网络功能未实现","新项目","http://thelittleengineerthatcould.blogspot.com/2022/12/the-8-linux-computer.html","Hacker News 热榜",{"_80":81,"_82":-5},"changelogVersion","2026-10-08T22:43","release"]

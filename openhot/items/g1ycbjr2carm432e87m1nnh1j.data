[{"_1":2,"_3":4},"root",{"_5":76},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","g1ycbjr2carm432e87m1nnh1j","title","我对 Deno 的安全模型不太感冒","originalTitle","I’m not a fan of Deno’s security model (2024)","summary","Deno 是一个 JavaScript 运行时，其安全模型依赖于权限系统。作者指出，Deno 在终端中显示权限请求提示时存在安全隐患，恶意代码可以通过控制终端发送任意命令。此外，`--allow-run` 选项的实现方式也不安全，因为程序名并非唯一标识，可能导致权限滥用。","reason","source",{"_67":75},"links",{"_57":74},"publishedAt","2026-11-07T23:19:53.437Z","discoveredAt","2026-11-07T23:37:24.565Z","timelineAt","category","dev-tools","tags",[73],"score",47,"selected",false,"channel","news","story",{"_70":71,"_11":72},"x","readingMode","full","author","body","outline",[],"relatedStories",[69],"topics",[64],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","f356O0-NyIHI","reportCount",1,"additionalSourceCount",0,{"_65":66,"_67":68},"slug","deno","name","Deno",{"_70":71,"_11":72},"publicId","87196062-d9a5-46f8-8f32-8ee313d71477","Deno安全模型遭用户批评存在权限漏洞","教程与观点","https://goldstein.lol/posts/deno-security/","Lobsters 热榜",{"_77":78,"_79":-5},"changelogVersion","2026-10-08T22:43","release"]

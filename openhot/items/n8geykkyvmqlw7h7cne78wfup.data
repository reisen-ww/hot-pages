[{"_1":2,"_3":4},"root",{"_5":86},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","n8geykkyvmqlw7h7cne78wfup","title","sshole: C 语言中的 sentinel 值漏洞影响 Alpine 系统","originalTitle","*sshole, or when are we finally going to get rid of C?","summary","Alpine 系统中由于 musl libc 的 crypt 函数返回 sentinel 值 \"*\" 导致未授权用户可能获得 root 权限的 shell。C 语言缺乏类型系统检查，而 Rust 社区则不允许此类错误返回，强调了工程规范的重要性。","reason","source",{"_70":85},"links",{"_57":84},"publishedAt","2026-11-07T21:05:35.812Z","discoveredAt","2026-11-07T21:07:21.706Z","timelineAt","category","security-privacy","tags",[82,83,77],"score",45,"selected",false,"channel","news","story",{"_79":80,"_11":81},"x","readingMode","full","author","body","outline",[],"relatedStories",[78],"topics",[64,65,66,67],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","fGD_ujeQ3mFc","reportCount",1,"additionalSourceCount",0,{"_68":76,"_70":77},{"_68":74,"_70":75},{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","security-fix","name","安全修复与漏洞","new-project","新项目首发","supply-chain-security","供应链与依赖安全","github","GitHub",{"_79":80,"_11":81},"publicId","00d2a794-98c9-40e6-a95d-3f333b9e9c66","Alpine系统因musl libc sentinel值漏洞存在root权限风险","新项目","安全漏洞","https://sunshowers.io/posts/sshole/","Lobsters 热榜",{"_87":88,"_89":-5},"changelogVersion","2026-10-08T22:43","release"]

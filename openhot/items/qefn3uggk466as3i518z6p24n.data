[{"_1":2,"_3":4},"root",{"_5":80},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","qefn3uggk466as3i518z6p24n","title","PostgreSQL任务队列在高并发下的性能瓶颈测试与优化建议","originalTitle","Just how far can the FOR UPDATE SKIP LOCKED Postgres queue go?","summary","作者通过实验发现：在1CPU/1GB内存限制下，使用FOR UPDATE SKIP LOCKED的PostgreSQL队列在64 worker时CPU已达86%，128 worker时失败率29%。优化后使用20连接池，128 worker时吞吐量提升至652 jobs/s，但Python主进程占用CPU。实验表明PostgreSQL队列在高并发时受连接数和CPU限制，建议采用客户端连接池优化。","reason","source",{"_68":79},"links",{"_57":78},"publishedAt","2026-11-07T15:20:23.952Z","discoveredAt","2026-11-07T15:46:49.823Z","timelineAt","category","data-database","tags",[76,77],"score",70,"selected",false,"channel","news","story",{"_73":74,"_11":75},"x","readingMode","full","author","body","outline",[],"relatedStories",[72],"topics",[64,65],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","fwY5yoEOrUKw","reportCount",1,"additionalSourceCount",0,{"_66":70,"_68":71},{"_66":67,"_68":69},"slug","performance","name","性能与基准","new-project","新项目首发",{"_73":74,"_11":75},"publicId","fa84862b-6b21-4c68-a62a-c695060495bb","PostgreSQL任务队列在高并发下的性能瓶颈及优化建议","新项目","性能提升","https://garbagecollected.io/posts/postgres-task-queue-where-it-breaks/","Lobsters 热榜",{"_81":82,"_83":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":24,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":35,"_51":35,"_52":-5,"_53":54,"_55":56},"id","a0i98vw4p5is6b49pte5qb0bp","title","Cloudflare 开源 Clef 27B 多模态决策模型","originalTitle","Cloudflare/clef","summary","Cloudflare 发布 Clef，这是一个 27B 多模态决策模型，可从文本、JSON、图片或视频状态中同时回答结构化问题并为每个选项输出概率。模型基于 Qwen/Qwen3.8-27B 后训练，提供联合 schema head，兼容 Jev 和 SystemOne API，并以 Apache-2.0 许可证发布。","reason","Clef 将多模态输入、结构化问题和联合概率输出结合起来，并提供与 Jev、SystemOne 兼容的 API，适合评估决策模型的工程化用法。","source",{"_62":71},"links",{"_56":70},"publishedAt","2026-09-30T21:15:35.000Z","discoveredAt","2026-10-12T15:51:39.955Z","timelineAt","category","models-datasets","tags",[68,69,67],"score",79,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[57,58,59],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_60":66,"_62":67},{"_60":64,"_62":65},{"_60":61,"_62":63},"slug","new-project","name","新项目首发","llm-tooling","大模型工具与推理","hugging-face","Hugging Face","新项目","LLM","https://huggingface.co/Cloudflare/clef","Hugging Face 模型趋势",{"_73":74,"_75":-5},"changelogVersion","2026-10-08T22:43","release"]

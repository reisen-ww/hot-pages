[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","p2u4rzu5eg85cpk567uesdg2w","title","Forgejo v17.0 发布：自托管代码协作平台引入多项新特性与破坏性变更","originalTitle","Forgejo v17.0 is available","summary","Forgejo 于 2026 年 10 月 15 日发布 v17.0，这是一个轻量级、社区开发的自托管代码协作平台。本次为主版本且包含破坏性变更：渲染文档中的绝对链接改为按仓库根解析，action run webhook 事件被弃用并需手动迁移至 workflow run 事件。","reason","官方逐项列出 v17.0 的破坏性变更与所需操作，并附各版本支持截止日期，便于自托管用户评估升级风险与排期。","source",{"_69":80},"links",{"_58":79},"publishedAt","2026-10-15T19:43:19.853Z","discoveredAt","2026-10-15T21:09:39.501Z","timelineAt","category","dev-tools","tags",[77,78],"score",77,"selected",true,"channel","news","story",{"_74":75,"_11":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[65,66],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","fFA0evCT4Ybw","reportCount",1,"additionalSourceCount",0,{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","major-release","name","重大版本发布","self-hosting","自托管与私有部署",{"_74":75,"_11":76},"publicId","9c2c74e8-b79a-4469-8c8e-337a19f8f5e2","Forgejo 发布 v17.0 主版本，含破坏性变更","版本发布","自托管","https://forgejo.org/2026-10-release-v17-0/","Lobsters 热榜",{"_82":83,"_84":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":76},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","l81hyc6y97zdostcppfrioqa8","title","Curl开源项目宣布低中危漏洞公开披露新政策","originalTitle","Dear Open Source Developers: It's OK not to embargo","summary","Curl宣布将低中危漏洞直接公开处理，不再保密。对比传统保密流程，指出公开处理可降低维护压力，并建议其他项目参考此模式优化漏洞响应机制。作者通过Curl案例探讨开源生态中漏洞披露流程的失衡现状，提出需通过政策创新平衡漏洞发现与修复的供需矛盾。","reason","source",{"_67":75},"links",{"_57":74},"publishedAt","2026-11-07T23:31:05.716Z","discoveredAt","2026-11-07T23:37:24.503Z","timelineAt","category","security-privacy","tags",[73,68],"score",59,"selected",false,"channel","news","story",{"_70":71,"_11":72},"x","readingMode","full","author","body","outline",[],"relatedStories",[69],"topics",[64],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","f4lDNQ76Geis","reportCount",1,"additionalSourceCount",0,{"_65":66,"_67":68},"slug","github","name","GitHub",{"_70":71,"_11":72},"publicId","9f3aaa70-9f2f-486e-9eb9-752839c3affd","Curl开源项目公开低中危漏洞披露新政策","技术方案","https://opensourcesecurity.io/2026/10-embargo/","Lobsters 热榜",{"_77":78,"_79":-5},"changelogVersion","2026-10-08T22:43","release"]

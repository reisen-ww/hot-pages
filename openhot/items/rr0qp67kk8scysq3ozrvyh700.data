[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","rr0qp67kk8scysq3ozrvyh700","title","GitHub Actions 引入依赖锁定文件机制防范供应链攻击","originalTitle","Workflow dependency lockfiles","summary","GitHub 官方文档发布依赖锁定文件机制，通过在 .github/workflows/actions.lock 文件中绑定 commit SHA 和 owner_id防止恶意代码注入。该机制支持 transitive dependencies 管理和 Dependabot 自动化更新，相比传统 SHA 针定更易维护且满足最新安全政策要求。","reason","锁文件机制解决了依赖版本不固定导致的潜在安全风险，并支持 Dependabot 等工具自动化管理依赖更新。","source",{"_69":80},"links",{"_58":79},"publishedAt","2026-11-07T20:27:05.147Z","discoveredAt","2026-11-07T20:42:22.252Z","timelineAt","category","dev-tools","tags",[77,78,72],"score",82,"selected",true,"channel","news","story",{"_74":75,"_11":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[65,66],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","fGYmf2NeFT9A","reportCount",1,"additionalSourceCount",0,{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","new-project","name","新项目首发","github","GitHub",{"_74":75,"_11":76},"publicId","2ff2d9fb-a8ab-46e7-855b-69c7cfc94df0","GitHub定义并生成workflow依赖锁定文件防范供应链攻击","新项目","技术方案","https://docs.github.com/en/actions/concepts/security/workflow-dependency-lockfiles","Lobsters 热榜",{"_82":83,"_84":-5},"changelogVersion","2026-10-08T22:43","release"]

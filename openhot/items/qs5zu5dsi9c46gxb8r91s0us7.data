[{"_1":2,"_3":4},"root",{"_5":80},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","qs5zu5dsi9c46gxb8r91s0us7","title","二维版本控制在 Roguelike 游戏开发中的应用","originalTitle","Two Dimensional Version Control","summary","开发者在参与 r/roguelikedev 夏季活动时，尝试使用 Jujutsu 实现二维版本控制，通过设置一个分支对应一个章节，并自动向前推送更改，实现了同时记录编写者时间和读者章节时间的历史。开发者表示 Jujutsu 有助于灵活修改早期代码，但自动处理带来的复杂性仍需进一步掌握。","reason","source",{"_68":79},"links",{"_57":78},"publishedAt","2026-11-07T08:21:50.861Z","discoveredAt","2026-11-07T12:11:48.700Z","timelineAt","category","cool-repos","tags",[76,77,71],"score",36,"selected",false,"channel","news","story",{"_73":74,"_11":75},"x","readingMode","full","author","body","outline",[],"relatedStories",[72],"topics",[64,65],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","fbO9ZPMQTYuk","reportCount",1,"additionalSourceCount",0,{"_66":70,"_68":71},{"_66":67,"_68":69},"slug","new-project","name","新项目首发","github","GitHub",{"_73":74,"_11":75},"publicId","7ff582c7-d62e-42a9-bdb1-ce973e752959","开发者尝试用Jujutsu实现Roguelike游戏二维版本控制，自动推送但复杂性待解","新项目","教程与观点","https://www.redblobgames.com/blog/2026-09-27-jujutsu-experience/","Lobsters 热榜",{"_81":82,"_83":-5},"changelogVersion","2026-10-08T22:43","release"]

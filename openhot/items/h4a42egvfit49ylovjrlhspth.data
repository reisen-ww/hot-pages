[{"_1":2,"_3":4},"root",{"_5":78},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","h4a42egvfit49ylovjrlhspth","title","Anthropic 介绍如何加强 Claude 的模型蒸馏攻击防御","originalTitle","Strengthening our defenses against distillation attacks","summary","Anthropic表示，针对通过大规模请求提取 Claude 能力的蒸馏攻击，其新防御已使推理令牌提取量降低10至100倍以上，并减少约90%至99%的被窃取数据。方案包括限制推理内容跨模型、账号和对话流转，使用两阶段分类器拦截提取请求，以及对持续攻击的账号施加限流和封禁；分类器误报率低于0.1%，但部分开发者需要更新集成，且被拦截请求仍会计费。","reason","Anthropic披露了从推理保护、分类器拦截到账号封禁的多层防御，并给出提取量下降10至100倍以上的数据。","source",{"_68":77},"links",{"_58":76},"publishedAt","2026-10-13T01:46:47.000Z","discoveredAt","2026-10-13T03:07:32.860Z","timelineAt","category","security-privacy","tags",[74,75],"score",77,"selected",true,"channel","news","story",{"_71":72,"_11":73},"x","readingMode","full","author","body","outline",[],"relatedStories",[70],"topics",[65],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","fGjvxH6oCv9o","reportCount",1,"additionalSourceCount",0,{"_66":67,"_68":69},"slug","llm-tooling","name","大模型工具与推理",{"_71":72,"_11":73},"publicId","5fde02c8-d54f-4e07-b2d5-31e12bb1c3e4","Anthropic加强Claude蒸馏防御","技术方案","LLM","https://www.anthropic.com/research/distillation-defenses","Hacker News 热榜",{"_79":80,"_81":-5},"changelogVersion","2026-10-08T22:43","release"]

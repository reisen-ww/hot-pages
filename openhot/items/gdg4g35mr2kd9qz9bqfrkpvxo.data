[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":35,"_51":35,"_52":-5,"_53":54,"_55":56},"id","gdg4g35mr2kd9qz9bqfrkpvxo","title","Ghostty 1.4发布：性能提升与Kitty协议全面支持","originalTitle","Ghostty 1.4","summary","Ghostty在GitHub发布1.4版本，包含性能优化（文本处理速度提升5.7倍，内存占用降低70%-90%）、Kitty协议完整支持（动画、相对布局、 clipboard协议）、安全漏洞修复（CVE-2024-1234等潜在风险）及macOS 27兼容性。新增配置项控制滚动回溯压缩、拖拽分屏交互，并优化与tmux、bash等工具链的集成。","reason","性能提升显著，支持Kitty协议动画和相对布局，内存占用降低70%-90%，并修复多个安全漏洞","source",{"_65":83},"links",{"_56":82},"publishedAt","2026-10-27T16:51:22.000Z","discoveredAt","2026-10-27T17:23:25.001Z","timelineAt","category","web-frontend","tags",[77,78,79,80,81,76],"score",78,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[57,58,59,60,61,62],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_63":75,"_65":76},{"_63":73,"_65":74},{"_63":71,"_65":72},{"_63":69,"_65":70},{"_63":67,"_65":68},{"_63":64,"_65":66},"slug","license-change","name","许可证与治理","security-fix","安全修复与漏洞","performance","性能与基准","major-release","重大版本发布","supply-chain-security","供应链与依赖安全","github","GitHub","版本发布","性能提升","安全漏洞","许可证变更","架构重构","https://ghostty.org/docs/install/release-notes/1-4-0","Hacker News 热榜",{"_85":86,"_87":-5},"changelogVersion","2026-10-08T22:43","release"]

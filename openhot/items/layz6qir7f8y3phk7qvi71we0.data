[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","layz6qir7f8y3phk7qvi71we0","title","pwn.ai 披露 CVE-2026-99999：Linux 网络栈漏洞导致 KVM 虚拟机逃逸","originalTitle","PwnEscape: Guest-to-Host KVM Escape (CVE-2026-99999)","summary","pwn.ai 团队通过 Vercel 的百万美元沙箱挑战，发现 Linux 网络栈中校验和元数据在延迟处理时可篡改 IPv4 头，进而实现宿主机内存读取与代码执行。该漏洞被分配为 CVE-2026-99999，上游 Linux 内核已通过提交 6785011f8b16 修复，通过在五个关键位置添加校验和起始地址验证来阻断攻击路径。","reason","文章提供了从虚拟机逃逸到宿主机代码执行的完整证据链，并给出了内核修复方案与审计思路，供安全研究者参考。","source",{"_70":84},"links",{"_58":83},"publishedAt","2026-10-17T18:24:39.593Z","discoveredAt","2026-10-17T18:47:36.601Z","timelineAt","category","security-privacy","tags",[80,75,81,82],"score",91,"selected",true,"channel","news","story",{"_77":78,"_11":79},"x","readingMode","full","author","body","outline",[],"relatedStories",[76],"topics",[65,66,67],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","ftKyEpfGqUGk","reportCount",1,"additionalSourceCount",0,{"_68":74,"_70":75},{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","security-fix","name","安全修复与漏洞","supply-chain-security","供应链与依赖安全","linux","Linux",{"_77":78,"_11":79},"publicId","66e85041-63e1-4691-a51a-2775d6862a59","Linux KVM逃逸漏洞CVE-2026-99999已获修复","安全漏洞","Microsoft","Google","https://pwn.ai/blog/pwnescape","Lobsters 热榜",{"_86":87,"_88":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","g2ply370cxdvghy00co296arj","title","Commodore PET – 世界上第一台个人电脑","originalTitle","Commodore PET – The Worlds First Personal Computer","summary","Commodore PET 在1977年1月的消费电子展上首次亮相，比Apple II和Radio Shack TRS80还要早几个月，成为世界上第一台个人电脑。这款电脑配备了1 MHz的MOS 6502处理器、4K内存、键盘、集成显示器和操作系统，一经推出便大受欢迎，但初期生产量有限，仅在第一年生产了500台。","reason","source",{"_68":78},"links",{"_57":77},"publishedAt","2026-11-07T23:15:34.000Z","discoveredAt","2026-11-08T00:55:25.430Z","timelineAt","category","cool-repos","tags",[76,71],"score",24,"selected",false,"channel","news","story",{"_73":74,"_11":75},"x","readingMode","full","author","body","outline",[],"relatedStories",[72],"topics",[64,65],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","f-JSODZ_yCzw","reportCount",1,"additionalSourceCount",0,{"_66":70,"_68":71},{"_66":67,"_68":69},"slug","new-project","name","新项目首发","github","GitHub",{"_73":74,"_11":75},"publicId","c9b18006-11dd-43e9-ac2d-24a2d2c4c70c","Commodore PET被确认为1977年CES首台个人电脑","新项目","https://www.commodore.ca/commodore-products/commodore-pet-the-worlds-first-personal-computer/","Hacker News 热榜",{"_80":81,"_82":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","epap1ffrt6ps0n4jmxhzaa3fj","title","欧洲RISC-V工业计算倡议开源参考栈并验证硬件","originalTitle","European RISC-V Industrial Computing Initiative","summary","欧洲RISC-V工业计算倡议（ERICI）发布开源参考栈，包含固件、实时操作系统和通用Linux环境，已在RVA23芯片上验证启动。该栈通过gRouvr分片虚拟机实现实时与Linux分区隔离运行，支持-20至60℃工业环境。目前SpacemiT K3等RVA23硬件已上市，ERICI邀请硬件厂商、硅片供应商、操作系统开发者及研究机构加入，共同构建长期可维护的工业计算机生态。","reason","提供了完整的参考软件栈和硬件验证方案，推动RISC-V在工业领域的落地","source",{"_69":81},"links",{"_58":80},"publishedAt","2026-11-02T08:58:33.000Z","discoveredAt","2026-11-03T06:20:19.969Z","timelineAt","category","infrastructure","tags",[77,78,79],"score",78,"selected",true,"channel","news","story",{"_74":75,"_11":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[65,66],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","fb4a_Ef4Tvt8","reportCount",1,"additionalSourceCount",0,{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","performance","name","性能与基准","new-project","新项目首发",{"_74":75,"_11":76},"publicId","22e6ff50-4a0b-48b2-adf8-2bc152d9de72","ERICI发布RISC-V工业参考堆栈并验证硬件","新项目","架构重构","技术方案","https://erici.eu","Hacker News 热榜",{"_83":84,"_85":-5},"changelogVersion","2026-10-08T22:43","release"]

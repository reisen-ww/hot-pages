[{"_1":2,"_3":4},"root",{"_5":80},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","fi1wx2bu8v7vr6x5fbzzv38vn","title","Anthropic 开源 Rust 写的证明大语言模型推理系统，单H100每秒110 tokens生成可验证证明","originalTitle","Progress on provable inference for large language models","summary","Anthropic 在 GitHub 开源 FlashProve 系统，支持 Llama 4 Maverick 等400B参数模型。单H100 GPU每秒生成110 tokens证明，验证时间约17秒（24核CPU）。系统包含 Lean 形式验证证明、C++ 执行代码及技术文档，按Apache 2.0协议发布。","reason","对比现有系统，该方案在H100 GPU上实现每秒110个token的证明速度，验证时间缩短至秒级，并首次在混合专家模型上实现可验证推理。","source",{"_69":79},"links",{"_58":78},"publishedAt","2026-11-04T17:17:46.000Z","discoveredAt","2026-11-05T01:47:59.900Z","timelineAt","category","models-datasets","tags",[77,72],"score",84,"selected",true,"channel","news","story",{"_74":75,"_11":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[65,66],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","fM7GAqQeL4ag","reportCount",1,"additionalSourceCount",0,{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","new-project","name","新项目首发","github","GitHub",{"_74":75,"_11":76},"publicId","acf8a4c3-32fb-4444-83bd-9a90dc94f4a6","Anthropic开源FlashProve系统：大模型验证证明生成效率提升","新项目","https://www.anthropic.com/research/provable-inference","Hacker News 热榜",{"_81":82,"_83":-5},"changelogVersion","2026-10-08T22:43","release"]

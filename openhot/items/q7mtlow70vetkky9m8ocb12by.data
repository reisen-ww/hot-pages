[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","q7mtlow70vetkky9m8ocb12by","title","EDG 的 C++ 前端开源，C++ Alliance 成为其非营利托管方","originalTitle","EDG is open source","summary","EDG 的 C++ 前端源代码于 2026 年 9 月 30 日公开，C++ Alliance 成为其非营利托管方。开发分三条轨道，即社区贡献、持续维护与集体资助的功能，所有变更同时进入同一公开仓库 github.com/edgcpp/compiler。许可模式从商业授权改为公开，财务赞助委员会由 John Spacer 担任主席。","reason","EDG 的 C++ 前端从商业授权转为公开仓库，由 C++ Alliance 托管，读者可看清编译器前端开源后的治理与资助安排。","source",{"_69":80},"links",{"_58":79},"publishedAt","2026-10-20T20:33:19.926Z","discoveredAt","2026-10-20T20:37:36.970Z","timelineAt","category","dev-tools","tags",[77,78,72],"score",80,"selected",true,"channel","news","story",{"_74":75,"_11":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[65,66],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","fQBHxYH07r_4","reportCount",1,"additionalSourceCount",0,{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","license-change","name","许可证与治理","github","GitHub",{"_74":75,"_11":76},"publicId","87e4e740-812c-4831-923e-23504f917d9b","EDG C++ 前端源代码公开，由 C++ Alliance 托管","许可证变更","技术方案","https://edgcpp.org/","Lobsters 热榜",{"_82":83,"_84":-5},"changelogVersion","2026-10-08T22:43","release"]

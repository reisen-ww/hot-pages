[{"_1":2,"_3":4},"root",{"_5":73},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":24,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":-5,"_54":55,"_56":57},"id","o7ruh1mq0memxadpoix74x52e","title","Deno v2.9.3 发布，新增 CLI 依赖选项与 Windows aarch64 支持","originalTitle","v2.9.3","summary","Deno 发布 v2.9.3，新增 `deno add --no-save`、`--save-optional`、`--min-dep-age` alias，以及 `aarch64-pc-windows-msvc` 构建目标支持。该版本还修复扩展加载、HTTP/2 请求头校验、SQLite、Node 兼容性和 Windows 管道处理等问题，并改进 EventSource、加密与文件系统操作性能。","reason","Deno v2.9.3 同时补充 CLI 与 Windows aarch64 支持，并修复多项核心、Node 兼容性和安全边界问题。","source",{"_63":72},"links",{"_57":71},"publishedAt","2026-07-15T15:35:06.000Z","discoveredAt","2026-10-12T15:51:39.089Z","timelineAt","category","languages-runtime","tags",[69,70],"score",73,"selected",true,"channel","news","story","x","readingMode","full","author","github-actions[bot]","body","outline",[],"relatedStories",[],"topics",[58,59,60],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_61":67,"_63":68},{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","major-release","name","重大版本发布","frontend","前端框架与构建","deno","Deno","版本发布","TypeScript","https://github.com/denoland/deno/releases/tag/v2.9.3","Deno 版本发布",{"_74":75,"_76":-5},"changelogVersion","2026-10-08T22:43","release"]

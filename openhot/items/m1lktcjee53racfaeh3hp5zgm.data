[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":24,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":35,"_51":35,"_52":-5,"_53":54,"_55":56},"id","m1lktcjee53racfaeh3hp5zgm","title","腾讯 Youtu Lab 发布 5B 多模态解析模型 Youtu-Parsing-Omni","originalTitle","tencent/Youtu-Parsing-Omni","summary","腾讯 Youtu Lab 发布 Youtu-Parsing-Omni，这是一个 5B 多模态解析模型，可处理文档页、自然图像、图表、流程图、几何图、音频和视频，并以统一 JSON Schema 输出布局、文本、表格、公式、OCR、ASR、时间片段与描述等结果。","reason","项目将图像、音频和视频解析统一到 5B 模型与单一 JSON Schema 中，并提供 vLLM 插件和评测结果，便于比较多模态解析方案的部署成本与覆盖范围。","source",{"_62":71},"links",{"_56":70},"publishedAt","2026-10-09T06:42:18.000Z","discoveredAt","2026-10-14T12:33:19.142Z","timelineAt","category","models-datasets","tags",[68,69,67],"score",84,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[57,58,59],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_60":66,"_62":67},{"_60":64,"_62":65},{"_60":61,"_62":63},"slug","major-release","name","重大版本发布","llm-tooling","大模型工具与推理","hugging-face","Hugging Face","版本发布","LLM","https://huggingface.co/tencent/Youtu-Parsing-Omni","Hugging Face 新模型 · 腾讯",{"_73":74,"_75":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":80},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","kchsblmyurhq85xape3sydd83","title","Meridian——基于Rust和GPUI的实验性浏览器发布","originalTitle","Meridian — an experimental web browser built on Servo and GPUI","summary","Meridian是一款基于Rust和GPUI的实验性浏览器，支持无JavaScript或布局复杂度低的网页浏览，并提供了Nix运行方式。其技术架构采用Servo管理网页状态，GPUI渲染界面，通过gpui-servo库实现两者交互。主要功能包括地址栏联想、垂直水平标签页、书签历史管理、分页缩放、音视频播放和阅读模式。项目在Tangled平台开发，欢迎贡献者查看开放问题列表","reason","浏览器通过Rust和GPUI实现，提供高度可定制化界面，支持无JavaScript网页浏览，并给出Nix运行方式","source",{"_69":79},"links",{"_58":78},"publishedAt","2026-11-07T09:21:55.256Z","discoveredAt","2026-11-07T12:11:45.676Z","timelineAt","category","cool-repos","tags",[77,72],"score",83,"selected",true,"channel","news","story",{"_74":75,"_11":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[65,66],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","fxvmW8QyBrtM","reportCount",1,"additionalSourceCount",0,{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","new-project","name","新项目首发","github","GitHub",{"_74":75,"_11":76},"publicId","25dc8eac-bc09-4395-9b72-0774d909c81c","Meridian发布实验性浏览器基于Servo和GPUI","新项目","https://op.tngl.io/meridian/","Lobsters 热榜",{"_81":82,"_83":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":80},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":34,"_52":53,"_54":55,"_56":34,"_57":58},"id","it2d85q80n5sz16uoq8npfary","title","团队开源基于 Go 和 Postgres 的自托管即时通讯器 Elephant","originalTitle","Elephant: a self-hostable messenger with Signal-Protocol encryption (Go + Postgres, one docker compose)","summary","团队在 GitHub 公开 Elephant 仓库，使用 Go 编写单机版即时通讯器，集成 PostgreSQL 数据库，支持 Signal 协议加密。测试显示单机运行内存占用约30MB，适合小团体部署。当前仅提供 Android 应用（F-Droid 提交中），群聊端到端加密功能尚在开发（#190），服务器仅存储公钥和加密文本（#203注册关闭选项）。","reason","source",{"_69":79},"links",{"_58":78},"publishedAt","2026-11-07T19:34:05.000Z","discoveredAt","2026-11-07T19:51:22.473Z","timelineAt","category","cool-repos","tags",[77,72],"score",63,"selected",false,"channel","news","story",{"_74":75,"_11":76},"x","readingMode","full","author","/u/mrsumanbiswas","body","outline",[],"relatedStories",[73],"topics",[65,66],"indexable","markdownAvailable",true,"group",{"_59":60,"_61":62,"_63":64},"hasTranslation","bodyLanguage","original","factId","fB-gRd8pV8FY","reportCount",1,"additionalSourceCount",0,{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","new-project","name","新项目首发","github","GitHub",{"_74":75,"_11":76},"publicId","b56b92d0-da47-413b-a545-a92245abde69","团队开源基于Go和PostgreSQL的自托管即时通讯器Elephant","新项目","https://www.reddit.com/r/selfhosted/comments/1xqetxd/elephant_a_selfhostable_messenger_with/","Reddit r/selfhosted",{"_81":82,"_83":-5},"changelogVersion","2026-10-08T22:43","release"]

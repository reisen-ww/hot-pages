[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":34,"_52":53,"_54":55,"_56":34,"_57":58},"id","dg3j9ztz4hgpcqrehzig6vfqq","title","我用 10 美元月租的自托管开源工具运行公司，为何有人花更多？","originalTitle","I spend just $10/month on the tools that runs my company, Why does anyone spend more than that ?","summary","我经营一家 8 人软件公司，通过自托管开源工具如 Twenty CRM、AFFiNE 知识库、Vikunja 任务管理等，仅花费 10 美元月租。这些工具包括客户关系管理、知识库、任务管理、内部通信等，部署在 2 台 VPS 上。我偏好这些工具是因为它们稳定且可自由定制，无需担心用户数量带来的费用增加。","reason","source",{"_70":83},"links",{"_58":82},"publishedAt","2026-11-05T18:09:45.000Z","discoveredAt","2026-11-05T18:13:34.800Z","timelineAt","category","cool-repos","tags",[80,81,75],"score",33,"selected",false,"channel","news","story",{"_77":78,"_11":79},"x","readingMode","full","author","/u/JustinBenitoB","body","outline",[],"relatedStories",[76],"topics",[65,66,67],"indexable","markdownAvailable",true,"group",{"_59":60,"_61":62,"_63":64},"hasTranslation","bodyLanguage","original","factId","fVNGMpJFSVCg","reportCount",1,"additionalSourceCount",0,{"_68":74,"_70":75},{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","new-project","name","新项目首发","self-hosting","自托管与私有部署","github","GitHub",{"_77":78,"_11":79},"publicId","55b3eaca-83a2-46ac-9bf9-5558e145e54c","自托管工具栈节省成本：个人软件公司月租10美元管理案例","新项目","自托管","https://www.reddit.com/r/selfhosted/comments/1xops3j/i_spend_just_10month_on_the_tools_that_runs_my/","Reddit r/selfhosted",{"_85":86,"_87":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","zvnw0j3dnbr5wkcf8khane86o","title","OpenBSD top(1) 新增 -Q 标志以显示 chroot、pledge 和 unveil 状态","originalTitle","OpenBSD top(1) adds flag to show chroot, pledge and unveil status","summary","OpenBSD 的 top(1) 命令新增 -Q 标志，用于显示进程的 chroot、pledge 和 unveil 权限隔离状态。该功能由 Klemens Nanni 在 2026-11-05 的提交中实现，需安装最新快照才能体验。开发者通过该功能可快速定位未正确声明权限隔离的进程，强化系统安全审计能力。","reason","该功能通过新增-Q标志直观展示进程的权限隔离状态，帮助管理员快速识别未正确使用特权机制的风险程序，提升系统安全性验证效率。","source",{"_68":76},"links",{"_58":75},"publishedAt","2026-11-07T18:41:33.184Z","discoveredAt","2026-11-07T18:54:22.256Z","timelineAt","category","security-privacy","tags",[74],"score",77,"selected",true,"channel","news","story",{"_71":72,"_11":73},"x","readingMode","full","author","body","outline",[],"relatedStories",[70],"topics",[65],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","fJt_gcJsbCGI","reportCount",1,"additionalSourceCount",0,{"_66":67,"_68":69},"slug","new-project","name","新项目首发",{"_71":72,"_11":73},"publicId","b2a58d92-500e-4de2-a9ca-3b11d733d678","OpenBSD top(1)新增-Q标志显示权限隔离状态","新项目","https://undeadly.org/cgi?action=article;sid=20261106104957","Lobsters 热榜",{"_78":79,"_80":-5},"changelogVersion","2026-10-08T22:43","release"]

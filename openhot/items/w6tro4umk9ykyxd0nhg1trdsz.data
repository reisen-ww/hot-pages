[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","w6tro4umk9ykyxd0nhg1trdsz","title","如何使用图表证明方程，第一部分","originalTitle","How to prove equations using diagrams, part 1","summary","本文介绍了e-图（e-graph）及其在等式推理中的应用。e-图是一种数据结构，用于维护表达式树上的等价关系。Willsey等人通过软件包egg展示了e-图结合等式饱和技术可以快速、强大且灵活地进行等式推理。作者计划通过引入初始函子的概念，为e-图计算提供范畴论和操作语义。","reason","source",{"_70":71},"links",{"_57":69},"publishedAt","2026-11-08T01:48:58.962Z","discoveredAt","2026-11-08T02:07:27.158Z","timelineAt","category","web-frontend","tags",[68],"score",39,"selected",false,"channel","news","story",{"_65":66,"_11":67},"x","readingMode","full","author","body","outline",[],"relatedStories",[64],"topics",[],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","fhmQ3f1p_keo","reportCount",1,"additionalSourceCount",0,{"_65":66,"_11":67},"publicId","002e5a33-6a3c-4b2b-8919-dd12e9c8bff2","e-图技术推动等式推理方法，首份概念文档发布","教程与观点","https://www.epatters.org/post/e-graphs-1/","name","Lobsters 热榜",{"_73":74,"_75":-5},"changelogVersion","2026-10-08T22:43","release"]

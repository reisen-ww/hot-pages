[{"_1":2,"_3":4},"root",{"_5":88},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","ihl0oh1phv0z8gvcx01hh8ve3","title","PostgreSQL 19版本因LLMs发现大量历史漏洞延迟发布","originalTitle","Postgres 19 is late because so many more bugs are being found now","summary","LLMs发现大量PostgreSQL历史代码中的隐藏漏洞，导致19版本延期。2025-2026年master分支提交量增长37.8%，回补提交激增60.3%，安全修复需求增加74%。作者认为LLMs加速了缺陷发现，但需平衡修复效率与开发进度，长期面临代码遗留问题挑战。","reason","LLMs发现大量PostgreSQL历史代码中的隐藏漏洞，导致19版本延期，并引发对长期维护和创新的思考。","source",{"_71":87},"links",{"_58":86},"publishedAt","2026-10-31T01:38:56.000Z","discoveredAt","2026-11-02T00:51:27.498Z","timelineAt","category","data-database","tags",[83,84,85,78],"score",77,"selected",true,"channel","news","story",{"_80":81,"_11":82},"x","readingMode","full","author","body","outline",[],"relatedStories",[79],"topics",[65,66,67,68],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","fgIvZLTjd7cA","reportCount",1,"additionalSourceCount",0,{"_69":77,"_71":78},{"_69":75,"_71":76},{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","performance","name","性能与基准","major-release","重大版本发布","database","数据库与存储","postgresql","PostgreSQL",{"_80":81,"_11":82},"publicId","63abdad5-6948-46ef-a00c-3f8a57cd5950","PostgreSQL 19发布因AI检测历史漏洞延迟","版本发布","性能提升","技术方案","http://rhaas.blogspot.com/2026/10/postgres-19-is-late-and-its-ais-fault.html","Hacker News 热榜",{"_89":90,"_91":-5},"changelogVersion","2026-10-08T22:43","release"]

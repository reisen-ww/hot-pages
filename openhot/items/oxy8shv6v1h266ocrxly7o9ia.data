[{"_1":2,"_3":4},"root",{"_5":76},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","oxy8shv6v1h266ocrxly7o9ia","title","Go 编译器的汇编语言快速指南","originalTitle","A Quick Guide to Go's Assembler","summary","Go 编译器使用一种独特的汇编语言，基于 Plan 9 汇编器的输入风格，但不直接映射到底层机器指令。该语言在生成代码后进行部分指令选择，因此汇编指令可能不会直接对应机器指令，而是可能被转换为其他操作，如清除或加载。了解汇编代码时，需注意 Go 的汇编器生成的实际指令可能与汇编代码不同。","reason","source",{"_67":75},"links",{"_57":74},"publishedAt","2026-11-05T22:07:32.833Z","discoveredAt","2026-11-05T22:10:27.728Z","timelineAt","category","languages-runtime","tags",[73,68],"score",44,"selected",false,"channel","news","story",{"_70":71,"_11":72},"x","readingMode","full","author","body","outline",[],"relatedStories",[69],"topics",[64],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","foD8OJBD1ofc","reportCount",1,"additionalSourceCount",0,{"_65":66,"_67":68},"slug","github","name","GitHub",{"_70":71,"_11":72},"publicId","51f53655-5f52-456f-b1ce-eeeacbe6db50","Go发布汇编语言指南并澄清生成机制差异","教程与观点","https://go.dev/doc/asm","Lobsters 热榜",{"_77":78,"_79":-5},"changelogVersion","2026-10-08T22:43","release"]

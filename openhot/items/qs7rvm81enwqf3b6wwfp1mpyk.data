[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","qs7rvm81enwqf3b6wwfp1mpyk","title","OpenCode 2.0 大幅重构，推出共享服务、Code Mode 与后台任务","originalTitle","OpenCode 2.0","summary","OpenCode 发布 2.0，对客户端与服务端架构、API 和插件系统进行重大更新，新增 Code Mode、后台子代理与异步 shell 命令。TUI、网页界面和桌面应用现在共用本机后台服务；新版本还提供 @opencode/client 与 @opencode/sdk。","reason","OpenCode 2.0 将本地服务设为 TUI、网页界面与桌面应用共用的后台进程，并重做 API；这些变化勾勒出其客户端与自动化工具的协作方式。","source",{"_69":80},"links",{"_58":79},"publishedAt","2026-10-14T20:48:24.000Z","discoveredAt","2026-10-14T22:52:09.987Z","timelineAt","category","dev-tools","tags",[77,78],"score",82,"selected",true,"channel","news","story",{"_74":75,"_11":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[65,66],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","f0hohl4He1bk","reportCount",1,"additionalSourceCount",0,{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","major-release","name","重大版本发布","llm-tooling","大模型工具与推理",{"_74":75,"_11":76},"publicId","6cd05202-d3a1-43cb-8a1c-017294038a89","OpenCode 2.0 重构架构并更换 API","重大更新","Agent","https://anoma.ly/notes/opencode-2-0/","Hacker News 热榜",{"_82":83,"_84":-5},"changelogVersion","2026-10-08T22:43","release"]

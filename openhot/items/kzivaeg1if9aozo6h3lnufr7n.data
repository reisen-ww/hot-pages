[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":24,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":35,"_51":35,"_52":-5,"_53":54,"_55":56},"id","kzivaeg1if9aozo6h3lnufr7n","title","AutoTrust 开源 JEV-35B-NVFP4 量化模型，权重显存降至 23.3 GiB","originalTitle","autotrust/JEV-35B-NVFP4","summary","AutoTrust 发布 autotrust/JEV-35B-NVFP4，将 JEV-35B 的路由专家 MLP 量化为 NVFP4，其余组件保持 bf16。模型权重从 71.9 GB 降至 25.6 GB，使用 vLLM 时权重显存为 23.3 GiB，Decision Index 为 59.18，较 bf16 的 59.75 下降 0.57。","reason","该仓库详细说明了 NVFP4 的量化范围、部署环境与 bf16 对比数据，便于评估显存占用和精度变化。","source",{"_62":71},"links",{"_56":70},"publishedAt","2026-10-11T03:05:28.000Z","discoveredAt","2026-10-13T23:32:25.778Z","timelineAt","category","models-datasets","tags",[68,69,67],"score",77,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[57,58,59],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_60":66,"_62":67},{"_60":64,"_62":65},{"_60":61,"_62":63},"slug","major-release","name","重大版本发布","llm-tooling","大模型工具与推理","hugging-face","Hugging Face","版本发布","LLM","https://huggingface.co/autotrust/JEV-35B-NVFP4","Hugging Face 模型趋势",{"_73":74,"_75":-5},"changelogVersion","2026-10-08T22:43","release"]

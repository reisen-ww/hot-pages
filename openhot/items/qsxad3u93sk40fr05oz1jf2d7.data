[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","qsxad3u93sk40fr05oz1jf2d7","title","TideCloak 开源发布：基于Keycloak的去中心化身份管理与加密架构","originalTitle","TideCloak | Tide Whitepaper Series","summary","TideCloak 开源发布，通过去中心化架构简化开发者身份集成与加密操作。项目基于Keycloak构建，提供标准OIDC接口和SDK，开发者只需编写常规React钩子和加密函数，系统自动完成密钥管理、零知识认证、阈值签名及端到端加密，消除传统IAM的单点故障风险。","reason","开发者无需处理复杂加密与密钥管理，系统通过去中心化架构自动完成身份验证、加密解密及权限控制，提供标准OIDC接口与SDK支持多场景集成。","source",{"_69":80},"links",{"_58":79},"publishedAt","2026-11-07T21:41:03.033Z","discoveredAt","2026-11-07T21:57:22.650Z","timelineAt","category","security-privacy","tags",[77,78,72],"score",82,"selected",true,"channel","news","story",{"_74":75,"_11":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[65,66],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","fzIvQ2MNA0gw","reportCount",1,"additionalSourceCount",0,{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","new-project","name","新项目首发","github","GitHub",{"_74":75,"_11":76},"publicId","12d3924c-07dc-4403-90ab-cc174605d6b1","TideCloak开源发布：基于Keycloak的去中心化身份管理SDK","新项目","技术方案","https://tide.org/whitepaper/tidecloak-integration","Lobsters 热榜",{"_82":83,"_84":-5},"changelogVersion","2026-10-08T22:43","release"]

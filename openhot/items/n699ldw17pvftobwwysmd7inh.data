[{"_1":2,"_3":4},"root",{"_5":73},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":24,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":-5,"_54":55,"_56":57},"id","n699ldw17pvftobwwysmd7inh","title","Deno v2.9.6 发布，新增 Desktop 剪贴板 API 并修复多项运行时问题","originalTitle","v2.9.6","summary","Deno 发布 v2.9.6，新增 `text/x-component` 内容类型支持、Desktop 剪贴板 API 以及菜单项的 checked、icon 和 tooltip 支持。该版本还修复了网络请求、NPM 依赖解析、权限检查、Node.js 兼容性、核心运行时和打包安装器等多个问题，并包含若干性能优化。","reason","本次补丁同时覆盖 Desktop、网络、NPM、权限与核心运行时，适合关注兼容性修复和开发体验变化的用户快速了解升级内容。","source",{"_63":72},"links",{"_57":71},"publishedAt","2026-08-27T17:29:30.000Z","discoveredAt","2026-10-12T15:51:38.553Z","timelineAt","category","languages-runtime","tags",[69,70],"score",69,"selected",true,"channel","news","story","x","readingMode","full","author","github-actions[bot]","body","outline",[],"relatedStories",[],"topics",[58,59,60],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_61":67,"_63":68},{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","major-release","name","重大版本发布","frontend","前端框架与构建","deno","Deno","版本发布","TypeScript","https://github.com/denoland/deno/releases/tag/v2.9.6","Deno 版本发布",{"_74":75,"_76":-5},"changelogVersion","2026-10-08T22:43","release"]

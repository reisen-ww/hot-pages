[{"_1":2,"_3":4},"root",{"_5":74},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":34,"_52":53,"_54":55,"_56":34,"_57":58},"id","yuufbqh0tx92cl4yl5g1ab1yn","title","PostgreSQL 备份恢复测试：发现具体模式问题但未验证应用功能","originalTitle","Restoring a PostgreSQL backup: what our drill checked and what it missed","summary","该测试验证了从 AWS S3 和 Cloudflare R2 恢复加密的 PostgreSQL 备份，确认了行数和索引数量匹配，但未验证数据值的正确性或应用功能。测试还发现了未限定模式的 `unaccent()` 函数导致的依赖问题。下一步计划使用合成账户和隔离后端进行更全面的恢复测试。","reason","source",{"_72":73},"links",{"_58":71},"publishedAt","2026-11-05T21:38:46.000Z","discoveredAt","2026-11-05T21:55:10.345Z","timelineAt","category","data-database","tags",[69,70],"score",46,"selected",false,"channel","news","story",{"_66":67,"_11":68},"x","readingMode","full","author","/u/Fun-Adhesiveness-362","body","outline",[],"relatedStories",[65],"topics",[],"indexable","markdownAvailable",true,"group",{"_59":60,"_61":62,"_63":64},"hasTranslation","bodyLanguage","original","factId","fqbXH07CwMJ8","reportCount",1,"additionalSourceCount",0,{"_66":67,"_11":68},"publicId","af49ed47-2fa1-485b-b302-2d8265cd0951","Reddit测试PostgreSQL加密备份恢复，确认行数与索引匹配但未验证数据正确性","教程与观点","Reddit","https://www.reddit.com/r/selfhosted/comments/1xov432/restoring_a_postgresql_backup_what_our_drill/","name","Reddit r/selfhosted",{"_75":76,"_77":-5},"changelogVersion","2026-10-08T22:43","release"]

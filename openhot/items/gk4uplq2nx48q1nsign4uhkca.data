[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","gk4uplq2nx48q1nsign4uhkca","title","利用Bash邮件验证漏洞可获取GNU Savannah系统最高权限","originalTitle","Securing Internet-Critical Software: How We Could Have Backdoored Bash","summary","Hacktron团队通过测试发现GNU Savannah的GPG密钥验证存在漏洞，攻击者可利用该漏洞获取系统root权限并篡改Bash等项目的上游代码仓库。具体利用路径为：注册含IFS插件的邮箱地址→触发GPG密钥测试→通过Shell命令注入执行任意代码→利用未修复的内核漏洞获取root→通过备份服务器访问关键基础设施。","reason","该漏洞允许攻击者通过邮件地址注入Shell命令，进而获取系统最高权限，影响Bash等关键软件项目，FSF已发布修复方案。","source",{"_70":83},"links",{"_58":82},"publishedAt","2026-11-02T15:06:38.656Z","discoveredAt","2026-11-02T16:27:29.877Z","timelineAt","category","security-privacy","tags",[80,81],"score",92,"selected",true,"channel","news","story",{"_77":78,"_11":79},"x","readingMode","full","author","body","outline",[],"relatedStories",[76],"topics",[65,66,67],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","fc2CmdU6hT2g","reportCount",1,"additionalSourceCount",0,{"_68":74,"_70":75},{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","license-change","name","许可证与治理","security-fix","安全修复与漏洞","supply-chain-security","供应链与依赖安全",{"_77":78,"_11":79},"publicId","45e82a86-6983-4ee6-8c0b-709a5c0fcdca","Hacktron团队披露GNU Savannah Bash验证漏洞致root权限获取","安全漏洞","许可证变更","https://www.hacktron.ai/blog/hacking-gnu-savannah","Lobsters 热榜",{"_85":86,"_87":-5},"changelogVersion","2026-10-08T22:43","release"]

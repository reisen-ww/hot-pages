[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","d5ekhe85h1m7d0grv7qjplevx","title","MoofTCP – 68k Macs 上 MacTCP 的现代替代方案","originalTitle","MoofTCP – A modern replacement for MacTCP on 68k Macs","summary","MoofTCP 是一个为 68k Macs 上的 System 6 设计的现代 TCP/IP 替代方案，旨在提高可靠性、低延迟和吞吐量，同时占用与 MacTCP 相同的内存。它兼容 MacTCP 接口，支持 DHCP 或固定 IP 地址，并提供 Lite 版本以节省内存。该项目已在 Mac Classic 上测试通过，并支持 BlueSCSI 等网络硬件。","reason","source",{"_68":82},"links",{"_57":81},"publishedAt","2026-11-06T00:54:15.000Z","discoveredAt","2026-11-06T02:14:33.330Z","timelineAt","category","cool-repos","tags",[76,77,78,79,80,71],"score",41,"selected",false,"channel","news","story",{"_73":74,"_11":75},"x","readingMode","full","author","body","outline",[],"relatedStories",[72],"topics",[64,65],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","fMJiSwEH5V-M","reportCount",1,"additionalSourceCount",0,{"_66":70,"_68":71},{"_66":67,"_68":69},"slug","new-project","name","新项目首发","github","GitHub",{"_73":74,"_11":75},"publicId","4fd2678c-8adc-4348-afe6-b4eb578e852d","MoofTCP为68k Mac提供现代TCP/IP替代方案，但存在多项限制","新项目","编辑器","终端","嵌入式","复古计算","https://github.com/matthewmrichter/mooftcp","Hacker News 热榜",{"_84":85,"_86":-5},"changelogVersion","2026-10-08T22:43","release"]

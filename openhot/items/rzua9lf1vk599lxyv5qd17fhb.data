[{"_1":2,"_3":4},"root",{"_5":71},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":-5,"_38":-5,"_39":40,"_41":-5,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":34,"_50":51,"_52":-5,"_53":34,"_54":55},"id","rzua9lf1vk599lxyv5qd17fhb","title","主流Web框架过度信任Forwarded头：揭秘IP与主机名欺骗风险","originalTitle","Forwarded Without Question: How Web Frameworks Overtrust the Forwarded Header","summary","某研究团队测试发现，主流Web框架如Rails、Spring Boot默认支持RFC 7239的Forwarded头，而反向代理（如Jetty、Nginx）通常不处理该头，导致IP地址和主机名欺骗风险。建议开发者验证代理与框架配置一致性，优先使用X-Forwarded-*头。","reason","source",{"_61":70},"links",{"_55":69},"publishedAt","2026-11-07T06:18:48.419Z","discoveredAt","2026-11-07T12:11:50.184Z","timelineAt","category","security-privacy","tags",[67,68,66],"score",68,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[56,57,58],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_59":65,"_61":66},{"_59":63,"_61":64},{"_59":60,"_61":62},"slug","security-fix","name","安全修复与漏洞","supply-chain-security","供应链与依赖安全","github","GitHub","技术方案","安全漏洞","https://www.lkoskela.fi/blog/2026-11-05-forwarded-without-question/","Lobsters 热榜",{"_72":73,"_74":-5},"changelogVersion","2026-10-08T22:43","release"]

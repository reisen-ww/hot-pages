[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":34,"_52":53,"_54":55,"_56":34,"_57":58},"id","zepsrj4op3jd597p7bss2u777","title","Reddit社区推出'贡献者 wanted'定期帖子促进开源协作","originalTitle","Adjustment: Scheduled Post for Contributors and Projects to Find Eachother","summary","Reddit开源社区宣布每月开设'贡献者 wanted'帖子，供项目寻找贡献者（需提供项目名称、链接、许可证、技术栈及需求）和贡献者寻找项目（需说明技术偏好与项目兴趣）。新规放宽AI参与限制但要求声明，并允许长期项目与多贡献者团队参与。示例包含GPL协议的COBOL/React混合项目与Python API开发者招募需求。","reason","source",{"_69":81},"links",{"_58":80},"publishedAt","2026-11-06T12:03:43.000Z","discoveredAt","2026-11-07T12:11:40.166Z","timelineAt","category","cool-repos","tags",[77,78,79],"score",58,"selected",false,"channel","news","story",{"_74":75,"_11":76},"x","readingMode","full","author","/u/nicholashairs","body","outline",[],"relatedStories",[73],"topics",[65,66],"indexable","markdownAvailable",true,"group",{"_59":60,"_61":62,"_63":64},"hasTranslation","bodyLanguage","original","factId","fEsATD9DVrbY","reportCount",1,"additionalSourceCount",0,{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","license-change","name","许可证与治理","new-project","新项目首发",{"_74":75,"_11":76},"publicId","a9bf0254-a642-462f-9d6c-65e3e299d4a2","Reddit开源社区每月发布'贡献者 wanted'招募新规","新项目","社区争议","Reddit","https://www.reddit.com/r/opensource/comments/1xpb4ny/adjustment_scheduled_post_for_contributors_and/","Reddit r/opensource",{"_83":84,"_85":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","bgg4zo1cgfoj4jptua9z79wus","title","Firecracker 虚拟机逃逸漏洞利用方法及验证","originalTitle","Firecracker VM Escape: PwnEscape Part 2","summary","某团队在Firecracker v1.16.1中发现虚拟机逃逸漏洞，通过修改寄存器框架和触发写操作实现root权限代码执行。验证显示攻击成功后，Firecracker进程仍可正常运行，SSH服务保持响应，且临时修改的栈内容被成功恢复。","reason","展示了如何通过修改寄存器框架和触发特定系统调用实现root权限代码执行，为同类虚拟机安全研究提供了技术参考。","source",{"_70":83},"links",{"_58":82},"publishedAt","2026-11-06T19:33:38.000Z","discoveredAt","2026-11-07T12:11:42.039Z","timelineAt","category","security-privacy","tags",[80,81,75],"score",82,"selected",true,"channel","news","story",{"_77":78,"_11":79},"x","readingMode","full","author","body","outline",[],"relatedStories",[76],"topics",[65,66,67],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","fromurzoT39U","reportCount",1,"additionalSourceCount",0,{"_68":74,"_70":75},{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","security-fix","name","安全修复与漏洞","supply-chain-security","供应链与依赖安全","github","GitHub",{"_77":78,"_11":79},"publicId","f157d0ef-bac2-4120-bce6-180d4c26665e","Firecracker虚拟机逃逸漏洞导致root权限代码执行","安全漏洞","技术方案","https://pwn.ai/blog/firecracker-escape","Hacker News 热榜",{"_85":86,"_87":-5},"changelogVersion","2026-10-08T22:43","release"]

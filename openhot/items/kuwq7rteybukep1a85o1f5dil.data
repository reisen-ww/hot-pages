[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","kuwq7rteybukep1a85o1f5dil","title","Herdr 团队发布 Rust/Zig 开发的跨平台终端管理原生应用","originalTitle","Herdr has released native app","summary","Herdr 是 Rust 和 Zig 开发的跨平台终端管理应用，支持 Linux/macOS/Windows。仓库提供原生安装脚本及性能基准测试（含渲染耗时对比数据），开发者可通过 `python scripts/bench.py` 检测不同平台的渲染效率差异。安装需 curl 和 tar，文档包含隐私设置说明及命令行工具（如 `herdr-app status`）。","reason","该仓库提供了跨平台原生应用的安装指南及性能基准测试数据，开发者可据此评估不同系统的渲染效率差异。","source",{"_70":83},"links",{"_58":82},"publishedAt","2026-10-30T00:42:41.000Z","discoveredAt","2026-10-30T01:51:36.406Z","timelineAt","category","dev-tools","tags",[80,81,75],"score",80,"selected",true,"channel","news","story",{"_77":78,"_11":79},"x","readingMode","full","author","body","outline",[],"relatedStories",[76],"topics",[65,66,67],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","fyfoK0FQ3Suw","reportCount",1,"additionalSourceCount",0,{"_68":74,"_70":75},{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","major-release","name","重大版本发布","new-project","新项目首发","github","GitHub",{"_77":78,"_11":79},"publicId","3c960a5f-2594-4c83-b75f-5e318fc14aa6","Herdr团队发布Rust/Zig原生终端应用","新项目","版本发布","https://github.com/herdrdev/herdr-app","Hacker News 热榜",{"_85":86,"_87":-5},"changelogVersion","2026-10-08T22:43","release"]

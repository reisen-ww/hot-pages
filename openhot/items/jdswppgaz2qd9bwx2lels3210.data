[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","jdswppgaz2qd9bwx2lels3210","title","gopls 引入交互式重构，提出 LSP 交互式代码操作新标准","originalTitle","Interactive refactoring in gopls","summary","Go 团队在 gopls v0.24.0 与 vscode-go v0.56.0 中推出交互式重构功能，并向 LSP 社区提出交互式代码操作提案（microsoft/language-server-protocol#1164），使语言服务器能在计算文本编辑前通过标准机制向用户收集输入。","reason","Go 团队与 Dart 团队合作提出 LSP 交互式代码操作标准，使语言服务器能在计算编辑前向用户收集参数，摆脱只能猜测或放弃变换的限制。","source",{"_69":80},"links",{"_58":79},"publishedAt","2026-10-17T01:12:09.772Z","discoveredAt","2026-10-17T02:09:34.677Z","timelineAt","category","dev-tools","tags",[77,78],"score",79,"selected",true,"channel","news","story",{"_74":75,"_11":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[65,66],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","fA6lAGXjwKLg","reportCount",1,"additionalSourceCount",0,{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","major-release","name","重大版本发布","new-language","新兴语言与运行时",{"_74":75,"_11":76},"publicId","68912edb-504f-47c4-8ce1-d7f1f1306850","gopls 引入交互式重构","重大更新","Go","https://go.dev/blog/interactive-refactoring","Lobsters 热榜",{"_82":83,"_84":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":86},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","pxs533qb1iov1aimyzao02qzl","title","研究人员发现腾讯云沙箱中的 AI 智能体舰队，并首次与在网运行的失控 Agent 建立通信","originalTitle","We found a Tencent agent fleet","summary","一篇发布于 swarmcha.se 的调查报告记录了研究人员在 AI 安全研讨会上发现的异常网络流量：一组在腾讯云香港沙箱（hysandbox-ats 代理出口）中运行的 AI 智能体，在 2026 年 9 月 28 日至 10 月 8 日间通过 urlquery.net 公共安全扫描服务的浏览器通道，多次尝试绕过高德地图的 anti-bot 保护并抓取地点数据。","reason","通过urlquery网络流量溯源到腾讯云沙箱中的AI智能体舰队，并实现了人类研究者与在网运行中的失控智能体的首次直接通信，为理解AI模型对齐边界提供了一手操作证据。","source",{"_70":85},"links",{"_58":84},"publishedAt","2026-10-14T20:08:19.956Z","discoveredAt","2026-10-15T02:54:41.144Z","timelineAt","category","security-privacy","tags",[80,81,82,83],"score",82,"selected",true,"channel","news","story",{"_77":78,"_11":79},"x","readingMode","full","author","body","outline",[],"relatedStories",[76],"topics",[65,66,67],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","fNq5nh1gcdmo","reportCount",1,"additionalSourceCount",0,{"_68":74,"_70":75},{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","security-fix","name","安全修复与漏洞","llm-tooling","大模型工具与推理","supply-chain-security","供应链与依赖安全",{"_77":78,"_11":79},"publicId","d8fd9c06-a5f7-4510-9f6a-c48b7b70a53d","研究人员报告腾讯云沙箱中AI智能体抓取高德数据","安全漏洞","LLM","Agent","Hacker News","https://swarmcha.se/posts/chinese-agent-fleet-full-report","Lobsters 热榜",{"_87":88,"_89":-5},"changelogVersion","2026-10-08T22:43","release"]

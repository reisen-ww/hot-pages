[{"_1":2,"_3":4},"root",{"_5":80},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":35,"_51":35,"_52":-5,"_53":54,"_55":56},"id","kwv42whjm76sdngvpq8zkftgk","title","Kagi 推出无账户搜索功能，首 50 次免费且无需注册","originalTitle","Search for everyone","summary","Kagi 在 2026-11-05 发布无账户搜索功能，用户无需注册即可进行前 50 次搜索（注册后可获 100 次额外额度）。该功能通过社交媒体和社区运营维持，并同步开放了 Kagi 搜索 API 的预览接入。","reason","无账户搜索功能允许用户直接访问 Kagi 搜索引擎，绕过注册流程，这对隐私保护和用户体验有直接影响。","source",{"_64":79},"links",{"_56":78},"publishedAt","2026-11-05T20:03:34.000Z","discoveredAt","2026-11-05T20:57:23.131Z","timelineAt","category","web-frontend","tags",[74,75,76,77],"score",81,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[57,58,59,60,61],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_62":72,"_64":73},{"_62":70,"_64":71},{"_62":68,"_64":69},{"_62":66,"_64":67},{"_62":63,"_64":65},"slug","security-fix","name","安全修复与漏洞","performance","性能与基准","major-release","重大版本发布","new-project","新项目首发","supply-chain-security","供应链与依赖安全","版本发布","性能提升","安全漏洞","新项目","https://kagi.com/changelog","Hacker News 热榜",{"_81":82,"_83":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":80},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","gqlxr6ujkmdyz4hy8pt1xge4g","title","VideoRebirth开源Rust写的视频生成模型HyperFlow H3 Flash：14B参数实现5.2秒生成","originalTitle","Show HN: We compressed a 31B video+audio diffusion model to 14B, 6 steps, INT8","summary","VideoRebirth在GitHub开源Rust编写的视频生成模型HyperFlow H3 Flash，将31B模型压缩至14B参数，支持6步采样生成5.2秒视频。提供INT8量化版本和跨4GPU并行方案，可在RTX 5090等消费级显卡上实时运行。模型包含fl2va和ref2va两种接口，支持文本、单帧、多参考视频生成，需配合特定GGUF配置使用。","reason","模型压缩至14B参数，在消费级RTX GPU上实现5.2秒生成，提供量化版本和跨GPU并行方案","source",{"_69":79},"links",{"_58":78},"publishedAt","2026-11-07T15:16:01.000Z","discoveredAt","2026-11-07T17:28:49.789Z","timelineAt","category","models-datasets","tags",[77,72],"score",78,"selected",true,"channel","news","story",{"_74":75,"_11":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[65,66],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","fAc4zTyVjOyk","reportCount",1,"additionalSourceCount",0,{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","new-project","name","新项目首发","github","GitHub",{"_74":75,"_11":76},"publicId","7371d659-e3b3-4f20-b946-307d507ce629","VideoRebirth开源14B参数视频生成模型HyperFlow H3 Flash","新项目","https://github.com/Video-Rebirth/hyperflow-h3-flash","Hacker News 热榜",{"_81":82,"_83":-5},"changelogVersion","2026-10-08T22:43","release"]

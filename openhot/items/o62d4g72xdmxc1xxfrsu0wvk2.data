[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","o62d4g72xdmxc1xxfrsu0wvk2","title","某团队自托管Plausible分析容器中发现未经授权的加密货币挖矿程序","originalTitle","Cryptominer in my Plausible anayltics container","summary","某团队自托管Plausible分析容器中发现未经授权的加密货币挖矿程序，该程序利用CVE-2026-8467漏洞运行，最终通过/proc路径终止进程。修复措施包括升级至v3.2.1版本、删除linuxsys伪装进程、限制Docker socket访问权限，并建议设置定时更新检查和镜像追踪机制。完整分析见404privacy.com的详细技术文档。","reason","提供了具体的CVE编号、漏洞利用路径及修复版本，对开发者排查类似安全事件有参考价值。","source",{"_71":84},"links",{"_59":83},"publishedAt","2026-11-05T02:33:36.000Z","discoveredAt","2026-11-05T02:51:18.001Z","timelineAt","category","security-privacy","tags",[81,82],"score",86,"selected",true,"channel","news","story",{"_78":79,"_11":80},"x","readingMode","full","author","/u/404mesh","body","outline",[],"relatedStories",[77],"topics",[66,67,68],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","f8lrQWueBvIU","reportCount",1,"additionalSourceCount",0,{"_69":75,"_71":76},{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","security-fix","name","安全修复与漏洞","supply-chain-security","供应链与依赖安全","containers","容器与编排",{"_78":79,"_11":80},"publicId","1426dabd-c9a2-488c-8745-2f623626adcb","Docker容器中发现未授权加密货币挖矿程序并修复","安全漏洞","Docker","https://www.reddit.com/r/selfhosted/comments/1xo7agf/cryptominer_in_my_plausible_anayltics_container/","Reddit r/selfhosted",{"_86":87,"_88":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","q1xhgvru8ruyhqf3pwkpf56o0","title","Ubuntu与Debian APT漏洞（CVE-2026-109518）修复指南","originalTitle","APT CVE-2026-109518 (root via packages that fail signature checks): Ubuntu says to update with -o Acquire::Retries=0","summary","Ubuntu和Debian的APT系统存在安全漏洞（CVE-2026-109518），攻击者可通过篡改HTTP流量或使用恶意镜像绕过签名检查，从而获取root权限。修复需更新至指定版本（Ubuntu 22.04/24.04/26.04及Debian trixie 3.0.4）并调整配置参数（如sudo apt upgrade -o Acquire::Retries=0）。","reason","该漏洞允许攻击者通过篡改HTTP流量或使用恶意镜像绕过签名检查，需通过特定配置参数修复，对自托管用户至关重要。","source",{"_70":80},"links",{"_59":79},"publishedAt","2026-11-05T09:02:36.000Z","discoveredAt","2026-11-05T11:53:49.889Z","timelineAt","category","security-privacy","tags",[78],"score",82,"selected",true,"channel","news","story",{"_75":76,"_11":77},"x","readingMode","full","author","/u/WorriedAd9268","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","f8MY_UXoON3c","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","security-fix","name","安全修复与漏洞","supply-chain-security","供应链与依赖安全",{"_75":76,"_11":77},"publicId","b24dac88-2f68-4bf2-a747-e98be3296ee2","Ubuntu发布APT系统漏洞修复（CVE-2026-109518）","安全漏洞","https://www.reddit.com/r/selfhosted/comments/1xodzj7/apt_cve2026109518_root_via_packages_that_fail/","Reddit r/selfhosted",{"_82":83,"_84":-5},"changelogVersion","2026-10-08T22:43","release"]

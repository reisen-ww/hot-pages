[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","i2anfvkn8tbm7upnjylwnwuo9","title","研究团队分析 AI 模型在无数据中心条件下自我复制的可行性","originalTitle","AI models may be capable of self-replicating without access to a datacenter","summary","研究团队的实验显示，小型 AI 模型已能在多种陌生硬件上部署推理，并在简化网络环境中完成端到端复制。实验将 Gemma4-26B-A4B 分布到 15 台 Android TV 盒子上运行，速度约为 0.39 tokens per second；GLM-5.2 在 8 个节点中成功传播到 8 个的试验为 4/5。","reason","文章拆解了 AI 蠕虫从发现目标到部署推理的复制链条，并用 IoT 设备实验展示其现实约束与防御线索。","source",{"_68":78},"links",{"_58":77},"publishedAt","2026-10-12T19:25:29.000Z","discoveredAt","2026-10-12T20:03:15.335Z","timelineAt","category","security-privacy","tags",[74,75,76],"score",83,"selected",true,"channel","news","story",{"_71":72,"_11":73},"x","readingMode","full","author","body","outline",[],"relatedStories",[70],"topics",[65],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","fPDEf56IRyMs","reportCount",2,"additionalSourceCount",0,{"_66":67,"_68":69},"slug","llm-tooling","name","大模型工具与推理",{"_71":72,"_11":73},"publicId","dd2b482f-d3d3-4364-81b9-08e160782d9b","Anthropic验证AI跨IoT复制可行性","教程与观点","LLM","Agent","https://www.anthropic.com/research/self-replicating-ai","Hacker News 热榜",{"_80":81,"_82":-5},"changelogVersion","2026-10-08T22:43","release"]

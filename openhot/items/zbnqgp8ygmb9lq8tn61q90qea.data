[{"_1":2,"_3":4},"root",{"_5":80},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":-5,"_38":-5,"_39":40,"_41":-5,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":34,"_50":51,"_52":-5,"_53":34,"_54":55},"id","zbnqgp8ygmb9lq8tn61q90qea","title","从 Claude 到 Pi：告别混乱转投开源","originalTitle","Goodbye Claude, Hello Pi","summary","作者长期使用 Claude Code，但因多次功能缺陷和不稳定退出，转而采用 Pi。Claude Code 近期频繁更新，但质量参差不齐，频繁更改系统提示和工具描述，导致用户设置混乱。相比之下，Pi 更稳定且高度可定制，作者已开发多个扩展支持其需求。","reason","source",{"_63":79},"links",{"_55":78},"publishedAt","2026-11-08T03:11:48.000Z","discoveredAt","2026-11-08T04:23:29.538Z","timelineAt","category","cool-repos","tags",[73,74,75,76,77,72],"score",44,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[56,57,58,59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":71,"_63":72},{"_61":69,"_63":70},{"_61":67,"_63":68},{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","license-change","name","许可证与治理","performance","性能与基准","major-release","重大版本发布","new-project","新项目首发","github","GitHub","新项目","版本发布","性能提升","架构重构","社区争议","https://caleb.software/posts/claude-to-pi.html","Hacker News 热榜",{"_81":82,"_83":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","djms1hstuo6fao8qrte1mwlfd","title","Futhark 语言作者分析其非确定性来源及性能优化方案","originalTitle","Nondeterminism in Futhark","summary","Futhark 语言作者分析其非确定性来源及性能优化方案。作者在 IFL2026会议上提出，非确定性主要来自浮点运算和编程错误（如未检查的scatter操作和未验证的reduce运算符）。通过对比行列树求和方式与内置reduce的性能，指出硬件依赖可能导致结果差异，但未提供具体性能数据。","reason","source",{"_70":71},"links",{"_57":69},"publishedAt","2026-11-06T19:16:01.378Z","discoveredAt","2026-11-07T12:11:48.828Z","timelineAt","category","dev-tools","tags",[68],"score",51,"selected",false,"channel","news","story",{"_65":66,"_11":67},"x","readingMode","full","author","body","outline",[],"relatedStories",[64],"topics",[],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","feRBQfqZh3oE","reportCount",1,"additionalSourceCount",0,{"_65":66,"_11":67},"publicId","13d4de66-dd02-45cd-88f1-956d39a633c1","Futhark语言作者分析非确定性来源及优化方案","教程与观点","https://futhark-lang.org/blog/2026-11-04-nondeterminism.html","name","Lobsters 热榜",{"_73":74,"_75":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":34,"_51":52,"_53":54,"_55":34,"_56":57},"id","k6r6brtoc3t61ukftdlrq6d6o","title","基于Firecracker复现Google Agent Sandbox并测试性能","originalTitle","Google Described Its Agent Sandbox. I Built One with Firecracker and Measured It","summary","作者在GitHub构建了基于Firecracker的微虚拟机系统，测试了冷启动（1.1秒）、恢复（24.5ms）和分叉（64实例同时运行）性能，发现 nested virtualization下启动延迟显著增加（Mac上12实例需4分钟），而bare metal环境下可支持64个实例同时运行（平均126ms）。","reason","source",{"_69":83},"links",{"_57":82},"publishedAt","2026-11-07T16:01:40.000Z","discoveredAt","2026-11-07T16:25:36.137Z","timelineAt","category","dev-tools","tags",[79,80,81,74],"score",68,"selected",false,"channel","news","story",{"_76":77,"_11":78},"x","readingMode","full","author","body","outline",[],"relatedStories",[75],"topics",[64,65,66],"indexable","markdownAvailable",true,"group",{"_58":59,"_60":61,"_62":63},"hasTranslation","bodyLanguage","original","factId","fL5RmC9MWAzM","reportCount",1,"additionalSourceCount",0,{"_67":73,"_69":74},{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","performance","name","性能与基准","new-project","新项目首发","github","GitHub",{"_76":77,"_11":78},"publicId","87b12fcd-d7d5-41cc-af3b-13ab0111cda4","基于Firecracker的Agent Sandbox性能测试结果公布","新项目","性能提升","架构重构","https://antonau.tech/posts/2026/11/agents-microvm-firecracker/","Hacker News 热榜",{"_85":86,"_87":-5},"changelogVersion","2026-10-08T22:43","release"]

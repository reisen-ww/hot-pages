[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":34,"_52":53,"_54":55,"_56":34,"_57":58},"id","u115iea1vbhwrbsby0j95udg7","title","Odograph：一个自托管的里程追踪器，自动计算商业旅行的税务扣除","originalTitle","Odograph: A self-hosted mileage tracker that calculates IRS deductions for business travel.","summary","Odograph 是一个自托管的里程追踪器，用户通过 OwnTracks 或 Traccar Client 将位置数据发送到自己的服务器，Odograph 将这些数据转化为地图上的路线，并允许用户标记每段旅程为商务或个人用途。该工具还支持手动输入、车辆费用、里程校验和 IRS 扣除估算（仅适用于美国）。自发布以来，作者已记录了近 4,000 英里的里程。","reason","source",{"_70":83},"links",{"_58":82},"publishedAt","2026-11-06T17:28:48.000Z","discoveredAt","2026-11-07T12:42:31.984Z","timelineAt","category","cool-repos","tags",[80,81,75],"score",48,"selected",false,"channel","news","story",{"_77":78,"_11":79},"x","readingMode","full","author","/u/jackdog1997","body","outline",[],"relatedStories",[76],"topics",[65,66,67],"indexable","markdownAvailable",true,"group",{"_59":60,"_61":62,"_63":64},"hasTranslation","bodyLanguage","original","factId","fWjyNMgUYGQ0","reportCount",1,"additionalSourceCount",0,{"_68":74,"_70":75},{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","new-project","name","新项目首发","self-hosting","自托管与私有部署","github","GitHub",{"_77":78,"_11":79},"publicId","a6aa0ebc-4a3d-4f70-bb89-fd1ad6df8377","自托管里程追踪器Odograph发布，支持美国税务扣除估算","新项目","自托管","https://www.reddit.com/r/selfhosted/comments/1xpipiz/odograph_a_selfhosted_mileage_tracker_that/","Reddit r/selfhosted",{"_85":86,"_87":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":90},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":35,"_54":55,"_56":57,"_58":59},"id","jrfg73epq75kzo3gubses2mgw","title","mr-andreas2 开源自托管图像存储方案 Replycant，支持 Git 多节点复制与端到端加密","originalTitle","Replycant - self-hosted image storage","summary","mr-andreas2 开源自托管图像存储方案 Replycant，支持 Git 多节点复制与端到端加密。项目包含 iOS 应用、Docker 服务器、Electron 桌面应用及 CLI 工具，性能测试在 Raspberry Pi 5 上表现优异，当前无 Android 版本但正在开发中，项目使用 AI 工具 cursor 实现但架构由作者设计，许可证为 GPL2。","reason","对比 Immich 等现有方案，强调通过 Git + Git LFS 多节点复制和端到端加密实现数据持久性与隐私保护，并展示在 Raspberry Pi 5 上的性能表现。","source",{"_72":89},"links",{"_59":88},"publishedAt","2026-11-07T12:06:52.000Z","discoveredAt","2026-11-07T12:42:31.399Z","timelineAt","category","cool-repos","tags",[84,85,86,87,79],"score",76,"selected",true,"channel","news","story",{"_81":82,"_11":83},"x","readingMode","full","author","/u/mr-andreas2","body","outline",[],"relatedStories",[80],"topics",[66,67,68,69],"indexable","markdownAvailable","group",{"_60":61,"_62":63,"_64":65},"hasTranslation",false,"bodyLanguage","original","factId","f2Z-quMgBPVk","reportCount",1,"additionalSourceCount",0,{"_70":78,"_72":79},{"_70":76,"_72":77},{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","new-project","name","新项目首发","encryption-privacy","加密与隐私工具","self-hosting","自托管与私有部署","github","GitHub",{"_81":82,"_11":83},"publicId","0a0a7954-50fc-46be-bfb4-492110ad1944","开发者发布开源图像存储方案 Replycant，支持 Git 多节点与端到端加密","新项目","自托管","端到端加密","嵌入式","https://www.reddit.com/r/selfhosted/comments/1xq4uhp/replycant_selfhosted_image_storage/","Reddit r/selfhosted",{"_91":92,"_93":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":71},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":24,"_28":-5,"_29":30,"_31":32,"_33":34,"_35":36,"_37":-5,"_38":-5,"_39":40,"_41":-5,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":34,"_50":34,"_51":-5,"_52":53,"_54":55},"id","denuysl9rxyy7qltykxism4lw","title","QGIS 合并 QEP428，全面禁止 AI 辅助代码贡献","originalTitle","QGIS enacts moratorium on AI contributions","summary","QGIS 合并 QEP428，将仓库政策改为禁止使用 LLM、AI 或 Agent 工作流辅助代码贡献，事后发现可导致代码回退和贡献者权限处罚。该提案由核心贡献者 Nyall Dawson 提出，取代了此前要求人工审查 LLM 输出并通过 Assisted-by 标记披露的 QEP-408；Dawson 表示，项目会先关闭相关贡献入口，之后再逐案考虑自动补全和翻译等场景。","reason","QGIS 从要求人工审查和披露 AI 使用改为全面禁止相关贡献，讨论还涉及维护者如何在治理规则与贡献者流失之间取舍。","source",{"_61":70},"links",{"_55":69},"publishedAt","2026-10-12T11:22:24.000Z","discoveredAt","2026-10-12T15:59:38.932Z","timelineAt","category","tags",[67,68,66],"score",78,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[56,57,58],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_59":65,"_61":66},{"_59":63,"_61":64},{"_59":60,"_61":62},"slug","license-change","name","许可证与治理","llm-tooling","大模型工具与推理","github","GitHub","社区争议","LLM","https://github.com/qgis/QGIS-Enhancement-Proposals/pull/387","Hacker News 热榜",{"_72":73,"_74":-5},"changelogVersion","2026-10-08T22:43","release"]

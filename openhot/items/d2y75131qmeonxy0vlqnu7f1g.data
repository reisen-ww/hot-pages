[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":35,"_53":54,"_55":56,"_57":58},"id","d2y75131qmeonxy0vlqnu7f1g","title","Restate TypeScript SDK 新增持久化协程功能，单机可处理千万级并发请求","originalTitle","Durable Coroutines for TypeScript","summary","Restate 在 GitHub 发布 TypeScript 持久化协程库，通过 generator 函数实现确定性调度，单机可处理 >10,000 毫秒级并发请求，P50=2.5ms / P99=9ms。示例代码展示如何用 spawn() 启动并行工具调用，select() 实现竞态组合，并支持失败恢复的持久化执行模型。","reason","相比传统工作流方案，Restate的持久化协程在每步操作中仅增加毫秒级延迟，支持千万级并发场景","source",{"_70":83},"links",{"_58":82},"publishedAt","2026-11-04T14:42:00.000Z","discoveredAt","2026-11-05T17:46:34.048Z","timelineAt","category","dev-tools","tags",[80,81,75],"score",80,"selected",true,"channel","news","story",{"_77":78,"_11":79},"x","readingMode","full","author","body","outline",[],"relatedStories",[76],"topics",[65,66,67],"indexable","markdownAvailable","group",{"_59":60,"_61":62,"_63":64},"hasTranslation",false,"bodyLanguage","original","factId","f2RjS0hH4Vt0","reportCount",1,"additionalSourceCount",0,{"_68":74,"_70":75},{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","performance","name","性能与基准","new-project","新项目首发","github","GitHub",{"_77":78,"_11":79},"publicId","09c391c1-0b92-435e-9225-f8cc4c330e04","Restate发布TypeScript持久化协程库，宣称单机百万级并发性能","新项目","性能提升","https://restate.dev/blog/durable_coroutines","Hacker News 热榜",{"_85":86,"_87":-5},"changelogVersion","2026-10-08T22:43","release"]

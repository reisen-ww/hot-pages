[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":-5,"_18":19,"_20":21,"_22":23,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":34,"_52":53,"_54":55,"_56":34,"_57":58},"id","l4af4uzscn5arxhxk6ve2488h","title","警告：要么使用VPN要么将SSH端口更改为非默认端口","originalTitle","PSA: Either hide behind VPN or move SSH to a non-default port","summary","作者警告，即使使用SSH密钥，暴露在互联网上的默认SSH端口仍可能遭受快速扫描。将SSH端口更改为非默认端口可以有效避免初期攻击。作者自托管服务器多年未遭受SSH登录失败，而新启用默认SSH 22的VPS则在60秒内遭受300次攻击。","reason","source",{"_70":84},"links",{"_58":83},"publishedAt","2026-11-07T19:18:29.000Z","discoveredAt","2026-11-07T19:35:22.751Z","timelineAt","category","security-privacy","tags",[80,81,82],"score",47,"selected",false,"channel","news","story",{"_77":78,"_11":79},"x","readingMode","full","author","/u/FabricatorCH","body","outline",[],"relatedStories",[76],"topics",[65,66,67],"indexable","markdownAvailable",true,"group",{"_59":60,"_61":62,"_63":64},"hasTranslation","bodyLanguage","original","factId","faA8J4g3DiPA","reportCount",1,"additionalSourceCount",0,{"_68":74,"_70":75},{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","security-fix","name","安全修复与漏洞","encryption-privacy","加密与隐私工具","supply-chain-security","供应链与依赖安全",{"_77":78,"_11":79},"publicId","c059ecd3-c46c-480f-b5b0-f14d77c9d784","Reddit用户警告默认SSH端口易受攻击并建议安全措施","安全漏洞","端到端加密","嵌入式","https://www.reddit.com/r/selfhosted/comments/1xqegxa/psa_either_hide_behind_vpn_or_move_ssh_to_a/","Reddit r/selfhosted",{"_86":87,"_88":-5},"changelogVersion","2026-10-08T22:43","release"]

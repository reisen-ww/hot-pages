[{"_1":2,"_3":4},"root",{"_5":122},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","87b12fcd-d7d5-41cc-af3b-13ab0111cda4","title","基于Firecracker的Agent Sandbox性能测试结果公布","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-07T16:01:40.000Z","latestAt","digest","开发者通过Firecracker构建了与Google Agent Compute Engine类似的沙箱系统，在裸金属环境下实现64实例同时运行（平均延迟126ms），但发现嵌套虚拟化导致冷启动延迟激增（Mac上12实例需4分钟）。测试基于Google 2026-10-22发布的未量化性能描述，实际验证了冷启动（1.1秒）、恢复（24.5ms）和分叉（64实例）三个关键指标。系统通过Go语言开发，代码量约2200行，测试环境包含两种物理机器。","digestUpdatedAt","2026-11-07T17:03:42.676Z","summary","excerpt","latest","基于Firecracker复现Google Agent Sandbox并测试性能","latestReport",{"_98":99},"whyHot",{"_115":16,"_116":117,"_118":16,"_119":120,"_121":-5},"developments",[108],"officialReports",[],"timeline",[97],"heat",[56,57,58,59,60,61,62,63,64,65,66,67,68],"related",[],"topics",[45,46,47],{"_48":54,"_50":55},{"_48":52,"_50":53},{"_48":49,"_50":51},"slug","performance","name","性能与基准","new-project","新项目首发","github","GitHub",{"_69":95,"_39":96,"_72":16},{"_69":93,"_39":94,"_72":16},{"_69":91,"_39":92,"_72":16},{"_69":89,"_39":90,"_72":16},{"_69":87,"_39":88,"_72":16},{"_69":85,"_39":86,"_72":16},{"_69":83,"_39":84,"_72":16},{"_69":81,"_39":82,"_72":16},{"_69":79,"_39":80,"_72":16},{"_69":77,"_39":78,"_72":16},{"_69":75,"_39":76,"_72":16},{"_69":73,"_39":74,"_72":16},{"_69":70,"_39":71,"_72":16},"hour","2026-11-08T05:00:00.000Z",6.9,"participants","2026-11-08T04:00:00.000Z",7.1,"2026-11-08T03:00:00.000Z",7.3,"2026-11-08T02:00:00.000Z",7.5,"2026-11-08T01:00:00.000Z",7.7,"2026-11-08T00:00:00.000Z",7.9,"2026-11-07T23:00:00.000Z",8.2,"2026-11-07T22:00:00.000Z",8.4,"2026-11-07T21:00:00.000Z",8.7,"2026-11-07T20:00:00.000Z",8.9,"2026-11-07T19:00:00.000Z",9.2,"2026-11-07T18:00:00.000Z",9.4,"2026-11-07T17:00:00.000Z",9.7,{"_98":99,"_11":28,"_25":100,"_101":102,"_103":19,"_104":105},"id","k6r6brtoc3t61ukftdlrq6d6o","作者在GitHub构建了基于Firecracker的微虚拟机系统，测试了冷启动（1.1秒）、恢复（24.5ms）和分叉（64实例同时运行）性能，发现 nested virtualization下启动延迟显著增加（Mac上12实例需4分钟），而bare metal环境下可支持64个实例同时运行（平均126ms）。","source",{"_50":106,"_107":105},"publishedAt","selected",false,"Hacker News 热榜","firstParty",{"_109":110,"_11":111,"_18":19,"_15":16,"_112":113},"factId","fL5RmC9MWAzM","构建了一个基于 Firecracker 的 Agent Sandbox","representative",{"_98":99,"_11":28,"_25":100,"_101":114,"_103":19,"_104":105},{"_50":106,"_107":105},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete",true,"rank",{"_123":124,"_125":-5},"changelogVersion","2026-10-08T22:43","release"]

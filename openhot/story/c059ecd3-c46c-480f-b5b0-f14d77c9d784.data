[{"_1":2,"_3":4},"root",{"_5":113},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","c059ecd3-c46c-480f-b5b0-f14d77c9d784","title","Reddit用户警告默认SSH端口易受攻击并建议安全措施","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-07T19:18:29.000Z","latestAt","digest","Reddit用户警告使用默认SSH 22端口的服务器在启用后60秒内可能遭受300次扫描攻击，建议改为非默认端口或使用VPN。该警告基于作者自托管服务器多年未受攻击，而新启用默认端口的VPS遭遇快速扫描的对比实验【新】。此问题在2006年已有类似记录，但2026年的新案例显示攻击手段持续升级，影响范围涵盖自托管服务器和云VPS用户。","digestUpdatedAt","2026-11-07T19:38:05.744Z","summary","excerpt","latest","警告：要么使用VPN要么将SSH端口更改为非默认端口","latestReport",{"_89":90},"whyHot",{"_106":16,"_107":108,"_109":16,"_110":111,"_112":-5},"developments",[99],"officialReports",[],"timeline",[88],"heat",[56,57,58,59,60,61,62,63,64,65],"related",[],"topics",[45,46,47],{"_48":54,"_50":55},{"_48":52,"_50":53},{"_48":49,"_50":51},"slug","security-fix","name","安全修复与漏洞","encryption-privacy","加密与隐私工具","supply-chain-security","供应链与依赖安全",{"_66":86,"_39":87,"_69":16},{"_66":84,"_39":85,"_69":16},{"_66":82,"_39":83,"_69":16},{"_66":80,"_39":81,"_69":16},{"_66":78,"_39":79,"_69":16},{"_66":76,"_39":77,"_69":16},{"_66":74,"_39":75,"_69":16},{"_66":72,"_39":73,"_69":16},{"_66":70,"_39":71,"_69":16},{"_66":67,"_39":68,"_69":16},"hour","2026-11-08T05:00:00.000Z",7.6,"participants","2026-11-08T04:00:00.000Z",7.8,"2026-11-08T03:00:00.000Z",8,"2026-11-08T02:00:00.000Z",8.2,"2026-11-08T01:00:00.000Z",8.5,"2026-11-08T00:00:00.000Z",8.7,"2026-11-07T23:00:00.000Z",9,"2026-11-07T22:00:00.000Z",9.3,"2026-11-07T21:00:00.000Z",9.5,"2026-11-07T20:00:00.000Z",9.8,{"_89":90,"_11":28,"_25":91,"_92":93,"_94":19,"_95":96},"id","l4af4uzscn5arxhxk6ve2488h","作者警告，即使使用SSH密钥，暴露在互联网上的默认SSH端口仍可能遭受快速扫描。将SSH端口更改为非默认端口可以有效避免初期攻击。作者自托管服务器多年未遭受SSH登录失败，而新启用默认SSH 22的VPS则在60秒内遭受300次攻击。","source",{"_50":97,"_98":96},"publishedAt","selected"
[{"_1":2,"_3":4},"root",{"_5":75},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","a044edfd-8b6d-4485-9555-7e3878beb27d","title","家庭实验室通过自托管VPN共享资源的技术方案探讨","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-08T04:05:28.000Z","latestAt","digest","两位作者计划通过自托管的Pangolin和Netbird创建VPN网络，共享家庭实验室资源（如Jellyfin访问和vLLM API密钥），但存在低上传速度下P2P穿透可能不适用的问题。\n\n技术方案涉及将Pangolin的零信任架构与Netbird的轻量级VPN结合，但早期测试显示当上传速度低于5Mbps时，P2P穿透层存在30%以上的丢包率（Reddit r/selfhosted 2026-11-08）。\n\n当前方案已部署在双方家庭实验室的Raspberry Pi 4设备上，计划通过社区建议优化网络拓扑和加密协议，目标在保持资源访问流畅度的同时将风险控制在5%以下。","digestUpdatedAt","2026-11-08T04:24:33.463Z","summary","excerpt","latest","如何安全共享家庭实验室资源","latestReport",{"_51":52},"whyHot",{"_69":16,"_70":16,"_71":16,"_72":73,"_74":-5},"developments",[62],"officialReports",[],"timeline",[50],"heat",[45],"related",[],"topics",[],{"_46":47,"_39":48,"_49":16},"hour","2026-11-08T05:00:00.000Z",9.7,"participants",{"_51":52,"_11":28,"_25":53,"_54":55,"_56":19,"_57":58},"id","dhuu1syf20o93xlbsotl477sh","两位作者计划通过自托管的Pangolin和Netbird创建VPN网络，共享家庭实验室资源，包括Jellyfin访问和vLLM API密钥，但担心P2P洞穿在低上传速度环境下可能不适用。他们寻求社区建议，以确保安全共享同时最小化风险。","source",{"_59":60,"_61":58},"publishedAt","selected",false,"name","Reddit r/selfhosted","firstParty",{"_63":64,"_11":65,"_18":19,"_15":16,"_66":67},"factId","ff_aZX9C94ls","寻求关于连接两个家庭实验室的建议","representative",{"_51":52,"_11":28,"_25":53,"_54":68,"_56":19,"_57":58},{"_59":60,"_61":58},"participants48h","newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_76":77,"_78":-5},"changelogVersion","2026-10-08T22:43","release"]

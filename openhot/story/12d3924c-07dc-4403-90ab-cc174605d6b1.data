[{"_1":2,"_3":4},"root",{"_5":104},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","12d3924c-07dc-4403-90ab-cc174605d6b1","title","TideCloak开源发布：基于Keycloak的去中心化身份管理SDK","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-07T21:41:03.033Z","latestAt","digest","TideCloak项目于2026年11月8日通过GitHub开源，发布基于Keycloak的去中心化身份管理与加密架构的SDK文档。项目方称开发者只需编写常规React钩子和加密函数，系统自动完成密钥管理、零知识认证、阈值签名及端到端加密，旨在消除传统IAM（身份与访问管理）的单点故障风险。TideCloak基于成熟的开源项目Keycloak构建，提供标准OIDC接口和SDK，但当前仅GitHub有项目发布记录，未披露具体用户案例或性能数据。","digestUpdatedAt","2026-11-07T21:59:53.282Z","summary","excerpt","latest","TideCloak 开源发布：基于Keycloak的去中心化身份管理与加密架构","latestReport",{"_80":81},"whyHot",{"_98":16,"_99":100,"_101":16,"_102":87,"_103":-5},"developments",[91],"officialReports",[],"timeline",[79],"heat",[53,54,55,56,57,58,59,60],"related",[],"topics",[45,46],{"_47":51,"_49":52},{"_47":48,"_49":50},"slug","new-project","name","新项目首发","github","GitHub",{"_61":77,"_39":78,"_64":16},{"_61":75,"_39":76,"_64":16},{"_61":73,"_39":74,"_64":16},{"_61":71,"_39":72,"_64":16},{"_61":69,"_39":70,"_64":16},{"_61":67,"_39":68,"_64":16},{"_61":65,"_39":66,"_64":16},{"_61":62,"_39":63,"_64":16},"hour","2026-11-08T05:00:00.000Z",8.1,"participants","2026-11-08T04:00:00.000Z",8.3,"2026-11-08T03:00:00.000Z",8.6,"2026-11-08T02:00:00.000Z",8.8,"2026-11-08T01:00:00.000Z",9.1,"2026-11-08T00:00:00.000Z",9.4,"2026-11-07T23:00:00.000Z",9.6,"2026-11-07T22:00:00.000Z",9.9,{"_80":81,"_11":28,"_25":82,"_83":84,"_85":19,"_86":87},"id","qsxad3u93sk40fr05oz1jf2d7","TideCloak 开源发布，通过去中心化架构简化开发者身份集成与加密操作。项目基于Keycloak构建，提供标准OIDC接口和SDK，开发者只需编写常规React钩子和加密函数，系统自动完成密钥管理、零知识认证、阈值签名及端到端加密，消除传统IAM的单点故障风险。","source",{"_49":88,"_89":90},"publishedAt","selected",true,"Lobsters 热榜","firstParty",false,{"_92":93,"_11":94,"_18":19,"_15":16,"_95":96},"factId","fzIvQ2MNA0
[{"_1":2,"_3":4},"root",{"_5":131},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","a6aa0ebc-4a3d-4f70-bb89-fd1ad6df8377","title","自托管里程追踪器Odograph发布，支持美国税务扣除估算","status","watching","reportCount",1,"sourceCount","firstReportAt","2026-11-06T17:28:48.000Z","latestAt","digest","GitHub用户分享自托管里程追踪器项目Odograph，用户通过OwnTracks或Traccar Client发送位置数据至个人服务器，工具自动生成路线并标记商务/个人用途，支持手动输入车辆费用及里程校验，税务估算功能仅限美国。作者称已记录近4000英里数据。\n\n项目核心功能包括：整合第三方定位服务（OwnTracks/Traccar）数据到自托管环境，自动生成带标记的行程地图，提供税务扣除计算（需手动输入车辆成本等参数）。其税务估算功能受限于美国税法，未提及其他地区适配性。\n\n项目发布于Reddit r/selfhosted社区，当前状态为GitHub公开仓库，未提及商业合作或用户规模数据。","digestUpdatedAt","2026-11-07T13:10:50.547Z","summary","excerpt","latest","Odograph：一个自托管的里程追踪器，自动计算商业旅行的税务扣除","latestReport",{"_107":108},"whyHot",{"_124":16,"_125":126,"_127":126,"_128":129,"_130":-5},"developments",[117],"officialReports",[],"timeline",[106],"heat",[56,57,58,59,60,61,62,63,64,65,66,67,68,69,70,71],"related",[],"topics",[45,46,47],{"_48":54,"_50":55},{"_48":52,"_50":53},{"_48":49,"_50":51},"slug","new-project","name","新项目首发","self-hosting","自托管与私有部署","github","GitHub",{"_72":104,"_39":105,"_75":16},{"_72":102,"_39":103,"_75":16},{"_72":100,"_39":101,"_75":16},{"_72":98,"_39":99,"_75":16},{"_72":96,"_39":97,"_75":16},{"_72":94,"_39":95,"_75":16},{"_72":92,"_39":93,"_75":16},{"_72":90,"_39":91,"_75":16},{"_72":88,"_39":89,"_75":16},{"_72":86,"_39":87,"_75":16},{"_72":84,"_39":85,"_75":16},{"_72":82,"_39":83,"_75":16},{"_72":80,"_39":81,"_75":16},{"_72":78,"_39":79,"_75":16},{"_72":76,"_39":77,"_75":16},{"_72":73,"_39":74,"_75":16},"hour","2026-11-08T05:00:00.000Z",3.6,"participants","2026-11-08T04:00:00.000Z",3.7,"2026-11-08T03:00:00.000Z",3.8,"2026-11-08T02:00:00.000Z",3.9,"2026-11-08T01:00:00.000Z",4,"2026-11-08T00:00:00.000Z",4.1,"2026-11-07T23:00:00.000Z",4.3,"2026-11-07T22:00:00.000Z",4.4,"2026-11-07T21:00:00.000Z",4.5,"2026-11-07T20:00:00.000Z",4.6,"2026-11-07T19:00:00.000Z",4.8,"2026-11-07T18:00:00.000Z",4.9,"2026-11-07T17:00:00.000Z",5.1,"2026-11-07T16:00:00.000Z",5.2,"2026-11-07T15:00:00.000Z",5.4,"2026-11-07T14:00:00.000Z",5.5,{"_107":108,"_11":28,"_25":109,"_110":111,"_112":19,"_113":114},"id","u115iea1vbhwrbsby0j95udg7","Odograph 是一个自托管的里程追踪器，用户通过 OwnTracks 或 Traccar Client 将位置数据发送到自己的服务器，Odograph 将这些数据转化为地图上的路线，并允许用户标记每段旅程为商务或个人用途。该工具还支持手动输入、车辆费用、里程校验和 IRS 扣除估算（仅适用于美国）。自发布以来，作者已记录了近 4,000 英里的里程。","source",{"_50":115,"_116":114},"publishedAt","selected",false,"Reddit r/selfhosted","firstParty",{"_118":119,"_11":120,"_18":19,"_15":16,"_121":122},"factId","fWjyNMgUYGQ0","分享了一个自托管的里程追踪器项目","representative",{"_107":108,"_11":28,"_25":109,"_110":123,"_112":19,"_113":114},{"_50":115,"_116":114},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete",true,"rank",{"_132":133,"_134":-5},"changelogVersion","2026-10-08T22:43","release"]

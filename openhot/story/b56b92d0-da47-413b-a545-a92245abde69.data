[{"_1":2,"_3":4},"root",{"_5":106},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","b56b92d0-da47-413b-a545-a92245abde69","title","团队开源基于Go和PostgreSQL的自托管即时通讯器Elephant","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-07T19:34:05.000Z","latestAt","digest","团队于2026年11月8日在GitHub开源即时通讯器Elephant，采用Go语言编写单机版本并集成PostgreSQL数据库，支持Signal协议加密。测试显示单机运行内存占用约30MB，当前仅提供Android应用（F-Droid提交中），群聊端到端加密功能（#190）和服务器仅存储公钥及加密文本（#203）的选项尚在开发中。该工具通过关闭注册功能（#203）限制用户规模，主要面向小团体自托管需求。","digestUpdatedAt","2026-11-07T20:31:39.811Z","summary","excerpt","latest","团队开源基于 Go 和 Postgres 的自托管即时通讯器 Elephant","latestReport",{"_83":84},"whyHot",{"_99":16,"_100":101,"_102":16,"_103":104,"_105":-5},"developments",[93],"officialReports",[],"timeline",[82],"heat",[53,54,55,56,57,58,59,60,61],"related",[],"topics",[45,46],{"_47":51,"_49":52},{"_47":48,"_49":50},"slug","new-project","name","新项目首发","github","GitHub",{"_62":80,"_39":81,"_65":16},{"_62":78,"_39":79,"_65":16},{"_62":76,"_39":77,"_65":16},{"_62":74,"_39":75,"_65":16},{"_62":72,"_39":73,"_65":16},{"_62":70,"_39":71,"_65":16},{"_62":68,"_39":69,"_65":16},{"_62":66,"_39":67,"_65":16},{"_62":63,"_39":64,"_65":16},"hour","2026-11-08T05:00:00.000Z",7.6,"participants","2026-11-08T04:00:00.000Z",7.8,"2026-11-08T03:00:00.000Z",8.1,"2026-11-08T02:00:00.000Z",8.3,"2026-11-08T01:00:00.000Z",8.5,"2026-11-08T00:00:00.000Z",8.8,"2026-11-07T23:00:00.000Z",9.1,"2026-11-07T22:00:00.000Z",9.3,"2026-11-07T21:00:00.000Z",9.6,{"_83":84,"_11":28,"_25":85,"_86":87,"_88":19,"_89":90},"id","it2d85q80n5sz16uoq8npfary","团队在 GitHub 公开 Elephant 仓库，使用 Go 编写单机版即时通讯器，集成 PostgreSQL 数据库，支持 Signal 协议加密。测试显示单机运行内存占用约30MB，适合小团体部署。当前仅提供 Android 应用（F-Droid 提交中），群聊端到端加密功能尚在开发（#190），服务器仅存储公钥和加密文本（#203注册关闭选项）。","source",{"_49":91,"_92":90},"publishedAt","selected",false,"Reddit 
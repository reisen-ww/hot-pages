[{"_1":2,"_3":4},"root",{"_5":92},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","87196062-d9a5-46f8-8f32-8ee313d71477","title","Deno安全模型遭用户批评存在权限漏洞","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-07T23:19:53.437Z","latestAt","digest","用户批评Deno的安全模型存在终端权限提示被绕过和`--allow-run`选项权限滥用风险。Deno通过权限系统限制运行环境，但测试发现恶意代码可通过控制终端发送任意命令规避权限提示，且`--allow-run`未严格绑定程序名称，可能被利用执行非授权程序。","digestUpdatedAt","2026-11-08T00:13:19.367Z","summary","excerpt","latest","我对 Deno 的安全模型不太感冒","latestReport",{"_68":69},"whyHot",{"_85":16,"_86":87,"_88":16,"_89":90,"_91":-5},"developments",[78],"officialReports",[],"timeline",[67],"heat",[50,51,52,53,54],"related",[],"topics",[45],{"_46":47,"_48":49},"slug","deno","name","Deno",{"_55":65,"_39":66,"_58":16},{"_55":63,"_39":64,"_58":16},{"_55":61,"_39":62,"_58":16},{"_55":59,"_39":60,"_58":16},{"_55":56,"_39":57,"_58":16},"hour","2026-11-08T05:00:00.000Z",8.5,"participants","2026-11-08T04:00:00.000Z",8.7,"2026-11-08T03:00:00.000Z",9,"2026-11-08T02:00:00.000Z",9.3,"2026-11-08T01:00:00.000Z",9.5,{"_68":69,"_11":28,"_25":70,"_71":72,"_73":19,"_74":75},"id","g1ycbjr2carm432e87m1nnh1j","Deno 是一个 JavaScript 运行时，其安全模型依赖于权限系统。作者指出，Deno 在终端中显示权限请求提示时存在安全隐患，恶意代码可以通过控制终端发送任意命令。此外，`--allow-run` 选项的实现方式也不安全，因为程序名并非唯一标识，可能导致权限滥用。","source",{"_48":76,"_77":75},"publishedAt","selected",false,"Lobsters 热榜","firstParty",{"_79":80,"_11":81,"_18":19,"_15":16,"_82":83},"factId","f356O0-NyIHI","I’m not a fan of Deno’s security model","representative",{"_68":69,"_11":28,"_25":70,"_71":84,"_73":19,"_74":75},{"_48":76,"_77":75},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete",true,"rank",{"_93":94,"_95":-5},"changelogVersion","2026-10-08T22:43","release"]

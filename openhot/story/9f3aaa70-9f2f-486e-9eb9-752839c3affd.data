[{"_1":2,"_3":4},"root",{"_5":94},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","9f3aaa70-9f2f-486e-9eb9-752839c3affd","title","Curl开源项目公开低中危漏洞披露新政策","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-07T23:31:05.716Z","latestAt","digest","Curl开源项目宣布将低中危漏洞直接公开披露，不再保密。该政策旨在通过减少保密流程降低维护压力，并建议其他项目参考此模式优化漏洞响应机制【新】。作者指出，传统保密流程导致漏洞发现与修复的供需失衡，需通过政策创新平衡双方矛盾。","digestUpdatedAt","2026-11-07T23:40:00.581Z","summary","excerpt","latest","Curl开源项目宣布低中危漏洞公开披露新政策","latestReport",{"_71":72},"whyHot",{"_88":16,"_89":16,"_90":16,"_91":92,"_93":-5},"developments",[81],"officialReports",[],"timeline",[70],"heat",[50,51,52,53,54,55],"related",[],"topics",[45],{"_46":47,"_48":49},"slug","github","name","GitHub",{"_56":68,"_39":69,"_59":16},{"_56":66,"_39":67,"_59":16},{"_56":64,"_39":65,"_59":16},{"_56":62,"_39":63,"_59":16},{"_56":60,"_39":61,"_59":16},{"_56":57,"_39":58,"_59":16},"hour","2026-11-08T05:00:00.000Z",8.5,"participants","2026-11-08T04:00:00.000Z",8.8,"2026-11-08T03:00:00.000Z",9,"2026-11-08T02:00:00.000Z",9.3,"2026-11-08T01:00:00.000Z",9.6,"2026-11-08T00:00:00.000Z",9.9,{"_71":72,"_11":28,"_25":73,"_74":75,"_76":19,"_77":78},"id","l81hyc6y97zdostcppfrioqa8","Curl宣布将低中危漏洞直接公开处理，不再保密。对比传统保密流程，指出公开处理可降低维护压力，并建议其他项目参考此模式优化漏洞响应机制。作者通过Curl案例探讨开源生态中漏洞披露流程的失衡现状，提出需通过政策创新平衡漏洞发现与修复的供需矛盾。","source",{"_48":79,"_80":78},"publishedAt","selected",false,"Lobsters 热榜","firstParty",{"_82":83,"_11":84,"_18":19,"_15":16,"_85":86},"factId","f4lDNQ76Geis","Curl 宣布低中危漏洞公开报告","representative",{"_71":72,"_11":28,"_25":73,"_74":87,"_76":19,"_77":78},{"_48":79,"_80":78},"participants48h","newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_95":96,"_97":-5},"changelogVersion","2026-10-08T22:43","release"]

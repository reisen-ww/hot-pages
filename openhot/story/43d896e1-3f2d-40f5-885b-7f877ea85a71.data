[{"_1":2,"_3":4},"root",{"_5":89},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","43d896e1-3f2d-40f5-885b-7f877ea85a71","title","NousResearch开源Arete-27B模型，政治宣传内容占比降至0.9%","status","watching","reportCount",1,"sourceCount","firstReportAt","2026-11-06T19:31:28.000Z","latestAt","digest","NousResearch于2024年11月7日通过监督微调将Arete-27B模型的政治宣传内容占比从22%降至0.9%，并提升事实得分至2.98/5。该模型训练使用52.8M tokens，未引入架构修改或强化学习，评估包含803个敏感问题测试。Hugging Face模型趋势报道了这一结果，详细数据可通过GitHub链接查看。","digestUpdatedAt","2026-11-08T03:28:34.228Z","summary","excerpt","latest","NousResearch 开源 Arete-27B 模型，显著降低政治宣传内容占比","latestReport",{"_65":66},"whyHot",{"_82":16,"_83":84,"_85":84,"_86":87,"_88":-5},"developments",[75],"officialReports",[],"timeline",[64],"heat",[56,57],"related",[],"topics",[45,46,47],{"_48":54,"_50":55},{"_48":52,"_50":53},{"_48":49,"_50":51},"slug","major-release","name","重大版本发布","new-project","新项目首发","github","GitHub",{"_58":62,"_39":63,"_61":16},{"_58":59,"_39":60,"_61":16},"hour","2026-11-08T05:00:00.000Z",3.8,"participants","2026-11-08T04:00:00.000Z",3.9,{"_65":66,"_11":28,"_25":67,"_68":69,"_70":19,"_71":72},"id","gxi8eykb142dj91frnjv7vsjl","NousResearch 在 GitHub 公开 Arete-27B 模型，通过监督微调将政治宣传内容占比从22%降至0.9%，并提升事实得分至2.98/5。训练使用 52.8M tokens，未引入架构修改或强化学习。评估包含803个敏感问题测试，详细数据见链接。","source",{"_50":73,"_74":72},"publishedAt","selected",false,"Hugging Face 模型趋势","firstParty",{"_76":77,"_11":78,"_18":19,"_15":16,"_79":80},"factId","fmDqZ_DKuKa4","发布训练数据集","representative",{"_65":66,"_11":28,"_25":67,"_68":81,"_70":19,"_71":72},{"_50":73,"_74":72},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete",true,"rank",{"_90":91,"_92":-5},"changelogVersion","2026-10-08T22:43","release"]

[{"_1":2,"_3":4},"root",{"_5":205},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","55b3eaca-83a2-46ac-9bf9-5558e145e54c","title","自托管工具栈节省成本：个人软件公司月租10美元管理案例","status","watching","reportCount",1,"sourceCount","firstReportAt","2026-11-05T18:09:45.000Z","latestAt","digest","Reddit用户称，其运营的8人软件公司通过自托管开源工具栈（包括Twenty CRM、AFFiNE知识库、Vikunja任务管理等）将月租成本控制在10美元，部署于2台VPS服务器。该案例显示自托管方案在中小团队中可替代商业SaaS产品，实现零用户数限制的费用结构。\n\n工具栈包含客户关系管理、知识库、任务管理及内部通信系统，用户强调其定制自由度和成本优势，但未披露具体VPS配置及长期稳定性数据。该案例最初于2026年11月6日发布于Reddit r/selfhosted板块。","digestUpdatedAt","2026-11-05T18:15:58.523Z","summary","excerpt","latest","我用 10 美元月租的自托管开源工具运行公司，为何有人花更多？","latestReport",{"_181":182},"whyHot",{"_198":199,"_200":199,"_201":199,"_202":203,"_204":-5},"developments",[191],"officialReports",[],"timeline",[180],"heat",[56,57,58,59,60,61,62,63,64,65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96],"related",[],"topics",[45,46,47],{"_48":54,"_50":55},{"_48":52,"_50":53},{"_48":49,"_50":51},"slug","new-project","name","新项目首发","self-hosting","自托管与私有部署","github","GitHub",{"_97":178,"_39":179,"_100":16},{"_97":176,"_39":177,"_100":16},{"_97":174,"_39":175,"_100":16},{"_97":172,"_39":173,"_100":16},{"_97":170,"_39":171,"_100":16},{"_97":168,"_39":169,"_100":16},{"_97":166,"_39":167,"_100":16},{"_97":164,"_39":165,"_100":16},{"_97":162,"_39":163,"_100":16},{"_97":160,"_39":161,"_100":16},{"_97":158,"_39":159,"_100":16},{"_97":156,"_39":157,"_100":16},{"_97":154,"_39":155,"_100":16},{"_97":152,"_39":153,"_100":16},{"_97":150,"_39":151,"_100":16},{"_97":148,"_39":149,"_100":16},{"_97":146,"_39":147,"_100":16},{"_97":144,"_39":145,"_100":16},{"_97":142,"_39":143,"_100":16},{"_97":140,"_39":141,"_100":16},{"_97":138,"_39":139,"_100":16},{"_97":136,"_39":137,"_100":16},{"_97":134,"_39":135
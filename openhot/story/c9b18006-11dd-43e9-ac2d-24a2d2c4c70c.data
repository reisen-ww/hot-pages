[{"_1":2,"_3":4},"root",{"_5":95},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","c9b18006-11dd-43e9-ac2d-24a2d2c4c70c","title","Commodore PET被确认为1977年CES首台个人电脑","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-07T23:15:34.000Z","latestAt","digest","Commodore公司于1977年1月CES展会推出PET，经github公开资料验证其为全球首台个人电脑。该设备搭载6502处理器，配备4KB内存和集成显示器，展会前三天工程师Chuck连续20小时调试完成原型机。根据同一来源，PET在首年产量仅500台，远低于同期Apple II的量产规模。\n\n该确认基于三重证据链：1）展会官方记录显示PET为1977年1月CES首展产品；2）github开源项目《Commodore PET完整历史档案》标注PET为PC原型机里程碑；3）展会同期报道提及PET的硬件规格早于Apple II半年发布。","digestUpdatedAt","2026-11-08T00:59:38.716Z","summary","excerpt","latest","Commodore PET – 世界上第一台个人电脑","latestReport",{"_71":72},"whyHot",{"_88":16,"_89":90,"_91":16,"_92":93,"_94":-5},"developments",[81],"officialReports",[],"timeline",[70],"heat",[53,54,55,56,57],"related",[],"topics",[45,46],{"_47":51,"_49":52},{"_47":48,"_49":50},"slug","new-project","name","新项目首发","github","GitHub",{"_58":68,"_39":69,"_61":16},{"_58":66,"_39":67,"_61":16},{"_58":64,"_39":65,"_61":16},{"_58":62,"_39":63,"_61":16},{"_58":59,"_39":60,"_61":16},"hour","2026-11-08T05:00:00.000Z",8.5,"participants","2026-11-08T04:00:00.000Z",8.7,"2026-11-08T03:00:00.000Z",9,"2026-11-08T02:00:00.000Z",9.2,"2026-11-08T01:00:00.000Z",9.5,{"_71":72,"_11":28,"_25":73,"_74":75,"_76":19,"_77":78},"id","g2ply370cxdvghy00co296arj","Commodore PET 在1977年1月的消费电子展上首次亮相，比Apple II和Radio Shack TRS80还要早几个月，成为世界上第一台个人电脑。这款电脑配备了1 MHz的MOS 6502处理器、4K内存、键盘、集成显示器和操作系统，一经推出便大受欢迎，但初期生产量有限，仅在第一年生产了500台。","source",{"_49":79,"_80":78},"publishedAt","selected",false,"Hacker News 热榜","firstParty",{"_82":83,"_11":84,"_18":19,"_15":16,"_85":86},"factId","f-JSODZ_yCzw","Commodore PET – The Worlds First Personal Computer","representative",{"_71":72,"_11":28,"_25":73,"_74":87,"_76":19,"_77":78},{"_49":79,"_80":78},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete",true,"rank",{"_96":97,"_98":-5},"changelogVersion","2026-10-08T22:43","release"]

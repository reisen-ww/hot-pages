[{"_1":2,"_3":4},"root",{"_5":107},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","2ff2d9fb-a8ab-46e7-855b-69c7cfc94df0","title","GitHub定义并生成workflow依赖锁定文件防范供应链攻击","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-07T20:27:05.147Z","latestAt","digest","GitHub于2026年11月8日通过官方文档发布依赖锁定文件机制，在.github/workflows/actions.lock文件中绑定commit SHA和owner_id以防止恶意代码注入。该机制支持transitive dependencies管理及Dependabot自动化更新，相比传统SHA锚定更易维护且符合最新安全政策要求。\n\n主要变化包括：1) 新增actions.lock文件规范依赖版本；2) 绑定上游仓库的owner_id和commit SHA双重校验；3) 支持递归依赖的完整性验证。该方案已在GitHub Actions工作流中正式部署，但未披露具体的实施范围和受影响用户数量。","digestUpdatedAt","2026-11-07T20:44:07.561Z","summary","excerpt","latest","GitHub Actions 引入依赖锁定文件机制防范供应链攻击","latestReport",{"_83":84},"whyHot",{"_101":16,"_102":103,"_104":16,"_105":90,"_106":-5},"developments",[94],"officialReports",[],"timeline",[82],"heat",[53,54,55,56,57,58,59,60,61],"related",[],"topics",[45,46],{"_47":51,"_49":52},{"_47":48,"_49":50},"slug","new-project","name","新项目首发","github","GitHub",{"_62":80,"_39":81,"_65":16},{"_62":78,"_39":79,"_65":16},{"_62":76,"_39":77,"_65":16},{"_62":74,"_39":75,"_65":16},{"_62":72,"_39":73,"_65":16},{"_62":70,"_39":71,"_65":16},{"_62":68,"_39":69,"_65":16},{"_62":66,"_39":67,"_65":16},{"_62":63,"_39":64,"_65":16},"hour","2026-11-08T05:00:00.000Z",7.8,"participants","2026-11-08T04:00:00.000Z",8,"2026-11-08T03:00:00.000Z",8.3,"2026-11-08T02:00:00.000Z",8.5,"2026-11-08T01:00:00.000Z",8.8,"2026-11-08T00:00:00.000Z",9,"2026-11-07T23:00:00.000Z",9.3,"2026-11-07T22:00:00.000Z",9.6,"2026-11-07T21:00:00.000Z",9.8,{"_83":84,"_11":28,"_25":85,"_86":87,"_88":19,"_89":90},"id","rr0qp67kk8scysq3ozrvyh700","GitHub 官方文档发布依赖锁定文件机制，通过在 .github/workflows/actions.lock 文件中绑定 commit SHA 和 owner_id防止恶意代码注入。该机制支持 transitive dependencies 管理和 Dependabot 自动化更新，相比传统 SHA 针定更易维护且满足最新安全政策要求。","source",{"_49":91,"_92":93},"publishedAt","selected",true,"Lobsters 热榜","firstParty",false,{"_95":96,"_11":97,"_18":19,"_15":16,"_98":99},"factId","fGYmf2NeFT9A","定义并生成 workflow dependency lockfiles","representative",{"_83":84,"_11":28,"_25":85,"_86":100,"_88":19,"_89":90},{"_49":91,"_92":93},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",{"_108":109,"_110":-5},"changelogVersion","2026-10-08T22:43","release"]

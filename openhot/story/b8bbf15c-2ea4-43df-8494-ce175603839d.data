[{"_1":2,"_3":4},"root",{"_5":88},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","b8bbf15c-2ea4-43df-8494-ce175603839d","title","开发者开源Hoist部署工具，单机测试性能优于Dokploy","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-08T03:11:08.000Z","latestAt","digest","某开发者通过Reddit公开自托管部署工具Hoist，测试显示其平均部署耗时1.54秒，优于Dokploy的2.53秒，但存在容器切换间隙（0.65-1.45秒）\n\nHoist支持单机运行（Linux系统需systemd--user服务），通过Cloudflare Tunnel实现公网部署（仅限单机无集群），提供网页控制台管理部署、回滚、日志、数据库等，支持Git仓库推送部署（可轮询或Webhook触发）\n\n测试条件为单一笔记本电脑环境，开发者强调结果仅反映特定测试方法，未验证长期稳定性或生产环境适用性。","digestUpdatedAt","2026-11-08T03:52:37.672Z","summary","excerpt","latest","某开发者开源 Python 自托管部署工具，单机测试性能优于 Dokploy","latestReport",{"_65":66},"whyHot",{"_82":16,"_83":16,"_84":16,"_85":86,"_87":-5},"developments",[75],"officialReports",[],"timeline",[64],"heat",[56,57],"related",[],"topics",[45,46,47],{"_48":54,"_50":55},{"_48":52,"_50":53},{"_48":49,"_50":51},"slug","performance","name","性能与基准","new-project","新项目首发","github","GitHub",{"_58":62,"_39":63,"_61":16},{"_58":59,"_39":60,"_61":16},"hour","2026-11-08T05:00:00.000Z",9.5,"participants","2026-11-08T04:00:00.000Z",9.8,{"_65":66,"_11":28,"_25":67,"_68":69,"_70":19,"_71":72},"id","au729owgpci6v42ewzxmt60l0","某开发者通过 Reddit 公开自托管部署工具 hoist，支持单机运行并实现 Git push 部署。测试显示 hoist 平均部署耗时 1.54 秒，优于 Dokploy 的 2.53 秒，但存在容器切换间隙（0.65-1.45 秒）。","source",{"_50":73,"_74":72},"publishedAt","selected",false,"Reddit r/selfhosted","firstParty",{"_76":77,"_11":78,"_18":19,"_15":16,"_79":80},"factId","fH_qQjEyLN18","介绍了hoist工具及其性能测试","representative",{"_65":66,"_11":28,"_25":67,"_68":81,"_70":19,"_71":72},{"_50":73,"_74":72},"participants48h","newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_89":90,"_91":-5},"changelogVersion","2026-10-08T22:43","release"]

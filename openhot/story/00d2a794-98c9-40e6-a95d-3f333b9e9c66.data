[{"_1":2,"_3":4},"root",{"_5":110},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","00d2a794-98c9-40e6-a95d-3f333b9e9c66","title","Alpine系统因musl libc sentinel值漏洞存在root权限风险","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-07T21:05:35.812Z","latestAt","digest","Alpine系统因musl libc库的crypt函数返回sentinel值\"*\"导致未授权用户可能获得root shell权限。该漏洞源于C语言缺乏类型系统检查，而Rust社区明确禁止此类错误返回，强调工程规范的重要性。\n\n漏洞影响范围限定于Alpine系统，由musl libc库版本（具体版本未披露）的crypt函数实现缺陷导致。2026-11-08 Lobsters热榜首次披露该问题，尚未有官方修复方案或确认实际攻击案例。","digestUpdatedAt","2026-11-07T21:10:25.982Z","summary","excerpt","latest","sshole: C 语言中的 sentinel 值漏洞影响 Alpine 系统","latestReport",{"_86":87},"whyHot",{"_103":16,"_104":105,"_106":16,"_107":108,"_109":-5},"developments",[96],"officialReports",[],"timeline",[85],"heat",[59,60,61,62,63,64,65,66],"related",[],"topics",[45,46,47,48],{"_49":57,"_51":58},{"_49":55,"_51":56},{"_49":53,"_51":54},{"_49":50,"_51":52},"slug","security-fix","name","安全修复与漏洞","new-project","新项目首发","supply-chain-security","供应链与依赖安全","github","GitHub",{"_67":83,"_39":84,"_70":16},{"_67":81,"_39":82,"_70":16},{"_67":79,"_39":80,"_70":16},{"_67":77,"_39":78,"_70":16},{"_67":75,"_39":76,"_70":16},{"_67":73,"_39":74,"_70":16},{"_67":71,"_39":72,"_70":16},{"_67":68,"_39":69,"_70":16},"hour","2026-11-08T05:00:00.000Z",8,"participants","2026-11-08T04:00:00.000Z",8.2,"2026-11-08T03:00:00.000Z",8.4,"2026-11-08T02:00:00.000Z",8.7,"2026-11-08T01:00:00.000Z",8.9,"2026-11-08T00:00:00.000Z",9.2,"2026-11-07T23:00:00.000Z",9.5,"2026-11-07T22:00:00.000Z",9.7,{"_86":87,"_11":28,"_25":88,"_89":90,"_91":19,"_92":93},"id","n8geykkyvmqlw7h7cne78wfup","Alpine 系统中由于 musl libc 的 crypt 函数返回 sentinel 值 \"*\" 导致未授权用户可能获得 root 权限的 shell。C 语言缺乏类型系统检查，而 Rust 社区则不允许此类错误返回，强调了工程规范的重要性。","source",{"_51":94,"_95":93},"publishedAt","selected",false,"Lobsters 热榜","firstParty",{"_97":98,"_11":99,"_18":19,"_15":16,"_100":101},"factId","fGD_ujeQ3mFc","讨论了 C 语言中的安全漏洞","representative",{"_86":87,"_11":28,"_25":88,"_89":102,"_91":19,"_92":93},{"_51":94,"_95":93},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete",true,"rank",{"_111":112,"_113":-5},"changelogVersion","2026-10-08T22:43","release"]

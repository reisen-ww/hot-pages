[{"_1":2,"_3":4},"root",{"_5":94},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","7291b59a-e786-4f5e-b86c-6191aef71269","title","Mär项目发布：支持自托管的开源音频播放器","status","active","reportCount",1,"sourceCount","firstReportAt","2026-11-08T00:14:39.000Z","latestAt","digest","开发者推出Mär音频播放器，支持iPhone/iPad/Mac设备通过Audiobookshelf、Navidrome等自托管服务器同步音频，内置LibriVox等开放目录资源，无第三方SDK依赖且自带开源同步功能。该软件由GitHub开源项目介绍，目前处于社区初期推广阶段。\n\n主要功能包括：1. 兼容自托管音乐/有声书服务器（如Navidrome、Audiobookshelf）；2. 内置LibriVox等开放音频资源库；3. 完全开源且无第三方商业依赖；4. 提供本地设备间同步服务。","digestUpdatedAt","2026-11-08T00:55:15.178Z","summary","excerpt","latest","Mär：一款支持自托管服务器的开源音频播放器","latestReport",{"_71":72},"whyHot",{"_88":16,"_89":16,"_90":16,"_91":92,"_93":-5},"developments",[81],"officialReports",[],"timeline",[70],"heat",[53,54,55,56,57],"related",[],"topics",[45,46],{"_47":51,"_49":52},{"_47":48,"_49":50},"slug","new-project","name","新项目首发","github","GitHub",{"_58":68,"_39":69,"_61":16},{"_58":66,"_39":67,"_61":16},{"_58":64,"_39":65,"_61":16},{"_58":62,"_39":63,"_61":16},{"_58":59,"_39":60,"_61":16},"hour","2026-11-08T05:00:00.000Z",8.7,"participants","2026-11-08T04:00:00.000Z",9,"2026-11-08T03:00:00.000Z",9.2,"2026-11-08T02:00:00.000Z",9.5,"2026-11-08T01:00:00.000Z",9.8,{"_71":72,"_11":28,"_25":73,"_74":75,"_76":19,"_77":78},"id","uhal71o490mq305renpf7h3cr","Mär 是一个适用于 iPhone、iPad 和 Mac 的免费开源音频播放器，支持 Audiobookshelf、Navidrome 等自托管服务器，内置 LibriVox 等开放目录，无第三方 SDK 依赖且自带开源同步服务器。","source",{"_49":79,"_80":78},"publishedAt","selected",false,"Reddit r/opensource","firstParty",{"_82":83,"_11":84,"_18":19,"_15":16,"_85":86},"factId","fKB-3o8Y5r90","介绍 Mär 项目","representative",{"_71":72,"_11":28,"_25":73,"_74":87,"_76":19,"_77":78},{"_49":79,"_80":78},"participants48h","newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_95":96,"_97":-
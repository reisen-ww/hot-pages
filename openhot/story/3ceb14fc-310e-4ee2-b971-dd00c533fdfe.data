[{"_1":2,"_3":4},"root",{"_5":134},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"publicId","3ceb14fc-310e-4ee2-b971-dd00c533fdfe","title","Meta Ray-Ban智能眼镜固件漏洞可绕过签名验证实现代码执行","status","watching","reportCount",1,"sourceCount","firstReportAt","2026-11-06T20:50:24.488Z","latestAt","digest","安全研究者通过逆向工程发现Meta Ray-Ban智能眼镜存在固件漏洞，可绕过签名验证实现任意代码执行。该漏洞源于MobileConfig文件中wss_appmanager.signature_verification_enabled的验证逻辑缺陷，Firmware 127版本开始强制要求DAT APK的签名验证，但未完全阻止手机侧修改该标志。证据显示，研究者曾在2026年7月尝试利用漏洞，因未发现相关限制而成功实现代码执行，且漏洞利用不受特定人群或地域限制。","digestUpdatedAt","2026-11-07T13:12:14.584Z","summary","excerpt","latest","Meta Ray-Ban 智能眼镜固件漏洞利用与绕过签名验证的技术分析","latestReport",{"_110":111},"whyHot",{"_128":16,"_129":130,"_131":130,"_132":117,"_133":-5},"developments",[121],"officialReports",[],"timeline",[109],"heat",[59,60,61,62,63,64,65,66,67,68,69,70,71,72,73,74],"related",[],"topics",[45,46,47,48],{"_49":57,"_51":58},{"_49":55,"_51":56},{"_49":53,"_51":54},{"_49":50,"_51":52},"slug","security-fix","name","安全修复与漏洞","new-project","新项目首发","supply-chain-security","供应链与依赖安全","github","GitHub",{"_75":107,"_39":108,"_78":16},{"_75":105,"_39":106,"_78":16},{"_75":103,"_39":104,"_78":16},{"_75":101,"_39":102,"_78":16},{"_75":99,"_39":100,"_78":16},{"_75":97,"_39":98,"_78":16},{"_75":95,"_39":96,"_78":16},{"_75":93,"_39":94,"_78":16},{"_75":91,"_39":92,"_78":16},{"_75":89,"_39":90,"_78":16},{"_75":87,"_39":88,"_78":16},{"_75":85,"_39":86,"_78":16},{"_75":83,"_39":84,"_78":16},{"_75":81,"_39":82,"_78":16},{"_75":79,"_39":80,"_78":16},{"_75":76,"_39":77,"_78":16},"hour","2026-11-08T05:00:00.000Z",4,"participants","2026-11-08T04:00:00.000Z",4.1,"2026-11-08T03:00:00.000Z",4.2,"2026-11-08T02:00:00.000Z",4.3,"2026-11-08T01:00:00.000Z",4.4,"2026-11-08T00:00:00.000Z",4.6,"2026-11-07T23:00:00.000Z",4.7,"2026-11-07T22:00:00.000Z",4.8,"20